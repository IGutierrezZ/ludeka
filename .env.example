# =====================================================================
# Ludeka - Configuración de Variables de Entorno (Staging / Producción)
# Copia este archivo como '.env' en el servidor VPS y completa los valores.
# =====================================================================

# Configuración del Entorno de Ejecución
ASPNETCORE_ENVIRONMENT=Production
PORT=5081

# Base de Datos (Estrategia Dual: SQLite en local o PostgreSQL en Supabase)
# Para desarrollo local con SQLite:
# Database__Provider=Sqlite
# ConnectionStrings__DefaultConnection=Data Source=/app/data/ludeka.db

# Para Producción con Supabase (PostgreSQL):
Database__Provider=PostgreSql
Database__SeedDemoData=false
ConnectionStrings__DefaultConnection=Host=db.xxxx.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=TU_PASSWORD_AQUI;SSL Mode=Require;Trust Server Certificate=true;

# Usuario Administrador Fundador Inicial Permanente (Garantizado)
AdminUser__Id=admin-fundador
AdminUser__UserName=Administrador Ludeka
AdminUser__Email=admin@ludeka.es
AdminUser__Country=España

# BoardGameGeek XMLAPI2 (Opcional - Requerido para auto-catalogación enriquecida en directo)
Bgg__ApiToken=
Bgg__BaseUrl=https://boardgamegeek.com/xmlapi2/
Bgg__UserAgent=LudekaApp/1.0 (https://ludeka.es; contacto@ludeka.es)

# Sistema de Notificaciones y Webhooks de Comunidad (Discord & Telegram)
# Establecer DryRun=false en producción para emitir mensajes reales
CommunityNotifications__Enabled=true
CommunityNotifications__DryRun=false

# Discord Oficial de la Comunidad (Webhook y enlace público de invitación)
CommunityNotifications__DiscordEnabled=true
CommunityNotifications__DiscordWebhookUrl=
CommunityNotifications__DiscordInviteUrl=https://discord.gg/DgGUUEU6gs

# Telegram Oficial de la Comunidad (Bot y enlace público al canal)
CommunityNotifications__TelegramEnabled=true
CommunityNotifications__TelegramBotToken=
CommunityNotifications__TelegramChatId=
CommunityNotifications__TelegramChannelUrl=https://t.me/ludeka

# Google Gemini API (Síntesis editorial inteligente y extracción de noticias)
Gemini__Simulate=false
Gemini__ApiKey=
Gemini__Model=gemini-2.5-flash

# YouTube Data API v3 (Búsqueda en directo de partidas y reseñas comunitarias)
YouTube__Simulate=false
YouTube__ApiKey=

# Motor Privado de Afiliación de Tiendas Especializadas
Affiliates__Enabled=true
Affiliates__Stores__Zacatrus__AffiliateTag=ludeka
Affiliates__Stores__Mathom__AffiliateTag=ludeka
Affiliates__Stores__DungeonMarvels__AffiliateTag=ludeka
Affiliates__Stores__CuartoDeJuegos__AffiliateTag=ludeka
Affiliates__Stores__Tablerum__AffiliateTag=ludeka
