@using Ludeka.Application.DTOs
@using Ludeka.Core.Enums
@using Ludeka.Web.Components.Shared

<a href="/sorteos/@Giveaway.Id"
   class="group block bg-[#FFF8EE] text-[#22180F] p-3 pb-4 sm:pb-5 rounded-sm sm:rounded shadow-[0_16px_30px_rgba(34,24,15,0.20)] border border-black/5 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl @GetRotationClass()"
   role="listitem"
   aria-label="Ver sorteo de @Giveaway.Title">
    @* Carátula cuadrada 1:1 *@
    <div class="aspect-square w-full rounded-[2px] overflow-hidden bg-[var(--paper-2)] relative mb-2.5">
        @if (!string.IsNullOrWhiteSpace(Giveaway.ThumbnailUrl))
        {
            <img src="@Giveaway.ThumbnailUrl"
                 alt="@Giveaway.Title"
                 width="220"
                 height="220"
                 loading="lazy"
                 decoding="async"
                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                 onerror="this.onerror=null; this.src='/images/defaults/sorteo-default.svg';" />
        }
        else
        {
            <DefaultImage Domain="DefaultImageDomain.Sorteo" CssClass="w-full h-full object-cover" />
        }

        @if (Giveaway.IsPromoted)
        {
            <div class="absolute top-1.5 left-1.5 px-2 py-0.5 rounded-full bg-[var(--mustard)] text-[#22180F] text-[10px] font-black uppercase tracking-wider shadow">
                Top
            </div>
        }
    </div>

    @* Título *@
    <h3 class="text-sm sm:text-base font-black text-[#22180F] line-clamp-2 leading-snug tracking-[-0.015em] mb-2 min-h-[2.5rem]">
        @Giveaway.Title
    </h3>

    @* Pie de Polaroid: Plataforma y Cuenta Atrás en alerta *@
    <div class="flex items-center justify-between gap-2 text-xs font-black pt-1 border-t border-black/10">
        <span class="text-[#6B5848] truncate flex items-center gap-1">
            <Icon Name="@GetPlatformIcon(Giveaway.Platform)" Size="13" />
            <span>@Giveaway.Platform</span>
        </span>
        <span class="text-[#B23A12] shrink-0 font-mono text-[11px] sm:text-xs inline-flex items-center gap-1">
            <Icon Name="timer" Size="12" />
            <span>@Giveaway.RemainingTimeText</span>
        </span>
    </div>
</a>

@code {
    [Parameter, EditorRequired] public GiveawayDto Giveaway { get; set; } = null!;
    [Parameter] public int Index { get; set; }

    private string GetRotationClass() => (Index % 2 == 0)
        ? "-rotate-[1.5deg] hover:rotate-0"
        : "rotate-[1.5deg] hover:rotate-0";

    private static string GetPlatformIcon(GiveawayPlatform platform) => platform switch
    {
        GiveawayPlatform.Instagram => "instagram",
        GiveawayPlatform.TwitterX => "twitter",
        GiveawayPlatform.YouTube => "youtube",
        GiveawayPlatform.Community => "users",
        _ => "gift"
    };
}
