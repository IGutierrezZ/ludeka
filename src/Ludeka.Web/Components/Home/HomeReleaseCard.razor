@* Tarjeta del carril Novedades de la portada (INC-87): formato vertical compacto equivalente al catálogo (HomeGameCard/HomeGiveawayCard),
   microinteracción .rail-card, portada con badges de novedad/reimpresión y fecha, y enlace directo a la ficha de la novedad. *@
@using Ludeka.Web.Components.Shared
@using Ludeka.Application.DTOs

<a href="/novedades/@Release.Id"
   class="rail-card w-[28vw] min-w-[105px] max-w-[125px] sm:w-44 md:w-48 shrink-0 snap-start flex flex-col h-full cursor-pointer"
   role="listitem"
   aria-label="Ver ficha del lanzamiento @Release.Title">
    <div class="rail-cover rail-cover--square">
        @if (!string.IsNullOrWhiteSpace(Release.CoverImageUrl))
        {
            <img src="@Release.CoverImageUrl"
                 alt="Carátula de @Release.Title"
                 loading="lazy"
                 decoding="async"
                 width="192"
                 height="192"
                 onerror="this.onerror=null; this.src='/images/defaults/novedad-default.svg';" />
        }
        else
        {
            <DefaultImage Domain="DefaultImageDomain.Novedad" CssClass="w-full h-full" />
        }

        @* Badge superior izquierdo: Novedad / Reimpresión *@
        <div class="absolute top-1.5 left-1.5 sm:top-2 sm:left-2 z-10">
            <span class="px-1.5 sm:px-2 py-0.5 rounded-md text-[0.6rem] sm:text-[0.65rem] font-black border shadow-md inline-flex items-center gap-0.5 sm:gap-1 @(Release.IsReprint ? "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)]" : "bg-[var(--brand-glow)] border-[var(--brand-primary)] text-[var(--text-primary)]")">
                @if (Release.IsReprint)
                {
                    <Icon Name="refresh-cw" Size="11" />
                    <span class="hidden sm:inline">Reimpresión</span>
                }
                else
                {
                    <Icon Name="sparkles" Size="11" />
                    <span>Novedad</span>
                }
            </span>
        </div>

        @* Badge superior derecho: Fecha de lanzamiento *@
        <div class="absolute top-1.5 right-1.5 sm:top-2 sm:right-2 z-10 px-1.5 sm:px-2 py-0.5 rounded-md text-[0.6rem] sm:text-[0.65rem] font-bold shadow-md border bg-black/80 backdrop-blur-sm border-white/20 text-white flex items-center gap-0.5 sm:gap-1">
            <Icon Name="calendar-days" Size="11" />
            <span>@(Release.ReleaseDate.HasValue ? Release.ReleaseDate.Value.ToString("dd/MM") : "Próximamente")</span>
        </div>
    </div>

    <div class="p-2 sm:p-3 flex flex-col flex-1">
        <div class="flex items-center justify-between gap-1 text-[0.65rem] sm:text-[0.7rem] font-semibold text-[var(--text-muted)] mb-1">
            <span class="truncate">@Release.Publisher</span>
            @if (Release.EstimatedPvp.HasValue)
            {
                <span class="font-extrabold text-[var(--text-primary)] shrink-0">@Release.EstimatedPvp.Value.ToString("0.00") €</span>
            }
        </div>

        <h3 class="text-xs sm:text-sm font-extrabold text-[var(--text-primary)] line-clamp-2 leading-snug min-h-[2.1rem] sm:min-h-[2.5rem]">
            @Release.Title
        </h3>

        @if (!string.IsNullOrWhiteSpace(Release.SourceUrl))
        {
            <div class="mt-auto pt-1.5 text-[0.62rem] sm:text-[0.68rem] text-[var(--text-muted)] truncate flex items-center gap-1">
                <Icon Name="newspaper" Size="11" Class="shrink-0" />
                <span class="truncate">Fuente oficial</span>
            </div>
        }
    </div>
</a>

@code {
    /// <summary>Novedad semanal del carril (datos puros; la card no accede a servicios).</summary>
    [Parameter, EditorRequired] public WeeklyReleaseDto Release { get; set; } = null!;
}
