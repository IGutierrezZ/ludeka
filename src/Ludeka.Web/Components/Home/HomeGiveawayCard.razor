@* Tarjeta del carril Sorteos de la portada (INC-35, Decisión 3): estrena el render de
   GiveawayDto.ThumbnailUrl con fallback por dominio (SVG inline temable si falta el
   dato, asset estático de sorteos vía onerror si la URL cae en el navegador), badges
   con Icon sin emojis y la microinteracción .rail-card del PR-1. *@
@using Ludeka.Web.Components.Shared
@using Ludeka.Application.DTOs

<div class="rail-card w-64 sm:w-72 shrink-0 snap-start p-4" role="listitem">
    <div class="rail-cover rail-cover--wide rounded-xl mb-3">
        @if (!string.IsNullOrWhiteSpace(Giveaway.ThumbnailUrl))
        {
            <img src="@Giveaway.ThumbnailUrl"
                 alt="Imagen del sorteo @Giveaway.Title"
                 loading="lazy"
                 decoding="async"
                 width="320"
                 height="180"
                 onerror="this.onerror=null; this.src='/images/defaults/sorteo-default.svg';" />
        }
        else
        {
            <DefaultImage Domain="DefaultImageDomain.Sorteo" CssClass="w-full h-full" />
        }
    </div>

    <div>
        <div class="flex items-center justify-between gap-2 mb-2.5">
            @if (Giveaway.IsPromoted)
            {
                <span class="px-2 py-0.5 rounded-md bg-amber-500/15 border border-amber-500/40 text-amber-400 font-extrabold text-[0.68rem] flex items-center gap-1">
                    <Icon Name="star" Size="12" /> Promocionado
                </span>
            }
            else
            {
                <span class="px-2 py-0.5 rounded-md bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-secondary)] font-semibold text-[0.68rem]">
                    @Giveaway.Platform
                </span>
            }

            <span class="text-[0.68rem] font-bold px-2 py-0.5 rounded-full bg-rose-500/10 text-rose-400 border border-rose-500/20 flex items-center gap-1">
                <Icon Name="timer" Size="12" /> @Giveaway.RemainingTimeText
            </span>
        </div>

        <h3 class="text-sm font-extrabold text-[var(--text-primary)] line-clamp-2 leading-snug mb-1">
            @Giveaway.Title
        </h3>

        <p class="text-xs text-[var(--text-secondary)] mb-3">
            Por <strong class="text-[var(--text-primary)]">@Giveaway.FormattedOrganizer</strong>
        </p>
    </div>

    <a href="@Giveaway.Url"
       target="_blank"
       rel="noopener noreferrer"
       class="w-full text-center py-2 px-3 rounded-xl bg-[var(--bg-surface-elevated)] hover:bg-[var(--brand-primary)] hover:text-white border border-[var(--border-subtle)] font-bold text-xs text-[var(--text-primary)] transition-colors">
        Participar en sorteo &rarr;
    </a>
</div>

@code {
    /// <summary>Sorteo del carril (datos puros; la card no accede a servicios).</summary>
    [Parameter, EditorRequired] public GiveawayDto Giveaway { get; set; } = null!;
}
