@* Tarjeta del carril Eventos de la portada (INC-87): formato vertical compacto equivalente al catálogo (HomeGameCard/HomeGiveawayCard),
   microinteracción .rail-card, portada con badges de país y estado temporal, y enlace directo a la ficha del evento. *@
@using Ludeka.Web.Components.Shared
@using Ludeka.Application.DTOs
@using Ludeka.Core.ValueObjects

<a href="/eventos/@Event.Id"
   class="rail-card w-[28vw] min-w-[105px] max-w-[125px] sm:w-44 md:w-48 shrink-0 snap-start flex flex-col h-full cursor-pointer"
   role="listitem"
   aria-label="Ver ficha del evento @Event.Title">
    <div class="rail-cover rail-cover--square">
        @if (string.IsNullOrWhiteSpace(Event.ImageUrl))
        {
            <DefaultImage Domain="DefaultImageDomain.Evento" CssClass="w-full h-full" />
        }
        else
        {
            <img src="@Event.ImageUrl"
                 alt="Cartel de @Event.Title"
                 loading="lazy"
                 decoding="async"
                 width="192"
                 height="192"
                 onerror="this.onerror=null; this.src='/images/defaults/evento-default.svg';" />
        }

        @* Badge superior izquierdo: País *@
        <div class="absolute top-1.5 left-1.5 sm:top-2 sm:left-2 z-10">
            <span class="px-1.5 sm:px-2 py-0.5 rounded-md text-[0.6rem] sm:text-[0.65rem] font-bold border shadow-md backdrop-blur-md bg-black/80 text-white border-white/20 flex items-center gap-0.5 sm:gap-1">
                <span>@CountryCatalog.GetFlag(Event.Country)</span>
                <span class="hidden sm:inline">@(Event.IsInternational ? "Inter." : Event.Country)</span>
            </span>
        </div>

        @* Badge superior derecho: Estado / Urgencia *@
        <div class="absolute top-1.5 right-1.5 sm:top-2 sm:right-2 z-10 px-1.5 sm:px-2 py-0.5 rounded-md text-[0.6rem] sm:text-[0.65rem] font-black border shadow-md @GetRemainingBadgeClass(Event.RemainingDaysText)">
            @Event.RemainingDaysText
        </div>

        @* Badge flotante inferior con fechas *@
        <div class="absolute bottom-1.5 right-1.5 sm:bottom-2 sm:right-2 z-10 px-1.5 sm:px-2 py-0.5 rounded-md text-[0.6rem] sm:text-[0.65rem] font-bold shadow-md border bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-primary)]">
            @Event.FormattedDates
        </div>
    </div>

    <div class="p-2 sm:p-3 flex flex-col flex-1">
        <div class="flex items-center gap-1 text-[0.65rem] sm:text-[0.7rem] font-semibold text-[var(--text-muted)] mb-1 truncate">
            <Icon Name="map-pin" Size="11" Class="shrink-0" />
            <span class="truncate">@Event.Location</span>
        </div>

        <h3 class="text-xs sm:text-sm font-extrabold text-[var(--text-primary)] line-clamp-2 leading-snug min-h-[2.1rem] sm:min-h-[2.5rem]">
            @Event.Title
        </h3>

        @if (!string.IsNullOrWhiteSpace(Event.Organizer))
        {
            <div class="mt-auto pt-1.5 text-[0.62rem] sm:text-[0.68rem] text-[var(--text-muted)] truncate flex items-center gap-1">
                <Icon Name="users" Size="11" Class="shrink-0" />
                <span class="truncate">@Event.Organizer</span>
            </div>
        }
    </div>
</a>

@code {
    /// <summary>Evento del carril (datos puros; la card no accede a servicios).</summary>
    [Parameter, EditorRequired] public BoardGameEventDto Event { get; set; } = null!;

    private static string GetRemainingBadgeClass(string remainingText)
    {
        if (remainingText.Contains("curso", StringComparison.OrdinalIgnoreCase))
            return "bg-[var(--state-error)] text-[var(--on-brand)] border-[var(--state-error-border)] animate-pulse";

        if (remainingText.Contains("hoy", StringComparison.OrdinalIgnoreCase) || remainingText.Contains("mañana", StringComparison.OrdinalIgnoreCase))
            return "bg-[var(--state-warning)] text-[var(--on-brand)] border-[var(--state-warning-border)] font-black";

        if (remainingText.Contains("Finalizado", StringComparison.OrdinalIgnoreCase))
            return "bg-black/80 text-white/80 border-white/10";

        return "bg-black/80 text-white border-white/20";
    }
}
