@* Cabecera de carril reutilizable de la portada (INC-35, Decisión 3): icono Lucide,
   título en serif display (.rail-title, Decisión 7), contador de títulos y enlace
   opcional "Ver todos…". El carril Eventos no tiene enlace: con Href nulo el enlace no
   se renderiza. El aria-label expone el nombre accesible de la cabecera de la sección. *@
@using Ludeka.Web.Components.Shared

<header class="flex items-center justify-between gap-2" aria-label="@AriaLabel">
    <div class="flex items-center gap-1.5 sm:gap-2 min-w-0">
        <span class="text-[var(--brand-primary)] shrink-0">
            <Icon Name="@IconName" Size="20" />
        </span>
        <h2 class="rail-title text-base sm:text-2xl font-bold truncate">
            @if (!string.IsNullOrWhiteSpace(MobileTitle))
            {
                <span class="sm:hidden">@MobileTitle</span>
                <span class="hidden sm:inline">@Title</span>
            }
            else
            {
                @Title
            }
        </h2>
    </div>

    @if (Href is not null)
    {
        <a href="@Href" class="text-xs sm:text-sm font-bold text-[var(--brand-primary)] hover:underline inline-flex items-center gap-1 shrink-0 whitespace-nowrap">
            <span class="hidden sm:inline">@(LinkText)</span>
            <span class="sm:hidden">Ver todos</span>
            <span aria-hidden="true">&rarr;</span>
        </a>
    }
</header>

@code {
    /// <summary>Nombre kebab-case del icono Lucide del carril (trophy, gift, rocket o tent).</summary>
    [Parameter, EditorRequired] public string IconName { get; set; } = null!;

    /// <summary>Título del carril en serif display.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = null!;

    /// <summary>Título breve opcional para pantallas móviles.</summary>
    [Parameter] public string? MobileTitle { get; set; }

    /// <summary>Número de tarjetas del carril (contador mostrado junto al título).</summary>
    [Parameter] public int Count { get; set; }

    /// <summary>Etiqueta del contador (p. ej. "títulos", "activos" o "eventos").</summary>
    [Parameter, EditorRequired] public string CountLabel { get; set; } = null!;

    /// <summary>Destino del enlace "Ver todos…"; null cuando el carril no tiene (Eventos).</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>Texto visible del enlace "Ver todos…".</summary>
    [Parameter, EditorRequired] public string LinkText { get; set; } = null!;

    /// <summary>Nombre accesible de la cabecera del carril (aria-label del header).</summary>
    [Parameter, EditorRequired] public string AriaLabel { get; set; } = null!;
}
