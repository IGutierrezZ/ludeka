@using System.Threading
@using Ludeka.Application.Contracts
@using Ludeka.Application.DTOs
@using Ludeka.Application.Features.Catalog
@using Ludeka.Core.Enums
@inject ISocialIngestionService IngestionService
@inject ICatalogService CatalogService
@inject ICurrentUserService CurrentUserService
@implements IDisposable

@if (IsOpen && Item != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm animate-fade-in"
         role="dialog"
         aria-modal="true"
         aria-labelledby="edit-inbox-title">
        <div class="relative w-full max-w-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] rounded-3xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
            
            @* Cabecera *@
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)] shrink-0">
                <div class="flex items-center gap-2">
                    <span class="p-2 rounded-xl bg-amber-500/15 text-amber-400">
                        <Icon Name="edit" Size="18" />
                    </span>
                    <div>
                        <h2 id="edit-inbox-title" class="text-base font-black text-[var(--text-primary)]">
                            Editar Datos antes de Publicar
                        </h2>
                        <p class="text-[0.7rem] text-[var(--text-muted)]">
                            Modifica cualquier valor antes de aprobar en el catálogo o radar
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    @if (GetPublishedUrl() is string publishedUrl)
                    {
                        <a href="@publishedUrl"
                           target="_blank"
                           class="px-2.5 py-1.5 rounded-xl bg-emerald-600/10 border border-emerald-500/30 hover:bg-emerald-600/20 text-emerald-600 dark:text-emerald-400 transition-colors flex items-center gap-1.5 text-xs font-semibold"
                           title="Ver contenido publicado">
                            <Icon Name="check-check" Size="14" />
                            <span class="hidden sm:inline">Ver Publicado</span>
                        </a>
                    }
                    <a href="@Item.SourceUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="px-2.5 py-1.5 rounded-xl border border-[var(--border-subtle)] hover:bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors flex items-center gap-1.5 text-xs font-semibold"
                       title="Abrir publicación original en nueva pestaña">
                        <Icon Name="external-link" Size="14" />
                        <span class="hidden sm:inline">Ver Original</span>
                    </a>
                    <button type="button"
                            @onclick="HandleClose"
                            aria-label="Cerrar modal"
                            class="p-2 rounded-full hover:bg-[var(--bg-surface)] text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors">
                        <Icon Name="x" Size="18" />
                    </button>
                </div>
            </div>

            @* Formulario con scroll *@
            <div class="p-6 space-y-4 overflow-y-auto">
                @if (!string.IsNullOrWhiteSpace(_successMessage))
                {
                    <div class="p-3.5 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-xs flex items-center justify-between gap-2">
                        <div class="flex items-center gap-2">
                            <Icon Name="check" Size="16" />
                            <span>@_successMessage</span>
                        </div>
                        <button type="button" @onclick="() => _successMessage = null" class="opacity-70 hover:opacity-100">&times;</button>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="p-3.5 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs flex items-center gap-2">
                        <Icon Name="triangle-alert" Size="16" />
                        <span>@_errorMessage</span>
                    </div>
                }

                @* Aviso de análisis sin IA + Botón de reintento *@
                @if (!Item.IsAiProcessed)
                {
                    <div class="p-3.5 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-600 dark:text-amber-400 text-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <div class="flex items-start gap-2.5">
                            <Icon Name="triangle-alert" Size="18" Class="shrink-0 text-amber-500 mt-0.5" />
                            <div>
                                <span class="font-bold">Publicación procesada sin IA</span>
                                <p class="text-[0.7rem] text-amber-600/90 dark:text-amber-400/90 mt-0.5 leading-relaxed">
                                    @(string.IsNullOrWhiteSpace(Item.AiAnalysisNotes) ? "Esta publicación fue registrada mediante detección heurística o alta manual." : Item.AiAnalysisNotes)
                                </p>
                            </div>
                        </div>
                        <button type="button"
                                @onclick="ReanalyzeWithAiAsync"
                                disabled="@(_isReanalyzing || _isSaving || _isApproving)"
                                class="px-3.5 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs transition-colors shrink-0 flex items-center gap-1.5 shadow-sm disabled:opacity-50">
                            <Icon Name="sparkles" Size="14" Class="@(_isReanalyzing ? "animate-spin" : "")" />
                            <span>@(_isReanalyzing ? "Reanalizando..." : "Reintentar con IA")</span>
                        </button>
                    </div>
                }

                @* Texto original extraído *@
                @if (!string.IsNullOrWhiteSpace(Item.OriginalCaption))
                {
                    <div class="p-3.5 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] space-y-1.5">
                        <div class="flex items-center justify-between text-xs font-bold text-[var(--text-secondary)]">
                            <span class="flex items-center gap-1.5">
                                <Icon Name="file-text" Size="14" />
                                <span>Texto Original Extraído</span>
                            </span>
                            <span class="text-[0.65rem] text-[var(--text-muted)] font-normal">Coteja las bases y requisitos</span>
                        </div>
                        <div class="text-[0.75rem] text-[var(--text-secondary)] bg-[var(--bg-surface-elevated)] p-3 rounded-xl border border-[var(--border-subtle)] max-h-36 overflow-y-auto whitespace-pre-line leading-relaxed select-text font-mono">
                            @Item.OriginalCaption
                        </div>
                    </div>
                }

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5">
                            Tipología de Destino <span class="text-rose-400">*</span>
                        </label>
                        <select @bind="_detectedType"
                                class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]">
                            <option value="@SocialSubmissionType.Giveaway">Sorteo (/sorteos)</option>
                            <option value="@SocialSubmissionType.WeeklyRelease">Novedad Semanal (/novedades)</option>
                            <option value="@SocialSubmissionType.BoardGameEvent">Evento Lúdico (/eventos)</option>
                            <option value="@SocialSubmissionType.MediaItem">Vídeo / Multimedia</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5">
                            Título Editorial <span class="text-rose-400">*</span>
                        </label>
                        <input type="text"
                               @bind="_title"
                               class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5">
                            Organizador, Canal o Editorial <span class="text-rose-400">*</span>
                        </label>
                        <input type="text"
                               @bind="_organizer"
                               class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5">
                            Colaborador (Opcional)
                        </label>
                        <input type="text"
                               @bind="_collaborator"
                               placeholder="Ej. Tienda colaboradora o divulgador"
                               class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                    </div>
                </div>

                @* URL / Enlace Oficial *@
                <div>
                    <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5 flex items-center justify-between">
                        <span>
                            @(_detectedType == SocialSubmissionType.WeeklyRelease ? "Enlace Oficial a la Noticia / Fuente *" : "URL de la Publicación / Enlace de Origen")
                            @if (_detectedType == SocialSubmissionType.WeeklyRelease || _detectedType == SocialSubmissionType.Giveaway)
                            {
                                <span class="text-rose-400">*</span>
                            }
                        </span>
                        @if (!string.IsNullOrWhiteSpace(_sourceUrl))
                        {
                            <a href="@_sourceUrl" target="_blank" rel="noopener noreferrer" class="text-[0.68rem] text-[var(--brand-primary)] hover:underline inline-flex items-center gap-1 font-semibold">
                                <span>Abrir enlace</span>
                                <Icon Name="external-link" Size="11" />
                            </a>
                        }
                    </label>
                    <input type="url"
                           @bind="_sourceUrl"
                           placeholder="https://..."
                           class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                    @if (_detectedType == SocialSubmissionType.WeeklyRelease)
                    {
                        <span class="text-[0.65rem] text-[var(--text-muted)] mt-1 block">
                            Enlace a la noticia en la web de la editorial o blog donde se anunció la novedad (obligatorio como en sorteos).
                        </span>
                    }
                </div>

                @* Buscador reactivo de juego *@
                <div>
                    <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5">
                        Juego del Catálogo Vinculado
                    </label>
                    @if (_gameId.HasValue)
                    {
                        <div class="flex items-center justify-between p-2.5 rounded-xl bg-[var(--brand-primary)]/10 border border-[var(--brand-primary)]/30 text-xs">
                            <span class="font-bold text-[var(--brand-primary)] flex items-center gap-1.5"><Icon Name="dices" Size="14" /> @_gameTitle</span>
                            <button type="button" @onclick="ClearGame" class="text-[var(--text-muted)] hover:text-rose-400">
                                <Icon Name="x" Size="14" />
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="relative">
                            <input type="text"
                                   value="@_gameSearchInput"
                                   @oninput="OnSearchGameInput"
                                   placeholder="Buscar juego en catálogo..."
                                   class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />

                            @if (_gameSuggestions.Count > 0)
                            {
                                <div class="absolute left-0 right-0 top-full mt-1 bg-[var(--bg-card)] border border-[var(--border-subtle)] rounded-xl shadow-xl z-20 max-h-40 overflow-y-auto divide-y divide-[var(--border-subtle)]">
                                    @foreach (var game in _gameSuggestions)
                                    {
                                        <button type="button"
                                                @onclick="() => SelectGame(game)"
                                                class="w-full px-3 py-2 text-left text-xs text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] flex items-center justify-between">
                                            <span class="font-bold">@game.SpanishTitle</span>
                                            <span class="text-[0.65rem] text-[var(--text-muted)]">@game.YearPublished</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5 flex items-center justify-between">
                            <span>
                                @(_detectedType == SocialSubmissionType.Giveaway ? "Fecha Límite Sorteo" : _detectedType == SocialSubmissionType.BoardGameEvent ? "Fecha Inicio Evento" : "Fecha Lanzamiento")
                                @if (_detectedType == SocialSubmissionType.Giveaway)
                                {
                                    <span class="text-rose-400">*</span>
                                }
                            </span>
                            @if (_detectedType == SocialSubmissionType.Giveaway)
                            {
                                <span class="text-[0.65rem] font-normal text-[var(--text-muted)]">Hoy o posterior</span>
                            }
                        </label>
                        <input type="datetime-local"
                               @bind="_eventOrReleaseDate"
                               class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)] @(_detectedType == SocialSubmissionType.Giveaway && (!_eventOrReleaseDate.HasValue || _eventOrReleaseDate.Value.Date < DateTime.UtcNow.Date) ? "border-rose-500/60" : "border-[var(--border-subtle)]")" />
                        @if (_detectedType == SocialSubmissionType.Giveaway && (!_eventOrReleaseDate.HasValue || _eventOrReleaseDate.Value.Date < DateTime.UtcNow.Date))
                        {
                            <p class="text-[0.68rem] text-rose-400 mt-1 flex items-center gap-1 font-medium">
                                <Icon Name="triangle-alert" Size="12" />
                                <span>@(!_eventOrReleaseDate.HasValue ? "Obligatorio indicar fecha límite para poder aprobar el sorteo." : $"Fecha en el pasado ({_eventOrReleaseDate.Value:dd/MM/yyyy}). Debe ser igual o posterior a hoy.")</span>
                            </p>
                        }
                    </div>

                    @if (_detectedType == SocialSubmissionType.BoardGameEvent)
                    {
                        <div>
                            <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5">
                                Fecha Fin Evento
                            </label>
                            <input type="datetime-local"
                                   @bind="_eventEndDate"
                                   class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                        </div>
                    }
                </div>

                @if (_detectedType == SocialSubmissionType.BoardGameEvent)
                {
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5">
                            Ubicación / Ciudad del Evento
                        </label>
                        <input type="text"
                               @bind="_location"
                               placeholder="Ej. IFEMA Madrid, Córdoba..."
                               class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                    </div>
                }
                else if (_detectedType == SocialSubmissionType.Giveaway)
                {
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5">
                            Ámbito Territorial / País del Sorteo
                        </label>
                        <input type="text"
                               @bind="_location"
                               placeholder="Ej. España (Península), Nacional, Internacional..."
                               class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                    </div>
                }

                @if (_detectedType == SocialSubmissionType.WeeklyRelease)
                {
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5">
                            PVP Estimado (€)
                        </label>
                        <input type="number"
                               step="0.5"
                               @bind="_estimatedPvp"
                               placeholder="Ej. 45.00"
                               class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                    </div>
                }

                @if (_detectedType == SocialSubmissionType.MediaItem)
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5">
                                Categoría Multimedia
                            </label>
                            <select @bind="_mediaCategory"
                                    class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)]">
                                <option value="@MediaCategory.Tutorial">Tutorial / Cómo Jugar</option>
                                <option value="@MediaCategory.Gameplay">Partida Completa</option>
                                <option value="@MediaCategory.ReviewOpinion">Reseña / Opinión</option>
                                <option value="@MediaCategory.QuickOverview">Cómo Funciona</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5">
                                Badge de Jugadores
                            </label>
                            <input type="text"
                                   @bind="_playerCountBadge"
                                   placeholder="Ej. Partida a 2"
                                   class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)]" />
                        </div>
                    </div>
                }

                <div>
                    <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5">
                        URL de Portada / Miniatura
                    </label>
                    <input type="text"
                           @bind="_thumbnailUrl"
                           placeholder="https://..."
                           class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5">
                        Notas del Moderador
                    </label>
                    <textarea @bind="_moderatorNotes"
                              rows="2"
                              placeholder="Observaciones internas del equipo de moderación..."
                              class="w-full p-2.5 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)]"></textarea>
                </div>
            </div>

            @* Botones del footer *@
            <div class="flex items-center justify-between gap-3 px-6 py-4 border-t border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)] shrink-0 flex-wrap">
                <button type="button"
                        @onclick="HandleClose"
                        disabled="@(_isSaving || _isApproving || _isReanalyzing)"
                        class="px-4 py-2 rounded-xl border border-[var(--border-subtle)] hover:bg-[var(--bg-surface)] text-xs font-bold text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors">
                    Cancelar
                </button>
                <div class="flex items-center gap-2">
                    <button type="button"
                            @onclick="SaveAsync"
                            disabled="@(_isSaving || _isApproving || _isReanalyzing)"
                            class="px-4 py-2 rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)] hover:border-[var(--brand-primary)] text-xs font-bold text-[var(--text-primary)] transition-all shadow-sm flex items-center gap-1.5 disabled:opacity-50">
                        @if (_isSaving)
                        {
                            <span class="inline-block animate-spin"><Icon Name="refresh-cw" Size="14" /></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <Icon Name="check" Size="14" />
                            <span>Guardar Cambios</span>
                        }
                    </button>
                    <button type="button"
                            @onclick="ApproveDirectlyAsync"
                            disabled="@(_isSaving || _isApproving || _isReanalyzing)"
                            class="px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition-all shadow-sm flex items-center gap-1.5 disabled:opacity-50">
                        @if (_isApproving)
                        {
                            <span class="inline-block animate-spin"><Icon Name="refresh-cw" Size="14" /></span>
                            <span>Aprobando...</span>
                        }
                        else
                        {
                            <Icon Name="check-check" Size="14" />
                            <span>Aprobar y Publicar</span>
                        }
                    </button>
                </div>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public SocialInboxItemDto? Item { get; set; }
    [Parameter] public EventCallback<SocialInboxItemDto> OnSaved { get; set; }
    [Parameter] public EventCallback<SocialInboxItemDto> OnApproved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool _isSaving;
    private bool _isApproving;
    private bool _isReanalyzing;
    private string? _errorMessage;
    private string? _successMessage;

    private string _title = string.Empty;
    private string _organizer = string.Empty;
    private string? _collaborator;
    private SocialSubmissionType _detectedType;
    private Guid? _gameId;
    private string? _gameTitle;
    private DateTime? _eventOrReleaseDate;
    private DateTime? _eventEndDate;
    private string? _location;
    private decimal? _estimatedPvp;
    private MediaCategory? _mediaCategory;
    private string? _playerCountBadge;
    private string? _thumbnailUrl;
    private string? _moderatorNotes;
    private string _sourceUrl = string.Empty;

    private string _gameSearchInput = string.Empty;
    private List<GameSummaryDto> _gameSuggestions = new();
    private System.Threading.Timer? _debounceTimer;
    private CancellationTokenSource? _searchCts;

    protected override void OnParametersSet()
    {
        if (Item != null)
        {
            _title = Item.Title;
            _organizer = Item.OrganizerOrAuthor;
            _collaborator = Item.Collaborator;
            _detectedType = Item.DetectedType;
            _gameId = Item.GameId;
            _gameTitle = Item.GameTitle;
            _eventOrReleaseDate = Item.EventOrReleaseDate?.LocalDateTime;
            _eventEndDate = Item.EventEndDate?.LocalDateTime;
            _location = Item.Location;
            _estimatedPvp = Item.EstimatedPvp;
            _mediaCategory = Item.MediaCategory;
            _playerCountBadge = Item.PlayerCountBadge;
            _thumbnailUrl = Item.ThumbnailUrl;
            _moderatorNotes = Item.ModeratorNotes;
            _sourceUrl = Item.SourceUrl ?? string.Empty;
            _errorMessage = null;
            _successMessage = null;
        }
    }

    private void OnSearchGameInput(ChangeEventArgs e)
    {
        _gameSearchInput = e.Value?.ToString() ?? string.Empty;

        _debounceTimer?.Dispose();
        _debounceTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await SearchGamesAsync();
                StateHasChanged();
            });
        }, null, 250, Timeout.Infinite);
    }

    private async Task SearchGamesAsync()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var ct = _searchCts.Token;

        var term = _gameSearchInput?.Trim();
        if (!string.IsNullOrWhiteSpace(term) && term.Length >= 2)
        {
            try
            {
                var results = await CatalogService.GetQuickSearchAsync(term, limit: 5, ct: ct);
                _gameSuggestions = results.ToList();
            }
            catch (OperationCanceledException)
            {
            }
            catch
            {
                _gameSuggestions.Clear();
            }
        }
        else
        {
            _gameSuggestions.Clear();
        }
    }

    private void SelectGame(GameSummaryDto game)
    {
        _debounceTimer?.Dispose();
        _searchCts?.Cancel();
        _gameId = game.Id;
        _gameTitle = game.SpanishTitle;
        _gameSuggestions.Clear();
        _gameSearchInput = string.Empty;
    }

    private void ClearGame()
    {
        _gameId = null;
        _gameTitle = null;
    }

    private async Task ReanalyzeWithAiAsync()
    {
        if (Item == null) return;
        _isReanalyzing = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var updated = await IngestionService.ReanalyzeWithAiAsync(Item.Id);
            Item = updated;
            _title = updated.Title;
            _organizer = updated.OrganizerOrAuthor;
            _collaborator = updated.Collaborator;
            _detectedType = updated.DetectedType;
            _gameId = updated.GameId;
            _gameTitle = updated.GameTitle;
            _eventOrReleaseDate = updated.EventOrReleaseDate?.LocalDateTime;
            _eventEndDate = updated.EventEndDate?.LocalDateTime;
            _location = updated.Location;
            _estimatedPvp = updated.EstimatedPvp;
            _mediaCategory = updated.MediaCategory;
            _playerCountBadge = updated.PlayerCountBadge;
            _thumbnailUrl = updated.ThumbnailUrl;
            _moderatorNotes = updated.ModeratorNotes;

            _successMessage = "Reanálisis con IA completado con éxito. Se han actualizado los campos.";
            await OnSaved.InvokeAsync(updated);
        }
        catch (Exception ex)
        {
            _errorMessage = $"No se pudo completar el reanálisis con IA: {ex.Message}";
        }
        finally
        {
            _isReanalyzing = false;
        }
    }

    private async Task SaveAsync()
    {
        if (Item == null) return;

        if (string.IsNullOrWhiteSpace(_title))
        {
            _errorMessage = "El título es obligatorio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_organizer))
        {
            _errorMessage = "El organizador es obligatorio.";
            return;
        }

        if (_detectedType == SocialSubmissionType.WeeklyRelease && string.IsNullOrWhiteSpace(_sourceUrl))
        {
            _errorMessage = "El enlace oficial o noticia de la novedad es obligatorio (igual que en sorteos).";
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            DateTimeOffset? startOffset = _eventOrReleaseDate.HasValue
                ? new DateTimeOffset(_eventOrReleaseDate.Value, TimeSpan.Zero)
                : null;

            DateTimeOffset? endOffset = _eventEndDate.HasValue
                ? new DateTimeOffset(_eventEndDate.Value, TimeSpan.Zero)
                : null;

            if (_detectedType == SocialSubmissionType.Giveaway && !endOffset.HasValue && startOffset.HasValue)
            {
                endOffset = startOffset;
            }

            var updateDto = new SocialInboxUpdateDto(
                Id: Item.Id,
                Title: _title,
                OrganizerOrAuthor: _organizer,
                Collaborator: _collaborator,
                DetectedType: _detectedType,
                GameId: _gameId,
                GameTitle: _gameTitle,
                EventOrReleaseDate: startOffset,
                EventEndDate: endOffset,
                Location: _location,
                EstimatedPvp: _estimatedPvp,
                MediaCategory: _mediaCategory,
                PlayerCountBadge: _playerCountBadge,
                ThumbnailUrl: _thumbnailUrl,
                ModeratorNotes: _moderatorNotes,
                SourceUrl: _sourceUrl);

            var updated = await IngestionService.UpdateItemAsync(updateDto);
            await OnSaved.InvokeAsync(updated);
            await HandleClose();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error al guardar: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ApproveDirectlyAsync()
    {
        if (Item == null) return;

        if (string.IsNullOrWhiteSpace(_title) || string.IsNullOrWhiteSpace(_organizer))
        {
            _errorMessage = "El título y el organizador son obligatorios para aprobar.";
            return;
        }

        if (_detectedType == SocialSubmissionType.WeeklyRelease && string.IsNullOrWhiteSpace(_sourceUrl))
        {
            _errorMessage = "Para aprobar una novedad es obligatorio indicar el enlace oficial a la noticia o fuente.";
            return;
        }

        if (_detectedType == SocialSubmissionType.Giveaway)
        {
            var rawDeadline = _eventEndDate ?? _eventOrReleaseDate;
            if (!rawDeadline.HasValue)
            {
                _errorMessage = "Para aprobar un sorteo es obligatorio indicar una fecha de fin igual o posterior a hoy.";
                return;
            }

            if (rawDeadline.Value.Date < DateTime.UtcNow.Date && rawDeadline.Value.ToUniversalTime().Date < DateTime.UtcNow.Date)
            {
                _errorMessage = $"No se puede aprobar un sorteo con una fecha límite en el pasado ({rawDeadline.Value:dd/MM/yyyy}). Debe ser igual o posterior a hoy.";
                return;
            }
        }

        _isApproving = true;
        _errorMessage = null;

        try
        {
            DateTimeOffset? startOffset = _eventOrReleaseDate.HasValue
                ? new DateTimeOffset(_eventOrReleaseDate.Value, TimeSpan.Zero)
                : null;

            DateTimeOffset? endOffset = _eventEndDate.HasValue
                ? new DateTimeOffset(_eventEndDate.Value, TimeSpan.Zero)
                : null;

            if (_detectedType == SocialSubmissionType.Giveaway && !endOffset.HasValue && startOffset.HasValue)
            {
                endOffset = startOffset;
            }

            var updateDto = new SocialInboxUpdateDto(
                Id: Item.Id,
                Title: _title,
                OrganizerOrAuthor: _organizer,
                Collaborator: _collaborator,
                DetectedType: _detectedType,
                GameId: _gameId,
                GameTitle: _gameTitle,
                EventOrReleaseDate: startOffset,
                EventEndDate: endOffset,
                Location: _location,
                EstimatedPvp: _estimatedPvp,
                MediaCategory: _mediaCategory,
                PlayerCountBadge: _playerCountBadge,
                ThumbnailUrl: _thumbnailUrl,
                ModeratorNotes: _moderatorNotes,
                SourceUrl: _sourceUrl);

            var updated = await IngestionService.UpdateItemAsync(updateDto);

            var reviewerId = CurrentUserService.UserId ?? "moderador";
            await IngestionService.ApproveAndPublishAsync(updated.Id, reviewerId);
            var approvedItem = await IngestionService.GetItemByIdAsync(updated.Id);

            await OnApproved.InvokeAsync(approvedItem ?? updated);
            await HandleClose();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error al aprobar: {ex.Message}";
        }
        finally
        {
            _isApproving = false;
        }
    }

    private string? GetPublishedUrl()
    {
        if (Item?.CreatedEntityId == null || Item.CreatedEntityId == Guid.Empty)
            return null;

        return Item.DetectedType switch
        {
            SocialSubmissionType.Giveaway => $"/sorteos/{Item.CreatedEntityId.Value}",
            SocialSubmissionType.WeeklyRelease => "/novedades",
            SocialSubmissionType.BoardGameEvent => "/eventos",
            SocialSubmissionType.MediaItem => "/comunidad",
            _ => null
        };
    }

    private async Task HandleClose()
    {
        _debounceTimer?.Dispose();
        _searchCts?.Cancel();
        _errorMessage = null;
        _successMessage = null;
        await OnClose.InvokeAsync();
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }
}
