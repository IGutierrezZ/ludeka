@using Ludeka.Application.DTOs
@using System.Globalization

<div class="rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)] p-5 sm:p-6 shadow-sm">
    @* Cabecera Editorial con Insignia de IA y Modelo *@
    <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-[var(--border-subtle)]">
        <div class="flex items-center flex-wrap gap-2.5">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-[var(--bg-surface-elevated)] text-[var(--text-primary)] border border-[var(--border-subtle)] shadow-2xs">
                <Icon Name="bot" Size="14" /> Síntesis generada por IA
            </span>
            @if (Summary.GeneratedAt.HasValue)
            {
                <span class="text-[0.68rem] text-[var(--text-muted)]">
                    Generado el @Summary.GeneratedAt.Value.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)
                </span>
            }
        </div>
        <div class="text-[0.68rem] text-[var(--text-muted)] flex items-center gap-1">
            <Icon Name="shield" Size="12" /> Análisis objetivo del hobby
        </div>
    </div>

    @* Contenido estructurado *@
    <div class="mt-4 space-y-4 text-xs sm:text-sm">
        <p class="text-[var(--text-secondary)] leading-relaxed font-normal">
            @Summary.GeneralVerdict
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 pt-2">
            @* Escalabilidad *@
            <div class="p-3.5 rounded-lg bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] space-y-1">
                <span class="text-[0.68rem] font-bold uppercase tracking-wider text-[var(--text-primary)] flex items-center gap-1.5">
                    <Icon Name="users" Size="12" /> Escalabilidad
                </span>
                <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
                    @Summary.ScalabilitySummary
                </p>
            </div>

            @* Edad Real *@
            <div class="p-3.5 rounded-lg bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] space-y-1">
                <span class="text-[0.68rem] font-bold uppercase tracking-wider text-[var(--text-primary)] flex items-center gap-1.5">
                    <Icon Name="baby" Size="12" /> Accesibilidad & Edad
                </span>
                <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
                    @Summary.AgeSummary
                </p>
            </div>

            @* Huella en mesa *@
            <div class="p-3.5 rounded-lg bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] space-y-1">
                <span class="text-[0.68rem] font-bold uppercase tracking-wider text-[var(--text-primary)] flex items-center gap-1.5">
                    <Icon Name="shapes" Size="12" /> Espacio y Tiempo
                </span>
                <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
                    @Summary.FootprintSummary
                </p>
            </div>
        </div>

        @* Banner informativo del ciclo editorial *@
        <div class="p-3 rounded-lg bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[0.72rem] text-[var(--text-muted)] flex items-start gap-2.5">
            <span class="shrink-0"><Icon Name="hourglass" Size="16" /></span>
            <p>
                <strong class="text-[var(--text-secondary)]">Ciclo Editorial Ludeka:</strong> Síntesis objetiva provisional generada mediante IA o motor heurístico basada en el consenso internacional. En cuanto el equipo de la Mesa Fundadora publique su veredicto oficial con fotografías de sesión real, este bloque pasará a segundo plano.
            </p>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public AiGameSummaryDto Summary { get; set; } = null!;
}
