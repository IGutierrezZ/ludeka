@using Ludeka.Application.DTOs
@using Ludeka.Core.Enums
@using Ludeka.Core.ValueObjects

<div class="rail-card flex flex-col justify-between h-full @(Giveaway.IsExpired ? "opacity-60" : string.Empty)">
    <div class="flex flex-col flex-1">
        <a href="/sorteos/@Giveaway.Id"
           class="rail-cover rail-cover--square relative overflow-hidden block group cursor-pointer"
           aria-label="Ver ficha del sorteo @Giveaway.Title">
            @if (string.IsNullOrWhiteSpace(Giveaway.ThumbnailUrl))
            {
                <DefaultImage Domain="DefaultImageDomain.Sorteo"
                              Alt="@($"Imagen del sorteo {Giveaway.Title}")"
                              CssClass="w-full h-full object-cover" />
            }
            else
            {
                <img src="@Giveaway.ThumbnailUrl"
                     alt="Cartel de @Giveaway.Title"
                     width="240"
                     height="240"
                     loading="lazy"
                     decoding="async"
                     onerror="this.onerror=null; this.src='/images/defaults/sorteo-default.svg';"
                     class="w-full h-full object-cover" />
            }

            @* Badges superiores: Promocionado y Exclusivo de Comunidad *@
            <div class="absolute top-2 left-2 z-10 flex flex-col gap-1 items-start">
                @if (Giveaway.IsPromoted)
                {
                    <span class="px-2 py-0.5 rounded-md text-[0.65rem] font-black bg-[var(--state-warning)] text-[var(--on-brand)] shadow-md flex items-center gap-1">
                        <Icon Name="star" Size="11" /> Promocionado
                    </span>
                }
                @if (Giveaway.IsCommunityExclusive)
                {
                    <span class="px-2 py-0.5 rounded-md text-[0.65rem] font-black bg-[var(--brand-primary)] text-[var(--on-brand)] shadow-md flex items-center gap-1">
                        <Icon Name="gift" Size="11" /> Comunidad
                    </span>
                }
            </div>

            @* Badge flotante de tiempo restante (Countdown) *@
            <div class="absolute bottom-2 right-2 z-10 px-2 py-0.5 rounded-md text-[0.65rem] font-bold shadow-md border @GetCountdownBadgeClass(Giveaway.IsExpired, Giveaway.RemainingTimeText)">
                @Giveaway.RemainingTimeText
            </div>
        </a>

        @* Contenido: Metadatos territoriales, Plataforma, Título y Organizador *@
        <div class="p-2 sm:p-3 flex flex-col flex-1">
            <div class="flex items-center justify-between gap-1 text-[0.65rem] sm:text-xs font-semibold text-[var(--text-muted)] mb-1">
                <span class="flex items-center gap-1 truncate">
                    <span>@CountryCatalog.GetFlag(Giveaway.Country)</span>
                    <span class="truncate">@(Giveaway.IsInternational ? "Internacional" : Giveaway.Country)</span>
                </span>
                <span class="flex items-center gap-1 px-1.5 py-0.5 rounded bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-secondary)] shrink-0">
                    <Icon Name="@GetPlatformIcon(Giveaway.Platform)" Size="11" />
                    <span>@Giveaway.Platform</span>
                </span>
            </div>

            <a href="/sorteos/@Giveaway.Id" class="block group mb-1">
                <h3 class="font-extrabold text-xs sm:text-sm text-[var(--text-primary)] group-hover:text-[var(--brand-primary)] transition-colors line-clamp-2 leading-snug">
                    @Giveaway.Title
                </h3>
            </a>

            <div class="text-[0.65rem] sm:text-xs text-[var(--text-secondary)] line-clamp-1 mb-1">
                <span class="text-[var(--text-muted)]">Por:</span> <strong>@Giveaway.FormattedOrganizer</strong>
            </div>

            @if (!string.IsNullOrWhiteSpace(Giveaway.GameTitle))
            {
                <div class="mt-auto pt-1 inline-flex items-center gap-1 text-[0.62rem] sm:text-[0.72rem] text-[var(--text-muted)] line-clamp-1">
                    <Icon Name="dices" Size="12" />
                    <span class="truncate">Juego: <strong class="text-[var(--text-primary)]">@Giveaway.GameTitle</strong></span>
                </div>
            }
        </div>
    </div>

    @* Footer de acciones compactas *@
    <div class="p-2 sm:p-2.5 pt-2 border-t border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)] flex items-center justify-between gap-2 mt-auto">
        <div class="flex flex-col min-w-0">
            <span class="text-[0.62rem] text-[var(--text-muted)] truncate" title="Límite: @Giveaway.DeadlineAt.ToString("dd/MM/yyyy HH:mm")">
                Fin: @Giveaway.DeadlineAt.ToString("dd/MM")
            </span>
            @if (Giveaway.IsPublishedOnInstagram && !string.IsNullOrWhiteSpace(Giveaway.InstagramPermalink))
            {
                <a href="@Giveaway.InstagramPermalink"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="inline-flex items-center gap-1 text-[0.6rem] font-bold text-[var(--state-highlight)] hover:opacity-80">
                    <Icon Name="camera" Size="11" />
                    <span>Instagram</span>
                </a>
            }
            @if (CanModerate && OnTogglePromoted.HasDelegate)
            {
                <button type="button"
                        @onclick="() => OnTogglePromoted.InvokeAsync(Giveaway.Id)"
                        class="text-[0.6rem] font-bold text-left underline transition-colors truncate @(Giveaway.IsPromoted ? "text-[var(--state-warning)]" : "text-[var(--text-muted)]")">
                    @(Giveaway.IsPromoted ? "Desmarcar" : "Destacar")
                </button>
            }
        </div>

        <div class="flex items-center gap-1">
            <a href="/sorteos/@Giveaway.Id"
               class="px-2 py-1 rounded-lg bg-[var(--bg-card)] hover:bg-[var(--bg-surface)] text-[var(--text-primary)] border border-[var(--border-subtle)] font-bold text-[0.68rem] transition-colors"
               title="Ver ficha con todos los detalles">
                Ficha
            </a>
            <a href="@Giveaway.Url"
               target="_blank"
               rel="noopener noreferrer"
               class="px-2.5 py-1 rounded-lg bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-[var(--on-brand)] font-bold text-[0.68rem] transition-colors inline-flex items-center gap-0.5 shadow-sm"
               title="Participar en enlace oficial">
                <span>Participar</span>
                <span>&rarr;</span>
            </a>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public GiveawayDto Giveaway { get; set; } = null!;

    [Parameter]
    public bool CanModerate { get; set; }

    [Parameter]
    public EventCallback<Guid> OnTogglePromoted { get; set; }

    private string GetPlatformIcon(GiveawayPlatform platform) => platform switch
    {
        GiveawayPlatform.Instagram => "camera",
        GiveawayPlatform.TwitterX => "twitter",
        GiveawayPlatform.YouTube => "clapperboard",
        GiveawayPlatform.Community => "dices",
        _ => "link"
    };

    private string GetCountdownBadgeClass(bool isExpired, string remainingText)
    {
        if (isExpired)
            return "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-muted)]";

        if (remainingText.Contains("horas", StringComparison.OrdinalIgnoreCase))
            return "bg-[var(--state-error-bg)] border-[var(--state-error-border)] text-[var(--state-error)] animate-pulse";

        return "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-primary)]";
    }
}
