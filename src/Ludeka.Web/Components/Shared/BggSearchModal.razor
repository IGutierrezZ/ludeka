@using Ludeka.Application.Contracts
@using Ludeka.Application.DTOs
@using Ludeka.Core.Enums
@inject IBggSearchAssistedService SearchAssistedService
@inject NavigationManager Navigation

@if (IsVisible)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-fadeIn"
         role="dialog" aria-modal="true" aria-labelledby="bgg-search-modal-title">
        <div class="bg-[var(--bg-card)] border border-[var(--border-subtle)] rounded-2xl shadow-2xl max-w-lg w-full overflow-hidden flex flex-col max-h-[90vh]">
            
            @* Cabecera del modal *@
            <div class="px-6 py-5 border-b border-[var(--border-subtle)] flex items-center justify-between bg-[var(--bg-surface-elevated)]">
                <div class="flex items-center gap-2.5">
                    <Icon Name="dices" Size="24" />
                    <div>
                        <h3 id="bgg-search-modal-title" class="text-lg font-bold text-[var(--text-primary)] tracking-tight">
                            Buscador Asistido por BGG
                        </h3>
                        <p class="text-xs text-[var(--text-muted)]">Encuentra y añade cualquier juego del mundo al catálogo</p>
                    </div>
                </div>
                <button type="button" 
                        @onclick="Close"
                        class="text-[var(--text-muted)] hover:text-[var(--text-primary)] p-1.5 rounded-lg hover:bg-[var(--bg-surface)] transition-colors"
                        aria-label="Cerrar modal de búsqueda">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            @* Input de búsqueda reactiva *@
            <div class="p-6 border-b border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)] space-y-3">
                <div class="flex gap-2">
                    <div class="relative flex-1">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-[var(--text-muted)] text-sm"><Icon Name="search" Size="14" /></span>
                        <input type="text" 
                               @bind="_query" 
                               @bind:event="oninput"
                               @onkeydown="HandleKeyDown"
                               placeholder="Escribe el nombre del juego (ej. Ark Nova, Dune)..."
                               class="w-full pl-10 pr-4 py-2.5 bg-[var(--bg-card)] border border-[var(--border-subtle)] rounded-xl text-[var(--text-primary)] text-sm placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)] transition-all" />
                    </div>
                    <button type="button" 
                            @onclick="PerformSearchAsync"
                            disabled="@(string.IsNullOrWhiteSpace(_query) || _query.Trim().Length < 2 || _isSearching)"
                            class="px-4 py-2.5 rounded-xl font-bold text-xs bg-[var(--brand-primary)] hover:opacity-90 text-white transition-all disabled:opacity-50 disabled:cursor-not-allowed shadow-sm">
                        @if (_isSearching)
                        {
                            <span>Buscando...</span>
                        }
                        else
                        {
                            <span>Buscar</span>
                        }
                    </button>
                </div>

                <div class="flex items-center gap-2 text-xs">
                    <span class="text-[var(--text-secondary)]">Añadir como:</span>
                    <select @bind="_selectedStatus" class="bg-[var(--bg-card)] border border-[var(--border-subtle)] rounded-lg px-2.5 py-1 text-[var(--text-primary)] text-xs focus:outline-none focus:border-[var(--brand-primary)]">
                        <option value="@CollectionStatus.InCollection">En mi ludoteca</option>
                        <option value="@CollectionStatus.Played">Jugado</option>
                        <option value="@CollectionStatus.WantToBuy">Comprar (Seguimiento)</option>
                    </select>
                </div>
            </div>

            @* Resultados de búsqueda *@
            <div class="p-6 overflow-y-auto flex-1 space-y-3">
                @if (_isAdding)
                {
                    <div class="py-12 text-center space-y-3">
                        <div class="inline-block animate-spin"><Icon Name="settings" Size="36" /></div>
                        <h4 class="text-sm font-bold text-[var(--text-primary)]">@_addingMessage</h4>
                        <p class="text-xs text-[var(--text-muted)]">Creando ficha oficial con ADN lúdico, escalabilidad y ratings...</p>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="p-4 bg-red-500/10 border border-red-500/30 rounded-xl text-xs text-red-600 dark:text-red-300">
                        <span class="inline-flex items-center gap-1.5"><Icon Name="triangle-alert" Size="14" /> @_errorMessage</span>
                    </div>
                }
                else if (_hasSearched && _results.Count == 0 && !_isSearching)
                {
                    <div class="py-10 text-center text-[var(--text-muted)]">
                        <span class="inline-block mb-2"><Icon Name="search-x" Size="30" /></span>
                        <p class="text-xs font-semibold">No se encontraron juegos en BoardGameGeek con ese término.</p>
                    </div>
                }
                else
                {
                    @foreach (var item in _results)
                    {
                        <div class="p-3.5 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] flex items-center justify-between gap-3 hover:border-[var(--border-highlight)] transition-colors">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <h4 class="text-sm font-bold text-[var(--text-primary)] truncate">@item.Title</h4>
                                    @if (item.YearPublished.HasValue)
                                    {
                                        <span class="text-[0.7rem] px-1.5 py-0.5 rounded bg-[var(--bg-card)] text-[var(--text-secondary)] border border-[var(--border-subtle)] font-mono">
                                            @item.YearPublished
                                        </span>
                                    }
                                </div>
                                <div class="flex items-center gap-2 mt-1">
                                    <span class="text-[0.68rem] text-[var(--text-muted)]">BGG ID: @item.BggId</span>
                                    @if (item.IsAlreadyCataloged)
                                    {
                                        <span class="text-[0.68rem] font-bold text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
                                            ✓ Ya en catálogo de Ludeka
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-[0.68rem] font-bold text-[var(--brand-primary)] inline-flex items-center gap-1">
                                            <Icon Name="zap" Size="12" /> Se catalogará al vuelo
                                        </span>
                                    }
                                </div>
                            </div>

                            <div>
                                <button type="button" 
                                        @onclick="() => AddToCollectionAsync(item)"
                                        class="px-3 py-1.5 rounded-xl font-bold text-xs bg-[var(--brand-primary)] hover:opacity-90 text-white transition-opacity shadow-sm flex items-center gap-1.5 whitespace-nowrap">
                                    <span>+ Añadir</span>
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>

            @* Pie del modal *@
            <div class="px-6 py-3.5 border-t border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)] flex justify-end">
                <button type="button" 
                        @onclick="Close"
                        class="py-2 px-4 rounded-xl font-semibold text-xs bg-[var(--bg-card)] hover:bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border-subtle)] transition-colors">
                    Cerrar
                </button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnGameAdded { get; set; }

    private string _query = string.Empty;
    private bool _isSearching = false;
    private bool _isAdding = false;
    private bool _hasSearched = false;
    private string? _addingMessage;
    private string? _errorMessage;
    private IReadOnlyList<BggSearchResultDto> _results = [];
    private CollectionStatus _selectedStatus = CollectionStatus.InCollection;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await PerformSearchAsync();
        }
    }

    private async Task PerformSearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_query) || _query.Trim().Length < 2) return;

        _isSearching = true;
        _errorMessage = null;
        _hasSearched = true;

        try
        {
            _results = await SearchAssistedService.SearchGamesAsync(_query);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error al consultar el buscador de BGG: {ex.Message}";
        }
        finally
        {
            _isSearching = false;
        }
    }

    private async Task AddToCollectionAsync(BggSearchResultDto item)
    {
        _isAdding = true;
        _addingMessage = item.IsAlreadyCataloged 
            ? "Añadiendo a tu ludoteca..." 
            : $"Descargando ficha oficial de {item.Title} desde BGG...";
        _errorMessage = null;

        try
        {
            await SearchAssistedService.AddGameToCollectionAsync(item.BggId, _selectedStatus);
            await OnGameAdded.InvokeAsync();
            await OnClose.InvokeAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
        }
        catch (Exception ex)
        {
            _errorMessage = $"No se pudo añadir el juego: {ex.Message}";
        }
        finally
        {
            _isAdding = false;
        }
    }

    private async Task Close()
    {
        _query = string.Empty;
        _results = [];
        _hasSearched = false;
        _errorMessage = null;
        await OnClose.InvokeAsync();
    }
}
