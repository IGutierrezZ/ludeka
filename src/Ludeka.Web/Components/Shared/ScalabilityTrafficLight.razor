@using Ludeka.Core.Enums
@using Ludeka.Core.ValueObjects

<div class="scalability-component space-y-3">
    <div class="grid grid-cols-7 border-t-[3px] border-[var(--rule)]" role="group" aria-label="Semáforo de jugadores de 1 a 7+">
        @for (int count = 1; count <= 7; count++)
        {
            var pCount = count;
            var labelCount = count == 7 ? "7+" : count.ToString();
            var entry = Entries?.FirstOrDefault(e => count == 7 ? e.PlayerCount >= 7 : e.PlayerCount == count);
            var status = entry?.Status;

            var barColor = status switch
            {
                ScalabilityStatus.MustPlay => "var(--accent-green)",
                ScalabilityStatus.Recommended => "var(--mustard)",
                ScalabilityStatus.NotRecommended => "var(--line)",
                _ => "var(--line)"
            };

            var statusText = status switch
            {
                ScalabilityStatus.MustPlay => "Ideal",
                ScalabilityStatus.Recommended => "Bien",
                ScalabilityStatus.NotRecommended => "No",
                _ => "—"
            };

            var tooltip = entry != null
                ? $"{labelCount} jugadores: {statusText} ({entry.BestVotes} votos mejor, {entry.RecommendedVotes} recomendados)"
                : $"{labelCount} jugadores: Sin datos";

            <div class="py-3 px-1.5 flex flex-col gap-2 border-r last:border-r-0 border-[var(--line)]" title="@tooltip">
                <span class="text-xl sm:text-2xl font-black tracking-tight text-[var(--ink)] pl-1">
                    @labelCount
                </span>
                <span class="h-[10px] w-full rounded-full transition-colors" style="background-color: @barColor" aria-hidden="true"></span>
                <span class="text-[10px] sm:text-[11px] font-extrabold uppercase tracking-wider text-[var(--muted)] pl-1">
                    @statusText
                </span>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(IdealText))
    {
        <p class="text-xs sm:text-sm text-[var(--muted)] flex items-center gap-1.5 pt-1">
            <Icon Name="sparkles" Size="14" class="text-[var(--accent-green)]" />
            <span>Votos de la comunidad. <strong>@IdealText</strong></span>
        </p>
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<ScalabilityEntry>? Entries { get; set; }

    [Parameter]
    public string? IdealText { get; set; }
}
