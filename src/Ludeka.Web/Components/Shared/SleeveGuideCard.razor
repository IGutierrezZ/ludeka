@using Ludeka.Application.Contracts
@using Ludeka.Core.ValueObjects
@inject IUserLocationService LocationService
@inject ISleeveStoreUrlResolver SleeveStoreUrlResolver

<div class="p-5 sm:p-6 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] shadow-sm space-y-4">
    <div class="flex items-center justify-between flex-wrap gap-2 pb-2 border-b border-[var(--border-subtle)]">
        <div class="flex items-center gap-2.5">
            <Icon Name="shield" Size="24" />
            <div>
                <h3 class="font-bold text-base text-[var(--text-primary)] tracking-tight">Protege tu juego: Guía de Fundas</h3>
                <p class="text-xs text-[var(--text-secondary)]">Especificación de cartas, medidas exactas y paquetes recomendados</p>
            </div>
        </div>
        <button type="button" 
                @onclick="ToggleMicronsGuide"
                class="px-2.5 py-1 text-[0.7rem] font-bold rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface-hover)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors flex items-center gap-1.5"
                aria-expanded="@_showMicronsGuide"
                aria-label="Información sobre grosor de fundas (micras)">
            <Icon Name="lightbulb" Size="14" />
            <span>¿Standard o Premium?</span>
        </button>
    </div>

    @* Banner didáctico desplegable de micras *@
    @if (_showMicronsGuide)
    {
        <div class="p-3.5 rounded-xl bg-sky-950/20 border border-sky-500/30 text-xs text-sky-200/90 animate-fade-in space-y-2">
            <div class="flex items-center justify-between font-bold text-sky-300">
                <span class="flex items-center gap-1.5">
                    <Icon Name="ruler" Size="14" /> Guía rápida de grosor (Micras / µm):
                </span>
                <button type="button" @onclick="ToggleMicronsGuide" class="text-sky-400 hover:text-sky-200 text-sm font-bold">&times;</button>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 mt-1 text-[0.75rem]">
                <div class="p-2.5 rounded-lg bg-[var(--bg-card)] border border-sky-500/20">
                    <strong class="text-sky-300 block mb-1">Standard (50 a 60 micras)</strong>
                    <p class="text-sky-100/70">
                        Más finas y económicas. Barajeo suave y flexible. <strong>Caben casi siempre en el inserto original</strong> de plástico de la caja. Ideales para juegos con cientos de cartas.
                    </p>
                </div>
                <div class="p-2.5 rounded-lg bg-[var(--bg-card)] border border-amber-500/20">
                    <strong class="text-amber-300 block mb-1">Premium (90 a 100 micras)</strong>
                    <p class="text-amber-100/70">
                        Máxima rigidez y durabilidad. Protegen de arrugas y líquidos, pero <strong>duplican el grosor del mazo</strong> y a menudo exigen retirar la cuna interior.
                    </p>
                </div>
            </div>
        </div>
    }

    @if (Sleeves != null && Sleeves.Count > 0)
    {
        <div class="space-y-3.5">
            @foreach (var sleeve in Sleeves)
            {
                var options = SleeveStoreUrlResolver.ResolvePurchaseOptions(sleeve, _effectiveCountry);
                var standardFormat = SleeveStoreUrlResolver.MatchStandardFormat(sleeve.WidthMm, sleeve.HeightMm);

                <div class="p-4 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] flex flex-col md:flex-row md:items-center justify-between gap-4 transition-shadow hover:shadow-md">
                    @* Silueta visual de la carta y detalles de medidas *@
                    <div class="flex items-start sm:items-center gap-3.5">
                        @* Silueta gráfica SVG/CSS de la carta *@
                        <div class="relative shrink-0 flex items-center justify-center w-12 h-16 rounded-md border-2 border-dashed border-[var(--border-highlight)] bg-[var(--bg-card)] shadow-inner text-[0.6rem] font-black text-[var(--text-muted)] select-none">
                            <span class="rotate-[-90deg] sm:rotate-0 tracking-tighter">@sleeve.WidthMm.ToString("0.#")&times;@sleeve.HeightMm.ToString("0.#")</span>
                            <div class="absolute -top-1 -right-1 w-2.5 h-2.5 rounded-full bg-[var(--brand-primary)]/80"></div>
                        </div>

                        <div class="space-y-1">
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="font-extrabold text-sm text-[var(--text-primary)]">
                                    @sleeve.FormatName
                                </span>
                                <span class="text-xs font-bold px-2 py-0.5 rounded-md bg-[var(--bg-card)] border border-[var(--border-subtle)] text-[var(--brand-primary)]">
                                    @sleeve.DimensionText
                                </span>
                                @if (standardFormat != null && !string.Equals(standardFormat.Name, sleeve.FormatName, StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="text-[0.65rem] px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-300 border border-emerald-500/20 font-medium">
                                        Eq: @standardFormat.Name
                                    </span>
                                }
                            </div>

                            <div class="text-xs text-[var(--text-secondary)] flex items-center gap-2 flex-wrap">
                                @if (sleeve.CardCount > 0)
                                {
                                    <span class="font-bold text-[var(--text-primary)]">@sleeve.CardCount cartas</span>
                                    <span class="text-[var(--text-muted)]">&bull;</span>
                                    <span class="text-[var(--text-secondary)]">
                                        Requiere: <strong>@sleeve.PacksNeeded50</strong> @(sleeve.PacksNeeded50 == 1 ? "pack" : "packs") de 50 (o <strong>@sleeve.PacksNeeded100</strong> de 100)
                                    </span>
                                }
                                else
                                {
                                    <span class="font-bold text-[var(--text-primary)]">Recuento no especificado</span>
                                    <span class="text-[var(--text-muted)] italic text-[0.7rem]">(consulta los componentes de tu edición)</span>
                                }
                            </div>
                        </div>
                    </div>

                    @* Enlaces y Botones de Compra Contextuales por Tienda *@
                    <div class="flex items-center flex-wrap gap-2 self-start md:self-auto">
                        @if (options.Count > 0)
                        {
                            @foreach (var opt in options)
                            {
                                <a href="@opt.PurchaseUrl" 
                                   target="_blank" 
                                   rel="noopener noreferrer sponsored"
                                   title="Comprar fundas compatibles en @opt.StoreName"
                                   class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-bold bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-white transition-all shadow-sm active:scale-95">
                                    <Icon Name="shopping-cart" Size="14" />
                                    <span>Comprar en @opt.StoreName</span>
                                    @if (!string.IsNullOrWhiteSpace(opt.Badge))
                                    {
                                        <span class="hidden sm:inline-block text-[0.65rem] font-medium opacity-90 px-1 py-0.2 bg-black/20 rounded">
                                            @opt.Badge
                                        </span>
                                    }
                                    <span class="text-[0.7rem]">&rarr;</span>
                                </a>
                            }
                        }
                        else if (!string.IsNullOrWhiteSpace(_effectiveCountry))
                        {
                            <span class="text-xs text-[var(--text-muted)] italic px-2 py-1 rounded bg-[var(--bg-card)] border border-[var(--border-subtle)]">
                                Sin ofertas directas para @_effectiveCountry
                            </span>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        @if (HasNoCards)
        {
            <div class="p-4 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] flex items-center gap-3">
                <Icon Name="party-popper" Size="24" />
                <p class="text-xs text-[var(--text-secondary)]">
                    <strong class="text-[var(--text-primary)]">¡Buenas noticias!</strong> Este juego no contiene cartas que requieran fundas o no tiene componentes enfundables.
                </p>
            </div>
        }
        else
        {
            <div class="p-4 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                    <Icon Name="info" Size="20" class="text-[var(--text-muted)] shrink-0" />
                    <p class="text-xs text-[var(--text-secondary)]">
                        <strong class="text-[var(--text-primary)]">Sin especificación registrada de fundas.</strong> Si este juego contiene cartas en tu edición, puedes consultar o añadir las medidas exactas.
                    </p>
                </div>
                @if (OnOpenEditor.HasDelegate)
                {
                    <button type="button" @onclick="OnOpenEditor" class="shrink-0 px-3 py-1.5 rounded-lg text-xs font-bold border border-[var(--border-subtle)] bg-[var(--bg-card)] hover:bg-[var(--bg-surface-hover)] text-[var(--text-primary)] transition-colors flex items-center gap-1.5">
                        <Icon Name="edit" Size="14" />
                        <span>Añadir fundas</span>
                    </button>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<SleeveItem>? Sleeves { get; set; }

    [Parameter]
    public bool HasNoCards { get; set; } = false;

    [Parameter]
    public EventCallback OnOpenEditor { get; set; }

    private string? _effectiveCountry;
    private bool _showMicronsGuide = false;

    protected override async Task OnParametersSetAsync()
    {
        _effectiveCountry = await LocationService.GetEffectiveCountryAsync();
    }

    private void ToggleMicronsGuide()
    {
        _showMicronsGuide = !_showMicronsGuide;
    }
}
