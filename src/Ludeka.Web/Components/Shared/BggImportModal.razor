@using Ludeka.Application.Contracts
@using Ludeka.Application.DTOs
@using Ludeka.Core.Enums
@inject IBggImportService BggImportService
@inject NavigationManager Navigation

@if (IsVisible)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-fadeIn"
         role="dialog" aria-modal="true" aria-labelledby="bgg-import-modal-title">
        <div class="bg-[var(--bg-card)] border border-[var(--border-subtle)] rounded-2xl shadow-2xl max-w-lg w-full overflow-hidden flex flex-col">
            
            @* Cabecera del modal *@
            <div class="px-6 py-5 border-b border-[var(--border-subtle)] flex items-center justify-between bg-[var(--bg-surface-elevated)]">
                <div class="flex items-center gap-2.5">
                    <Icon Name="inbox" Size="24" aria-hidden="true" />
                    <div>
                        <h3 id="bgg-import-modal-title" class="text-lg font-bold text-[var(--text-primary)] tracking-tight">
                            Importar desde BoardGameGeek
                        </h3>
                        <p class="text-xs text-[var(--text-muted)]">Sincroniza tus juegos de mesa en 1 clic</p>
                    </div>
                </div>
                <button type="button" 
                        @onclick="Close"
                        class="text-[var(--text-muted)] hover:text-[var(--text-primary)] p-1.5 rounded-lg hover:bg-[var(--bg-surface)] transition-colors"
                        aria-label="Cerrar modal de importación">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            @* Cuerpo del modal *@
            <div class="p-6 space-y-5">
                @if (_isProcessing)
                {
                    <div class="py-8 text-center space-y-4" role="status" aria-live="polite">
                        @if (_currentProgress?.Phase == BggImportPhase.PreparingInBgg)
                        {
                            <div class="inline-block animate-spin" style="animation-duration: 3s;"><Icon Name="hourglass" Size="48" /></div>
                            <h4 class="text-base font-bold text-[var(--text-primary)]">
                                BGG está preparando tu colección...
                            </h4>
                            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-600 dark:text-amber-400 text-xs font-semibold">
                                <span>Sondeo adaptativo</span>
                                <span>•</span>
                                <span>Intento @(_currentProgress.CurrentAttempt) de @(_currentProgress.MaxAttempts)</span>
                                @if (_currentProgress.WaitSeconds.HasValue)
                                {
                                    <span>•</span>
                                    <span>Espera: @(_currentProgress.WaitSeconds)s</span>
                                }
                            </div>
                            <p class="text-xs text-[var(--text-muted)] max-w-sm mx-auto leading-relaxed">
                                @(_currentProgress.Message)
                            </p>
                            <p class="text-[0.75rem] text-[var(--text-secondary)] bg-[var(--bg-surface-elevated)] p-2.5 rounded-xl border border-[var(--border-subtle)] max-w-sm mx-auto">
                                <Icon Name="lightbulb" Size="14" /> <em>BGG genera colecciones asíncronamente en servidores externos. No cierres esta ventana.</em>
                            </p>
                        }
                        else if (_currentProgress?.Phase == BggImportPhase.RateLimitedWaiting)
                        {
                            <div class="inline-block animate-pulse"><Icon Name="timer" Size="48" /></div>
                            <h4 class="text-base font-bold text-amber-600 dark:text-amber-400">
                                Aviso de saturación en BoardGameGeek
                            </h4>
                            <div class="p-3 bg-amber-500/10 border border-amber-500/30 rounded-xl text-xs text-amber-700 dark:text-amber-300 text-left max-w-md mx-auto space-y-1">
                                <p class="font-bold flex items-center gap-1.5">
                                    <span class="inline-flex items-center gap-1"><Icon Name="hourglass" Size="12" /> Pausa de cortesía obligatoria</span>
                                </p>
                                <p>@(_currentProgress.Message)</p>
                                <p class="text-[0.7rem] opacity-90">
                                    Aguardamos el tiempo solicitado por BGG (Retry-After) para evitar bloqueos por IP.
                                </p>
                            </div>
                        }
                        else if (_currentProgress?.Phase == BggImportPhase.ProcessingItems)
                        {
                            <div class="inline-block animate-bounce"><Icon Name="package" Size="48" /></div>
                            <h4 class="text-base font-bold text-[var(--text-primary)]">
                                ¡Colección descargada! Procesando juegos...
                            </h4>
                            <p class="text-xs text-[var(--text-muted)] max-w-sm mx-auto">
                                @(_currentProgress.Message)
                            </p>
                            @if (_currentProgress.ItemsFound > 0)
                            {
                                <span class="inline-block px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/30 text-indigo-600 dark:text-indigo-400 text-xs font-semibold">
                                    @_currentProgress.ItemsFound títulos encontrados
                                </span>
                            }
                        }
                        else
                        {
                            <div class="inline-block animate-bounce"><Icon Name="dices" Size="48" /></div>
                            <h4 class="text-base font-bold text-[var(--text-primary)]">Sincronizando con BoardGameGeek...</h4>
                            <p class="text-xs text-[var(--text-muted)] max-w-sm mx-auto">
                                @(_currentProgress?.Message ?? "Conectando con la API oficial de BGG y cruzando datos...")
                            </p>
                        }

                        <div class="w-56 h-2 bg-[var(--bg-surface-elevated)] rounded-full mx-auto overflow-hidden mt-2">
                            <div class="h-full bg-[var(--brand-primary)] rounded-full animate-pulse w-4/5"></div>
                        </div>
                    </div>
                }
                else if (_result != null)
                {
                    <div class="space-y-4">
                        <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/25 text-center">
                            <span class="inline-block mb-2" aria-hidden="true"><Icon Name="party-popper" Size="30" /></span>
                            <h4 class="text-base font-bold text-emerald-600 dark:text-emerald-300">¡Colección sincronizada con éxito!</h4>
                            <p class="text-xs text-[var(--text-secondary)] mt-1">
                                Procesados un total de <strong>@_result.TotalProcessed</strong> juegos de tu perfil.
                            </p>
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div class="p-4 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-center">
                                <span class="inline-block mb-1" aria-hidden="true"><Icon Name="circle-check" Size="24" /></span>
                                <div class="text-2xl font-bold text-[var(--text-primary)]">@_result.ImportedToCollection</div>
                                <div class="text-xs font-semibold text-[var(--text-secondary)] mt-0.5">En tu ludoteca ahora</div>
                            </div>
                            <div class="p-4 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-center">
                                <span class="inline-block mb-1" aria-hidden="true"><Icon Name="hourglass" Size="24" /></span>
                                <div class="text-2xl font-bold text-amber-600 dark:text-amber-300">@_result.EnqueuedForCataloging</div>
                                <div class="text-xs font-semibold text-[var(--text-secondary)] mt-0.5">En cola de catalogación</div>
                            </div>
                        </div>

                        <p class="text-[0.75rem] text-[var(--text-muted)] bg-[var(--bg-surface-elevated)] p-3 rounded-xl border border-[var(--border-subtle)] leading-relaxed">
                            <Icon Name="lightbulb" Size="14" /> <strong>¿Qué son los juegos en cola?</strong> Son títulos que aún no tienen ficha oficial en Ludeka. Ya puedes gestionarlos y prestarles, y nuestro motor de auto-catalogación creará su ficha oficial pronto.
                        </p>

                        @if (_result.Errors.Count > 0)
                        {
                            <div class="p-3 bg-red-500/10 border border-red-500/30 rounded-xl text-xs text-red-600 dark:text-red-300">
                                <strong>Avisos durante la importación (@_result.Errors.Count):</strong>
                                <ul class="list-disc list-inside mt-1 space-y-0.5">
                                    @foreach (var err in _result.Errors.Take(3))
                                    {
                                        <li class="truncate">@err</li>
                                    }
                                </ul>
                            </div>
                        }

                        <button type="button" 
                                @onclick="CloseAndRefresh"
                                class="w-full py-3 px-4 rounded-xl font-bold text-sm bg-[var(--brand-primary)] hover:opacity-90 text-white transition-opacity shadow-sm">
                            ¡Ver mi ludoteca actualizada!
                        </button>
                    </div>
                }
                else
                {
                    <div class="space-y-4">
                        <div>
                            <label for="bgg-username" class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider mb-2">
                                Usuario de BoardGameGeek
                            </label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-[var(--text-muted)] text-sm" aria-hidden="true"><Icon Name="user" Size="14" /></span>
                                <input id="bgg-username" 
                                       type="text" 
                                       @bind="_username" 
                                       @bind:event="oninput"
                                       placeholder="Ej. ludomaster99"
                                       class="w-full pl-10 pr-4 py-2.5 bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] rounded-xl text-[var(--text-primary)] text-sm placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)] transition-all" />
                            </div>
                        </div>

                        <div class="space-y-2 pt-1">
                            <span class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider">
                                Listas a Importar
                            </span>
                            <label class="flex items-center gap-3 p-3 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] hover:border-[var(--border-highlight)] cursor-pointer transition-colors">
                                <input type="checkbox" @bind="_importOwned" class="w-4 h-4 rounded text-[var(--brand-primary)] focus:ring-[var(--brand-primary)]" />
                                <div class="text-xs">
                                    <strong class="text-[var(--text-primary)] block">Juegos en propiedad (Owned)</strong>
                                    <span class="text-[var(--text-muted)]">Se añadirán a tu pestaña <em>En mi ludoteca</em></span>
                                </div>
                            </label>
                            <label class="flex items-center gap-3 p-3 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] hover:border-[var(--border-highlight)] cursor-pointer transition-colors">
                                <input type="checkbox" @bind="_importWishlist" class="w-4 h-4 rounded text-[var(--brand-primary)] focus:ring-[var(--brand-primary)]" />
                                <div class="text-xs">
                                    <strong class="text-[var(--text-primary)] block">Lista de deseos (Wishlist & Want to Buy)</strong>
                                    <span class="text-[var(--text-muted)]">Se añadirán a <em>Deseados</em> o <em>Quiero comprar</em></span>
                                </div>
                            </label>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_errorMessage))
                        {
                            <div class="p-3 bg-red-500/10 border border-red-500/30 rounded-xl text-xs text-red-600 dark:text-red-300 flex items-center gap-2">
                                <Icon Name="triangle-alert" Size="14" aria-hidden="true" />
                                <span>@_errorMessage</span>
                            </div>
                        }

                        <div class="pt-2 flex gap-3">
                            <button type="button" 
                                    @onclick="Close"
                                    class="flex-1 py-2.5 px-4 rounded-xl font-semibold text-xs bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border-subtle)] transition-colors">
                                Cancelar
                            </button>
                            <button type="button" 
                                    @onclick="StartImportAsync"
                                    disabled="@(string.IsNullOrWhiteSpace(_username))"
                                    class="flex-1 py-2.5 px-4 rounded-xl font-bold text-xs bg-[var(--brand-primary)] hover:opacity-90 text-white transition-opacity disabled:opacity-50 disabled:cursor-not-allowed shadow-sm">
                                Importar Colección
                            </button>
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnImportCompleted { get; set; }

    private string _username = string.Empty;
    private bool _importOwned = true;
    private bool _importWishlist = true;
    private bool _isProcessing = false;
    private string? _errorMessage;
    private BggImportResultDto? _result;
    private BggImportProgressReport? _currentProgress;

    private async Task StartImportAsync()
    {
        if (string.IsNullOrWhiteSpace(_username)) return;

        _isProcessing = true;
        _errorMessage = null;
        _result = null;
        _currentProgress = new BggImportProgressReport(BggImportPhase.Initializing, "Iniciando solicitud a BoardGameGeek...");

        var progressReporter = new Progress<BggImportProgressReport>(report =>
        {
            _currentProgress = report;
            InvokeAsync(StateHasChanged);
        });

        try
        {
            var request = new BggImportRequest(_username.Trim(), _importOwned, _importWishlist);
            _result = await BggImportService.ImportUserCollectionAsync(request, progressReporter);
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
        }
        catch (Exception ex)
        {
            _errorMessage = $"No se pudo importar la colección: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task Close()
    {
        _result = null;
        _errorMessage = null;
        _currentProgress = null;
        await OnClose.InvokeAsync();
    }

    private async Task CloseAndRefresh()
    {
        _result = null;
        _errorMessage = null;
        _currentProgress = null;
        await OnImportCompleted.InvokeAsync();
        await OnClose.InvokeAsync();
    }
}
