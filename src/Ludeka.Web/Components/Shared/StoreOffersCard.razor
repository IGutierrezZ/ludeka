@using Ludeka.Application.Contracts
@using Ludeka.Core.Enums
@using Ludeka.Core.ValueObjects
@inject IUserLocationService LocationService
@inject IStoreStockService StockService
@inject IAffiliateUrlResolver AffiliateResolver
@inject IPriceRadarService PriceRadarService

@if (IsSidebar)
{
    <div id="donde-comprar" class="flex flex-col">
        <div class="flex items-center justify-between pb-2.5 border-b-[3px] border-[var(--rule)]">
            <b class="text-[13px] font-extrabold uppercase tracking-[0.14em] text-[var(--ink)]">Dónde comprar</b>
            @if (_priceMetrics?.AllTimeLowPrice.HasValue == true)
            {
                <span class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400 inline-flex items-center gap-1" title="@($"Mínimo histórico registrado: {_priceMetrics.AllTimeLowPrice:0.00} €")">
                    <Icon Name="trending-down" Size="11" />
                    <span>Mínimo: @_priceMetrics.AllTimeLowPrice.Value.ToString("0.00") €</span>
                </span>
            }
        </div>

        @if (!_isReferenceFallback && _displayedOffers != null && _displayedOffers.Count > 0)
        {
            <div class="flex flex-col">
                @foreach (var offer in _displayedOffers)
                {
                    var stock = GetOfferStock(offer);
                    var isOutOfStock = stock != null && stock.IsOutOfStock;
                    var storeSlug = Ludeka.Core.Entities.Game.GenerateSlug(offer.StoreName);
                    var targetPurchaseUrl = !string.IsNullOrWhiteSpace(GameSlug)
                        ? $"/r/comprar/{GameSlug}/{storeSlug}"
                        : AffiliateResolver.ResolveAffiliateUrl(offer.AffiliateUrl, offer.StoreName);

                    <a href="@targetPurchaseUrl"
                       target="_blank"
                       rel="noopener noreferrer sponsored"
                       aria-label="Comprar @(string.IsNullOrWhiteSpace(GameTitle) ? "juego" : GameTitle) en @offer.StoreName"
                       class="flex justify-between items-center gap-3 py-3 border-b border-[var(--line)] group transition-colors hover:bg-[var(--paper-2)]/60 -mx-1 px-1 rounded-lg @(isOutOfStock ? "opacity-70" : "")">
                        <span class="flex flex-col gap-1 min-w-0">
                            <b class="text-[15px] font-extrabold text-[var(--ink)] group-hover:text-[var(--accent)] transition-colors truncate">
                                @offer.StoreName
                            </b>
                            <span class="text-xs font-extrabold flex items-center gap-1.5 flex-wrap">
                                @if (isOutOfStock)
                                {
                                    <span class="w-2 h-2 rounded-full bg-[var(--muted)] inline-block"></span>
                                    <span class="text-[var(--muted)]">Sin stock</span>
                                }
                                else if (stock?.IsInStock == true)
                                {
                                    <span class="w-2 h-2 rounded-full bg-[var(--accent-green)] inline-block"></span>
                                    <span class="text-[var(--accent-green)]">En stock@(stock.AvailableQuantity.HasValue ? $" ({stock.AvailableQuantity} uds)" : "")</span>
                                }
                                else if (!offer.Price.HasValue)
                                {
                                    <span class="w-2 h-2 rounded-full bg-[var(--muted)] inline-block"></span>
                                    <span class="text-[var(--muted)]">Buscar en tienda</span>
                                }
                                else
                                {
                                    <span class="w-2 h-2 rounded-full bg-[var(--mustard)] inline-block"></span>
                                    <span class="text-[var(--mustard)]">Pocas unidades</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(offer.Badge))
                                {
                                    <span class="text-[var(--muted)]">&bull; @offer.Badge</span>
                                }
                            </span>
                        </span>
                        <div class="text-right shrink-0">
                            @if (stock?.CurrentPrice.HasValue == true)
                            {
                                <b class="text-[20px] font-black tracking-[-0.02em] leading-none @(isOutOfStock ? "text-[var(--muted)]" : "text-[var(--accent)]")">
                                    @($"{stock.CurrentPrice.Value:0.00} {offer.Currency}")
                                </b>
                            }
                            else if (offer.Price.HasValue)
                            {
                                <b class="text-[20px] font-black tracking-[-0.02em] leading-none @(isOutOfStock ? "text-[var(--muted)]" : "text-[var(--accent)]")">
                                    @offer.FormattedPrice
                                </b>
                            }
                            else
                            {
                                <span class="text-xs font-extrabold text-[var(--ink)] underline">Buscar &nearr;</span>
                            }
                        </div>
                    </a>
                }
            </div>
        }
        else if (_isReferenceFallback && _displayedOffers != null && _displayedOffers.Count > 0)
        {
            <div class="flex flex-col">
                <span class="py-2 text-xs text-[var(--muted)]">Sin precios ni stock confirmados. Busca en:</span>
                @foreach (var offer in _displayedOffers)
                {
                    var storeSlug = Ludeka.Core.Entities.Game.GenerateSlug(offer.StoreName);
                    var targetPurchaseUrl = !string.IsNullOrWhiteSpace(GameSlug)
                        ? $"/r/comprar/{GameSlug}/{storeSlug}"
                        : AffiliateResolver.ResolveAffiliateUrl(offer.AffiliateUrl, offer.StoreName);

                    <a href="@targetPurchaseUrl"
                       target="_blank"
                       rel="noopener noreferrer sponsored"
                       aria-label="Buscar @(string.IsNullOrWhiteSpace(GameTitle) ? "juego" : GameTitle) en @offer.StoreName"
                       class="flex justify-between items-center gap-3 py-2.5 border-b border-[var(--line)] group transition-colors hover:bg-[var(--paper-2)]/60 -mx-1 px-1 rounded-lg">
                        <span class="text-sm font-bold text-[var(--ink)] group-hover:text-[var(--accent)] transition-colors">
                            Buscar en @offer.StoreName
                        </span>
                        <span class="text-sm text-[var(--muted)] group-hover:text-[var(--accent)]">&nearr;</span>
                    </a>
                }
            </div>
        }
        else
        {
            <span class="py-3 text-xs text-[var(--muted)]">Sin ofertas disponibles por el momento.</span>
        }

        <span class="mt-3.5 mb-2 text-xs text-[var(--muted)]">Enlaces de afiliado sin coste adicional para ti.</span>
    </div>
}
else
{
<div id="donde-comprar" class="p-6 rounded-[24px] bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-4 shadow-sm">
    <div class="flex items-center justify-between flex-wrap gap-2">
        <div class="flex items-center gap-2.5">
            <Icon Name="shopping-cart" Size="20" />
            <div>
                <div class="flex items-center gap-2 flex-wrap">
                    <h2 class="font-bold text-base text-[var(--text-primary)] leading-tight">Dónde Comprar</h2>
                    @if (!string.IsNullOrWhiteSpace(_effectiveCountry))
                    {
                        <span class="px-2 py-0.5 rounded-md text-[0.68rem] font-bold bg-amber-500/10 text-amber-500 border border-amber-500/30 inline-flex items-center gap-1">
                            <span>@CountryCatalog.GetFlag(_effectiveCountry)</span>
                            <span>@_effectiveCountry</span>
                        </span>
                    }
                    @if (_priceMetrics?.AllTimeLowPrice.HasValue == true)
                    {
                        <span class="px-2.5 py-0.5 rounded-md text-[0.68rem] font-bold bg-emerald-500/10 text-emerald-500 border border-emerald-500/30 inline-flex items-center gap-1" title="@($"Mínimo histórico registrado: {_priceMetrics.AllTimeLowPrice:0.00} €")">
                            <Icon Name="trending-down" Size="12" />
                            <span>Mínimo histórico: @_priceMetrics.AllTimeLowPrice.Value.ToString("0.00") €</span>
                            @if (!string.IsNullOrWhiteSpace(_priceMetrics.AllTimeLowStore))
                            {
                                <span class="opacity-75 font-normal">(@_priceMetrics.AllTimeLowStore)</span>
                            }
                        </span>
                    }
                    @if (_isCheckingStock)
                    {
                        <span class="px-2 py-0.5 rounded-md text-[0.65rem] font-medium bg-slate-500/10 text-slate-400 border border-slate-500/20 inline-flex items-center gap-1 animate-pulse">
                            <Icon Name="settings" Size="12" />
                            <span>Verificando stock en vivo...</span>
                        </span>
                    }
                </div>
                @if (_isReferenceFallback)
                {
                    <p class="text-xs text-[var(--text-secondary)]">Búsqueda directa en catálogo de tiendas especializadas de España</p>
                }
                else
                {
                    <p class="text-xs text-[var(--text-secondary)]">Tiendas colaboradoras con verificación de disponibilidad en tiempo real</p>
                }
            </div>
        </div>
        <a href="/transparencia" class="text-[0.7rem] font-medium text-[var(--text-muted)] hover:text-[var(--brand-primary)] transition-colors flex items-center gap-1">
            <Icon Name="shield" Size="12" /> 100% Transparente
        </a>
    </div>

    @if (!_isReferenceFallback && _displayedOffers != null && _displayedOffers.Count > 0)
    {
        <div class="@(IsSidebar ? "grid grid-cols-1 gap-2.5" : "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3")">
            @foreach (var offer in _displayedOffers)
            {
                var stock = GetOfferStock(offer);
                var isOutOfStock = stock != null && stock.IsOutOfStock;

                <div class="p-4 rounded-xl bg-[var(--bg-surface-elevated)] border @(isOutOfStock ? "border-rose-500/20 opacity-90" : "border-[var(--border-subtle)] hover:border-[var(--border-highlight)]") flex flex-col justify-between gap-3 transition-all group">
                    <div class="space-y-1.5">
                        <div class="flex items-start justify-between gap-2">
                            <a href="@($"/tiendas/{Ludeka.Core.Entities.Game.GenerateSlug(offer.StoreName)}")"
                               class="font-bold text-sm text-[var(--text-primary)] hover:text-[var(--brand-primary)] transition-colors inline-flex items-center gap-1"
                               title="Ver ficha de @offer.StoreName en el directorio de tiendas">
                                <span>@offer.StoreName</span>
                                <span class="text-[0.65rem] opacity-70">&nearr;</span>
                            </a>
                            @if (!string.IsNullOrWhiteSpace(offer.Badge))
                            {
                                <span class="px-2 py-0.5 rounded-md bg-[var(--bg-card)] text-[var(--brand-primary)] border border-[var(--border-subtle)] font-bold text-[0.65rem] tracking-wide">
                                    @offer.Badge
                                </span>
                            }
                        </div>

                        @* Badge territorial de la tienda *@
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <span class="inline-flex items-center gap-1 text-[0.68rem] px-2 py-0.5 rounded-md bg-[var(--bg-card)] border border-[var(--border-subtle)] text-[var(--text-secondary)] font-medium">
                                <span>@CountryCatalog.GetFlag(offer.Country)</span>
                                <span>@offer.Country</span>
                            </span>
                            @if (offer.ShippingCountries != null && offer.ShippingCountries.Count > 1)
                            {
                                <span class="text-[0.65rem] text-[var(--text-muted)]" title="Envíos a: @string.Join(", ", offer.ShippingCountries)">
                                    <Icon Name="plane" Size="12" /> Envíos a @offer.ShippingCountries.Count países
                                </span>
                            }
                        </div>

                        @* Precio orientativo o en vivo *@
                        <div class="flex items-baseline gap-2 pt-1 flex-wrap">
                            @if (stock?.CurrentPrice.HasValue == true)
                            {
                                <span class="text-lg font-black text-[var(--text-primary)]">
                                    @($"{stock.CurrentPrice.Value:0.00} {offer.Currency}")
                                </span>
                                <span class="text-[0.65rem] px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 font-semibold border border-emerald-500/20">En vivo</span>
                                @if (_priceMetrics?.AllTimeLowPrice.HasValue == true && stock.CurrentPrice.Value <= _priceMetrics.AllTimeLowPrice.Value + 0.01m)
                                {
                                    <span class="text-[0.65rem] px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 font-bold border border-emerald-500/30 inline-flex items-center gap-0.5">
                                        <Icon Name="trending-down" Size="10" /> Mínimo histórico
                                    </span>
                                }
                            }
                            else if (offer.Price.HasValue)
                            {
                                <span class="text-lg font-black text-[var(--text-primary)]">
                                    @offer.FormattedPrice
                                </span>
                                <span class="text-[0.65rem] text-[var(--text-muted)]">PVP orientativo</span>
                                @if (_priceMetrics?.AllTimeLowPrice.HasValue == true && offer.Price.Value <= _priceMetrics.AllTimeLowPrice.Value + 0.01m)
                                {
                                    <span class="text-[0.65rem] px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 font-bold border border-emerald-500/30 inline-flex items-center gap-0.5">
                                        <Icon Name="trending-down" Size="10" /> Mínimo histórico
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-xs font-bold text-[var(--text-secondary)]">Búsqueda en catálogo</span>
                                <span class="text-[0.65rem] px-1.5 py-0.5 rounded bg-blue-500/10 text-blue-400 font-semibold border border-blue-500/20">En directo</span>
                            }
                        </div>

                        @* Estado y semáforo de disponibilidad en tiempo real *@
                        <div class="pt-0.5">
                            @if (stock == null || stock.IsChecking)
                            {
                                <div class="flex items-center gap-1.5 animate-pulse">
                                    <span class="inline-block w-2 h-2 rounded-full bg-slate-400"></span>
                                    <span class="text-[0.7rem] font-medium text-slate-400">Consultando disponibilidad...</span>
                                </div>
                            }
                            else if (stock.IsInStock)
                            {
                                <div class="flex items-center justify-between gap-1.5">
                                    <div class="flex items-center gap-1.5">
                                        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
                                        <span class="text-[0.7rem] font-semibold text-emerald-400">
                                            @(stock.AvailableQuantity.HasValue ? $"En stock ({stock.AvailableQuantity} uds)" : "En stock")
                                        </span>
                                    </div>
                                    <span class="text-[0.62rem] text-[var(--text-muted)]" title="@stock.StatusNote">
                                        @stock.GetRelativeTimeText()
                                    </span>
                                </div>
                            }
                            else if (stock.IsLowStock)
                            {
                                <div class="flex items-center justify-between gap-1.5">
                                    <div class="flex items-center gap-1.5">
                                        <span class="inline-block w-2 h-2 rounded-full bg-amber-500"></span>
                                        <span class="text-[0.7rem] font-semibold text-amber-400">
                                            @(stock.AvailableQuantity.HasValue ? $"Últimas {stock.AvailableQuantity} uds" : "Últimas unidades")
                                        </span>
                                    </div>
                                    <span class="text-[0.62rem] text-[var(--text-muted)]" title="@stock.StatusNote">
                                        @stock.GetRelativeTimeText()
                                    </span>
                                </div>
                            }
                            else if (stock.IsOutOfStock)
                            {
                                <div class="flex items-center justify-between gap-1.5">
                                    <div class="flex items-center gap-1.5">
                                        <span class="inline-block w-2 h-2 rounded-full bg-rose-500"></span>
                                        <span class="text-[0.7rem] font-semibold text-rose-400">Agotado en tienda</span>
                                    </div>
                                    <span class="text-[0.62rem] text-[var(--text-muted)]" title="@stock.StatusNote">
                                        @stock.GetRelativeTimeText()
                                    </span>
                                </div>
                            }
                            else
                            {
                                <div class="flex items-center justify-between gap-1.5">
                                    <div class="flex items-center gap-1.5">
                                        <span class="inline-block w-2 h-2 rounded-full bg-slate-400"></span>
                                        <span class="text-[0.7rem] font-medium text-slate-400">Verificar en web</span>
                                    </div>
                                    <span class="text-[0.62rem] text-[var(--text-muted)]" title="@stock.StatusNote">
                                        @stock.GetRelativeTimeText()
                                    </span>
                                </div>
                            }
                        </div>
                    </div>

                    @* Botón de compra y acción contextual *@
                    @{
                        var storeSlug = Ludeka.Core.Entities.Game.GenerateSlug(offer.StoreName);
                        var targetPurchaseUrl = !string.IsNullOrWhiteSpace(GameSlug)
                            ? $"/r/comprar/{GameSlug}/{storeSlug}"
                            : AffiliateResolver.ResolveAffiliateUrl(offer.AffiliateUrl, offer.StoreName);
                    }
                    <div class="flex items-center gap-2 pt-1">
                        @if (_isReferenceFallback || !offer.Price.HasValue)
                        {
                            <a href="@targetPurchaseUrl"
                               target="_blank"
                               rel="noopener noreferrer sponsored"
                               aria-label="Buscar @(string.IsNullOrWhiteSpace(GameTitle) ? "juego" : GameTitle) en @offer.StoreName"
                               class="inline-flex items-center justify-center gap-1.5 flex-1 px-3.5 py-2 rounded-lg text-xs font-bold bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-white transition-all shadow-sm group-hover:shadow">
                                <span>Buscar en @offer.StoreName</span>
                                <span class="text-[0.8rem]">&nearr;</span>
                            </a>
                        }
                        else if (isOutOfStock)
                        {
                            <a href="@targetPurchaseUrl"
                               target="_blank"
                               rel="noopener noreferrer sponsored"
                               aria-label="Ver disponibilidad de @(string.IsNullOrWhiteSpace(GameTitle) ? "juego" : GameTitle) en @offer.StoreName"
                               class="inline-flex items-center justify-center gap-1.5 flex-1 px-3 py-2 rounded-lg text-xs font-semibold bg-slate-800/80 hover:bg-slate-700 text-slate-300 border border-slate-700/60 transition-all shadow-sm">
                                <span>Agotado / Ver tienda</span>
                                <span class="text-[0.75rem] opacity-70">&nearr;</span>
                            </a>
                        }
                        else
                        {
                            <a href="@targetPurchaseUrl"
                               target="_blank"
                               rel="noopener noreferrer sponsored"
                               aria-label="Comprar @(string.IsNullOrWhiteSpace(GameTitle) ? "juego" : GameTitle) en @offer.StoreName"
                               class="inline-flex items-center justify-center gap-1.5 flex-1 px-3.5 py-2 rounded-lg text-xs font-bold bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-white transition-all shadow-sm group-hover:shadow">
                                <span>Ver en tienda</span>
                                <span class="text-[0.8rem]">&nearr;</span>
                            </a>
                        }

                        @if (offer.Price.HasValue)
                        {
                            <button type="button"
                                    @onclick="() => RefreshOfferStockAsync(offer)"
                                    title="Recomprobar disponibilidad en vivo en @offer.StoreName"
                                    aria-label="Recomprobar disponibilidad en @offer.StoreName"
                                    class="p-2 rounded-lg bg-[var(--bg-card)] hover:bg-[var(--bg-surface)] text-[var(--text-muted)] hover:text-[var(--text-primary)] border border-[var(--border-subtle)] text-xs transition-colors">
                                <Icon Name="refresh-cw" Size="14" />
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else if (_isReferenceFallback && _displayedOffers != null && _displayedOffers.Count > 0)
    {
        <div class="p-3.5 sm:p-4 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] space-y-3">
            <div class="space-y-1">
                <div class="flex items-center gap-1.5 text-xs font-semibold text-[var(--text-primary)]">
                    <span class="inline-block w-2 h-2 rounded-full bg-slate-400"></span>
                    <span>Sin precios ni stock confirmados</span>
                </div>
                <p class="text-[0.72rem] text-[var(--text-secondary)] leading-relaxed">
                    No disponemos de ofertas con precio y disponibilidad verificada en vivo para este título. Puedes consultar directamente en el buscador de tiendas especializadas:
                </p>
            </div>

            <div class="@(IsSidebar ? "grid grid-cols-1 gap-1.5" : "grid grid-cols-2 sm:grid-cols-4 gap-2")">
                @foreach (var offer in _displayedOffers)
                {
                    var storeSlug = Ludeka.Core.Entities.Game.GenerateSlug(offer.StoreName);
                    var targetPurchaseUrl = !string.IsNullOrWhiteSpace(GameSlug)
                        ? $"/r/comprar/{GameSlug}/{storeSlug}"
                        : AffiliateResolver.ResolveAffiliateUrl(offer.AffiliateUrl, offer.StoreName);
                    <a href="@targetPurchaseUrl"
                       target="_blank"
                       rel="noopener noreferrer sponsored"
                       aria-label="Buscar @(string.IsNullOrWhiteSpace(GameTitle) ? "juego" : GameTitle) en @offer.StoreName"
                       class="px-3 py-2 rounded-lg bg-[var(--bg-card)] hover:bg-[var(--brand-primary)]/10 border border-[var(--border-subtle)] hover:border-[var(--brand-primary)] text-[var(--text-primary)] hover:text-[var(--brand-primary)] text-xs font-medium transition-all flex items-center justify-between group shadow-sm">
                        <span class="font-bold truncate">Buscar en @offer.StoreName</span>
                        <span class="text-[0.75rem] opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-transform">&nearr;</span>
                    </a>
                }
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_effectiveCountry))
    {
        <div class="p-5 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-center sm:text-left flex flex-col sm:flex-row items-center gap-3">
            <Icon Name="package" Size="24" />
            <div class="text-xs text-[var(--text-secondary)] space-y-1">
                <p class="font-bold text-[var(--text-primary)]">
                    No hay tiendas asociadas con disponibilidad o envíos para @CountryCatalog.GetFlag(_effectiveCountry) @_effectiveCountry por el momento.
                </p>
                <p>
                    Para consultar tiendas de otros países o envíos internacionales, puedes desactivar el filtro de país en tu perfil o cambiar la ubicación en la barra superior.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="p-4 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-center sm:text-left flex flex-col sm:flex-row items-center gap-3">
            <Icon Name="package" Size="24" />
            <div class="text-xs text-[var(--text-secondary)] space-y-0.5">
                <p class="font-medium text-[var(--text-primary)]">Sin enlaces de compra vinculados por el momento.</p>
                <p>Si eres una tienda física o especializada y dispones de stock de este título, puedes contactar con la comunidad para vincularlo.</p>
            </div>
        </div>
    }

    <div class="pt-2 border-t border-[var(--border-subtle)] flex items-center justify-between text-[0.68rem] text-[var(--text-muted)] flex-wrap gap-2">
        <span>
            <Icon Name="lightbulb" Size="12" /> <em>Al comprar a través de estos enlaces recibimos una pequeña aportación que ayuda a mantener Ludeka libre de publicidad invasiva.</em>
        </span>
        <a href="/transparencia" class="underline hover:text-[var(--text-secondary)]">
            Transparencia de fondos &rarr;
        </a>
    </div>
</div>
}

@code {
    [Parameter]
    public IReadOnlyList<GamePurchaseLink>? Offers { get; set; }

    [Parameter]
    public string? GameTitle { get; set; }

    [Parameter]
    public string? GameSlug { get; set; }

    [Parameter]
    public Guid? GameId { get; set; }

    [Parameter]
    public bool IsSidebar { get; set; }

    private string? _effectiveCountry;
    private IReadOnlyList<GamePurchaseLink> _displayedOffers = [];
    private readonly Dictionary<string, StoreStockInfo> _stockByUrl = new(StringComparer.OrdinalIgnoreCase);
    private bool _isCheckingStock;
    private GamePriceMetrics? _priceMetrics;
    private bool _isReferenceFallback;

    protected override async Task OnParametersSetAsync()
    {
        _effectiveCountry = await LocationService.GetEffectiveCountryAsync();

        if (GameId.HasValue && GameId.Value != Guid.Empty)
        {
            try
            {
                _priceMetrics = await PriceRadarService.GetGamePriceMetricsAsync(GameId.Value);
            }
            catch
            {
                // Silencioso por resiliencia
            }
        }

        if (Offers != null && Offers.Count > 0)
        {
            if (!string.IsNullOrWhiteSpace(_effectiveCountry))
            {
                // Filtrado territorial estricto
                _displayedOffers = Offers.Where(o => o.ShipsTo(_effectiveCountry)).ToList();
            }
            else
            {
                // Sin filtro excluyente: priorizar por país detectado si existe
                string? detected = await LocationService.GetDetectedCountryAsync();
                _displayedOffers = LocationService.PrioritizeByCountry(Offers, detected).ToList();
            }
        }
        else
        {
            _displayedOffers = [];
        }

        // Si no hay ofertas registradas para este juego/país, activar fallback automático con tiendas de referencia
        if (_displayedOffers.Count == 0 && !string.IsNullOrWhiteSpace(GameTitle))
        {
            _isReferenceFallback = true;
            _displayedOffers = GenerateReferenceSearchOffers(GameTitle, _effectiveCountry);
        }
        else
        {
            _isReferenceFallback = false;

            // Garantizar que la opción de Amazon esté siempre disponible (único canal con afiliación activa)
            if (!string.IsNullOrWhiteSpace(GameTitle) && !_displayedOffers.Any(o => string.Equals(o.StoreName, "Amazon", StringComparison.OrdinalIgnoreCase)))
            {
                var existingAmazon = Offers?.FirstOrDefault(o => string.Equals(o.StoreName, "Amazon", StringComparison.OrdinalIgnoreCase));
                var amazonOffer = existingAmazon ?? CreateAmazonSearchOffer(GameTitle);

                var list = _displayedOffers.ToList();
                list.Add(amazonOffer);
                // Ordenar: primero ofertas con precio orientativo/en vivo (ordenadas por precio ascendente), seguidas de búsqueda en catálogo
                _displayedOffers = list.OrderBy(o => !o.Price.HasValue).ThenBy(o => o.Price ?? decimal.MaxValue).ToList();
            }
        }

        // Sembrar valores iniciales orientativos si no se han cargado todavía (solo para ofertas reales o persistentes)
        if (!_isReferenceFallback)
        {
            foreach (var offer in _displayedOffers)
            {
                if (!_stockByUrl.ContainsKey(offer.AffiliateUrl))
                {
                    _stockByUrl[offer.AffiliateUrl] = offer.Price.HasValue
                        ? (offer.InStock
                            ? StoreStockInfo.InStock(price: offer.Price, note: "Disponibilidad orientativa")
                            : StoreStockInfo.OutOfStock(note: "Agotado orientativo"))
                        : StoreStockInfo.Unknown("Consultar en catálogo");
                }

                if (GameId.HasValue && GameId.Value != Guid.Empty && offer.Price.HasValue && offer.Price.Value > 0)
                {
                    _ = PriceRadarService.RecordPriceObservationAsync(
                        GameId.Value,
                        offer.StoreName,
                        offer.AffiliateUrl,
                        offer.Price.Value,
                        offer.InStock,
                        offer.Currency);
                }
            }
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        // INC-86: Saneamiento de rendimiento — Toda lectura de disponibilidad y precios en la
        // navegación web se sirve 100% desde snapshots en base de datos. Se erradican las peticiones
        // HTTP en caliente hacia las tiendas para evitar latencias, bloqueos y consumo de egress.
        return Task.CompletedTask;
    }

    private StoreStockInfo? GetOfferStock(GamePurchaseLink offer)
    {
        if (string.IsNullOrWhiteSpace(offer.AffiliateUrl))
            return null;

        _stockByUrl.TryGetValue(offer.AffiliateUrl, out var stock);
        return stock;
    }

    private async Task LoadStockInBackgroundAsync()
    {
        if (_displayedOffers.Count == 0)
            return;

        _isCheckingStock = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var batchResults = await StockService.GetStockBatchAsync(_displayedOffers);
            foreach (var kvp in batchResults)
            {
                _stockByUrl[kvp.Key] = kvp.Value;
            }

            if (GameId.HasValue && GameId.Value != Guid.Empty)
            {
                foreach (var offer in _displayedOffers)
                {
                    if (_stockByUrl.TryGetValue(offer.AffiliateUrl, out var s) && s.CurrentPrice.HasValue && s.CurrentPrice.Value > 0)
                    {
                        try
                        {
                            await PriceRadarService.RecordPriceObservationAsync(
                                GameId.Value,
                                offer.StoreName,
                                offer.AffiliateUrl,
                                s.CurrentPrice.Value,
                                s.IsInStock,
                                offer.Currency);
                        }
                        catch
                        {
                            // Silencioso
                        }
                    }
                }

                try
                {
                    _priceMetrics = await PriceRadarService.GetGamePriceMetricsAsync(GameId.Value);
                }
                catch
                {
                }
            }
        }
        catch
        {
            // Resiliencia total: degradación transparente sin errores en pantalla
        }
        finally
        {
            _isCheckingStock = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshOfferStockAsync(GamePurchaseLink offer)
    {
        if (offer == null || string.IsNullOrWhiteSpace(offer.AffiliateUrl))
            return;

        StockService.InvalidateStockCache(offer.AffiliateUrl);
        _stockByUrl[offer.AffiliateUrl] = StoreStockInfo.Checking();
        StateHasChanged();

        try
        {
            var updated = await StockService.GetStockAsync(offer.StoreName, offer.AffiliateUrl);
            _stockByUrl[offer.AffiliateUrl] = updated;

            if (GameId.HasValue && GameId.Value != Guid.Empty && updated.CurrentPrice.HasValue && updated.CurrentPrice.Value > 0)
            {
                try
                {
                    await PriceRadarService.RecordPriceObservationAsync(
                        GameId.Value,
                        offer.StoreName,
                        offer.AffiliateUrl,
                        updated.CurrentPrice.Value,
                        updated.IsInStock,
                        offer.Currency);

                    _priceMetrics = await PriceRadarService.GetGamePriceMetricsAsync(GameId.Value);
                }
                catch
                {
                }
            }
        }
        catch
        {
            _stockByUrl[offer.AffiliateUrl] = StoreStockInfo.Unknown("Error al verificar en vivo");
        }
        finally
        {
            StateHasChanged();
        }
    }

    private static GamePurchaseLink CreateAmazonSearchOffer(string gameTitle)
    {
        var encoded = Uri.EscapeDataString(gameTitle.Trim());
        return new GamePurchaseLink(
            storeName: "Amazon",
            affiliateUrl: $"https://www.amazon.es/s?k={encoded}",
            price: null,
            currency: "€",
            inStock: true,
            badge: "Marketplace",
            affiliateTag: "Direct",
            country: "España",
            shippingCountries: ["España", "Portugal", "Internacional"]);
    }

