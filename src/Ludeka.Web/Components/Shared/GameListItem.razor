@using Ludeka.Application.DTOs
@using Ludeka.Core.Enums

@if (Game != null)
{
    var colorVar = GetCyclicColor(PositionNumber ?? 1);
    var placeholderUrl = Game.IsExpansion ? "/images/expansion-placeholder.svg" : "/images/game-placeholder.svg";
    var effectiveImageUrl = !string.IsNullOrWhiteSpace(Game.ThumbnailUrl)
        ? Game.ThumbnailUrl
        : (!string.IsNullOrWhiteSpace(Game.CoverImageUrl) ? Game.CoverImageUrl : null);
    var compactPlayers = FormatCompactPlayers(Game.IdealPlayerCountText);
    var rotation = ((PositionNumber ?? 1) % 2 == 0) ? "rotate-[-1.5deg]" : "rotate-[1.5deg]";

    <a href="/juegos/@Game.Slug"
       class="flex items-center gap-3 sm:gap-4.5 py-3 sm:py-3.5 border-b border-[var(--line)] hover:bg-[var(--paper-2)]/50 transition-colors group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand)] rounded px-1"
       aria-label="Ver ficha de @Game.SpanishTitle">
        
        @* Numeral editorial ciclálico *@
        @if (PositionNumber.HasValue)
        {
            <span class="w-10 sm:w-12 shrink-0 text-2xl sm:text-3xl font-black tracking-[-0.06em] text-center"
                  style="color: @colorVar">
                @PositionNumber.Value.ToString("00")
            </span>
        }
        else
        {
            <span class="w-8 sm:w-10 shrink-0 text-xl font-black tracking-[-0.04em] text-center text-[var(--muted)]">
                ·
            </span>
        }

        @* Miniatura con ligera rotación física *@
        <div class="w-14 h-14 sm:w-16 sm:h-16 shrink-0 rounded overflow-hidden shadow-sm bg-[var(--paper-2)] border border-black/5 @rotation">
            @if (!string.IsNullOrWhiteSpace(effectiveImageUrl))
            {
                <img src="@effectiveImageUrl"
                     alt="Carátula de @Game.SpanishTitle"
                     loading="lazy"
                     decoding="async"
                     width="64"
                     height="64"
                     onerror="this.onerror=null; this.src='@placeholderUrl';"
                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            }
            else
            {
                <img src="@placeholderUrl"
                     alt="Carátula de @Game.SpanishTitle no disponible"
                     loading="lazy"
                     decoding="async"
                     width="64"
                     height="64"
                     class="w-full h-full object-cover opacity-80" />
            }
        </div>

        @* Detalle y metadatos en línea editorial *@
        <div class="flex-1 flex flex-col min-w-0 pr-2">
            <div class="flex items-baseline gap-2 min-w-0">
                <b class="text-sm sm:text-base lg:text-[17px] font-black text-[var(--ink)] tracking-[-0.015em] leading-snug truncate group-hover:text-[var(--accent)] transition-colors">
                    @Game.SpanishTitle
                </b>
                <span class="text-xs text-[var(--muted)] shrink-0 font-bold">
                    @Game.YearPublished
                </span>
            </div>

            <div class="text-xs text-[var(--muted)] truncate mt-0.5">
                @Game.Designer @(!string.IsNullOrWhiteSpace(Game.Publisher) ? $"· {Game.Publisher}" : "")
            </div>

            <div class="flex items-center gap-2 sm:gap-3 flex-wrap text-xs font-black mt-1">
                <span class="text-[var(--ink)]">★ @Game.BggRating.ToString("0.0")</span>
                
                @if (!string.IsNullOrWhiteSpace(compactPlayers))
                {
                    <span class="text-[var(--accent-green)]">· @compactPlayers</span>
                }

                @if (Game.EstimatedPerPlayerMinutes > 0)
                {
                    <span class="text-[var(--muted)]">· @(Game.EstimatedPerPlayerMinutes)'</span>
                }

                @* Dureza cuantitativa o cualitativa con accesibilidad WCAG *@
                <span class="text-[var(--muted)]" title="@Game.ComplexityTooltip" aria-label="@Game.ComplexityTooltip">
                    · @Game.ComplexityDisplayBadge
                </span>
            </div>
        </div>

        <div class="shrink-0 text-[var(--muted)] group-hover:text-[var(--accent)] transition-colors pr-1">
            <Icon Name="chevron-right" Size="16" />
        </div>
    </a>
}

@code {
    [Parameter, EditorRequired]
    public GameSummaryDto Game { get; set; } = null!;

    [Parameter]
    public int? PositionNumber { get; set; }

    private static string GetCyclicColor(int position) => ((position - 1) % 5) switch
    {
        0 => "var(--accent)",
        1 => "var(--mustard)",
        2 => "var(--accent-green)",
        3 => "var(--sky)",
        _ => "var(--pink)"
    };

    private static string FormatCompactPlayers(string? idealText)
    {
        if (string.IsNullOrWhiteSpace(idealText) || idealText.Contains("Sin datos", StringComparison.OrdinalIgnoreCase))
            return string.Empty;

        return idealText
            .Replace("Ideal:", "", StringComparison.OrdinalIgnoreCase)
            .Trim();
    }
}
