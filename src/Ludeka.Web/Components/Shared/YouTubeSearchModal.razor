@using System.Threading
@using Ludeka.Application.Contracts
@using Ludeka.Application.DTOs
@using Ludeka.Core.Enums
@inject IYouTubeSearchService YouTubeSearchService
@inject ICatalogService CatalogService
@implements IDisposable

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-fade-in"
         role="dialog"
         aria-modal="true"
         aria-labelledby="yt-modal-title">
        
        <div class="w-full max-w-4xl max-h-[90vh] flex flex-col rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] shadow-2xl overflow-hidden">
            
            @* Cabecera del Modal *@
            <div class="p-5 border-b border-[var(--border-subtle)] flex items-center justify-between gap-4 bg-[var(--bg-surface-elevated)]">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-red-600/10 text-red-600 dark:text-red-400 border border-red-500/20 flex items-center justify-center">
                        <Icon Name="tv" Size="20" />
                    </div>
                    <div>
                        <h2 id="yt-modal-title" class="text-base font-bold text-[var(--text-primary)]">
                            Búsqueda Quirúrgica de YouTube
                        </h2>
                        <p class="text-xs text-[var(--text-secondary)]">
                            Localiza en tiempo real tutoriales, partidas y vídeos de "cómo funciona" con foco en canales de referencia.
                        </p>
                    </div>
                </div>

                <button type="button"
                        @onclick="CloseModal"
                        class="w-8 h-8 rounded-lg flex items-center justify-center text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface)] transition-colors"
                        aria-label="Cerrar modal">
                    <Icon Name="x" Size="16" />
                </button>
            </div>

            @* Píldora del Foco de Canales *@
            <div class="px-5 py-2.5 bg-gradient-to-r from-red-500/10 via-amber-500/10 to-transparent border-b border-[var(--border-subtle)] flex items-center justify-between text-xs">
                <div class="flex items-center gap-2">
                    <Icon Name="target" Size="14" />
                    <span class="text-[var(--text-secondary)]">
                        <strong>Foco Prioritario:</strong> Editoriales (Devir, Maldito, Asmodee), Creadores (Análisis Parálisis, Meepletopía, El Agujero de Hobbit) y Tiendas (Zacatrus!).
                    </span>
                </div>
                <span class="hidden sm:inline-block px-2 py-0.5 rounded text-[0.62rem] font-mono font-semibold bg-[var(--bg-surface-elevated)] text-[var(--text-muted)] border border-[var(--border-subtle)]">
                    YouTube Data API v3
                </span>
            </div>

            @* Buscador de Juego y Acciones *@
            <div class="p-5 border-b border-[var(--border-subtle)] space-y-4 bg-[var(--bg-card)]">
                <div class="flex flex-col sm:flex-row gap-3">
                    <div class="flex-1 relative">
                        <input type="text"
                               value="@_searchQuery"
                               @oninput="HandleSearchInput"
                               @onkeydown="HandleSearchKeyDown"
                               placeholder="Escribe el nombre del juego (ej. Wingspan, Catan, Carcassonne)..."
                               class="w-full px-4 py-2.5 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] focus:border-[var(--brand-primary)] focus:outline-none text-xs text-[var(--text-primary)] placeholder-[var(--text-muted)] transition-colors" />
                        
                        @* Sugerencias de autocompletado en catálogo *@
                        @if (_matchingGames.Count > 0)
                        {
                            <div class="absolute left-0 right-0 top-full mt-1 z-30 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] shadow-xl overflow-hidden max-h-48 overflow-y-auto">
                                @foreach (var g in _matchingGames)
                                {
                                    <button type="button"
                                            @onclick="() => SelectGame(g)"
                                            class="w-full px-4 py-2 text-left text-xs text-[var(--text-primary)] hover:bg-[var(--brand-primary)] hover:text-white transition-colors flex items-center justify-between">
                                        <span class="font-bold">@g.SpanishTitle</span>
                                        <span class="text-[0.68rem] opacity-75">@(g.OriginalTitle != g.SpanishTitle ? g.OriginalTitle : "")</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <button type="button"
                            @onclick="PerformSearch"
                            disabled="@(_isSearching || string.IsNullOrWhiteSpace(_searchQuery))"
                            class="px-5 py-2.5 rounded-xl bg-red-600 hover:bg-red-500 disabled:opacity-50 text-white font-bold text-xs transition-colors flex items-center justify-center gap-2 shadow-md">
                        @if (_isSearching)
                        {
                            <span class="animate-spin inline-block"><Icon Name="dices" Size="14" /></span>
                            <span>Buscando...</span>
                        }
                        else
                        {
                            <Icon Name="search" Size="14" />
                            <span>Buscar en YouTube</span>
                        }
                    </button>

                    @if (_selectedGame != null)
                    {
                        <button type="button"
                                @onclick="AutoIngestTopVideos"
                                disabled="@_isAutoIngesting"
                                class="px-4 py-2.5 rounded-xl bg-[var(--brand-primary)] hover:opacity-90 disabled:opacity-50 text-white font-bold text-xs transition-colors flex items-center justify-center gap-1.5 shadow-md">
                            <Icon Name="zap" Size="14" />
                            <span>@(_isAutoIngesting ? "Auto-Ingestando..." : "Auto-Ingestar 3 Mejores")</span>
                        </button>
                    }
                </div>

                @if (_selectedGame != null)
                {
                    <div class="flex items-center gap-2 text-xs text-[var(--text-secondary)]">
                        <span>Juego seleccionado:</span>
                        <span class="font-bold text-[var(--text-primary)]">@_selectedGame.SpanishTitle</span>
                        <button type="button" @onclick="ClearSelectedGame" class="text-[0.68rem] text-rose-500 hover:underline">
                            (cambiar)
                        </button>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_notificationMessage))
                {
                    <div class="p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs flex items-center justify-between animate-fade-in">
                        <span>@_notificationMessage</span>
                        <button type="button" @onclick="() => _notificationMessage = null" class="text-xs font-bold"><Icon Name="x" Size="12" /></button>
                    </div>
                }
            </div>

            @* Pestañas de Resultados *@
            @if (_hasSearched)
            {
                <div class="px-5 pt-3 border-b border-[var(--border-subtle)] flex items-center gap-2 bg-[var(--bg-surface-elevated)] overflow-x-auto">
                    <button type="button"
                            @onclick='() => _activeCategory = "quick"'
                            class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 @(_activeCategory == "quick" ? "bg-amber-500 text-black shadow-sm" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                        <Icon Name="zap" Size="14" />
                        <span>Cómo Funciona (2 min)</span>
                        <span class="px-1.5 py-0.2 rounded-full text-[0.65rem] @(_activeCategory == "quick" ? "bg-black/20 text-black" : "bg-[var(--bg-card)] text-[var(--text-muted)]")">
                            @_quickOverviews.Count
                        </span>
                    </button>

                    <button type="button"
                            @onclick='() => _activeCategory = "tutorials"'
                            class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 @(_activeCategory == "tutorials" ? "bg-[var(--brand-primary)] text-white shadow-sm" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                        <Icon Name="clapperboard" Size="14" />
                        <span>Tutoriales (8–25 min)</span>
                        <span class="px-1.5 py-0.2 rounded-full text-[0.65rem] @(_activeCategory == "tutorials" ? "bg-black/20 text-white" : "bg-[var(--bg-card)] text-[var(--text-muted)]")">
                            @_tutorials.Count
                        </span>
                    </button>

                    <button type="button"
                            @onclick='() => _activeCategory = "playthroughs"'
                            class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 @(_activeCategory == "playthroughs" ? "bg-emerald-600 text-white shadow-sm" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                        <Icon Name="dices" Size="14" />
                        <span>Partidas Completas</span>
                        <span class="px-1.5 py-0.2 rounded-full text-[0.65rem] @(_activeCategory == "playthroughs" ? "bg-black/20 text-white" : "bg-[var(--bg-card)] text-[var(--text-muted)]")">
                            @_playthroughs.Count
                        </span>
                    </button>
                </div>
            }

            @* Contenido de Resultados Desplazable *@
            <div class="flex-1 overflow-y-auto p-5 space-y-4">
                @if (_isSearching)
                {
                    <div class="py-16 text-center space-y-3">
                        <div class="inline-block animate-spin"><Icon Name="dices" Size="36" /></div>
                        <p class="text-xs text-[var(--text-muted)]">
                            Consultando YouTube en vivo y ponderando canales oficiales de referencia...
                        </p>
                    </div>
                }
                else if (!_hasSearched)
                {
                    <div class="py-16 text-center space-y-2 max-w-sm mx-auto">
                        <span class="inline-block"><Icon Name="search" Size="36" /></span>
                        <h3 class="text-sm font-bold text-[var(--text-primary)]">Empieza una búsqueda</h3>
                        <p class="text-xs text-[var(--text-secondary)]">
                            Selecciona o escribe el nombre de un juego para buscar automáticamente vídeos especializados en español.
                        </p>
                    </div>
                }
                else
                {
                    var activeList = _activeCategory switch
                    {
                        "quick" => _quickOverviews,
                        "tutorials" => _tutorials,
                        _ => _playthroughs
                    };

                    @if (activeList.Count == 0)
                    {
                        <div class="py-12 text-center space-y-2">
                            <span class="inline-block"><Icon Name="sparkles" Size="30" /></span>
                            <h3 class="text-sm font-bold text-[var(--text-primary)]">Sin resultados en esta categoría</h3>
                            <p class="text-xs text-[var(--text-secondary)]">
                                No se localizaron vídeos que encajen estrictamente con los filtros de esta pestaña.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            @foreach (var item in activeList)
                            {
                                <div class="p-4 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] flex flex-col justify-between gap-3 shadow-sm hover:border-[var(--brand-primary)]/50 transition-colors">
                                    <div class="flex gap-3">
                                        @* Miniatura 16:9 *@
                                        <div class="w-32 h-20 shrink-0 rounded-lg overflow-hidden bg-black relative border border-[var(--border-subtle)]">
                                            <img src="@item.ThumbnailUrl" alt="@item.Title" class="w-full h-full object-cover" />
                                            @if (!string.IsNullOrWhiteSpace(item.FormattedDuration))
                                            {
                                                <span class="absolute bottom-1 right-1 px-1.5 py-0.2 rounded bg-black/80 text-[0.62rem] text-white font-mono font-bold">
                                                    @item.FormattedDuration
                                                </span>
                                            }
                                        </div>

                                        @* Metadatos *@
                                        <div class="flex-1 min-w-0 space-y-1">
                                            <div class="flex items-center gap-1.5 flex-wrap">
                                                @if (item.IsReferenceChannel)
                                                {
                                                        <span class="px-2 py-0.5 rounded text-[0.6rem] font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/25 inline-flex items-center gap-1">
                                                            <Icon Name="target" Size="12" /> Canal de Referencia (@(item.ChannelCategory ?? "Oficial"))
                                                        </span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.ExtractedPlayerBadge))
                                                {
                                                    <span class="px-2 py-0.5 rounded text-[0.6rem] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-300 border border-emerald-500/25">
                                                        <Icon Name="users" Size="12" /> @item.ExtractedPlayerBadge
                                                    </span>
                                                }
                                            </div>

                                            <h4 class="text-xs font-bold text-[var(--text-primary)] line-clamp-2 leading-snug">
                                                @item.Title
                                            </h4>

                                            <p class="text-[0.68rem] text-[var(--brand-primary)] font-semibold">
                                                @item.ChannelTitle
                                            </p>
                                        </div>
                                    </div>

                                    @* Acciones en 1 Clic *@
                                    <div class="pt-2 border-t border-[var(--border-subtle)] flex items-center justify-between gap-2 text-xs">
                                        <a href="@item.Url" target="_blank" rel="noopener noreferrer"
                                           class="px-2.5 py-1.5 rounded-lg text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] text-xs font-semibold transition-colors flex items-center gap-1 border border-[var(--border-subtle)]">
                                            <Icon Name="play" Size="12" /> Ver en YouTube
                                        </a>

                                        <div class="flex items-center gap-2">
                                            <button type="button"
                                                    @onclick="() => IngestCandidate(item, false)"
                                                    class="px-3 py-1.5 rounded-lg bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-primary)] font-semibold text-xs border border-[var(--border-subtle)] transition-colors flex items-center gap-1">
                                                <Icon Name="inbox" Size="12" /> A Pendientes
                                            </button>

                                            <button type="button"
                                                    @onclick="() => IngestCandidate(item, true)"
                                                    class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs transition-colors flex items-center gap-1 shadow-sm">
                                                <Icon Name="circle-check" Size="12" /> Aprobar Ya
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>

            @* Pie del Modal *@
            <div class="p-4 border-t border-[var(--border-subtle)] flex items-center justify-end bg-[var(--bg-surface-elevated)]">
                <button type="button"
                        @onclick="CloseModal"
                        class="px-4 py-2 rounded-xl bg-[var(--bg-surface)] hover:bg-[var(--bg-surface-elevated)] text-[var(--text-primary)] text-xs font-semibold border border-[var(--border-subtle)] transition-colors">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnVideoIngested { get; set; }

    private string _searchQuery = string.Empty;
    private bool _isSearching;
    private bool _hasSearched;
    private bool _isAutoIngesting;
    private string _activeCategory = "tutorials";
    private string? _notificationMessage;

    private GameSummaryDto? _selectedGame;
    private IReadOnlyList<GameSummaryDto> _matchingGames = [];

    private IReadOnlyList<YouTubeSearchResultDto> _quickOverviews = [];
    private IReadOnlyList<YouTubeSearchResultDto> _tutorials = [];
    private IReadOnlyList<YouTubeSearchResultDto> _playthroughs = [];

    private System.Threading.Timer? _debounceTimer;
    private CancellationTokenSource? _searchCts;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !string.IsNullOrWhiteSpace(_searchQuery) && _selectedGame == null)
        {
            await FilterCatalogGamesAsync();
        }
    }

    private void HandleSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? string.Empty;

        _debounceTimer?.Dispose();
        _debounceTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await FilterCatalogGamesAsync();
                StateHasChanged();
            });
        }, null, 250, Timeout.Infinite);
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _debounceTimer?.Dispose();
            _matchingGames = [];
            await PerformSearch();
        }
    }

    private async Task FilterCatalogGamesAsync()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var ct = _searchCts.Token;

        var term = _searchQuery?.Trim();
        if (string.IsNullOrWhiteSpace(term) || term.Length < 2)
        {
            _matchingGames = [];
            return;
        }

        try
        {
            _matchingGames = await CatalogService.GetQuickSearchAsync(term, 5, ct);
        }
        catch (OperationCanceledException)
        {
            // Ignorado por cancelación activa
        }
        catch
        {
            _matchingGames = [];
        }
    }

    private async Task SelectGame(GameSummaryDto game)
    {
        _debounceTimer?.Dispose();
        _searchCts?.Cancel();
        _selectedGame = game;
        _searchQuery = game.SpanishTitle;
        _matchingGames = [];
        await PerformSearch();
    }

    private void ClearSelectedGame()
    {
        _debounceTimer?.Dispose();
        _searchCts?.Cancel();
        _selectedGame = null;
        _searchQuery = string.Empty;
        _matchingGames = [];
        _hasSearched = false;
        _quickOverviews = [];
        _tutorials = [];
        _playthroughs = [];
    }

    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery)) return;

        _isSearching = true;
        _hasSearched = true;
        _matchingGames = [];

        try
        {
            var qOverviewsTask = YouTubeSearchService.SearchQuickOverviewsAsync(_searchQuery);
            var tutorialsTask = YouTubeSearchService.SearchTutorialsAsync(_searchQuery);
            var playthroughsTask = YouTubeSearchService.SearchPlaythroughsAsync(_searchQuery, _selectedGame?.Id);

            await Task.WhenAll(qOverviewsTask, tutorialsTask, playthroughsTask);

            _quickOverviews = qOverviewsTask.Result;
            _tutorials = tutorialsTask.Result;
            _playthroughs = playthroughsTask.Result;

            // Seleccionar por defecto la pestaña con más resultados
            if (_quickOverviews.Count > 0 && _tutorials.Count == 0)
            {
                _activeCategory = "quick";
            }
            else if (_tutorials.Count > 0)
            {
                _activeCategory = "tutorials";
            }
            else if (_playthroughs.Count > 0)
            {
                _activeCategory = "playthroughs";
            }
        }
        catch (Exception ex)
        {
            _notificationMessage = $"Error al buscar: {ex.Message}";
        }
        finally
        {
            _isSearching = false;
        }
    }

    private async Task IngestCandidate(YouTubeSearchResultDto candidate, bool autoApprove)
    {
        if (_selectedGame == null)
        {
            _notificationMessage = "Selecciona primero un juego del catálogo para asociar el vídeo.";
            return;
        }

        try
        {
            var request = new YouTubeIngestRequestDto(
                GameId: _selectedGame.Id,
                VideoId: candidate.VideoId,
                Type: candidate.SuggestedType,
                Title: candidate.Title,
                Url: candidate.Url,
                ThumbnailUrl: candidate.ThumbnailUrl,
                ChannelTitle: candidate.ChannelTitle,
                DurationSeconds: candidate.DurationSeconds,
                PlayerCountBadge: candidate.ExtractedPlayerBadge,
                AutoApprove: autoApprove
            );

            await YouTubeSearchService.IngestVideoAsync(request);
            _notificationMessage = autoApprove
                ? $"Vídeo de '{candidate.ChannelTitle}' aprobado y publicado en el Hub."
                : "Vídeo guardado en la bandeja de pendientes de moderación.";

            await OnVideoIngested.InvokeAsync();
        }
        catch (Exception ex)
        {
            _notificationMessage = $"Error al incorporar vídeo: {ex.Message}";
        }
    }

    private async Task AutoIngestTopVideos()
    {
        if (_selectedGame == null) return;

        _isAutoIngesting = true;
        try
        {
            var ingested = await YouTubeSearchService.AutoSuggestAndIngestForGameAsync(_selectedGame.Id, autoApprove: false);
            _notificationMessage = $"Se han incorporado {ingested.Count} vídeos sugeridos a la cola de moderación.";
            await OnVideoIngested.InvokeAsync();
        }
        catch (Exception ex)
        {
            _notificationMessage = $"Error en auto-ingesta: {ex.Message}";
        }
        finally
        {
            _isAutoIngesting = false;
        }
    }

    private async Task CloseModal()
    {
        _debounceTimer?.Dispose();
        _searchCts?.Cancel();
        _matchingGames = [];
        _notificationMessage = null;
        await OnClose.InvokeAsync();
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }
}
