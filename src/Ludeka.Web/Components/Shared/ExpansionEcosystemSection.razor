@using Ludeka.Application.DTOs
@using Ludeka.Application.Contracts
@using Ludeka.Core.Enums
@inject IExpansionService ExpansionService

@if (_isLoading)
{
    <div class="p-6 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] text-center text-xs text-[var(--text-muted)]">
        <div class="inline-block animate-spin mb-1"><Icon Name="dices" Size="20" /></div>
        <p>Cargando expansiones y sinergias del ecosistema...</p>
    </div>
}
else if (Expansions != null && Expansions.Count > 0)
{
    <div class="p-6 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-6">
        @* Cabecera y Selector de Pestañas *@
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-[var(--border-subtle)]">
            <div>
                <span class="text-[0.68rem] font-bold uppercase tracking-wider text-[var(--brand-primary)] block mb-1">
                    Ecosistema Lúdico
                </span>
                <h2 class="text-xl font-black text-[var(--text-primary)]">
                    Expansiones Oficiales y Compatibilidad de Mesa
                </h2>
            </div>

            <div class="flex items-center gap-1.5 p-1 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] self-start sm:self-auto overflow-x-auto">
                <button type="button"
                        @onclick='() => _activeTab = "list"'
                        class="px-3 py-1.5 rounded-lg text-xs font-bold transition-colors whitespace-nowrap @(_activeTab == "list" ? "bg-[var(--brand-primary)] text-white shadow-sm" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                    <span class="inline-flex items-center gap-1"><Icon Name="puzzle" Size="12" /> Expansiones (@Expansions.Count)</span>
                </button>
                <button type="button"
                        @onclick='() => _activeTab = "mixer"'
                        class="px-3 py-1.5 rounded-lg text-xs font-bold transition-colors whitespace-nowrap @(_activeTab == "mixer" ? "bg-[var(--brand-primary)] text-white shadow-sm" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                    <span class="inline-flex items-center gap-1"><Icon Name="flask-conical" Size="12" /> Mezclador de Mesa</span>
                </button>
                @if (_recipes.Count > 0)
                {
                    <button type="button"
                            @onclick='() => _activeTab = "recipes"'
                            class="px-3 py-1.5 rounded-lg text-xs font-bold transition-colors whitespace-nowrap @(_activeTab == "recipes" ? "bg-[var(--brand-primary)] text-white shadow-sm" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                        <span class="inline-flex items-center gap-1"><Icon Name="lightbulb" Size="12" /> Recetas (@_recipes.Count)</span>
                    </button>
                }
            </div>
        </div>

        @* PESTAÑA 1: Listado de Expansiones Disponibles *@
        @if (_activeTab == "list")
        {
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @foreach (var exp in Expansions)
                {
                    <div class="p-4 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] hover:border-[var(--border-highlight)] transition-colors flex flex-col justify-between space-y-3">
                        <div class="flex items-start gap-3.5">
                            <div class="w-16 h-16 rounded-xl overflow-hidden shrink-0 bg-[var(--bg-card)] border border-[var(--border-subtle)] relative">
                                @if (!string.IsNullOrWhiteSpace(exp.CoverImageUrl))
                                {
                                    <img src="@exp.CoverImageUrl"
                                         alt="Carátula de @exp.SpanishTitle"
                                         width="64"
                                         height="64"
                                         loading="lazy"
                                         decoding="async"
                                         class="w-full h-full object-cover"
                                         onerror="this.onerror=null; this.src='/images/expansion-placeholder.svg';" />
                                }
                                else
                                {
                                    <img src="/images/expansion-placeholder.svg"
                                         alt="Carátula de @exp.SpanishTitle no disponible"
                                         width="64"
                                         height="64"
                                         loading="lazy"
                                         decoding="async"
                                         class="w-full h-full object-cover opacity-90" />
                                }
                                <div class="absolute top-1 left-1 px-1 py-0.5 rounded bg-purple-950/85 backdrop-blur-sm border border-purple-500/40 text-purple-200 shadow-sm leading-none">
                                    <Icon Name="puzzle" Size="12" />
                                </div>
                            </div>

                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 mb-0.5">
                                    <span class="text-[0.68rem] font-bold text-[var(--text-muted)]">
                                        @exp.YearPublished
                                    </span>
                                    <span class="text-[0.68rem] font-extrabold text-[var(--brand-primary)]">
                                        ★ @exp.LudistRating.ToString("0.0")
                                    </span>
                                </div>
                                <h3 class="text-sm font-bold text-[var(--text-primary)] truncate" title="@exp.SpanishTitle">
                                    @exp.SpanishTitle
                                </h3>
                                <p class="text-[0.72rem] font-bold text-emerald-400 mt-0.5">
                                    @exp.NecessityBadgeText
                                </p>
                            </div>
                        </div>

                        @* Chips de Aporte *@
                        @if (exp.ImpactTagLabels.Count > 0)
                        {
                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var label in exp.ImpactTagLabels)
                                {
                                    <span class="text-[0.68rem] font-bold px-2 py-0.5 rounded-md bg-[var(--bg-card)] text-[var(--text-secondary)] border border-[var(--border-subtle)]">
                                        @label
                                    </span>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(exp.WhatItBringsSummary))
                        {
                            <p class="text-xs text-[var(--text-secondary)] line-clamp-2 leading-relaxed">
                                @exp.WhatItBringsSummary
                            </p>
                        }

                        <div class="pt-2 border-t border-[var(--border-subtle)] flex items-center justify-between">
                            <span class="text-[0.68rem] text-[var(--text-muted)]">
                                Ficha, vídeos y reviews independientes
                            </span>
                            <a href="/juegos/@exp.Slug"
                               class="px-3 py-1.5 rounded-lg bg-[var(--bg-card)] hover:bg-[var(--bg-surface)] text-[var(--text-primary)] border border-[var(--border-subtle)] text-xs font-bold transition-colors inline-flex items-center gap-1.5 shadow-sm">
                                <span>Ver ficha</span>
                                <span>&rarr;</span>
                            </a>
                        </div>
                    </div>
                }
            </div>
        }

        @* PESTAÑA 2: Mezclador de Mesa y Compatibilidad *@
        @if (_activeTab == "mixer")
        {
            <div class="space-y-6">
                <div>
                    <h3 class="text-base font-bold text-[var(--text-primary)] mb-1">
                        ¿Qué expansiones vas a sacar a mesa?
                    </h3>
                    <p class="text-xs text-[var(--text-secondary)]">
                        Marca las expansiones que posees o deseas combinar. El sistema analizará las sinergias registradas, tiempos de partida y posibles conflictos de componentes.
                    </p>
                </div>

                @* Selector interactivo de expansiones *@
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                    @foreach (var exp in Expansions)
                    {
                        bool isSelected = _selectedExpansionIds.Contains(exp.Id);
                        <button type="button"
                                @onclick="() => ToggleExpansion(exp.Id)"
                                class="p-3 rounded-xl text-left border transition-all flex items-center justify-between gap-3 @(isSelected ? "bg-[var(--brand-primary)]/10 border-[var(--brand-primary)] shadow-sm" : "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] hover:border-[var(--border-highlight)]")">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <span class="text-lg"><Icon Name="@(isSelected ? "circle-check" : "square")" Size="18" /></span>
                                <div class="truncate">
                                    <span class="text-xs font-bold text-[var(--text-primary)] block truncate">
                                        @exp.SpanishTitle
                                    </span>
                                    <span class="text-[0.68rem] text-[var(--text-muted)]">
                                        @exp.YearPublished &bull; @(exp.ExtraPlayerCount > 0 ? $"+{exp.ExtraPlayerCount}J" : "Mismo rango")
                                    </span>
                                </div>
                            </div>
                            @if (isSelected)
                            {
                                <span class="text-[0.68rem] font-extrabold text-[var(--brand-primary)] uppercase">Activa</span>
                            }
                        </button>
                    }
                </div>

                @* Panel de Diagnóstico en Tiempo Real *@
                @if (_evaluation != null)
                {
                    <div class="p-5 rounded-2xl border transition-colors @GetEvaluationContainerClass(_evaluation.GlobalStatus)">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-[var(--border-subtle)]">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-black">
                                    @_evaluation.GlobalStatusBadge
                                </span>
                            </div>

                            <div class="flex items-center gap-4 text-xs">
                                <div>
                                    <span class="text-[0.68rem] uppercase font-bold text-[var(--text-muted)] block">Jugadores Resultantes</span>
                                    <span class="font-extrabold text-[var(--text-primary)]">
                                        @_evaluation.ResultingMinPlayers a @_evaluation.ResultingMaxPlayers personas
                                    </span>
                                </div>
                                <div class="w-px h-6 bg-[var(--border-subtle)]"></div>
                                <div>
                                    <span class="text-[0.68rem] uppercase font-bold text-[var(--text-muted)] block">Duración Estimada</span>
                                    <span class="font-extrabold text-[var(--text-primary)]">
                                        ~@_evaluation.ResultingEstimatedMinutes minutos
                                    </span>
                                </div>
                            </div>
                        </div>

                        <p class="text-xs text-[var(--text-secondary)] mt-3 leading-relaxed">
                            @_evaluation.GlobalStatusMessage
                        </p>

                        @* Avisos de Conflicto *@
                        @if (_evaluation.ConflictWarnings.Count > 0)
                        {
                            <div class="mt-3 p-3 rounded-xl bg-rose-500/10 border border-rose-500/30 text-xs text-rose-300 space-y-1">
                                <span class="font-black uppercase text-[0.68rem] block inline-flex items-center gap-1"><Icon Name="triangle-alert" Size="12" /> Incompatibilidades Detectadas:</span>
                                @foreach (var warn in _evaluation.ConflictWarnings)
                                {
                                    <p>&bull; @warn</p>
                                }
                            </div>
                        }

                        @* Avisos de Precaución / Sobrecarga *@
                        @if (_evaluation.CautionWarnings.Count > 0)
                        {
                            <div class="mt-3 p-3 rounded-xl bg-amber-500/10 border border-amber-500/30 text-xs text-amber-300 space-y-1">
                                <span class="font-black uppercase text-[0.68rem] block inline-flex items-center gap-1"><Icon Name="triangle-alert" Size="12" /> Advertencias de Mesa y Sobrecarga:</span>
                                @foreach (var warn in _evaluation.CautionWarnings)
                                {
                                    <p>&bull; @warn</p>
                                }
                            </div>
                        }

                        @* Destacados de Sinergia *@
                        @if (_evaluation.SynergyHighlights.Count > 0)
                        {
                            <div class="mt-3 p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-xs text-emerald-300 space-y-1">
                                <span class="font-black uppercase text-[0.68rem] block inline-flex items-center gap-1"><Icon Name="sparkles" Size="12" /> Sinergias Óptimas:</span>
                                @foreach (var syn in _evaluation.SynergyHighlights)
                                {
                                    <p>&bull; @syn</p>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @* PESTAÑA 3: Recetas de Mesa Recomendadas *@
        @if (_activeTab == "recipes" && _recipes.Count > 0)
        {
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @foreach (var recipe in _recipes)
                {
                    <div class="p-4 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] space-y-3 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between gap-2 mb-1">
                                <span class="text-[0.68rem] font-bold uppercase tracking-wider text-[var(--brand-primary)]">
                                    <span class="inline-flex items-center gap-1"><Icon Name="lightbulb" Size="12" /> Receta Recomendada</span>
                                </span>
                                <span class="text-[0.68rem] font-extrabold px-2 py-0.5 rounded-full bg-[var(--bg-card)] border border-[var(--border-subtle)] text-[var(--text-muted)]">
                                    @recipe.IdealFor
                                </span>
                            </div>
                            <h4 class="text-sm font-black text-[var(--text-primary)]">
                                @recipe.Name
                            </h4>
                            <p class="text-xs text-[var(--text-secondary)] mt-1 leading-relaxed">
                                @recipe.Description
                            </p>
                        </div>

                        <div class="pt-2 border-t border-[var(--border-subtle)] flex items-center justify-between">
                            <span class="text-[0.68rem] text-[var(--text-muted)]">
                                Incluye @recipe.IncludedExpansionIds.Count @(recipe.IncludedExpansionIds.Count == 1 ? "expansión" : "expansiones")
                            </span>
                            <button type="button"
                                    @onclick="() => LoadRecipe(recipe)"
                                    class="px-3 py-1.5 rounded-lg bg-[var(--brand-primary)] text-white hover:opacity-90 font-bold text-xs transition-opacity flex items-center gap-1.5 shadow-sm">
                                <span class="inline-flex items-center gap-1"><Icon Name="target" Size="12" /> Cargar en Mezclador</span>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public Guid BaseGameId { get; set; }

    [Parameter]
    public IReadOnlyList<ExpansionSummaryDto> Expansions { get; set; } = [];

    private string _activeTab = "list";
    private bool _isLoading = false;
    private HashSet<Guid> _selectedExpansionIds = [];
    private ExpansionMixerEvaluationDto? _evaluation;
    private IReadOnlyList<ExpansionRecipeDto> _recipes = [];

    protected override async Task OnParametersSetAsync()
    {
        if (BaseGameId != Guid.Empty)
        {
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _recipes = await ExpansionService.GetRecipesForBaseGameAsync(BaseGameId);
            // Por defecto evaluamos sin expansiones seleccionadas
            _evaluation = await ExpansionService.EvaluateMixerCombinationAsync(BaseGameId, _selectedExpansionIds);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ToggleExpansion(Guid expansionId)
    {
        if (!_selectedExpansionIds.Add(expansionId))
        {
            _selectedExpansionIds.Remove(expansionId);
        }

        _evaluation = await ExpansionService.EvaluateMixerCombinationAsync(BaseGameId, _selectedExpansionIds);
    }

    private async Task LoadRecipe(ExpansionRecipeDto recipe)
    {
        _selectedExpansionIds = recipe.IncludedExpansionIds.ToHashSet();
        _activeTab = "mixer";
        _evaluation = await ExpansionService.EvaluateMixerCombinationAsync(BaseGameId, _selectedExpansionIds);
    }

    private static string GetEvaluationContainerClass(string status) => status switch
    {
        "Conflict" => "bg-rose-500/5 border-rose-500/30",
        "Caution" => "bg-amber-500/5 border-amber-500/30",
        _ => "bg-emerald-500/5 border-emerald-500/20"
    };
}
