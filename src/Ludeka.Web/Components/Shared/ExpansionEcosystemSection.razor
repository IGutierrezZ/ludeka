@using Ludeka.Application.DTOs
@using Ludeka.Application.Contracts
@using Ludeka.Core.Enums
@using Microsoft.Extensions.Logging
@inject IUserLibraryService LibraryService
@inject ICurrentUserService CurrentUserService
@inject NavigationManager Navigation
@inject ILogger<ExpansionEcosystemSection> Logger

@if (Expansions != null && Expansions.Count > 0)
{
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        @foreach (var exp in Expansions)
        {
            <div class="flex items-center gap-4 p-4 sm:p-5 rounded-2xl bg-[var(--paper-2)] border border-[var(--rule)]/40 hover:border-[var(--rule)] transition-all">
                <a href="/juegos/@exp.Slug" class="shrink-0 w-20 h-20 sm:w-22 sm:h-22 rounded-xl overflow-hidden bg-white/50 border border-black/5 group block">
                    <img src="@(string.IsNullOrWhiteSpace(exp.CoverImageUrl) ? "/images/expansion-placeholder.svg" : exp.CoverImageUrl)"
                         alt="Carátula de @exp.SpanishTitle"
                         width="64"
                         height="64"
                         loading="lazy"
                         decoding="async"
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200"
                         onerror="this.onerror=null; this.src='/images/expansion-placeholder.svg';" />
                </a>
                <div class="flex-1 min-w-0 flex flex-col items-start gap-1">
                    <span class="text-[11px] font-bold uppercase tracking-wider text-[var(--muted)]">
                        @GetNecessitySimpleLabel(exp.Necessity)
                    </span>
                    <a href="/juegos/@exp.Slug" class="text-base font-black text-[var(--ink)] hover:text-[var(--accent)] transition-colors leading-tight line-clamp-1" title="@exp.SpanishTitle">
                        @exp.SpanishTitle
                    </a>
                    <span class="text-xs text-[var(--muted)] font-semibold">
                        @exp.YearPublished@(GetPlayerText(exp))
                    </span>
                    <button type="button"
                            @onclick="() => HandleToggleLibrary(exp.Id)"
                            class="mt-1 h-8 px-3.5 rounded-full border border-[var(--line)] bg-transparent hover:bg-white text-[var(--ink)] font-bold text-xs inline-flex items-center gap-1.5 transition-all cursor-pointer">
                        @if (_userInCollectionIds.Contains(exp.Id))
                        {
                            <Icon Name="check" Size="13" class="text-[var(--accent-green)]" />
                            <span>En mi ludoteca</span>
                        }
                        else
                        {
                            <span>+ A mi ludoteca</span>
                        }
                    </button>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="p-8 rounded-2xl bg-[var(--paper-2)] text-center max-w-lg">
        <p class="text-sm text-[var(--muted)] font-semibold">
            No hay expansiones oficiales registradas para este juego todavía.
        </p>
    </div>
}

@code {
    [Parameter]
    public Guid BaseGameId { get; set; }

    [Parameter]
    public IReadOnlyList<ExpansionSummaryDto> Expansions { get; set; } = [];

    [Parameter]
    public int? BaseGameMaxPlayers { get; set; }

    private HashSet<Guid> _userInCollectionIds = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadUserCollectionStateAsync();
    }

    private async Task LoadUserCollectionStateAsync()
    {
        if (string.IsNullOrWhiteSpace(CurrentUserService.UserId)) return;

        try
        {
            var summary = await LibraryService.GetLibrarySummaryAsync();
            if (summary?.Items != null)
            {
                _userInCollectionIds = summary.Items
                    .Where(i => i.Status == CollectionStatus.InCollection && i.GameId.HasValue)
                    .Select(i => i.GameId!.Value)
                    .ToHashSet();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error al cargar estado de colección en expansiones");
        }
    }

    private async Task HandleToggleLibrary(Guid expansionId)
    {
        if (string.IsNullOrWhiteSpace(CurrentUserService.UserId))
        {
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(Navigation.Uri)}");
            return;
        }

        try
        {
            if (_userInCollectionIds.Contains(expansionId))
            {
                await LibraryService.SetCollectionStateAsync(expansionId, null);
                _userInCollectionIds.Remove(expansionId);
            }
            else
            {
                await LibraryService.SetCollectionStateAsync(expansionId, CollectionStatus.InCollection);
                _userInCollectionIds.Add(expansionId);
            }
            StateHasChanged();
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error al cambiar estado de colección para la expansión {ExpansionId}", expansionId);
        }
    }

    private static string GetNecessitySimpleLabel(ExpansionNecessity? necessity) => necessity switch
    {
        ExpansionNecessity.MustHave => "Imprescindible",
        ExpansionNecessity.HighlyRecommended => "Muy recomendada",
        ExpansionNecessity.Situational => "Opcional",
        ExpansionNecessity.OnlyForFans => "Para completistas",
        ExpansionNecessity.Dispensable => "Prescindible",
        _ => "Opcional"
    };

    private string GetPlayerText(ExpansionSummaryDto exp)
    {
        if (exp.ExtraPlayerCount.HasValue && exp.ExtraPlayerCount > 0)
        {
            if (BaseGameMaxPlayers.HasValue && BaseGameMaxPlayers.Value > 0)
            {
                return $" · hasta {BaseGameMaxPlayers.Value + exp.ExtraPlayerCount.Value} jugadores";
            }
            return $" · +{exp.ExtraPlayerCount.Value} jugadores";
        }
        return string.Empty;
    }
}
