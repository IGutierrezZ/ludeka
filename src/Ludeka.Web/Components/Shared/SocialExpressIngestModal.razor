@using System.IO
@using System.Threading
@using Microsoft.AspNetCore.Components.Forms
@using Ludeka.Application.Contracts
@using Ludeka.Application.DTOs
@using Ludeka.Application.Features.Catalog
@using Ludeka.Core.Enums
@inject ISocialIngestionService IngestionService
@inject ICatalogService CatalogService
@implements IDisposable

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm animate-fade-in"
         role="dialog"
         aria-modal="true"
         aria-labelledby="express-ingest-title">
        <div class="relative w-full max-w-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] rounded-3xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
            
            @* Cabecera del modal *@
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)] shrink-0">
                <div class="flex items-center gap-2">
                    <span class="p-2 rounded-xl bg-amber-500/15 text-amber-400">
                        <Icon Name="sparkles" Size="20" />
                    </span>
                    <div>
                        <h2 id="express-ingest-title" class="text-base font-black text-[var(--text-primary)]">
                            Alta Exprés &amp; Asistente de Ingesta
                        </h2>
                        <p class="text-[0.7rem] text-[var(--text-muted)]">
                            Captura rápida de publicaciones sociales para revisión editorial
                        </p>
                    </div>
                </div>
                <button type="button"
                        @onclick="HandleClose"
                        aria-label="Cerrar modal"
                        class="p-2 rounded-full hover:bg-[var(--bg-surface)] text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors">
                    <Icon Name="x" Size="18" />
                </button>
            </div>

            @* Selector de pestañas *@
            <div class="flex border-b border-[var(--border-subtle)] bg-[var(--bg-surface)] shrink-0">
                <button type="button"
                        @onclick="() => _activeTab = 0"
                        class="flex-1 py-3 px-4 text-xs font-bold text-center border-b-2 transition-colors flex items-center justify-center gap-1.5 @(_activeTab == 0 ? "border-[var(--brand-primary)] text-[var(--brand-primary)] bg-[var(--bg-card)]" : "border-transparent text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                    <Icon Name="zap" Size="14" />
                    <span>Alta Exprés Multimodal (IA)</span>
                </button>
                <button type="button"
                        @onclick="() => _activeTab = 1"
                        class="flex-1 py-3 px-4 text-xs font-bold text-center border-b-2 transition-colors flex items-center justify-center gap-1.5 @(_activeTab == 1 ? "border-[var(--brand-primary)] text-[var(--brand-primary)] bg-[var(--bg-card)]" : "border-transparent text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                    <Icon Name="settings" Size="14" />
                    <span>Modo Manual Avanzado</span>
                </button>
            </div>

            @* Contenido con scroll *@
            <div class="p-6 space-y-4 overflow-y-auto">
                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="p-3.5 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs flex items-center gap-2">
                        <Icon Name="triangle-alert" Size="16" />
                        <span>@_errorMessage</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_successMessage))
                {
                    <div class="p-3.5 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs flex items-center gap-2">
                        <Icon Name="circle-check" Size="16" />
                        <span>@_successMessage</span>
                    </div>
                }

                @if (_activeTab == 0)
                {
                    @* Pestaña 0: Alta Exprés Multimodal *@
                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5">
                                URL de Instagram, YouTube o Web <span class="text-rose-400">*</span>
                            </label>
                            <div class="relative">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[var(--text-muted)]">
                                    <Icon Name="link" Size="14" />
                                </span>
                                <input type="url"
                                       @bind="_expressUrl"
                                       placeholder="https://www.instagram.com/p/... o https://youtu.be/..."
                                       class="w-full pl-9 pr-3.5 py-2.5 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
                            </div>
                            <span class="text-[0.65rem] text-[var(--text-muted)] mt-1 block">
                                Se vinculará como enlace de origen del sorteo o publicación.
                            </span>
                        </div>

                        @* Sección Foto de Portada *@
                        <div class="p-3.5 rounded-2xl bg-[var(--bg-surface-elevated)]/60 border border-[var(--border-subtle)] space-y-2.5">
                            <div class="flex items-center justify-between">
                                <label class="text-xs font-bold text-[var(--text-primary)] flex items-center gap-1.5">
                                    <Icon Name="image" Size="14" />
                                    <span>Foto de Portada / Post</span>
                                    <span class="text-[0.65rem] font-normal text-amber-400 font-mono">(Recomendado en Instagram)</span>
                                </label>
                                @if (_coverImageBytes != null)
                                {
                                    <button type="button"
                                            @onclick="ClearCoverImage"
                                            class="text-[0.65rem] font-bold text-rose-400 hover:text-rose-300 flex items-center gap-1 transition-colors">
                                        <Icon Name="trash-2" Size="12" />
                                        <span>Quitar</span>
                                    </button>
                                }
                            </div>

                            @if (_coverImagePreviewUrl != null)
                            {
                                <div class="flex items-center gap-3 p-2 rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)]">
                                    <img src="@_coverImagePreviewUrl"
                                         alt="Portada cargada"
                                         class="w-16 h-16 object-cover rounded-lg border border-[var(--border-subtle)] shrink-0" />
                                    <div class="min-w-0 flex-1">
                                        <div class="text-xs font-bold text-[var(--text-primary)] truncate">@_coverImageFileName</div>
                                        <div class="text-[0.65rem] text-emerald-400 flex items-center gap-1 mt-0.5">
                                            <Icon Name="check" Size="10" />
                                            <span>Lista para encuadre 16:9 y recorte IA</span>
                                        </div>
                                        <div class="text-[0.6rem] text-[var(--text-muted)] mt-0.5">
                                            SkiaSharp compondrá la carátula horizontal con fondo difuminado y marca.
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="relative border-2 border-dashed border-[var(--border-subtle)] hover:border-[var(--brand-primary)]/50 rounded-xl p-3 text-center transition-colors">
                                    <InputFile OnChange="HandleCoverFileSelected"
                                               accept=".jpg,.jpeg,.png,.webp"
                                               class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />
                                    <div class="flex flex-col items-center justify-center gap-1 pointer-events-none py-1">
                                        <div class="p-1.5 rounded-lg bg-[var(--bg-surface)] text-[var(--text-muted)]">
                                            <Icon Name="image" Size="16" />
                                        </div>
                                        <span class="text-xs font-semibold text-[var(--text-secondary)]">
                                            Selecciona o suelta la captura/foto del sorteo
                                        </span>
                                        <span class="text-[0.65rem] text-[var(--text-muted)]">
                                            Si es captura de móvil, la IA detectará los bordes y eliminará la barra superior
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>

                        @* Sección Bases del Sorteo *@
                        <div class="p-3.5 rounded-2xl bg-[var(--bg-surface-elevated)]/60 border border-[var(--border-subtle)] space-y-2.5">
                            <div class="flex items-center justify-between">
                                <label class="text-xs font-bold text-[var(--text-primary)] flex items-center gap-1.5">
                                    <Icon Name="file-text" Size="14" />
                                    <span>Bases o Pie de Foto</span>
                                </label>
                                @* Selector sub-modo: Texto vs Captura *@
                                <div class="flex rounded-lg bg-[var(--bg-surface)] p-0.5 border border-[var(--border-subtle)] text-[0.65rem]">
                                    <button type="button"
                                            @onclick="() => _basesInputMode = 0"
                                            class="px-2 py-1 rounded font-bold transition-colors flex items-center gap-1 @(_basesInputMode == 0 ? "bg-[var(--brand-primary)] text-white shadow-xs" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                                        <Icon Name="file-text" Size="11" />
                                        <span>Texto</span>
                                    </button>
                                    <button type="button"
                                            @onclick="() => _basesInputMode = 1"
                                            class="px-2 py-1 rounded font-bold transition-colors flex items-center gap-1 @(_basesInputMode == 1 ? "bg-[var(--brand-primary)] text-white shadow-xs" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                                        <Icon Name="camera" Size="11" />
                                        <span>Captura (Móvil)</span>
                                    </button>
                                </div>
                            </div>

                            @if (_basesInputMode == 0)
                            {
                                <div>
                                    <textarea @bind="_expressCaption"
                                              rows="3"
                                              placeholder="Pega aquí el texto con los requisitos, fecha y menciones del sorteo..."
                                              class="w-full p-2.5 rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]"></textarea>
                                </div>
                            }
                            else
                            {
                                @if (_basesImagePreviewUrl != null)
                                {
                                    <div class="flex items-center justify-between p-2 rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)]">
                                        <div class="flex items-center gap-2.5 min-w-0">
                                            <img src="@_basesImagePreviewUrl"
                                                 alt="Captura de bases"
                                                 class="w-12 h-12 object-cover rounded-lg border border-[var(--border-subtle)] shrink-0" />
                                            <div class="min-w-0">
                                                <div class="text-xs font-bold text-[var(--text-primary)] truncate">@_basesImageFileName</div>
                                                <div class="text-[0.65rem] text-emerald-400 flex items-center gap-1 mt-0.5">
                                                    <Icon Name="check" Size="10" />
                                                    <span>Captura lista para OCR multimodal</span>
                                                </div>
                                            </div>
                                        </div>
                                        <button type="button"
                                                @onclick="ClearBasesImage"
                                                class="text-[0.65rem] font-bold text-rose-400 hover:text-rose-300 p-1.5 rounded-lg hover:bg-rose-500/10 transition-colors">
                                            <Icon Name="trash-2" Size="14" />
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="relative border-2 border-dashed border-[var(--border-subtle)] hover:border-[var(--brand-primary)]/50 rounded-xl p-3 text-center transition-colors">
                                        <InputFile OnChange="HandleBasesFileSelected"
                                                   accept=".jpg,.jpeg,.png,.webp"
                                                   class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />
                                        <div class="flex flex-col items-center justify-center gap-1 pointer-events-none py-1">
                                            <div class="p-1.5 rounded-lg bg-[var(--bg-surface)] text-[var(--text-muted)]">
                                                <Icon Name="camera" Size="16" />
                                            </div>
                                            <span class="text-xs font-semibold text-[var(--text-secondary)]">
                                                Sube la captura de pantalla con el texto/bases
                                            </span>
                                            <span class="text-[0.65rem] text-[var(--text-muted)]">
                                                Ideal para Instagram en móvil: Gemini Vision extraerá organizador, fechas y juego
                                            </span>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
                else
                {
                    @* Pestaña 1: Manual Avanzado *@
                    <div class="space-y-4">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5">
                                    URL de Origen <span class="text-rose-400">*</span>
                                </label>
                                <input type="url"
                                       @bind="_manualUrl"
                                       placeholder="https://..."
                                       class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5">
                                    Tipología de Destino <span class="text-rose-400">*</span>
                                </label>
                                <select @bind="_manualType"
                                        class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]">
                                    <option value="@SocialSubmissionType.Giveaway">Sorteo (/sorteos)</option>
                                    <option value="@SocialSubmissionType.WeeklyRelease">Novedad Semanal (/novedades)</option>
                                    <option value="@SocialSubmissionType.BoardGameEvent">Evento o Feria (/eventos)</option>
                                    <option value="@SocialSubmissionType.MediaItem">Vídeo / Tutorial / Partida</option>
                                </select>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5">
                                    Título <span class="text-rose-400">*</span>
                                </label>
                                <input type="text"
                                       @bind="_manualTitle"
                                       placeholder="Ej. Sorteo Brass Birmingham o Tutorial Cascadia"
                                       class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5">
                                    Organizador, Canal o Editorial <span class="text-rose-400">*</span>
                                </label>
                                <input type="text"
                                       @bind="_manualOrganizer"
                                       placeholder="Ej. Maldito Games, Zacatrus..."
                                       class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                            </div>
                        </div>

                        @* Buscador reactivo de juego *@
                        <div>
                            <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5">
                                Juego del Catálogo Asociado
                            </label>
                            @if (_selectedGameId.HasValue)
                            {
                                <div class="flex items-center justify-between p-2.5 rounded-xl bg-[var(--brand-primary)]/10 border border-[var(--brand-primary)]/30 text-xs">
                                    <span class="font-bold text-[var(--brand-primary)] flex items-center gap-1.5"><Icon Name="dices" Size="14" /> @_selectedGameTitle</span>
                                    <button type="button" @onclick="ClearSelectedGame" class="text-[var(--text-muted)] hover:text-rose-400">
                                        <Icon Name="x" Size="14" />
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="relative">
                                    <input type="text"
                                           value="@_gameSearchInput"
                                           @oninput="OnSearchGameInput"
                                           placeholder="Escribe el nombre de un juego para buscar en el catálogo..."
                                           class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                                    
                                    @if (_gameSuggestions.Count > 0)
                                    {
                                        <div class="absolute left-0 right-0 top-full mt-1 bg-[var(--bg-card)] border border-[var(--border-subtle)] rounded-xl shadow-xl z-20 max-h-40 overflow-y-auto divide-y divide-[var(--border-subtle)]">
                                            @foreach (var game in _gameSuggestions)
                                            {
                                                <button type="button"
                                                        @onclick="() => SelectGame(game)"
                                                        class="w-full px-3 py-2 text-left text-xs text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] flex items-center justify-between">
                                                    <span class="font-bold">@game.SpanishTitle</span>
                                                    <span class="text-[0.65rem] text-[var(--text-muted)]">@game.YearPublished</span>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        @if (_manualType == SocialSubmissionType.MediaItem)
                        {
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 p-3 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)]">
                                <div>
                                    <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5">
                                        Categoría Multimedia
                                    </label>
                                    <select @bind="_manualMediaCategory"
                                            class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)]">
                                        <option value="@MediaCategory.Tutorial">Tutorial / Cómo Jugar</option>
                                        <option value="@MediaCategory.Gameplay">Partida Completa</option>
                                        <option value="@MediaCategory.ReviewOpinion">Reseña / Opinión</option>
                                        <option value="@MediaCategory.QuickOverview">Cómo Funciona (2 min)</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5">
                                        Badge de Jugadores
                                    </label>
                                    <input type="text"
                                           @bind="_manualPlayerBadge"
                                           placeholder="Ej. Partida a 2, En Solitario..."
                                           class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)]" />
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @* Botones del footer *@
            <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)] shrink-0">
                <button type="button"
                        @onclick="HandleClose"
                        disabled="@_isSubmitting"
                        class="px-4 py-2 rounded-xl border border-[var(--border-subtle)] hover:bg-[var(--bg-surface)] text-xs font-bold text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors">
                    Cancelar
                </button>
                <button type="button"
                        @onclick="SubmitAsync"
                        disabled="@_isSubmitting"
                        class="px-5 py-2 rounded-xl bg-[var(--brand-primary)] hover:opacity-90 text-[var(--on-brand)] text-xs font-bold transition-all shadow-sm flex items-center gap-2 disabled:opacity-50">
                    @if (_isSubmitting)
                    {
                        <span class="inline-block animate-spin"><Icon Name="refresh-cw" Size="14" /></span>
                        <span>Procesando con IA...</span>
                    }
                    else
                    {
                        <Icon Name="check" Size="14" />
                        <span>@(_activeTab == 0 ? "Capturar y Enviar a Bandeja" : "Guardar en Bandeja")</span>
                    }
                </button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string? PrepopulatedOrganizer { get; set; }
    [Parameter] public EventCallback<SocialInboxItemDto> OnItemCreated { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private int _activeTab = 0;
    private bool _isSubmitting;
    private string? _errorMessage;
    private string? _successMessage;

    // Campos pestaña 0 (Multimodal)
    private string _expressUrl = string.Empty;
    private string _expressCaption = string.Empty;
    private int _basesInputMode = 0; // 0 = Texto, 1 = Captura

    private byte[]? _coverImageBytes;
    private string? _coverImageMimeType;
    private string? _coverImagePreviewUrl;
    private string? _coverImageFileName;

    private byte[]? _basesImageBytes;
    private string? _basesImageMimeType;
    private string? _basesImagePreviewUrl;
    private string? _basesImageFileName;

    // Campos pestaña 1
    private string _manualUrl = string.Empty;
    private SocialSubmissionType _manualType = SocialSubmissionType.Giveaway;
    private string _manualTitle = string.Empty;
    private string _manualOrganizer = string.Empty;
    private Guid? _selectedGameId;
    private string? _selectedGameTitle;
    private string _gameSearchInput = string.Empty;
    private List<GameSummaryDto> _gameSuggestions = new();
    private MediaCategory _manualMediaCategory = MediaCategory.Tutorial;
    private string _manualPlayerBadge = string.Empty;
    private System.Threading.Timer? _debounceTimer;
    private CancellationTokenSource? _searchCts;

    protected override void OnParametersSet()
    {
        if (IsOpen && !string.IsNullOrWhiteSpace(PrepopulatedOrganizer) && string.IsNullOrWhiteSpace(_manualOrganizer))
        {
            _manualOrganizer = PrepopulatedOrganizer;
        }
    }

    private async Task HandleCoverFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        _errorMessage = null;

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _coverImageBytes = ms.ToArray();
            _coverImageMimeType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType;
            _coverImagePreviewUrl = $"data:{_coverImageMimeType};base64,{Convert.ToBase64String(_coverImageBytes)}";
            _coverImageFileName = file.Name;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error al leer la foto de portada: {ex.Message}";
        }
    }

    private void ClearCoverImage()
    {
        _coverImageBytes = null;
        _coverImageMimeType = null;
        _coverImagePreviewUrl = null;
        _coverImageFileName = null;
    }

    private async Task HandleBasesFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        _errorMessage = null;

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _basesImageBytes = ms.ToArray();
            _basesImageMimeType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType;
            _basesImagePreviewUrl = $"data:{_basesImageMimeType};base64,{Convert.ToBase64String(_basesImageBytes)}";
            _basesImageFileName = file.Name;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error al leer la captura de bases: {ex.Message}";
        }
    }

    private void ClearBasesImage()
    {
        _basesImageBytes = null;
        _basesImageMimeType = null;
        _basesImagePreviewUrl = null;
        _basesImageFileName = null;
    }

    private void OnSearchGameInput(ChangeEventArgs e)
    {
        _gameSearchInput = e.Value?.ToString() ?? string.Empty;

        _debounceTimer?.Dispose();
        _debounceTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await SearchGamesAsync();
                StateHasChanged();
            });
        }, null, 250, Timeout.Infinite);
    }

    private async Task SearchGamesAsync()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var ct = _searchCts.Token;

        var term = _gameSearchInput?.Trim();
        if (!string.IsNullOrWhiteSpace(term) && term.Length >= 2)
        {
            try
            {
                var results = await CatalogService.GetQuickSearchAsync(term, limit: 5, ct: ct);
                _gameSuggestions = results.ToList();
            }
            catch (OperationCanceledException)
            {
            }
            catch
            {
                _gameSuggestions.Clear();
            }
        }
        else
        {
            _gameSuggestions.Clear();
        }
    }

    private void SelectGame(GameSummaryDto game)
    {
        _debounceTimer?.Dispose();
        _searchCts?.Cancel();
        _selectedGameId = game.Id;
        _selectedGameTitle = game.SpanishTitle;
        _gameSuggestions.Clear();
        _gameSearchInput = string.Empty;
    }

    private void ClearSelectedGame()
    {
        _selectedGameId = null;
        _selectedGameTitle = null;
    }

    private async Task SubmitAsync()
    {
        _errorMessage = null;
        _successMessage = null;
        _isSubmitting = true;

        try
        {
            SocialInboxItemDto result;

            if (_activeTab == 0)
            {
                if (string.IsNullOrWhiteSpace(_expressUrl))
                {
                    _errorMessage = "Introduce la URL de la publicación.";
                    return;
                }

                bool hasCover = _coverImageBytes != null && _coverImageBytes.Length > 0;
                bool hasBasesImg = _basesImageBytes != null && _basesImageBytes.Length > 0;
                bool hasCaption = !string.IsNullOrWhiteSpace(_expressCaption);

                if (hasCover || hasBasesImg)
                {
                    var multimodalInput = new SocialExpressMultimodalInputDto(
                        SourceUrl: _expressUrl,
                        ManualCaption: hasCaption ? _expressCaption : null,
                        BasesImageBytes: _basesImageBytes,
                        BasesImageMimeType: _basesImageMimeType,
                        CoverImageBytes: _coverImageBytes,
                        CoverImageMimeType: _coverImageMimeType);

                    result = await IngestionService.IngestMultimodalAsync(multimodalInput);
                }
                else
                {
                    result = await IngestionService.IngestFromUrlAsync(_expressUrl, _expressCaption);
                }
            }
            else
            {
                if (string.IsNullOrWhiteSpace(_manualUrl))
                {
                    _errorMessage = "Introduce la URL de origen.";
                    return;
                }

                if (string.IsNullOrWhiteSpace(_manualTitle))
                {
                    _errorMessage = "Introduce un título para el elemento.";
                    return;
                }

                if (string.IsNullOrWhiteSpace(_manualOrganizer))
                {
                    _errorMessage = "Introduce el organizador o canal.";
                    return;
                }

                var input = new SocialInboxManualInputDto(
                    SourceUrl: _manualUrl,
                    SubmissionType: _manualType,
                    Title: _manualTitle,
                    OrganizerOrAuthor: _manualOrganizer,
                    GameId: _selectedGameId,
                    GameTitle: _selectedGameTitle,
                    MediaCategory: _manualType == SocialSubmissionType.MediaItem ? _manualMediaCategory : null,
                    PlayerCountBadge: !string.IsNullOrWhiteSpace(_manualPlayerBadge) ? _manualPlayerBadge : null);

                result = await IngestionService.IngestManualAdvancedAsync(input);
            }

            _successMessage = "¡Publicación enviada a la bandeja de moderación!";
            await OnItemCreated.InvokeAsync(result);

            // Resetear campos
            _expressUrl = string.Empty;
            _expressCaption = string.Empty;
            _basesInputMode = 0;
            ClearCoverImage();
            ClearBasesImage();
            _manualUrl = string.Empty;
            _manualTitle = string.Empty;
            _selectedGameId = null;
            _selectedGameTitle = null;

            await Task.Delay(800);
            await HandleClose();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error al procesar la publicación: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task HandleClose()
    {
        _debounceTimer?.Dispose();
        _searchCts?.Cancel();
        _errorMessage = null;
        _successMessage = null;
        await OnClose.InvokeAsync();
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }
}
