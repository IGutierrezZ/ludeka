@using Ludeka.Core.Enums

@if (IsOpen && Item != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-fade-in"
         role="dialog"
         aria-modal="true"
         aria-labelledby="media-embed-modal-title"
         @onclick="HandleBackdropClick">
        <div class="bg-[var(--bg-card)] border border-[var(--border-subtle)] rounded-2xl w-full max-w-3xl overflow-hidden shadow-2xl flex flex-col max-h-[90vh]"
             @onclick:stopPropagation="true">
            
            @* Cabecera del modal *@
            <div class="p-4 border-b border-[var(--border-subtle)] flex items-center justify-between bg-[var(--bg-surface-elevated)]">
                <div class="flex items-center gap-2.5 min-w-0">
                    <span class="text-xl">
                        @if (Item.Type == MediaType.Tutorial)
                        {
                            <Icon Name="clapperboard" Size="20" />
                        }
                        else if (Item.Type == MediaType.Playthrough)
                        {
                            <Icon Name="dices" Size="20" />
                        }
                        else if (Item.Type == MediaType.InstagramPost)
                        {
                            <Icon Name="camera" Size="20" />
                        }
                        else
                        {
                            <Icon Name="smartphone" Size="20" />
                        }
                    </span>
                    <div class="min-w-0">
                        <h3 id="media-embed-modal-title" class="text-sm font-bold text-[var(--text-primary)] truncate max-w-md">
                            @Item.Title
                        </h3>
                        <p class="text-xs text-[var(--brand-primary)] font-medium">
                            @Item.AuthorChannel &bull; <span class="text-[var(--text-muted)]">@Item.Platform</span>
                        </p>
                    </div>
                </div>

                <button type="button"
                        @onclick="CloseModal"
                        class="p-1.5 rounded-lg text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface)] transition-colors"
                        aria-label="Cerrar modal de reproducción">
                    <Icon Name="x" Size="16" />
                </button>
            </div>

            @* Cuerpo con reproductor o visualizador *@
            <div class="bg-black flex-1 flex items-center justify-center overflow-hidden">
                @if (Item.Platform == MediaPlatform.YouTube && !string.IsNullOrWhiteSpace(Item.EmbedUrl))
                {
                    <div class="w-full aspect-video">
                        <iframe src="@Item.EmbedUrl"
                                title="@Item.Title"
                                class="w-full h-full"
                                frameborder="0"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                allowfullscreen>
                        </iframe>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(Item.ThumbnailUrl))
                {
                    <div class="p-4 flex flex-col items-center justify-center gap-3">
                        <div class="max-w-md max-h-[60vh] overflow-hidden rounded-xl border border-[var(--border-subtle)]">
                            <img src="@Item.ThumbnailUrl" alt="@Item.Title" loading="lazy" decoding="async" class="w-full h-auto object-cover" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Item.Excerpt))
                        {
                            <p class="text-xs text-[var(--text-secondary)] italic bg-[var(--bg-surface-elevated)] p-3 rounded-lg border border-[var(--border-subtle)]">
                                "@Item.Excerpt"
                            </p>
                        }
                        <p class="text-xs text-[var(--text-muted)]">
                            Este contenido procede de Instagram y está optimizado para su visualización en la red social.
                        </p>
                    </div>
                }
            </div>

            @* Pie del modal *@
            <div class="p-3.5 border-t border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)] flex items-center justify-between text-xs">
                <div class="flex items-center gap-2">
                    <LikeButton TargetType="LikeTargetType.MediaItem"
                                TargetId="@Item.Id"
                                InitialLikesCount="@Item.UserLikesCount"
                                OnLikesCountChanged="(cnt) => Item = Item with { UserLikesCount = cnt }" />
                    @if (!string.IsNullOrWhiteSpace(Item.PlayerCountBadge))
                    {
                        <span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-300 border border-emerald-500/25 font-semibold text-[0.68rem]">
                            <Icon Name="users" Size="12" /> @Item.PlayerCountBadge
                        </span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Item.FormattedDuration))
                    {
                        <span class="px-2 py-0.5 rounded-full bg-[var(--bg-card)] text-[var(--text-secondary)] border border-[var(--border-subtle)] font-semibold text-[0.68rem]">
                            <Icon Name="timer" Size="12" /> @Item.FormattedDuration
                        </span>
                    }
                    @if (Item.LikesCount.HasValue)
                    {
                        <span class="px-2 py-0.5 rounded-full bg-rose-500/10 text-rose-600 dark:text-rose-300 border border-rose-500/25 font-semibold text-[0.68rem]">
                            <Icon Name="heart" Size="12" /> @Item.LikesCount likes
                        </span>
                    }
                </div>

                <div class="flex items-center gap-2">
                    <a href="@Item.Url"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="px-3 py-1.5 rounded-lg bg-[var(--brand-primary)] hover:opacity-90 text-white font-bold transition-opacity inline-flex items-center gap-1.5 shadow-sm">
                        <span>↗</span> Ver en @Item.Platform
                    </a>
                    <button type="button"
                            @onclick="CloseModal"
                            class="px-3 py-1.5 rounded-lg bg-[var(--bg-card)] hover:bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border-subtle)] font-semibold transition-colors">
                        Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public MediaItemDto? Item { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private async Task CloseModal()
    {
        await OnClose.InvokeAsync();
    }

    private async Task HandleBackdropClick()
    {
        await CloseModal();
    }
}
