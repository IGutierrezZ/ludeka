@using Ludeka.Application.DTOs
@using Ludeka.Core.Enums
@using Ludeka.Application.Contracts
@inject IMediaService MediaService
@inject ICatalogService CatalogService
@inject ICurrentUserService CurrentUserService
@inject IJSRuntime JSRuntime

<div class="space-y-4">
    @{
        var displayedVideos = GetDisplayedItems();
    }

    @* Cabecera y Filtros Multimedia: Barra Segmentada Profesional *@
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-2 border-b border-[var(--border-subtle)]">
        @* Barra Segmentada Estilizada *@
        <div class="bg-[var(--bg-surface-elevated)] p-1 rounded-xl border border-[var(--border-subtle)] inline-flex items-center gap-1 overflow-x-auto max-w-full scrollbar-none self-start sm:self-auto" role="tablist" aria-label="Filtrar por formato de vídeo">
            <button type="button"
                    @onclick='() => _activeFilter = "all"'
                    role="tab"
                    aria-selected="@(_activeFilter == "all")"
                    class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 whitespace-nowrap @(_activeFilter == "all" ? "bg-[var(--brand-primary)] text-white shadow-sm" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-card)]")">
                <Icon Name="tv" Size="13" />
                <span>Todos</span>
                <span class="px-1.5 py-0.5 rounded-full text-[0.62rem] font-semibold @(_activeFilter == "all" ? "bg-white/20 text-white" : "bg-[var(--bg-card)] text-[var(--text-muted)]")">
                    @TotalVideosCount
                </span>
            </button>

            <button type="button"
                    @onclick='() => _activeFilter = "tutorials"'
                    role="tab"
                    aria-selected="@(_activeFilter == "tutorials")"
                    class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 whitespace-nowrap @(_activeFilter == "tutorials" ? "bg-[var(--brand-primary)] text-white shadow-sm" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-card)]")">
                <Icon Name="clapperboard" Size="13" />
                <span>Tutoriales</span>
                <span class="px-1.5 py-0.5 rounded-full text-[0.62rem] font-semibold @(_activeFilter == "tutorials" ? "bg-white/20 text-white" : "bg-[var(--bg-card)] text-[var(--text-muted)]")">
                    @(MediaHub?.Tutorials.Count ?? 0)
                </span>
            </button>

            <button type="button"
                    @onclick='() => _activeFilter = "quick"'
                    role="tab"
                    aria-selected="@(_activeFilter == "quick")"
                    class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 whitespace-nowrap @(_activeFilter == "quick" ? "bg-[var(--brand-primary)] text-white shadow-sm" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-card)]")">
                <Icon Name="zap" Size="13" />
                <span>Cómo Funciona</span>
                <span class="px-1.5 py-0.5 rounded-full text-[0.62rem] font-semibold @(_activeFilter == "quick" ? "bg-white/20 text-white" : "bg-[var(--bg-card)] text-[var(--text-muted)]")">
                    @(MediaHub?.QuickOverviews.Count ?? 0)
                </span>
            </button>

            <button type="button"
                    @onclick='() => _activeFilter = "playthroughs"'
                    role="tab"
                    aria-selected="@(_activeFilter == "playthroughs")"
                    class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 whitespace-nowrap @(_activeFilter == "playthroughs" ? "bg-[var(--brand-primary)] text-white shadow-sm" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-card)]")">
                <Icon Name="dices" Size="13" />
                <span>Partidas</span>
                <span class="px-1.5 py-0.5 rounded-full text-[0.62rem] font-semibold @(_activeFilter == "playthroughs" ? "bg-white/20 text-white" : "bg-[var(--bg-card)] text-[var(--text-muted)]")">
                    @(MediaHub?.Playthroughs.Count ?? 0)
                </span>
            </button>

            <button type="button"
                    @onclick='() => _activeFilter = "social"'
                    role="tab"
                    aria-selected="@(_activeFilter == "social")"
                    class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 whitespace-nowrap @(_activeFilter == "social" ? "bg-[var(--brand-primary)] text-white shadow-sm" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-card)]")">
                <Icon Name="message-circle" Size="13" />
                <span>Opiniones y Redes</span>
                <span class="px-1.5 py-0.5 rounded-full text-[0.62rem] font-semibold @(_activeFilter == "social" ? "bg-white/20 text-white" : "bg-[var(--bg-card)] text-[var(--text-muted)]")">
                    @SocialCount
                </span>
            </button>
        </div>

        @* Botones de Acción: Navegación y Moderación *@
        <div class="flex items-center gap-2 self-start sm:self-auto shrink-0 flex-wrap">
            @if (displayedVideos.Count > 2)
            {
                <div class="hidden sm:flex items-center gap-1">
                    <button type="button"
                            @onclick='() => ScrollMediaRailAsync(-320)'
                            class="w-8 h-8 rounded-full bg-[var(--bg-surface-elevated)] hover:bg-[var(--brand-primary)] hover:text-white border border-[var(--border-subtle)] text-[var(--text-secondary)] flex items-center justify-center transition-all shadow-sm"
                            aria-label="Vídeos anteriores"
                            title="Deslizar hacia la izquierda">
                        <Icon Name="chevron-left" Size="16" />
                    </button>
                    <button type="button"
                            @onclick='() => ScrollMediaRailAsync(320)'
                            class="w-8 h-8 rounded-full bg-[var(--bg-surface-elevated)] hover:bg-[var(--brand-primary)] hover:text-white border border-[var(--border-subtle)] text-[var(--text-secondary)] flex items-center justify-center transition-all shadow-sm"
                            aria-label="Vídeos siguientes"
                            title="Deslizar hacia la derecha">
                        <Icon Name="chevron-right" Size="16" />
                    </button>
                </div>
            }

            @if (IsModeratorUser)
            {
                <div class="flex items-center gap-1.5 sm:pl-1.5 sm:border-l sm:border-[var(--border-subtle)]">
                    <button type="button"
                            @onclick="OpenYouTubeSearchModal"
                            title="Búsqueda quirúrgica en YouTube con el título pre-rellenado"
                            class="px-2.5 py-1.5 rounded-lg bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-card)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border-subtle)] font-bold text-xs shadow-sm transition-all flex items-center gap-1.5">
                        <Icon Name="search" Size="12" />
                        <span class="hidden md:inline">Buscar en YouTube</span>
                        <span class="md:hidden">YouTube</span>
                    </button>

                    <button type="button"
                            @onclick="OpenFlashIngestModal"
                            title="Añadir vídeo por URL al instante"
                            class="px-2.5 py-1.5 rounded-lg bg-amber-500/10 hover:bg-amber-500 hover:text-black text-amber-500 border border-amber-500/30 font-bold text-xs shadow-sm transition-all flex items-center gap-1.5">
                        <Icon Name="zap" Size="12" />
                        <span>Ingesta Flash</span>
                    </button>
                </div>
            }
        </div>
    </div>

    @* Notificación de Acción de Moderación *@
    @if (!string.IsNullOrWhiteSpace(_bannerMessage))
    {
        <div class="p-3 rounded-xl text-xs font-semibold flex items-center justify-between animate-fade-in @(_bannerSuccess ? "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20" : "bg-rose-500/10 text-rose-400 border border-rose-500/20")">
            <span>@_bannerMessage</span>
            <button type="button" @onclick="() => _bannerMessage = null" class="opacity-70 hover:opacity-100"><Icon Name="x" Size="14" /></button>
        </div>
    }

    @* Carrusel Horizontal de Vídeos Filtrados *@
    @if (displayedVideos.Count > 0)
    {
        <div id="media-carousel-rail"
             class="flex gap-3 sm:gap-4 overflow-x-auto snap-x snap-mandatory scrollbar-none pb-2 pt-1 scroll-smooth"
             role="list"
             tabindex="0"
             aria-label="Carrusel de vídeos multimedia">
            @foreach (var video in displayedVideos)
            {
                var (badgeIcon, badgeLabel, badgeClasses) = GetTypeBadge(video);

                <div class="w-[260px] sm:w-[290px] md:w-[310px] shrink-0 snap-start rounded-xl overflow-hidden bg-[var(--bg-surface)] border border-[var(--border-subtle)] hover:border-[var(--brand-primary)] transition-all flex flex-col justify-between shadow-sm focus:outline-none focus:ring-2 focus:ring-[var(--brand-primary)] relative group cursor-pointer"
                     role="button"
                     tabindex="0"
                     aria-label="@($"Reproducir {badgeLabel}: {video.Title}")"
                     @onkeydown="(e) => HandleCardKeyDown(e, video)"
                     @onclick="() => OpenEmbedModal(video)">
                    
                    <div class="aspect-video relative overflow-hidden bg-black">
                        <img src="@video.ThumbnailUrl"
                             alt="@video.Title"
                             loading="lazy"
                             decoding="async"
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                        
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/20"></div>

                        @* Badge del Tipo de Vídeo *@
                        <div class="absolute top-2 left-2 flex items-center gap-1.5 flex-wrap z-10">
                            <span class="px-2 py-0.5 rounded-full @badgeClasses text-[0.62rem] font-bold tracking-tight shadow-md inline-flex items-center gap-1 backdrop-blur-sm">
                                @if (badgeIcon == "zap")
                                {
                                    <Icon Name="zap" Size="10" />
                                }
                                else if (badgeIcon == "clapperboard")
                                {
                                    <Icon Name="clapperboard" Size="10" />
                                }
                                else if (badgeIcon == "dices")
                                {
                                    <Icon Name="dices" Size="10" />
                                }
                                else if (badgeIcon == "message-circle")
                                {
                                    <Icon Name="message-circle" Size="10" />
                                }
                                else if (badgeIcon == "camera")
                                {
                                    <Icon Name="camera" Size="10" />
                                }
                                else if (badgeIcon == "smartphone")
                                {
                                    <Icon Name="smartphone" Size="10" />
                                }
                                else
                                {
                                    <Icon Name="play" Size="10" />
                                }
                                <span>@badgeLabel</span>
                            </span>

                            @if (video.Category == MediaCategory.Gameplay && !string.IsNullOrWhiteSpace(video.PlayerCountBadge) && !badgeLabel.Equals(video.PlayerCountBadge, StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="px-1.5 py-0.5 rounded-full bg-black/70 text-white border border-white/20 text-[0.6rem] font-semibold inline-flex items-center gap-1 backdrop-blur-sm">
                                    <Icon Name="users" Size="10" />
                                    <span>@video.PlayerCountBadge</span>
                                </span>
                            }
                        </div>

                        <div class="absolute inset-0 flex items-center justify-center">
                            <div class="w-10 h-10 rounded-full bg-[var(--brand-primary)]/90 text-white flex items-center justify-center pl-0.5 shadow-lg group-hover:scale-110 group-hover:bg-[var(--brand-primary)] transition-all">
                                <Icon Name="play" Size="18" />
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(video.FormattedDuration))
                        {
                            <div class="absolute bottom-1.5 right-1.5 px-1.5 py-0.5 rounded bg-black/80 text-white text-[0.65rem] font-mono font-bold tracking-tight inline-flex items-center gap-1">
                                <Icon Name="timer" Size="10" /> @video.FormattedDuration
                            </div>
                        }
                        else if (video.LikesCount.HasValue && video.Type == MediaType.InstagramPost)
                        {
                            <div class="absolute bottom-1.5 right-1.5 px-1.5 py-0.5 rounded bg-black/80 text-white text-[0.65rem] font-bold tracking-tight inline-flex items-center gap-1">
                                <Icon Name="heart" Size="10" /> @video.LikesCount
                            </div>
                        }
                    </div>

                    <div class="p-3 flex-1 flex flex-col justify-between bg-[var(--bg-card)]">
                        <div>
                            <div class="flex items-center justify-between gap-1.5 mb-1">
                                <span class="text-[0.68rem] font-bold text-[var(--brand-primary)] truncate">
                                    @video.AuthorChannel
                                </span>
                                <LikeButton TargetType="LikeTargetType.MediaItem" TargetId="@video.Id" InitialLikesCount="@video.UserLikesCount" Compact="true" />
                            </div>
                            <h3 class="text-xs font-bold text-[var(--text-primary)] group-hover:text-[var(--brand-primary)] transition-colors line-clamp-2 leading-snug" title="@video.Title">
                                @video.Title
                            </h3>
                        </div>

                        @if (IsModeratorUser)
                        {
                            <div class="mt-2.5 pt-2 border-t border-[var(--border-subtle)] flex items-center justify-between gap-1"
                                 @onclick:stopPropagation="true">
                                <span class="text-[0.62rem] font-bold text-amber-500 flex items-center gap-1">
                                    <Icon Name="settings" Size="10" /> Mod
                                </span>
                                <div class="flex items-center gap-1">
                                    <button type="button"
                                            @onclick="() => OpenModerateModal(video)"
                                            title="Cambiar categoría o reasignar"
                                            class="px-2 py-0.5 rounded bg-[var(--bg-surface-elevated)] hover:bg-[var(--brand-primary)] hover:text-white text-[var(--text-secondary)] text-[0.62rem] font-bold transition-colors flex items-center gap-1 border border-[var(--border-subtle)]">
                                        <Icon Name="tag" Size="10" /> Cambiar Categoría
                                    </button>
                                    <button type="button"
                                            @onclick="() => PromptDeleteDirect(video)"
                                            title="Eliminar vídeo de la ficha"
                                            class="px-2 py-0.5 rounded bg-rose-500/10 hover:bg-rose-600 hover:text-white text-rose-400 text-[0.62rem] font-bold transition-colors flex items-center gap-1 border border-rose-500/20">
                                        <Icon Name="x" Size="10" /> Eliminar
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        @if (_activeFilter == "all")
        {
            <div class="p-6 text-center rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] max-w-md mx-auto space-y-2.5">
                <span class="inline-block p-2.5 rounded-xl bg-[var(--bg-card)] text-[var(--brand-primary)] border border-[var(--border-subtle)] shadow-sm">
                    <Icon Name="tv" Size="26" />
                </span>
                <h3 class="text-sm font-bold text-[var(--text-primary)]">
                    Aún no hay tutoriales ni vídeos en español
                </h3>
                <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
                    Nadie ha añadido tutoriales, partidas ni reseñas de este juego a la comunidad todavía. ¿Conoces uno excelente de YouTube?
                </p>
                @if (IsModeratorUser)
                {
                    <div class="pt-1.5 flex items-center justify-center gap-2 flex-wrap">
                        <button type="button"
                                @onclick="OpenYouTubeSearchModal"
                                class="px-3 py-1.5 rounded-xl bg-[var(--bg-card)] hover:bg-[var(--brand-primary)] hover:text-white text-[var(--text-primary)] font-bold text-xs border border-[var(--border-subtle)] shadow-sm transition-all flex items-center gap-1.5">
                            <Icon Name="search" Size="13" />
                            <span>Buscar en YouTube</span>
                        </button>
                        <button type="button"
                                @onclick="OpenFlashIngestModal"
                                class="px-3 py-1.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-black font-bold text-xs shadow-sm transition-all flex items-center gap-1.5">
                            <Icon Name="zap" Size="13" />
                            <span>Ingesta Flash</span>
                        </button>
                    </div>
                }
                else
                {
                    <a href="/moderacion-media" class="inline-block text-xs text-[var(--brand-primary)] hover:underline font-semibold">
                        &rarr; Avisar al equipo en moderación
                    </a>
                }
            </div>
        }
        else
        {
            <div class="p-6 text-center rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] max-w-md mx-auto space-y-2">
                <span class="inline-block text-[var(--text-muted)]"><Icon Name="tv" Size="24" /></span>
                <h3 class="text-sm font-bold text-[var(--text-primary)]">Sin contenidos en este formato todavía</h3>
                <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
                    Aún no se han indexado vídeos o publicaciones para este filtro en este juego.
                </p>
                <div class="pt-1.5">
                    <button type="button"
                            @onclick='() => _activeFilter = "all"'
                            class="px-3 py-1.5 rounded-lg bg-[var(--bg-card)] hover:bg-[var(--bg-surface)] text-[var(--brand-primary)] text-xs font-bold border border-[var(--border-subtle)] transition-colors">
                        Ver todos los vídeos (@TotalVideosCount)
                    </button>
                </div>
            </div>
        }
    }
</div>

@* Modal de reproducción embebida *@
<MediaEmbedModal
    IsOpen="@_isEmbedModalOpen"
    Item="@_selectedMediaItem"
    OnClose="() => _isEmbedModalOpen = false" />

@* Modal de Moderación Directa sobre Vídeo *@
@if (_isModModalOpen && _itemToModerate != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm animate-fade-in"
         @onclick="CloseModerateModal">
        <div class="bg-[var(--bg-card)] border border-[var(--border-subtle)] rounded-2xl w-full max-w-lg p-6 space-y-5 shadow-2xl"
             @onclick:stopPropagation="true">
            @* Cabecera *@
            <div class="flex items-center justify-between pb-3 border-b border-[var(--border-subtle)]">
                <div class="flex items-center gap-2">
                    <Icon Name="settings" Size="20" />
                    <h3 class="text-base font-bold text-[var(--text-primary)]">
                        Moderar Contenido Multimedia
                    </h3>
                </div>
                <button type="button" @onclick="CloseModerateModal" class="text-[var(--text-muted)] hover:text-[var(--text-primary)]"><Icon Name="x" Size="16" /></button>
            </div>

            @* Resumen del ítem *@
            <div class="flex items-start gap-3 p-3 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)]">
                <img src="@_itemToModerate.ThumbnailUrl" alt="@_itemToModerate.Title" class="w-20 h-14 object-cover rounded-lg shrink-0 border border-[var(--border-subtle)]" />
                <div class="min-w-0 flex-1 space-y-0.5">
                    <h4 class="text-xs font-bold text-[var(--text-primary)] line-clamp-2">@_itemToModerate.Title</h4>
                    <p class="text-[0.68rem] text-[var(--brand-primary)]">@_itemToModerate.AuthorChannel</p>
                    <span class="inline-block px-1.5 py-0.2 rounded bg-amber-500/10 text-amber-500 text-[0.62rem] font-bold">
                        Actual: @_itemToModerate.CategoryDisplayName
                    </span>
                </div>
            </div>

            @* Feedback / Mensaje de Estado *@
            @if (!string.IsNullOrWhiteSpace(_modMessage))
            {
                <div class="p-3 rounded-xl text-xs font-semibold @(_modSuccess ? "bg-emerald-500/10 text-emerald-500 border border-emerald-500/30" : "bg-rose-500/10 text-rose-500 border border-rose-500/30")">
                    @_modMessage
                </div>
            }

            @* Bloques de acción *@
            <div class="space-y-4">
                @* 1. Cambio Inmediato de Categoría *@
                <div class="p-3.5 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] space-y-2.5">
                    <h5 class="text-xs font-bold text-[var(--text-primary)] flex items-center gap-1.5">
                        <Icon Name="tag" Size="12" /> Cambiar Categoría
                    </h5>
                    <p class="text-[0.68rem] text-[var(--text-secondary)]">
                        Reubica el vídeo en otra pestaña de la ficha al instante.
                    </p>
                    <div class="flex items-center gap-2">
                        <select @bind="_targetCategory"
                                class="flex-1 px-3 py-1.5 rounded-lg bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]">
                            <option value="@MediaCategory.QuickOverview">Cómo Funciona (2 min)</option>
                            <option value="@MediaCategory.Tutorial">Tutorial (Reglas)</option>
                            <option value="@MediaCategory.Gameplay">Partida Completa</option>
                            <option value="@MediaCategory.ReviewOpinion">Reseña / Opinión</option>
                        </select>
                        <button type="button"
                                @onclick="SaveCategoryChangeAsync"
                                disabled="@_isModProcessing"
                                class="px-3 py-1.5 rounded-lg bg-[var(--brand-primary)] hover:opacity-90 text-white font-bold text-xs transition-opacity disabled:opacity-50">
                            Cambiar
                        </button>
                    </div>
                </div>

                @* 2. Reasignación de Juego *@
                <div class="p-3.5 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] space-y-2.5">
                    <h5 class="text-xs font-bold text-[var(--text-primary)] flex items-center gap-1.5">
                        <span class="inline-flex items-center gap-1"><Icon Name="repeat" Size="12" /> Reasignar a otro Juego</span>
                    </h5>
                    <p class="text-[0.68rem] text-[var(--text-secondary)]">
                        Transfiere el vídeo a otra ficha si corresponde a una expansión o juego diferente.
                    </p>
                    <div class="space-y-2">
                        <input type="text"
                               placeholder="Buscar título de juego (ej. Ark Nova, Wingspan...)"
                               value="@_gameSearchQuery"
                               @oninput="OnGameSearchInput"
                               class="w-full px-3 py-1.5 rounded-lg bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />

                        @if (_matchingGames.Count > 0)
                        {
                            <div class="max-h-32 overflow-y-auto space-y-1 p-1 bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] rounded-lg text-xs">
                                @foreach (var g in _matchingGames)
                                {
                                    <button type="button"
                                            @onclick="() => SelectTargetGame(g)"
                                            class="w-full text-left px-2 py-1 rounded hover:bg-[var(--brand-primary)]/10 text-[var(--text-primary)] flex items-center justify-between @(_selectedTargetGame?.Id == g.Id ? "bg-[var(--brand-primary)]/20 text-[var(--brand-primary)] font-bold" : "")">
                                        <span class="truncate">@g.SpanishTitle (@g.YearPublished)</span>
                                        @if (_selectedTargetGame?.Id == g.Id)
                                        {
                                            <span>✓</span>
                                        }
                                    </button>
                                }
                            </div>
                        }

                        @if (_selectedTargetGame != null)
                        {
                            <div class="flex items-center justify-between pt-1">
                                <span class="text-[0.68rem] text-[var(--text-secondary)]">
                                    Destino: <strong class="text-[var(--brand-primary)]">@_selectedTargetGame.SpanishTitle</strong>
                                </span>
                                <button type="button"
                                        @onclick="ConfirmReassignmentAsync"
                                        disabled="@_isModProcessing"
                                        class="px-3 py-1.5 rounded-lg bg-amber-600 hover:bg-amber-500 text-white font-bold text-xs transition-colors disabled:opacity-50">
                                    Reasignar
                                </button>
                            </div>
                        }
                    </div>
                </div>

                @* 3. Eliminación / Desvinculación *@
                <div class="p-3.5 rounded-xl bg-rose-500/5 border border-rose-500/20 flex items-center justify-between gap-3">
                    <div>
                        <h5 class="text-xs font-bold text-rose-400">Eliminar de la ficha</h5>
                        <p class="text-[0.68rem] text-[var(--text-secondary)]">Retira definitivamente este vídeo del catálogo.</p>
                    </div>
                    @if (!_confirmingDelete)
                    {
                        <button type="button"
                                @onclick="() => _confirmingDelete = true"
                                class="px-3 py-1.5 rounded-lg bg-rose-600/80 hover:bg-rose-600 text-white font-bold text-xs transition-colors shrink-0">
                            Eliminar
                        </button>
                    }
                    else
                    {
                        <div class="flex items-center gap-1.5 shrink-0">
                            <button type="button"
                                    @onclick="() => _confirmingDelete = false"
                                    class="px-2 py-1 rounded bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] text-xs">
                                Cancelar
                            </button>
                            <button type="button"
                                    @onclick="ConfirmDeleteAsync"
                                    disabled="@_isModProcessing"
                                    class="px-3 py-1 rounded bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs transition-colors">
                                Sí, eliminar
                            </button>
                        </div>
                    }
                </div>
            </div>

            @* Pie *@
            <div class="flex justify-end pt-2 border-t border-[var(--border-subtle)]">
                <button type="button"
                        @onclick="CloseModerateModal"
                        class="px-4 py-2 rounded-xl bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-primary)] font-bold text-xs border border-[var(--border-subtle)] transition-colors">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
}

@* Modal de Ingesta Flash de Vídeo *@
@if (_isFlashIngestOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm animate-fade-in"
         @onclick="CloseFlashIngestModal">
        <div class="bg-[var(--bg-card)] border border-[var(--border-subtle)] rounded-2xl w-full max-w-md p-6 space-y-5 shadow-2xl"
             @onclick:stopPropagation="true">
            @* Cabecera *@
            <div class="flex items-center justify-between pb-3 border-b border-[var(--border-subtle)]">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-500 flex items-center justify-center">
                        <Icon Name="zap" Size="18" />
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-[var(--text-primary)]">
                            Ingesta Flash de Vídeo
                        </h3>
                        <p class="text-[0.68rem] text-[var(--text-secondary)]">Publica al instante pegando la URL de YouTube</p>
                    </div>
                </div>
                <button type="button" @onclick="CloseFlashIngestModal" class="text-[var(--text-muted)] hover:text-[var(--text-primary)]">
                    <Icon Name="x" Size="16" />
                </button>
            </div>

            @* Feedback de error si lo hay *@
            @if (!string.IsNullOrWhiteSpace(_flashErrorMessage))
            {
                <div class="p-3 rounded-xl text-xs font-semibold bg-rose-500/10 text-rose-400 border border-rose-500/20 flex items-center gap-2">
                    <Icon Name="x" Size="14" />
                    <span>@_flashErrorMessage</span>
                </div>
            }

            <div class="space-y-4">
                @* URL del vídeo *@
                <div>
                    <label class="block text-xs font-bold text-[var(--text-primary)] mb-1.5" for="flash-video-url">
                        URL de YouTube
                    </label>
                    <input id="flash-video-url"
                           type="url"
                           placeholder="https://www.youtube.com/watch?v=..."
                           @bind="_flashUrl"
                           disabled="@_isFlashIngesting"
                           class="w-full px-3.5 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)] disabled:opacity-50" />
                    <p class="text-[0.65rem] text-[var(--text-muted)] mt-1">
                        Compatible con enlaces estándar de YouTube, youtu.be y shorts.
                    </p>
                </div>

                @* Categoría destino *@
                <div>
                    <label class="block text-xs font-bold text-[var(--text-primary)] mb-1.5" for="flash-video-category">
                        Categoría en la ficha
                    </label>
                    <select id="flash-video-category"
                            @bind="_flashCategory"
                            disabled="@_isFlashIngesting"
                            class="w-full px-3.5 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)] disabled:opacity-50">
                        <option value="@MediaCategory.QuickOverview">Cómo Funciona (En 2 min)</option>
                        <option value="@MediaCategory.Tutorial">Tutorial (Reglas y Cómo se juega)</option>
                        <option value="@MediaCategory.Gameplay">Partida Completa</option>
                        <option value="@MediaCategory.ReviewOpinion">Reseña / Análisis Crítico</option>
                    </select>
                </div>

                @* Badge opcional de jugadores (solo si es Gameplay) *@
                @if (_flashCategory == MediaCategory.Gameplay)
                {
                    <div class="animate-fade-in">
                        <label class="block text-xs font-bold text-[var(--text-primary)] mb-1.5" for="flash-player-badge">
                            Número de jugadores (opcional)
                        </label>
                        <input id="flash-player-badge"
                                type="text"
                                placeholder="Ej. A 2 Jugadores, Solitario, A 4..."
                                @bind="_flashPlayerBadge"
                                disabled="@_isFlashIngesting"
                                class="w-full px-3.5 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)] disabled:opacity-50" />
                        <p class="text-[0.65rem] text-[var(--text-muted)] mt-1">
                            Si lo dejas vacío, se intentará detectar automáticamente del título.
                        </p>
                    </div>
                }
            </div>

            @* Botones de acción *@
            <div class="flex items-center justify-end gap-2 pt-3 border-t border-[var(--border-subtle)]">
                <button type="button"
                        @onclick="CloseFlashIngestModal"
                        disabled="@_isFlashIngesting"
                        class="px-4 py-2 rounded-xl bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-secondary)] font-bold text-xs border border-[var(--border-subtle)] transition-colors disabled:opacity-50">
                    Cancelar
                </button>
                <button type="button"
                        @onclick="ExecuteFlashIngestAsync"
                        disabled="@(_isFlashIngesting || string.IsNullOrWhiteSpace(_flashUrl))"
                        class="px-4 py-2 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-white font-bold text-xs shadow-md transition-all flex items-center gap-1.5 disabled:opacity-50">
                    @if (_isFlashIngesting)
                    {
                        <span class="inline-block animate-spin mr-1">◌</span>
                        <span>Ingiriendo...</span>
                    }
                    else
                    {
                        <Icon Name="zap" Size="14" />
                        <span>Publicar Ahora</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@* Modal de Búsqueda Quirúrgica en YouTube *@
<YouTubeSearchModal
    IsOpen="@_isYouTubeSearchOpen"
    InitialGameId="@GameId"
    InitialGameTitle="@GameTitle"
    OnClose="() => _isYouTubeSearchOpen = false"
    OnVideoIngested="HandleYouTubeVideoIngestedAsync" />

@code {
    [Parameter]
    public Guid GameId { get; set; }

    [Parameter]
    public GameMediaHubDto? MediaHub { get; set; }

    [Parameter]
    public string GameTitle { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnMediaChanged { get; set; }

    private string _activeFilter = "all";
    private bool _isEmbedModalOpen;
    private MediaItemDto? _selectedMediaItem;
    private bool _isYouTubeSearchOpen;

    private bool IsModeratorUser => CurrentUserService.IsFoundingTeam || (CurrentUserService.IsInRole("Moderator") && CurrentUserService.HasPermission(ModeratorPermission.CanApproveMedia));

    private int TotalVideosCount =>
        (MediaHub?.QuickOverviews.Count ?? 0) +
        (MediaHub?.Tutorials.Count ?? 0) +
        (MediaHub?.Playthroughs.Count ?? 0) +
        (MediaHub?.ReviewsAndOpinions.Count ?? 0) +
        (MediaHub?.InstagramPosts.Count ?? 0) +
        (MediaHub?.ShortReels.Count ?? 0);

    private int SocialCount =>
        (MediaHub?.ReviewsAndOpinions.Count ?? 0) +
        (MediaHub?.InstagramPosts.Count ?? 0) +
        (MediaHub?.ShortReels.Count ?? 0);

    private List<MediaItemDto> GetDisplayedItems()
    {
        if (MediaHub == null) return [];

        IEnumerable<MediaItemDto> source = _activeFilter switch
        {
            "quick" => MediaHub.QuickOverviews,
            "tutorials" => MediaHub.Tutorials,
            "playthroughs" => MediaHub.Playthroughs,
            "social" => (MediaHub.ReviewsAndOpinions ?? [])
                .Concat(MediaHub.InstagramPosts ?? [])
                .Concat(MediaHub.ShortReels ?? []),
            _ => (MediaHub.QuickOverviews ?? [])
                .Concat(MediaHub.Tutorials ?? [])
                .Concat(MediaHub.Playthroughs ?? [])
                .Concat(MediaHub.ReviewsAndOpinions ?? [])
                .Concat(MediaHub.InstagramPosts ?? [])
                .Concat(MediaHub.ShortReels ?? [])
                .DistinctBy(x => x.Id)
        };

        return source
            .OrderByDescending(x => x.UserLikesCount)
            .ThenByDescending(x => x.LikesCount ?? 0)
            .ThenByDescending(x => x.PublishedAt)
            .ToList();
    }

    private static (string IconName, string Label, string BadgeClasses) GetTypeBadge(MediaItemDto item)
    {
        if (item.Type == MediaType.InstagramPost)
        {
            return ("camera", "Instagram", "bg-pink-600/90 text-white");
        }
        if (item.Type == MediaType.ShortReel)
        {
            return ("smartphone", "Short / Reel", "bg-indigo-600/90 text-white");
        }

        return item.Category switch
        {
            MediaCategory.QuickOverview => ("zap", "Cómo Funciona", "bg-amber-500 text-black"),
            MediaCategory.Tutorial => ("clapperboard", "Tutorial", "bg-[var(--brand-primary)] text-white"),
            MediaCategory.Gameplay => ("dices", !string.IsNullOrWhiteSpace(item.PlayerCountBadge) ? item.PlayerCountBadge : "Partida Completa", "bg-emerald-600 text-white"),
            MediaCategory.ReviewOpinion => ("message-circle", "Reseña / Opinión", "bg-purple-600 text-white"),
            _ => ("play", item.CategoryDisplayName, "bg-slate-700 text-white")
        };
    }

    private async Task ScrollMediaRailAsync(int distance)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("ludekaScrollRail", "media-carousel-rail", distance);
        }
        catch
        {
            // Interop defensivo
        }
    }

    private void OpenYouTubeSearchModal()
    {
        _isYouTubeSearchOpen = true;
    }

    private async Task HandleYouTubeVideoIngestedAsync()
    {
        _isYouTubeSearchOpen = false;
        _bannerSuccess = true;
        _bannerMessage = "Vídeo incorporado con éxito al Hub Multimedia.";
        await OnMediaChanged.InvokeAsync();
    }

    // Estados para Ingesta Flash
    private bool _isFlashIngestOpen;
    private string _flashUrl = string.Empty;
    private MediaCategory _flashCategory = MediaCategory.Tutorial;
    private string? _flashPlayerBadge;
    private string? _flashErrorMessage;
    private bool _isFlashIngesting;

    // Estados para el Modal de Moderación Directa
    private bool _isModModalOpen;
    private MediaItemDto? _itemToModerate;
    private MediaCategory _targetCategory;
    private string? _modMessage;
    private bool _modSuccess;
    private bool _isModProcessing;
    private bool _confirmingDelete;

    // Buscador asistido de juego
    private string _gameSearchQuery = string.Empty;
    private List<GameSummaryDto> _matchingGames = [];
    private GameSummaryDto? _selectedTargetGame;

    // Banner contextual en el componente
    private string? _bannerMessage;
    private bool _bannerSuccess;

    protected override void OnParametersSet()
    {
        // Se preserva el filtro o "all" por defecto.
    }

    private void OpenEmbedModal(MediaItemDto item)
    {
        _selectedMediaItem = item;
        _isEmbedModalOpen = true;
    }

    private void HandleCardKeyDown(KeyboardEventArgs e, MediaItemDto item)
    {
        if (e.Key is "Enter" or " ")
        {
            OpenEmbedModal(item);
        }
    }

    private void OpenModerateModal(MediaItemDto item)
    {
        _itemToModerate = item;
        _targetCategory = item.Category;
        _modMessage = null;
        _confirmingDelete = false;
        _gameSearchQuery = string.Empty;
        _matchingGames.Clear();
        _selectedTargetGame = null;
        _isModModalOpen = true;
    }

    private void CloseModerateModal()
    {
        _isModModalOpen = false;
        _itemToModerate = null;
        _modMessage = null;
    }

    private async Task SaveCategoryChangeAsync()
    {
        if (_itemToModerate == null) return;
        _isModProcessing = true;
        _modMessage = null;

        try
        {
            var updated = await MediaService.UpdateMediaCategoryAsync(_itemToModerate.Id, _targetCategory);
            if (updated != null)
            {
                _modSuccess = true;
                _modMessage = $"Categoría actualizada a '{updated.CategoryDisplayName}'.";
                _bannerSuccess = true;
                _bannerMessage = $"Se ha reubicado el vídeo '{_itemToModerate.Title}' a la categoría '{updated.CategoryDisplayName}'.";
                await OnMediaChanged.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            _modSuccess = false;
            _modMessage = $"Error al actualizar categoría: {ex.Message}";
        }
        finally
        {
            _isModProcessing = false;
        }
    }

    private async Task OnGameSearchInput(ChangeEventArgs e)
    {
        _gameSearchQuery = e.Value?.ToString() ?? string.Empty;
        if (_gameSearchQuery.Trim().Length >= 2)
        {
            var res = await CatalogService.GetCatalogAsync(new GameFilterCriteria(SearchTerm: _gameSearchQuery.Trim()), 1, 10);
            _matchingGames = res.Games.ToList();
        }
        else
        {
            _matchingGames.Clear();
        }
    }

    private void SelectTargetGame(GameSummaryDto game)
    {
        _selectedTargetGame = game;
    }

    private async Task ConfirmReassignmentAsync()
    {
        if (_itemToModerate == null || _selectedTargetGame == null) return;
        _isModProcessing = true;
        _modMessage = null;

        try
        {
            var updated = await MediaService.ReassignMediaGameAsync(_itemToModerate.Id, _selectedTargetGame.Id);
            if (updated != null)
            {
                _modSuccess = true;
                _modMessage = $"Vídeo reasignado con éxito a '{_selectedTargetGame.SpanishTitle}'.";
                _bannerSuccess = true;
                _bannerMessage = $"El vídeo '{_itemToModerate.Title}' ha sido transferido a la ficha de '{_selectedTargetGame.SpanishTitle}'.";
                await OnMediaChanged.InvokeAsync();
                await Task.Delay(1000);
                CloseModerateModal();
            }
        }
        catch (Exception ex)
        {
            _modSuccess = false;
            _modMessage = $"Error al reasignar juego: {ex.Message}";
        }
        finally
        {
            _isModProcessing = false;
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_itemToModerate == null) return;
        _isModProcessing = true;
        _modMessage = null;

        try
        {
            var success = await MediaService.DeleteMediaAsync(_itemToModerate.Id);
            if (success)
            {
                _modSuccess = true;
                _modMessage = "Vídeo eliminado de la ficha.";
                _bannerSuccess = true;
                _bannerMessage = $"El vídeo '{_itemToModerate.Title}' ha sido retirado de la ficha.";
                await OnMediaChanged.InvokeAsync();
                await Task.Delay(1000);
                CloseModerateModal();
            }
        }
        catch (Exception ex)
        {
            _modSuccess = false;
            _modMessage = $"Error al eliminar vídeo: {ex.Message}";
        }
        finally
        {
            _isModProcessing = false;
        }
    }

    private void PromptDeleteDirect(MediaItemDto item)
    {
        _itemToModerate = item;
        _targetCategory = item.Category;
        _modMessage = null;
        _confirmingDelete = true;
        _gameSearchQuery = string.Empty;
        _matchingGames.Clear();
        _selectedTargetGame = null;
        _isModModalOpen = true;
    }

    private void OpenFlashIngestModal()
    {
        _flashUrl = string.Empty;
        _flashErrorMessage = null;
        _flashPlayerBadge = null;
        _flashCategory = _activeFilter switch
        {
            "quick" => MediaCategory.QuickOverview,
            "playthroughs" => MediaCategory.Gameplay,
            "social" => MediaCategory.ReviewOpinion,
            _ => MediaCategory.Tutorial
        };
        _isFlashIngestOpen = true;
    }

    private void CloseFlashIngestModal()
    {
        if (_isFlashIngesting) return;
        _isFlashIngestOpen = false;
        _flashErrorMessage = null;
    }

    private async Task ExecuteFlashIngestAsync()
    {
        if (GameId == Guid.Empty)
        {
            _flashErrorMessage = "No se ha especificado el juego para la ingesta.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_flashUrl))
        {
            _flashErrorMessage = "Introduce una URL válida de YouTube.";
            return;
        }

        _isFlashIngesting = true;
        _flashErrorMessage = null;

        try
        {
            var created = await MediaService.FlashIngestAsync(
                GameId,
                _flashUrl.Trim(),
                _flashCategory,
                string.IsNullOrWhiteSpace(_flashPlayerBadge) ? null : _flashPlayerBadge.Trim());

            _isFlashIngestOpen = false;
            _bannerSuccess = true;
            _bannerMessage = $"¡Vídeo ingestado con éxito! '{created.Title}' añadido como {created.CategoryDisplayName}.";

            _activeFilter = created.Category switch
            {
                MediaCategory.QuickOverview => "quick",
                MediaCategory.Gameplay => "playthroughs",
                MediaCategory.ReviewOpinion => "social",
                _ => "tutorials"
            };

            await OnMediaChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _flashErrorMessage = ex.Message;
        }
        finally
        {
            _isFlashIngesting = false;
        }
    }
}
