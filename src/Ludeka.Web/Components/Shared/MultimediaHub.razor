@using Ludeka.Application.DTOs
@using Ludeka.Core.Enums
@using Ludeka.Application.Contracts
@inject IMediaService MediaService
@inject ICatalogService CatalogService
@inject ICurrentUserService CurrentUserService

<div class="p-6 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] shadow-xl space-y-6">
    @* Cabecera del Hub Multimedia *@
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <Icon Name="tv" Size="20" />
                <h2 class="text-lg font-black text-[var(--text-primary)] tracking-tight">
                    Hub Multimedia en Español
                </h2>
            </div>
            <p class="text-xs text-[var(--text-secondary)]">
                Tutoriales, partidas completas y reseñas en redes segregados sin mezclar formatos.
            </p>
        </div>

        @* Pestañas Selectoras *@
        <div class="flex items-center gap-1.5 p-1 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] self-start sm:self-auto overflow-x-auto max-w-full" role="tablist" aria-label="Formatos multimedia en español">
            <button type="button"
                    id="tab-quick"
                    role="tab"
                    aria-selected="@(_activeTab == "quick" ? "true" : "false")"
                    aria-controls="panel-quick"
                    @onclick='() => _activeTab = "quick"'
                    class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all whitespace-nowrap flex items-center gap-1.5 @(_activeTab == "quick" ? "bg-[var(--brand-primary)] text-white shadow-sm" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                <Icon Name="zap" Size="14" />
                <span>Cómo Funciona</span>
                <span class="px-1.5 py-0.2 rounded-full text-[0.65rem] @(_activeTab == "quick" ? "bg-black/20 text-white" : "bg-[var(--bg-card)] text-[var(--text-muted)]")">
                    @(MediaHub?.QuickOverviews.Count ?? 0)
                </span>
            </button>

            <button type="button"
                    id="tab-tutorials"
                    role="tab"
                    aria-selected="@(_activeTab == "tutorials" ? "true" : "false")"
                    aria-controls="panel-tutorials"
                    @onclick='() => _activeTab = "tutorials"'
                    class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all whitespace-nowrap flex items-center gap-1.5 @(_activeTab == "tutorials" ? "bg-[var(--brand-primary)] text-white shadow-sm" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                <Icon Name="clapperboard" Size="14" />
                <span>Tutoriales</span>
                <span class="px-1.5 py-0.2 rounded-full text-[0.65rem] @(_activeTab == "tutorials" ? "bg-black/20 text-white" : "bg-[var(--bg-card)] text-[var(--text-muted)]")">
                    @(MediaHub?.Tutorials.Count ?? 0)
                </span>
            </button>

            <button type="button"
                    id="tab-playthroughs"
                    role="tab"
                    aria-selected="@(_activeTab == "playthroughs" ? "true" : "false")"
                    aria-controls="panel-playthroughs"
                    @onclick='() => _activeTab = "playthroughs"'
                    class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all whitespace-nowrap flex items-center gap-1.5 @(_activeTab == "playthroughs" ? "bg-[var(--brand-primary)] text-white shadow-sm" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                <Icon Name="dices" Size="14" />
                <span>Partidas Completas</span>
                <span class="px-1.5 py-0.2 rounded-full text-[0.65rem] @(_activeTab == "playthroughs" ? "bg-black/20 text-white" : "bg-[var(--bg-card)] text-[var(--text-muted)]")">
                    @(MediaHub?.Playthroughs.Count ?? 0)
                </span>
            </button>

            <button type="button"
                    id="tab-social"
                    role="tab"
                    aria-selected="@(_activeTab == "social" ? "true" : "false")"
                    aria-controls="panel-social"
                    @onclick='() => _activeTab = "social"'
                    class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all whitespace-nowrap flex items-center gap-1.5 @(_activeTab == "social" ? "bg-[var(--brand-primary)] text-white shadow-sm" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                <Icon Name="message-circle" Size="14" />
                <span>Opiniones y Redes</span>
                <span class="px-1.5 py-0.2 rounded-full text-[0.65rem] @(_activeTab == "social" ? "bg-black/20 text-white" : "bg-[var(--bg-card)] text-[var(--text-muted)]")">
                    @((MediaHub?.InstagramPosts.Count ?? 0) + (MediaHub?.ShortReels.Count ?? 0) + (MediaHub?.ReviewsAndOpinions.Count ?? 0))
                </span>
            </button>
        </div>
    </div>

    @* Notificación de Acción de Moderación *@
    @if (!string.IsNullOrWhiteSpace(_bannerMessage))
    {
        <div class="p-3 rounded-xl text-xs font-semibold flex items-center justify-between animate-fade-in @(_bannerSuccess ? "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20" : "bg-rose-500/10 text-rose-400 border border-rose-500/20")">
            <span>@_bannerMessage</span>
            <button type="button" @onclick="() => _bannerMessage = null" class="opacity-70 hover:opacity-100"><Icon Name="x" Size="14" /></button>
        </div>
    }

    @* Contenido de las pestañas *@
    @if (_activeTab == "quick")
    {
        @* PESTAÑA: CÓMO FUNCIONA / VISTAZO EN 2 MIN (16:9) *@
        <div id="panel-quick" role="tabpanel" aria-labelledby="tab-quick">
            @if (MediaHub != null && MediaHub.QuickOverviews.Count > 0)
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    @foreach (var video in MediaHub.QuickOverviews)
                    {
                        <div class="group cursor-pointer rounded-xl overflow-hidden bg-[var(--bg-surface)] border border-[var(--border-subtle)] hover:border-[var(--brand-primary)] transition-all flex flex-col shadow-md focus:outline-none focus:ring-2 focus:ring-[var(--brand-primary)] relative"
                             role="button"
                             tabindex="0"
                             aria-label="@($"Reproducir cómo funciona: {video.Title}")"
                             @onkeydown="(e) => HandleCardKeyDown(e, video)"
                             @onclick="() => OpenEmbedModal(video)">
                            <div class="aspect-video relative overflow-hidden bg-black">
                                <img src="@video.ThumbnailUrl"
                                     alt="@video.Title"
                                     loading="lazy"
                                     decoding="async"
                                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                                
                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/20"></div>

                                @if (IsModeratorUser)
                                {
                                    <button type="button"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => OpenModerateModal(video)"
                                            title="Moderar vídeo"
                                            class="absolute top-2 right-2 z-20 px-2 py-1 rounded-lg bg-black/80 hover:bg-amber-600 text-white text-[0.65rem] font-bold transition-colors flex items-center gap-1 shadow backdrop-blur-sm border border-white/20">
                                        <Icon Name="settings" Size="12" /> Moderar
                                    </button>
                                }

                                <div class="absolute inset-0 flex items-center justify-center">
                                    <div class="w-12 h-12 rounded-full bg-amber-500/90 text-white flex items-center justify-center pl-0.5 shadow-lg group-hover:scale-110 group-hover:bg-amber-500 transition-all">
                                        <Icon Name="zap" Size="22" />
                                    </div>
                                </div>

                                <div class="absolute top-2 left-2 px-2 py-0.5 rounded-full bg-amber-500/90 text-black text-[0.62rem] font-bold tracking-tight shadow inline-flex items-center gap-1">
                                    <Icon Name="zap" Size="10" /> En 2 minutos
                                </div>

                                @if (!string.IsNullOrWhiteSpace(video.FormattedDuration))
                                {
                                    <div class="absolute bottom-2 right-2 px-2 py-0.5 rounded bg-black/80 text-white text-[0.68rem] font-mono font-bold tracking-tight inline-flex items-center gap-1">
                                        <Icon Name="timer" Size="10" /> @video.FormattedDuration
                                    </div>
                                }
                            </div>

                            <div class="p-3.5 flex-1 flex flex-col justify-between bg-[var(--bg-card)]">
                                <div>
                                    <div class="flex items-center justify-between gap-2 mb-0.5">
                                        <span class="text-[0.7rem] font-bold text-[var(--brand-primary)] truncate">
                                            @video.AuthorChannel
                                        </span>
                                        <LikeButton TargetType="LikeTargetType.MediaItem" TargetId="@video.Id" InitialLikesCount="@video.UserLikesCount" Compact="true" />
                                    </div>
                                    <h3 class="text-sm font-bold text-[var(--text-primary)] group-hover:text-[var(--brand-primary)] transition-colors line-clamp-2 leading-snug">
                                        @video.Title
                                    </h3>
                                </div>
                                <div class="mt-2.5 pt-2 border-t border-[var(--border-subtle)] flex items-center justify-between text-[0.68rem] text-[var(--text-muted)]">
                                    <span class="text-amber-500 font-semibold">Mecánicas & Vistazo Rápido</span>
                                    <span class="text-[var(--brand-primary)] font-semibold group-hover:underline">Ver cómo funciona &rarr;</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="py-12 px-4 text-center rounded-xl bg-[var(--bg-surface)] border border-dashed border-[var(--border-subtle)] space-y-2">
                    <span class="inline-block"><Icon Name="zap" Size="30" /></span>
                    <h3 class="text-sm font-bold text-[var(--text-primary)]">Sin vídeo de mecánicas rápidas todavía</h3>
                    <p class="text-xs text-[var(--text-secondary)] max-w-sm mx-auto">
                        Aún no tenemos un vídeo breve de 2 minutos para este título. Puedes consultar los tutoriales completos de reglas.
                    </p>
                </div>
            }
        </div>
    }
    else if (_activeTab == "tutorials")
    {
        @* PESTAÑA: TUTORIALES COMPLETOS (16:9) *@
        <div id="panel-tutorials" role="tabpanel" aria-labelledby="tab-tutorials">
            @if (MediaHub != null && MediaHub.Tutorials.Count > 0)
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    @foreach (var tutorial in MediaHub.Tutorials)
                    {
                        <div class="group cursor-pointer rounded-xl overflow-hidden bg-[var(--bg-surface)] border border-[var(--border-subtle)] hover:border-[var(--brand-primary)] transition-all flex flex-col shadow-md focus:outline-none focus:ring-2 focus:ring-[var(--brand-primary)] relative"
                             role="button"
                             tabindex="0"
                             aria-label="@($"Reproducir tutorial: {tutorial.Title}")"
                             @onkeydown="(e) => HandleCardKeyDown(e, tutorial)"
                             @onclick="() => OpenEmbedModal(tutorial)">
                            <div class="aspect-video relative overflow-hidden bg-black">
                                <img src="@tutorial.ThumbnailUrl"
                                     alt="@tutorial.Title"
                                     loading="lazy"
                                     decoding="async"
                                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                                
                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/20"></div>

                                @if (IsModeratorUser)
                                {
                                    <button type="button"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => OpenModerateModal(tutorial)"
                                            title="Moderar vídeo"
                                            class="absolute top-2 right-2 z-20 px-2 py-1 rounded-lg bg-black/80 hover:bg-amber-600 text-white text-[0.65rem] font-bold transition-colors flex items-center gap-1 shadow backdrop-blur-sm border border-white/20">
                                        <Icon Name="settings" Size="12" /> Moderar
                                    </button>
                                }

                                <div class="absolute inset-0 flex items-center justify-center">
                                    <div class="w-12 h-12 rounded-full bg-[var(--brand-primary)]/90 text-white flex items-center justify-center pl-0.5 shadow-lg group-hover:scale-110 group-hover:bg-[var(--brand-primary)] transition-all">
                                        <Icon Name="play" Size="22" />
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(tutorial.FormattedDuration))
                                {
                                    <div class="absolute bottom-2 right-2 px-2 py-0.5 rounded bg-black/80 text-white text-[0.68rem] font-mono font-bold tracking-tight inline-flex items-center gap-1">
                                        <Icon Name="timer" Size="10" /> @tutorial.FormattedDuration
                                    </div>
                                }
                            </div>

                            <div class="p-3.5 flex-1 flex flex-col justify-between bg-[var(--bg-card)]">
                                <div>
                                    <div class="flex items-center justify-between gap-2 mb-0.5">
                                        <span class="text-[0.7rem] font-bold text-[var(--brand-primary)] truncate">
                                            @tutorial.AuthorChannel
                                        </span>
                                        <LikeButton TargetType="LikeTargetType.MediaItem" TargetId="@tutorial.Id" InitialLikesCount="@tutorial.UserLikesCount" Compact="true" />
                                    </div>
                                    <h3 class="text-sm font-bold text-[var(--text-primary)] group-hover:text-[var(--brand-primary)] transition-colors line-clamp-2 leading-snug">
                                        @tutorial.Title
                                    </h3>
                                </div>
                                <div class="mt-2.5 pt-2 border-t border-[var(--border-subtle)] flex items-center justify-between text-[0.68rem] text-[var(--text-muted)]">
                                    <span>YouTube Tutorial</span>
                                    <span class="text-[var(--brand-primary)] font-semibold group-hover:underline">Reproducir &rarr;</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="p-8 text-center rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] max-w-md mx-auto">
                    <span class="inline-block mb-2"><Icon Name="clapperboard" Size="36" /></span>
                    <h3 class="text-sm font-bold text-[var(--text-primary)] mb-1">Aún no hay tutoriales en español</h3>
                    <p class="text-xs text-[var(--text-secondary)] mb-3 leading-relaxed">
                        Nadie ha añadido un tutorial de reglas de este juego a la comunidad todavía. ¿Conoces uno excelente de YouTube?
                    </p>
                    <a href="/moderacion-media" class="inline-block text-xs text-[var(--brand-primary)] hover:underline font-semibold">
                        &rarr; Avisar al equipo en moderación
                    </a>
                </div>
            }
        </div>
    }
    else if (_activeTab == "playthroughs")
    {
        @* PESTAÑA 2: PARTIDAS COMPLETAS (16:9 + BADGE DE COMENSALES) *@
        <div id="panel-playthroughs" role="tabpanel" aria-labelledby="tab-playthroughs">
            @if (MediaHub != null && MediaHub.Playthroughs.Count > 0)
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    @foreach (var play in MediaHub.Playthroughs)
                    {
                        <div class="group cursor-pointer rounded-xl overflow-hidden bg-[var(--bg-surface)] border border-[var(--border-subtle)] hover:border-[var(--brand-primary)] transition-all flex flex-col shadow-md focus:outline-none focus:ring-2 focus:ring-[var(--brand-primary)] relative"
                             role="button"
                             tabindex="0"
                             aria-label="@($"Ver partida completa: {play.Title}")"
                             @onkeydown="(e) => HandleCardKeyDown(e, play)"
                             @onclick="() => OpenEmbedModal(play)">
                            <div class="aspect-video relative overflow-hidden bg-black">
                                <img src="@play.ThumbnailUrl"
                                     alt="@play.Title"
                                     loading="lazy"
                                     decoding="async"
                                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                                
                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/20"></div>

                                @if (IsModeratorUser)
                                {
                                    <button type="button"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => OpenModerateModal(play)"
                                            title="Moderar vídeo"
                                            class="absolute top-2 right-2 z-20 px-2 py-1 rounded-lg bg-black/80 hover:bg-amber-600 text-white text-[0.65rem] font-bold transition-colors flex items-center gap-1 shadow backdrop-blur-sm border border-white/20">
                                        <Icon Name="settings" Size="12" /> Moderar
                                    </button>
                                }

                                <div class="absolute top-2.5 left-2.5">
                    <span class="px-2.5 py-1 rounded-lg bg-[var(--bg-nav)] text-[var(--text-primary)] border border-[var(--border-highlight)] font-bold text-xs shadow-lg flex items-center gap-1.5 backdrop-blur-sm">
                        <Icon Name="users" Size="12" aria-hidden="true" />
                        <span>@(play.PlayerCountBadge ?? "Partida")</span>
                    </span>
                                </div>

                                <div class="absolute inset-0 flex items-center justify-center">
                                    <div class="w-12 h-12 rounded-full bg-[var(--brand-primary)]/90 text-white flex items-center justify-center pl-0.5 shadow-lg group-hover:scale-110 group-hover:bg-[var(--brand-primary)] transition-all">
                                        <Icon Name="play" Size="22" />
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(play.FormattedDuration))
                                {
                                    <div class="absolute bottom-2 right-2 px-2 py-0.5 rounded bg-black/80 text-white text-[0.68rem] font-mono font-bold tracking-tight inline-flex items-center gap-1">
                                        <Icon Name="timer" Size="10" /> @play.FormattedDuration
                                    </div>
                                }
                            </div>

                            <div class="p-3.5 flex-1 flex flex-col justify-between bg-[var(--bg-card)]">
                                <div>
                                    <div class="flex items-center justify-between gap-2 mb-0.5">
                                        <span class="text-[0.7rem] font-bold text-[var(--brand-primary)] truncate">
                                            @play.AuthorChannel
                                        </span>
                                        <LikeButton TargetType="LikeTargetType.MediaItem" TargetId="@play.Id" InitialLikesCount="@play.UserLikesCount" Compact="true" />
                                    </div>
                                    <h3 class="text-sm font-bold text-[var(--text-primary)] group-hover:text-[var(--brand-primary)] transition-colors line-clamp-2 leading-snug">
                                        @play.Title
                                    </h3>
                                </div>
                                <div class="mt-2.5 pt-2 border-t border-[var(--border-subtle)] flex items-center justify-between text-[0.68rem] text-[var(--text-muted)]">
                                    <span class="text-emerald-500 font-semibold">Partida completa</span>
                                    <span class="text-[var(--brand-primary)] font-semibold group-hover:underline">Ver partida &rarr;</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="p-8 text-center rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] max-w-md mx-auto">
                    <span class="inline-block mb-2"><Icon Name="dices" Size="36" /></span>
                    <h3 class="text-sm font-bold text-[var(--text-primary)] mb-1">Sin partidas completas registradas</h3>
                    <p class="text-xs text-[var(--text-secondary)] mb-3 leading-relaxed">
                        Aún no tenemos partidas con número de comensales registradas en español para este juego.
                    </p>
                    <a href="/moderacion-media" class="inline-block text-xs text-[var(--brand-primary)] hover:underline font-semibold">
                        &rarr; Proponer partida en moderación
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        @* PESTAÑA 3: OPINIONES Y REDES (YouTube Reseñas + Instagram 1:1 + Shorts/Reels 9:16) *@
        <div id="panel-social" role="tabpanel" aria-labelledby="tab-social" class="space-y-6">
            @* Subsección 0: Reseñas y Análisis en Vídeo (YouTube) *@
            @if (MediaHub != null && MediaHub.ReviewsAndOpinions.Count > 0)
            {
                <div>
                    <div class="flex items-center gap-2 mb-3">
                        <span class="text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider inline-flex items-center gap-1.5">
                            <Icon Name="clapperboard" Size="12" /> Reseñas y Análisis Críticos
                        </span>
                        <div class="h-px flex-1 bg-[var(--border-subtle)]"></div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        @foreach (var review in MediaHub.ReviewsAndOpinions)
                        {
                            <div class="group cursor-pointer rounded-xl overflow-hidden bg-[var(--bg-surface)] border border-[var(--border-subtle)] hover:border-[var(--brand-primary)] transition-all flex flex-col shadow-md focus:outline-none focus:ring-2 focus:ring-[var(--brand-primary)] relative"
                                 role="button"
                                 tabindex="0"
                                 aria-label="@($"Reproducir reseña: {review.Title}")"
                                 @onkeydown="(e) => HandleCardKeyDown(e, review)"
                                 @onclick="() => OpenEmbedModal(review)">
                                <div class="aspect-video relative overflow-hidden bg-black">
                                    <img src="@review.ThumbnailUrl"
                                         alt="@review.Title"
                                         loading="lazy"
                                         decoding="async"
                                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />

                                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/20"></div>

                                    @if (IsModeratorUser)
                                    {
                                        <button type="button"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => OpenModerateModal(review)"
                                                title="Moderar vídeo"
                                                class="absolute top-2 right-2 z-20 px-2 py-1 rounded-lg bg-black/80 hover:bg-amber-600 text-white text-[0.65rem] font-bold transition-colors flex items-center gap-1 shadow backdrop-blur-sm border border-white/20">
                                            <Icon Name="settings" Size="12" /> Moderar
                                        </button>
                                    }

                                    <div class="absolute inset-0 flex items-center justify-center">
                                        <div class="w-12 h-12 rounded-full bg-[var(--brand-primary)]/90 text-white flex items-center justify-center pl-0.5 shadow-lg group-hover:scale-110 group-hover:bg-[var(--brand-primary)] transition-all">
                                            <Icon Name="play" Size="22" />
                                        </div>
                                    </div>

                                    <div class="absolute top-2 left-2 px-2 py-0.5 rounded-full bg-purple-500/90 text-white text-[0.62rem] font-bold tracking-tight shadow inline-flex items-center gap-1">
                                        <Icon Name="message-circle" Size="10" /> Reseña / Opinión
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(review.FormattedDuration))
                                    {
                                        <div class="absolute bottom-2 right-2 px-2 py-0.5 rounded bg-black/80 text-white text-[0.68rem] font-mono font-bold tracking-tight inline-flex items-center gap-1">
                                            <Icon Name="timer" Size="10" /> @review.FormattedDuration
                                        </div>
                                    }
                                </div>

                                <div class="p-3.5 flex-1 flex flex-col justify-between bg-[var(--bg-card)]">
                                    <div>
                                        <div class="flex items-center justify-between gap-2 mb-0.5">
                                            <span class="text-[0.7rem] font-bold text-[var(--brand-primary)] truncate">
                                                @review.AuthorChannel
                                            </span>
                                            <LikeButton TargetType="LikeTargetType.MediaItem" TargetId="@review.Id" InitialLikesCount="@review.UserLikesCount" Compact="true" />
                                        </div>
                                        <h3 class="text-sm font-bold text-[var(--text-primary)] group-hover:text-[var(--brand-primary)] transition-colors line-clamp-2 leading-snug">
                                            @review.Title
                                        </h3>
                                    </div>
                                    <div class="mt-2.5 pt-2 border-t border-[var(--border-subtle)] flex items-center justify-between text-[0.68rem] text-[var(--text-muted)]">
                                        <span class="text-purple-400 font-semibold">Crítica y Opinión</span>
                                        <span class="text-[var(--brand-primary)] font-semibold group-hover:underline">Ver análisis &rarr;</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* Subsección A: Posts de Instagram (1:1) *@
            @if (MediaHub != null && MediaHub.InstagramPosts.Count > 0)
            {
                <div>
                    <div class="flex items-center gap-2 mb-3">
                        <span class="text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider inline-flex items-center gap-1.5">
                            <Icon Name="camera" Size="12" /> Reseñas en Instagram (Fotos 1:1)
                        </span>
                        <div class="h-px flex-1 bg-[var(--border-subtle)]"></div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                        @foreach (var post in MediaHub.InstagramPosts)
                        {
                            <div class="group cursor-pointer rounded-xl overflow-hidden bg-[var(--bg-surface)] border border-[var(--border-subtle)] hover:border-[var(--brand-primary)] transition-all flex flex-col shadow-md focus:outline-none focus:ring-2 focus:ring-[var(--brand-primary)] relative"
                                 role="button"
                                 tabindex="0"
                                 aria-label="@($"Ver publicación de {post.AuthorChannel}: {post.Title}")"
                                 @onkeydown="(e) => HandleCardKeyDown(e, post)"
                                 @onclick="() => OpenEmbedModal(post)">
                                <div class="aspect-square relative overflow-hidden bg-black">
                                    <img src="@post.ThumbnailUrl"
                                         alt="@post.Title"
                                         loading="lazy"
                                         decoding="async"
                                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                                    
                                    @if (IsModeratorUser)
                                    {
                                        <button type="button"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => OpenModerateModal(post)"
                                                title="Moderar post"
                                                class="absolute top-2 right-2 z-20 px-2 py-1 rounded-lg bg-black/80 hover:bg-amber-600 text-white text-[0.65rem] font-bold transition-colors flex items-center gap-1 shadow backdrop-blur-sm border border-white/20">
                                            <Icon Name="settings" Size="12" /> Moderar
                                        </button>
                                    }

                                    @if (post.LikesCount.HasValue)
                                    {
                                        <div class="absolute bottom-2.5 left-2.5 px-2.5 py-1 rounded-full bg-black/75 text-white border border-white/20 text-xs font-bold flex items-center gap-1 backdrop-blur-sm">
                                            <Icon Name="heart" Size="12" aria-hidden="true" />
                                            <span>@post.LikesCount</span>
                                        </div>
                                    }
                                </div>

                                <div class="p-3 flex-1 flex flex-col justify-between bg-[var(--bg-card)]">
                                    <div>
                                        <span class="text-xs font-bold text-[var(--brand-primary)] block mb-1">
                                            @post.AuthorChannel
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(post.Excerpt))
                                        {
                                            <p class="text-xs text-[var(--text-secondary)] line-clamp-3 italic leading-relaxed">
                                                "@post.Excerpt"
                                            </p>
                                        }
                                        else
                                        {
                                            <p class="text-xs text-[var(--text-secondary)] line-clamp-2">
                                                @post.Title
                                            </p>
                                        }
                                    </div>
                                    <div class="mt-2 pt-2 border-t border-[var(--border-subtle)] text-[0.68rem] text-[var(--text-muted)] font-medium flex items-center justify-between">
                                        <span>Instagram</span>
                                        <span class="text-[var(--brand-primary)] font-semibold group-hover:underline">Ver reseña &rarr;</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* Subsección B: Vídeos Verticales (Reels / Shorts 9:16) *@
            @if (MediaHub != null && MediaHub.ShortReels.Count > 0)
            {
                <div>
                    <div class="flex items-center gap-2 mb-3">
                        <span class="text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider inline-flex items-center gap-1.5">
                            <Icon Name="smartphone" Size="12" /> Vídeos Verticales (Reels & Shorts 9:16)
                        </span>
                        <div class="h-px flex-1 bg-[var(--border-subtle)]"></div>
                    </div>

                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
                        @foreach (var reel in MediaHub.ShortReels)
                        {
                            <div class="group cursor-pointer rounded-xl overflow-hidden bg-[var(--bg-surface)] border border-[var(--border-subtle)] hover:border-[var(--brand-primary)] transition-all flex flex-col shadow-md focus:outline-none focus:ring-2 focus:ring-[var(--brand-primary)] relative"
                                 role="button"
                                 tabindex="0"
                                 aria-label="@($"Ver vídeo vertical de {reel.AuthorChannel}: {reel.Title}")"
                                 @onkeydown="(e) => HandleCardKeyDown(e, reel)"
                                 @onclick="() => OpenEmbedModal(reel)">
                                <div class="aspect-[9/16] relative overflow-hidden bg-black">
                                    <img src="@reel.ThumbnailUrl"
                                         alt="@reel.Title"
                                         loading="lazy"
                                         decoding="async"
                                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                                    
                                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/20"></div>

                                    @if (IsModeratorUser)
                                    {
                                        <button type="button"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => OpenModerateModal(reel)"
                                                title="Moderar vídeo"
                                                class="absolute top-2 right-2 z-20 px-2 py-1 rounded-lg bg-black/80 hover:bg-amber-600 text-white text-[0.65rem] font-bold transition-colors flex items-center gap-1 shadow backdrop-blur-sm border border-white/20">
                                            <Icon Name="settings" Size="12" /> Moderar
                                        </button>
                                    }

                                    <div class="absolute inset-0 flex items-center justify-center">
                                        <div class="w-10 h-10 rounded-full bg-[var(--brand-primary)]/90 text-white flex items-center justify-center pl-0.5 shadow-lg group-hover:scale-110 group-hover:bg-[var(--brand-primary)] transition-all">
                                            <Icon Name="play" Size="18" />
                                        </div>
                                    </div>

                                    <div class="absolute bottom-2 inset-x-2 flex items-center justify-between text-[0.68rem] text-white font-semibold">
                                        <span class="truncate max-w-[70%] text-white">@reel.AuthorChannel</span>
                                        @if (!string.IsNullOrWhiteSpace(reel.FormattedDuration))
                                        {
                                            <span class="px-1.5 py-0.5 rounded bg-black/80 font-mono text-[0.65rem]">
                                                @reel.FormattedDuration
                                            </span>
                                        }
                                    </div>
                                </div>

                                <div class="p-2 bg-[var(--bg-card)] border-t border-[var(--border-subtle)]">
                                    <h4 class="text-[0.72rem] font-bold text-[var(--text-primary)] truncate group-hover:text-[var(--brand-primary)]">
                                        @reel.Title
                                    </h4>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* Estado vacío si no hay posts ni reels ni reseñas *@
            @if (MediaHub == null || (!MediaHub.HasSocial))
            {
                <div class="p-8 text-center rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] max-w-md mx-auto">
                    <span class="inline-block mb-2"><Icon Name="message-circle" Size="36" /></span>
                    <h3 class="text-sm font-bold text-[var(--text-primary)] mb-1">Sin menciones en redes todavía</h3>
                    <p class="text-xs text-[var(--text-secondary)] mb-3 leading-relaxed">
                        Aún no se han indexado reseñas en vídeo, posts de Instagram ni Reels sobre este título.
                    </p>
                    <a href="/moderacion-media" class="inline-block text-xs text-[var(--brand-primary)] hover:underline font-semibold">
                        &rarr; Proponer post en moderación
                    </a>
                </div>
            }
        </div>
    }
</div>

@* Modal de reproducción embebida *@
<MediaEmbedModal
    IsOpen="@_isEmbedModalOpen"
    Item="@_selectedMediaItem"
    OnClose="() => _isEmbedModalOpen = false" />

@* Modal de Moderación Directa sobre Vídeo *@
@if (_isModModalOpen && _itemToModerate != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm animate-fade-in"
         @onclick="CloseModerateModal">
        <div class="bg-[var(--bg-card)] border border-[var(--border-subtle)] rounded-2xl w-full max-w-lg p-6 space-y-5 shadow-2xl"
             @onclick:stopPropagation="true">
            @* Cabecera *@
            <div class="flex items-center justify-between pb-3 border-b border-[var(--border-subtle)]">
                <div class="flex items-center gap-2">
                    <Icon Name="settings" Size="20" />
                    <h3 class="text-base font-bold text-[var(--text-primary)]">
                        Moderar Contenido Multimedia
                    </h3>
                </div>
                <button type="button" @onclick="CloseModerateModal" class="text-[var(--text-muted)] hover:text-[var(--text-primary)]"><Icon Name="x" Size="16" /></button>
            </div>

            @* Resumen del ítem *@
            <div class="flex items-start gap-3 p-3 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)]">
                <img src="@_itemToModerate.ThumbnailUrl" alt="@_itemToModerate.Title" class="w-20 h-14 object-cover rounded-lg shrink-0 border border-[var(--border-subtle)]" />
                <div class="min-w-0 flex-1 space-y-0.5">
                    <h4 class="text-xs font-bold text-[var(--text-primary)] line-clamp-2">@_itemToModerate.Title</h4>
                    <p class="text-[0.68rem] text-[var(--brand-primary)]">@_itemToModerate.AuthorChannel</p>
                    <span class="inline-block px-1.5 py-0.2 rounded bg-amber-500/10 text-amber-500 text-[0.62rem] font-bold">
                        Actual: @_itemToModerate.CategoryDisplayName
                    </span>
                </div>
            </div>

            @* Feedback / Mensaje de Estado *@
            @if (!string.IsNullOrWhiteSpace(_modMessage))
            {
                <div class="p-3 rounded-xl text-xs font-semibold @(_modSuccess ? "bg-emerald-500/10 text-emerald-500 border border-emerald-500/30" : "bg-rose-500/10 text-rose-500 border border-rose-500/30")">
                    @_modMessage
                </div>
            }

            @* Bloques de acción *@
            <div class="space-y-4">
                @* 1. Cambio Inmediato de Categoría *@
                <div class="p-3.5 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] space-y-2.5">
                    <h5 class="text-xs font-bold text-[var(--text-primary)] flex items-center gap-1.5">
                        <Icon Name="tag" Size="12" /> Cambiar Categoría
                    </h5>
                    <p class="text-[0.68rem] text-[var(--text-secondary)]">
                        Reubica el vídeo en otra pestaña de la ficha al instante.
                    </p>
                    <div class="flex items-center gap-2">
                        <select @bind="_targetCategory"
                                class="flex-1 px-3 py-1.5 rounded-lg bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]">
                            <option value="@MediaCategory.QuickOverview">Cómo Funciona (2 min)</option>
                            <option value="@MediaCategory.Tutorial">Tutorial (Reglas)</option>
                            <option value="@MediaCategory.Gameplay">Partida Completa</option>
                            <option value="@MediaCategory.ReviewOpinion">Reseña / Opinión</option>
                        </select>
                        <button type="button"
                                @onclick="SaveCategoryChangeAsync"
                                disabled="@_isModProcessing"
                                class="px-3 py-1.5 rounded-lg bg-[var(--brand-primary)] hover:opacity-90 text-white font-bold text-xs transition-opacity disabled:opacity-50">
                            Cambiar
                        </button>
                    </div>
                </div>

                @* 2. Reasignación de Juego *@
                <div class="p-3.5 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] space-y-2.5">
                    <h5 class="text-xs font-bold text-[var(--text-primary)] flex items-center gap-1.5">
                        <span class="inline-flex items-center gap-1"><Icon Name="repeat" Size="12" /> Reasignar a otro Juego</span>
                    </h5>
                    <p class="text-[0.68rem] text-[var(--text-secondary)]">
                        Transfiere el vídeo a otra ficha si corresponde a una expansión o juego diferente.
                    </p>
                    <div class="space-y-2">
                        <input type="text"
                               placeholder="Buscar título de juego (ej. Ark Nova, Wingspan...)"
                               value="@_gameSearchQuery"
                               @oninput="OnGameSearchInput"
                               class="w-full px-3 py-1.5 rounded-lg bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />

                        @if (_matchingGames.Count > 0)
                        {
                            <div class="max-h-32 overflow-y-auto space-y-1 p-1 bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] rounded-lg text-xs">
                                @foreach (var g in _matchingGames)
                                {
                                    <button type="button"
                                            @onclick="() => SelectTargetGame(g)"
                                            class="w-full text-left px-2 py-1 rounded hover:bg-[var(--brand-primary)]/10 text-[var(--text-primary)] flex items-center justify-between @(_selectedTargetGame?.Id == g.Id ? "bg-[var(--brand-primary)]/20 text-[var(--brand-primary)] font-bold" : "")">
                                        <span class="truncate">@g.SpanishTitle (@g.YearPublished)</span>
                                        @if (_selectedTargetGame?.Id == g.Id)
                                        {
                                            <span>✓</span>
                                        }
                                    </button>
                                }
                            </div>
                        }

                        @if (_selectedTargetGame != null)
                        {
                            <div class="flex items-center justify-between pt-1">
                                <span class="text-[0.68rem] text-[var(--text-secondary)]">
                                    Destino: <strong class="text-[var(--brand-primary)]">@_selectedTargetGame.SpanishTitle</strong>
                                </span>
                                <button type="button"
                                        @onclick="ConfirmReassignmentAsync"
                                        disabled="@_isModProcessing"
                                        class="px-3 py-1.5 rounded-lg bg-amber-600 hover:bg-amber-500 text-white font-bold text-xs transition-colors disabled:opacity-50">
                                    Reasignar
                                </button>
                            </div>
                        }
                    </div>
                </div>

                @* 3. Eliminación / Desvinculación *@
                <div class="p-3.5 rounded-xl bg-rose-500/5 border border-rose-500/20 flex items-center justify-between gap-3">
                    <div>
                        <h5 class="text-xs font-bold text-rose-400">Eliminar de la ficha</h5>
                        <p class="text-[0.68rem] text-[var(--text-secondary)]">Retira definitivamente este vídeo del catálogo.</p>
                    </div>
                    @if (!_confirmingDelete)
                    {
                        <button type="button"
                                @onclick="() => _confirmingDelete = true"
                                class="px-3 py-1.5 rounded-lg bg-rose-600/80 hover:bg-rose-600 text-white font-bold text-xs transition-colors shrink-0">
                            Eliminar
                        </button>
                    }
                    else
                    {
                        <div class="flex items-center gap-1.5 shrink-0">
                            <button type="button"
                                    @onclick="() => _confirmingDelete = false"
                                    class="px-2 py-1 rounded bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] text-xs">
                                Cancelar
                            </button>
                            <button type="button"
                                    @onclick="ConfirmDeleteAsync"
                                    disabled="@_isModProcessing"
                                    class="px-3 py-1 rounded bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs transition-colors">
                                Sí, eliminar
                            </button>
                        </div>
                    }
                </div>
            </div>

            @* Pie *@
            <div class="flex justify-end pt-2 border-t border-[var(--border-subtle)]">
                <button type="button"
                        @onclick="CloseModerateModal"
                        class="px-4 py-2 rounded-xl bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-primary)] font-bold text-xs border border-[var(--border-subtle)] transition-colors">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public GameMediaHubDto? MediaHub { get; set; }

    [Parameter]
    public string GameTitle { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnMediaChanged { get; set; }

    private string _activeTab = "tutorials";
    private bool _isEmbedModalOpen;
    private MediaItemDto? _selectedMediaItem;

    private bool IsModeratorUser => CurrentUserService.IsFoundingTeam || (CurrentUserService.IsInRole("Moderator") && CurrentUserService.HasPermission(ModeratorPermission.CanApproveMedia));

    // Estados para el Modal de Moderación Directa
    private bool _isModModalOpen;
    private MediaItemDto? _itemToModerate;
    private MediaCategory _targetCategory;
    private string? _modMessage;
    private bool _modSuccess;
    private bool _isModProcessing;
    private bool _confirmingDelete;

    // Buscador asistido de juego
    private string _gameSearchQuery = string.Empty;
    private List<GameSummaryDto> _matchingGames = [];
    private GameSummaryDto? _selectedTargetGame;

    // Banner contextual en el componente
    private string? _bannerMessage;
    private bool _bannerSuccess;

    protected override void OnParametersSet()
    {
        if (MediaHub != null && MediaHub.HasQuickOverviews && !MediaHub.HasTutorials && _activeTab == "tutorials")
        {
            _activeTab = "quick";
        }
        else if (MediaHub != null && !MediaHub.HasTutorials && MediaHub.HasPlaythroughs && _activeTab == "tutorials")
        {
            _activeTab = "playthroughs";
        }
        else if (MediaHub != null && !MediaHub.HasTutorials && !MediaHub.HasPlaythroughs && MediaHub.HasSocial && _activeTab == "tutorials")
        {
            _activeTab = "social";
        }
    }

    private void OpenEmbedModal(MediaItemDto item)
    {
        _selectedMediaItem = item;
        _isEmbedModalOpen = true;
    }

    private void HandleCardKeyDown(KeyboardEventArgs e, MediaItemDto item)
    {
        if (e.Key is "Enter" or " ")
        {
            OpenEmbedModal(item);
        }
    }

    private void OpenModerateModal(MediaItemDto item)
    {
        _itemToModerate = item;
        _targetCategory = item.Category;
        _modMessage = null;
        _confirmingDelete = false;
        _gameSearchQuery = string.Empty;
        _matchingGames.Clear();
        _selectedTargetGame = null;
        _isModModalOpen = true;
    }

    private void CloseModerateModal()
    {
        _isModModalOpen = false;
        _itemToModerate = null;
        _modMessage = null;
    }

    private async Task SaveCategoryChangeAsync()
    {
        if (_itemToModerate == null) return;
        _isModProcessing = true;
        _modMessage = null;

        try
        {
            var updated = await MediaService.UpdateMediaCategoryAsync(_itemToModerate.Id, _targetCategory);
            if (updated != null)
            {
                _modSuccess = true;
                _modMessage = $"Categoría actualizada a '{updated.CategoryDisplayName}'.";
                _bannerSuccess = true;
                _bannerMessage = $"Se ha reubicado el vídeo '{_itemToModerate.Title}' a la categoría '{updated.CategoryDisplayName}'.";
                await OnMediaChanged.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            _modSuccess = false;
            _modMessage = $"Error al actualizar categoría: {ex.Message}";
        }
        finally
        {
            _isModProcessing = false;
        }
    }

    private async Task OnGameSearchInput(ChangeEventArgs e)
    {
        _gameSearchQuery = e.Value?.ToString() ?? string.Empty;
        if (_gameSearchQuery.Trim().Length >= 2)
        {
            var res = await CatalogService.GetCatalogAsync(new GameFilterCriteria(SearchTerm: _gameSearchQuery.Trim()), 1, 10);
            _matchingGames = res.Games.ToList();
        }
        else
        {
            _matchingGames.Clear();
        }
    }

    private void SelectTargetGame(GameSummaryDto game)
    {
        _selectedTargetGame = game;
    }

    private async Task ConfirmReassignmentAsync()
    {
        if (_itemToModerate == null || _selectedTargetGame == null) return;
        _isModProcessing = true;
        _modMessage = null;

        try
        {
            var updated = await MediaService.ReassignMediaGameAsync(_itemToModerate.Id, _selectedTargetGame.Id);
            if (updated != null)
            {
                _modSuccess = true;
                _modMessage = $"Vídeo reasignado con éxito a '{_selectedTargetGame.SpanishTitle}'.";
                _bannerSuccess = true;
                _bannerMessage = $"El vídeo '{_itemToModerate.Title}' ha sido transferido a la ficha de '{_selectedTargetGame.SpanishTitle}'.";
                await OnMediaChanged.InvokeAsync();
                await Task.Delay(1000);
                CloseModerateModal();
            }
        }
        catch (Exception ex)
        {
            _modSuccess = false;
            _modMessage = $"Error al reasignar juego: {ex.Message}";
        }
        finally
        {
            _isModProcessing = false;
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_itemToModerate == null) return;
        _isModProcessing = true;
        _modMessage = null;

        try
        {
            var success = await MediaService.DeleteMediaAsync(_itemToModerate.Id);
            if (success)
            {
                _modSuccess = true;
                _modMessage = "Vídeo eliminado de la ficha.";
                _bannerSuccess = true;
                _bannerMessage = $"El vídeo '{_itemToModerate.Title}' ha sido retirado de la ficha.";
                await OnMediaChanged.InvokeAsync();
                await Task.Delay(1000);
                CloseModerateModal();
            }
        }
        catch (Exception ex)
        {
            _modSuccess = false;
            _modMessage = $"Error al eliminar vídeo: {ex.Message}";
        }
        finally
        {
            _isModProcessing = false;
        }
    }
}
