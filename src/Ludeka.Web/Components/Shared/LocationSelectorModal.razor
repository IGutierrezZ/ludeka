@using Ludeka.Application.Contracts
@using Ludeka.Core.ValueObjects
@inject IUserLocationService LocationService
@inject IUserPreferenceService PreferenceService
@inject ICurrentUserService CurrentUserService
@inject IJSRuntime JS
@inject NavigationManager Navigation

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-black/75 backdrop-blur-sm animate-fade-in"
         role="dialog"
         aria-modal="true"
         aria-labelledby="location-modal-title">
        <div class="w-full max-w-lg max-h-[90vh] flex flex-col rounded-3xl bg-[var(--bg-card)] border border-[var(--border-subtle)] shadow-2xl overflow-hidden"
             @onclick:stopPropagation="true">

            @* Cabecera *@
            <div class="p-5 border-b border-[var(--border-subtle)] flex items-center justify-between shrink-0 bg-[var(--bg-surface-elevated)]/50">
                <div class="flex items-center gap-2.5">
                    <Icon Name="earth" Size="24" />
                    <div>
                        <h2 id="location-modal-title" class="text-base font-black text-[var(--text-primary)]">
                            Ubicación y Ámbito Territorial
                        </h2>
                        <p class="text-xs text-[var(--text-secondary)]">
                            Personaliza el filtrado de tiendas, eventos y sorteos
                        </p>
                    </div>
                </div>
                <button type="button"
                        @onclick="Close"
                        class="text-[var(--text-muted)] hover:text-[var(--text-primary)] text-2xl w-8 h-8 flex items-center justify-center rounded-full hover:bg-[var(--bg-surface-elevated)] transition-colors">
                    &times;
                </button>
            </div>

            @* Cuerpo *@
            <div class="p-5 space-y-4 overflow-y-auto flex-1 text-xs">
                @* Advertencia obligatoria *@
                <div class="p-3.5 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-500 dark:text-amber-400 space-y-1">
                    <div class="flex items-center gap-1.5 font-black text-xs">
                        <Icon Name="triangle-alert" Size="14" />
                        <span>Aviso de Filtrado Territorial</span>
                    </div>
                    <p class="leading-relaxed">
                        Al seleccionar un país, los sorteos, eventos y tiendas se filtrarán automáticamente para mostrar únicamente los disponibles en tu territorio. Si prefieres explorar toda la información de la comunidad global sin filtrar, déjalo sin seleccionar.
                    </p>
                </div>

                @* Botón de autodetectar por zona horaria *@
                <div class="flex items-center justify-between p-3 rounded-2xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)]">
                    <div>
                        <span class="font-bold text-[var(--text-primary)] block">Detección automática</span>
                        <span class="text-[var(--text-muted)] text-[0.7rem]">Inferir país según la zona horaria del dispositivo</span>
                    </div>
                    <button type="button"
                            @onclick="AutoDetectCountryAsync"
                            class="px-3 py-1.5 rounded-xl bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-white font-bold text-xs transition-colors inline-flex items-center gap-1.5 shadow-sm">
                        <Icon Name="map-pin" Size="14" />
                        <span>Detectar</span>
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(_statusMessage))
                {
                    <div class="p-2.5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-500 font-bold text-center">
                        @_statusMessage
                    </div>
                }

                @* Buscador de países *@
                <div>
                    <input type="text"
                           @bind="_searchFilter"
                           @bind:event="oninput"
                           placeholder="Buscar país en la lista..."
                           class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
                </div>

                @* Opción sin país (Global) *@
                <div class="pt-1">
                    <button type="button"
                            @onclick="() => SelectCountryAsync(null)"
                            class="w-full p-3 rounded-2xl border text-left transition-all flex items-center justify-between @(string.IsNullOrWhiteSpace(_currentCountry) ? "border-[var(--brand-primary)] bg-[var(--brand-glow)] ring-2 ring-[var(--brand-primary)]/20" : "border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)] hover:border-[var(--border-highlight)]")">
                        <div class="flex items-center gap-2.5">
                            <Icon Name="earth" Size="20" />
                            <div>
                                <span class="font-black text-sm text-[var(--text-primary)] block">Sin país seleccionado (Global)</span>
                                <span class="text-[var(--text-muted)] text-[0.7rem]">Ver todas las tiendas, sorteos y eventos sin filtrado territorial</span>
                            </div>
                        </div>
                        @if (string.IsNullOrWhiteSpace(_currentCountry))
                        {
                            <span class="px-2 py-0.5 rounded-md bg-[var(--brand-primary)] text-white font-bold text-[0.65rem]">
                                Activo
                            </span>
                        }
                    </button>
                </div>

                @* Listado de países *@
                <div class="space-y-1.5 max-h-60 overflow-y-auto pr-1">
                    @foreach (var c in FilteredCountries)
                    {
                        bool isSelected = string.Equals(_currentCountry, c.Name, StringComparison.OrdinalIgnoreCase);
                        <button type="button"
                                @onclick="() => SelectCountryAsync(c.Name)"
                                class="w-full px-3 py-2.5 rounded-xl border text-left transition-all flex items-center justify-between @(isSelected ? "border-[var(--brand-primary)] bg-[var(--brand-glow)] ring-1 ring-[var(--brand-primary)]/30" : "border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:bg-[var(--bg-surface-elevated)] hover:border-[var(--border-highlight)]")">
                            <div class="flex items-center gap-2.5">
                                <span class="text-xl">@c.FlagEmoji</span>
                                <span class="font-bold text-[var(--text-primary)]">@c.Name</span>
                                <span class="text-[0.65rem] text-[var(--text-muted)] uppercase">(@c.Code)</span>
                            </div>
                            @if (isSelected)
                            {
                                <span class="px-2 py-0.5 rounded-md bg-[var(--brand-primary)] text-white font-bold text-[0.65rem]">
                                    Seleccionado
                                </span>
                            }
                        </button>
                    }
                </div>
            </div>

            @* Pie *@
            <div class="p-4 border-t border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)]/30 flex items-center justify-end">
                <button type="button"
                        @onclick="Close"
                        class="px-4 py-2 rounded-xl border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] text-xs font-bold transition-colors">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<string?> OnCountryChanged { get; set; }

    private string? _currentCountry;
    private string _searchFilter = string.Empty;
    private string? _statusMessage;

    private IEnumerable<CountryInfo> FilteredCountries =>
        string.IsNullOrWhiteSpace(_searchFilter)
            ? CountryCatalog.GetAllCountries()
            : CountryCatalog.GetAllCountries().Where(c => c.Name.Contains(_searchFilter, StringComparison.OrdinalIgnoreCase) || c.Code.Contains(_searchFilter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen)
        {
            _currentCountry = await LocationService.GetEffectiveCountryAsync();
            _statusMessage = null;
        }
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task SelectCountryAsync(string? country)
    {
        _currentCountry = country;

        try
        {
            // Preferencia con identidad: sin sesión la acción lleva al acceso (INC-46 F4).
            await PreferenceService.SetUserCountryAsync(CurrentUserService.UserId, country);
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
            return;
        }

        LocationService.SetUserCountry(country);

        try
        {
            await JS.InvokeVoidAsync("setStoredUserCountry", country, CurrentUserService.UserId);
        }
        catch
        {
        }

        _statusMessage = country != null
            ? $"País configurado a {CountryCatalog.GetFlag(country)} {country}."
            : "Ámbito global restablecido (sin filtro).";

        await OnCountryChanged.InvokeAsync(country);
    }

    private async Task AutoDetectCountryAsync()
    {
        try
        {
            var detected = await JS.InvokeAsync<string?>("detectUserCountry");
            if (!string.IsNullOrWhiteSpace(detected))
            {
                LocationService.SetDetectedCountry(detected);
                await SelectCountryAsync(detected);
            }
            else
            {
                _statusMessage = "No se pudo determinar el país automáticamente desde la zona horaria.";
            }
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error al detectar: {ex.Message}";
        }
    }
}
