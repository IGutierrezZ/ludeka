@using System
@using Ludeka.Application.DTOs

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-fade-in"
         role="dialog"
         aria-modal="true"
         aria-labelledby="loan-modal-title"
         @onclick="HandleBackdropClick">
        <div class="w-full max-w-md bg-[var(--bg-card)] border border-[var(--border-subtle)] rounded-2xl shadow-2xl p-6 text-left relative overflow-hidden"
             @onclick:stopPropagation="true">
            
            @* Header *@
            <div class="flex items-center justify-between pb-4 border-b border-[var(--border-subtle)]">
                <div class="flex items-center gap-2">
                    <Icon Name="package" Size="24" />
                    <h3 id="loan-modal-title" class="text-base font-bold text-[var(--text-primary)]">
                        @(ActiveLoan != null ? "Préstamo Activo" : "Registrar Préstamo")
                    </h3>
                </div>
                <button type="button" @onclick="Close"
                        aria-label="Cerrar modal de préstamo"
                        class="text-[var(--text-muted)] hover:text-[var(--text-primary)] p-1 rounded-lg text-lg transition-colors">
                    &times;
                </button>
            </div>

            @* Body *@
            <div class="py-4 space-y-4">
                @if (ActiveLoan != null)
                {
                    @* Ficha de préstamo activo *@
                    <div class="p-4 rounded-xl bg-amber-500/10 border border-amber-500/25 space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xs uppercase font-bold text-amber-600 dark:text-amber-400">Prestatario</span>
                            <span class="text-sm font-bold text-[var(--text-primary)]">@ActiveLoan.BorrowerName</span>
                        </div>
                        <div class="flex items-center justify-between text-xs text-[var(--text-secondary)]">
                            <span>Fecha de entrega:</span>
                            <span class="font-semibold text-[var(--text-primary)]">@ActiveLoan.LoanDate.ToString("dd/MM/yyyy")</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(ActiveLoan.Notes))
                        {
                            <div class="text-xs text-[var(--text-secondary)] pt-2 border-t border-[var(--border-subtle)]">
                                <em>Notas: @ActiveLoan.Notes</em>
                            </div>
                        }
                    </div>

                    <p class="text-xs text-[var(--text-secondary)]">
                        ¿Ya recuperaste la copia física de tu juego de mesa?
                    </p>

                    <button type="button"
                            @onclick="HandleReturnLoan"
                            class="w-full py-3 px-4 rounded-xl text-xs font-bold uppercase tracking-wider bg-[var(--color-mustplay)] hover:opacity-90 text-white shadow-sm transition-all flex items-center justify-center gap-2">
                        <Icon Name="undo-2" Size="14" />
                        <span>Marcar como devuelto (1 clic)</span>
                    </button>
                }
                else
                {
                    @* Formulario de nuevo préstamo *@
                    @if (!string.IsNullOrWhiteSpace(GameTitle))
                    {
                        <div class="p-3 rounded-xl bg-[var(--brand-primary)]/10 border border-[var(--brand-primary)]/20 text-xs font-bold text-[var(--brand-primary)]">
                            Juego: @GameTitle
                        </div>
                    }

                    <p class="text-xs text-[var(--text-secondary)]">
                        Apunta a quién le has dejado este juego para no perderle la pista jamás en tu perfil.
                    </p>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="p-3 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-600 dark:text-rose-300 text-xs font-semibold">
                            @_errorMessage
                        </div>
                    }

                    <div class="space-y-3">
                        @if (string.IsNullOrWhiteSpace(GameTitle) && AvailableGames != null && AvailableGames.Count > 0)
                        {
                            <div>
                                <label for="loan-game-select" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1">
                                    Juego a prestar <span class="text-rose-500">*</span>
                                </label>
                                <select id="loan-game-select"
                                        @bind="_selectedGameId"
                                        class="w-full px-3.5 py-2.5 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]">
                                    @foreach (var g in AvailableGames)
                                    {
                                        <option value="@g.GameId">@g.GameTitle</option>
                                    }
                                </select>
                            </div>
                        }

                        <div>
                            <label for="loan-borrower-name" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1">
                                Persona o Asociación <span class="text-rose-500">*</span>
                            </label>
                            <input id="loan-borrower-name"
                                   type="text"
                                   @bind="_borrowerName"
                                   placeholder="Ej. Carlos (Asociación Ludens)"
                                   class="w-full px-3.5 py-2.5 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-sm text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
                        </div>

                        <div>
                            <label for="loan-date-input" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1">
                                Fecha del Préstamo
                            </label>
                            <input id="loan-date-input"
                                   type="date"
                                   @bind="_loanDate"
                                   class="w-full px-3.5 py-2.5 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                        </div>

                        <div>
                            <label for="loan-notes-input" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1">
                                Notas o contacto (opcional)
                            </label>
                            <input id="loan-notes-input"
                                   type="text"
                                   @bind="_notes"
                                   placeholder="Ej. Lo devuelve en la quedada del jueves"
                                   class="w-full px-3.5 py-2.5 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-sm text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
                        </div>
                    </div>

                    <div class="pt-3 flex gap-3">
                        <button type="button" @onclick="Close"
                                class="flex-1 py-2.5 px-4 rounded-xl text-xs font-semibold bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-secondary)] border border-[var(--border-subtle)] transition-colors">
                            Cancelar
                        </button>
                        <button type="button"
                                @onclick="HandleCreateLoan"
                                class="flex-1 py-2.5 px-4 rounded-xl text-xs font-bold uppercase tracking-wider bg-[var(--brand-primary)] hover:opacity-90 text-white shadow-sm transition-opacity">
                            Prestar
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public Guid? GameId { get; set; }

    [Parameter]
    public string? GameTitle { get; set; }

    [Parameter]
    public IReadOnlyList<UserCollectionItemDto>? AvailableGames { get; set; }

    [Parameter]
    public GameLoanDto? ActiveLoan { get; set; }

    [Parameter]
    public EventCallback<CreateLoanRequest> OnCreateLoan { get; set; }

    [Parameter]
    public EventCallback<Guid> OnReturnLoan { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private Guid _selectedGameId;
    private string _borrowerName = string.Empty;
    private DateTime _loanDate = DateTime.Today;
    private string? _notes;
    private string? _errorMessage;

    protected override void OnParametersSet()
    {
        if (GameId.HasValue && GameId.Value != Guid.Empty)
        {
            _selectedGameId = GameId.Value;
        }
        else if (AvailableGames != null && AvailableGames.Count > 0 && (_selectedGameId == Guid.Empty || !AvailableGames.Any(g => g.GameId == _selectedGameId)))
        {
            _selectedGameId = AvailableGames[0].GameId ?? Guid.Empty;
        }
    }

    private async Task HandleCreateLoan()
    {
        _errorMessage = null;

        var targetGameId = GameId ?? (_selectedGameId != Guid.Empty ? _selectedGameId : Guid.Empty);

        if (string.IsNullOrWhiteSpace(_borrowerName))
        {
            _errorMessage = "Por favor indica el nombre de la persona o asociación.";
            return;
        }

        var req = new CreateLoanRequest(targetGameId, _borrowerName, new DateTimeOffset(_loanDate), _notes);
        await OnCreateLoan.InvokeAsync(req);
        _borrowerName = string.Empty;
        _notes = null;
        await Close();
    }

    private async Task HandleReturnLoan()
    {
        if (ActiveLoan != null)
        {
            await OnReturnLoan.InvokeAsync(ActiveLoan.Id);
            await Close();
        }
    }

    private async Task Close()
    {
        _errorMessage = null;
        await OnClose.InvokeAsync();
    }

    private async Task HandleBackdropClick()
    {
        await Close();
    }
}
