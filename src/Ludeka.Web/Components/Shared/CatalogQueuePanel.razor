@using Ludeka.Application.Contracts
@using Ludeka.Application.DTOs
@using Ludeka.Core.Enums
@inject IBggCatalogQueueService QueueService
@inject IAiGameSummaryService AiSummaryService
@inject ICurrentUserService CurrentUserService
@inject NavigationManager Navigation

<div class="p-6 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[var(--border-subtle)] pb-4">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border border-[var(--border-subtle)]">
                    Comunidad & Catálogo
                </span>
                <span class="text-xs text-[var(--text-muted)]">@_totalCount títulos en cola</span>
            </div>
            <h3 class="text-xl font-bold text-[var(--text-primary)] tracking-tight">
                Cola de Auto-Catalogación Comunitaria
            </h3>
            <p class="text-xs text-[var(--text-muted)] mt-0.5">
                Juegos solicitados por usuarios en sus importaciones de BGG, ordenados por popularidad.
            </p>
        </div>

        @if (CurrentUserService.IsFoundingTeam || (CurrentUserService.IsInRole("Moderator") && CurrentUserService.HasPermission(ModeratorPermission.CanEditGames)))
        {
            <div class="flex items-center gap-2 flex-wrap">
                @if (_items.Any(i => i.Status == CatalogQueueStatus.Failed))
                {
                    <button type="button" 
                            @onclick="RetryFailedItemsAsync"
                            disabled="@_isProcessing"
                            title="Restablecer elementos fallidos a estado pendiente para reintentar la catalogación"
                            class="py-2.5 px-3 rounded-xl font-semibold text-xs bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border-subtle)] transition-all flex items-center gap-1.5 shadow-sm disabled:opacity-50">
                        <Icon Name="refresh-cw" Size="14" />
                        <span>Reintentar Fallidos</span>
                    </button>
                }

                <button type="button" 
                        @onclick="ProcessAiBatchAsync"
                        disabled="@(_isProcessingAi || _isProcessing)"
                        title="Ejecutar la carga nocturna de síntesis con IA para enriquecer juegos del catálogo pendientes"
                        class="py-2.5 px-3.5 rounded-xl font-bold text-xs bg-indigo-600 hover:bg-indigo-500 text-white transition-colors flex items-center gap-2 shadow-sm disabled:opacity-50 disabled:cursor-not-allowed">
                    @if (_isProcessingAi)
                    {
                        <span class="animate-spin inline-block"><Icon Name="settings" Size="14" /></span>
                        <span>Carga Nocturna IA...</span>
                    }
                    else
                    {
                        <Icon Name="moon" Size="14" />
                        <span>Carga Nocturna IA</span>
                    }
                </button>

                <button type="button" 
                        @onclick="ProcessQueueBatchAsync"
                        disabled="@(_isProcessing || _items.Count == 0)"
                        class="py-2.5 px-4 rounded-xl font-bold text-xs bg-[var(--brand-primary)] hover:opacity-90 text-white transition-opacity flex items-center gap-2 shadow-sm disabled:opacity-50 disabled:cursor-not-allowed">
                    @if (_isProcessing)
                    {
                        <span class="animate-spin inline-block"><Icon Name="settings" Size="14" /></span>
                        <span>Auto-Catalogando...</span>
                    }
                    else
                    {
                        <Icon Name="zap" Size="14" />
                        <span>Ejecutar Auto-Catalogación Ahora</span>
                    }
                </button>
            </div>
        }
    </div>

    @if (_lastAiResult != null)
    {
        <div class="p-4 rounded-xl bg-indigo-500/10 border border-indigo-500/25 text-xs space-y-2">
            <div class="font-bold text-indigo-400 flex items-center gap-2">
                <Icon Name="moon" Size="14" />
                <span>Carga nocturna de IA finalizada: @_lastAiResult.SuccessCount sintetizados con éxito (@_lastAiResult.FailedCount fallos).</span>
            </div>
            @if (_lastAiResult.SummarizedTitles.Count > 0)
            {
                <div class="text-[var(--text-secondary)]">
                    Juegos enriquecidos con IA: <strong class="text-indigo-300">@string.Join(", ", _lastAiResult.SummarizedTitles)</strong>
                </div>
            }
        </div>
    }

    @if (_lastResult != null)
    {
        @if (_lastResult.SuccessCount > 0 && _lastResult.FailedCount == 0)
        {
            <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/25 text-xs space-y-2">
                <div class="font-bold text-emerald-600 dark:text-emerald-300 flex items-center gap-2">
                    <Icon Name="circle-check" Size="14" />
                    <span>Proceso completado con éxito: @_lastResult.SuccessCount juegos catalogados e incorporados al catálogo.</span>
                </div>
                @if (_lastResult.CatalogedGameTitles.Count > 0)
                {
                    <div class="text-[var(--text-secondary)]">
                        Títulos incorporados al catálogo y promovidos en ludotecas:
                        <strong class="text-emerald-600 dark:text-emerald-400">@string.Join(", ", _lastResult.CatalogedGameTitles)</strong>
                    </div>
                }
            </div>
        }
        else if (_lastResult.SuccessCount > 0 && _lastResult.FailedCount > 0)
        {
            <div class="p-4 rounded-xl bg-amber-500/10 border border-amber-500/25 text-xs space-y-2">
                <div class="font-bold text-amber-600 dark:text-amber-300 flex items-center gap-2">
                    <Icon Name="triangle-alert" Size="14" />
                    <span>Proceso parcial: @_lastResult.SuccessCount catalogados con éxito, pero @_lastResult.FailedCount fallaron.</span>
                </div>
                <div class="text-[var(--text-secondary)]">
                    Títulos incorporados: <strong class="text-emerald-600 dark:text-emerald-400">@string.Join(", ", _lastResult.CatalogedGameTitles)</strong>
                </div>
                <p class="text-[var(--text-muted)] text-[0.7rem]">
                    Los elementos fallidos permanecen en la cola para que puedas reintentarlos.
                </p>
            </div>
        }
        else
        {
            <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/25 text-xs space-y-2">
                <div class="font-bold text-rose-600 dark:text-rose-300 flex items-center gap-2">
                    <Icon Name="circle-x" Size="14" />
                    <span>Fallo en la auto-catalogación: 0 de @_lastResult.ProcessedCount solicitudes procesadas con éxito (@_lastResult.FailedCount fallos).</span>
                </div>
                <p class="text-[var(--text-secondary)] leading-relaxed">
                    La API de BoardGameGeek requiere autenticación registrada (HTTP 401 Unauthorized) o no se pudo conectar.
                    <strong>Los juegos no se han eliminado de la cola</strong> y están listos para reintentarse cuando configures tus credenciales de BGG.
                </p>
                <div class="pt-1">
                    <p class="text-[0.7rem] text-[var(--text-muted)] mb-1">Para configurar tu token de BGG de forma segura en tu equipo local:</p>
                    <code class="px-2.5 py-1 rounded-md bg-[var(--bg-surface-elevated)] text-[var(--text-primary)] font-mono text-[0.7rem] block overflow-x-auto border border-[var(--border-subtle)]">
                        dotnet user-secrets set "Bgg:ApiToken" "TU_TOKEN_AQUI" --project src/Ludeka.Web
                    </code>
                </div>
            </div>
        }
    }

    @if (_isLoading)
    {
        <div class="py-8 text-center text-[var(--text-muted)]">
            <div class="inline-block animate-spin mb-2"><Icon Name="hourglass" Size="24" /></div>
            <p class="text-xs">Consultando la cola comunitaria...</p>
        </div>
    }
    else if (_items.Count == 0)
    {
        <div class="py-8 text-center text-[var(--text-muted)] max-w-sm mx-auto">
            <span class="inline-block mb-2"><Icon Name="sparkles" Size="30" /></span>
            <p class="text-xs font-bold text-[var(--text-primary)]">¡No hay juegos pendientes en la cola!</p>
            <p class="text-[0.75rem] text-[var(--text-muted)] mt-1">Todos los juegos solicitados han sido catalogados en el catálogo general.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
            @foreach (var item in _items)
            {
                <div class="p-3.5 rounded-xl @(item.Status == CatalogQueueStatus.Failed ? "bg-rose-500/10 border-rose-500/25" : "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)]") border flex items-center gap-3">
                    @if (!string.IsNullOrWhiteSpace(item.ThumbnailUrl))
                    {
                        <img src="@item.ThumbnailUrl"
                             alt="@item.Title"
                             onerror="this.onerror=null; this.src='/images/game-placeholder.svg';"
                             class="w-12 h-12 object-cover rounded-lg bg-[var(--bg-card)] flex-shrink-0" />
                    }
                    else
                    {
                        <img src="/images/game-placeholder.svg"
                             alt="Carátula no disponible"
                             class="w-12 h-12 object-cover rounded-lg bg-[var(--bg-card)] flex-shrink-0 opacity-90" />
                    }

                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-1.5">
                            <h4 class="text-xs font-bold text-[var(--text-primary)] truncate" title="@item.Title">
                                @item.Title
                            </h4>
                            @if (item.YearPublished.HasValue)
                            {
                                <span class="text-[0.65rem] text-[var(--text-muted)] font-mono">(@item.YearPublished)</span>
                            }
                        </div>
                        <div class="flex items-center gap-2 mt-1 flex-wrap">
                            <span class="text-[0.68rem] font-semibold px-2 py-0.5 rounded-md bg-amber-500/10 text-amber-600 dark:text-amber-300 border border-amber-500/25">
                                <Icon Name="flame" Size="12" /> @item.RequestedCount @(item.RequestedCount == 1 ? "solicitud" : "solicitudes")
                            </span>
                            @if (item.Status == CatalogQueueStatus.Failed)
                            {
                                <span class="text-[0.65rem] font-semibold px-1.5 py-0.5 rounded bg-rose-500/10 text-rose-600 dark:text-rose-300 border border-rose-500/25" title="@(item.ErrorMessage ?? "Error al conectar con BGG")">
                                    <span class="inline-flex items-center gap-1"><Icon Name="triangle-alert" Size="12" /> Falló (Reintentable)</span>
                                </span>
                            }
                            <span class="text-[0.65rem] text-[var(--text-muted)] font-mono">ID: @item.BggId</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback OnQueueProcessed { get; set; }

    private bool _isLoading = true;
    private bool _isProcessing = false;
    private int _totalCount = 0;
    private IReadOnlyList<CatalogQueueItemDto> _items = [];
    private ProcessQueueResultDto? _lastResult;

    protected override async Task OnInitializedAsync()
    {
        await LoadQueueAsync();
    }

    private async Task LoadQueueAsync()
    {
        _isLoading = true;
        try
        {
            _totalCount = await QueueService.GetTotalPendingCountAsync();
            _items = await QueueService.GetTopPendingQueueAsync(12);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ProcessQueueBatchAsync()
    {
        _isProcessing = true;
        _lastResult = null;

        try
        {
            _lastResult = await QueueService.ProcessPendingQueueBatchAsync(5);
            await LoadQueueAsync();
            await OnQueueProcessed.InvokeAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            // El panel vive en una página pública: la denegación por permiso lleva al acceso.
            Navigation.TryRedirectToLogin(ex);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task RetryFailedItemsAsync()
    {
        _isLoading = true;
        try
        {
            await QueueService.ResetFailedItemsAsync();
            await LoadQueueAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private bool _isProcessingAi = false;
    private AiBatchProcessingResultDto? _lastAiResult;

    private async Task ProcessAiBatchAsync()
    {
        _isProcessingAi = true;
        _lastAiResult = null;

        try
        {
            _lastAiResult = await AiSummaryService.ProcessPendingSummariesBatchAsync(10);
            await OnQueueProcessed.InvokeAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
        }
        finally
        {
            _isProcessingAi = false;
        }
    }
}
