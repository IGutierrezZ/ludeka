@using Ludeka.Core.Enums
@using Ludeka.Application.DTOs

<div class="rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)] p-4 sm:p-5 shadow-sm space-y-4">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
            <span class="text-[0.68rem] uppercase font-bold text-[var(--text-muted)] tracking-wider block mb-1">
                Tu Ludoteca Personal
            </span>
            <p class="text-xs text-[var(--text-secondary)] flex flex-wrap items-center gap-2">
                @if (CurrentItem != null && (CurrentItem.Status.HasValue || CurrentItem.IsPlayed))
                {
                    <span>Estado actual: <strong class="text-[var(--text-primary)]">@GetStatusName(CurrentItem.Status, CurrentItem.IsPlayed)</strong></span>
                }
                else
                {
                    <span>Añade este título a tu colección lúdica:</span>
                }

                @if (PlayCount > 0)
                {
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[0.68rem] font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
                        <Icon Name="dices" Size="12" />
                        <span>@PlayCount @(PlayCount == 1 ? "partida" : "partidas")</span>
                    </span>
                }
            </p>
        </div>

        <div class="w-full sm:w-auto flex flex-wrap items-center gap-2">
            @* Botón de Registrar Partida *@
            <button type="button"
                    @onclick="() => OnRecordPlayClicked.InvokeAsync()"
                    class="w-full sm:w-auto px-3.5 py-1.5 rounded-lg text-xs font-bold bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-white transition-all flex items-center justify-center gap-1.5 shadow-sm">
                <Icon Name="plus" Size="12" />
                <span>Registrar partida</span>
            </button>
            @* Botón de Préstamos (solo si está en propiedad física) *@
            @if (CurrentItem?.Status == CollectionStatus.InCollection)
            {
                @if (ActiveLoan != null)
                {
                    <button type="button"
                            @onclick="OnLoanClicked"
                            class="w-full sm:w-auto px-3 py-1.5 rounded-lg text-xs font-semibold bg-amber-500/10 text-amber-500 dark:text-amber-300 border border-amber-500/30 hover:bg-amber-500/20 transition-all flex items-center justify-center gap-1.5 shadow-sm">
                        <Icon Name="package" Size="12" />
                        <span>Prestado a <strong>@ActiveLoan.BorrowerName</strong></span>
                    </button>
                }
                else
                {
                    <button type="button"
                            @onclick="OnLoanClicked"
                            class="w-full sm:w-auto px-3 py-1.5 rounded-lg text-xs font-semibold bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border-subtle)] transition-all flex items-center justify-center gap-1.5 shadow-sm">
                        <Icon Name="handshake" Size="12" />
                        <span>Prestar juego</span>
                    </button>
                }
            }
        </div>
    </div>

    @* Aviso de sesión: las acciones con identidad exigen acceso y redirigen al inicio de sesión *@
    @if (!IsSessionActive)
    {
        <p class="p-3 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-secondary)] flex flex-wrap items-center gap-1.5"
           role="status">
            <Icon Name="user" Size="12" />
            <span>Estas acciones guardan tu identidad: para llevarlas a cabo</span>
            <a href="@ExternalAuthenticationSchemes.LoginPath" class="font-bold text-[var(--brand-primary)] underline">
                Inicia sesión
            </a>
        </p>
    }

    @* Barra de 3 acciones ergonómicas *@
    <div class="grid grid-cols-3 gap-1.5 sm:gap-2" role="group" aria-label="Estados de colección">
        @* 1. En mi ludoteca / Tengo *@
        <button type="button"
                @onclick="() => HandleStatusClick(CollectionStatus.InCollection)"
                class="px-2 sm:px-3 py-2.5 rounded-lg text-xs font-semibold transition-all flex items-center justify-center gap-1.5 sm:gap-2 @GetStatusButtonStyle(CollectionStatus.InCollection)">
            <Icon Name="library" Size="14" />
            <span class="hidden sm:inline">En mi ludoteca</span>
            <span class="sm:hidden">Tengo</span>
        </button>

        @* 2. Jugado (Independiente y Coexistente) *@
        <button type="button"
                @onclick="HandlePlayedClick"
                class="px-2 sm:px-3 py-2.5 rounded-lg text-xs font-semibold transition-all flex items-center justify-center gap-1.5 sm:gap-2 @GetPlayedButtonStyle()">
            <Icon Name="dices" Size="12" />
            <span>Jugado</span>
            @if (CurrentItem?.IsPlayed == true)
            {
                <span class="text-[0.65rem] opacity-80">✓</span>
            }
        </button>

        @* 3. Quiero comprar *@
        <button type="button"
                @onclick="() => HandleStatusClick(CollectionStatus.WantToBuy)"
                class="px-2 sm:px-3 py-2.5 rounded-lg text-xs font-semibold transition-all flex items-center justify-center gap-1.5 sm:gap-2 @GetStatusButtonStyle(CollectionStatus.WantToBuy)">
            <Icon Name="shopping-cart" Size="14" />
            <span>Comprar</span>
        </button>
    </div>

    @* Píldora de Radar de Compra *@
    @if (CurrentItem?.Status == CollectionStatus.WantToBuy)
    {
        <div class="p-3 rounded-xl bg-sky-500/10 border border-sky-500/25 flex items-center gap-2.5 text-xs text-sky-700 dark:text-sky-300">
            <span class="shrink-0"><Icon Name="bell" Size="16" /></span>
            <div class="leading-tight">
                <strong class="font-bold">Radar de compra activo:</strong>
                <span> Te avisaremos en cuanto detectemos sorteos, descuentos o reimpresiones de este juego en tiendas.</span>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public UserCollectionItemDto? CurrentItem { get; set; }

    [Parameter]
    public GameLoanDto? ActiveLoan { get; set; }

    [Parameter]
    public int PlayCount { get; set; } = 0;

    /// <summary>
    /// Indica si hay sesión iniciada. Sin sesión se muestra el aviso de acceso y cada acción con
    /// identidad lleva al inicio de sesión en lugar de escribir.
    /// </summary>
    [Parameter]
    public bool IsSessionActive { get; set; } = true;

    [Parameter]
    public EventCallback<CollectionStatus> OnStatusSelected { get; set; }

    [Parameter]
    public EventCallback OnTogglePlayed { get; set; }

    [Parameter]
    public EventCallback OnRecordPlayClicked { get; set; }

    [Parameter]
    public EventCallback OnLoanClicked { get; set; }

    private async Task HandleStatusClick(CollectionStatus status)
    {
        await OnStatusSelected.InvokeAsync(status);
    }

    private async Task HandlePlayedClick()
    {
        await OnTogglePlayed.InvokeAsync();
    }

    private string GetStatusButtonStyle(CollectionStatus status)
    {
        bool isSelected = CurrentItem?.Status == status;

        if (!isSelected)
        {
            return "bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border-subtle)] hover:border-[var(--border-highlight)]";
        }

        return "bg-[var(--brand-glow)] text-[var(--text-primary)] border-2 border-[var(--brand-primary)] font-bold shadow-sm";
    }

    private string GetPlayedButtonStyle()
    {
        bool isPlayed = CurrentItem?.IsPlayed == true;

        if (!isPlayed)
        {
            return "bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border-subtle)] hover:border-[var(--border-highlight)]";
        }

        return "bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 border-2 border-emerald-500 font-bold shadow-sm";
    }

    private static string GetStatusName(CollectionStatus? status, bool isPlayed)
    {
        var parts = new List<string>();

        if (status == CollectionStatus.InCollection)
        {
            parts.Add("En mi ludoteca");
        }
        else if (status == CollectionStatus.WantToBuy)
        {
            parts.Add("En seguimiento para comprar");
        }

        if (isPlayed)
        {
            parts.Add("Jugado");
        }

        return parts.Count > 0 ? string.Join(" · ", parts) : "Sin estado";
    }
}
