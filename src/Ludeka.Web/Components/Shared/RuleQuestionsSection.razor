@using Ludeka.Application.Contracts
@using Ludeka.Application.DTOs
@inject IRuleQAService RuleQAService
@inject ICurrentUserService CurrentUserService
@inject NavigationManager Navigation

<div class="p-6 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-6">
    @* Encabezado de la Sección *@
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[var(--border-subtle)] pb-4">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <span class="text-xs uppercase font-extrabold tracking-wider text-[var(--brand-primary)]">Consultorio de Mesa</span>
                <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] font-bold border border-[var(--border-subtle)]">
                    @_questions.Count @(_questions.Count == 1 ? "duda" : "dudas")
                </span>
            </div>
            <h2 class="text-lg sm:text-xl font-black text-[var(--text-primary)]">
                Dudas de Reglas en Partida (Q&A)
            </h2>
            <p class="text-xs text-[var(--text-secondary)] mt-0.5">
                Respuestas comunitarias verificadas y citando el reglamento para resolver atascos en mesa en menos de 1 minuto.
            </p>
        </div>

        <div>
            <button type="button"
                    @onclick="() => _isAskingQuestion = !_isAskingQuestion"
                    class="px-3.5 py-2 rounded-xl bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-white font-bold text-xs transition-colors flex items-center gap-1.5 shadow-sm">
                <span>@(_isAskingQuestion ? "Cerrar Formulario" : "")</span>
                @if (!_isAskingQuestion)
                {
                    <Icon Name="plus" Size="12" />
                    <span>Preguntar una Duda</span>
                }
            </button>
        </div>
    </div>

    @* Formulario para Nueva Pregunta *@
    @if (_isAskingQuestion)
    {
        <div class="p-4 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-highlight)] space-y-3 animate-fade-in">
            <h3 class="text-xs font-black uppercase text-[var(--brand-primary)] tracking-wider">
                Nueva Duda de Reglamento sobre @GameTitle
            </h3>

            <div>
                <label for="new-q-title" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1">Resumen de la duda en 1 frase *</label>
                <input id="new-q-title"
                       type="text"
                       @bind="_newQuestionTitle"
                       placeholder="Ej. ¿Puedo consumir carbón de una mina enemiga si no está conectada?"
                       class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] text-[var(--text-primary)] text-xs placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
            </div>

            <div>
                <label for="new-q-body" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1">Contexto o detalle de la situación en mesa *</label>
                <textarea id="new-q-body"
                          rows="3"
                          @bind="_newQuestionBody"
                          placeholder="Explica qué fase del turno era, cuántos jugadores estabais y qué cartas o losetas estaban en juego..."
                          class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] text-[var(--text-primary)] text-xs placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)] resize-none">
                </textarea>
            </div>

            @if (!string.IsNullOrWhiteSpace(_questionError))
            {
                <p class="text-xs text-rose-500">@_questionError</p>
            }

            <div class="flex items-center justify-end gap-2 pt-1">
                <button type="button"
                        @onclick="() => _isAskingQuestion = false"
                        class="px-3 py-1.5 rounded-lg border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] text-xs font-bold transition-colors">
                    Cancelar
                </button>
                <button type="button"
                        @onclick="HandleSubmitQuestion"
                        class="px-3 py-1.5 rounded-lg bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-white text-xs font-bold transition-colors shadow-sm">
                    Publicar Duda
                </button>
            </div>
        </div>
    }

    @* Listado de Preguntas *@
    @if (_isLoading)
    {
        <div class="py-8 text-center text-[var(--text-secondary)]">
            <div class="inline-block animate-spin mb-1"><Icon Name="dices" Size="24" /></div>
            <p class="text-xs font-semibold">Cargando consultorio de reglas...</p>
        </div>
    }
    else if (_questions.Count == 0)
    {
        <div class="p-8 text-center rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)]">
            <span class="inline-block mb-2"><Icon Name="book-open" Size="30" /></span>
            <p class="text-sm font-bold text-[var(--text-primary)]">No hay dudas registradas aún para este juego</p>
            <p class="text-xs text-[var(--text-secondary)] mt-1 max-w-sm mx-auto">
                ¿Os ha surgido alguna duda jugando? Sé el primero en plantearla para que la comunidad aporte la solución oficial.
            </p>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var question in _questions)
            {
                <div class="p-4 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] space-y-3">
                    @* Cabecera de la Duda con Votos *@
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex-1">
                            <h3 class="text-sm font-bold text-[var(--text-primary)]">
                                @question.Title
                            </h3>
                            <p class="text-xs text-[var(--text-secondary)] mt-1 leading-relaxed">
                                @question.Body
                            </p>
                            <div class="flex items-center gap-2 text-[0.68rem] text-[var(--text-muted)] mt-2">
                                <span>Por <strong class="text-[var(--text-secondary)]">@question.UserName</strong></span>
                                <span>&bull;</span>
                                <span>@question.CreatedAt.ToString("dd/MM/yyyy")</span>
                                <span>&bull;</span>
                                <span class="text-[var(--brand-primary)] font-semibold">@question.Answers.Count @(question.Answers.Count == 1 ? "respuesta" : "respuestas")</span>
                            </div>
                        </div>

                        @* Botón de Votar Duda *@
                        <button type="button"
                                @onclick="() => HandleVoteQuestion(question.Id)"
                                title="Votar esta duda como útil"
                                aria-label="@($"Votar esta duda como útil (actualmente {question.VotesCount} votos)")"
                                class="px-2.5 py-1.5 rounded-xl border text-xs font-extrabold flex flex-col items-center gap-0.5 transition-all @(question.HasUserVoted ? "bg-[var(--brand-primary)] border-[var(--brand-primary)] text-white shadow-sm" : "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                            <span>▲</span>
                            <span>@question.VotesCount</span>
                        </button>
                    </div>

                    @* Respuestas *@
                    @if (question.Answers.Count > 0)
                    {
                        <div class="pl-3 sm:pl-4 border-l-2 border-[var(--border-subtle)] space-y-2.5 pt-2">
                            @foreach (var answer in question.Answers)
                            {
                                <div class="p-3 rounded-xl transition-all @(answer.IsAccepted ? "bg-[var(--bg-card)] border border-[var(--color-mustplay)]" : "bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)]")">
                                    <div class="flex items-start justify-between gap-2">
                                        <div class="flex-1 space-y-1">
                                            @if (answer.IsAccepted)
                                            {
                                                <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-[var(--bg-card)] text-[var(--color-mustplay)] border border-[var(--border-subtle)] text-[0.65rem] font-black uppercase mb-1">
                                                    <span>✓</span> Solución Aceptada
                                                </div>
                                            }

                                            <p class="text-xs text-[var(--text-primary)] leading-relaxed">
                                                @answer.Body
                                            </p>

                                            @if (!string.IsNullOrWhiteSpace(answer.OfficialRuleReference))
                                            {
                                                <p class="text-[0.68rem] text-[var(--text-secondary)] italic">
                                                    <span class="inline-flex items-center gap-1.5"><Icon Name="book-open" Size="12" /> Referencia: <span class="text-[var(--text-primary)] font-semibold">@answer.OfficialRuleReference</span></span>
                                                </p>
                                            }

                                            <div class="flex items-center gap-2 text-[0.65rem] text-[var(--text-muted)] pt-1">
                                                <span>Respondido por <strong class="text-[var(--text-secondary)]">@answer.UserName</strong></span>
                                                <span>&bull;</span>
                                                <span>@answer.CreatedAt.ToString("dd/MM/yyyy")</span>
                                            </div>
                                        </div>

                                        @* Voto de Respuesta y Botón Aceptar *@
                                        <div class="flex flex-col items-end gap-1.5">
                                            <button type="button"
                                                    @onclick="() => HandleVoteAnswer(answer.Id)"
                                                    aria-label="@($"Votar esta respuesta como útil (actualmente {answer.VotesCount} votos)")"
                                                    class="px-2 py-1 rounded-lg border text-[0.68rem] font-bold flex items-center gap-1 transition-all @(answer.HasUserVoted ? "bg-[var(--brand-primary)] border-[var(--brand-primary)] text-white shadow-sm" : "bg-[var(--bg-card)] border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                                                <span>▲</span>
                                                <span>@answer.VotesCount</span>
                                            </button>

                                            @* Autor o Moderador puede marcar/desmarcar como aceptada *@
                                            @if (CanManageAcceptedAnswer(question))
                                            {
                                                @if (answer.IsAccepted)
                                                {
                                                    <button type="button"
                                                            @onclick="() => HandleUnmarkAccepted(question.Id)"
                                                            class="text-[0.65rem] text-[var(--text-muted)] hover:text-rose-500 underline">
                                                        Desmarcar
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button"
                                                            @onclick="() => HandleMarkAccepted(question.Id, answer.Id)"
                                                            class="text-[0.65rem] text-[var(--color-mustplay)] hover:underline font-bold">
                                                        ✓ Aceptar solución
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @* Botón / Formulario para Responder *@
                    @if (_activeAnsweringQuestionId == question.Id)
                    {
                        <div class="p-3 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] space-y-2 text-xs">
                            <label for="@($"answer-body-{question.Id}")" class="font-bold text-[var(--text-secondary)] block">Tu respuesta o aclaración de regla *</label>
                            <textarea id="@($"answer-body-{question.Id}")"
                                      rows="2"
                                      @bind="_answerBody"
                                      placeholder="Aporta la respuesta explicando cómo resolverlo según las reglas oficiales..."
                                      class="w-full px-3 py-2 rounded-lg bg-[var(--bg-surface)] border border-[var(--border-subtle)] text-[var(--text-primary)] text-xs placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)] resize-none">
                            </textarea>

                            <div>
                                <label for="@($"answer-ref-{question.Id}")" class="font-semibold text-[var(--text-secondary)] block mb-0.5 text-[0.68rem]">Página o sección del manual (opcional)</label>
                                <input id="@($"answer-ref-{question.Id}")"
                                       type="text"
                                       @bind="_answerRuleRef"
                                       placeholder="Ej. Página 12, sección 3.4"
                                       class="w-full px-2.5 py-1.5 rounded-lg bg-[var(--bg-surface)] border border-[var(--border-subtle)] text-[var(--text-primary)] text-xs placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
                            </div>

                            @if (!string.IsNullOrWhiteSpace(_answerError))
                            {
                                <p class="text-xs text-rose-500">@_answerError</p>
                            }

                            <div class="flex items-center justify-end gap-2 pt-1">
                                <button type="button"
                                        @onclick="() => _activeAnsweringQuestionId = null"
                                        class="px-2.5 py-1 rounded-lg border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] font-bold text-[0.68rem]">
                                    Cancelar
                                </button>
                                <button type="button"
                                        @onclick="() => HandleSubmitAnswer(question.Id)"
                                        class="px-3 py-1 rounded-lg bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-white font-bold text-[0.68rem] shadow-sm">
                                    Enviar Respuesta
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="pt-1">
                            <button type="button"
                                    @onclick="() => OpenAnswerForm(question.Id)"
                                    class="text-xs font-bold text-[var(--brand-primary)] hover:opacity-80 flex items-center gap-1">
                                <Icon Name="message-circle" Size="12" /> Responder a esta duda
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public Guid GameId { get; set; }

    [Parameter, EditorRequired]
    public string GameTitle { get; set; } = string.Empty;

    private IReadOnlyList<RuleQuestionDto> _questions = new List<RuleQuestionDto>();
    private bool _isLoading = true;

    private bool _isAskingQuestion;
    private string _newQuestionTitle = string.Empty;
    private string _newQuestionBody = string.Empty;
    private string? _questionError;

    private Guid? _activeAnsweringQuestionId;
    private string _answerBody = string.Empty;
    private string? _answerRuleRef;
    private string? _answerError;

    protected override async Task OnParametersSetAsync()
    {
        await LoadQuestionsAsync();
    }

    private async Task LoadQuestionsAsync()
    {
        _isLoading = true;
        try
        {
            _questions = await RuleQAService.GetQuestionsByGameIdAsync(GameId, CurrentUserService.UserId);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private bool CanManageAcceptedAnswer(RuleQuestionDto q)
    {
        return CurrentUserService.IsFoundingTeam ||
               CurrentUserService.IsInRole("Moderator") ||
               string.Equals(q.UserId, CurrentUserService.UserId, StringComparison.OrdinalIgnoreCase);
    }

    private async Task HandleSubmitQuestion()
    {
        _questionError = null;

        if (string.IsNullOrWhiteSpace(_newQuestionTitle))
        {
            _questionError = "Debes indicar un título conciso para la duda.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_newQuestionBody))
        {
            _questionError = "Debes describir la situación de mesa.";
            return;
        }

        var request = new CreateRuleQuestionRequest(GameId, _newQuestionTitle, _newQuestionBody);

        try
        {
            await RuleQAService.CreateQuestionAsync(request, CurrentUserService.UserId, CurrentUserService.UserName);
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
            return;
        }

        _isAskingQuestion = false;
        _newQuestionTitle = string.Empty;
        _newQuestionBody = string.Empty;

        await LoadQuestionsAsync();
    }

    private void OpenAnswerForm(Guid questionId)
    {
        _activeAnsweringQuestionId = questionId;
        _answerBody = string.Empty;
        _answerRuleRef = null;
        _answerError = null;
    }

    private async Task HandleSubmitAnswer(Guid questionId)
    {
        _answerError = null;

        if (string.IsNullOrWhiteSpace(_answerBody))
        {
            _answerError = "La respuesta no puede estar vacía.";
            return;
        }

        var request = new CreateRuleAnswerRequest(questionId, _answerBody, _answerRuleRef);

        try
        {
            await RuleQAService.AddAnswerAsync(request, CurrentUserService.UserId, CurrentUserService.UserName);
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
            return;
        }

        _activeAnsweringQuestionId = null;
        _answerBody = string.Empty;
        _answerRuleRef = null;

        await LoadQuestionsAsync();
    }

    private async Task HandleVoteQuestion(Guid questionId)
    {
        try
        {
            await RuleQAService.ToggleVoteQuestionAsync(questionId, CurrentUserService.UserId);
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
            return;
        }

        await LoadQuestionsAsync();
    }

    private async Task HandleVoteAnswer(Guid answerId)
    {
        try
        {
            await RuleQAService.ToggleVoteAnswerAsync(answerId, CurrentUserService.UserId);
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
            return;
        }

        await LoadQuestionsAsync();
    }

    private async Task HandleMarkAccepted(Guid questionId, Guid answerId)
    {
        try
        {
            await RuleQAService.MarkAcceptedAnswerAsync(
                questionId,
                answerId,
                CurrentUserService.UserId,
                CurrentUserService.IsFoundingTeam || CurrentUserService.IsInRole("Moderator"));
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
            return;
        }

        await LoadQuestionsAsync();
    }

    private async Task HandleUnmarkAccepted(Guid questionId)
    {
        try
        {
            await RuleQAService.UnmarkAcceptedAnswerAsync(
                questionId,
                CurrentUserService.UserId,
                CurrentUserService.IsFoundingTeam || CurrentUserService.IsInRole("Moderator"));
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
            return;
        }

        await LoadQuestionsAsync();
    }
}
