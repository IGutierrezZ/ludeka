@using System
@using Ludeka.Application.Contracts
@using Ludeka.Core.Enums
@using Ludeka.Web.Services
@inject IUserLikeService UserLikeService
@inject ICurrentUserService CurrentUserService
@inject NavigationManager Navigation

<button type="button"
        @onclick="HandleClickAsync"
        @onclick:stopPropagation="true"
        disabled="@_isLoading"
        aria-label="@AriaLabel"
        aria-pressed="@_isLiked.ToString().ToLowerInvariant()"
        title="@TitleText"
        class="@GetButtonClasses()">
    <svg width="@(Compact ? 13 : 15)"
         height="@(Compact ? 13 : 15)"
         viewBox="0 0 24 24"
         fill="@(_isLiked ? "currentColor" : "none")"
         stroke="currentColor"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round"
         class="shrink-0 transition-transform duration-150 @(_isLiked ? "scale-110" : "group-hover/like:scale-110")"
         aria-hidden="true"
         focusable="false">
        <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
    </svg>
    <span class="tabular-nums font-bold leading-none select-none">@_likesCount</span>
</button>

@code {
    [Parameter, EditorRequired]
    public LikeTargetType TargetType { get; set; }

    [Parameter, EditorRequired]
    public Guid TargetId { get; set; }

    [Parameter]
    public int InitialLikesCount { get; set; }

    [Parameter]
    public bool? InitialIsLiked { get; set; }

    [Parameter]
    public bool Compact { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public EventCallback<int> OnLikesCountChanged { get; set; }

    private int _likesCount;
    private bool _isLiked;
    private bool _isLoading;
    private bool _statusLoaded;

    protected override void OnParametersSet()
    {
        if (!_statusLoaded)
        {
            _likesCount = InitialLikesCount;
            if (InitialIsLiked.HasValue)
            {
                _isLiked = InitialIsLiked.Value;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _likesCount = InitialLikesCount;
        if (InitialIsLiked.HasValue)
        {
            _isLiked = InitialIsLiked.Value;
            _statusLoaded = true;
            return;
        }

        if (Guid.TryParse(CurrentUserService?.UserId, out var uid) && TargetId != Guid.Empty)
        {
            try
            {
                var status = await UserLikeService.GetStatusAsync(uid, TargetType, TargetId);
                _isLiked = status.IsLiked;
                _likesCount = status.LikesCount;
                _statusLoaded = true;
            }
            catch
            {
                // Degradar elegantemente a los valores iniciales ante errores de red/estado
            }
        }
    }

    private async Task HandleClickAsync()
    {
        if (_isLoading) return;

        // Si el usuario no ha iniciado sesión, redirigir al login preservando ReturnUrl
        if (string.IsNullOrWhiteSpace(CurrentUserService?.UserId) || !Guid.TryParse(CurrentUserService.UserId, out var uid))
        {
            Navigation.ToLogin();
            return;
        }

        _isLoading = true;
        try
        {
            var result = await UserLikeService.ToggleLikeAsync(uid, TargetType, TargetId);
            _isLiked = result.IsLiked;
            _likesCount = result.LikesCount;
            _statusLoaded = true;
            await OnLikesCountChanged.InvokeAsync(_likesCount);
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.ToLogin();
        }
        catch (Exception)
        {
            // Revertir estado si procede
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string AriaLabel => _isLiked
        ? $"Ya no me gusta ({_likesCount} {(_likesCount == 1 ? "me gusta" : "me gusta")})"
        : $"Me gusta ({_likesCount} {(_likesCount == 1 ? "me gusta" : "me gusta")})";

    private string TitleText => _isLiked ? "Ya no me gusta" : "Me gusta";

    private string GetButtonClasses()
    {
        var sizeClasses = Compact
            ? "px-2 py-1 text-[0.68rem] gap-1 rounded-lg"
            : "px-2.5 py-1.5 text-xs gap-1.5 rounded-xl";

        var stateClasses = _isLiked
            ? "bg-rose-500/10 text-rose-600 dark:text-rose-400 border-rose-500/30 hover:bg-rose-500/20"
            : "bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] hover:text-rose-600 hover:bg-rose-500/10 border-[var(--border-subtle)]";

        return $"group/like inline-flex items-center justify-center font-bold border transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-500 focus-visible:ring-offset-2 disabled:opacity-60 {sizeClasses} {stateClasses} {Class}".Trim();
    }
}
