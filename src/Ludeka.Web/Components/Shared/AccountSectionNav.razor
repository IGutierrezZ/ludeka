@*
    Cabecera de sección compartida del área de cuenta (INC-50, diseño §D3.1/§D4.2).
    Componente presentacional: el padre le pasa la sección activa; no conoce servicios
    ni NavigationManager. El marcado `aria-current="page"` sigue el patrón de
    HeroEditorial.razor y comunica la sección actual al árbol de accesibilidad.
*@

<nav aria-label="Secciones del área de cuenta"
     class="flex flex-wrap items-center gap-2 border-b border-[var(--border-subtle)] pb-4 mb-6">
    <a href="/cuenta"
       class="px-3 py-1.5 rounded-full text-xs font-bold text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] transition-colors flex items-center gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] focus-visible:ring-offset-2">
        <Icon Name="arrow-left" Size="14" />
        <span>Cuenta</span>
    </a>

    <a href="/cuenta/ludoteca"
       aria-current="@(Active == "ludoteca" ? "page" : null)"
       class="px-3 py-1.5 rounded-full text-xs font-bold transition-colors flex items-center gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] focus-visible:ring-offset-2 @(Active == "ludoteca" ? "bg-[var(--brand-primary)] text-white" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)]")">
        <Icon Name="library" Size="14" />
        <span>Ludoteca</span>
    </a>

    <a href="/cuenta/apariencia"
       aria-current="@(Active == "apariencia" ? "page" : null)"
       class="px-3 py-1.5 rounded-full text-xs font-bold transition-colors flex items-center gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] focus-visible:ring-offset-2 @(Active == "apariencia" ? "bg-[var(--brand-primary)] text-white" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)]")">
        <Icon Name="palette" Size="14" />
        <span>Apariencia</span>
    </a>

    <a href="/cuenta/pais"
       aria-current="@(Active == "pais" ? "page" : null)"
       class="px-3 py-1.5 rounded-full text-xs font-bold transition-colors flex items-center gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] focus-visible:ring-offset-2 @(Active == "pais" ? "bg-[var(--brand-primary)] text-white" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)]")">
        <Icon Name="globe" Size="14" />
        <span>País</span>
    </a>

    <a href="/cuenta/privacidad"
       aria-current="@(Active == "privacidad" ? "page" : null)"
       class="px-3 py-1.5 rounded-full text-xs font-bold transition-colors flex items-center gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] focus-visible:ring-offset-2 @(Active == "privacidad" ? "bg-[var(--brand-primary)] text-white" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)]")">
        <Icon Name="shield" Size="14" />
        <span>Privacidad</span>
    </a>

    <a href="/cuenta/conexiones"
       aria-current="@(Active == "conexiones" ? "page" : null)"
       class="px-3 py-1.5 rounded-full text-xs font-bold transition-colors flex items-center gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] focus-visible:ring-offset-2 @(Active == "conexiones" ? "bg-[var(--brand-primary)] text-white" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)]")">
        <Icon Name="link" Size="14" />
        <span>Conexiones</span>
    </a>
</nav>

@code {
    /// <summary>
    /// Sección activa: "ludoteca" | "apariencia" | "pais" | "privacidad" | "conexiones". Cadena de conjunto cerrado, no texto libre;
    /// el componente solo la compara, nunca la pinta como contenido.
    /// </summary>
    [Parameter] public string Active { get; set; } = string.Empty;
}
