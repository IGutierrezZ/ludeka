@using Ludeka.Application.DTOs
@using Ludeka.Core.Enums

@if (Game != null)
{
    var colorVar = GetCyclicColor(PositionNumber ?? 1);
    var placeholderUrl = Game.IsExpansion ? "/images/expansion-placeholder.svg" : "/images/game-placeholder.svg";
    var effectiveImageUrl = !string.IsNullOrWhiteSpace(Game.ThumbnailUrl)
        ? Game.ThumbnailUrl
        : (!string.IsNullOrWhiteSpace(Game.CoverImageUrl) ? Game.CoverImageUrl : null);
    var displayTitle = Game.GetTitleForCountry(CountryCode);
    var compactPlayers = FormatCompactPlayers(Game.IdealPlayerCountText);

    <a href="/juegos/@Game.Slug"
       class="group flex flex-col gap-3 transition-transform hover:-translate-y-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand)] rounded-md"
       aria-label="Ver ficha de @Game.SpanishTitle">
        
        @* Carátula cuadrada 1:1 con sombra profunda y numeral ciclálico *@
        <div class="relative aspect-square w-full rounded overflow-hidden bg-[var(--paper-2)] shadow-[0_12px_24px_var(--shadow)]">
            @if (PositionNumber.HasValue)
            {
                <span class="absolute -top-3.5 -left-1.5 z-20 text-3xl sm:text-[42px] font-black tracking-[-0.06em] select-none pointer-events-none leading-none"
                      style="color: @colorVar; text-shadow: 0 2px 0 var(--paper, #FFF8EE);">
                    @PositionNumber.Value
                </span>
            }

            @if (!string.IsNullOrWhiteSpace(effectiveImageUrl))
            {
                <img src="@effectiveImageUrl"
                     alt="Carátula oficial de @Game.SpanishTitle"
                     loading="lazy"
                     decoding="async"
                     width="240"
                     height="240"
                     onerror="this.onerror=null; this.src='@placeholderUrl';"
                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            }
            else
            {
                <img src="@placeholderUrl"
                     alt="Carátula de @Game.SpanishTitle no disponible"
                     loading="lazy"
                     decoding="async"
                     width="240"
                     height="240"
                     class="w-full h-full object-cover opacity-80" />
            }

            @* Badge de Expansión *@
            @if (Game.IsExpansion)
            {
                <div class="absolute top-2 right-2 z-10 px-2 py-0.5 rounded-full bg-purple-950/85 backdrop-blur-sm border border-purple-500/40 text-[10px] font-black text-purple-200 flex items-center gap-1">
                    <Icon Name="puzzle" Size="11" />
                    <span>Expansión</span>
                </div>
            }

            @* Botón de acción rápida: Colección / Jugado *@
            <button type="button"
                    @onclick="HandleQuickActionClick"
                    @onclick:stopPropagation="true"
                    @onclick:preventDefault="true"
                    title="Añadir a mi ludoteca / jugado"
                    aria-label="Añadir @Game.SpanishTitle a tu colección o jugado"
                    class="absolute bottom-2 right-2 z-10 w-8 h-8 rounded-full bg-black/60 hover:bg-[var(--brand)] text-[#FFF8EE] backdrop-blur-md border border-white/20 shadow-md flex items-center justify-center transition-all opacity-80 group-hover:opacity-100 hover:scale-110 active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white">
                <Icon Name="plus" Size="15" />
            </button>
        </div>

        @* Detalle editorial con regla superior de 2px *@
        <div class="flex flex-col gap-1 pt-2 border-t-2 border-[var(--rule)]">
            <h3 class="text-base sm:text-[17px] font-black text-[var(--ink)] tracking-[-0.02em] leading-snug line-clamp-1 group-hover:text-[var(--accent)] transition-colors m-0">
                @displayTitle
            </h3>

            <div class="text-xs text-[var(--muted)] truncate">
                @Game.Designer · @Game.YearPublished
            </div>

            <div class="flex items-center gap-2.5 flex-wrap text-xs font-black mt-1">
                <span class="text-[var(--ink)]">★ @Game.BggRating.ToString("0.0")</span>
                
                @if (!string.IsNullOrWhiteSpace(compactPlayers))
                {
                    <span class="text-[var(--accent-green)]">· @compactPlayers</span>
                }

                @if (Game.EstimatedPerPlayerMinutes > 0)
                {
                    <span class="text-[var(--muted)]">· @(Game.EstimatedPerPlayerMinutes)'</span>
                }

                @* Huella en mesa sutil para cumplir contrato de accesibilidad *@
                @switch (Game.Footprint)
                {
                    case TableFootprint.SmallTable:
                        <span class="inline-flex items-center gap-0.5 text-[var(--muted)]" title="Mesa pequeña / cafetería" aria-label="Mesa pequeña">
                            <Icon Name="armchair" Size="11" />
                        </span>
                        break;
                    case TableFootprint.TableMonster:
                        <span class="inline-flex items-center gap-0.5 text-[var(--muted)]" title="Mesa grande / despliegue masivo" aria-label="Mesa grande">
                            <Icon Name="castle" Size="11" />
                        </span>
                        break;
                    default:
                        <span class="inline-flex items-center gap-0.5 text-[var(--muted)]" title="Mesa estándar de comedor" aria-label="Mesa estándar">
                            <Icon Name="utensils" Size="11" />
                        </span>
                        break;
                }
            </div>
        </div>
    </a>
}

@code {
    [Parameter, EditorRequired]
    public GameSummaryDto Game { get; set; } = null!;

    [Parameter]
    public string? CountryCode { get; set; }

    [Parameter]
    public int? PositionNumber { get; set; }

    [Parameter]
    public EventCallback<GameSummaryDto> OnQuickAction { get; set; }

    private async Task HandleQuickActionClick()
    {
        await OnQuickAction.InvokeAsync(Game);
    }

    private static string GetCyclicColor(int position) => ((position - 1) % 5) switch
    {
        0 => "var(--accent)",
        1 => "var(--mustard)",
        2 => "var(--accent-green)",
        3 => "var(--sky)",
        _ => "var(--pink)"
    };

    private static string FormatCompactPlayers(string? idealText)
    {
        if (string.IsNullOrWhiteSpace(idealText) || idealText.Contains("Sin datos", StringComparison.OrdinalIgnoreCase))
            return string.Empty;

        return idealText
            .Replace("Ideal:", "", StringComparison.OrdinalIgnoreCase)
            .Trim();
    }
}
