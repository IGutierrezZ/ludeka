@using Ludeka.Application.DTOs
@using Ludeka.Core.Enums

@if (Game != null)
{
    <a href="/juegos/@Game.Slug" class="game-card-editorial group" aria-label="Ver ficha de @Game.SpanishTitle">
        <div class="cover-wrapper">
            @{
                var placeholderUrl = Game.IsExpansion ? "/images/expansion-placeholder.svg" : "/images/game-placeholder.svg";
                var effectiveImageUrl = !string.IsNullOrWhiteSpace(Game.ThumbnailUrl)
                    ? Game.ThumbnailUrl
                    : (!string.IsNullOrWhiteSpace(Game.CoverImageUrl) ? Game.CoverImageUrl : null);
            }
            @if (!string.IsNullOrWhiteSpace(effectiveImageUrl))
            {
                <img src="@effectiveImageUrl"
                     alt="Carátula oficial de @Game.SpanishTitle"
                     loading="lazy"
                     decoding="async"
                     width="240"
                     height="240"
                     onerror="this.onerror=null; this.src='@placeholderUrl';"
                     class="w-full h-full object-cover" />
            }
            else
            {
                <img src="@placeholderUrl"
                     alt="Carátula de @Game.SpanishTitle no disponible"
                     loading="lazy"
                     decoding="async"
                     width="240"
                     height="240"
                     class="w-full h-full object-cover opacity-90" />
            }

            @* Badge de Expansión *@
            @if (Game.IsExpansion)
            {
                <div class="absolute top-2 left-2 z-10 px-2 py-0.5 rounded-md bg-purple-950/85 backdrop-blur-sm border border-purple-500/40 text-[0.68rem] font-black text-purple-200 shadow-md flex items-center gap-1">
                    <Icon Name="puzzle" Size="12" />
                    <span>Expansión</span>
                </div>
            }

            @* Rating flotante *@
            <div class="rating-badge-float">
                <span>★</span>
                <span>@Game.BggRating.ToString("0.0")</span>
            </div>
        </div>

        <div class="p-2 sm:p-3.5 flex flex-col flex-1 justify-between bg-[var(--bg-card)]">
            <div>
                <div class="flex items-center justify-between gap-1 mb-1 sm:mb-1.5">
                    <span class="text-[0.65rem] sm:text-xs font-bold text-[var(--brand-primary)] shrink-0">@Game.YearPublished</span>
                    @if (!string.IsNullOrWhiteSpace(Game.IdealPlayerCountText))
                    {
                        <span class="text-[0.58rem] sm:text-[0.68rem] font-bold px-1 sm:px-2 py-0.5 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--color-mustplay)] border border-[var(--border-subtle)] truncate max-w-[5rem] sm:max-w-none">
                            @Game.IdealPlayerCountText
                        </span>
                    }
                </div>

                <h3 class="font-extrabold text-xs sm:text-base text-[var(--text-primary)] group-hover:text-[var(--brand-primary)] transition-colors line-clamp-2 leading-tight sm:line-clamp-1 mb-1">
                    @Game.SpanishTitle
                </h3>

                @if (!string.Equals(Game.SpanishTitle, Game.OriginalTitle, StringComparison.OrdinalIgnoreCase))
                {
                    <p class="text-[0.65rem] sm:text-xs text-[var(--text-muted)] italic line-clamp-1 mb-1 sm:mb-1.5 hidden sm:block">(@Game.OriginalTitle)</p>
                }
                else
                {
                    <div class="mb-1 hidden sm:block"></div>
                }

                <div class="text-[0.62rem] sm:text-[0.72rem] text-[var(--text-secondary)] line-clamp-1 mb-1 sm:mb-3">
                    @Game.Designer
                </div>
            </div>

            <div class="hidden sm:flex items-center gap-1.5 flex-wrap pt-2.5 border-t border-[var(--border-subtle)] text-[0.7rem] text-[var(--text-muted)]">
                @switch (Game.Style)
                {
                    case GameStyle.Eurogame:
                        <span class="px-2 py-0.5 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border border-[var(--border-subtle)]"><Icon Name="settings" Size="12" /> Euro</span>
                        break;
                    case GameStyle.Ameritrash:
                        <span class="px-2 py-0.5 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border border-[var(--border-subtle)]"><Icon Name="dices" Size="12" /> Temático</span>
                        break;
                    case GameStyle.PartyGame:
                        <span class="px-2 py-0.5 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border border-[var(--border-subtle)]"><Icon Name="party-popper" Size="12" /> Party</span>
                        break;
                    case GameStyle.FillerAbstract:
                        <span class="px-2 py-0.5 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border border-[var(--border-subtle)]"><Icon Name="puzzle" Size="12" /> Filler</span>
                        break;
                    default:
                        <span class="px-2 py-0.5 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border border-[var(--border-subtle)]"><Icon Name="book-open" Size="12" /> Narrativo</span>
                        break;
                }

                @if (Game.IsOfficialSolo)
                {
                    <span class="px-2 py-0.5 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border border-[var(--border-subtle)]"><Icon Name="user" Size="12" /> Solo</span>
                }

                @if (Game.IsAccessibleEarlier)
                {
                    <span class="px-2 py-0.5 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border border-[var(--border-subtle)]"><Icon Name="baby" Size="12" /> @Game.CommunityAge+</span>
                }

                @switch (Game.Footprint)
                {
                    case TableFootprint.SmallTable:
                        <span class="px-2 py-0.5 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border border-[var(--border-subtle)]" title="Mesa pequeña / cafetería">
                            <Icon Name="armchair" Size="12" /> Mesa pequeña
                        </span>
                        break;
                    case TableFootprint.TableMonster:
                        <span class="px-2 py-0.5 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border border-[var(--border-subtle)]" title="Monstruo de mesa / despliegue masivo">
                            <Icon Name="castle" Size="12" /> Mesa grande
                        </span>
                        break;
                    default:
                        <span class="px-2 py-0.5 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border border-[var(--border-subtle)]" title="Mesa de comedor estándar">
                            <Icon Name="utensils" Size="12" /> Mesa estándar
                        </span>
                        break;
                }
            </div>
        </div>
    </a>
}

@code {
    [Parameter, EditorRequired]
    public GameSummaryDto Game { get; set; } = null!;
}
