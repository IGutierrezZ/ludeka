@using Ludeka.Application.DTOs
@using Ludeka.Core.Enums

@if (Game != null)
{
    <a href="/juegos/@Game.Slug" class="game-card-editorial group" aria-label="Ver ficha de @Game.SpanishTitle">
        <div class="cover-wrapper">
            @{
                var placeholderUrl = Game.IsExpansion ? "/images/expansion-placeholder.svg" : "/images/game-placeholder.svg";
                var effectiveImageUrl = !string.IsNullOrWhiteSpace(Game.ThumbnailUrl)
                    ? Game.ThumbnailUrl
                    : (!string.IsNullOrWhiteSpace(Game.CoverImageUrl) ? Game.CoverImageUrl : null);
            }
            @if (!string.IsNullOrWhiteSpace(effectiveImageUrl))
            {
                <img src="@effectiveImageUrl"
                     alt="Carátula oficial de @Game.SpanishTitle"
                     loading="lazy"
                     decoding="async"
                     width="240"
                     height="240"
                     onerror="this.onerror=null; this.src='@placeholderUrl';"
                     class="w-full h-full object-cover" />
            }
            else
            {
                <img src="@placeholderUrl"
                     alt="Carátula de @Game.SpanishTitle no disponible"
                     loading="lazy"
                     decoding="async"
                     width="240"
                     height="240"
                     class="w-full h-full object-cover opacity-90" />
            }

            @* Badge de Expansión *@
            @if (Game.IsExpansion)
            {
                <div class="absolute top-2 left-2 z-10 px-2 py-0.5 rounded-md bg-purple-950/85 backdrop-blur-sm border border-purple-500/40 text-[0.68rem] font-black text-purple-200 shadow-md flex items-center gap-1">
                    <Icon Name="puzzle" Size="12" />
                    <span>Expansión</span>
                </div>
            }

            @* Rating flotante *@
            <div class="rating-badge-float">
                <span>★</span>
                <span>@Game.BggRating.ToString("0.0")</span>
            </div>

            @* Botón de acción rápida: Colección / Jugado *@
            <button type="button"
                    @onclick="HandleQuickActionClick"
                    @onclick:stopPropagation="true"
                    @onclick:preventDefault="true"
                    title="Añadir a mi ludoteca / jugado"
                    aria-label="Añadir @Game.SpanishTitle a tu colección o jugado"
                    class="absolute bottom-2 right-2 z-10 w-7 h-7 rounded-full bg-black/70 hover:bg-[var(--brand-primary)] text-white backdrop-blur-md border border-white/20 shadow-md flex items-center justify-center transition-all hover:scale-110 active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white">
                <Icon Name="plus" Size="14" />
            </button>
        </div>

        <div class="p-2 sm:p-3.5 flex flex-col flex-1 justify-between bg-[var(--bg-card)]">
            <div>
                <div class="flex items-center justify-between gap-1 mb-1 sm:mb-1.5">
                    <span class="text-[0.65rem] sm:text-xs font-bold text-[var(--brand-primary)] shrink-0">@Game.YearPublished</span>
                    @{
                        var compactPlayers = FormatCompactPlayers(Game.IdealPlayerCountText);
                    }
                    @if (!string.IsNullOrWhiteSpace(compactPlayers))
                    {
                        <span class="text-[var(--color-mustplay)] font-bold text-[0.62rem] sm:text-[0.7rem] truncate flex items-center gap-0.5 shrink-0" title="@Game.IdealPlayerCountText">
                            <Icon Name="users" Size="11" />
                            <span>@compactPlayers</span>
                        </span>
                    }
                </div>

                @{
                    var displayTitle = Game.GetTitleForCountry(CountryCode);
                }
                <h3 class="font-extrabold text-xs sm:text-base text-[var(--text-primary)] group-hover:text-[var(--brand-primary)] transition-colors line-clamp-2 leading-tight sm:line-clamp-1 mb-1">
                    @displayTitle
                </h3>

                @if (!string.Equals(displayTitle, Game.OriginalTitle, StringComparison.OrdinalIgnoreCase))
                {
                    <p class="text-[0.65rem] sm:text-xs text-[var(--text-muted)] italic line-clamp-1 mb-1 sm:mb-1.5 hidden sm:block">(@Game.OriginalTitle)</p>
                }
                else
                {
                    <div class="mb-1 hidden sm:block"></div>
                }

                <div class="text-[0.62rem] sm:text-[0.72rem] text-[var(--text-secondary)] line-clamp-1 mb-1 sm:mb-3">
                    @Game.Designer
                </div>
            </div>

            <div class="flex items-center gap-1.5 flex-wrap pt-2 border-t border-[var(--border-subtle)] text-[var(--text-muted)]">
                @switch (Game.Style)
                {
                    case GameStyle.Eurogame:
                        <span class="w-6 h-6 rounded-lg bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border border-[var(--border-subtle)] inline-flex items-center justify-center hover:text-[var(--brand-primary)] hover:border-[var(--brand-primary)] transition-colors shrink-0" title="Eurogame (gestión y optimización)" aria-label="Eurogame">
                            <Icon Name="settings" Size="12" />
                        </span>
                        break;
                    case GameStyle.Ameritrash:
                        <span class="w-6 h-6 rounded-lg bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border border-[var(--border-subtle)] inline-flex items-center justify-center hover:text-[var(--brand-primary)] hover:border-[var(--brand-primary)] transition-colors shrink-0" title="Temático / Ameritrash (aventura y dados)" aria-label="Temático">
                            <Icon Name="dices" Size="12" />
                        </span>
                        break;
                    case GameStyle.PartyGame:
                        <span class="w-6 h-6 rounded-lg bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border border-[var(--border-subtle)] inline-flex items-center justify-center hover:text-[var(--brand-primary)] hover:border-[var(--brand-primary)] transition-colors shrink-0" title="Party Game (social y risas)" aria-label="Party Game">
                            <Icon Name="party-popper" Size="12" />
                        </span>
                        break;
                    case GameStyle.FillerAbstract:
                        <span class="w-6 h-6 rounded-lg bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border border-[var(--border-subtle)] inline-flex items-center justify-center hover:text-[var(--brand-primary)] hover:border-[var(--brand-primary)] transition-colors shrink-0" title="Filler / Abstracto (rápido o mental)" aria-label="Filler">
                            <Icon Name="puzzle" Size="12" />
                        </span>
                        break;
                    default:
                        <span class="w-6 h-6 rounded-lg bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border border-[var(--border-subtle)] inline-flex items-center justify-center hover:text-[var(--brand-primary)] hover:border-[var(--brand-primary)] transition-colors shrink-0" title="Narrativo / Campaña" aria-label="Narrativo">
                            <Icon Name="book-open" Size="12" />
                        </span>
                        break;
                }

                @switch (Game.Footprint)
                {
                    case TableFootprint.SmallTable:
                        <span class="w-6 h-6 rounded-lg bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border border-[var(--border-subtle)] inline-flex items-center justify-center hover:text-[var(--brand-primary)] hover:border-[var(--brand-primary)] transition-colors shrink-0" title="Mesa pequeña / cafetería" aria-label="Mesa pequeña">
                            <Icon Name="armchair" Size="12" />
                        </span>
                        break;
                    case TableFootprint.TableMonster:
                        <span class="w-6 h-6 rounded-lg bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border border-[var(--border-subtle)] inline-flex items-center justify-center hover:text-[var(--brand-primary)] hover:border-[var(--brand-primary)] transition-colors shrink-0" title="Mesa grande / despliegue masivo" aria-label="Mesa grande">
                            <Icon Name="castle" Size="12" />
                        </span>
                        break;
                    default:
                        <span class="w-6 h-6 rounded-lg bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border border-[var(--border-subtle)] inline-flex items-center justify-center hover:text-[var(--brand-primary)] hover:border-[var(--brand-primary)] transition-colors shrink-0" title="Mesa estándar de comedor" aria-label="Mesa estándar">
                            <Icon Name="utensils" Size="12" />
                        </span>
                        break;
                }

                @if (Game.IsAccessibleEarlier)
                {
                    <span class="h-6 px-1.5 rounded-lg bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border border-[var(--border-subtle)] inline-flex items-center justify-center gap-0.5 text-[0.62rem] font-bold shrink-0"
                          title="Edad recomendada por la comunidad: @Game.CommunityAge+ años"
                          aria-label="Edad comunitaria: @Game.CommunityAge+ años">
                        <Icon Name="baby" Size="11" />
                        <span>@Game.CommunityAge+</span>
                    </span>
                }
            </div>
        </div>
    </a>
}

@code {
    [Parameter, EditorRequired]
    public GameSummaryDto Game { get; set; } = null!;

    [Parameter]
    public string? CountryCode { get; set; }

    [Parameter]
    public EventCallback<GameSummaryDto> OnQuickAction { get; set; }

    private async Task HandleQuickActionClick()
    {
        await OnQuickAction.InvokeAsync(Game);
    }

    private static string FormatCompactPlayers(string? idealText)
    {
        if (string.IsNullOrWhiteSpace(idealText) || idealText.Contains("Sin datos", StringComparison.OrdinalIgnoreCase))
            return string.Empty;

        return idealText
            .Replace("Ideal:", "", StringComparison.OrdinalIgnoreCase)
            .Replace("jugadores", "J", StringComparison.OrdinalIgnoreCase)
            .Replace("jugador", "J", StringComparison.OrdinalIgnoreCase)
            .Trim();
    }
}
