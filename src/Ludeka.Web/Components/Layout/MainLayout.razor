@inherits LayoutComponentBase
@implements IDisposable
@using Ludeka.Application.Contracts
@using Ludeka.Core.ValueObjects
@using Ludeka.Web.Components.Shared
@inject ICurrentUserService CurrentUserService
@inject IUserPreferenceService PreferenceService
@inject IUserLocationService LocationService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Microsoft.Extensions.Options.IOptions<Ludeka.Application.Options.CommunityNotificationOptions> CommunityOptions

<div class="min-h-screen flex flex-col bg-[var(--bg-main)] text-[var(--text-primary)] transition-colors duration-200">
    <a href="#main-content" class="skip-link sr-only focus:not-sr-only">
        Saltar al contenido principal
    </a>
    <header class="header-nav">
        <div class="container-ludeka flex items-center justify-between h-16 gap-3">
            <a href="/" class="logo-badge flex items-center gap-2.5 shrink-0" title="Ludeka — Inicio">
                <img src="/images/logo-dark.png" alt="Logotipo de Ludeka" width="36" height="36" decoding="async" class="h-9 w-auto object-contain drop-shadow logo-img-dark" />
                <img src="/images/logo-light.png" alt="Logotipo de Ludeka" width="36" height="36" decoding="async" class="h-9 w-auto object-contain drop-shadow logo-img-light" />
                <span class="font-extrabold tracking-tight text-xl text-[var(--text-primary)]">Ludeka<span class="dot text-[var(--brand-primary)]">.</span></span>
            </a>

            @* Navegación Pública Principal *@
            <nav class="hidden lg:flex items-center gap-3 xl:gap-4 text-xs font-semibold">
                <a href="/catalogo" class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors">
                    Catálogo
                </a>
                <a href="/editoriales" class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors">
                    Editoriales
                </a>
                <a href="/creadores" class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors">
                    Creadores
                </a>
                <a href="/tiendas" class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors">
                    Tiendas
                </a>
                <a href="/sorteos" class="text-[var(--text-secondary)] hover:text-[var(--brand-primary)] transition-colors flex items-center gap-1">
                    <Icon Name="gift" Size="14" />
                    <span>Sorteos</span>
                </a>
                <a href="/novedades" class="text-[var(--text-secondary)] hover:text-[var(--brand-primary)] transition-colors flex items-center gap-1">
                    <Icon Name="newspaper" Size="14" />
                    <span>Novedades</span>
                </a>
                <a href="/eventos" class="text-[var(--text-secondary)] hover:text-[var(--brand-primary)] transition-colors flex items-center gap-1">
                    <Icon Name="tent" Size="14" />
                    <span>Eventos</span>
                </a>
            </nav>

            @* Zona de Utilidades y Controles de Usuario *@
            <div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
                @* Menú móvil: los destinos de la nav principal, accesibles siempre
                   (details/summary SSR puro, accesible, sin JavaScript) *@
                <details class="lg:hidden relative">
                    <summary aria-label="Menú de navegación"
                             class="px-2.5 py-1.5 rounded-full border border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)] hover:border-[var(--brand-primary)] text-xs font-bold transition-all flex items-center gap-1.5 text-[var(--text-primary)] shadow-sm cursor-pointer list-none [&::-webkit-details-marker]:hidden shrink-0">
                        <Icon Name="menu" Size="14" />
                        <span>Menú</span>
                    </summary>
                    <div class="absolute right-0 top-full mt-2 w-56 rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-card)] shadow-lg p-2 z-50">
                        <a href="/catalogo" class="block px-3 py-2 rounded-xl text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] transition-colors">Catálogo</a>
                        <a href="/editoriales" class="block px-3 py-2 rounded-xl text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] transition-colors">Editoriales</a>
                        <a href="/creadores" class="block px-3 py-2 rounded-xl text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] transition-colors">Creadores</a>
                        <a href="/tiendas" class="block px-3 py-2 rounded-xl text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] transition-colors">Tiendas</a>
                        <a href="/sorteos" class="block px-3 py-2 rounded-xl text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] transition-colors">Sorteos</a>
                        <a href="/novedades" class="block px-3 py-2 rounded-xl text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] transition-colors">Novedades</a>
                        <a href="/eventos" class="block px-3 py-2 rounded-xl text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] transition-colors">Eventos</a>
                    </div>
                </details>

                <OfflineIndicator />

                @* Selector de país / territorio *@
                <button type="button"
                        @onclick="() => _showLocationModal = true"
                        title="Configurar país para tiendas, eventos y sorteos"
                        aria-label="Configurar país y ámbito territorial"
                        class="px-2.5 py-1.5 rounded-full border border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)] hover:border-[var(--brand-primary)] text-xs font-bold transition-all flex items-center gap-1.5 text-[var(--text-primary)] shadow-sm shrink-0">
                    @if (string.IsNullOrWhiteSpace(_activeCountry))
                    {
                        <Icon Name="globe" Size="14" />
                    }
                    else
                    {
                        <span>@CountryCatalog.GetFlag(_activeCountry)</span>
                    }
                    <span class="hidden sm:inline">@(string.IsNullOrWhiteSpace(_activeCountry) ? "Global" : _activeCountry)</span>
                </button>

                @* Acceso Mi Ludoteca *@
                <a href="/mi-ludoteca" class="px-2.5 py-1.5 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--text-primary)] border border-[var(--border-subtle)] hover:border-[var(--border-highlight)] transition-all flex items-center gap-1.5 text-xs font-semibold shadow-sm shrink-0">
                    <Icon Name="library" Size="14" />
                    <span class="hidden sm:inline">Mi Ludoteca</span>
                </a>

                @* Menú Desplegable de Gestión / Mesa (Solo Administradores y Moderadores) *@
                @if (CurrentUserService.IsFoundingTeam || CurrentUserService.IsInRole("Moderator"))
                {
                    <div class="relative">
                        <button type="button"
                                @onclick="ToggleAdminMenu"
                                class="px-2.5 py-1.5 rounded-full border text-xs font-bold transition-all flex items-center gap-1.5 shadow-sm @(_isAdminMenuOpen ? "bg-[var(--bg-surface-elevated)] border-[var(--brand-primary)] text-[var(--brand-primary)]" : "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-highlight)]")"
                                title="Herramientas y paneles de gestión editorial"
                                aria-expanded="@_isAdminMenuOpen"
                                aria-haspopup="true">
                            <Icon Name="settings" Size="14" />
                            <span class="hidden sm:inline">Gestión</span>
                            <span class="text-[0.65rem] transition-transform duration-200 @(_isAdminMenuOpen ? "rotate-180" : "")">▼</span>
                        </button>

                        @if (_isAdminMenuOpen)
                        {
                            <div class="fixed inset-0 z-40" @onclick="() => _isAdminMenuOpen = false"></div>
                            <div class="absolute right-0 mt-2 w-72 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] shadow-2xl z-50 p-2.5 text-xs space-y-2.5 animate-fade-in divide-y divide-[var(--border-subtle)]">
                                <div class="p-1 pb-0 text-[var(--text-muted)] font-extrabold uppercase tracking-wider text-[0.65rem] flex items-center justify-between">
                                    <span>Panel de Mesa & Moderación</span>
                                    <span class="px-1.5 py-0.5 rounded bg-[var(--brand-primary)]/15 text-[var(--brand-primary)] font-black text-[0.6rem]">
                                        @(CurrentUserService.IsFoundingTeam ? "Fundador" : "Moderador")
                                    </span>
                                </div>

                                @* Bloque: Moderación & Catálogo *@
                                <div class="pt-2 space-y-1">
                                    <span class="px-2 text-[0.65rem] font-bold text-[var(--text-muted)] uppercase tracking-wider block">Moderación & Catálogo</span>
                                    @if (CurrentUserService.IsFoundingTeam || CurrentUserService.HasPermission(ModeratorPermission.CanResolveReports))
                                    {
                                        <a href="/moderacion/reportes" @onclick="() => _isAdminMenuOpen = false" class="flex items-center gap-2.5 px-2.5 py-2 rounded-xl hover:bg-[var(--bg-surface-elevated)] text-[var(--text-primary)] font-medium transition-colors">
                                            <span class="text-amber-400"><Icon Name="flag" Size="14" /></span>
                                            <div>
                                                <div class="font-bold text-[var(--text-primary)]">Reportes de Catálogo</div>
                                                <div class="text-[0.65rem] text-[var(--text-muted)]">Erratas y correcciones comunitarias</div>
                                            </div>
                                        </a>
                                    }
                                    @if (CurrentUserService.IsFoundingTeam || CurrentUserService.HasPermission(ModeratorPermission.CanEditGames))
                                    {
                                        <a href="/admin/cola-catalogacion" @onclick="() => _isAdminMenuOpen = false" class="flex items-center gap-2.5 px-2.5 py-2 rounded-xl hover:bg-[var(--bg-surface-elevated)] text-[var(--text-primary)] font-medium transition-colors">
                                            <span class="text-indigo-400"><Icon Name="moon" Size="14" /></span>
                                            <div>
                                                <div class="font-bold text-[var(--text-primary)]">Cola BGG & Catalogación</div>
                                                <div class="text-[0.65rem] text-[var(--text-muted)]">Batch nocturno y sincronización BGG</div>
                                            </div>
                                        </a>
                                    }
                                    @if (CurrentUserService.IsFoundingTeam || CurrentUserService.HasPermission(ModeratorPermission.CanApproveMedia))
                                    {
                                        <a href="/admin/ingesta-social" @onclick="() => _isAdminMenuOpen = false" class="flex items-center gap-2.5 px-2.5 py-2 rounded-xl hover:bg-[var(--bg-surface-elevated)] text-[var(--text-primary)] font-medium transition-colors">
                                            <span class="text-amber-400"><Icon Name="sparkles" Size="14" /></span>
                                            <div>
                                                <div class="font-bold text-[var(--text-primary)]">Bandeja Ingesta Social</div>
                                                <div class="text-[0.65rem] text-[var(--text-muted)]">Alta exprés, moderación y sorteos</div>
                                            </div>
                                        </a>
                                        <a href="/admin/canales-monitorizados" @onclick="() => _isAdminMenuOpen = false" class="flex items-center gap-2.5 px-2.5 py-2 rounded-xl hover:bg-[var(--bg-surface-elevated)] text-[var(--text-primary)] font-medium transition-colors">
                                            <span class="text-blue-400"><Icon Name="radio" Size="14" /></span>
                                            <div>
                                                <div class="font-bold text-[var(--text-primary)]">Canales Monitorizados</div>
                                                <div class="text-[0.65rem] text-[var(--text-muted)]">Directorio de Instagram, YouTube y webs</div>
                                            </div>
                                        </a>
                                        <a href="/moderacion-media" @onclick="() => _isAdminMenuOpen = false" class="flex items-center gap-2.5 px-2.5 py-2 rounded-xl hover:bg-[var(--bg-surface-elevated)] text-[var(--text-primary)] font-medium transition-colors">
                                            <span class="text-emerald-400"><Icon Name="clapperboard" Size="14" /></span>
                                            <div>
                                                <div class="font-bold text-[var(--text-primary)]">Moderación Multimedia</div>
                                                <div class="text-[0.65rem] text-[var(--text-muted)]">Vídeos de YouTube y carátulas</div>
                                            </div>
                                        </a>
                                    }
                                </div>

                                @* Bloque: Difusión & Comunidad *@
                                <div class="pt-2 space-y-1">
                                    <span class="px-2 text-[0.65rem] font-bold text-[var(--text-muted)] uppercase tracking-wider block">Difusión & Redes</span>
                                    @if (CurrentUserService.IsFoundingTeam || CurrentUserService.HasPermission(ModeratorPermission.CanPublishInstagram))
                                    {
                                        <a href="/admin/instagram" @onclick="() => _isAdminMenuOpen = false" class="flex items-center gap-2.5 px-2.5 py-2 rounded-xl hover:bg-[var(--bg-surface-elevated)] text-[var(--text-primary)] font-medium transition-colors">
                                            <span class="text-pink-400"><Icon Name="camera" Size="14" /></span>
                                            <div>
                                                <div class="font-bold text-[var(--text-primary)]">Publicador de Instagram</div>
                                                <div class="text-[0.65rem] text-[var(--text-muted)]">Posts oficiales de sorteos y noticias</div>
                                            </div>
                                        </a>
                                    }
                                    <a href="/admin/notificaciones" @onclick="() => _isAdminMenuOpen = false" class="flex items-center gap-2.5 px-2.5 py-2 rounded-xl hover:bg-[var(--bg-surface-elevated)] text-[var(--text-primary)] font-medium transition-colors">
                                        <span class="text-sky-400"><Icon Name="bell" Size="14" /></span>
                                        <div>
                                            <div class="font-bold text-[var(--text-primary)]">Webhooks & Notificaciones</div>
                                            <div class="text-[0.65rem] text-[var(--text-muted)]">Difusión a Discord y Telegram</div>
                                        </div>
                                    </a>
                                </div>

                                @* Bloque: Gobernanza *@
                                @if (CurrentUserService.HasPermission(ModeratorPermission.CanManageUsers) ||
                                     CurrentUserService.HasPermission(ModeratorPermission.CanViewAuditLog))
                                {
                                    <div class="pt-2 space-y-1">
                                        <span class="px-2 text-[0.65rem] font-bold text-[var(--text-muted)] uppercase tracking-wider block">Gobernanza del Sistema</span>
                                        <a href="/admin/usuarios" @onclick="() => _isAdminMenuOpen = false" class="flex items-center gap-2.5 px-2.5 py-2 rounded-xl hover:bg-[var(--bg-surface-elevated)] text-[var(--text-primary)] font-medium transition-colors">
                                            <span class="text-purple-400"><Icon Name="users" Size="14" /></span>
                                            <div>
                                                <div class="font-bold text-[var(--text-primary)]">Gestión de Usuarios</div>
                                                <div class="text-[0.65rem] text-[var(--text-muted)]">Roles RBAC y permisos de moderación</div>
                                            </div>
                                        </a>
                                        <a href="/admin/auditoria" @onclick="() => _isAdminMenuOpen = false" class="flex items-center gap-2.5 px-2.5 py-2 rounded-xl hover:bg-[var(--bg-surface-elevated)] text-[var(--text-primary)] font-medium transition-colors">
                                            <span class="text-sky-400"><Icon Name="scroll" Size="14" /></span>
                                            <div>
                                                <div class="font-bold text-[var(--text-primary)]">Bitácora de Auditoría</div>
                                                <div class="text-[0.65rem] text-[var(--text-muted)]">Histórico inmutable de mutaciones</div>
                                            </div>
                                        </a>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </header>

    <main class="flex-1" id="main-content" tabindex="-1">
        @Body
    </main>

    <footer class="mt-auto border-t border-[var(--border-subtle)] bg-[var(--bg-surface)] py-8 text-xs text-[var(--text-secondary)]">
        <div class="container-ludeka space-y-6">
            <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 pb-6 border-b border-[var(--border-subtle)]">
                <div class="space-y-1">
                    <p class="font-extrabold text-sm text-[var(--text-primary)] tracking-tight">Ludeka &copy; 2026</p>
                    <p class="text-xs text-[var(--text-secondary)]">El Letterboxd de los juegos de mesa en español.</p>
                    <p class="text-[0.68rem] text-[var(--text-muted)]">
                        Participamos en programas de afiliación de tiendas especializadas sin coste adicional para ti.
                    </p>
                </div>

                @* Canales de Comunidad (Discord y Telegram) *@
                <div class="flex items-center gap-2.5 flex-wrap">
                    @if (!string.IsNullOrWhiteSpace(CommunityOptions?.Value?.DiscordInviteUrl))
                    {
                        <a href="@CommunityOptions.Value.DiscordInviteUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           title="Unirse al servidor oficial de Discord de Ludeka"
                           class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[var(--bg-surface-elevated)] hover:bg-[#5865F2]/10 border border-[var(--border-subtle)] hover:border-[#5865F2]/40 text-[#5865F2] font-bold text-xs transition-all shadow-sm">
                            <Icon Name="message-circle" Size="14" />
                            <span>Comunidad Discord</span>
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(CommunityOptions?.Value?.TelegramChannelUrl))
                    {
                        <a href="@CommunityOptions.Value.TelegramChannelUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           title="Unirse al canal oficial de Telegram de Ludeka"
                           class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[var(--bg-surface-elevated)] hover:bg-[#229ED9]/10 border border-[var(--border-subtle)] hover:border-[#229ED9]/40 text-[#229ED9] font-bold text-xs transition-all shadow-sm">
                            <Icon Name="send" Size="14" />
                            <span>Canal Telegram</span>
                        </a>
                    }
                </div>
            </div>

            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-semibold">
                @* Atribución oficial de BoardGameGeek *@
                <div class="flex items-center gap-2">
                    <a href="https://boardgamegeek.com"
                       target="_blank"
                       rel="noopener noreferrer"
                       title="Visitar BoardGameGeek"
                       class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] hover:border-[var(--border-highlight)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors text-[0.7rem] font-bold tracking-tight">
                        <Icon Name="dices" Size="14" />
                        <span>Powered by BoardGameGeek</span>
                        <span class="text-[0.65rem] opacity-70">&nearr;</span>
                    </a>
                    <span class="text-[0.68rem] text-[var(--text-muted)] hidden lg:inline">
                        Datos técnicos sincronizados con la XMLAPI2 de BGG.
                    </span>
                </div>

                @* Enlaces de Navegación y Transparencia *@
                <div class="flex items-center gap-4 text-xs">
                    <a href="/transparencia" class="text-[var(--text-secondary)] hover:text-[var(--brand-primary)] transition-colors inline-flex items-center gap-1">
                        <Icon Name="shield" Size="12" /> Transparencia & Afiliados
                    </a>
                </div>
            </div>
        </div>
    </footer>
</div>

<LocationSelectorModal
    IsOpen="@_showLocationModal"
    OnClose="() => _showLocationModal = false"
    OnCountryChanged="HandleCountryChanged" />

<div id="blazor-error-ui" class="hidden">
    Ha ocurrido un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">&times;</span>
</div>

@code {
    private string CurrentTheme = "charcoal";
    private string? _activeCountry;
    private bool _showLocationModal;
    private bool _isAdminMenuOpen;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChangedForMenu;
    }

    private void HandleLocationChangedForMenu(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_isAdminMenuOpen)
        {
            _isAdminMenuOpen = false;
            StateHasChanged();
        }
    }

    private void ToggleAdminMenu()
    {
        _isAdminMenuOpen = !_isAdminMenuOpen;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChangedForMenu;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Consultar tema guardado en la base de datos para el usuario actual
                string userDbTheme = await PreferenceService.GetUserThemeAsync(CurrentUserService.UserId);

                // Consultar tema almacenado en localStorage para este usuario
                string stored = await JS.InvokeAsync<string>("getLudekaTheme", CurrentUserService.UserId);

                // Priorizar preferencia persistida de usuario si existe y es válida
                string effectiveTheme = !string.IsNullOrWhiteSpace(userDbTheme) && userDbTheme != "charcoal" 
                    ? userDbTheme 
                    : (!string.IsNullOrWhiteSpace(stored) ? stored : userDbTheme);

                if (!string.IsNullOrWhiteSpace(effectiveTheme) && effectiveTheme != CurrentTheme)
                {
                    CurrentTheme = effectiveTheme;
                    await JS.InvokeVoidAsync("setLudekaTheme", effectiveTheme, CurrentUserService.UserId);
                }

                // Cargar país activo
                _activeCountry = await LocationService.GetEffectiveCountryAsync();

                // Si no hay país en BD, comprobar localStorage o zona horaria
                if (string.IsNullOrWhiteSpace(_activeCountry))
                {
                    string? storedCountry = await JS.InvokeAsync<string?>("getStoredUserCountry", CurrentUserService.UserId);
                    if (!string.IsNullOrWhiteSpace(storedCountry))
                    {
                        LocationService.SetUserCountry(storedCountry);
                        _activeCountry = storedCountry;
                    }
                    else
                    {
                        string? detected = await JS.InvokeAsync<string?>("detectUserCountry");
                        if (!string.IsNullOrWhiteSpace(detected))
                        {
                            LocationService.SetDetectedCountry(detected);
                            // Solo como detección (no forzado a usuario)
                        }
                    }
                }

                StateHasChanged();
            }
            catch
            {
                // Ignorar en entornos donde JS o DB aún no estén listos en prerender
            }
        }
    }

    private async Task SwitchTheme(string theme)
    {
        CurrentTheme = theme;
        try
        {
            await JS.InvokeVoidAsync("setLudekaTheme", theme, CurrentUserService.UserId);
            await PreferenceService.SetUserThemeAsync(CurrentUserService.UserId, theme);
        }
        catch
        {
        }
    }

    private void HandleCountryChanged(string? country)
    {
        _activeCountry = country;
        _showLocationModal = false;
        StateHasChanged();
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
