@inherits LayoutComponentBase
@implements IDisposable
@using Ludeka.Application.Contracts
@using Ludeka.Core.ValueObjects
@using Ludeka.Web.Components.Shared
@inject ICurrentUserService CurrentUserService
@inject IUserPreferenceService PreferenceService
@inject IUserLocationService LocationService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Microsoft.Extensions.Options.IOptions<Ludeka.Application.Options.CommunityNotificationOptions> CommunityOptions

@*
    Shell Global «Revista Lúdica» (INC-114).
    - Cabecera reactiva de 72 px que tiñe su fondo según la sección activa.
    - Barra de navegación móvil fija en píldora con 5 destinos y hoja modal «Más de Ludeka».
    - Barra contextual StaffBar bajo la cabecera para moderadores y administradores.
    - Banner global de desconexión reactivo ante eventos navigator.onLine.
    - Cumplimiento estricto WCAG 2.2 AA (landmarks, aria attributes, skip link, área táctil >=48px).
*@

<div class="min-h-screen flex flex-col bg-[var(--paper)] text-[var(--ink)] transition-colors duration-200">
    <a href="#main-content" class="skip-link sr-only focus:not-sr-only">
        Saltar al contenido principal
    </a>

    @* Cabecera superior compacta reactiva (72 px) *@
    <header class="h-[72px] transition-colors duration-200 border-b border-[var(--line)] select-none shrink-0"
            style="background: @HeaderColors.Bg; color: @HeaderColors.Fg;">
        <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 h-full flex items-center justify-between gap-3 sm:gap-4">
            
            @* Navegación en escritorio (izquierda) *@
            <nav class="hidden lg:flex items-center gap-5 text-sm font-extrabold flex-1"
                 aria-label="Navegación principal">
                <a href="/catalogo"
                   style="border-bottom: 3px solid @(IsPageActive("catalogo") ? HeaderColors.Accent : "transparent");"
                   class="py-1 transition-opacity hover:opacity-80">
                    Catálogo
                </a>
                <a href="/sorteos"
                   style="border-bottom: 3px solid @(IsPageActive("sorteos") ? HeaderColors.Accent : "transparent");"
                   class="py-1 transition-opacity hover:opacity-80 inline-flex items-center gap-1.5">
                    <Icon Name="gift" Size="14" />
                    <span>Sorteos</span>
                </a>
                <a href="/novedades"
                   style="border-bottom: 3px solid @(IsPageActive("novedades") ? HeaderColors.Accent : "transparent");"
                   class="py-1 transition-opacity hover:opacity-80 inline-flex items-center gap-1.5">
                    <Icon Name="newspaper" Size="14" />
                    <span>Novedades</span>
                </a>
                <a href="/eventos"
                   style="border-bottom: 3px solid @(IsPageActive("eventos") ? HeaderColors.Accent : "transparent");"
                   class="py-1 transition-opacity hover:opacity-80 inline-flex items-center gap-1.5">
                    <Icon Name="tent" Size="14" />
                    <span>Eventos</span>
                </a>

                @* Desplegable de escritorio «Más ▾» *@
                <div class="relative" @onkeydown="HandleMoreKeyDown">
                    <button type="button"
                            @onclick="ToggleMore"
                            aria-haspopup="menu"
                            aria-expanded="@_isMoreOpen"
                            style="border-bottom: 3px solid @(_isMoreOpen || IsMoreSectionActive ? HeaderColors.Accent : "transparent");"
                            class="py-1 transition-opacity hover:opacity-80 flex items-center gap-1 font-extrabold text-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-current">
                        <span>Más</span>
                        <Icon Name="chevron-down" Size="14" />
                    </button>

                    @if (_isMoreOpen)
                    {
                        <div class="fixed inset-0 z-40" @onclick="CloseMore"></div>
                        <div role="menu"
                             aria-label="Más secciones de Ludeka"
                             class="absolute left-0 top-full mt-2 w-[260px] bg-[var(--paper)] text-[var(--ink)] border-2 border-[var(--rule)] rounded-[22px] p-2 shadow-2xl z-50 flex flex-col gap-1 animate-fade-in text-left">
                            <a href="/clasificaciones" @onclick="CloseMore" role="menuitem" class="p-2.5 rounded-xl hover:bg-[var(--paper-2)] transition-colors flex flex-col">
                                <b class="text-sm font-extrabold text-[var(--ink)]">Clasificación</b>
                                <span class="text-xs text-[var(--muted)] font-semibold">Ranking mensual de partidas</span>
                            </a>
                            <a href="/editoriales" @onclick="CloseMore" role="menuitem" class="p-2.5 rounded-xl hover:bg-[var(--paper-2)] transition-colors flex flex-col">
                                <b class="text-sm font-extrabold text-[var(--ink)]">Editoriales</b>
                                <span class="text-xs text-[var(--muted)] font-semibold">Casas de edición y juegos</span>
                            </a>
                            <a href="/creadores" @onclick="CloseMore" role="menuitem" class="p-2.5 rounded-xl hover:bg-[var(--paper-2)] transition-colors flex flex-col">
                                <b class="text-sm font-extrabold text-[var(--ink)]">Creadores</b>
                                <span class="text-xs text-[var(--muted)] font-semibold">Autoría y catálogo</span>
                            </a>
                            <a href="/tiendas" @onclick="CloseMore" role="menuitem" class="p-2.5 rounded-xl hover:bg-[var(--paper-2)] transition-colors flex flex-col">
                                <b class="text-sm font-extrabold text-[var(--ink)]">Tiendas</b>
                                <span class="text-xs text-[var(--muted)] font-semibold">Tiendas especializadas y ofertas</span>
                            </a>
                            <a href="/transparencia" @onclick="CloseMore" role="menuitem" class="p-2.5 rounded-xl hover:bg-[var(--paper-2)] transition-colors flex flex-col border-t border-[var(--line)] mt-1 pt-2">
                                <b class="text-sm font-extrabold text-[var(--ink)]">Transparencia</b>
                                <span class="text-xs text-[var(--muted)] font-semibold">Financiación y afiliados</span>
                            </a>
                        </div>
                    }
                </div>
            </nav>

            @* Menú móvil superior desplegable (SSR puro, accesible, details/summary) *@
            <details id="mobile-nav-details" data-mobile-nav class="lg:hidden relative">
                <summary aria-label="Menú de navegación"
                         class="px-2.5 py-1.5 rounded-full border border-current/30 bg-black/5 dark:bg-white/5 hover:border-current text-xs font-bold transition-all flex items-center gap-1.5 shadow-sm cursor-pointer list-none [&::-webkit-details-marker]:hidden shrink-0">
                    <Icon Name="menu" Size="14" />
                    <span>Menú</span>
                </summary>
                <div class="absolute left-0 top-full mt-2 w-56 rounded-2xl border-2 border-[var(--rule)] bg-[var(--paper)] text-[var(--ink)] shadow-2xl p-2 z-50">
                    <a href="/catalogo" onclick="this.closest('details')?.removeAttribute('open')" class="block px-3 py-2 rounded-xl text-xs font-semibold hover:bg-[var(--paper-2)] transition-colors">Catálogo</a>
                    <a href="/editoriales" onclick="this.closest('details')?.removeAttribute('open')" class="block px-3 py-2 rounded-xl text-xs font-semibold hover:bg-[var(--paper-2)] transition-colors">Editoriales</a>
                    <a href="/creadores" onclick="this.closest('details')?.removeAttribute('open')" class="block px-3 py-2 rounded-xl text-xs font-semibold hover:bg-[var(--paper-2)] transition-colors">Creadores</a>
                    <a href="/tiendas" onclick="this.closest('details')?.removeAttribute('open')" class="block px-3 py-2 rounded-xl text-xs font-semibold hover:bg-[var(--paper-2)] transition-colors">Tiendas</a>
                    <a href="/sorteos" onclick="this.closest('details')?.removeAttribute('open')" class="block px-3 py-2 rounded-xl text-xs font-semibold hover:bg-[var(--paper-2)] transition-colors">Sorteos</a>
                    <a href="/novedades" onclick="this.closest('details')?.removeAttribute('open')" class="block px-3 py-2 rounded-xl text-xs font-semibold hover:bg-[var(--paper-2)] transition-colors">Novedades</a>
                    <a href="/eventos" onclick="this.closest('details')?.removeAttribute('open')" class="block px-3 py-2 rounded-xl text-xs font-semibold hover:bg-[var(--paper-2)] transition-colors">Eventos</a>
                    <a href="/clasificaciones" onclick="this.closest('details')?.removeAttribute('open')" class="block px-3 py-2 rounded-xl text-xs font-semibold hover:bg-[var(--paper-2)] transition-colors">Clasificación</a>
                </div>
            </details>

            @* Logotipo editorial central *@
            <a href="/" class="flex items-center gap-2.5 shrink-0 transition-opacity hover:opacity-85" title="Ludeka — Inicio">
                <span class="w-[42px] h-[42px] rounded-full bg-[#FFF8EE] border border-[var(--line)] flex items-center justify-center shadow-xs shrink-0">
                    <img src="/images/logo-light.png" alt="Logotipo de Ludeka" width="32" height="32" decoding="async" class="h-8 w-auto object-contain" />
                </span>
                <span class="text-2xl font-black tracking-tighter">Ludeka<span style="color: @HeaderColors.Accent;">.</span></span>
            </a>

            @* Utilidades de cabecera (derecha) *@
            <div class="flex items-center gap-2 sm:gap-2.5 justify-end flex-1 shrink-0">
                @* 1. Barra / Enlace de búsqueda rápida (/buscar) *@
                <a href="/buscar"
                   class="h-10 px-3 rounded-full border border-current/30 hover:border-current bg-black/5 dark:bg-white/5 text-xs font-extrabold transition-all flex items-center gap-1.5 shrink-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-current"
                   title="Búsqueda rápida en Ludeka"
                   aria-label="Buscar en Ludeka">
                    <Icon Name="search" Size="15" />
                    <span class="hidden md:inline">Buscar</span>
                </a>

                @* 2. Botón de soporte y mecenazgo *@
                @if (!string.IsNullOrWhiteSpace(CommunityOptions?.Value?.KofiUrl))
                {
                    <a href="@CommunityOptions.Value.KofiUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="h-10 px-3 rounded-full border border-current/30 hover:border-current bg-black/5 dark:bg-white/5 text-xs font-extrabold transition-all flex items-center gap-1.5 shrink-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-current"
                       title="Apoyar el proyecto en Ko-fi"
                       aria-label="Apoyar en Ko-fi">
                        <Icon Name="coffee" Size="15" />
                        <span class="hidden xl:inline">Apoyar</span>
                    </a>
                }

                @* 3. Píldora de estado de red offline en cabecera *@
                <OfflineIndicator AsBanner="false" />

                @* 4. Conmutador claro/oscuro Sun/Moon *@
                <button type="button"
                        @onclick="ToggleTheme"
                        aria-label="Cambiar tema"
                        title="@(CurrentTheme == "dark" ? "Cambiar a tema claro" : "Cambiar a tema oscuro")"
                        class="w-10 h-10 rounded-full border border-current/30 hover:border-current bg-transparent flex items-center justify-center shrink-0 transition-opacity hover:opacity-80 focus:outline-none focus-visible:ring-2 focus-visible:ring-current">
                    <Icon Name="@(CurrentTheme == "dark" ? "sun" : "moon")" Size="17" />
                </button>

                @* Selector compacto de temas para visitantes (compatibilidad INC-113) *@
                @if (!HasSession)
                {
                    <GuestThemePicker CurrentTheme="@CurrentTheme" OnThemeChanged="SwitchTheme" />
                }

                @if (CurrentUserService.IsFoundingTeam || CurrentUserService.IsInRole("Moderator"))
                {
                    <a href="/admin/notificaciones"
                       class="h-10 w-10 rounded-full border border-current/30 hover:border-current bg-black/5 dark:bg-white/5 flex items-center justify-center shrink-0 transition-opacity hover:opacity-80 focus:outline-none focus-visible:ring-2 focus-visible:ring-current"
                       title="Webhooks & Notificaciones"
                       aria-label="Notificaciones del sistema">
                        <Icon Name="bell" Size="16" />
                    </a>
                }

                @* 5. Menú de cuenta y estado de sesión *@
                <AccountMenu />
            </div>
        </div>
    </header>

    @* Banner global de conectividad/offline reactivo ante eventos navigator.onLine *@
    <OfflineIndicator AsBanner="true" />

    @* Barra contextual de Staff para moderadores y administradores *@
    <StaffBar />

    @* Aviso descartable de correo no verificado *@
    <AccountEmailNotice />

    <main class="flex-1" id="main-content" tabindex="-1">
        @Body
    </main>

    @* Pie de página editorial con canales de comunidad y afiliados *@
    <footer class="mt-auto border-t border-[var(--line)] bg-[#12161A] py-8 mobile-nav-spacer text-xs text-stone-300 shadow-inner">
        <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
            <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 pb-6 border-b border-stone-800/80">
                <div class="space-y-1">
                    <p class="font-extrabold text-sm text-white tracking-tight">Ludeka &copy; 2026</p>
                    <p class="text-xs text-stone-300">Juegos, sorteos, eventos y opiniones de verdad. Bienvenido a tu mesa.</p>
                    <p class="text-[0.68rem] text-stone-400">
                        Participamos en programas de afiliación de tiendas especializadas sin coste adicional para ti.
                    </p>
                </div>

                @* Canales de Comunidad (Ko-fi, Discord y Telegram) *@
                <div class="flex items-center gap-2.5 flex-wrap">
                    @if (!string.IsNullOrWhiteSpace(CommunityOptions?.Value?.KofiUrl))
                    {
                        <a href="@CommunityOptions.Value.KofiUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           title="Apoyar el proyecto en Ko-fi"
                           class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#1A2026] hover:bg-amber-500/20 border border-stone-700/60 hover:border-amber-500/50 text-amber-400 font-bold text-xs transition-all shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500">
                            <Icon Name="coffee" Size="14" />
                            <span>Apoyar en Ko-fi</span>
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(CommunityOptions?.Value?.DiscordInviteUrl))
                    {
                        <a href="@CommunityOptions.Value.DiscordInviteUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           title="Unirse al servidor oficial de Discord de Ludeka"
                           class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#1A2026] hover:bg-[#5865F2]/20 border border-stone-700/60 hover:border-[#5865F2]/50 text-[#828BF8] font-bold text-xs transition-all shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#5865F2]">
                            <Icon Name="message-circle" Size="14" />
                            <span>Comunidad Discord</span>
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(CommunityOptions?.Value?.TelegramChannelUrl))
                    {
                        <a href="@CommunityOptions.Value.TelegramChannelUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           title="Unirse al canal oficial de Telegram de Ludeka"
                           class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#1A2026] hover:bg-[#229ED9]/20 border border-stone-700/60 hover:border-[#229ED9]/50 text-[#38BDF8] font-bold text-xs transition-all shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#229ED9]">
                            <Icon Name="send" Size="14" />
                            <span>Canal Telegram</span>
                        </a>
                    }
                </div>
            </div>

            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-semibold">
                @* Atribución oficial de BoardGameGeek *@
                <div class="flex items-center gap-2">
                    <a href="https://boardgamegeek.com"
                       target="_blank"
                       rel="noopener noreferrer"
                       title="Visitar BoardGameGeek"
                       class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#1A2026] border border-stone-700/60 hover:border-stone-500 text-stone-300 hover:text-white transition-colors text-[0.7rem] font-bold tracking-tight">
                        <Icon Name="dices" Size="14" />
                        <span>Powered by BoardGameGeek</span>
                        <span class="text-[0.65rem] opacity-70">&nearr;</span>
                    </a>
                    <span class="text-[0.68rem] text-stone-400 hidden lg:inline">
                        Datos técnicos sincronizados con la XMLAPI2 de BGG.
                    </span>
                </div>

                @* Enlaces de Navegación y Transparencia *@
                <div class="flex items-center gap-4 text-xs">
                    <a href="/clasificaciones" class="text-stone-300 hover:text-[var(--brand-primary)] transition-colors inline-flex items-center gap-1">
                        <Icon Name="trophy" Size="12" /> Clasificaciones
                    </a>
                    <a href="/transparencia" class="text-stone-300 hover:text-[var(--brand-primary)] transition-colors inline-flex items-center gap-1">
                        <Icon Name="shield" Size="12" /> Transparencia & Afiliados
                    </a>
                </div>
            </div>
        </div>
    </footer>

    @* Barra de navegación móvil fija al alcance del pulgar *@
    <MobileBottomNav />
</div>

<LocationSelectorModal
    IsOpen="@_showLocationModal"
    OnClose="() => _showLocationModal = false"
    OnCountryChanged="HandleCountryChanged" />

@* Recarga el circuito cuando la cuenta de la sesión se suspende o cambian sus permisos *@
<SessionGuard />

<div id="blazor-error-ui" class="hidden">
    Ha ocurrido un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">&times;</span>
</div>

@code {
    private string CurrentTheme = "wood";
    private string? _activeCountry;
    private bool _showLocationModal;
    private bool _isMoreOpen;

    private bool HasSession => !string.IsNullOrWhiteSpace(CurrentUserService.UserId);

    private string CurrentRelativePath
    {
        get
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
            var queryIndex = relative.IndexOf('?');
            if (queryIndex >= 0)
            {
                relative = relative.Substring(0, queryIndex);
            }
            return relative.Trim('/');
        }
    }

    private (string Bg, string Fg, string Accent) HeaderColors => GetHeaderColors();

    private (string Bg, string Fg, string Accent) GetHeaderColors()
    {
        var path = CurrentRelativePath.ToLowerInvariant();
        if (string.IsNullOrEmpty(path))
            return ("var(--brand)", "var(--on-brand)", "var(--mustard)");
        if (path == "catalogo" || path.StartsWith("catalogo/") || path.StartsWith("juegos"))
            return ("var(--green)", "var(--on-green)", "var(--mustard)");
        if (path == "sorteos" || path.StartsWith("sorteos/"))
            return ("var(--mustard)", "var(--on-mustard)", "#C9481C");
        if (path == "novedades" || path.StartsWith("novedades/"))
            return ("var(--inverse)", "var(--on-inverse)", "var(--mustard)");
        if (path == "eventos" || path.StartsWith("eventos/"))
            return ("var(--blue-band)", "var(--on-blue)", "var(--mustard)");
        if (path == "clasificaciones" || path.StartsWith("clasificaciones/"))
            return ("var(--plum)", "#FFF8EE", "var(--mustard)");

        return ("var(--paper)", "var(--ink)", "var(--accent)");
    }

    private bool IsPageActive(string section)
    {
        var path = CurrentRelativePath.ToLowerInvariant();
        return path == section || path.StartsWith(section + "/");
    }

    private bool IsMoreSectionActive
    {
        get
        {
            var path = CurrentRelativePath.ToLowerInvariant();
            return path == "clasificaciones" || path.StartsWith("clasificaciones/") ||
                   path == "editoriales" || path.StartsWith("editoriales/") ||
                   path == "creadores" || path.StartsWith("creadores/") ||
                   path == "tiendas" || path.StartsWith("tiendas/") ||
                   path == "transparencia" || path.StartsWith("transparencia/");
        }
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_isMoreOpen)
        {
            _isMoreOpen = false;
        }
        InvokeAsync(StateHasChanged);
    }

    private void ToggleMore()
    {
        _isMoreOpen = !_isMoreOpen;
    }

    private void CloseMore()
    {
        _isMoreOpen = false;
    }

    private void HandleMoreKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && _isMoreOpen)
        {
            CloseMore();
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Consultar tema almacenado en localStorage
                string stored = await JS.InvokeAsync<string>("getLudekaTheme", HasSession ? CurrentUserService.UserId : null);

                string effectiveTheme;
                if (HasSession)
                {
                    string userDbTheme = await PreferenceService.GetUserThemeAsync(CurrentUserService.UserId);
                    effectiveTheme = !string.IsNullOrWhiteSpace(userDbTheme)
                        ? userDbTheme
                        : (!string.IsNullOrWhiteSpace(stored) ? stored : "wood");
                }
                else
                {
                    effectiveTheme = !string.IsNullOrWhiteSpace(stored) ? stored : "wood";
                }

                if (!string.IsNullOrWhiteSpace(effectiveTheme) && effectiveTheme != CurrentTheme)
                {
                    CurrentTheme = effectiveTheme;
                    await JS.InvokeVoidAsync("setLudekaTheme", effectiveTheme, HasSession ? CurrentUserService.UserId : null);
                }

                // Cargar país activo
                _activeCountry = await LocationService.GetEffectiveCountryAsync();

                if (string.IsNullOrWhiteSpace(_activeCountry))
                {
                    string? storedCountry = await JS.InvokeAsync<string?>("getStoredUserCountry", CurrentUserService.UserId);
                    if (!string.IsNullOrWhiteSpace(storedCountry))
                    {
                        LocationService.SetUserCountry(storedCountry);
                        _activeCountry = storedCountry;
                    }
                    else
                    {
                        string? detected = await JS.InvokeAsync<string?>("detectUserCountry");
                        if (!string.IsNullOrWhiteSpace(detected))
                        {
                            LocationService.SetDetectedCountry(detected);
                        }
                    }
                }

                StateHasChanged();
            }
            catch
            {
                // Ignorar en prerender cuando JS no esté disponible
            }
        }
    }

    private async Task ToggleTheme()
    {
        var nextTheme = (CurrentTheme == "dark" || CurrentTheme == "charcoal" || CurrentTheme == "tabletop" || CurrentTheme == "midnight")
            ? "light"
            : "dark";
        await SwitchTheme(nextTheme);
    }

    private async Task SwitchTheme(string theme)
    {
        CurrentTheme = theme;
        try
        {
            await JS.InvokeVoidAsync("setLudekaTheme", theme, HasSession ? CurrentUserService.UserId : null);
            if (HasSession)
            {
                await PreferenceService.SetUserThemeAsync(CurrentUserService.UserId, theme);
            }
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
        }
        catch
        {
        }
        StateHasChanged();
    }

    private void HandleCountryChanged(string? country)
    {
        _activeCountry = country;
        _showLocationModal = false;
        StateHasChanged();
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
