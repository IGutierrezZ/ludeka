<!DOCTYPE html>
<html lang="es" data-theme="light" class="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    <ResourcePreloader />
    <!-- Preconexiones tempranas DNS / TLS para Fonts y Carátulas BGG -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cf.geekdo-images.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,800&family=Fraunces:opsz,wght@9..144,600..700&family=JetBrains+Mono:wght@500;700&display=swap" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Ludeka.Web.styles.css"]" />
    <!-- Favicon & Touch Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <!-- PWA & Mobile Meta Tags (Incremento 16) -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#C85A32" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Ludeka" />
    <script>
        (function() {
            try {
                // INC-113: Soporte zero-FOUC con resolución determinista light / dark
                var activeUserId = localStorage.getItem('ludeka-active-user-id');
                var rawTheme = (activeUserId ? localStorage.getItem('ludeka-theme-' + activeUserId) : null) || localStorage.getItem('ludeka-theme') || 'light';
                var theme = (rawTheme === 'dark' || rawTheme === 'charcoal' || rawTheme === 'tabletop' || rawTheme === 'midnight' || rawTheme === 'oscuro') ? 'dark' : 'light';
                document.documentElement.setAttribute('data-theme', theme);
                if (theme === 'dark') {
                    document.documentElement.classList.add('dark');
                    document.documentElement.classList.remove('light');
                } else {
                    document.documentElement.classList.add('light');
                    document.documentElement.classList.remove('dark');
                }
            } catch (e) {}
        })();
    </script>
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script>
        window.setLudekaTheme = function(theme, userId) {
            try {
                var normalized = (theme === 'dark' || theme === 'charcoal' || theme === 'tabletop' || theme === 'midnight' || theme === 'oscuro') ? 'dark' : 'light';
                localStorage.setItem('ludeka-theme', normalized);
                if (userId) {
                    localStorage.setItem('ludeka-theme-' + userId, normalized);
                    localStorage.setItem('ludeka-active-user-id', userId);
                }
                document.documentElement.setAttribute('data-theme', normalized);
                if (normalized === 'dark') {
                    document.documentElement.classList.add('dark');
                    document.documentElement.classList.remove('light');
                } else {
                    document.documentElement.classList.add('light');
                    document.documentElement.classList.remove('dark');
                }
            } catch (e) {}
        };
        window.getLudekaTheme = function(userId) {
            try {
                if (userId) {
                    var userTheme = localStorage.getItem('ludeka-theme-' + userId);
                    if (userTheme) {
                        return (userTheme === 'dark' || userTheme === 'charcoal' || userTheme === 'tabletop' || userTheme === 'midnight' || userTheme === 'oscuro') ? 'dark' : 'light';
                    }
                }
                var stored = localStorage.getItem('ludeka-theme');
                if (stored) {
                    return (stored === 'dark' || stored === 'charcoal' || stored === 'tabletop' || stored === 'midnight' || stored === 'oscuro') ? 'dark' : 'light';
                }
                return 'light';
            } catch (e) {
                return 'light';
            }
        };
        window.setActiveUserTheme = function(userId) {
            try {
                if (userId) {
                    localStorage.setItem('ludeka-active-user-id', userId);
                    var userTheme = localStorage.getItem('ludeka-theme-' + userId);
                    if (userTheme) {
                        var normalized = (userTheme === 'dark' || userTheme === 'charcoal' || userTheme === 'tabletop' || userTheme === 'midnight' || userTheme === 'oscuro') ? 'dark' : 'light';
                        document.documentElement.setAttribute('data-theme', normalized);
                        if (normalized === 'dark') {
                            document.documentElement.classList.add('dark');
                            document.documentElement.classList.remove('light');
                        } else {
                            document.documentElement.classList.add('light');
                            document.documentElement.classList.remove('dark');
                        }
                        return normalized;
                    }
                }
            } catch (e) {}
            return null;
        };
    </script>
    <script src="/js/ludeka-offline.js"></script>
    <script src="/js/locationInterop.js"></script>
    <script src="/js/editorial-modal.js" defer></script>
    <script src="/js/rail-scroll.js" defer></script>
    <script src="/js/mobile-nav.js" defer></script>
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function() {
                navigator.serviceWorker.register('/service-worker.js')
                    .then(function(reg) {
                        // Service Worker registrado correctamente
                    })
                    .catch(function(err) {
                        console.warn('[PWA] Error al registrar Service Worker:', err);
                    });
            });
        }
    </script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
