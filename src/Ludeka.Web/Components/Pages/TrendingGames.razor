@page "/tendencias"
@rendermode InteractiveServer
@inject ITrendingService TrendingService
@inject NavigationManager Navigation
@using System.Globalization
@using Ludeka.Application.Contracts
@using Ludeka.Application.DTOs
@using Ludeka.Core.Enums

<PageTitle>Tendencias de Hoy — Ludeka</PageTitle>

@* Hero Terracota Revista Lúdica *@
<section data-screen-label="Tendencias de hoy"
         class="w-full bg-[var(--brand)] text-[var(--on-brand)] py-8 sm:py-14 px-4 sm:px-8 md:px-12 -mt-3 mb-6 transition-colors shadow-sm select-none"
         style="background-color: var(--brand, #C9481C); color: var(--on-brand, #FFF8EE);">
    <div class="max-w-[1280px] mx-auto flex flex-col gap-5 sm:gap-6">
        <span class="text-xs sm:text-[13px] font-extrabold uppercase tracking-[0.18em] text-[#FFC145]">
            @(_comparison != null ? FormatDate(_comparison.DateUtc) : "Hoy") · Actualizado a las 08:00 UTC
        </span>

        <div class="flex flex-wrap justify-between items-end gap-5">
            <h1 class="text-5xl sm:text-7xl lg:text-[96px] font-black tracking-[-0.055em] leading-[0.88] m-0">
                Tendencias<br><i class="text-[#FFC145] font-serif font-black not-italic italic">de hoy</i>
            </h1>

            <div class="flex flex-col gap-3 items-start sm:items-end">
                <p class="text-sm sm:text-base max-w-[420px] leading-relaxed opacity-90 m-0">
                    Lo que más se está mirando y comentando en Ludeka y BGG en las últimas 24 horas: ascensos rápidos, novedades y títulos en boca de todos.
                </p>
                <a href="/catalogo" class="h-10 px-5 rounded-full border-2 border-[#FFF8EE] bg-transparent text-[#FFF8EE] hover:bg-white/10 text-xs font-black inline-flex items-center gap-2 transition-colors">
                    <span>Ir al catálogo</span>
                    <Icon Name="arrow-right" Size="14" />
                </a>
            </div>
        </div>

        @* Pestañas de píldora con borde blanco *@
        <div class="flex items-center gap-2 overflow-x-auto scrollbar-none pt-2" role="tablist">
            <button type="button"
                    @onclick='() => _activeFilter = "all"'
                    role="tab"
                    aria-selected="@(_activeFilter == "all")"
                    class="h-11 px-5 rounded-full border-2 border-[#FFF8EE] text-xs sm:text-sm font-extrabold transition-all shrink-0 focus-visible:outline-none @(_activeFilter == "all" ? "bg-[#FFF8EE] text-[#22180F] shadow-sm" : "bg-transparent text-[#FFF8EE] hover:bg-white/10")">
                Top 50 hoy
            </button>
            <button type="button"
                    @onclick='() => _activeFilter = "up"'
                    role="tab"
                    aria-selected="@(_activeFilter == "up")"
                    class="h-11 px-5 rounded-full border-2 border-[#FFF8EE] text-xs sm:text-sm font-extrabold transition-all shrink-0 focus-visible:outline-none @(_activeFilter == "up" ? "bg-[#FFF8EE] text-[#22180F] shadow-sm" : "bg-transparent text-[#FFF8EE] hover:bg-white/10")">
                Mayores subidas
            </button>
            <button type="button"
                    @onclick='() => _activeFilter = "new"'
                    role="tab"
                    aria-selected="@(_activeFilter == "new")"
                    class="h-11 px-5 rounded-full border-2 border-[#FFF8EE] text-xs sm:text-sm font-extrabold transition-all shrink-0 focus-visible:outline-none @(_activeFilter == "new" ? "bg-[#FFF8EE] text-[#22180F] shadow-sm" : "bg-transparent text-[#FFF8EE] hover:bg-white/10")">
                Nuevas entradas
            </button>
        </div>
    </div>
</section>

@* Contenedor de 2 columnas editorial *@
<div class="max-w-[1280px] mx-auto px-4 sm:px-8 md:px-12 pb-20 sm:pb-32 flex flex-col lg:flex-row gap-10 lg:gap-14">
    @* Columna Principal de Juegos en Tendencia *@
    <div class="flex-1 min-w-0 flex flex-col">
        @if (_isLoading)
        {
            <div class="py-20 text-center text-[var(--muted)]">
                <div class="inline-block animate-spin text-[var(--brand)] mb-3"><Icon Name="flame" Size="36" /></div>
                <p class="text-sm font-black">Cargando las tendencias de la mesa...</p>
            </div>
        }
        else if (FilteredItems.Count == 0)
        {
            <div class="py-16 text-center text-sm font-bold text-[var(--muted)]">
                No hay juegos que coincidan con este filtro en el Top de hoy.
            </div>
        }
        else
        {
            <div class="flex flex-col divide-y divide-[var(--line)]" role="list">
                @foreach (var item in FilteredItems)
                {
                    var colorVar = GetCyclicColor(item.Rank);
                    var displayTitle = !string.IsNullOrWhiteSpace(item.SpanishTitle) ? item.SpanishTitle : item.Title;
                    var rotation = item.Rank % 2 == 0 ? "rotate-[-1.5deg]" : "rotate-[1.5deg]";

                    <div class="flex items-center gap-3 sm:gap-5 py-3.5 sm:py-4 hover:bg-[var(--paper-2)]/50 transition-colors group px-1" role="listitem">
                        @* Numeral ciclálico gigante *@
                        <b class="w-10 sm:w-14 shrink-0 text-3xl sm:text-4xl lg:text-5xl font-black tracking-[-0.06em] text-center leading-none"
                           style="color: @colorVar">
                            @item.Rank.ToString("00")
                        </b>

                        @* Carátula con rotación física *@
                        <a href="/juegos/@item.Slug"
                           class="w-14 h-14 sm:w-18 sm:h-18 lg:w-20 lg:h-20 shrink-0 rounded overflow-hidden shadow-sm bg-[var(--paper-2)] border border-black/5 @rotation group-hover:scale-105 transition-transform duration-300">
                            <img src="@(string.IsNullOrWhiteSpace(item.ThumbnailUrl) ? "/images/game-placeholder.svg" : item.ThumbnailUrl)"
                                 alt="@displayTitle"
                                 width="80"
                                 height="80"
                                 loading="lazy"
                                 decoding="async"
                                 class="w-full h-full object-cover"
                                 onerror="this.onerror=null; this.src='/images/game-placeholder.svg';" />
                        </a>

                        @* Información editorial *@
                        <div class="flex-1 min-w-0 pr-2">
                            <a href="/juegos/@item.Slug"
                               class="text-base sm:text-lg lg:text-xl font-black text-[var(--ink)] tracking-tight leading-snug truncate block group-hover:text-[var(--accent)] transition-colors">
                                @displayTitle
                            </a>

                            <div class="flex items-center gap-2 flex-wrap text-xs text-[var(--muted)] mt-1 font-semibold">
                                @if (item.YearPublished.HasValue)
                                {
                                    <span>@item.YearPublished.Value</span>
                                }
                                @if (item.BggRating.HasValue && item.BggRating.Value > 0)
                                {
                                    <span class="text-[var(--ink)] font-black">· ★ @item.BggRating.Value.ToString("0.0")</span>
                                }
                                @if (item.BggRank.HasValue && item.BggRank.Value > 0)
                                {
                                    <span>· BGG #@item.BggRank.Value</span>
                                }
                            </div>
                        </div>

                        @* Métrica de movimiento a la derecha *@
                        <div class="flex flex-col items-end gap-1 shrink-0">
                            @switch (item.Movement)
                            {
                                case RankMovement.Up:
                                    <span class="px-2.5 py-1 rounded-full bg-[#E5F7ED] text-[#1B7D52] text-xs font-black inline-flex items-center gap-1 shadow-xs">
                                        <Icon Name="arrow-up" Size="12" />
                                        <span>+@item.PositionsChanged</span>
                                    </span>
                                    <span class="text-[10px] font-bold text-[var(--muted)]">sube</span>
                                    break;
                                case RankMovement.Down:
                                    <span class="px-2.5 py-1 rounded-full bg-red-50 text-red-600 text-xs font-black inline-flex items-center gap-1 shadow-xs">
                                        <Icon Name="arrow-down" Size="12" />
                                        <span>-@item.PositionsChanged</span>
                                    </span>
                                    <span class="text-[10px] font-bold text-[var(--muted)]">baja</span>
                                    break;
                                case RankMovement.New:
                                    <span class="px-2.5 py-1 rounded-full bg-[#FFC145] text-[#22180F] text-xs font-black inline-flex items-center gap-1 shadow-xs">
                                        <Icon Name="sparkles" Size="12" />
                                        <span>Entra</span>
                                    </span>
                                    <span class="text-[10px] font-bold text-[var(--muted)]">en el top</span>
                                    break;
                                case RankMovement.Same:
                                    <span class="px-2.5 py-1 rounded-full bg-[var(--paper-2)] text-[var(--muted)] text-xs font-bold border border-[var(--line)]">
                                        =
                                    </span>
                                    <span class="text-[10px] font-bold text-[var(--muted)]">mantiene</span>
                                    break;
                                default:
                                    <span class="px-2.5 py-1 rounded-full bg-[var(--paper-2)] text-[var(--muted)] text-xs font-bold border border-[var(--line)]">
                                        =
                                    </span>
                                    <span class="text-[10px] font-bold text-[var(--muted)]">mantiene</span>
                                    break;
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @* Barra lateral Aside de Claude Design *@
    <aside class="w-full lg:w-[320px] shrink-0 flex flex-col gap-9">
        @* Búsquedas en alza *@
        <div class="flex flex-col gap-3">
            <span class="text-xs font-black uppercase tracking-[0.14em] pb-2 border-b-[3px] border-[var(--rule)] text-[var(--ink)]">
                Búsquedas en alza
            </span>
            <div class="flex flex-wrap gap-2 pt-1">
                <a href="/catalogo?q=Brass" class="h-9 px-3.5 rounded-full border border-[var(--line)] bg-[var(--card)] hover:border-[var(--ink)] text-[var(--ink)] text-xs font-bold inline-flex items-center gap-1.5 transition-colors">
                    <span>Brass: Birmingham</span>
                    <span class="text-[#1B7D52] text-[11px] font-extrabold">+42%</span>
                </a>
                <a href="/catalogo?q=Ark+Nova" class="h-9 px-3.5 rounded-full border border-[var(--line)] bg-[var(--card)] hover:border-[var(--ink)] text-[var(--ink)] text-xs font-bold inline-flex items-center gap-1.5 transition-colors">
                    <span>Ark Nova</span>
                    <span class="text-[#1B7D52] text-[11px] font-extrabold">+28%</span>
                </a>
                <a href="/catalogo?q=Dune+Imperium" class="h-9 px-3.5 rounded-full border border-[var(--line)] bg-[var(--card)] hover:border-[var(--ink)] text-[var(--ink)] text-xs font-bold inline-flex items-center gap-1.5 transition-colors">
                    <span>Dune: Imperium</span>
                    <span class="text-[#1B7D52] text-[11px] font-extrabold">+19%</span>
                </a>
                <a href="/catalogo?q=Harmonies" class="h-9 px-3.5 rounded-full border border-[var(--line)] bg-[var(--card)] hover:border-[var(--ink)] text-[var(--ink)] text-xs font-bold inline-flex items-center gap-1.5 transition-colors">
                    <span>Harmonies</span>
                    <span class="text-[#1B7D52] text-[11px] font-extrabold">+54%</span>
                </a>
            </div>
        </div>

        @* Accesos rápidos complementarios *@
        <div class="p-6 rounded-2xl bg-[var(--inverse)] text-[var(--on-inverse)] flex flex-col gap-3">
            <span class="text-xs font-black uppercase tracking-[0.12em] text-[#FFC145]">
                Catálogo editorial
            </span>
            <h3 class="text-xl font-black tracking-tight leading-snug m-0">
                ¿Buscas un juego específico?
            </h3>
            <p class="text-xs leading-relaxed opacity-80 m-0">
                Filtra por número de jugadores, peso, duración y estilo con nuestro recomendador conversacional.
            </p>
            <a href="/catalogo" class="mt-2 h-10 px-5 rounded-full bg-[#FFC145] text-[#22180F] text-xs font-black inline-flex items-center justify-center self-start hover:scale-105 active:scale-95 transition-transform">
                Explorar catálogo
            </a>
        </div>
    </aside>
</div>

@code {
    private TrendingComparisonDto? _comparison;
    private bool _isLoading = true;
    private string _activeFilter = "all";

    private IReadOnlyList<TrendingGameItemDto> FilteredItems
    {
        get
        {
            if (_comparison?.Items == null) return [];
            return _activeFilter switch
            {
                "up" => _comparison.Items.Where(i => i.Movement == RankMovement.Up).OrderByDescending(i => i.PositionsChanged).ToList(),
                "new" => _comparison.Items.Where(i => i.Movement == RankMovement.New).ToList(),
                _ => _comparison.Items
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            _comparison = await TrendingService.GetTrendingComparisonAsync();
        }
        catch
        {
            _comparison = new TrendingComparisonDto(DateOnly.FromDateTime(DateTime.UtcNow), null, Array.Empty<TrendingGameItemDto>());
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string GetCyclicColor(int position) => ((position - 1) % 5) switch
    {
        0 => "var(--accent)",
        1 => "var(--mustard)",
        2 => "var(--accent-green)",
        3 => "var(--sky)",
        _ => "var(--pink)"
    };

    private static string FormatDate(DateOnly date)
    {
        var dt = date.ToDateTime(TimeOnly.MinValue);
        return dt.ToString("d 'de' MMMM 'de' yyyy", new CultureInfo("es-ES"));
    }
}
