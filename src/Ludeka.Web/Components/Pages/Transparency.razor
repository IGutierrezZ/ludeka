@page "/transparencia"
@inject Microsoft.Extensions.Options.IOptions<Ludeka.Application.Options.CommunityNotificationOptions> CommunityOptions

<PageTitle>Manifiesto de Transparencia de Fondos — Ludeka</PageTitle>

<div class="container-ludeka py-12 max-w-4xl space-y-10">
    @* Encabezado de la Declaración *@
    <div class="text-center space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-secondary)] text-xs font-bold">
            <Icon Name="shield" Size="14" /> Compromiso Ético &bull; Independencia Lúdica
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-[var(--text-primary)] tracking-tight">
            Manifiesto de Transparencia
        </h1>
        <p class="text-base sm:text-lg text-[var(--text-secondary)] max-w-2xl mx-auto leading-relaxed">
            Sin banners invasivos, sin publirreportajes pagados y con total claridad sobre cómo se sostiene y reinvierte cada euro en el hobby.
        </p>
    </div>

    @* Declaración de Principios *@
    <div class="p-8 rounded-3xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-4">
        <h2 class="text-xl font-bold text-[var(--text-primary)] flex items-center gap-2.5">
            <Icon Name="dices" Size="18" /> Nacido de jugones para jugones
        </h2>
        <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed">
            <strong>Ludeka</strong> es una plataforma web independiente construida para la comunidad hispanohablante de juegos de mesa. Rechazamos los modelos tradicionales saturados de publicidad ruidosa o reseñas compradas. Todo el catálogo, rankings, semáforos de escalabilidad, dudas de reglamento y sorteos son <strong>100% de libre acceso</strong>.
        </p>
        <p class="text-sm text-[var(--text-muted)] leading-relaxed">
            Nuestras únicas vías de ingreso provienen de enlaces de compra contextuales (afiliación con tiendas de confianza y Amazon) y aportaciones voluntarias de mecenazgo en Ko-fi.
        </p>
    </div>

    @* Los 3 Pilares Éticos de Reinversión *@
    <div class="space-y-4">
        <div class="text-center">
            <span class="text-xs uppercase font-bold tracking-wider text-[var(--brand-primary)]">Destino de los Fondos</span>
            <h3 class="text-2xl font-bold text-[var(--text-primary)] mt-1">¿A qué se destina el dinero recaudado?</h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
            @* Pilar 1 *@
            <div class="p-6 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] flex flex-col justify-between">
                <div class="space-y-3">
                    <Icon Name="zap" Size="30" />
                    <h4 class="text-base font-bold text-[var(--text-primary)]">1. Servidores y Mantenimiento</h4>
                    <p class="text-xs text-[var(--text-muted)] leading-relaxed">
                        Cubrir los costes mensuales de hosting, dominio, base de datos de alta velocidad y certificados, garantizando tiempos de respuesta ultrarrápidos y alta disponibilidad.
                    </p>
                </div>
                <div class="mt-4 pt-3 border-t border-[var(--border-subtle)] text-[0.7rem] text-[var(--text-muted)]">
                    Coste eficiente &bull; 0 € en anuncios
                </div>
            </div>

            @* Pilar 2 *@
            <div class="p-6 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] flex flex-col justify-between">
                <div class="space-y-3">
                    <Icon Name="camera" Size="30" />
                    <h4 class="text-base font-bold text-[var(--text-primary)]">2. Copias para Mesa Real</h4>
                    <p class="text-xs text-[var(--text-muted)] leading-relaxed">
                        Adquirir novedades y expansiones para que la Mesa Fundadora pueda probarlas a fondo a 2 personas (parejas) y con niños/familias, aportando fotos reales y veredictos honestos.
                    </p>
                </div>
                <div class="mt-4 pt-3 border-t border-[var(--border-subtle)] text-[0.7rem] text-[var(--text-muted)]">
                    Análisis rigurosos &bull; Fotos sin trampa
                </div>
            </div>

            @* Pilar 3 *@
            <div class="p-6 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] flex flex-col justify-between">
                <div class="space-y-3">
                    <Icon Name="gift" Size="30" />
                    <h4 class="text-base font-bold text-[var(--text-primary)]">3. Sorteos Comunitarios</h4>
                    <p class="text-xs text-[var(--text-muted)] leading-relaxed">
                        Financiar periódicamente sorteos de juegos top adquiridos expresamente para devolver el apoyo a los miembros que aportan micro-reseñas y resuelven dudas en la web.
                    </p>
                </div>
                <div class="mt-4 pt-3 border-t border-[var(--border-subtle)] text-[0.7rem] text-[var(--text-muted)]">
                    Premios para usuarios activos
                </div>
            </div>
        </div>
    </div>

    @* Bloque de Apoyo y Canales Comunitarios *@
    <div class="p-8 rounded-3xl bg-[var(--bg-card)] border border-[var(--border-subtle)] flex flex-col sm:flex-row items-center justify-between gap-6 shadow-sm">
        <div class="space-y-2 text-center sm:text-left">
            <h3 class="text-xl font-bold text-[var(--text-primary)]">
                ¿Quieres apoyar el proyecto?
            </h3>
            <p class="text-xs sm:text-sm text-[var(--text-secondary)] max-w-lg leading-relaxed">
                Puedes colaborar como mecenas en Ko-fi (obtendrás la insignia dorada de <strong class="text-amber-500 font-bold">Mecenas</strong>) o unirte a nuestros canales de Discord y Telegram para debatir reglas, partidas y sugerir mejoras.
            </p>
        </div>

        <div class="flex items-center gap-3 shrink-0 flex-wrap justify-center sm:justify-start">
            @if (!string.IsNullOrWhiteSpace(CommunityOptions?.Value?.KofiUrl))
            {
                <a href="@CommunityOptions.Value.KofiUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   title="Apoyar el proyecto en Ko-fi"
                   class="px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs transition-colors flex items-center gap-2 shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500">
                    <Icon Name="coffee" Size="14" /> Apoyar en Ko-fi
                </a>
            }

            @if (!string.IsNullOrWhiteSpace(CommunityOptions?.Value?.DiscordInviteUrl))
            {
                <a href="@CommunityOptions.Value.DiscordInviteUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   title="Unirse al servidor oficial de Discord de Ludeka"
                   class="px-4 py-2.5 rounded-xl bg-[#5865F2] hover:bg-[#4752C4] text-white font-bold text-xs transition-colors flex items-center gap-2 shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#5865F2]">
                    <Icon Name="message-circle" Size="14" /> Discord Oficial
                </a>
            }

            @if (!string.IsNullOrWhiteSpace(CommunityOptions?.Value?.TelegramChannelUrl))
            {
                <a href="@CommunityOptions.Value.TelegramChannelUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   title="Unirse al canal oficial de Telegram de Ludeka"
                   class="px-4 py-2.5 rounded-xl bg-[#229ED9] hover:bg-[#1e8dbf] text-white font-bold text-xs transition-colors flex items-center gap-2 shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#229ED9]">
                    <Icon Name="send" Size="14" /> Canal Telegram
                </a>
            }
        </div>
    </div>
</div>
