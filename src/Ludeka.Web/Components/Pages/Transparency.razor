@page "/transparencia"
@inject Microsoft.Extensions.Options.IOptions<Ludeka.Application.Options.CommunityNotificationOptions> CommunityOptions

<PageTitle>Transparencia y Afiliados — Ludeka</PageTitle>

<section data-screen-label="Transparencia" class="max-w-[960px] mx-auto px-4 sm:px-8 lg:px-12 pt-8 sm:pt-14 pb-20 flex flex-col gap-11 font-sans">
    @* Encabezado de la Pantalla *@
    <div class="flex flex-col gap-3.5">
        <span class="text-xs sm:text-[13px] font-extrabold uppercase tracking-[0.18em] text-[var(--accent)] inline-flex items-center gap-1.5">
            <Icon Name="shield" Size="14" />
            <span>Cómo funciona Ludeka</span>
        </span>
        <h1 class="m-0 text-[52px] sm:text-[76px] lg:text-[100px] leading-[0.86] font-extrabold tracking-[-0.06em] text-[var(--ink)]">
            Transparencia<br />
            y <i class="italic text-[var(--accent)] font-serif font-normal">afiliados</i>
        </h1>
        <p class="m-0 text-base sm:text-[17px] leading-relaxed text-[var(--muted)] max-w-2xl">
            Sin banners invasivos, sin publirreportajes pagados y con total claridad sobre cómo se sostiene y reinvierte cada euro en la comunidad de juegos de mesa.
        </p>
    </div>

    @* Bloques Editoriales Numerados (01 a 04) *@
    <div class="flex flex-col gap-10">
        @* 01 *@
        <div class="flex flex-col gap-3">
            <div class="flex items-baseline gap-4 border-b-[3px] border-[var(--rule)] pb-3">
                <b class="text-4xl sm:text-[44px] leading-none tracking-[-0.06em] text-[var(--accent)] font-extrabold">01</b>
                <div class="flex items-center gap-2">
                    <span class="text-[var(--accent)]"><Icon Name="zap" Size="20" /></span>
                    <b class="text-xl sm:text-[26px] tracking-[-0.03em] text-[var(--ink)] font-extrabold">Cómo se financia Ludeka</b>
                </div>
            </div>
            <p class="m-0 text-base sm:text-[17px] leading-[1.6] text-[var(--muted)]">
                Ludeka se mantiene con enlaces de afiliado a tiendas especializadas de confianza y con aportaciones voluntarias de mecenazgo en Ko-fi. Los enlaces de afiliado no tienen ningún coste adicional para ti y no influyen en el orden del catálogo, en las valoraciones ni en los veredictos.
            </p>
        </div>

        @* 02 *@
        <div class="flex flex-col gap-3">
            <div class="flex items-baseline gap-4 border-b-[3px] border-[var(--rule)] pb-3">
                <b class="text-4xl sm:text-[44px] leading-none tracking-[-0.06em] text-[var(--mustard)] font-extrabold">02</b>
                <div class="flex items-center gap-2">
                    <span class="text-[var(--mustard)]"><Icon Name="dices" Size="20" /></span>
                    <b class="text-xl sm:text-[26px] tracking-[-0.03em] text-[var(--ink)] font-extrabold">Valoraciones y veredictos</b>
                </div>
            </div>
            <p class="m-0 text-base sm:text-[17px] leading-[1.6] text-[var(--muted)]">
                El rating BGG procede directamente de BoardGameGeek. El consenso Ludeka combina las valoraciones de la comunidad registrada. Los veredictos los firma la Mesa Fundadora tras partidas reales; cuando aún no hay veredicto disponible, se muestra una síntesis asistida, indicada honestamente como tal.
            </p>
        </div>

        @* 03 *@
        <div class="flex flex-col gap-3">
            <div class="flex items-baseline gap-4 border-b-[3px] border-[var(--rule)] pb-3">
                <b class="text-4xl sm:text-[44px] leading-none tracking-[-0.06em] text-[var(--accent-green)] font-extrabold">03</b>
                <div class="flex items-center gap-2">
                    <span class="text-[var(--accent-green)]"><Icon Name="camera" Size="20" /></span>
                    <b class="text-xl sm:text-[26px] tracking-[-0.03em] text-[var(--ink)] font-extrabold">Datos de BoardGameGeek</b>
                </div>
            </div>
            <p class="m-0 text-base sm:text-[17px] leading-[1.6] text-[var(--muted)]">
                Los datos técnicos de los juegos (jugadores recomendados, duración, autoría, ilustradores y año) se sincronizan con la XMLAPI2 de BoardGameGeek. Si detectas cualquier errata o desajuste en una edición española, puedes reportarla desde la propia ficha del juego.
            </p>
        </div>

        @* 04 *@
        <div class="flex flex-col gap-3">
            <div class="flex items-baseline gap-4 border-b-[3px] border-[var(--rule)] pb-3">
                <b class="text-4xl sm:text-[44px] leading-none tracking-[-0.06em] text-[var(--sky)] font-extrabold">04</b>
                <div class="flex items-center gap-2">
                    <span class="text-[var(--sky)]"><Icon Name="gift" Size="20" /></span>
                    <b class="text-xl sm:text-[26px] tracking-[-0.03em] text-[var(--ink)] font-extrabold">Sorteos y moderación</b>
                </div>
            </div>
            <p class="m-0 text-base sm:text-[17px] leading-[1.6] text-[var(--muted)]">
                Los sorteos propuestos por la comunidad o detectados en redes se revisan antes de publicarse para evitar spam y cuentas fraudulentas. Ludeka no organiza los sorteos de terceros: la participación y las bases legales se completan siempre en la publicación original del organizador.
            </p>
        </div>
    </div>

    @* Bloque de Apoyo Comunitario y Canales *@
    <div class="p-6 sm:p-8 rounded-[24px] bg-[var(--paper-2)] border-2 border-[var(--rule)] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 shadow-[0_12px_24px_var(--shadow)]">
        <div class="space-y-2">
            <h3 class="text-xl sm:text-2xl font-extrabold text-[var(--ink)] tracking-tight">
                ¿Quieres apoyar el proyecto?
            </h3>
            <p class="text-sm leading-relaxed text-[var(--muted)] max-w-lg">
                Puedes colaborar como mecenas voluntario en Ko-fi o unirte a nuestros canales oficiales de Discord y Telegram para debatir sobre juegos, reglas y sugerir mejoras.
            </p>
        </div>

        <div class="flex items-center gap-3 shrink-0 flex-wrap">
            @if (!string.IsNullOrWhiteSpace(CommunityOptions?.Value?.KofiUrl))
            {
                <a href="@CommunityOptions.Value.KofiUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   title="Apoyar el proyecto en Ko-fi"
                   class="h-11 px-5 rounded-full bg-[var(--brand)] hover:opacity-90 text-[var(--on-brand)] font-extrabold text-xs sm:text-sm inline-flex items-center gap-2 transition-all shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand)]">
                    <Icon Name="coffee" Size="15" />
                    <span>Apoyar en Ko-fi</span>
                </a>
            }

            @if (!string.IsNullOrWhiteSpace(CommunityOptions?.Value?.DiscordInviteUrl))
            {
                <a href="@CommunityOptions.Value.DiscordInviteUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   title="Unirse al servidor oficial de Discord de Ludeka"
                   class="h-11 px-5 rounded-full bg-[var(--card)] text-[var(--ink)] border-2 border-[var(--rule)] hover:bg-[var(--paper-2)] font-extrabold text-xs sm:text-sm inline-flex items-center gap-2 transition-all shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--sky)]">
                    <Icon Name="message-circle" Size="15" />
                    <span>Discord Oficial</span>
                </a>
            }

            @if (!string.IsNullOrWhiteSpace(CommunityOptions?.Value?.TelegramChannelUrl))
            {
                <a href="@CommunityOptions.Value.TelegramChannelUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   title="Unirse al canal oficial de Telegram de Ludeka"
                   class="h-11 px-5 rounded-full bg-[var(--card)] text-[var(--ink)] border-2 border-[var(--rule)] hover:bg-[var(--paper-2)] font-extrabold text-xs sm:text-sm inline-flex items-center gap-2 transition-all shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--sky)]">
                    <Icon Name="send" Size="15" />
                    <span>Canal Telegram</span>
                </a>
            }
        </div>
    </div>
</section>
