@page "/sorteos"
@page "/radar"
@rendermode InteractiveServer
@using Ludeka.Application.Contracts
@using Ludeka.Core.ValueObjects
@inject IGiveawayService GiveawayService
@inject ICurrentUserService CurrentUserService
@inject IUserLocationService LocationService

<PageTitle>Radar de Sorteos — Ludeka</PageTitle>

<div class="container-ludeka py-8 space-y-8">
    <PageHeaderEditorial Badge="Radar de Sorteos Comunitarios"
                         BadgeIcon="gift"
                         Subtitle="Oportunidades lúdicas verificadas sin spam. Sorteos activos en Instagram, YouTube y redes con alertas de expiración y destacados oficiales.">
        <Title>Sorteos de Juegos de Mesa</Title>
        <Actions>
            @if (IsModerator)
            {
                <button type="button"
                        @onclick="() => _isExpressModalOpen = true"
                        class="px-3.5 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs transition-all flex items-center gap-1.5 shadow-sm">
                    <Icon Name="zap" Size="12" /> Alta Exprés
                </button>
            }
            <button type="button"
                    @onclick="() => _isCreateModalOpen = true"
                    class="px-4 py-2 rounded-xl bg-[var(--brand-primary)] hover:opacity-90 text-[var(--on-brand)] font-bold text-xs transition-all flex items-center gap-1.5 shadow-sm">
                <Icon Name="plus" Size="12" /> Proponer Sorteo
            </button>
        </Actions>
    </PageHeaderEditorial>

    @* Filtro de activos / todos y filtro territorial *@
    <div class="flex items-center justify-between flex-wrap gap-3">
        <div class="flex items-center gap-2 flex-wrap">
            <button type="button"
                    @onclick="() => ToggleExpiredFilter(false)"
                    class="px-3 py-1.5 rounded-lg text-xs font-bold border transition-colors @(!_includeExpired ? "bg-[var(--brand-glow)] border-[var(--brand-primary)] text-[var(--text-primary)] shadow-sm" : "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                Vigentes (@_giveaways.Count(g => !g.IsExpired))
            </button>
            <button type="button"
                    @onclick="() => ToggleExpiredFilter(true)"
                    class="px-3 py-1.5 rounded-lg text-xs font-bold border transition-colors @(_includeExpired ? "bg-[var(--brand-glow)] border-[var(--brand-primary)] text-[var(--text-primary)] shadow-sm" : "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                Incluir Finalizados
            </button>

            <span class="text-[var(--border-subtle)]">|</span>

            @* Filtro territorial *@
            <button type="button"
                    @onclick="() => SetCountryFilter(null)"
                    class="px-3 py-1.5 rounded-lg text-xs font-bold border transition-colors @(string.IsNullOrWhiteSpace(_countryFilter) ? "bg-[var(--brand-primary)] text-[var(--on-brand)] shadow-sm" : "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                <Icon Name="globe" Size="12" /> Global (Todos)
            </button>
            @if (!string.IsNullOrWhiteSpace(_userActiveCountry) && _userActiveCountry != "Internacional")
            {
                <button type="button"
                        @onclick="() => SetCountryFilter(_userActiveCountry)"
                        class="px-3 py-1.5 rounded-lg text-xs font-bold border transition-colors @(_countryFilter == _userActiveCountry ? "bg-[var(--brand-primary)] text-[var(--on-brand)] shadow-sm" : "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                    @CountryCatalog.GetFlag(_userActiveCountry) Solo @_userActiveCountry
                </button>
            }
            <select @bind="_countryFilter"
                    @bind:after="OnCountryDropdownChanged"
                    class="px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]">
                <option value="">Otros países...</option>
                @foreach (var c in CountryCatalog.GetAllCountries())
                {
                    <option value="@c.Name">@c.FlagEmoji @c.Name</option>
                }
            </select>
        </div>

        <span class="text-xs text-[var(--text-muted)]">
            <Icon Name="star" Size="12" /> Sorteos promocionados en cabecera &bull; Internacionales siempre visibles
        </span>
    </div>

    @if (_isLoading)
    {
        <div class="py-16 text-center text-[var(--text-muted)]">
            <div class="inline-block animate-spin mb-2"><Icon Name="dices" Size="30" /></div>
            <p class="text-sm font-semibold">Sintonizando el radar de sorteos...</p>
        </div>
    }
    else if (_giveaways.Count == 0)
    {
        <div class="p-12 text-center rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)]">
            <span class="inline-block mb-3"><Icon Name="radar" Size="40" /></span>
            <h3 class="text-base font-bold text-[var(--text-primary)] mb-1">Sin sorteos registrados</h3>
            <p class="text-xs text-[var(--text-secondary)] max-w-md mx-auto mb-4">
                Actualmente no hay sorteos activos en el radar. ¿Conoces alguno en marcha? ¡Añádelo con un clic!
            </p>
            <button type="button"
                    @onclick="() => _isCreateModalOpen = true"
                    class="px-3 py-1.5 rounded-xl bg-[var(--brand-primary)] hover:opacity-90 text-[var(--on-brand)] font-bold text-xs transition-opacity">
                <Icon Name="plus" Size="12" /> Añadir Sorteo
            </button>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            @foreach (var giveaway in _giveaways)
            {
                <GiveawayCard Giveaway="@giveaway"
                              CanModerate="@IsModerator"
                              OnTogglePromoted="@HandleTogglePromoted" />
            }
        </div>
    }
</div>

@* Modal de Proponer / Crear Sorteo *@
    <EditorialModal Open="@_isCreateModalOpen"
                    Title="Registrar o Proponer Sorteo"
                    TitleIcon="gift"
                    OnClose="@(() => _isCreateModalOpen = false)">
        <ChildContent>
            <div class="space-y-3 text-xs">
                <div>
                    <label class="font-semibold text-[var(--text-secondary)] block mb-1">Título del Sorteo *</label>
                    <input type="text"
                           @bind="_formTitle"
                           placeholder="Ej. Sorteo Brass Birmingham + Monedas de Metal"
                           class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="font-semibold text-[var(--text-secondary)] block mb-1">Organizador (Editorial / Tienda) *</label>
                        <input type="text"
                               @bind="_formOrganizer"
                               placeholder="Ej. Maldito Games"
                               class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
                    </div>
                    <div>
                        <label class="font-semibold text-[var(--text-secondary)] block mb-1">Colaborador (Influencer / Canal)</label>
                        <input type="text"
                               @bind="_formCollaborator"
                               placeholder="Ej. Análisis Parálisis"
                               class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
                    </div>
                </div>

                <div>
                    <label class="font-semibold text-[var(--text-secondary)] block mb-1">Enlace Oficial al Sorteo *</label>
                    <input type="url"
                           @bind="_formUrl"
                           placeholder="https://www.instagram.com/p/..."
                           class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
                </div>

                <div>
                    <label class="font-semibold text-[var(--text-secondary)] block mb-1">URL de Imagen de Portada (Opcional)</label>
                    <input type="url"
                           @bind="_formThumbnailUrl"
                           placeholder="https://... o /images/..."
                           class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="font-semibold text-[var(--text-secondary)] block mb-1">País / Ámbito Territorial</label>
                        <select @bind="_formCountry"
                                class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]">
                            <option value="Internacional">Internacional (Válido para todos)</option>
                            @foreach (var c in CountryCatalog.GetAllCountries())
                            {
                                <option value="@c.Name">@c.FlagEmoji @c.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="font-semibold text-[var(--text-secondary)] block mb-1">Plataforma</label>
                        <select @bind="_formPlatform"
                                class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]">
                            <option value="@GiveawayPlatform.Instagram">Instagram</option>
                            <option value="@GiveawayPlatform.TwitterX">Twitter / X</option>
                            <option value="@GiveawayPlatform.YouTube">YouTube</option>
                            <option value="@GiveawayPlatform.Community">Comunidad Ludeka</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="font-semibold text-[var(--text-secondary)] block mb-1">Días hasta fin de sorteo</label>
                        <input type="number"
                               @bind="_formDaysUntilEnd"
                               min="1"
                               max="60"
                               class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                    </div>
                </div>

                <div class="flex items-center gap-2 pt-2">
                    <input type="checkbox"
                           id="commExcl"
                           @bind="_formIsCommunityExclusive"
                           class="rounded bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--brand-primary)] focus:ring-0" />
                    <label for="commExcl" class="text-[var(--text-secondary)] font-medium cursor-pointer">
                        Sorteo exclusivo para miembros de la comunidad Ludeka
                    </label>
                </div>

                @if (IsModerator)
                {
                    <div class="flex items-center gap-2 p-2.5 rounded-xl bg-[var(--state-warning-bg)] border border-[var(--state-warning-border)]">
                        <input type="checkbox"
                               id="isPromotedInput"
                               @bind="_formIsPromoted"
                               class="rounded bg-[var(--bg-surface-elevated)] border-[var(--state-warning-border)] text-[var(--state-warning)] focus:ring-0" />
                        <label for="isPromotedInput" class="text-[var(--state-warning)] font-bold cursor-pointer">
                            Destacar como Sorteo Promocionado en cabecera
                        </label>
                    </div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(_formError))
            {
                <div class="p-2.5 rounded-xl bg-[var(--state-error-bg)] border border-[var(--state-error-border)] text-[var(--state-error)] text-xs">
                    @_formError
                </div>
            }
        </ChildContent>

        <Footer>
                <button type="button"
                        @onclick="() => _isCreateModalOpen = false"
                        class="px-4 py-2 rounded-xl border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] text-xs font-bold transition-colors">
                    Cancelar
                </button>
                <button type="button"
                        @onclick="HandleSubmitGiveaway"
                        class="px-4 py-2 rounded-xl bg-[var(--brand-primary)] hover:opacity-90 text-[var(--on-brand)] text-xs font-bold transition-opacity">
                    Guardar y Publicar
                </button>
        </Footer>
    </EditorialModal>

    <SocialExpressIngestModal IsOpen="_isExpressModalOpen"
                              OnClose="() => _isExpressModalOpen = false"
                              OnItemCreated="HandleExpressItemCreated" />

@code {
    private bool _includeExpired;
    private bool _isLoading = true;
    private IReadOnlyList<GiveawayDto> _giveaways = new List<GiveawayDto>();
    private string? _userActiveCountry;
    private string? _countryFilter;

    private bool _isExpressModalOpen;
    private bool _isCreateModalOpen;
    private string _formTitle = string.Empty;
    private string _formOrganizer = string.Empty;
    private string? _formCollaborator;
    private string _formUrl = string.Empty;
    private string? _formThumbnailUrl;
    private string _formCountry = "Internacional";
    private GiveawayPlatform _formPlatform = GiveawayPlatform.Instagram;
    private int _formDaysUntilEnd = 5;
    private bool _formIsCommunityExclusive;
    private bool _formIsPromoted;
    private string? _formError;

    private bool IsModerator => CurrentUserService.IsFoundingTeam || CurrentUserService.IsInRole("Moderator");

    protected override async Task OnInitializedAsync()
    {
        _userActiveCountry = await LocationService.GetEffectiveCountryAsync();
        _countryFilter = _userActiveCountry;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _giveaways = await GiveawayService.GetGiveawaysAsync(_includeExpired, _countryFilter);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ToggleExpiredFilter(bool includeExpired)
    {
        _includeExpired = includeExpired;
        await LoadDataAsync();
    }

    private async Task SetCountryFilter(string? country)
    {
        _countryFilter = country;
        await LoadDataAsync();
    }

    private async Task OnCountryDropdownChanged()
    {
        await LoadDataAsync();
    }

    private async Task HandleTogglePromoted(Guid giveawayId)
    {
        var target = _giveaways.FirstOrDefault(g => g.Id == giveawayId);
        if (target == null) return;

        bool newPromoted = !target.IsPromoted;
        await GiveawayService.SetPromotedAsync(giveawayId, newPromoted);
        await LoadDataAsync();
    }

    private async Task HandleSubmitGiveaway()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_formTitle))
        {
            _formError = "El título del sorteo es obligatorio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_formOrganizer))
        {
            _formError = "El organizador es obligatorio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_formUrl))
        {
            _formError = "El enlace oficial del sorteo es obligatorio.";
            return;
        }

        var deadline = DateTimeOffset.UtcNow.AddDays(_formDaysUntilEnd);

        var request = new CreateGiveawayRequest(
            Title: _formTitle,
            Organizer: _formOrganizer,
            Collaborator: _formCollaborator,
            Url: _formUrl,
            Platform: _formPlatform,
            DeadlineAt: deadline,
            ThumbnailUrl: string.IsNullOrWhiteSpace(_formThumbnailUrl) ? null : _formThumbnailUrl.Trim(),
            IsCommunityExclusive: _formIsCommunityExclusive,
            IsPromoted: IsModerator && _formIsPromoted,
            Country: _formCountry);

        await GiveawayService.CreateOrMergeGiveawayAsync(request);

        _isCreateModalOpen = false;
        _formTitle = string.Empty;
        _formOrganizer = string.Empty;
        _formCollaborator = null;
        _formUrl = string.Empty;
        _formThumbnailUrl = null;
        _formCountry = "Internacional";
        _formIsCommunityExclusive = false;
        _formIsPromoted = false;

        await LoadDataAsync();
    }

    private async Task HandleExpressItemCreated(Ludeka.Application.DTOs.SocialInboxItemDto item)
    {
        _isExpressModalOpen = false;
        await LoadDataAsync();
    }
}
