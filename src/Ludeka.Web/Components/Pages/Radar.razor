@page "/sorteos"
@page "/radar"
@rendermode InteractiveServer
@implements IDisposable
@using Ludeka.Application.Contracts
@using Ludeka.Application.DTOs
@using Ludeka.Core.Enums
@using Ludeka.Core.ValueObjects
@inject IGiveawayService GiveawayService
@inject IPriceRadarService PriceRadarService
@inject IAffiliateUrlResolver AffiliateResolver
@inject ICurrentUserService CurrentUserService
@inject IStaffActionService StaffActionService
@inject IUserLocationService LocationService
@inject NavigationManager Navigation

<PageTitle>@(_currentTab == RadarTab.Deals ? "Radar de Ofertas y Mínimos Históricos" : "Radar de Sorteos") — Ludeka</PageTitle>

@* Cabecera accesible que preserva el contrato editorial del sistema *@
<div class="sr-only">
    <PageHeaderEditorial Badge="Radar Comunitario"
                         BadgeIcon="gift"
                         Subtitle="@(_currentTab == RadarTab.Deals ? "Detección inteligente de bajadas de precio, mínimos históricos y alertas en tiendas especializadas en español." : "Oportunidades lúdicas verificadas sin spam. Sorteos activos en Instagram, YouTube y redes con alertas de expiración y destacados oficiales.")">
        <Title>@(_currentTab == RadarTab.Deals ? "Radar de Ofertas y Mínimos" : "Sorteos de Juegos de Mesa")</Title>
    </PageHeaderEditorial>
</div>

@* HERO MOSTAZA EDITORIAL DE CLAUDE DESIGN *@
<section data-screen-label="Sorteos" class="bg-[#FFC145] text-[#22180F] border-b-[3px] border-[var(--rule)]">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-8 lg:px-12 py-8 sm:py-14 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <div class="lg:col-span-7 flex flex-col gap-5 sm:gap-6">
            <span class="text-xs sm:text-[13px] font-extrabold uppercase tracking-[0.18em] text-[#22180F]/90 flex items-center gap-2">
                <Icon Name="radar" Size="14" />
                <span>Radar comunitario · @(_giveaways.Count(g => !g.IsExpired)) vigentes</span>
            </span>

            <h1 class="text-5xl sm:text-7xl lg:text-[88px] font-extrabold font-sans leading-[0.88] tracking-[-0.055em] m-0">
                Sorteos<br>de juegos<br><i class="text-[#B23A12] italic">de mesa</i>
            </h1>

            <p class="text-sm sm:text-base leading-relaxed max-w-[520px] opacity-90 m-0">
                Oportunidades lúdicas verificadas sin spam. Sorteos activos en Instagram, YouTube y redes con alertas de expiración y destacados oficiales.
            </p>

            <div class="flex flex-wrap items-center gap-3 pt-2">
                <button type="button"
                        @onclick="OpenCreateGiveawayModal"
                        class="h-12 sm:h-[52px] px-6 rounded-full bg-[#22180F] text-[#FFC145] font-extrabold text-xs sm:text-sm hover:opacity-95 transition-opacity flex items-center gap-2 shadow-sm">
                    <Icon Name="plus" Size="16" />
                    <span>Proponer sorteo</span>
                </button>
                <button type="button"
                        @onclick="() => SwitchTab(_currentTab == RadarTab.Deals ? RadarTab.Giveaways : RadarTab.Deals)"
                        class="h-12 sm:h-[52px] px-6 rounded-full border-2 border-[#22180F] bg-transparent text-[#22180F] font-extrabold text-xs sm:text-sm hover:bg-[#22180F]/5 transition-colors">
                    @(_currentTab == RadarTab.Deals ? "Ver sorteos activos" : "Ver ofertas y mínimos")
                </button>
            </div>
        </div>

        @* Polaroid física destacada a la derecha *@
        @if (FeaturedGiveaway != null)
        {
            var featured = FeaturedGiveaway;
            <div class="lg:col-span-5 flex justify-center lg:justify-end">
                <a href="/sorteos/@featured.Id"
                   class="relative w-full max-w-[380px] bg-[#FFF8EE] text-[#22180F] p-4 pb-6 rounded shadow-[0_24px_40px_rgba(34,24,15,0.25)] rotate-[2.5deg] hover:rotate-[0.5deg] transition-transform duration-300 flex flex-col gap-3 group">
                    <div class="w-full aspect-square bg-[#EFE4D6] rounded-sm overflow-hidden relative">
                        @if (!string.IsNullOrWhiteSpace(featured.ThumbnailUrl))
                        {
                            <img src="@featured.ThumbnailUrl"
                                 alt="@featured.Title"
                                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                        }
                        else
                        {
                            <DefaultImage Domain="DefaultImageDomain.Sorteo"
                                          Alt="@featured.Title"
                                          CssClass="w-full h-full object-cover" />
                        }
                    </div>

                    <div class="flex flex-wrap justify-between items-end gap-2 pt-1">
                        <div class="flex flex-col gap-0.5 min-w-0 flex-1">
                            <span class="text-[11px] font-black uppercase tracking-[0.12em] text-[#B23A12]">
                                @featured.RemainingTimeText
                            </span>
                            <b class="text-xl sm:text-2xl tracking-tight leading-tight line-clamp-1">
                                @featured.Title
                            </b>
                            <span class="text-xs text-[#6B5848] truncate">
                                @featured.Organizer · @CountryCatalog.GetFlag(featured.Country) @(featured.IsInternational ? "Internacional" : featured.Country)
                            </span>
                        </div>
                        <b class="text-2xl font-mono tabular-nums text-[#22180F] shrink-0 inline-flex items-center gap-1">
                            <Icon Name="clock" Size="16" />
                            <span>@featured.RemainingTimeText</span>
                        </b>
                    </div>

                    <span class="h-11 rounded-full bg-[#C9481C] text-[#FFF8EE] font-extrabold flex items-center justify-center text-xs sm:text-sm shadow group-hover:bg-[#B23A12] transition-colors">
                        Participar ↗
                    </span>

                    @* Sello cinta adhesiva decorativa *@
                    <span class="absolute left-1/2 -top-3 -translate-x-1/2 -rotate-3 w-28 h-6 bg-[rgba(201,72,28,0.85)] pointer-events-none"></span>
                </a>
            </div>
        }
    </div>
</section>

@* SUB-BARRA DE PESTAÑAS Y FILTROS *@
<div class="border-b-[3px] border-[var(--rule)] bg-[var(--paper)]">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-8 lg:px-12 py-3.5 flex flex-wrap justify-between items-center gap-4 text-xs sm:text-sm font-extrabold">
        @* Pestañas principales tipo píldora *@
        <div class="flex items-center gap-2 p-1 rounded-full bg-[var(--paper-2)]" role="tablist" aria-label="Secciones del radar">
            <button type="button"
                    role="tab"
                    id="tab-giveaways"
                    aria-selected="@(_currentTab == RadarTab.Giveaways)"
                    aria-controls="panel-giveaways"
                    @onclick="() => SwitchTab(RadarTab.Giveaways)"
                    class="h-10 px-5 rounded-full font-extrabold text-xs sm:text-sm transition-all @(_currentTab == RadarTab.Giveaways ? "bg-[var(--inverse)] text-[var(--on-inverse)] shadow-xs" : "bg-transparent text-[var(--muted)] hover:text-[var(--ink)]")">
                <span>Sorteos vigentes</span>
                <span class="ml-1.5 opacity-80">(@_giveaways.Count(g => !g.IsExpired))</span>
            </button>
            <button type="button"
                    role="tab"
                    id="tab-deals"
                    aria-selected="@(_currentTab == RadarTab.Deals)"
                    aria-controls="panel-deals"
                    @onclick="() => SwitchTab(RadarTab.Deals)"
                    class="h-10 px-5 rounded-full font-extrabold text-xs sm:text-sm transition-all @(_currentTab == RadarTab.Deals ? "bg-[var(--inverse)] text-[var(--on-inverse)] shadow-xs" : "bg-transparent text-[var(--muted)] hover:text-[var(--ink)]")">
                <span>Ofertas &amp; Mínimos Históricos</span>
                <span class="ml-1.5 opacity-80">(@_topDeals.Count)</span>
            </button>
        </div>

        @* Filtros a la derecha según la pestaña *@
        @if (_currentTab == RadarTab.Giveaways)
        {
            <div class="flex items-center flex-wrap gap-3 sm:gap-5 text-xs sm:text-sm">
                <button type="button"
                        @onclick="() => ToggleExpiredFilter(false)"
                        class="pb-1 font-extrabold border-b-[3px] transition-colors @(!_includeExpired ? "text-[var(--ink)] border-[var(--ink)]" : "text-[var(--muted)] border-transparent hover:text-[var(--ink)]")">
                    Vigentes
                </button>
                <button type="button"
                        @onclick="() => ToggleExpiredFilter(true)"
                        class="pb-1 font-extrabold border-b-[3px] transition-colors @(_includeExpired ? "text-[var(--ink)] border-[var(--ink)]" : "text-[var(--muted)] border-transparent hover:text-[var(--ink)]")">
                    Todos
                </button>

                <span class="w-[1px] h-4 bg-[var(--line)]"></span>

                <button type="button"
                        @onclick="() => SetCountryFilter(null)"
                        class="pb-1 font-extrabold border-b-[3px] transition-colors @(string.IsNullOrWhiteSpace(_countryFilter) ? "text-[var(--ink)] border-[var(--ink)]" : "text-[var(--muted)] border-transparent hover:text-[var(--ink)]")">
                    Global
                </button>
                @if (!string.IsNullOrWhiteSpace(_userActiveCountry) && _userActiveCountry != "Internacional")
                {
                    <button type="button"
                            @onclick="() => SetCountryFilter(_userActiveCountry)"
                            class="pb-1 font-extrabold border-b-[3px] transition-colors @(_countryFilter == _userActiveCountry ? "text-[var(--ink)] border-[var(--ink)]" : "text-[var(--muted)] border-transparent hover:text-[var(--ink)]")">
                        @CountryCatalog.GetFlag(_userActiveCountry) Solo @_userActiveCountry
                    </button>
                }
                <select @bind="_countryFilter"
                        @bind:after="OnCountryDropdownChanged"
                        class="px-2.5 py-1 rounded-full text-xs font-bold bg-[var(--paper-2)] border border-[var(--line)] text-[var(--ink)] focus:outline-none">
                    <option value="">Otros países...</option>
                    @foreach (var c in CountryCatalog.GetAllCountries())
                    {
                        <option value="@c.Name">@c.FlagEmoji @c.Name</option>
                    }
                </select>
            </div>
        }
        else
        {
            <div class="flex items-center flex-wrap gap-3 sm:gap-4 text-xs">
                <button type="button"
                        @onclick="() => ToggleOnlyAllTimeLows(false)"
                        class="pb-1 font-extrabold border-b-[3px] transition-colors @(!_onlyAllTimeLows ? "text-[var(--ink)] border-[var(--ink)]" : "text-[var(--muted)] border-transparent hover:text-[var(--ink)]")">
                    Todas las ofertas
                </button>
                <button type="button"
                        @onclick="() => ToggleOnlyAllTimeLows(true)"
                        class="pb-1 font-extrabold border-b-[3px] transition-colors @(_onlyAllTimeLows ? "text-[var(--ink)] border-[var(--ink)]" : "text-[var(--muted)] border-transparent hover:text-[var(--ink)]")">
                    Solo mínimos históricos
                </button>
                <span class="w-[1px] h-4 bg-[var(--line)]"></span>
                <span class="text-[var(--muted)] hidden md:inline">
                    Monitorización continua de tiendas especializadas
                </span>
            </div>
        }
    </div>
</div>

@* CONTENIDO DE PESTAÑAS *@
<div class="max-w-[1280px] mx-auto px-4 sm:px-8 lg:px-12 py-8 sm:py-12 flex flex-col">
    @if (_currentTab == RadarTab.Giveaways)
    {
        <div id="panel-giveaways" role="tabpanel" aria-labelledby="tab-giveaways">
            @if (_isLoadingGiveaways)
            {
                <div class="py-20 text-center text-[var(--muted)]">
                    <div class="inline-block animate-spin text-[var(--brand)] mb-3"><Icon Name="dices" Size="36" /></div>
                    <p class="text-sm font-semibold">Sintonizando el radar de sorteos...</p>
                </div>
            }
            else if (_giveaways.Count == 0)
            {
                <div class="p-12 text-center rounded-2xl bg-[var(--card)] border border-[var(--line)] max-w-lg mx-auto">
                    <span class="inline-block mb-3 text-[var(--muted)]"><Icon Name="radar" Size="40" /></span>
                    <h3 class="text-base font-black text-[var(--ink)] mb-1">Sin sorteos registrados</h3>
                    <p class="text-xs text-[var(--muted)] mb-5">
                        Actualmente no hay sorteos activos en el radar con estos filtros. ¿Conoces alguno en marcha?
                    </p>
                    <button type="button"
                            @onclick="() => _isCreateModalOpen = true"
                            class="h-10 px-5 rounded-full bg-[var(--brand)] text-[var(--on-brand)] font-extrabold text-xs inline-flex items-center gap-1.5 shadow-sm">
                        <Icon Name="plus" Size="14" />
                        <span>Añadir sorteo</span>
                    </button>
                </div>
            }
            else
            {
                @* Listado editorial de sorteos *@
                <div class="flex flex-col divide-y divide-[var(--line)]">
                    @foreach (var s in PagedGiveaways)
                    {
                        var (leftN, leftU, leftColor) = GetCountdownDisplay(s);
                        var rotation = (s.Id.GetHashCode() % 3) switch { 0 => "-rotate-1", 1 => "rotate-2", _ => "-rotate-2" };

                        @* Versión Móvil *@
                        <div class="flex sm:hidden items-center gap-3 py-3.5 @(s.IsExpired ? "opacity-60" : "")">
                            <a href="/sorteos/@s.Id" class="shrink-0 w-[60px] h-[60px] rounded overflow-hidden shadow-xs border border-black/5 @rotation">
                                @if (!string.IsNullOrWhiteSpace(s.ThumbnailUrl))
                                {
                                    <img src="@s.ThumbnailUrl" alt="@s.Title" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <DefaultImage Domain="DefaultImageDomain.Sorteo" Alt="@s.Title" CssClass="w-full h-full object-cover" />
                                }
                            </a>
                            <a href="/sorteos/@s.Id" class="flex-1 min-w-0 flex flex-col gap-0.5">
                                <b class="text-sm font-black text-[var(--ink)] leading-snug truncate block">@s.Title</b>
                                <span class="text-xs text-[var(--muted)] truncate">@s.Platform · @CountryCatalog.GetFlag(s.Country) @(s.IsInternational ? "Internacional" : s.Country)</span>
                                <b class="text-xs tabular-nums font-black inline-flex items-center gap-1" style="color: @leftColor">
                                    <Icon Name="clock" Size="11" />
                                    <span>@s.RemainingTimeText</span>
                                </b>
                            </a>
                            @if (IsModerator)
                            {
                                <button type="button"
                                        @onclick="() => OpenEditGiveawayModal(s)"
                                        title="Editar sorteo"
                                        aria-label="Editar sorteo"
                                        class="w-10 h-10 shrink-0 rounded-full border border-dashed border-[var(--accent)] text-[var(--accent)] font-bold text-xs flex items-center justify-center hover:bg-[var(--paper-2)]">
                                    ✎
                                </button>
                            }
                            <a href="@s.Url"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="w-10 h-10 shrink-0 rounded-full bg-[#C9481C] text-[#FFF8EE] font-black text-sm flex items-center justify-center hover:opacity-90 transition-opacity">
                                ↗
                            </a>
                        </div>

                        @* Versión Desktop *@
                        <div class="hidden sm:flex flex-wrap items-center gap-4 lg:gap-6 py-4.5 @(s.IsExpired ? "opacity-60" : "")">
                            @* Cuenta atrás gigante *@
                            <div class="w-24 shrink-0 flex flex-col leading-none">
                                <b class="text-3xl lg:text-4xl font-black tracking-[-0.05em] tabular-nums" style="color: @leftColor">
                                    @leftN
                                </b>
                                <span class="text-[11px] font-black uppercase text-[var(--muted)] tracking-wider mt-0.5">
                                    @leftU
                                </span>
                            </div>

                            @* Carátula rotada *@
                            <a href="/sorteos/@s.Id" class="w-20 h-20 lg:w-22 lg:h-22 shrink-0 rounded overflow-hidden shadow-xs border border-black/5 @rotation group-hover:scale-105 transition-transform duration-300">
                                @if (!string.IsNullOrWhiteSpace(s.ThumbnailUrl))
                                {
                                    <img src="@s.ThumbnailUrl" alt="@s.Title" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <DefaultImage Domain="DefaultImageDomain.Sorteo" Alt="@s.Title" CssClass="w-full h-full object-cover" />
                                }
                            </a>

                            @* Metadatos e Información *@
                            <div class="flex-1 min-w-[200px] flex flex-col gap-1">
                                <div class="flex items-center gap-2">
                                    @if (s.IsPromoted)
                                    {
                                        <span class="px-2 py-0.5 rounded-full bg-[#FFC145] text-[#22180F] text-[10px] font-black flex items-center gap-1 shadow-xs">
                                            <Icon Name="star" Size="10" /> Promocionado
                                        </span>
                                    }
                                    @if (s.IsCommunityExclusive)
                                    {
                                        <span class="px-2 py-0.5 rounded-full bg-[var(--brand)] text-[var(--on-brand)] text-[10px] font-black">
                                            Exclusivo
                                        </span>
                                    }
                                </div>
                                <a href="/sorteos/@s.Id" class="text-lg lg:text-xl font-black text-[var(--ink)] tracking-tight leading-snug hover:text-[var(--accent)] transition-colors block">
                                    @s.Title
                                </a>
                                <div class="text-xs text-[var(--muted)] flex items-center gap-2 flex-wrap font-medium">
                                    <span>@s.Organizer</span>
                                    <span>·</span>
                                    <span>@s.Platform</span>
                                    <span>·</span>
                                    <span>@CountryCatalog.GetFlag(s.Country) @(s.IsInternational ? "Internacional" : s.Country)</span>
                                    <span>·</span>
                                    <a href="/sorteos/@s.Id" class="underline text-[var(--ink)] font-bold">Ver detalles</a>
                                </div>
                            </div>

                            @* Acciones *@
                            <div class="flex items-center gap-2 shrink-0">
                                @if (IsModerator)
                                {
                                    <button type="button"
                                            @onclick="() => OpenEditGiveawayModal(s)"
                                            title="Editar sorteo"
                                            aria-label="Editar sorteo"
                                            class="w-10 h-10 rounded-full border border-dashed border-[var(--accent)] text-[var(--accent)] font-bold text-xs flex items-center justify-center hover:bg-[var(--paper-2)]">
                                        ✎
                                    </button>
                                }
                                <a href="@s.Url"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="h-11 px-5 rounded-full bg-[#C9481C] text-[#FFF8EE] font-extrabold text-xs lg:text-sm hover:opacity-90 transition-opacity inline-flex items-center gap-1.5 shadow-xs">
                                    <span>Participar</span>
                                    <span>↗</span>
                                </a>
                            </div>
                        </div>
                    }
                </div>

                @* Paginación accesible de sorteos *@
                @if (TotalGiveawayPages > 1)
                {
                    <nav class="flex items-center justify-center gap-2 pt-8" aria-label="Paginación de sorteos">
                        <button type="button"
                                @onclick="() => SetGiveawayPage(_giveawayPage - 1)"
                                disabled="@(_giveawayPage <= 1)"
                                class="min-h-[44px] min-w-[44px] px-3.5 rounded-full border border-[var(--rule)] bg-[var(--card)] text-[var(--ink)] font-extrabold text-xs disabled:opacity-30 disabled:cursor-not-allowed hover:bg-[var(--paper-2)] transition-colors inline-flex items-center justify-center gap-1"
                                aria-label="Página anterior de sorteos">
                            &larr; <span class="hidden sm:inline">Anterior</span>
                        </button>

                        @foreach (var pageNumber in GetVisiblePageNumbers(_giveawayPage, TotalGiveawayPages))
                        {
                            if (pageNumber == -1)
                            {
                                <span class="px-2 text-[var(--muted)] font-black select-none">…</span>
                            }
                            else
                            {
                                var isCurrent = pageNumber == _giveawayPage;
                                <button type="button"
                                        @onclick="() => SetGiveawayPage(pageNumber)"
                                        class="min-h-[44px] min-w-[44px] px-3.5 rounded-full text-xs font-black transition-all @(isCurrent ? "bg-[var(--brand)] text-[var(--on-brand)] shadow-xs" : "bg-[var(--card)] border border-[var(--rule)] text-[var(--ink)] hover:bg-[var(--paper-2)]")"
                                        aria-current="@(isCurrent ? "page" : null)"
                                        aria-label="@($"Ir a página {pageNumber}")">
                                    @pageNumber
                                </button>
                            }
                        }

                        <button type="button"
                                @onclick="() => SetGiveawayPage(_giveawayPage + 1)"
                                disabled="@(_giveawayPage >= TotalGiveawayPages)"
                                class="min-h-[44px] min-w-[44px] px-3.5 rounded-full border border-[var(--rule)] bg-[var(--card)] text-[var(--ink)] font-extrabold text-xs disabled:opacity-30 disabled:cursor-not-allowed hover:bg-[var(--paper-2)] transition-colors inline-flex items-center justify-center gap-1"
                                aria-label="Página siguiente de sorteos">
                            <span class="hidden sm:inline">Siguiente</span> &rarr;
                        </button>
                    </nav>
                }
            }
        </div>
    }
    else
    {
        @* Pestaña de Ofertas y Mínimos Históricos *@
        <div id="panel-deals" role="tabpanel" aria-labelledby="tab-deals">
            @if (_isLoadingDeals)
            {
                <div class="py-20 text-center text-[var(--muted)]">
                    <div class="inline-block animate-spin text-[var(--brand)] mb-3"><Icon Name="dices" Size="36" /></div>
                    <p class="text-sm font-semibold">Sintonizando el radar de ofertas y bajadas de precio...</p>
                </div>
            }
            else if (FilteredDeals.Count == 0)
            {
                <div class="p-12 text-center rounded-2xl bg-[var(--card)] border border-[var(--line)] max-w-lg mx-auto">
                    <span class="inline-block mb-3 text-[var(--muted)]"><Icon Name="trending-down" Size="40" /></span>
                    <h3 class="text-base font-black text-[var(--ink)] mb-1">Sin bajadas de precio recientes</h3>
                    <p class="text-xs text-[var(--muted)] mb-5">
                        No hay ofertas registradas que superen el umbral de descuento para este filtro.
                    </p>
                    @if (!string.IsNullOrWhiteSpace(_countryFilter))
                    {
                        <button type="button"
                                @onclick="() => SetCountryFilter(null)"
                                class="h-10 px-5 rounded-full bg-[var(--brand)] text-[var(--on-brand)] font-extrabold text-xs shadow-sm">
                            Ver ofertas internacionales
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="flex flex-col divide-y divide-[var(--line)]">
                    @foreach (var deal in PagedDeals)
                    {
                        var targetPurchaseUrl = AffiliateResolver.ResolveAffiliateUrl(deal.AffiliateUrl, deal.StoreName);
                        <div class="flex flex-wrap items-center gap-4 sm:gap-6 py-4 hover:bg-[var(--paper-2)]/40 transition-colors px-1">
                            @* Descuento en verde gigante *@
                            <span class="w-20 sm:w-24 text-2xl sm:text-[34px] font-black tracking-[-0.05em] text-[#1B7D52] tabular-nums shrink-0 leading-none">
                                @(deal.DiscountPercentage > 0 ? $"-{deal.DiscountPercentage:0.#}%" : "OFERTA")
                            </span>

                            @* Carátula del juego *@
                            <a href="/juegos/@deal.GameSlug" class="w-16 h-16 sm:w-18 sm:h-18 shrink-0 rounded overflow-hidden shadow-xs border border-black/5 bg-[var(--paper-2)]">
                                @if (!string.IsNullOrWhiteSpace(deal.GameCoverUrl))
                                {
                                    <img src="@deal.GameCoverUrl" alt="@deal.GameTitle" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <img src="/images/game-placeholder.svg" alt="@deal.GameTitle" class="w-full h-full object-cover opacity-80" />
                                }
                            </a>

                            @* Título y metadatos de tienda *@
                            <div class="flex-1 min-w-[200px] flex flex-col gap-1">
                                <a href="/juegos/@deal.GameSlug" class="text-base sm:text-lg font-black text-[var(--ink)] tracking-tight leading-snug hover:text-[var(--accent)] transition-colors block">
                                    @deal.GameTitle
                                </a>
                                <div class="text-xs text-[var(--muted)] flex items-center gap-2">
                                    <span class="font-bold text-[var(--ink)]">@deal.StoreName</span>
                                    @if (!string.IsNullOrWhiteSpace(deal.Country))
                                    {
                                        <span>·</span>
                                        <span>@CountryCatalog.GetFlag(deal.Country) @deal.Country</span>
                                    }
                                    @if (deal.IsAllTimeLow)
                                    {
                                        <span class="px-2 py-0.5 rounded-full bg-[#E5F7ED] text-[#1B7D52] font-black text-[10px]">
                                            Mínimo histórico
                                        </span>
                                    }
                                </div>
                            </div>

                            @* Precios *@
                            <div class="flex flex-col items-end shrink-0">
                                <b class="text-xl sm:text-2xl font-black text-[var(--ink)] tabular-nums">@deal.FormattedCurrentPrice</b>
                                @if (deal.ReferencePrice.HasValue)
                                {
                                    <s class="text-xs text-[var(--muted)] line-through">@deal.FormattedReferencePrice</s>
                                }
                            </div>

                            @* Botones CTA *@
                            <div class="flex items-center gap-2 shrink-0">
                                <a href="@targetPurchaseUrl"
                                   target="_blank"
                                   rel="noopener noreferrer sponsored"
                                   class="h-10 px-4 rounded-full bg-[var(--brand)] text-[var(--on-brand)] font-extrabold text-xs inline-flex items-center gap-1.5 hover:opacity-90 shadow-xs">
                                    <span>Ver en tienda</span>
                                    <span>↗</span>
                                </a>
                            </div>
                        </div>
                    }
                </div>

                @* Paginación accesible de ofertas *@
                @if (TotalDealsPages > 1)
                {
                    <nav class="flex items-center justify-center gap-2 pt-8" aria-label="Paginación de ofertas">
                        <button type="button"
                                @onclick="() => SetDealsPage(_dealsPage - 1)"
                                disabled="@(_dealsPage <= 1)"
                                class="min-h-[44px] min-w-[44px] px-3.5 rounded-full border border-[var(--rule)] bg-[var(--card)] text-[var(--ink)] font-extrabold text-xs disabled:opacity-30 disabled:cursor-not-allowed hover:bg-[var(--paper-2)] transition-colors inline-flex items-center justify-center gap-1"
                                aria-label="Página anterior de ofertas">
                            &larr; <span class="hidden sm:inline">Anterior</span>
                        </button>

                        @foreach (var pageNumber in GetVisiblePageNumbers(_dealsPage, TotalDealsPages))
                        {
                            if (pageNumber == -1)
                            {
                                <span class="px-2 text-[var(--muted)] font-black select-none">…</span>
                            }
                            else
                            {
                                var isCurrent = pageNumber == _dealsPage;
                                <button type="button"
                                        @onclick="() => SetDealsPage(pageNumber)"
                                        class="min-h-[44px] min-w-[44px] px-3.5 rounded-full text-xs font-black transition-all @(isCurrent ? "bg-[var(--brand)] text-[var(--on-brand)] shadow-xs" : "bg-[var(--card)] border border-[var(--rule)] text-[var(--ink)] hover:bg-[var(--paper-2)]")"
                                        aria-current="@(isCurrent ? "page" : null)"
                                        aria-label="@($"Ir a página {pageNumber}")">
                                    @pageNumber
                                </button>
                            }
                        }

                        <button type="button"
                                @onclick="() => SetDealsPage(_dealsPage + 1)"
                                disabled="@(_dealsPage >= TotalDealsPages)"
                                class="min-h-[44px] min-w-[44px] px-3.5 rounded-full border border-[var(--rule)] bg-[var(--card)] text-[var(--ink)] font-extrabold text-xs disabled:opacity-30 disabled:cursor-not-allowed hover:bg-[var(--paper-2)] transition-colors inline-flex items-center justify-center gap-1"
                                aria-label="Página siguiente de ofertas">
                            <span class="hidden sm:inline">Siguiente</span> &rarr;
                        </button>
                    </nav>
                }
            }
        </div>
    }

    @* TARJETA INVERSA DE CIERRE: ¿CONOCES OTRO SORTEO? *@
    <div class="mt-12 p-6 sm:p-9 rounded-3xl bg-[var(--inverse)] text-[var(--on-inverse)] flex flex-wrap justify-between items-center gap-5">
        <div class="flex flex-col gap-1.5">
            <b class="text-2xl sm:text-3xl font-black tracking-tight leading-tight m-0">
                ¿Conoces otro <i class="text-[#FFC145] font-serif not-italic italic">sorteo?</i>
            </b>
            <span class="text-xs sm:text-sm opacity-80">Compártelo con la comunidad y lo verificamos en el radar oficial.</span>
        </div>
        <button type="button"
                @onclick="() => _isCreateModalOpen = true"
                class="h-11 sm:h-12 px-6 rounded-full bg-[#FFC145] text-[#22180F] font-black text-xs sm:text-sm hover:scale-105 active:scale-95 transition-transform shadow">
            + Proponer sorteo
        </button>
    </div>
</div>

@* Modal de Proponer / Crear / Editar Sorteo *@
<EditorialModal Open="@_isCreateModalOpen"
                Title="@(_editingGiveawayId.HasValue ? "Editar Sorteo" : "Registrar o Proponer Sorteo")"
                TitleIcon="@(_editingGiveawayId.HasValue ? "pen-line" : "gift")"
                OnClose="@(() => _isCreateModalOpen = false)">
    <ChildContent>
        <div class="space-y-3.5 text-xs">
            <div>
                <label class="font-bold text-[var(--ink)] block mb-1">Título del Sorteo *</label>
                <input type="text"
                       @bind="_formTitle"
                       placeholder="Ej. Sorteo Cascadia + Expansión"
                       class="w-full px-3.5 py-2.5 rounded-xl bg-[var(--card)] border border-[var(--rule)] text-[var(--ink)] placeholder-[var(--muted)] focus:outline-none focus:border-[var(--brand)] text-sm" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="font-bold text-[var(--ink)] block mb-1">Organizador (Editorial / Tienda) *</label>
                    <input type="text"
                           @bind="_formOrganizer"
                           placeholder="Ej. Maldito Games"
                           class="w-full px-3.5 py-2.5 rounded-xl bg-[var(--card)] border border-[var(--rule)] text-[var(--ink)] placeholder-[var(--muted)] focus:outline-none focus:border-[var(--brand)] text-sm" />
                </div>
                <div>
                    <label class="font-bold text-[var(--ink)] block mb-1">Colaborador (Canal / Cuenta)</label>
                    <input type="text"
                           @bind="_formCollaborator"
                           placeholder="Ej. Análisis Parálisis"
                           class="w-full px-3.5 py-2.5 rounded-xl bg-[var(--card)] border border-[var(--rule)] text-[var(--ink)] placeholder-[var(--muted)] focus:outline-none focus:border-[var(--brand)] text-sm" />
                </div>
            </div>

            <div>
                <label class="font-bold text-[var(--ink)] block mb-1">Enlace Oficial al Sorteo *</label>
                <input type="url"
                       @bind="_formUrl"
                       placeholder="https://www.instagram.com/p/..."
                       class="w-full px-3.5 py-2.5 rounded-xl bg-[var(--card)] border border-[var(--rule)] text-[var(--ink)] placeholder-[var(--muted)] focus:outline-none focus:border-[var(--brand)] text-sm" />
            </div>

            <div>
                <label class="font-bold text-[var(--ink)] block mb-1">URL de Imagen de Portada (Opcional)</label>
                <input type="url"
                       @bind="_formThumbnailUrl"
                       placeholder="https://... o /images/..."
                       class="w-full px-3.5 py-2.5 rounded-xl bg-[var(--card)] border border-[var(--rule)] text-[var(--ink)] placeholder-[var(--muted)] focus:outline-none focus:border-[var(--brand)] text-sm" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="font-bold text-[var(--ink)] block mb-1">País / Ámbito Territorial</label>
                    <select @bind="_formCountry"
                            class="w-full px-3 py-2.5 rounded-xl bg-[var(--card)] border border-[var(--rule)] text-[var(--ink)] focus:outline-none focus:border-[var(--brand)] text-sm">
                        <option value="Internacional">Internacional (Válido para todos)</option>
                        @foreach (var c in CountryCatalog.GetAllCountries())
                        {
                            <option value="@c.Name">@c.FlagEmoji @c.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="font-bold text-[var(--ink)] block mb-1">Plataforma</label>
                    <select @bind="_formPlatform"
                            class="w-full px-3 py-2.5 rounded-xl bg-[var(--card)] border border-[var(--rule)] text-[var(--ink)] focus:outline-none focus:border-[var(--brand)] text-sm">
                        <option value="@GiveawayPlatform.Instagram">Instagram</option>
                        <option value="@GiveawayPlatform.TwitterX">Twitter / X</option>
                        <option value="@GiveawayPlatform.YouTube">YouTube</option>
                        <option value="@GiveawayPlatform.Community">Comunidad Ludeka</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="font-bold text-[var(--ink)] block mb-1">Días hasta fin de sorteo</label>
                    <input type="number"
                           @bind="_formDaysUntilEnd"
                           min="1"
                           max="60"
                           class="w-full px-3.5 py-2.5 rounded-xl bg-[var(--card)] border border-[var(--rule)] text-[var(--ink)] focus:outline-none focus:border-[var(--brand)] text-sm" />
                </div>
            </div>

            <div class="flex items-center gap-2 pt-1">
                <input type="checkbox"
                       id="commExcl"
                       @bind="_formIsCommunityExclusive"
                       class="rounded bg-[var(--card)] border-[var(--rule)] text-[var(--brand)] focus:ring-0" />
                <label for="commExcl" class="text-[var(--ink)] font-semibold cursor-pointer">
                    Sorteo exclusivo para miembros de la comunidad Ludeka
                </label>
            </div>

            @if (IsModerator)
            {
                <div class="flex items-center gap-2 p-3 rounded-xl bg-[#FFF8EE] border border-[#FFC145] text-[#22180F]">
                    <input type="checkbox"
                           id="isPromotedInput"
                           @bind="_formIsPromoted"
                           class="rounded bg-[var(--card)] border-[#FFC145] text-[#B23A12] focus:ring-0" />
                    <label for="isPromotedInput" class="text-[#22180F] font-bold cursor-pointer">
                        Destacar como Sorteo Promocionado en cabecera
                    </label>
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_formError))
        {
            <div class="p-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs font-semibold mt-3">
                @_formError
            </div>
        }
    </ChildContent>

    <Footer>
        <button type="button"
                @onclick="() => _isCreateModalOpen = false"
                class="px-5 py-2.5 rounded-full border border-[var(--rule)] text-[var(--ink)] hover:bg-[var(--paper-2)] text-xs font-bold transition-colors">
            Cancelar
        </button>
        <button type="button"
                @onclick="HandleSubmitGiveaway"
                class="px-5 py-2.5 rounded-full bg-[var(--brand)] hover:opacity-90 text-[var(--on-brand)] text-xs font-black transition-opacity shadow-xs">
            @(_editingGiveawayId.HasValue ? "Guardar cambios" : "Guardar y Publicar")
        </button>
    </Footer>
</EditorialModal>

<SocialExpressIngestModal IsOpen="_isExpressModalOpen"
                          OnClose="() => _isExpressModalOpen = false"
                          OnItemCreated="HandleExpressItemCreated" />

@code {
    private enum RadarTab
    {
        Deals,
        Giveaways
    }

    private RadarTab _currentTab = RadarTab.Giveaways;
    private bool _onlyAllTimeLows = false;
    private bool _includeExpired;
    private bool _isLoadingGiveaways = true;
    private bool _isLoadingDeals = true;
    private IReadOnlyList<GiveawayDto> _giveaways = [];
    private IReadOnlyList<PriceDropAlertDto> _topDeals = [];
    private string? _userActiveCountry;
    private string? _countryFilter;

    private const int PageSize = 10;
    private int _giveawayPage = 1;
    private int _dealsPage = 1;

    private bool _isExpressModalOpen;
    private bool _isCreateModalOpen;
    private Guid? _editingGiveawayId;
    private string _formTitle = string.Empty;
    private string _formOrganizer = string.Empty;
    private string? _formCollaborator;
    private string _formUrl = string.Empty;
    private string? _formThumbnailUrl;
    private string _formCountry = "Internacional";
    private GiveawayPlatform _formPlatform = GiveawayPlatform.Instagram;
    private int _formDaysUntilEnd = 5;
    private bool _formIsCommunityExclusive;
    private bool _formIsPromoted;
    private string? _formError;

    private bool IsModerator => CurrentUserService.IsFoundingTeam || CurrentUserService.IsInRole("Moderator");

    private GiveawayDto? FeaturedGiveaway =>
        _giveaways.FirstOrDefault(g => g.IsPromoted && !g.IsExpired) ??
        _giveaways.FirstOrDefault(g => !g.IsExpired);

    private int TotalGiveawayPages => Math.Max(1, (int)Math.Ceiling(_giveaways.Count / (double)PageSize));
    private IEnumerable<GiveawayDto> PagedGiveaways => _giveaways.Skip((_giveawayPage - 1) * PageSize).Take(PageSize);

    private List<PriceDropAlertDto> FilteredDeals => _onlyAllTimeLows ? _topDeals.Where(d => d.IsAllTimeLow).ToList() : _topDeals.ToList();
    private int TotalDealsPages => Math.Max(1, (int)Math.Ceiling(FilteredDeals.Count / (double)PageSize));
    private IEnumerable<PriceDropAlertDto> PagedDeals => FilteredDeals.Skip((_dealsPage - 1) * PageSize).Take(PageSize);

    protected override async Task OnInitializedAsync()
    {
        if (Navigation.Uri.Contains("/radar", StringComparison.OrdinalIgnoreCase))
        {
            _currentTab = RadarTab.Deals;
        }
        else
        {
            _currentTab = RadarTab.Giveaways;
        }

        _userActiveCountry = await LocationService.GetEffectiveCountryAsync();
        _countryFilter = _userActiveCountry;
        await LoadAllDataAsync();
        RegisterStaffActions();
    }

    private void RegisterStaffActions()
    {
        if (!IsModerator) return;
        StaffActionService.SetCustomActions(
        [
            new StaffActionItem(
                Label: "+ Alta exprés",
                Icon: "zap",
                OnClick: () =>
                {
                    _isExpressModalOpen = true;
                    StateHasChanged();
                    return Task.CompletedTask;
                })
        ]);
    }

    public void Dispose()
    {
        StaffActionService.ClearCustomActions();
    }

    private async Task LoadAllDataAsync()
    {
        await Task.WhenAll(LoadDealsDataAsync(), LoadGiveawaysDataAsync());
    }

    private async Task LoadDealsDataAsync()
    {
        _isLoadingDeals = true;
        try
        {
            _topDeals = await PriceRadarService.GetTopDiscountsAsync(limit: 60, country: _countryFilter);
        }
        catch
        {
            _topDeals = [];
        }
        finally
        {
            _isLoadingDeals = false;
        }
    }

    private async Task LoadGiveawaysDataAsync()
    {
        _isLoadingGiveaways = true;
        try
        {
            _giveaways = await GiveawayService.GetGiveawaysAsync(_includeExpired, _countryFilter);
        }
        finally
        {
            _isLoadingGiveaways = false;
        }
    }

    private void SwitchTab(RadarTab tab)
    {
        _currentTab = tab;
    }

    private void ToggleOnlyAllTimeLows(bool onlyAllTimeLows)
    {
        _onlyAllTimeLows = onlyAllTimeLows;
        _dealsPage = 1;
    }

    private async Task ToggleExpiredFilter(bool includeExpired)
    {
        _includeExpired = includeExpired;
        _giveawayPage = 1;
        await LoadGiveawaysDataAsync();
    }

    private async Task SetCountryFilter(string? country)
    {
        _countryFilter = country;
        _giveawayPage = 1;
        _dealsPage = 1;
        await LoadAllDataAsync();
    }

    private async Task OnCountryDropdownChanged()
    {
        _giveawayPage = 1;
        _dealsPage = 1;
        await LoadAllDataAsync();
    }

    private void SetGiveawayPage(int page)
    {
        if (page < 1 || page > TotalGiveawayPages) return;
        _giveawayPage = page;
    }

    private void SetDealsPage(int page)
    {
        if (page < 1 || page > TotalDealsPages) return;
        _dealsPage = page;
    }

    private static IEnumerable<int> GetVisiblePageNumbers(int current, int total)
    {
        if (total <= 7)
        {
            return Enumerable.Range(1, total);
        }

        var pages = new List<int> { 1 };

        if (current > 3)
        {
            pages.Add(-1); // Elipsis
        }

        var start = Math.Max(2, current - 1);
        var end = Math.Min(total - 1, current + 1);

        for (var i = start; i <= end; i++)
        {
            pages.Add(i);
        }

        if (current < total - 2)
        {
            pages.Add(-1); // Elipsis
        }

        pages.Add(total);
        return pages;
    }

    private void OpenCreateGiveawayModal()
    {
        _editingGiveawayId = null;
        _formTitle = string.Empty;
        _formOrganizer = string.Empty;
        _formCollaborator = null;
        _formUrl = string.Empty;
        _formThumbnailUrl = null;
        _formCountry = "Internacional";
        _formPlatform = GiveawayPlatform.Instagram;
        _formDaysUntilEnd = 5;
        _formIsCommunityExclusive = false;
        _formIsPromoted = false;
        _formError = null;
        _isCreateModalOpen = true;
    }

    private void OpenEditGiveawayModal(GiveawayDto s)
    {
        _editingGiveawayId = s.Id;
        _formTitle = s.Title;
        _formOrganizer = s.Organizer;
        _formCollaborator = s.Collaborator;
        _formUrl = s.Url;
        _formThumbnailUrl = s.ThumbnailUrl;
        _formCountry = s.Country;
        _formPlatform = s.Platform;
        var daysLeft = Math.Max(1, (int)Math.Ceiling((s.DeadlineAt - DateTimeOffset.UtcNow).TotalDays));
        _formDaysUntilEnd = Math.Min(60, daysLeft);
        _formIsCommunityExclusive = s.IsCommunityExclusive;
        _formIsPromoted = s.IsPromoted;
        _formError = null;
        _isCreateModalOpen = true;
    }

    private async Task HandleSubmitGiveaway()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_formTitle))
        {
            _formError = "El título del sorteo es obligatorio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_formOrganizer))
        {
            _formError = "El organizador es obligatorio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_formUrl))
        {
            _formError = "El enlace oficial del sorteo es obligatorio.";
            return;
        }

        var deadline = DateTimeOffset.UtcNow.AddDays(_formDaysUntilEnd);

        try
        {
            if (_editingGiveawayId.HasValue)
            {
                var updateRequest = new UpdateGiveawayRequest(
                    Id: _editingGiveawayId.Value,
                    Title: _formTitle,
                    Organizer: _formOrganizer,
                    Collaborator: _formCollaborator,
                    Url: _formUrl,
                    Platform: _formPlatform,
                    DeadlineAt: deadline,
                    Country: _formCountry,
                    ThumbnailUrl: string.IsNullOrWhiteSpace(_formThumbnailUrl) ? null : _formThumbnailUrl.Trim(),
                    IsCommunityExclusive: _formIsCommunityExclusive,
                    IsPromoted: IsModerator && _formIsPromoted);

                await GiveawayService.UpdateGiveawayAsync(updateRequest);
            }
            else
            {
                var request = new CreateGiveawayRequest(
                    Title: _formTitle,
                    Organizer: _formOrganizer,
                    Collaborator: _formCollaborator,
                    Url: _formUrl,
                    Platform: _formPlatform,
                    DeadlineAt: deadline,
                    ThumbnailUrl: string.IsNullOrWhiteSpace(_formThumbnailUrl) ? null : _formThumbnailUrl.Trim(),
                    IsCommunityExclusive: _formIsCommunityExclusive,
                    IsPromoted: IsModerator && _formIsPromoted,
                    Country: _formCountry);

                await GiveawayService.CreateOrMergeGiveawayAsync(request);
            }
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
            return;
        }
        catch (Exception ex)
        {
            _formError = "Error al procesar el sorteo: " + ex.Message;
            return;
        }

        _isCreateModalOpen = false;
        _editingGiveawayId = null;
        _formTitle = string.Empty;
        _formOrganizer = string.Empty;
        _formCollaborator = null;
        _formUrl = string.Empty;
        _formThumbnailUrl = null;
        _formCountry = "Internacional";
        _formIsCommunityExclusive = false;
        _formIsPromoted = false;

        await LoadGiveawaysDataAsync();
    }

    private async Task HandleExpressItemCreated(Ludeka.Application.DTOs.SocialInboxItemDto item)
    {
        _isExpressModalOpen = false;
        await LoadGiveawaysDataAsync();
    }

    private static (string Number, string Unit, string Color) GetCountdownDisplay(GiveawayDto giveaway)
    {
        if (giveaway.IsExpired) return ("FIN", "CERRADO", "#B23A12");
        var diff = giveaway.DeadlineAt - DateTimeOffset.UtcNow;
        if (diff.TotalHours <= 0) return ("0", "HORAS", "#B23A12");
        if (diff.TotalDays >= 1)
        {
            var days = (int)Math.Ceiling(diff.TotalDays);
            var color = days <= 2 ? "#B23A12" : "var(--ink)";
            return (days.ToString(), days == 1 ? "DÍA" : "DÍAS", color);
        }
        var hours = (int)Math.Ceiling(diff.TotalHours);
        return (hours.ToString(), hours == 1 ? "HORA" : "HORAS", "#B23A12");
    }
}
