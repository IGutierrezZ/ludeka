@page "/admin/instagram"
@attribute [Authorize(Policy = AuthorizationPolicies.PermisoPublicarInstagram)]
@rendermode InteractiveServer
@using Ludeka.Application.Contracts
@using Ludeka.Application.DTOs
@using Ludeka.Application.Options
@using Ludeka.Core.Entities
@using Ludeka.Core.Enums
@using Microsoft.Extensions.Options
@inject IInstagramPublisherService PublisherService
@inject IGiveawayService GiveawayService
@inject IWeeklyReleaseService ReleaseService
@inject ICurrentUserService CurrentUserService
@inject NavigationManager Navigation
@inject IOptions<InstagramOptions> InstagramOptions
@inject IJSRuntime JS

<PageTitle>Publicador Oficial de Instagram — Ludeka</PageTitle>

<div class="container-ludeka py-8 space-y-8">
    @* Verificación de Autorización y Permisos *@
    @if (!_isAuthorized)
    {
        <div class="p-8 rounded-3xl bg-rose-500/10 border border-rose-500/20 text-center space-y-4 max-w-xl mx-auto my-12">
            <span class="inline-block"><Icon Name="shield" Size="36" /></span>
            <h2 class="text-xl font-black text-[var(--text-primary)]">Acceso Reservado a Moderación</h2>
            <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
                Esta zona requiere el rol de <strong>Mesa Fundadora</strong> o disponer del permiso granular
                <strong>Publicar en Instagram Oficial</strong> (<code>CanPublishInstagram</code>).
            </p>
            <div class="pt-2">
                <a href="/" class="px-4 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs font-bold text-[var(--text-primary)] hover:border-[var(--brand-primary)] transition-colors">
                    &larr; Volver al Inicio
                </a>
            </div>
        </div>
    }
    else
    {
        @* Cabecera Editorial de la Página *@
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-[var(--border-subtle)] pb-6">
            <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--brand-primary)] text-xs font-bold mb-2">
                    <Icon Name="camera" Size="14" /> Automatización Omnicanal & Publicación Directa
                </div>
                <h1 class="text-3xl sm:text-4xl font-black text-[var(--text-primary)] tracking-tight flex items-center gap-3">
                    <span>Publicador de Instagram</span>
                    @if (InstagramOptions.Value.IsConfigured)
                    {
                        <span class="text-xs px-2.5 py-1 rounded-full font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 inline-flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                            <span>Meta API Conectada</span>
                        </span>
                    }
                    else
                    {
                        <span class="text-xs px-2.5 py-1 rounded-full font-bold bg-amber-500/15 text-amber-400 border border-amber-500/30 inline-flex items-center gap-1.5" title="En modo simulado no se requieren credenciales de Meta para publicar">
                            <Icon Name="flask-conical" Size="12" />
                            <span>Modo Simulado Activo</span>
                        </span>
                    }
                </h1>
                <p class="text-sm text-[var(--text-secondary)] mt-1 max-w-2xl">
                    Compón, previsualiza y publica sorteos y novedades lúdicas en la cuenta oficial de Instagram de Ludeka con un solo clic.
                </p>
            </div>

            @* Acciones de Creación Rápida *@
            <div class="flex items-center gap-2 flex-wrap">
                <button type="button"
                        @onclick="() => _isSelectGiveawayModalOpen = true"
                        class="px-3.5 py-2 rounded-xl bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-primary)] border border-[var(--border-subtle)] hover:border-[var(--brand-primary)] font-bold text-xs transition-colors flex items-center gap-1.5 shadow-sm">
                    <Icon Name="gift" Size="14" />
                    <span>Post desde Sorteo</span>
                </button>
                <button type="button"
                        @onclick="() => _isSelectReleaseModalOpen = true"
                        class="px-3.5 py-2 rounded-xl bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-primary)] border border-[var(--border-subtle)] hover:border-[var(--brand-primary)] font-bold text-xs transition-colors flex items-center gap-1.5 shadow-sm">
                    <Icon Name="newspaper" Size="14" />
                    <span>Post desde Novedad</span>
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs flex items-center justify-between">
                <div class="flex items-center gap-2 font-semibold">
                    <Icon Name="triangle-alert" Size="14" />
                    <span>@_errorMessage</span>
                </div>
                <button type="button" @onclick="LoadDataAsync" class="px-3 py-1 rounded-xl bg-rose-500/20 hover:bg-rose-500/30 text-white font-bold transition-colors">
                    Reintentar
                </button>
            </div>
        }

        @if (_isLoading)
        {
            <div class="py-20 text-center text-[var(--text-muted)] space-y-3">
                <div class="inline-block animate-spin"><Icon Name="camera" Size="30" /></div>
                <p class="text-sm font-semibold">Sincronizando bandeja de Instagram...</p>
            </div>
        }
        else
        {
            @* Layout Principal de 2 Columnas *@
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                
                @* COLUMNA IZQUIERDA (5 cols): Bandeja de borradores y Mockup del Feed *@
                <div class="lg:col-span-5 space-y-6">
                    
                    @* Selector / Pestañas de Borradores *@
                    <div class="p-4 rounded-3xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider">
                                Borradores (@_drafts.Count)
                            </span>
                            <div class="flex items-center gap-1 text-[0.7rem]">
                                <button type="button"
                                        @onclick="() => _filterStatus = null"
                                        class="px-2 py-0.5 rounded-lg font-bold transition-colors @(_filterStatus == null ? "bg-[var(--brand-primary)] text-white" : "text-[var(--text-muted)] hover:text-[var(--text-primary)]")">
                                    Todos
                                </button>
                                <button type="button"
                                        @onclick="() => _filterStatus = InstagramPostDraftStatus.Draft"
                                        class="px-2 py-0.5 rounded-lg font-bold transition-colors @(_filterStatus == InstagramPostDraftStatus.Draft ? "bg-[var(--brand-primary)] text-white" : "text-[var(--text-muted)] hover:text-[var(--text-primary)]")">
                                    Pendientes (@_drafts.Count(d => d.Status == InstagramPostDraftStatus.Draft))
                                </button>
                                <button type="button"
                                        @onclick="() => _filterStatus = InstagramPostDraftStatus.Published"
                                        class="px-2 py-0.5 rounded-lg font-bold transition-colors @(_filterStatus == InstagramPostDraftStatus.Published ? "bg-[var(--brand-primary)] text-white" : "text-[var(--text-muted)] hover:text-[var(--text-primary)]")">
                                    Publicados (@_drafts.Count(d => d.Status == InstagramPostDraftStatus.Published))
                                </button>
                            </div>
                        </div>

                        @* Lista con scroll de borradores *@
                        <div class="max-h-56 overflow-y-auto space-y-2 pr-1 text-xs">
                            @if (FilteredDrafts.Count == 0)
                            {
                                <div class="py-6 text-center text-[var(--text-muted)] italic">
                                    No hay borradores en este filtro.
                                </div>
                            }
                            else
                            {
                                @foreach (var draft in FilteredDrafts)
                                {
                                    <button type="button"
                                            @onclick="() => SelectDraft(draft)"
                                            class="w-full text-left p-3 rounded-2xl border transition-all flex items-start justify-between gap-2 @(_activeDraft?.Id == draft.Id ? "bg-[var(--brand-primary)]/15 border-[var(--brand-primary)] text-[var(--text-primary)] shadow-sm" : "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)] hover:border-[var(--border-highlight)]")">
                                        <div class="space-y-1 min-w-0">
                                            <div class="flex items-center gap-1.5 flex-wrap">
                                                <span class="px-1.5 py-0.5 rounded text-[0.65rem] font-bold @GetSourceBadgeClass(draft.SourceType) inline-flex items-center gap-1">
                                                    <Icon Name="@GetSourceIcon(draft.SourceType)" />
                                                    @draft.SourceType
                                                </span>
                                                <span class="font-bold truncate text-[var(--text-primary)]">@draft.Title</span>
                                            </div>
                                            <p class="text-[0.68rem] text-[var(--text-muted)] truncate">@draft.Caption</p>
                                        </div>
                                        <div class="shrink-0 flex flex-col items-end gap-1">
                                            <span class="px-2 py-0.5 rounded-full text-[0.65rem] font-bold @GetStatusBadgeClass(draft.Status)">
                                                @draft.Status
                                            </span>
                                            <span class="text-[0.62rem] text-[var(--text-muted)]">@draft.CreatedAt.ToString("dd/MM HH:mm")</span>
                                        </div>
                                    </button>
                                }
                            }
                        </div>
                    </div>

                    @* Mockup Fidedigno del Feed de Instagram *@
                    @if (_activeDraft != null)
                    {
                        <div class="space-y-2">
                            <span class="text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider block px-1">
                                <Icon Name="smartphone" Size="12" /> Previsualización Feed de Instagram (1:1)
                            </span>

                            <div class="rounded-3xl border border-[var(--border-subtle)] bg-[var(--bg-card)] shadow-2xl overflow-hidden max-w-md mx-auto">
                                @* Cabecera del Post en Instagram *@
                                <div class="p-3.5 flex items-center justify-between border-b border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)]/50">
                                    <div class="flex items-center gap-2.5">
                                        @* Avatar de Ludeka con anillo degradado estilo Instagram *@
                                        <div class="w-9 h-9 rounded-full p-[2px] bg-gradient-to-tr from-amber-500 via-rose-500 to-purple-600">
                                            <div class="w-full h-full rounded-full bg-[var(--bg-card)] flex items-center justify-center font-black text-[0.8rem] text-[var(--brand-primary)]">
                                                L.
                                            </div>
                                        </div>
                                        <div>
                                            <div class="flex items-center gap-1 font-bold text-xs text-[var(--text-primary)] leading-tight">
                                                <span>ludeka.app</span>
                                                <span class="text-sky-400 text-[0.75rem]" title="Cuenta Verificada">✓</span>
                                            </div>
                                            <span class="text-[0.65rem] text-[var(--text-muted)]">Bienvenido a tu mesa</span>
                                        </div>
                                    </div>
                                    <span class="text-base text-[var(--text-muted)] px-1">&bull;&bull;&bull;</span>
                                </div>

                                @* Contenedor Cuadrado de la Imagen (1:1) *@
                                <div class="aspect-square w-full bg-[var(--bg-surface)] flex items-center justify-center overflow-hidden border-b border-[var(--border-subtle)] relative">
                                    @if (_previewMode == "vector" && !string.IsNullOrWhiteSpace(_activeDraft.SvgContent))
                                    {
                                        <div class="w-full h-full flex items-center justify-center">
                                            @((MarkupString)_activeDraft.SvgContent)
                                        </div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(_activeDraft.ImageUrl))
                                    {
                                        <img src="@_activeDraft.ImageUrl" alt="@_activeDraft.Title" class="w-full h-full object-cover" />
                                    }
                                    else if (!string.IsNullOrWhiteSpace(_activeDraft.SvgContent))
                                    {
                                        <div class="w-full h-full flex items-center justify-center">
                                            @((MarkupString)_activeDraft.SvgContent)
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="p-8 text-center text-[var(--text-muted)]">
                                            <span class="inline-block mb-2"><Icon Name="image" Size="36" /></span>
                                            <span class="text-xs">Sin imagen seleccionada</span>
                                        </div>
                                    }

                                    @if (_activeDraft.Status == InstagramPostDraftStatus.Published)
                                    {
                                        <div class="absolute top-3 right-3 px-3 py-1 rounded-full text-xs font-black bg-emerald-500 text-black shadow-lg flex items-center gap-1">
                                            <span>✓ Publicado en IG</span>
                                        </div>
                                    }
                                </div>

                                @* Barra de Interacción Social (corazón, comentario, compartir y guardar) *@
                                <div class="p-3.5 pb-2 space-y-2 text-xs">
                                    <div class="flex items-center justify-between text-xl text-[var(--text-primary)]">
                                        <div class="flex items-center gap-4">
                                            <button type="button" @onclick="() => _isLiked = !_isLiked" class="hover:scale-110 transition-transform @(_isLiked ? "text-rose-500" : "")">
                                                <Icon Name="heart" Size="20" />
                                            </button>
                                            <button type="button" class="hover:scale-110 transition-transform"><Icon Name="message-circle" Size="20" /></button>
                                            <button type="button" class="hover:scale-110 transition-transform"><Icon Name="arrow-up-right" Size="20" /></button>
                                        </div>
                                        <button type="button" class="hover:scale-110 transition-transform"><Icon Name="bookmark" Size="20" /></button>
                                    </div>

                                    @* Conteo de Likes *@
                                    <div class="font-bold text-[0.75rem] text-[var(--text-primary)]">
                                        Les gusta a <span class="font-black">deviriberia</span>, <span class="font-black">zacatrus</span> y <span class="font-black">148 personas más</span>
                                    </div>

                                    @* Copy con 'ver más' y Hashtags *@
                                    <div class="text-[0.72rem] leading-relaxed text-[var(--text-secondary)] whitespace-pre-line break-words max-h-40 overflow-y-auto">
                                        <strong class="text-[var(--text-primary)] font-black">ludeka.app</strong> @_activeDraft.Caption
                                    </div>

                                    <div class="pt-1 text-[0.62rem] text-[var(--text-muted)] uppercase tracking-wider font-semibold">
                                        HACE UN MOMENTO &bull; VER TRADUCCIÓN
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @* COLUMNA DERECHA (7 cols): Editor en Vivo y Panel de Publicación *@
                <div class="lg:col-span-7 space-y-6">
                    @if (_activeDraft == null)
                    {
                        <div class="p-12 text-center rounded-3xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-4">
                            <span class="inline-block"><Icon Name="camera" Size="48" /></span>
                            <h3 class="text-lg font-bold text-[var(--text-primary)]">Ningún borrador seleccionado</h3>
                            <p class="text-xs text-[var(--text-secondary)] max-w-md mx-auto leading-relaxed">
                                Selecciona un borrador existente de la columna izquierda o crea uno nuevo a partir de un sorteo o novedad aprobados.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="p-6 rounded-3xl bg-[var(--bg-card)] border border-[var(--border-subtle)] shadow-sm space-y-6">
                            @* Estado del Borrador / Alertas *@
                            @if (_activeDraft.Status == InstagramPostDraftStatus.Published)
                            {
                                <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                                    <div class="flex items-center gap-2.5">
                                        <Icon Name="party-popper" Size="24" />
                                        <div>
                                            <p class="font-bold text-xs">¡Publicado oficialmente en Instagram!</p>
                                            <p class="text-[0.7rem] opacity-90">ID de Medio: <code>@_activeDraft.InstagramMediaId</code></p>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(_activeDraft.InstagramPermalink))
                                    {
                                        <a href="@_activeDraft.InstagramPermalink"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="px-3.5 py-1.5 rounded-xl bg-emerald-500 text-black font-bold text-xs inline-flex items-center gap-1.5 shrink-0 shadow-sm hover:opacity-90">
                                            <span class="inline-flex items-center gap-1.5">
                                                <Icon Name="link" Size="12" /> Ver en Instagram
                                                <span>↗</span>
                                            </span>
                                        </a>
                                    }
                                </div>
                            }
                            else if (_activeDraft.Status == InstagramPostDraftStatus.Failed)
                            {
                                <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-300 space-y-1">
                                    <div class="flex items-center gap-2 font-bold text-xs">
                                        <Icon Name="triangle-alert" Size="14" /> Error en el último intento de publicación
                                    </div>
                                    <p class="text-[0.7rem] opacity-90">@_activeDraft.ErrorMessage</p>
                                </div>
                            }

                            @* Título y Origen *@
                            <div class="flex items-start justify-between gap-4 border-b border-[var(--border-subtle)] pb-4">
                                <div>
                                    <span class="text-[0.65rem] font-bold text-[var(--text-muted)] uppercase tracking-wider inline-flex items-center gap-1">
                                        Origen: <Icon Name="@GetSourceIcon(_activeDraft.SourceType)" /> @_activeDraft.SourceType &bull; ID: @_activeDraft.SourceId
                                    </span>
                                    <h2 class="text-xl font-black text-[var(--text-primary)] mt-0.5">
                                        @_activeDraft.Title
                                    </h2>
                                </div>
                                <button type="button"
                                        @onclick="DeleteActiveDraft"
                                        class="text-[var(--text-muted)] hover:text-rose-400 text-xs font-bold transition-colors flex items-center gap-1">
                                    <Icon Name="trash-2" Size="14" />
                                    <span>Descartar</span>
                                </button>
                            </div>

                            @* Controles de la Tarjeta Visual *@
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                @* Selector de Imagen a Publicar *@
                                <div class="space-y-1.5">
                                    <label class="font-bold text-[var(--text-secondary)] uppercase tracking-wider text-[0.7rem] block">
                                        Imagen para el Post
                                    </label>
                                    <div class="grid grid-cols-2 gap-2">
                                        <button type="button"
                                                @onclick='() => SetPreviewMode("vector")'
                                                class="px-3 py-2 rounded-xl text-xs font-bold border transition-colors flex items-center justify-center gap-1.5 @(_previewMode == "vector" ? "bg-[var(--brand-primary)] text-white border-[var(--brand-primary)] shadow-sm" : "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)]")">
                                            <Icon Name="palette" Size="12" />
                                            <span>Tarjeta 1:1</span>
                                        </button>
                                        <button type="button"
                                                @onclick='() => SetPreviewMode("cover")'
                                                disabled="@(string.IsNullOrWhiteSpace(_activeDraft.ImageUrl))"
                                                class="px-3 py-2 rounded-xl text-xs font-bold border transition-colors flex items-center justify-center gap-1.5 disabled:opacity-40 @(_previewMode == "cover" ? "bg-[var(--brand-primary)] text-white border-[var(--brand-primary)] shadow-sm" : "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)]")">
                                            <Icon Name="image" Size="12" />
                                            <span>Carátula</span>
                                        </button>
                                    </div>
                                </div>

                                @* Selector de Tema Visual *@
                                <div class="space-y-1.5">
                                    <label class="font-bold text-[var(--text-secondary)] uppercase tracking-wider text-[0.7rem] block">
                                        Tema Visual de Marca
                                    </label>
                                    <div class="grid grid-cols-2 gap-2">
                                        <button type="button"
                                                @onclick='() => ChangeTheme("Dark")'
                                                class="px-3 py-2 rounded-xl text-xs font-bold border transition-colors flex items-center justify-center gap-1.5 @(_editorTheme == "Dark" ? "bg-slate-900 text-white border-slate-700 shadow-sm" : "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)]")">
                                            <Icon Name="moon" Size="12" />
                                            <span>Oscuro</span>
                                        </button>
                                        <button type="button"
                                                @onclick='() => ChangeTheme("Light")'
                                                class="px-3 py-2 rounded-xl text-xs font-bold border transition-colors flex items-center justify-center gap-1.5 @(_editorTheme == "Light" ? "bg-white text-slate-900 border-slate-300 shadow-sm" : "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)]")">
                                            <Icon Name="sun" Size="12" />
                                            <span>Claro</span>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            @* Editor de Texto y Copy *@
                            <div class="space-y-2">
                                <div class="flex items-center justify-between">
                                    <label for="instagram-caption-input" class="font-bold text-[var(--text-secondary)] uppercase tracking-wider text-[0.7rem]">
                                        Texto del Post (Copy para Instagram)
                                    </label>
                                    <span class="text-[0.68rem] font-mono @(_editorCaption.Length > 2200 ? "text-rose-500 font-bold" : "text-[var(--text-muted)]")">
                                        @_editorCaption.Length / 2200 caracteres
                                    </span>
                                </div>

                                <textarea id="instagram-caption-input"
                                          @bind="_editorCaption"
                                          @bind:event="oninput"
                                          rows="9"
                                          class="w-full p-4 rounded-2xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] text-xs font-mono leading-relaxed resize-y focus:outline-none focus:border-[var(--brand-primary)] shadow-inner">
                                </textarea>
                            </div>

                            @* Chips de Hashtags Rápidos *@
                            <div class="space-y-1.5">
                                <span class="font-bold text-[var(--text-secondary)] uppercase tracking-wider text-[0.68rem] block">
                                    Añadir Hashtags con 1 clic:
                                </span>
                                <div class="flex items-center gap-1.5 flex-wrap">
                                    @foreach (var tag in _suggestedTags)
                                    {
                                        <button type="button"
                                                @onclick="() => AppendHashtag(tag)"
                                                class="px-2.5 py-1 rounded-lg bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] hover:border-[var(--brand-primary)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] text-[0.7rem] font-semibold transition-colors">
                                            @tag
                                        </button>
                                    }
                                </div>
                            </div>

                            @* Botones de Acción de Publicación *@
                            <div class="pt-4 border-t border-[var(--border-subtle)] flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
                                <div class="flex items-center gap-2">
                                    <button type="button"
                                            @onclick="SaveDraftChanges"
                                            disabled="@_isSaving"
                                            class="px-4 py-2.5 rounded-xl bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface)] border border-[var(--border-subtle)] text-[var(--text-primary)] font-bold text-xs transition-colors flex items-center justify-center gap-1.5 shadow-sm">
                                        @if (_isSaving)
                                        {
                                            <span class="animate-spin inline-block"><Icon Name="hourglass" Size="14" /></span>
                                            <span>Guardando...</span>
                                        }
                                        else
                                        {
                                            <Icon Name="save" Size="14" />
                                            <span>Guardar Cambios</span>
                                        }
                                    </button>

                                    <button type="button"
                                            @onclick="CopyCaptionToClipboard"
                                            class="px-3.5 py-2.5 rounded-xl bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface)] border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] font-semibold text-xs transition-colors flex items-center justify-center gap-1.5">
                                        @if (_isCopied)
                                        {
                                            <span class="text-emerald-400 font-bold">✓ ¡Copiado!</span>
                                        }
                                        else
                                        {
                                            <Icon Name="clipboard-copy" Size="14" />
                                            <span>Copiar Copy</span>
                                        }
                                    </button>
                                </div>

                                <button type="button"
                                        @onclick="PublishNow"
                                        disabled="@(_isPublishing || _activeDraft.Status == InstagramPostDraftStatus.Published)"
                                        class="px-6 py-3 rounded-xl bg-gradient-to-r from-amber-500 via-rose-500 to-purple-600 hover:opacity-95 text-white font-black text-xs transition-all flex items-center justify-center gap-2 shadow-lg disabled:opacity-50 disabled:cursor-not-allowed">
                                    @if (_isPublishing)
                                    {
                                        <span class="animate-spin inline-block"><Icon Name="hourglass" Size="14" /></span>
                                        <span>Despachando a Instagram API...</span>
                                    }
                                    else if (_activeDraft.Status == InstagramPostDraftStatus.Published)
                                    {
                                        <span>✓ Ya Publicado</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-2"><Icon Name="rocket" Size="14" /> Validar y Publicar en Instagram</span>
                                    }
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@* Modal de Selección de Sorteo para Nuevo Post *@
@if (_isSelectGiveawayModalOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm animate-fade-in" role="dialog" aria-modal="true">
        <div class="w-full max-w-xl max-h-[85vh] rounded-3xl bg-[var(--bg-card)] border border-[var(--border-subtle)] p-6 shadow-2xl flex flex-col space-y-4">
            <div class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-3">
                <h3 class="text-base font-bold text-[var(--text-primary)] flex items-center gap-2">
                    <Icon Name="gift" Size="16" /> Seleccionar Sorteo para Crear Post
                </h3>
                <button type="button" @onclick="() => _isSelectGiveawayModalOpen = false" class="text-xl text-[var(--text-muted)] hover:text-[var(--text-primary)]">&times;</button>
            </div>
            <div class="flex-1 overflow-y-auto space-y-2 pr-1 text-xs">
                @if (_availableGiveaways.Count == 0)
                {
                    <div class="p-8 text-center text-[var(--text-muted)] italic">No hay sorteos vigentes registrados.</div>
                }
                else
                {
                    @foreach (var g in _availableGiveaways)
                    {
