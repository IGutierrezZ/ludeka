                            <div class="min-w-0">
                                <span class="font-bold text-[var(--text-primary)] block truncate">@g.Title</span>
                                <span class="text-[0.68rem] text-[var(--text-muted)]">Organizado por @g.FormattedOrganizer &bull; Límite: @g.DeadlineAt.ToString("dd/MM/yyyy")</span>
                            </div>
                            <button type="button"
                                    @onclick="() => CreateFromGiveaway(g.Id)"
                                    class="px-3 py-1.5 rounded-xl bg-[var(--brand-primary)] text-white font-bold text-xs hover:opacity-90 shrink-0">
                                Elegir &rarr;
                            </button>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

