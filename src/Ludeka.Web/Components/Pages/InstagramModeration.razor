@code {
    [SupplyParameterFromQuery]
    public string? SourceType { get; set; }

    [SupplyParameterFromQuery]
    public string? SourceId { get; set; }

    private bool _isAuthorized;
    private bool _isLoading = true;
    private List<InstagramPostDraftDto> _drafts = [];
    private InstagramPostDraftDto? _activeDraft;
    private InstagramPostDraftStatus? _filterStatus;

    private string _editorCaption = string.Empty;
    private string _editorTheme = "Dark";
    private string _previewMode = "vector"; // "vector" | "cover"
    private bool _isLiked;
    private bool _isSaving;
    private bool _isPublishing;
    private bool _isCopied;
    private string? _errorMessage;

    private bool _isSelectGiveawayModalOpen;
    private bool _isSelectReleaseModalOpen;
    private List<GiveawayDto> _availableGiveaways = [];
    private List<WeeklyReleaseDto> _availableReleases = [];

    private readonly string[] _suggestedTags = [
        "#juegosdemesa",
        "#boardgames",
        "#ludeka",
        "#sorteojuegos",
        "#novedadesludicas",
        "#bgg",
        "#juegosdemesaespaña",
        "#juegosdecartas"
    ];

    private IReadOnlyList<InstagramPostDraftDto> FilteredDrafts => _filterStatus.HasValue
        ? _drafts.Where(d => d.Status == _filterStatus.Value).ToList()
        : _drafts;

    protected override async Task OnInitializedAsync()
    {
        _isAuthorized = CurrentUserService.HasPermission(ModeratorPermission.CanPublishInstagram);

        if (!_isAuthorized)
        {
            _isLoading = false;
            return;
        }

        await LoadDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_isAuthorized) return;

        // Si viene con parámetros de consulta para auto-crear o abrir
        if (!string.IsNullOrWhiteSpace(SourceType) && !string.IsNullOrWhiteSpace(SourceId) && Guid.TryParse(SourceId, out var parsedId))
        {
            if (string.Equals(SourceType, "Giveaway", StringComparison.OrdinalIgnoreCase))
            {
                await CreateFromGiveaway(parsedId);
            }
            else if (string.Equals(SourceType, "WeeklyRelease", StringComparison.OrdinalIgnoreCase))
            {
                await CreateFromRelease(parsedId);
            }
        }
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            var rawDrafts = await PublisherService.GetDraftsAsync();
            _drafts = rawDrafts.ToList();

            if (_activeDraft == null && _drafts.Count > 0)
            {
                SelectDraft(_drafts[0]);
            }

            // Cargar sorteos y lanzamientos para los modales de creación rápida
            var giveaways = await GiveawayService.GetGiveawaysAsync(includeExpired: false);
            _availableGiveaways = giveaways.ToList();

            var releases = await ReleaseService.GetReleasesAsync(fromDate: null);
            _availableReleases = releases.ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = $"No se pudieron cargar los datos de Instagram: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SelectDraft(InstagramPostDraftDto draft)
    {
        _activeDraft = draft;
        _editorCaption = draft.Caption;
        _editorTheme = draft.Theme;
        _previewMode = !string.IsNullOrWhiteSpace(draft.SvgContent) ? "vector" : "cover";
    }

    private async Task ChangeTheme(string theme)
    {
        if (_activeDraft == null) return;
        _editorTheme = theme;
        await SaveDraftChanges();
    }

    private void SetPreviewMode(string mode)
    {
        _previewMode = mode;
    }

    private void AppendHashtag(string tag)
    {
        if (!_editorCaption.Contains(tag, StringComparison.OrdinalIgnoreCase))
        {
            _editorCaption = $"{_editorCaption.TrimEnd()} {tag}";
        }
    }

    private async Task SaveDraftChanges()
    {
        if (_activeDraft == null) return;

        try
        {
            _isSaving = true;
            var updated = await PublisherService.UpdateDraftAsync(_activeDraft.Id, new UpdateInstagramDraftCommand(
                Caption: _editorCaption,
                Theme: _editorTheme,
                ImageUrl: _activeDraft.ImageUrl,
                SvgContent: null
            ));

            _activeDraft = updated;
            var index = _drafts.FindIndex(d => d.Id == updated.Id);
            if (index >= 0) _drafts[index] = updated;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task PublishNow()
    {
        if (_activeDraft == null) return;

        try
        {
            _isPublishing = true;
            // Guardar cambios previos en el copy antes de disparar
            await SaveDraftChanges();

            var result = await PublisherService.PublishDraftAsync(
                _activeDraft.Id,
                CurrentUserService.UserId,
                CurrentUserService.UserName
            );

            // Refrescar borrador activo
            var refreshed = await PublisherService.GetDraftByIdAsync(_activeDraft.Id);
            if (refreshed != null)
            {
                SelectDraft(refreshed);
                var index = _drafts.FindIndex(d => d.Id == refreshed.Id);
                if (index >= 0) _drafts[index] = refreshed;
            }
        }
        finally
        {
            _isPublishing = false;
        }
    }

    private async Task DeleteActiveDraft()
    {
        if (_activeDraft == null) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", "¿Deseas descartar este borrador de Instagram?");
        if (confirmed)
        {
            await PublisherService.DeleteDraftAsync(_activeDraft.Id);
            _drafts.RemoveAll(d => d.Id == _activeDraft.Id);
            _activeDraft = _drafts.FirstOrDefault();
            if (_activeDraft != null) SelectDraft(_activeDraft);
        }
    }

    private async Task CreateFromGiveaway(Guid giveawayId)
    {
        _isSelectGiveawayModalOpen = false;
        var draft = await PublisherService.CreateDraftFromGiveawayAsync(
            giveawayId,
            CurrentUserService.UserId,
            CurrentUserService.UserName
        );

        if (!_drafts.Any(d => d.Id == draft.Id))
        {
            _drafts.Insert(0, draft);
        }
        SelectDraft(draft);
    }

    private async Task CreateFromRelease(Guid releaseId)
    {
        _isSelectReleaseModalOpen = false;
        var draft = await PublisherService.CreateDraftFromWeeklyReleaseAsync(
            releaseId,
            CurrentUserService.UserId,
            CurrentUserService.UserName
        );

        if (!_drafts.Any(d => d.Id == draft.Id))
        {
            _drafts.Insert(0, draft);
        }
        SelectDraft(draft);
    }

    private async Task CopyCaptionToClipboard()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _editorCaption);
            _isCopied = true;
            StateHasChanged();
            await Task.Delay(2500);
            _isCopied = false;
            StateHasChanged();
        }
        catch
        {
            // Fallback silencioso
        }
    }

    private static string GetSourceIcon(InstagramPostSourceType type) => type switch
    {
        InstagramPostSourceType.Giveaway => "gift",
        InstagramPostSourceType.WeeklyRelease => "newspaper",
        InstagramPostSourceType.Game => "dices",
        _ => "notebook-pen"
    };

    private static string GetSourceBadgeClass(InstagramPostSourceType type) => type switch
    {
        InstagramPostSourceType.Giveaway => "bg-amber-500/15 text-amber-400 border border-amber-500/30",
        InstagramPostSourceType.WeeklyRelease => "bg-blue-500/15 text-blue-400 border border-blue-500/30",
        InstagramPostSourceType.Game => "bg-purple-500/15 text-purple-400 border border-purple-500/30",
        _ => "bg-slate-500/15 text-slate-300 border border-slate-500/30"
    };

    private static string GetStatusBadgeClass(InstagramPostDraftStatus status) => status switch
    {
        InstagramPostDraftStatus.Published => "bg-emerald-500/15 text-emerald-400 border border-emerald-500/30",
        InstagramPostDraftStatus.Publishing => "bg-sky-500/15 text-sky-400 border border-sky-500/30 animate-pulse",
        InstagramPostDraftStatus.Failed => "bg-rose-500/15 text-rose-400 border border-rose-500/30",
        _ => "bg-amber-500/15 text-amber-400 border border-amber-500/30"
    };
}
