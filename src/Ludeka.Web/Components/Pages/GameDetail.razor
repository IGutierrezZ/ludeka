@page "/juegos/{Slug}"
@rendermode InteractiveServer
@inject ICatalogService CatalogService
@inject IUserLibraryService LibraryService
@inject IGamePlayLogService PlayLogService
@inject IFoundingVerdictService FoundingService
@inject IMediaService MediaService
@inject ICurrentUserService CurrentUserService
@inject IUserPreferenceService PreferenceService
@inject IExpansionService ExpansionService
@inject IGameEditorService GameEditorService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<GameDetail> Logger

<PageTitle>@(Game != null ? $"{Game.SpanishTitle} — Ficha Editorial | Ludeka" : "Juego no encontrado — Ludeka")</PageTitle>

@if (_isLoading)
{
    <div class="container-ludeka py-20 text-center text-[var(--muted)]">
        <div class="inline-block animate-spin mb-3 text-[var(--brand)]"><Icon Name="dices" Size="36" /></div>
        <p class="text-base font-extrabold text-[var(--ink)]">Cargando ficha editorial...</p>
    </div>
}
else if (Game == null)
{
    <div class="container-ludeka py-20 text-center max-w-lg mx-auto">
        <span class="inline-block mb-4 text-[var(--brand)]"><Icon Name="search" Size="40" /></span>
        <h1 class="text-3xl font-black text-[var(--ink)] mb-2">Juego no encontrado</h1>
        <p class="text-sm text-[var(--muted)] mb-6">
            El juego que buscas con identificador <code class="text-[var(--ink)] font-mono font-bold">@Slug</code> no figura en el catálogo de Ludeka.
        </p>
        <a href="/catalogo" class="h-11 px-6 rounded-full font-black text-xs bg-[var(--brand)] text-[var(--on-brand)] inline-flex items-center gap-2 hover:opacity-90 transition-opacity">
            &larr; Volver al Catálogo
        </a>
    </div>
}
else
{
    @* CABECERA EDITORIAL EN BANDA TERRACOTA A TODO EL ANCHO *@
    <style>
        #bloque-01-cabecera .text-\[var\(--text-primary\)\] {
            color: var(--on-brand) !important;
            border-bottom: 2px solid rgba(255, 248, 238, 0.5);
        }
    </style>
    <section id="bloque-01-cabecera"
             data-screen-label="Ficha de juego"
             aria-label="En la Mesa &amp; Colección"
             class="bg-[var(--brand)] text-[var(--on-brand)] selection:bg-[var(--mustard)] selection:text-[#22180F]">

        @* Barra superior de navegación y reporte *@
        <div class="max-w-[1280px] mx-auto px-4 sm:px-8 lg:px-12 pt-4 pb-0 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 text-xs font-black">
            <div class="flex items-center gap-4">
                <a href="/catalogo" class="text-[var(--on-brand)]/90 hover:text-[var(--mustard)] transition-colors inline-flex items-center gap-1.5">
                    <span>&larr;</span> Volver al catálogo
                </a>
                <a href="/cuenta/ludoteca" class="hidden sm:inline-flex text-[var(--on-brand)]/80 hover:text-[var(--on-brand)] items-center gap-1">
                    <Icon Name="library" Size="12" /> Ir a Mi Ludoteca
                </a>
            </div>
            <div class="flex items-center gap-2">
                <button type="button"
                        @onclick="() => _isReportModalOpen = true"
                        title="Reportar una errata, imagen incorrecta o problema en esta ficha"
                        class="text-[var(--on-brand)]/85 hover:text-[var(--on-brand)] transition-opacity inline-flex items-center gap-1.5 cursor-pointer">
                    <Icon Name="flag" Size="12" /> Reportar errata
                </button>
                @if (Game.PurchaseLinks != null && Game.PurchaseLinks.Count > 0)
                {
                    <a href="#donde-comprar"
                       class="px-3 py-1 rounded-full bg-black/20 hover:bg-black/30 text-[var(--on-brand)] border border-white/20 font-extrabold text-xs transition-colors flex items-center gap-1.5 shadow-2xs">
                        <Icon Name="shopping-cart" Size="12" /> Comprar (@Game.PurchaseLinks.Count)
                    </a>
                }
            </div>
        </div>

        @if (Game.IsExpansion && _parentGame != null)
        {
            <div class="max-w-[1280px] mx-auto px-4 sm:px-8 lg:px-12 pt-3">
                <ParentGameBanner ParentGame="@_parentGame" />
            </div>
        }

        @* Versión de Escritorio (lg:grid) *@
        <div class="hidden lg:grid max-w-[1280px] mx-auto px-4 sm:px-8 lg:px-12 pt-5 pb-11 grid-cols-[minmax(0,1fr)_minmax(300px,380px)] gap-10 xl:gap-14 items-center">
            @* Columna Izquierda: Metadatos, Titular, Píldoras, Veredicto y Botonera *@
            <div class="flex flex-col gap-4.5 min-w-0">
                <span class="text-xs font-black uppercase tracking-[0.18em] text-[var(--mustard)]">
                    @GetStyleShortText(Game.Style).ToUpperInvariant() &bull; @Game.YearPublished
                </span>

                <h1 class="m-0 text-4xl sm:text-5xl lg:text-6xl font-black leading-[1.04] sm:leading-[1.0] lg:leading-[0.98] tracking-[-0.035em] sm:tracking-[-0.04em] text-balance text-[var(--on-brand)]">
                    @TitleForCountry
                </h1>

                @if (!string.Equals(TitleForCountry, Game.OriginalTitle, StringComparison.OrdinalIgnoreCase))
                {
                    <p class="text-sm text-[var(--on-brand)]/70 italic -mt-2">
                        Título original: @Game.OriginalTitle
                    </p>
                }

                <p class="text-[15px] leading-relaxed text-[var(--on-brand)]/90">
                    Diseñado por <span class="text-[var(--text-primary)] font-bold">@Game.Designer</span> &bull; editado en España por
                    @if (HasLocalPublisher)
                    {
                        <a href="@($"/editoriales/{LocalPubSlug}")" class="font-black border-b-2 border-[var(--mustard)] text-[var(--on-brand)] hover:text-[var(--mustard)] transition-colors">@PublisherForCountry</a>
                    }
                    else
                    {
                        <strong class="font-black border-b-2 border-[var(--mustard)]">@(string.IsNullOrWhiteSpace(Game.Publisher) ? "Varios" : Game.Publisher)</strong>
                    }
                    @if (DiffersFromOriginal && !string.IsNullOrWhiteSpace(Game.Publisher))
                    {
                        <span class="text-xs text-[var(--on-brand)]/70 ml-1">(Orig.: <a href="@($"/editoriales/{OrigPubSlug}")" class="underline">@Game.Publisher</a>)</span>
                    }
                </p>

                @* Fila de Píldoras Compactas *@
                <div class="flex flex-wrap items-center gap-2 pt-0.5" title="Métricas y fichas técnicas">
                    <span class="py-1.5 px-3.5 rounded-full bg-[#FFF8EE] text-[#22180F] text-xs font-extrabold" title="Rating BGG">
                        BGG @Game.BggRating.ToString("0.0")
                    </span>
                    <span class="py-1.5 px-3.5 rounded-full bg-[#FFC145] text-[#22180F] text-xs font-extrabold" title="Consenso Ludeka">
                        Ludeka @Game.LudistRating.ToString("0.0")
                    </span>
                    @if (Game.BggRank.HasValue && Game.BggRank.Value <= 500)
                    {
                        <span class="py-1.5 px-3 rounded-full border border-white/60 text-xs font-extrabold text-[var(--on-brand)] inline-flex items-center gap-1" title="Ranking BGG">
                            <Icon Name="trophy" Size="12" class="text-[var(--mustard)]" />
                            <span>#@Game.BggRank.Value</span>
                        </span>
                    }
                    <span class="py-1.5 px-3.5 rounded-full border border-white/60 text-xs font-extrabold text-[var(--on-brand)]" title="Jugadores ideales">
                        Ideal a @GetIdealShortPlayerText()
                    </span>
                    <span class="py-1.5 px-3.5 rounded-full border border-white/60 text-xs font-extrabold text-[var(--on-brand)]">
                        @GetDurationDisplayText()
                    </span>
                    <span class="py-1.5 px-3.5 rounded-full border border-white/60 text-xs font-extrabold text-[var(--on-brand)]">
                        @GetComplexityShortText() &bull; @Game.Age.BoxAge+
                    </span>
                </div>

                @* Recuadro de Veredicto Breve *@
                <div class="flex items-start gap-3.5 py-3.5 border-t border-b border-white/35 max-w-[620px]">
                    <span class="shrink-0 py-1 px-2.5 rounded-md bg-[#FFC145] text-[#22180F] text-[11px] font-black uppercase tracking-wider">
                        @GetFoundingBadgeText()
                    </span>
                    <span class="text-[15px] leading-snug text-[var(--on-brand)]">
                        @(GetShortVerdictSnippet())
                        <button type="button"
                                @onclick="() => _isVerdictSlideOverOpen = true"
                                class="font-extrabold border-b-2 border-[#FFC145] text-[var(--on-brand)] hover:text-[#FFC145] transition-colors whitespace-nowrap ml-1 cursor-pointer">
                            Leer veredicto
                        </button>
                    </span>
                </div>

                @* Botonera de Acciones *@
                <div class="flex flex-wrap items-center gap-2.5 relative pt-1">
                    @* Split button en negro/inverso para ludoteca *@
                    <div class="flex h-[50px] rounded-full bg-[#22180F] text-[#FFC145] overflow-hidden shadow-md">
                        <button type="button"
                                @onclick="HandlePrimaryCollectionClick"
                                class="border-0 bg-transparent text-inherit px-5 font-extrabold text-sm whitespace-nowrap overflow-hidden text-ellipsis hover:bg-white/10 transition-colors cursor-pointer flex items-center gap-2">
                            <Icon Name="@GetCollectionIconName()" Size="16" />
                            <span>@GetCollectionButtonLabel()</span>
                        </button>
                        <button type="button"
                                @onclick="() => _isLibMenuOpen = !_isLibMenuOpen"
                                aria-label="Más opciones de ludoteca"
                                class="border-0 border-l border-[#FFC145]/35 bg-transparent text-inherit px-4 font-black text-sm hover:bg-white/10 transition-colors cursor-pointer">
                            ▾
                        </button>
                    </div>

                    @* Menú desplegable flotante de ludoteca *@
                    @if (_isLibMenuOpen)
                    {
                        <div class="absolute left-0 top-[58px] w-64 rounded-2xl bg-[#FFF8EE] text-[#22180F] shadow-2xl p-1.5 flex flex-col z-30 border border-[#22180F]/15 animate-in fade-in zoom-in-95 duration-150">
                            <button type="button"
                                    @onclick="() => SelectCollectionStatus(CollectionStatus.InCollection)"
                                    class="w-full text-left py-2.5 px-3 rounded-xl font-extrabold text-sm transition-colors flex items-center justify-between cursor-pointer @(_collectionItem?.Status == CollectionStatus.InCollection ? "bg-[var(--paper-2)] text-[var(--ink)]" : "hover:bg-[var(--paper-2)] text-[var(--ink)]")">
                                <span>En mi ludoteca</span>
                                @if (_collectionItem?.Status == CollectionStatus.InCollection)
                                {
                                    <Icon Name="check" Size="16" class="text-[var(--accent-green)]" />
                                }
                            </button>
                            <button type="button"
                                    @onclick="() => SelectCollectionStatus(CollectionStatus.WantToBuy)"
                                    class="w-full text-left py-2.5 px-3 rounded-xl font-extrabold text-sm transition-colors flex items-center justify-between cursor-pointer @(_collectionItem?.Status == CollectionStatus.WantToBuy ? "bg-[var(--paper-2)] text-[var(--ink)]" : "hover:bg-[var(--paper-2)] text-[var(--ink)]")">
                                <span>Lo quiero</span>
                                @if (_collectionItem?.Status == CollectionStatus.WantToBuy)
                                {
                                    <Icon Name="check" Size="16" class="text-[var(--accent-green)]" />
                                }
                            </button>
                            <button type="button"
                                    @onclick="SelectTogglePlayed"
                                    class="w-full text-left py-2.5 px-3 rounded-xl font-extrabold text-sm transition-colors flex items-center justify-between cursor-pointer @(_collectionItem?.IsPlayed == true ? "bg-[var(--paper-2)] text-[var(--ink)]" : "hover:bg-[var(--paper-2)] text-[var(--ink)]")">
                                <span>Jugado</span>
                                @if (_collectionItem?.IsPlayed == true)
                                {
                                    <Icon Name="check" Size="16" class="text-[var(--accent-green)]" />
                                }
                            </button>
                        </div>
                    }

                    @* Botón contorneado: Registrar partida *@
                    <button type="button"
                            @onclick="() => _isRecordPlayModalOpen = true"
                            class="h-[50px] px-5 rounded-full border-2 border-white/80 bg-transparent text-[var(--on-brand)] font-extrabold text-sm hover:bg-white/10 transition-colors inline-flex items-center gap-2 cursor-pointer">
                        <Icon Name="dices" Size="16" />
                        <span>Registrar partida @(_userPlaysCount > 0 ? $"({_userPlaysCount})" : "")</span>
                    </button>

                    @* Botón circular contorneado: Compartir *@
                    <button type="button"
                            @onclick="HandleShareClick"
                            aria-label="Compartir ficha"
                            title="Copiar enlace para compartir"
                            class="h-[50px] w-[50px] shrink-0 rounded-full border-2 border-white/80 bg-transparent text-[var(--on-brand)] font-black text-lg hover:bg-white/10 transition-colors flex items-center justify-center cursor-pointer">
                        <Icon Name="share-2" Size="18" />
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(_actionFeedbackMessage))
                {
                    <div class="p-3 rounded-2xl border flex items-center justify-between text-xs transition-all max-w-[500px] @(_actionFeedbackType == "error" ? "bg-[var(--state-error-bg)] border-[var(--state-error-border)] text-[var(--state-error)]" : "bg-black/25 border-white/30 text-[var(--on-brand)]")">
                        <div class="flex items-center gap-2">
                            <Icon Name="@(_actionFeedbackType == "error" ? "alert-circle" : "check-circle-2")" Size="16" />
                            <span>@_actionFeedbackMessage</span>
                        </div>
                        <button type="button" @onclick="() => _actionFeedbackMessage = null" class="p-1 cursor-pointer" aria-label="Cerrar">&times;</button>
                    </div>
                }
            </div>

            @* Columna Derecha: Marco polaroid físico rotado 2° con carrusel y pegatina de precio *@
            <div class="relative flex flex-col items-center gap-3.5 select-none">
                <div class="bg-[#FFF8EE] p-3 pb-3.5 rounded shadow-[0_26px_44px_rgba(34,24,15,0.3)] w-full max-w-[360px] flex flex-col gap-2.5 text-[#22180F] transform rotate-2 hover:rotate-0 transition-transform duration-300">
                    <div class="relative aspect-square w-full rounded overflow-hidden bg-neutral-900 flex items-center justify-center">
                        <img src="@CurrentHeroImageUrl"
                             alt="@Game.SpanishTitle"
                             class="w-full h-full object-cover" />

                        @if (AvailableHeroImagesCount > 1)
                        {
                            <button type="button"
                                    @onclick="PreviousHeroImage"
                                    aria-label="Imagen anterior"
                                    class="absolute left-2.5 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-[#FFF8EE]/90 hover:bg-[#FFF8EE] text-[#22180F] font-black text-sm flex items-center justify-center shadow-md transition-all cursor-pointer">
                                &larr;
                            </button>
                            <button type="button"
                                    @onclick="NextHeroImage"
                                    aria-label="Imagen siguiente"
                                    class="absolute right-2.5 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-[#FFF8EE]/90 hover:bg-[#FFF8EE] text-[#22180F] font-black text-sm flex items-center justify-center shadow-md transition-all cursor-pointer">
                                &rarr;
                            </button>
                        }

                        <span class="absolute right-2.5 bottom-2.5 py-1 px-2.5 rounded-full bg-[#22180F] text-[#FFF8EE] text-xs font-extrabold shadow">
                            @(CurrentHeroImageIndex + 1) / @AvailableHeroImagesCount
                        </span>
                    </div>

                    <div class="flex justify-between items-center gap-2 pt-0.5 px-0.5">
                        <b class="text-xs font-extrabold text-[#22180F] truncate">@CurrentHeroImageLabel</b>
                        <a href="https://boardgamegeek.com/boardgame/@Game.BggId"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="text-xs font-black text-[#22180F] border-b-2 border-[#C9481C] hover:opacity-80 transition-opacity whitespace-nowrap inline-flex items-center gap-1">
                            <Icon Name="globe" Size="12" />
                            <span>Ver en BGG ↗</span>
                        </a>
                    </div>
                </div>

                @* Fila de Miniaturas Fotográficas *@
                @if (AvailableHeroImagesCount > 1)
                {
                    <div class="flex gap-2">
                        @foreach (var imgInfo in AvailableHeroImages)
                        {
                            var isSelected = imgInfo.Key == _selectedHeroImageKey;
                            <button type="button"
                                    @onclick="() => _selectedHeroImageKey = imgInfo.Key"
                                    aria-label="@imgInfo.Label"
                                    class="p-0 w-[52px] h-[52px] rounded-lg overflow-hidden border-2 transition-all cursor-pointer @(isSelected ? "border-white shadow-md scale-105" : "border-white/40 opacity-70 hover:opacity-100")">
                                <img src="@imgInfo.Url" alt="" class="w-full h-full object-cover block" />
                            </button>
                        }
                    </div>
                }

            </div>
        </div>

        @* Versión Móvil (<lg) *@
        <div class="lg:hidden px-4 pt-4 pb-6 flex flex-col gap-3.5">
            @* Carátula 4:3 con controles táctiles y dots *@
            <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden bg-neutral-900 shadow-xl">
                <img src="@CurrentHeroImageUrl" alt="@Game.SpanishTitle" class="w-full h-full object-cover" />
                @if (AvailableHeroImagesCount > 1)
                {
                    <button type="button" @onclick="PreviousHeroImage" aria-label="Anterior" class="absolute left-0 top-0 bottom-0 w-1/3 bg-transparent border-0 cursor-pointer"></button>
                    <button type="button" @onclick="NextHeroImage" aria-label="Siguiente" class="absolute right-0 top-0 bottom-0 w-1/3 bg-transparent border-0 cursor-pointer"></button>
                }
                <span class="absolute left-3 bottom-3 py-1 px-2.5 rounded-full bg-[#22180F]/85 text-[#FFF8EE] text-[11px] font-extrabold backdrop-blur-xs">
                    @CurrentHeroImageLabel
                </span>
                @if (AvailableHeroImagesCount > 1)
                {
                    <span class="absolute right-3 bottom-3.5 flex gap-1.5">
                        @for (int i = 0; i < AvailableHeroImagesCount; i++)
                        {
                            var dotIndex = i;
                            var isDotActive = dotIndex == CurrentHeroImageIndex;
                            <span class="h-1.5 rounded-full transition-all @(isDotActive ? "w-4 bg-[#FFC145]" : "w-1.5 bg-white/50")"></span>
                        }
                    </span>
                }
            </div>

            @* Metadatos y título *@
            <div class="flex flex-col gap-2.5">
                <span class="text-[11px] font-black uppercase tracking-wider text-[var(--mustard)]">
                    @GetStyleShortText(Game.Style).ToUpperInvariant() &bull; @Game.YearPublished@(string.IsNullOrWhiteSpace(PublisherForCountry) ? "" : $" &bull; {PublisherForCountry}")
                </span>

                <h1 class="m-0 text-3xl sm:text-4xl font-black leading-[1.05] tracking-[-0.03em] text-balance text-[var(--on-brand)]">
                    @TitleForCountry
                </h1>

                @* Píldoras en móvil *@
                <div class="flex flex-wrap items-center gap-1.5">
                    <span class="py-1 px-2.5 rounded-full bg-[#FFF8EE] text-[#22180F] text-[11px] font-extrabold">BGG @Game.BggRating.ToString("0.0")</span>
                    <span class="py-1 px-2.5 rounded-full bg-[#FFC145] text-[#22180F] text-[11px] font-extrabold">Ludeka @Game.LudistRating.ToString("0.0")</span>
                    @if (Game.BggRank.HasValue && Game.BggRank.Value <= 500)
                    {
                        <span class="py-1 px-2 rounded-full border border-white/60 text-[11px] font-extrabold text-[var(--on-brand)] inline-flex items-center gap-1">
                            <Icon Name="trophy" Size="10" class="text-[var(--mustard)]" />
                            <span>#@Game.BggRank.Value</span>
                        </span>
                    }
                    <span class="py-1 px-2.5 rounded-full border border-white/60 text-[11px] font-extrabold text-[var(--on-brand)]">Ideal a @GetIdealShortPlayerText()</span>
                    <span class="py-1 px-2.5 rounded-full border border-white/60 text-[11px] font-extrabold text-[var(--on-brand)]">@GetDurationDisplayText()</span>
                    <span class="py-1 px-2.5 rounded-full border border-white/60 text-[11px] font-extrabold text-[var(--on-brand)]">@GetComplexityShortText() &bull; @Game.Age.BoxAge+</span>
                </div>

                @* Veredicto breve *@
                <p class="text-sm leading-snug text-[var(--on-brand)]/95">
                    <strong class="text-[#FFC145] font-black">@GetFoundingBadgeText().</strong>
                    @(GetShortVerdictSnippet())
                    <button type="button" @onclick="() => _isVerdictSlideOverOpen = true" class="font-black border-b border-[#FFC145] text-[var(--on-brand)] hover:text-[#FFC145] whitespace-nowrap ml-1 cursor-pointer">
                        Leer más
                    </button>
                </p>

                @* Botonera móvil compacta *@
                <div class="flex items-center gap-2 relative pt-1">
                    <div class="flex h-11 rounded-full bg-[#22180F] text-[#FFC145] overflow-hidden flex-1 min-w-0 shadow-sm">
                        <button type="button"
                                @onclick="HandlePrimaryCollectionClick"
                                class="flex-1 min-w-0 border-0 bg-transparent text-inherit px-3.5 font-extrabold text-xs whitespace-nowrap overflow-hidden text-ellipsis cursor-pointer">
                            @GetCollectionButtonLabel()
                        </button>
                        <button type="button"
                                @onclick="() => _isLibMenuOpen = !_isLibMenuOpen"
                                aria-label="Más opciones de ludoteca"
                                class="border-0 border-l border-[#FFC145]/35 bg-transparent text-inherit px-3.5 font-black text-xs cursor-pointer">
                            ▾
                        </button>
                    </div>
                    <button type="button"
                            @onclick="() => _isRecordPlayModalOpen = true"
                            aria-label="Registrar partida"
                            class="h-11 w-11 shrink-0 rounded-full border-2 border-white/80 bg-transparent text-[var(--on-brand)] font-black text-lg flex items-center justify-center cursor-pointer">
                        +
                    </button>
                    <button type="button"
                            @onclick="HandleShareClick"
                            aria-label="Compartir"
                            class="h-11 w-11 shrink-0 rounded-full border-2 border-white/80 bg-transparent text-[var(--on-brand)] font-black text-sm flex items-center justify-center cursor-pointer">
                        <Icon Name="share-2" Size="16" />
                    </button>

                    @if (_isLibMenuOpen)
                    {
                        <div class="absolute left-0 top-[50px] w-60 rounded-2xl bg-[#FFF8EE] text-[#22180F] shadow-2xl p-1.5 flex flex-col z-30 border border-[#22180F]/15">
                            <button type="button"
                                    @onclick="() => SelectCollectionStatus(CollectionStatus.InCollection)"
                                    class="w-full text-left py-2 px-3 rounded-xl font-extrabold text-xs flex items-center justify-between cursor-pointer">
                                <span>En mi ludoteca</span>
                                @if (_collectionItem?.Status == CollectionStatus.InCollection) { <Icon Name="check" Size="14" class="text-[var(--accent-green)]" /> }
                            </button>
                            <button type="button"
                                    @onclick="() => SelectCollectionStatus(CollectionStatus.WantToBuy)"
                                    class="w-full text-left py-2 px-3 rounded-xl font-extrabold text-xs flex items-center justify-between cursor-pointer">
                                <span>Lo quiero</span>
                                @if (_collectionItem?.Status == CollectionStatus.WantToBuy) { <Icon Name="check" Size="14" class="text-[var(--accent-green)]" /> }
                            </button>
                            <button type="button"
                                    @onclick="SelectTogglePlayed"
                                    class="w-full text-left py-2 px-3 rounded-xl font-extrabold text-xs flex items-center justify-between cursor-pointer">
                                <span>Jugado</span>
                                @if (_collectionItem?.IsPlayed == true) { <Icon Name="check" Size="14" class="text-[var(--accent-green)]" /> }
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    @* CINTA INVERSA DE MERCADO *@
    <div class="bg-[var(--inverse)] text-[var(--ticker)] border-y border-[var(--line)]">
        <div class="max-w-[1280px] mx-auto py-2.5 px-4 sm:px-8 lg:px-12 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 text-xs font-black">
            <div class="flex items-center gap-4 flex-wrap">
                <span>Mejor precio hoy: @GetBestPriceLabel()</span>
                <span class="hidden sm:inline-block w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
                <span>Mínimo histórico: @GetHistoricalLowLabel()</span>
            </div>
            <div class="flex items-center gap-4 text-[var(--on-inverse)]/80">
                <span>@(_mediaHub?.TotalCount ?? 0) vídeos</span>
                @if (Game.Sleeves != null && Game.Sleeves.Count > 0)
                {
                    <span>&bull;</span>
                    <span>@Game.Sleeves.Count formatos de fundas</span>
                }
            </div>
        </div>
    </div>

    @* BARRA PEGAJOSA DE PESTAÑAS (STICKY NAV) *@
    <nav id="ficha-tabs-nav" class="sticky top-0 z-30 bg-[var(--paper)] border-b border-[var(--line)] shadow-2xs backdrop-blur-md">
        <div class="max-w-[1280px] mx-auto px-4 sm:px-8 lg:px-12 flex gap-4 sm:gap-7 overflow-x-auto scrollbar-none whitespace-nowrap">
            <button type="button"
                    @onclick='() => SelectTab("resumen")'
                    class="border-0 bg-transparent py-4 px-1 font-extrabold text-sm transition-colors cursor-pointer @(_activeTab == "resumen" ? "text-[var(--ink)] border-b-[3px] border-[var(--rule)]" : "text-[var(--muted)] hover:text-[var(--ink)]")">
                Resumen
            </button>
            <button type="button"
                    @onclick='() => SelectTab("videos")'
                    class="border-0 bg-transparent py-4 px-1 font-extrabold text-sm transition-colors cursor-pointer @(_activeTab == "videos" ? "text-[var(--ink)] border-b-[3px] border-[var(--rule)]" : "text-[var(--muted)] hover:text-[var(--ink)]")">
                Vídeos @(_mediaHub?.TotalCount > 0 ? $"({_mediaHub.TotalCount})" : "")
            </button>
            <button type="button"
                    @onclick='() => SelectTab("dudas")'
                    class="border-0 bg-transparent py-4 px-1 font-extrabold text-sm transition-colors cursor-pointer @(_activeTab == "dudas" ? "text-[var(--ink)] border-b-[3px] border-[var(--rule)]" : "text-[var(--muted)] hover:text-[var(--ink)]")">
                Dudas
            </button>
            @if (Game.Sleeves != null && Game.Sleeves.Count > 0)
            {
                <button type="button"
                        @onclick='() => SelectTab("fundas")'
                        class="border-0 bg-transparent py-4 px-1 font-extrabold text-sm transition-colors cursor-pointer @(_activeTab == "fundas" ? "text-[var(--ink)] border-b-[3px] border-[var(--rule)]" : "text-[var(--muted)] hover:text-[var(--ink)]")">
                    Fundas (@Game.Sleeves.Count)
                </button>
            }
            <button type="button"
                    @onclick='() => SelectTab("expansiones")'
                    class="border-0 bg-transparent py-4 px-1 font-extrabold text-sm transition-colors cursor-pointer @(_activeTab == "expansiones" ? "text-[var(--ink)] border-b-[3px] border-[var(--rule)]" : "text-[var(--muted)] hover:text-[var(--ink)]")">
                Expansiones @(_expansions.Count > 0 ? $"({_expansions.Count})" : "")
            </button>
        </div>
    </nav>

    @* CUERPO PRINCIPAL A DOS COLUMNAS (12 columnas: 8 principal, 4 fija lateral) *@
    <div class="max-w-[1280px] mx-auto px-4 sm:px-8 lg:px-12 py-8 lg:py-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 xl:gap-12 items-start">
            @* Columna Principal de Contenido (8 cols) *@
            <div class="lg:col-span-8 flex flex-col gap-10 min-w-0">
                @* BLOQUE 02: PANEL LATERAL DESLIZABLE DE VEREDICTO (SLIDE-OVER MODAL / DRAWER) *@
                @if (_isVerdictSlideOverOpen)
                {
                    <div class="fixed inset-0 bg-black/60 backdrop-blur-xs z-[90] animate-fade-in"
                         @onclick="() => _isVerdictSlideOverOpen = false"
                         aria-hidden="true"></div>

                    <aside id="bloque-02-veredicto"
                           role="dialog"
                           aria-modal="true"
                           aria-label="Veredicto de la Mesa"
                           class="fixed right-0 top-0 bottom-0 w-full sm:w-[540px] max-w-full bg-[var(--paper)] text-[var(--ink)] z-[100] shadow-[-20px_0_50px_rgba(34,24,15,0.3)] overflow-y-auto flex flex-col animate-in slide-in-from-right duration-200">
                        @* Cabecera negra de veredicto *@
                        <div class="bg-[#22180F] text-[#FFF8EE] p-5 sm:p-7 flex flex-col gap-3">
                            <div class="flex justify-between items-center">
                                <span class="py-1 px-2.5 rounded bg-[#FFC145] text-[#22180F] text-[11px] font-black uppercase tracking-wider">
                                    @GetFoundingBadgeText()
                                </span>
                                <button type="button"
                                        @onclick="() => _isVerdictSlideOverOpen = false"
                                        aria-label="Cerrar veredicto"
                                        class="w-9 h-9 rounded-full border border-white/40 bg-transparent text-[#FFF8EE] font-black text-sm flex items-center justify-center hover:bg-white/10 transition-colors cursor-pointer">
                                    ✕
                                </button>
                            </div>
                            <h3 class="m-0 text-2xl sm:text-3xl font-black leading-tight tracking-[-0.035em]">
                                El veredicto de @Game.SpanishTitle
                            </h3>
                            <span class="text-xs text-[#FFC145] font-extrabold">
                                @GetVerdictSourceLabel()
                            </span>
                        </div>

                        @* Contenido del veredicto *@
                        <div class="p-5 sm:p-8 flex flex-col gap-6">
                            <p class="m-0 text-base sm:text-lg font-semibold leading-relaxed text-pretty text-[var(--ink)]">
                                «@GetHighImpactQuote()»
                            </p>

                            @if (!string.IsNullOrWhiteSpace(_foundingVerdict?.OverallVerdict))
                            {
                                <p class="m-0 text-sm sm:text-base leading-relaxed text-[var(--muted)] text-pretty">
                                    @_foundingVerdict.OverallVerdict
                                </p>
                            }

                            @* Pros & Contras *@
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 pt-2">
                                <div class="flex flex-col gap-2">
                                    <b class="text-xs font-black uppercase tracking-wider text-[var(--accent-green)] pb-2 border-b-[3px] border-[var(--accent-green)]">
                                        Lo mejor
                                    </b>
                                    <p class="text-sm leading-relaxed text-[var(--ink)]">
                                        @GetVerdictPros()
                                    </p>
                                </div>
                                <div class="flex flex-col gap-2">
                                    <b class="text-xs font-black uppercase tracking-wider text-[var(--accent)] pb-2 border-b-[3px] border-[var(--accent)]">
                                        A tener en cuenta
                                    </b>
                                    <p class="text-sm leading-relaxed text-[var(--ink)]">
                                        @GetVerdictCons()
                                    </p>
                                </div>
                            </div>

                            @* Público y contexto *@
                            @if (_foundingVerdict?.FamilyVerdict != null || _aiSummary?.AgeSummary != null)
                            {
                                <div class="flex flex-col gap-2 p-4 rounded-2xl bg-[var(--paper-2)] border border-[var(--line)]">
                                    <b class="text-xs font-black uppercase tracking-wider text-[var(--muted)]">Público y contexto ideal</b>
                                    <span class="text-sm font-semibold text-[var(--ink)]">@GetVerdictTargetAudience()</span>
                                </div>
                            }

                            @* Herramientas de Staff en Veredicto *@
                            @if (IsStaff)
                            {
                                <div class="flex flex-wrap items-center gap-2 p-3.5 rounded-2xl border-2 border-dashed border-[var(--mustard)] mt-2">
                                    <button type="button"
                                            @onclick="HandleRequestAiSummary"
                                            disabled="@_isGeneratingAiSummary"
                                            class="h-9 px-4 rounded-full bg-[var(--inverse)] text-[var(--on-inverse)] font-black text-xs hover:opacity-90 transition-opacity disabled:opacity-50 cursor-pointer inline-flex items-center gap-1.5">
                                        <Icon Name="bot" Size="14" />
                                        <span>@(_isGeneratingAiSummary ? "Generando..." : "Generar síntesis IA")</span>
                                    </button>
                                    <button type="button"
                                            @onclick="() => _isFoundingModalOpen = true"
                                            class="h-9 px-4 rounded-full border border-[var(--rule)] bg-transparent text-[var(--ink)] font-black text-xs hover:bg-[var(--paper-2)] transition-colors cursor-pointer inline-flex items-center gap-1.5">
                                        <Icon Name="pen-line" Size="14" />
                                        <span>Editar veredicto</span>
                                    </button>
                                    <button type="button"
                                            @onclick="() => _isEditorModalOpen = true"
                                            class="h-9 px-4 rounded-full border border-[var(--rule)] bg-transparent text-[var(--ink)] font-black text-xs hover:bg-[var(--paper-2)] transition-colors cursor-pointer inline-flex items-center gap-1.5">
                                        <Icon Name="pen-line" Size="14" />
                                        <span>Editar Ficha</span>
                                    </button>
                                    <button type="button"
                                            @onclick="OpenSocialCardModal"
                                            class="h-9 px-4 rounded-full border border-[var(--rule)] bg-transparent text-[var(--ink)] font-black text-xs hover:bg-[var(--paper-2)] transition-colors cursor-pointer inline-flex items-center gap-1.5">
                                        <Icon Name="palette" Size="14" />
                                        <span>Cartel para Redes</span>
                                    </button>
                                </div>
                            }
                        </div>
                    </aside>
                }

                @if (_activeTab == "resumen")
                {
                    @* BLOQUE 03: FICHA TÉCNICA DETALLADA Y ESCALABILIDAD *@
                    <section id="bloque-03-ficha-tecnica" class="flex flex-col gap-10" aria-label="Ficha Técnica &amp; Escalabilidad">
                        @* Escalabilidad *@
                        <div class="flex flex-col gap-3.5">
                            <div class="flex items-baseline justify-between gap-3">
                                <h2 class="text-xl sm:text-2xl font-black text-[var(--ink)] tracking-tight m-0">¿A cuántos se disfruta?</h2>
                                <span class="text-xs font-bold text-[var(--muted)]">Semáforo de jugadores</span>
                            </div>
                            <p class="text-xs text-[var(--muted)] m-0">Basado en miles de partidas y votaciones del hobby para saber si el juego realmente escala bien en mesa.</p>
                            <ScalabilityTrafficLight Entries="@Game.Scalability" IdealText="@Game.IdealPlayerCountText" />
                        </div>

                        @* ADN lúdico / Ficha Técnica *@
                        <div class="flex flex-col gap-3.5">
                            <div class="flex items-baseline justify-between gap-3">
                                <h2 class="text-xl sm:text-2xl font-black text-[var(--ink)] tracking-tight m-0">
                                    @(_isTechOpen ? "Ficha Técnica Completa" : "ADN Lúdico")
                                </h2>
                                <button type="button"
                                        @onclick="() => _isTechOpen = !_isTechOpen"
                                        class="text-xs font-extrabold text-[var(--accent)] border-b-2 border-[var(--accent)] hover:opacity-80 transition-opacity cursor-pointer">
                                    @(_isTechOpen ? "Ver menos" : "Ver todos los detalles")
                                </button>
                            </div>

                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                                <div class="flex flex-col gap-1 pt-2.5 border-t border-[var(--line)]">
                                    <span class="text-[11px] font-black uppercase tracking-wider text-[var(--muted)]">Estilo</span>
                                    <b class="text-sm sm:text-base font-extrabold text-[var(--ink)] leading-snug">@GetStyleText(Game.Style)</b>
                                </div>
                                <div class="flex flex-col gap-1 pt-2.5 border-t border-[var(--line)]">
                                    <span class="text-[11px] font-black uppercase tracking-wider text-[var(--muted)]">Edad mínima</span>
                                    <b class="text-sm sm:text-base font-extrabold text-[var(--ink)] leading-snug">@Game.Age.BoxAge+ años (Comunidad: @Game.Age.CommunityAge+)</b>
                                </div>
                                <div class="flex flex-col gap-1 pt-2.5 border-t border-[var(--line)]">
                                    <span class="text-[11px] font-black uppercase tracking-wider text-[var(--muted)]">Duración</span>
                                    <b class="text-sm sm:text-base font-extrabold text-[var(--ink)] leading-snug">@Game.Duration.EstimatedPerPlayerMinutes min/jugador</b>
                                </div>
                                <div class="flex flex-col gap-1 pt-2.5 border-t border-[var(--line)]">
                                    <span class="text-[11px] font-black uppercase tracking-wider text-[var(--muted)]">Año publicación</span>
                                    <b class="text-sm sm:text-base font-extrabold text-[var(--ink)] leading-snug">@Game.YearPublished</b>
                                </div>
                                <div class="flex flex-col gap-1 pt-2.5 border-t border-[var(--line)]">
                                    <span class="text-[11px] font-black uppercase tracking-wider text-[var(--muted)]">Confrontación</span>
                                    <b class="text-sm sm:text-base font-extrabold text-[var(--ink)] leading-snug">@GetConfrontationText(Game.Confrontation)</b>
                                </div>
                                <div class="flex flex-col gap-1 pt-2.5 border-t border-[var(--line)]">
                                    <span class="text-[11px] font-black uppercase tracking-wider text-[var(--muted)]">Huella en mesa</span>
                                    <b class="text-sm sm:text-base font-extrabold text-[var(--ink)] leading-snug">@GetFootprintText(Game.Footprint)</b>
                                </div>
                                <div class="flex flex-col gap-1 pt-2.5 border-t border-[var(--line)]">
                                    <span class="text-[11px] font-black uppercase tracking-wider text-[var(--muted)]">Modo solitario</span>
                                    <b class="text-sm sm:text-base font-extrabold text-[var(--ink)] leading-snug">@(Game.IsOfficialSolo ? "Oficial" : "No oficial / Sin solitario")</b>
                                </div>
                                <div class="flex flex-col gap-1 pt-2.5 border-t border-[var(--line)]">
                                    <span class="text-[11px] font-black uppercase tracking-wider text-[var(--muted)]">Dependencia idioma</span>
                                    <b class="text-sm sm:text-base font-extrabold text-[var(--ink)] leading-snug">@GetLanguageText(Game.Language)</b>
                                </div>
                            </div>
                        </div>

                        @* Vídeos destacados en Resumen *@
                        @{
                            var allFeaturedVideos = (_mediaHub?.Tutorials ?? [])
                                .Concat(_mediaHub?.Playthroughs ?? [])
                                .Concat(_mediaHub?.QuickOverviews ?? [])
                                .Concat(_mediaHub?.ReviewsAndOpinions ?? [])
                                .Where(v => !v.IsBroken)
                                .ToList();
                        }
                        @if (allFeaturedVideos.Count > 0)
                        {
                            var topVideos = allFeaturedVideos.Take(2).ToList();
                            <div class="flex flex-col gap-3.5">
                                <div class="flex items-baseline justify-between gap-3">
                                    <h2 class="text-xl sm:text-2xl font-black text-[var(--ink)] tracking-tight m-0">Vídeos destacados</h2>
                                    <button type="button"
                                            @onclick='() => SelectTab("videos")'
                                            class="text-xs font-extrabold text-[var(--accent)] border-b-2 border-[var(--accent)] hover:opacity-80 transition-opacity cursor-pointer">
                                        Ver los @allFeaturedVideos.Count vídeos
                                    </button>
                                </div>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    @foreach (var vid in topVideos)
                                    {
                                        <a href="@vid.Url" target="_blank" rel="noopener noreferrer" class="flex gap-3 items-center group">
                                            <div class="relative shrink-0 w-28 sm:w-32 aspect-video rounded-lg overflow-hidden bg-neutral-900 shadow">
                                                <img src="@vid.ThumbnailUrl" alt="@vid.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
                                                <span class="absolute left-1.5 bottom-1.5 py-0.5 px-2 rounded-full bg-[#22180F]/90 text-[#FFF8EE] text-[10px] font-extrabold flex items-center gap-1">
                                                    <Icon Name="play" Size="10" />
                                                    <span>@(string.IsNullOrWhiteSpace(vid.FormattedDuration) ? "Vídeo" : vid.FormattedDuration)</span>
                                                </span>
                                            </div>
                                            <div class="flex flex-col gap-0.5 min-w-0">
                                                <b class="text-xs sm:text-sm font-extrabold text-[var(--ink)] leading-snug line-clamp-2 group-hover:text-[var(--accent)] transition-colors">@vid.Title</b>
                                                <span class="text-xs text-[var(--muted)] truncate">@vid.AuthorChannel</span>
                                            </div>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </section>
                }
                else if (_activeTab == "expansiones")
                {
                    @* BLOQUE 04: EXPANSIONES Y DÓNDE COMPRAR *@
                    <section id="bloque-04-expansiones-tiendas" class="flex flex-col gap-6" aria-label="Bloque 04: Expansiones y tiendas">
                        <div class="flex items-baseline justify-between gap-3">
                            <div class="flex items-baseline gap-3">
                                <b class="text-3xl sm:text-4xl font-black text-[var(--accent)] tracking-[-0.06em] leading-none">04</b>
                                <h2 class="text-xl sm:text-2xl font-black text-[var(--ink)] tracking-tight">Expansiones &amp; Dónde Comprar</h2>
                            </div>
                            @if (_expansions.Count > 0)
                            {
                                <span class="py-1 px-3 rounded-full bg-[var(--paper-2)] text-[var(--ink)] font-extrabold text-xs flex items-center gap-1">
                                    <Icon Name="package" Size="14" /> @_expansions.Count expansiones
                                </span>
                            }
                        </div>

                        <ExpansionEcosystemSection
                            Expansions="@_expansions"
                            SisterExpansions="@_sisterExpansions"
                            SisterSynergies="@_sisterSynergies"
                            Game="@Game"
                            OnExpansionAporteUpdated="HandleExpansionAporteUpdated" />
                    </section>
                }
                else if (_activeTab == "videos" || _activeTab == "fundas" || _activeTab == "dudas")
                {
                    @* BLOQUE 05: HUB MULTIMEDIA Y OPINIONES *@
                    <section id="bloque-05-multimedia-comunidad" class="flex flex-col gap-6" aria-label="Bloque 05: Multimedia y opiniones">
                        <div class="flex items-baseline justify-between gap-3">
                            <div class="flex items-baseline gap-3">
                                <b class="text-3xl sm:text-4xl font-black text-[var(--accent)] tracking-[-0.06em] leading-none">05</b>
                                <h2 class="text-xl sm:text-2xl font-black text-[var(--ink)] tracking-tight">Multimedia &amp; Comunidad</h2>
                            </div>
                        </div>

                        @* Pestañas secundarias contratadas por GameDetailEditorialContractTests *@
                        <div class="flex flex-wrap items-center gap-2 border-b border-[var(--line)] pb-3">
                            <button type="button"
                                    @onclick='() => _activeSecondaryTab = "media"'
                                    class="px-4 py-2 rounded-full font-black text-xs transition-colors inline-flex items-center gap-1.5 @(_activeSecondaryTab == "media" ? "bg-[var(--ink)] text-[var(--on-inverse)]" : "text-[var(--muted)] hover:text-[var(--ink)]")">
                                <Icon Name="play-circle" Size="14" />
                                <span>Hub Multimedia (@(_mediaHub?.TotalCount ?? 0))</span>
                            </button>
                            <button type="button"
                                    @onclick='() => _activeSecondaryTab = "sleeves"'
                                    class="px-4 py-2 rounded-full font-black text-xs transition-colors inline-flex items-center gap-1.5 @(_activeSecondaryTab == "sleeves" ? "bg-[var(--ink)] text-[var(--on-inverse)]" : "text-[var(--muted)] hover:text-[var(--ink)]")">
                                <Icon Name="shield" Size="14" />
                                <span>Guía de Fundas (@(Game.Sleeves?.Count ?? 0))</span>
                            </button>
                            <button type="button"
                                    @onclick='() => _activeSecondaryTab = "qa"'
                                    class="px-4 py-2 rounded-full font-black text-xs transition-colors inline-flex items-center gap-1.5 @(_activeSecondaryTab == "qa" ? "bg-[var(--ink)] text-[var(--on-inverse)]" : "text-[var(--muted)] hover:text-[var(--ink)]")">
                                <Icon Name="help-circle" Size="14" />
                                <span>Consultorio de Reglas</span>
                            </button>
                        </div>

                        @if (_activeSecondaryTab == "media")
                        {
                            <MultimediaHub MediaHub="@_mediaHub" GameId="@Game.Id" GameTitle="@Game.SpanishTitle" OnMediaChanged="ReloadMediaAsync" />
                        }
                        else if (_activeSecondaryTab == "sleeves")
                        {
                            <SleeveGuideCard Sleeves="@Game.Sleeves" />
                        }
                        else if (_activeSecondaryTab == "qa")
                        {
                            <RuleQuestionsSection GameId="@Game.Id" GameTitle="@Game.SpanishTitle" />
                        }
                    </section>
                }
            </div>

            @* Columna Lateral Fija (Desktop / Sticky top-20) *@
            <aside id="donde-comprar" class="flex flex-col gap-7 lg:col-span-4 lg:sticky lg:top-20">
                <StoreOffersCard Offers="@Game.PurchaseLinks" GameTitle="@Game.SpanishTitle" GameSlug="@Game.Slug" GameId="@Game.Id" IsSidebar="true" />

                <UserReviewCard
                    Review="@_userReview"
                    CanReview="@CanUserReview()"
                    DisabledReviewReason="@GetDisabledReviewReason()"
                    OnEditClicked="OpenReviewModal" />
            </aside>
        </div>
    </div>

    @* BARRA INFERIOR MÓVIL FIJA (STICKY BOTTOM MOBILE BAR) *@
    <div class="lg:hidden fixed bottom-0 left-0 right-0 z-40 bg-[var(--inverse)] text-[var(--on-inverse)] px-4 py-3 border-t border-[var(--line)] shadow-2xl flex items-center justify-between gap-3">
        <div class="flex flex-col">
            <span class="text-[11px] font-extrabold uppercase text-[var(--muted)] leading-tight">Mejor precio hoy</span>
            <b class="text-lg font-black text-[var(--ticker)] leading-tight">@GetBestPriceLabel()</b>
        </div>
        <button type="button"
                @onclick="HandlePrimaryCollectionClick"
                class="h-11 px-5 rounded-full font-black text-xs inline-flex items-center gap-1.5 transition-transform active:scale-95 shadow-md cursor-pointer @(_collectionItem?.Status == CollectionStatus.InCollection ? "bg-[var(--accent-green)] text-[#FFF8EE]" : "bg-[var(--brand)] text-[var(--on-brand)]")">
            <Icon Name="@GetCollectionIconName()" Size="14" />
            <span>@GetCollectionButtonLabel()</span>
        </button>
    </div>



    @* PANEL FLOTANTE DE HERRAMIENTAS STAFF (ADMIN) *@
    @if (IsStaff)
    {
        <GameStaffToolsPanel
            Game="@Game"
            AiSummary="@_aiSummary"
            FoundingVerdict="@_foundingVerdict"
            IsGeneratingAiSummary="@_isGeneratingAiSummary"
            OnEditMetadata="() => _isEditorModalOpen = true"
            OnRequestAiSummary="HandleRequestAiSummary"
            OnAssociateBgg="() => _isAssociateBggModalOpen = true"
            OnEditVerdict="() => _isFoundingModalOpen = true"
            OnSocialCard="OpenSocialCardModal"
            OnOpenReports="() => _isReportModalOpen = true" />
    }

    @* Modales del Ecosistema *@
    <AssociateBggModal
        @bind-IsOpen="_isAssociateBggModalOpen"
        GameId="@Game.Id"
        GameTitle="@Game.SpanishTitle"
        CurrentBggId="@Game.BggId"
        OnBggAssociated="HandleBggAssociated" />

    <SocialCardModal
        IsOpen="@_isSocialCardModalOpen"
        Data="@_socialCardData"
        OnClose="() => _isSocialCardModalOpen = false" />

    <RecordPlayModal
        IsOpen="@_isRecordPlayModalOpen"
        GameId="@Game.Id"
        GameTitle="@Game.SpanishTitle"
        OnPlayRecorded="HandlePlayRecorded"
        OnClose="() => _isRecordPlayModalOpen = false" />

    <ReviewBottomSheet
        IsOpen="@_isReviewModalOpen"
        ExistingReview="@_userReview"
        OnSubmitReview="HandleSubmitReview"
        OnClose="() => _isReviewModalOpen = false" />

    <FoundingVerdictModal
        IsOpen="@_isFoundingModalOpen"
        GameId="@Game.Id"
        GameTitle="@Game.SpanishTitle"
        ExistingVerdict="@_foundingVerdict"
        OnSaveVerdict="HandleSaveFoundingVerdict"
        OnClose="() => _isFoundingModalOpen = false" />

    <GameReportModal
        IsOpen="@_isReportModalOpen"
        GameId="@Game.Id"
        GameSlug="@Game.Slug"
        GameTitle="@Game.SpanishTitle"
        OnClose="() => _isReportModalOpen = false" />

    <GameEditorModal
        @bind-IsOpen="_isEditorModalOpen"
        Game="@Game"
        OnGameUpdated="HandleGameUpdated" />

    @if (_isPlayedPromptModalOpen && Game != null)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs animate-fade-in"
             role="dialog"
             aria-modal="true"
             aria-labelledby="played-prompt-title">
            <div class="w-full max-w-sm rounded-3xl bg-[var(--card)] border-2 border-[var(--rule)] p-6 shadow-2xl space-y-4 text-center">
                <div class="w-12 h-12 mx-auto rounded-full bg-[var(--brand)]/10 text-[var(--brand)] flex items-center justify-center">
                    <Icon Name="dices" Size="24" />
                </div>
                <div class="space-y-1">
                    <h3 id="played-prompt-title" class="text-base font-black text-[var(--ink)]">
                        ¿Has jugado al juego @Game.SpanishTitle?
                    </h3>
                    <p class="text-xs text-[var(--muted)]">
                        Para mantener tu ludoteca al día, indícanos si ya lo has probado en mesa.
                    </p>
                </div>
                <div class="flex items-center gap-3 pt-2">
                    <button type="button"
                            @onclick="HandlePlayedPromptNo"
                            class="flex-1 py-2.5 px-4 rounded-full border border-[var(--line)] hover:bg-[var(--paper-2)] text-[var(--muted)] hover:text-[var(--ink)] font-black text-xs transition-colors cursor-pointer">
                        No
                    </button>
                    <button type="button"
                            @onclick="HandlePlayedPromptYes"
                            class="flex-1 py-2.5 px-4 rounded-full bg-[var(--brand)] hover:opacity-90 text-[var(--on-brand)] font-black text-xs shadow-md transition-colors cursor-pointer">
                        Sí
                    </button>
                </div>
            </div>
        </div>
    }

    @* Componente oculto para compatibilidad de contrato si aplica *@
    <div class="hidden" aria-hidden="true">
        <GameImageCarousel
            CoverImageUrl="@Game.CoverImageUrl"
            BackCoverImageUrl="@Game.BackCoverImageUrl"
            TableImageUrl="@Game.TableImageUrl"
            GameTitle="@Game.SpanishTitle"
            IsExpansion="@Game.IsExpansion"
            @bind-SelectedKey="_selectedHeroImageKey" />
    </div>
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private GameDetailDto? Game { get; set; }
    private UserCollectionItemDto? _collectionItem;
    private UserReviewDto? _userReview;
    private FoundingVerdictDto? _foundingVerdict;
    private AiGameSummaryDto? _aiSummary;
    private GameMediaHubDto? _mediaHub;

    private IReadOnlyList<ExpansionSummaryDto> _expansions = [];
    private IReadOnlyList<ExpansionSummaryDto> _sisterExpansions = [];
    private IReadOnlyList<ExpansionSynergyDto> _sisterSynergies = [];
    private ParentGameSummaryDto? _parentGame;

    private bool _isLoading = true;
    private bool _isRecordPlayModalOpen;
    private bool _isReviewModalOpen;
    private bool _isFoundingModalOpen;
    private bool _isSocialCardModalOpen;
    private bool _isReportModalOpen;
    private bool _isEditorModalOpen;
    private bool _isAssociateBggModalOpen;
    private SocialCardDataDto? _socialCardData;
    private bool _isGeneratingAiSummary;
    private string? _aiSummaryMessage;
    private int _userPlaysCount;
    private bool _isPlayedPromptModalOpen;
    private string? _actionFeedbackMessage;
    private string _actionFeedbackType = "success";

    private string _selectedHeroImageKey = "cover";
    private string _activeTab = "resumen";
    private string _activeSecondaryTab = "media";
    private bool _isLibMenuOpen;
    private bool _isVerdictSlideOverOpen;
    private bool _isTechOpen;

    private void SelectTab(string tab)
    {
        _activeTab = tab;
        if (tab == "videos") _activeSecondaryTab = "media";
        else if (tab == "fundas") _activeSecondaryTab = "sleeves";
        else if (tab == "dudas") _activeSecondaryTab = "qa";
    }

    private record HeroImageInfo(string Key, string Label, string Url);

    private IReadOnlyList<HeroImageInfo> AvailableHeroImages
    {
        get
        {
            var list = new List<HeroImageInfo>();
            if (Game != null)
            {
                if (!string.IsNullOrWhiteSpace(Game.CoverImageUrl))
                    list.Add(new HeroImageInfo("cover", "Foto de portada", Game.CoverImageUrl));
                if (!string.IsNullOrWhiteSpace(Game.BackCoverImageUrl))
                    list.Add(new HeroImageInfo("back", "Contraportada", Game.BackCoverImageUrl));
                if (!string.IsNullOrWhiteSpace(Game.TableImageUrl))
                    list.Add(new HeroImageInfo("table", "En mesa", Game.TableImageUrl));
            }
            if (list.Count == 0)
                list.Add(new HeroImageInfo("cover", "Carátula", "/images/game-placeholder.svg"));
            return list;
        }
    }

    private int CurrentHeroImageIndex
    {
        get
        {
            var list = AvailableHeroImages;
            var idx = list.ToList().FindIndex(img => img.Key.Equals(_selectedHeroImageKey, StringComparison.OrdinalIgnoreCase));
            return idx >= 0 ? idx : 0;
        }
    }

    private int AvailableHeroImagesCount => AvailableHeroImages.Count;

    private string CurrentHeroImageUrl => AvailableHeroImages.Count > 0
        ? AvailableHeroImages[CurrentHeroImageIndex].Url
        : (Game?.CoverImageUrl ?? string.Empty);

    private string CurrentHeroImageLabel => AvailableHeroImages.Count > 0
        ? AvailableHeroImages[CurrentHeroImageIndex].Label
        : "Carátula";

    private void NextHeroImage()
    {
        var count = AvailableHeroImagesCount;
        if (count <= 1) return;
        var nextIdx = (CurrentHeroImageIndex + 1) % count;
        _selectedHeroImageKey = AvailableHeroImages[nextIdx].Key;
    }

    private void PreviousHeroImage()
    {
        var count = AvailableHeroImagesCount;
        if (count <= 1) return;
        var prevIdx = (CurrentHeroImageIndex - 1 + count) % count;
        _selectedHeroImageKey = AvailableHeroImages[prevIdx].Key;
    }

    private string? _userCountryCode;
    private string _userCountryName = "España";

    private bool IsStaff => CurrentUserService.IsFoundingTeam || CurrentUserService.IsInRole("Moderator");
    private bool HasSession => !string.IsNullOrWhiteSpace(CurrentUserService.UserId);

    private string GetFoundingBadgeText()
    {
        if (_foundingVerdict != null)
        {
            return _foundingVerdict.Recommendation switch
            {
                FoundingRecommendation.MustPlay => "Imprescindible",
                FoundingRecommendation.RecommendedWithAdaptations => "Recomendado",
                _ => "Prescindible"
            };
        }
        if (Game != null)
        {
            if (Game.LudistRating >= 8.5) return "Imprescindible";
            if (Game.LudistRating >= 7.5) return "Recomendado";
            if (Game.LudistRating >= 6.0) return "Interesante";
        }
        return "Pendiente";
    }

    private static string GetStyleShortText(GameStyle style) => style switch
    {
        GameStyle.Eurogame => "Euro",
        GameStyle.Ameritrash => "Temático",
        GameStyle.PartyGame => "Party",
        GameStyle.FillerAbstract => "Filler",
        _ => "Narrativo"
    };

    private string GetComplexityShortText()
    {
        if (Game == null) return "Medio";
        if (Game.Style == GameStyle.PartyGame || Game.Style == GameStyle.FillerAbstract || (Game.Duration.MaxMinutes <= 30 && Game.Age.CommunityAge <= 10))
            return "Ligero";
        if (Game.Duration.MaxMinutes >= 120 || Game.Age.CommunityAge >= 14 || (Game.Duration.MaxMinutes >= 90 && Game.Style == GameStyle.Eurogame))
            return "Duro";
        return "Medio";
    }

    private string GetDurationDisplayText()
    {
        if (Game == null) return "60 min";
        if (Game.Duration.MinMinutes > 0 && Game.Duration.MaxMinutes > 0)
        {
            return Game.Duration.MinMinutes == Game.Duration.MaxMinutes
                ? $"{Game.Duration.MinMinutes} min"
                : $"{Game.Duration.MinMinutes}–{Game.Duration.MaxMinutes} min";
        }
        return $"{Game.Duration.EstimatedPerPlayerMinutes} min";
    }

    private string GetIdealShortPlayerText()
    {
        var raw = string.IsNullOrWhiteSpace(Game?.IdealPlayerCountText) ? GetPlayerRangeText() : Game.IdealPlayerCountText;
        if (string.IsNullOrWhiteSpace(raw)) return "1-4";
        var clean = raw.Trim();
        if (clean.StartsWith("Ideal:", StringComparison.OrdinalIgnoreCase))
            clean = clean["Ideal:".Length..].Trim();
        if (clean.StartsWith("Ideal a", StringComparison.OrdinalIgnoreCase))
            clean = clean["Ideal a".Length..].Trim();
        if (clean.StartsWith("a ", StringComparison.OrdinalIgnoreCase))
            clean = clean[2..].Trim();
        if (clean.EndsWith(" jugadores", StringComparison.OrdinalIgnoreCase))
            clean = clean[..^" jugadores".Length].Trim();
        return clean;
    }

    private string GetShortVerdictSnippet()
    {
        if (_foundingVerdict != null && !string.IsNullOrWhiteSpace(_foundingVerdict.OverallVerdict))
        {
            var text = _foundingVerdict.OverallVerdict.Trim();
            return text.Length > 130 ? text[..127] + "..." : text;
        }
        if (_aiSummary != null && !string.IsNullOrWhiteSpace(_aiSummary.GeneralVerdict))
        {
            var text = _aiSummary.GeneralVerdict.Trim();
            return text.Length > 130 ? text[..127] + "..." : text;
        }
        return "Decisiones encadenadas y mecánicas pulidas que transforman la mesa.";
    }

    private string GetCollectionButtonLabel()
    {
        if (_collectionItem?.Status == CollectionStatus.InCollection)
            return "En mi ludoteca";
        if (_collectionItem?.Status == CollectionStatus.WantToBuy)
            return "En lista de deseos";
        if (_collectionItem?.IsPlayed == true)
            return "Jugado";
        return "Añadir a mi ludoteca";
    }

    private string GetCollectionIconName()
    {
        if (_collectionItem?.Status == CollectionStatus.InCollection)
            return "check";
        if (_collectionItem?.Status == CollectionStatus.WantToBuy)
            return "heart";
        if (_collectionItem?.IsPlayed == true)
            return "check";
        return "library";
    }

    private async Task HandlePrimaryCollectionClick()
    {
        if (_collectionItem?.Status == CollectionStatus.InCollection)
        {
            _isLibMenuOpen = !_isLibMenuOpen;
            return;
        }
        await HandleStatusSelected(CollectionStatus.InCollection);
    }

    private async Task SelectCollectionStatus(CollectionStatus status)
    {
        _isLibMenuOpen = false;
        await HandleStatusSelected(status);
    }

    private async Task SelectTogglePlayed()
    {
        _isLibMenuOpen = false;
        await HandleTogglePlayed();
    }

    private async Task HandleShareClick()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Navigation.Uri);
            _actionFeedbackType = "success";
            _actionFeedbackMessage = "¡Enlace copiado al portapapeles!";
        }
        catch
        {
            _actionFeedbackType = "success";
            _actionFeedbackMessage = "Comparte este juego copiando la dirección de tu navegador.";
        }
    }

    private string GetBestPriceLabel()
    {
        if (Game?.PurchaseLinks == null || Game.PurchaseLinks.Count == 0) return "Consultar tiendas";
        var inStockOffers = Game.PurchaseLinks.Where(p => p.Price.HasValue && p.Price.Value > 0 && p.InStock).ToList();
        if (inStockOffers.Count > 0)
        {
            var min = inStockOffers.MinBy(p => p.Price!.Value);
            return min != null ? $"{min.FormattedPrice} en {min.StoreName}" : "Consultar tiendas";
        }
        var anyPriced = Game.PurchaseLinks.Any(p => p.Price.HasValue && p.Price.Value > 0);
        return anyPriced ? "Agotado en tiendas" : "Consultar tiendas";
    }

    private string GetHistoricalLowLabel()
    {
        if (Game?.PurchaseLinks == null || Game.PurchaseLinks.Count == 0) return "Sin datos";
        var validOffers = Game.PurchaseLinks.Where(p => p.Price.HasValue && p.Price.Value > 0).ToList();
        if (validOffers.Count == 0) return "Sin datos";
        var min = validOffers.MinBy(p => p.Price!.Value);
        return min?.Price.HasValue == true ? $"{min.Price.Value:0.00} €" : "Sin datos";
    }

    private string GetCleanIdealPlayerText()
    {
        var raw = string.IsNullOrWhiteSpace(Game?.IdealPlayerCountText) ? GetPlayerRangeText() : Game.IdealPlayerCountText;
        if (string.IsNullOrWhiteSpace(raw)) return "Ideal a 1-4 jugadores";
        var clean = raw.Trim();
        if (clean.StartsWith("Ideal:", StringComparison.OrdinalIgnoreCase))
            clean = clean["Ideal:".Length..].Trim();
        if (clean.StartsWith("Ideal a", StringComparison.OrdinalIgnoreCase))
            clean = clean["Ideal a".Length..].Trim();
        if (clean.StartsWith("a ", StringComparison.OrdinalIgnoreCase))
            clean = clean[2..].Trim();
        return $"Ideal a {clean}";
    }

    private string GetHighImpactQuote()
    {
        if (!string.IsNullOrWhiteSpace(_foundingVerdict?.OverallVerdict))
            return _foundingVerdict.OverallVerdict;
        if (!string.IsNullOrWhiteSpace(_aiSummary?.GeneralVerdict))
            return _aiSummary.GeneralVerdict;
        if (!string.IsNullOrWhiteSpace(Game?.Description))
        {
            var desc = Game.Description.Trim();
            return desc.Length > 220 ? desc[..217] + "..." : desc;
        }
        return "Ficha en evaluación editorial por la Mesa Fundadora.";
    }

    private string GetVerdictSourceLabel()
    {
        if (_foundingVerdict != null)
            return $"Mesa Fundadora de Ludeka &bull; por {_foundingVerdict.AuthorName}";
        if (_aiSummary != null)
            return $"Síntesis estructurada con IA ({_aiSummary.Model})";
        return "En evaluación por el equipo editorial de Ludeka";
    }

    private string GetVerdictPros()
    {
        if (_foundingVerdict != null && !string.IsNullOrWhiteSpace(_foundingVerdict.TwoPlayerVerdict))
            return _foundingVerdict.TwoPlayerVerdict;
        if (_aiSummary != null && !string.IsNullOrWhiteSpace(_aiSummary.ScalabilitySummary))
            return _aiSummary.ScalabilitySummary;
        return "Mecánicas pulidas y alta rejugabilidad según el consenso lúdico.";
    }

    private string GetVerdictCons()
    {
        if (_foundingVerdict != null && _foundingVerdict.Recommendation == FoundingRecommendation.RecommendedWithAdaptations)
            return "Requiere pequeñas adaptaciones o curva de aprendizaje pronunciada en primeras partidas.";
        if (_aiSummary != null && !string.IsNullOrWhiteSpace(_aiSummary.FootprintSummary))
            return _aiSummary.FootprintSummary;
        return "Exige espacio en mesa o tiempo de despliegue según el número de participantes.";
    }

    private string GetVerdictTargetAudience()
    {
        if (_foundingVerdict != null && !string.IsNullOrWhiteSpace(_foundingVerdict.FamilyVerdict))
            return _foundingVerdict.FamilyVerdict;
        if (_aiSummary != null && !string.IsNullOrWhiteSpace(_aiSummary.AgeSummary))
            return _aiSummary.AgeSummary;
        return $"Recomendado para mesas a partir de {Game?.Age?.BoxAge ?? 10} años y grupos afines al estilo {Game?.Style}.";
    }

    private void HandleGameUpdated(GameDetailDto updated)
    {
        Game = updated;
        StateHasChanged();
    }

    private async Task HandleBggAssociated(int newBggId)
    {
        if (Game != null)
        {
            Game = await CatalogService.GetGameBySlugAsync(Slug);
            StateHasChanged();
        }
    }

    private async Task HandleExpansionAporteUpdated()
    {
        if (!string.IsNullOrWhiteSpace(Slug))
        {
            var updated = await CatalogService.GetGameBySlugAsync(Slug);
            if (updated != null)
            {
                Game = updated;
                StateHasChanged();
            }
        }
    }

    private void OpenSocialCardModal()
    {
        if (Game == null) return;

        string? verdictBadge = null;
        if (_foundingVerdict != null)
        {
            verdictBadge = _foundingVerdict.Recommendation switch
            {
                FoundingRecommendation.MustPlay => "Imprescindible (Mesa Fundadora)",
                FoundingRecommendation.RecommendedWithAdaptations => "Recomendado con adaptaciones",
                _ => "Prescindible"
            };
        }

        _socialCardData = new SocialCardDataDto(
            GameTitle: Game.SpanishTitle,
            OriginalTitle: Game.OriginalTitle,
            YearPublished: Game.YearPublished,
            Designer: Game.Designer,
            Publisher: Game.Publisher,
            CoverImageUrl: Game.CoverImageUrl,
            Rating: Game.LudistRating > 0 ? Game.LudistRating : Game.BggRating,
            StyleText: Game.Style.ToString(),
            ConfrontationText: Game.Confrontation.ToString(),
            IdealPlayersText: Game.IdealPlayerCountText ?? "Consulta ficha",
            EstimatedDurationPerPlayer: Game.Duration.EstimatedPerPlayerMinutes,
            FoundingVerdictBadge: verdictBadge);

        _isSocialCardModalOpen = true;
    }

    private async Task LoadUserCountryAsync()
    {
        try
        {
            var rawCountry = await PreferenceService.GetUserCountryAsync(CurrentUserService.UserId);
            var countryInfo = CountryCatalog.FindByNameOrCode(rawCountry) ?? CountryCatalog.Spain;
            _userCountryCode = countryInfo.Code;
            _userCountryName = countryInfo.Name;
        }
        catch
        {
            _userCountryCode = "ES";
            _userCountryName = "España";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _isLoading = true;
            _selectedHeroImageKey = "cover";
            await LoadUserCountryAsync();
            Game = await CatalogService.GetGameBySlugAsync(Slug);
            if (Game != null)
            {
                await LoadUserDataAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar la ficha del juego {Slug}", Slug);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadUserDataAsync()
    {
        if (Game == null) return;

        try
        {
            _collectionItem = await LibraryService.GetCollectionStateAsync(Game.Id);
            _userReview = await LibraryService.GetUserReviewAsync(Game.Id);
            await RefreshPlaysCountAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error al cargar datos de biblioteca de usuario para el juego {GameId}", Game.Id);
        }

        try
        {
            _foundingVerdict = await FoundingService.GetVerdictByGameIdAsync(Game.Id);
            if (_foundingVerdict == null)
            {
                _aiSummary = await FoundingService.GetAiSummaryForGameAsync(Game.Id);
            }
            else
            {
                _aiSummary = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error al cargar veredicto o resumen IA para el juego {GameId}", Game.Id);
        }

        try
        {
            _mediaHub = await MediaService.GetGameMediaAsync(Game.Id);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error al cargar multimedia para el juego {GameId}", Game.Id);
        }

        try
        {
            if (Game.IsExpansion)
            {
                _parentGame = Game.BaseGame ?? (Game.BaseGameId.HasValue ? await ExpansionService.GetParentGameForExpansionAsync(Game.Id) : null);
                if (Game.BaseGameId.HasValue)
                {
                    var allSisters = await ExpansionService.GetExpansionsForBaseGameAsync(Game.BaseGameId.Value);
                    _sisterExpansions = allSisters.Where(s => s.Id != Game.Id).ToList();
                    _sisterSynergies = await ExpansionService.GetSynergiesForExpansionAsync(Game.Id);
                }
            }
            else
            {
                _expansions = await ExpansionService.GetExpansionsForBaseGameAsync(Game.Id);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error al cargar ecosistema de expansiones para el juego {GameId}", Game.Id);
        }
    }

    private bool CanUserReview()
    {
        if (_userReview != null) return true;
        if (_collectionItem != null && _collectionItem.Status == CollectionStatus.WantToBuy && !_collectionItem.IsPlayed)
        {
            return false;
        }
        return true;
    }

    private string? GetDisabledReviewReason()
    {
        if (_collectionItem != null && _collectionItem.Status == CollectionStatus.WantToBuy && !_collectionItem.IsPlayed)
        {
            return "Tienes este juego en tu lista de compra. Para valorarlo, márcalo como «Jugado» o registra una partida.";
        }
        return null;
    }

    private void OpenReviewModal()
    {
        if (!CanUserReview()) return;
        _isReviewModalOpen = true;
    }

    private async Task HandleTogglePlayed()
    {
        if (Game == null) return;
        bool wasUnrated = _userReview == null;
        bool wasPlayed = _collectionItem?.IsPlayed == true;

        try
        {
            _collectionItem = await LibraryService.TogglePlayedStateAsync(Game.Id);
            await RefreshPlaysCountAsync();
            _actionFeedbackMessage = null;
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
            return;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al alternar estado jugado para {GameId}", Game.Id);
            _actionFeedbackType = "error";
            _actionFeedbackMessage = "No se pudo alternar el estado de jugado. Por favor, inténtalo de nuevo.";
            return;
        }

        if (wasUnrated && !wasPlayed && _collectionItem?.IsPlayed == true)
        {
            _isReviewModalOpen = true;
        }
    }

    private async Task HandlePlayRecorded(RecordPlayRequest req)
    {
        if (Game == null) return;

        try
        {
            await PlayLogService.RecordPlayAsync(req);
            _collectionItem = await LibraryService.GetCollectionStateAsync(Game.Id);
            await RefreshPlaysCountAsync();
            _actionFeedbackMessage = null;
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al registrar partida para {GameId}", Game.Id);
            _actionFeedbackType = "error";
            _actionFeedbackMessage = "No se pudo registrar la partida. Por favor, inténtalo de nuevo.";
        }
    }

    private async Task RefreshPlaysCountAsync()
    {
        if (Game == null) return;
        var plays = await PlayLogService.GetGamePlaysAsync(Game.Id);
        _userPlaysCount = plays.Count;
    }

    private async Task HandleStatusSelected(CollectionStatus status)
    {
        if (Game == null) return;

        bool wasUnrated = _userReview == null;
        var prevStatus = _collectionItem?.Status;

        try
        {
            _collectionItem = await LibraryService.SetCollectionStateAsync(Game.Id, status);
            _actionFeedbackMessage = null;
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
            return;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al actualizar estado de colección para {GameId}", Game.Id);
            _actionFeedbackType = "error";
            _actionFeedbackMessage = "No se pudo actualizar el estado en tu colección. Por favor, inténtalo de nuevo.";
            return;
        }

        if (status == CollectionStatus.InCollection && _collectionItem != null && prevStatus != status)
        {
            if (!_collectionItem.IsPlayed)
            {
                _isPlayedPromptModalOpen = true;
                return;
            }

            if (wasUnrated)
            {
                _isReviewModalOpen = true;
            }
        }
    }

    private async Task HandlePlayedPromptYes()
    {
        _isPlayedPromptModalOpen = false;
        if (Game == null) return;

        try
        {
            _collectionItem = await LibraryService.SetPlayedStateAsync(Game.Id, true);
            await RefreshPlaysCountAsync();
            _isReviewModalOpen = true;
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al marcar como jugado {GameId}", Game.Id);
            _actionFeedbackType = "error";
            _actionFeedbackMessage = "No se pudo actualizar el estado de jugado. Por favor, inténtalo de nuevo.";
        }
    }

    private void HandlePlayedPromptNo()
    {
        _isPlayedPromptModalOpen = false;
        _actionFeedbackType = "success";
        _actionFeedbackMessage = "¡Añadido a tu ludoteca! Recuerda cuando lo juegues venir a marcarlo como jugado y valorar el juego.";
    }

    private async Task HandleSubmitReview(SubmitReviewRequest req)
    {
        if (Game == null) return;

        try
        {
            await LibraryService.SubmitReviewAsync(new SubmitReviewRequest(
                Game.Id,
                req.Score,
                req.MicroReview,
                req.PlayerCountVotes,
                req.FamilyExperience,
                req.PlayContext
            ));

            _actionFeedbackType = "success";
            _actionFeedbackMessage = "¡Valoración guardada correctamente!";

            Game = await CatalogService.GetGameBySlugAsync(Slug);
            await LoadUserDataAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
        }
        catch (InvalidOperationException ex)
        {
            _actionFeedbackType = "error";
            _actionFeedbackMessage = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al guardar valoración para {GameId}", Game?.Id);
            _actionFeedbackType = "error";
            _actionFeedbackMessage = "Hubo un error al guardar tu valoración. Por favor, inténtalo de nuevo.";
        }
    }

    private async Task HandleSaveFoundingVerdict(SaveFoundingVerdictRequest req)
    {
        if (Game == null) return;

        try
        {
            await FoundingService.SaveVerdictAsync(req);
            Game = await CatalogService.GetGameBySlugAsync(Slug);
            await LoadUserDataAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
        }
    }

    private async Task HandleRequestAiSummary()
    {
        if (Game == null || _isGeneratingAiSummary) return;

        _isGeneratingAiSummary = true;
        _aiSummaryMessage = null;

        try
        {
            _aiSummary = await FoundingService.RequestAiSummaryGenerationAsync(Game.Id);
            _aiSummaryMessage = "Síntesis estructurada generada y guardada correctamente con IA.";
            Game = await CatalogService.GetGameBySlugAsync(Slug);
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
        }
        catch (Exception ex)
        {
            _aiSummaryMessage = $"No se pudo generar la síntesis: {ex.Message}";
        }
        finally
        {
            _isGeneratingAiSummary = false;
        }
    }

    private async Task ReloadMediaAsync()
    {
        if (Game != null)
        {
            _mediaHub = await MediaService.GetGameMediaAsync(Game.Id);
            StateHasChanged();
        }
    }

    private string TitleForCountry => Game?.GetTitleForCountry(_userCountryCode) ?? string.Empty;
    private string PublisherForCountry => Game?.GetPublisherForCountry(_userCountryCode) ?? string.Empty;
    private bool HasLocalPublisher => !string.IsNullOrWhiteSpace(PublisherForCountry);
    private bool DiffersFromOriginal => HasLocalPublisher && !string.Equals(PublisherForCountry, Game?.Publisher, StringComparison.OrdinalIgnoreCase);
    private string? LocalPubSlug => HasLocalPublisher ? Ludeka.Core.Entities.Game.GenerateSlug(PublisherForCountry) : null;
    private string? OrigPubSlug => !string.IsNullOrWhiteSpace(Game?.Publisher) ? Ludeka.Core.Entities.Game.GenerateSlug(Game.Publisher) : null;

    private string GetPlayerRangeText()
    {
        if (Game == null || Game.Scalability.Count == 0) return "1–4";
        var min = Game.Scalability.Min(s => s.PlayerCount);
        var max = Game.Scalability.Max(s => s.PlayerCount);
        return min == max ? $"{min}" : $"{min}–{max}";
    }

    private static string GetLanguageText(LanguageDependence lang) => lang switch
    {
        LanguageDependence.None => "Nulo (solo iconografía)",
        LanguageDependence.Low => "Bajo (texto breve)",
        LanguageDependence.High => "Alto (dependiente)",
        _ => lang.ToString()
    };

    private static string GetFootprintText(TableFootprint footprint) => footprint switch
    {
        TableFootprint.SmallTable => "Mesa pequeña / Cafetería",
        TableFootprint.StandardTable => "Mesa estándar",
        TableFootprint.TableMonster => "Mesa grande / Despliegue amplio",
        _ => footprint.ToString()
    };

    private static string GetConfrontationText(ConfrontationType confrontation) => confrontation switch
    {
        ConfrontationType.Cooperative => "Cooperativo",
        ConfrontationType.SemiCooperative => "Semi-cooperativo",
        ConfrontationType.HiddenRolesOrTeams => "Roles Ocultos / Equipos",
