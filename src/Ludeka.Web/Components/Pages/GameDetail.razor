@page "/juegos/{Slug}"
@rendermode InteractiveServer
@inject ICatalogService CatalogService
@inject IUserLibraryService LibraryService
@inject IGamePlayLogService PlayLogService
@inject IFoundingVerdictService FoundingService
@inject IMediaService MediaService
@inject ICurrentUserService CurrentUserService
@inject IExpansionService ExpansionService
@inject NavigationManager Navigation
@inject ILogger<GameDetail> Logger

<PageTitle>@(Game != null ? $"{Game.SpanishTitle} — Ficha Inteligente | Ludeka" : "Juego no encontrado — Ludeka")</PageTitle>

@if (_isLoading)
{
    <div class="container-ludeka py-20 text-center text-[var(--text-muted)]">
        <div class="inline-block animate-spin mb-3"><Icon Name="dices" Size="36" /></div>
        <p class="text-base font-semibold">Cargando ficha lúdica inteligente...</p>
    </div>
}
else if (Game == null)
{
    <div class="container-ludeka py-20 text-center max-w-lg mx-auto">
        <span class="inline-block mb-4"><Icon Name="search" Size="40" /></span>
        <h1 class="text-2xl font-black text-[var(--text-primary)] mb-2">Juego no encontrado</h1>
        <p class="text-sm text-[var(--text-muted)] mb-6">
            El juego que buscas con identificador <code class="text-[var(--text-primary)] font-mono">@Slug</code> aún no está en nuestro catálogo base.
        </p>
        <a href="/catalogo" class="filter-btn active inline-block text-sm">
            &larr; Volver al Catálogo
        </a>
    </div>
}
else
{
    @* Back bar y Acciones de Cabecera (INC-36 DD-08: fila envolvente flex-wrap, navegación a
       la izquierda y bloque de moderación agrupado como unidad en subcontenedor con borde) *@
    <div class="border-b border-[var(--border-subtle)] bg-[var(--bg-surface)]">
        <div class="container-ludeka py-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
            <div class="flex items-center gap-4">
                <a href="/catalogo" class="text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--brand-primary)] transition-colors inline-flex items-center gap-1.5">
                    <span>&larr;</span> Volver al catálogo
                </a>
                <a href="/mi-ludoteca" class="hidden sm:inline-flex text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] items-center gap-1">
                    <Icon Name="library" Size="12" /> Ir a Mi Ludoteca
                </a>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                @if (Game.BggId > 0)
                {
                    <a href="https://boardgamegeek.com/boardgame/@Game.BggId"
                       target="_blank"
                       rel="noopener noreferrer"
                       title="Ver en BoardGameGeek"
                       class="px-3 py-1 rounded-lg bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-card)] text-[var(--text-primary)] border border-[var(--border-subtle)] font-bold text-xs transition-colors flex items-center gap-1.5 shadow-sm">
                        <Icon Name="globe" Size="12" /> Ver en BoardGameGeek
                    </a>
                }
                <button type="button"
                        @onclick="() => _isReportModalOpen = true"
                        title="Reportar una errata, imagen incorrecta o problema en esta ficha"
                        class="px-3 py-1 rounded-lg bg-[var(--bg-surface-elevated)] hover:bg-[var(--state-error-bg)] hover:text-[var(--state-error)] hover:border-[var(--state-error-border)] text-[var(--text-secondary)] border border-[var(--border-subtle)] font-bold text-xs transition-colors flex items-center gap-1.5 shadow-sm">
                    <Icon Name="flag" Size="12" /> Reportar problema
                </button>
                <button type="button"
                        @onclick="OpenSocialCardModal"
                        class="px-3 py-1 rounded-lg bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-card)] text-[var(--text-primary)] border border-[var(--border-subtle)] font-bold text-xs transition-colors flex items-center gap-1.5 shadow-sm">
                    <Icon Name="palette" Size="12" /> Cartel para Redes
                </button>
                @if (Game.PurchaseLinks != null && Game.PurchaseLinks.Count > 0)
                {
                    <a href="#donde-comprar"
                       class="px-3 py-1 rounded-lg bg-[var(--brand-primary)]/10 hover:bg-[var(--brand-primary)]/20 text-[var(--brand-primary)] border border-[var(--brand-primary)]/30 font-bold text-xs transition-colors flex items-center gap-1.5 shadow-sm">
                        <Icon Name="shopping-cart" Size="12" /> Comprar (@Game.PurchaseLinks.Count)
                    </a>
                }
                @if (CurrentUserService.IsFoundingTeam || (CurrentUserService.IsInRole("Moderator") && CurrentUserService.HasPermission(ModeratorPermission.CanEditGames)))
                {
                    <div class="flex items-center gap-1.5 pl-2 border-l border-[var(--border-subtle)]">
                        <button type="button"
                                @onclick="() => _isEditorModalOpen = true"
                                title="Editar ficha del catálogo y carátula"
                                class="px-3 py-1 rounded-lg bg-[var(--state-warning-bg)] hover:bg-[var(--state-warning-border)] text-[var(--state-warning)] border border-[var(--state-warning-border)] font-bold text-xs transition-colors flex items-center gap-1.5 shadow-sm">
                            <Icon Name="pen-line" Size="12" /> Editar Ficha
                        </button>
                        <button type="button"
                                @onclick="HandleRequestAiSummary"
                                disabled="@_isGeneratingAiSummary"
                                title="@(_aiSummary != null ? "Regenerar la síntesis con IA para esta ficha" : "Generar la síntesis con IA bajo demanda")"
                                class="px-3 py-1 rounded-lg bg-[var(--state-info-bg)] hover:bg-[var(--state-info-border)] text-[var(--state-info)] border border-[var(--state-info-border)] font-bold text-xs transition-colors flex items-center gap-1.5 shadow-sm disabled:opacity-50">
                            @if (_isGeneratingAiSummary)
                            {
                                <span class="animate-spin"><Icon Name="settings" Size="14" /></span>
                                <span>Sintetizando...</span>
                            }
                            else
                            {
                                <Icon Name="bot" Size="12" />
                                <span>@(_aiSummary != null ? "Regenerar con IA" : "Generar con IA")</span>
                            }
                        </button>
                        @if (CurrentUserService.IsFoundingTeam)
                        {
                            <button type="button"
                                    @onclick="() => _isFoundingModalOpen = true"
                                    class="px-3 py-1 rounded-lg bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-card)] text-[var(--text-primary)] border border-[var(--border-subtle)] font-bold text-xs transition-colors flex items-center gap-1.5 shadow-sm">
                                <Icon Name="shield" Size="12" /> Gestionar Veredicto Fundador
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @if (Game.IsExpansion && _parentGame != null)
    {
        <div class="container-ludeka pt-4">
            <ParentGameBanner ParentGame="@_parentGame" />
        </div>
    }

    @* Hero Section (Lectura en 3 segundos) *@
    <div class="detail-hero-backdrop">
        <div class="container-ludeka">
            <div class="flex flex-col md:flex-row gap-6 md:gap-8 items-start">
                @* Carátula oficial BGG *@
                <div class="w-full sm:w-64 md:w-72 shrink-0 aspect-square rounded-2xl overflow-hidden border-2 border-[var(--border-highlight)] shadow-2xl bg-[var(--bg-surface-elevated)] relative">
                    @{
                        var placeholderUrl = Game.IsExpansion ? "/images/expansion-placeholder.svg" : "/images/game-placeholder.svg";
                    }

                    @* Badge flotante en carátula para reconocimiento instantáneo *@
                    @if (Game.IsExpansion)
                    {
                        <div class="absolute top-3 left-3 z-10 px-3 py-1 rounded-lg bg-[var(--state-highlight)] text-[var(--on-brand)] text-xs font-black shadow-lg flex items-center gap-1.5">
                            <Icon Name="puzzle" Size="12" />
                            <span>Expansión Oficial</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Game.CoverImageUrl))
                    {
                        <img src="@Game.CoverImageUrl"
                             alt="Carátula oficial de @Game.SpanishTitle"
                             fetchpriority="high"
                             decoding="async"
                             width="320"
                             height="320"
                             onerror="this.onerror=null; this.src='@placeholderUrl';"
                             class="w-full h-full object-cover" />
                    }
                    else
                    {
                        <img src="@placeholderUrl"
                             alt="Carátula de @Game.SpanishTitle no disponible"
                             width="320"
                             height="320"
                             class="w-full h-full object-cover opacity-90" />
                    }
                </div>

                @* Bloque de Identidad y Ratings *@
                <div class="flex-1 space-y-4">
                    <div>
                        <div class="flex items-center gap-2 mb-1.5 flex-wrap">
                            @if (Game.IsExpansion)
                            {
                                <span class="text-xs font-black px-2.5 py-0.5 rounded-full bg-[var(--brand-primary)]/15 text-[var(--brand-primary)] border border-[var(--brand-primary)]/30">
                                    <Icon Name="puzzle" Size="12" /> Expansión Oficial
                                </span>
                            }
                            <span class="text-xs font-extrabold px-2.5 py-0.5 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border border-[var(--border-subtle)]">
                                @Game.YearPublished
                            </span>
                            @if (Game.BggRank.HasValue)
                            {
                                <span class="text-xs font-extrabold px-2.5 py-0.5 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border border-[var(--border-subtle)]">
                                    <Icon Name="trophy" Size="12" /> #@Game.BggRank Global BGG
                                </span>
                            }
                            @if (Game.BggId > 0)
                            {
                                <a href="https://boardgamegeek.com/boardgame/@Game.BggId"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   title="Ver en BoardGameGeek"
                                   class="text-xs font-extrabold px-2.5 py-0.5 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--brand-primary)] border border-[var(--border-subtle)] transition-colors inline-flex items-center gap-1">
                                    <Icon Name="globe" Size="12" /> Ver en BGG
                                </a>
                            }
                        </div>

                        <h1 class="text-3xl sm:text-4xl font-black text-[var(--text-primary)] tracking-tight">
                            @Game.SpanishTitle
                        </h1>

                        @if (!string.Equals(Game.SpanishTitle, Game.OriginalTitle, StringComparison.OrdinalIgnoreCase))
                        {
                            <p class="text-sm text-[var(--text-secondary)] italic">
                                Título original: @Game.OriginalTitle
                            </p>
                        }

                        <p class="text-xs text-[var(--text-secondary)] mt-1">
                            Diseñado por
                            @if (!string.IsNullOrWhiteSpace(Game.Designer))
                            {
                                <span class="text-[var(--text-primary)] font-bold">@Game.Designer</span>
                            }
                            else
                            {
                                <span class="text-[var(--text-primary)] font-bold">Desconocido</span>
                            }
                            &bull; Publicado en España por
                            @if (!string.IsNullOrWhiteSpace(Game.Publisher))
                            {
                                var pubSlug = Ludeka.Core.Entities.Game.GenerateSlug(Game.Publisher);
                                <a href="@($"/editoriales/{pubSlug}")" class="text-[var(--text-primary)] font-bold hover:text-[var(--brand-primary)] hover:underline" title="Ver catálogo de la editorial @Game.Publisher">
                                    @Game.Publisher
                                </a>
                            }
                            else
                            {
                                <span class="text-[var(--text-primary)] font-bold">Varios</span>
                            }
                        </p>
                    </div>

                    @* Doble Rating (BGG vs Ludist) *@
                    <div class="flex items-center gap-4 py-3 px-4 rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)] max-w-md">
                        <div class="flex-1">
                            <span class="text-[0.68rem] uppercase font-bold text-[var(--text-muted)] block">Rating BGG</span>
                            <div class="flex items-baseline gap-1 text-[var(--brand-primary)]">
                                <span class="text-xl font-black">★ @Game.BggRating.ToString("0.0")</span>
                                <span class="text-xs text-[var(--text-muted)]">/ 10</span>
                            </div>
                        </div>
                        <div class="w-px h-8 bg-[var(--border-subtle)]"></div>
                        <div class="flex-1">
                            <span class="text-[0.68rem] uppercase font-bold text-[var(--text-muted)] block">Consenso Ludeka</span>
                            <div class="flex items-baseline gap-1 text-[var(--text-primary)]">
                                <span class="text-xl font-black">★ @Game.LudistRating.ToString("0.0")</span>
                                <span class="text-xs text-[var(--text-muted)]">/ 10</span>
                            </div>
                        </div>
                    </div>

                    @* ADN Lúdico *@
                    <div>
                        <span class="text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider block mb-2">ADN Lúdico</span>
                        <QuickBadges
                            Confrontation="@Game.Confrontation"
                            Style="@Game.Style"
                            IsOfficialSolo="@Game.IsOfficialSolo"
                            Age="@Game.Age"
                            Language="@Game.Language"
                            EstimatedMinutesPerPlayer="@Game.Duration.EstimatedPerPlayerMinutes"
                            Footprint="@Game.Footprint" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Bloque de Interacción de Usuario: Colección, Estados y Préstamos *@
    <div class="container-ludeka pt-6">
<CollectionActionBar
    CurrentItem="@_collectionItem"
    ActiveLoan="@_activeLoan"
    PlayCount="@_userPlaysCount"
    IsSessionActive="@HasSession"
    OnStatusSelected="HandleStatusSelected"
    OnTogglePlayed="HandleTogglePlayed"
    OnRecordPlayClicked="() => _isRecordPlayModalOpen = true"
    OnLoanClicked="() => _isLoanModalOpen = true" />

        @if (_activeLoan != null)
        {
            <div class="mt-3 p-3 rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)] flex items-center justify-between text-xs text-[var(--text-secondary)]">
                <div class="flex items-center gap-2">
                    <Icon Name="package" Size="14" />
                    <span>
                        Actualmente prestado a <strong class="text-[var(--text-primary)]">@_activeLoan.BorrowerName</strong> desde el @_activeLoan.LoanDate.ToString("dd/MM/yyyy").
                    </span>
                </div>
                <button type="button"
                        @onclick="() => _isLoanModalOpen = true"
                        class="px-2.5 py-1 rounded-lg bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-card)] text-[var(--text-primary)] border border-[var(--border-subtle)] font-bold text-[0.68rem] transition-colors shadow-sm">
                    Ver préstamo &rarr;
                </button>
            </div>
        }
    </div>

    @* Bloque de Análisis Editorial y Consenso *@
    <div class="container-ludeka py-6 space-y-8">
        @if (!string.IsNullOrWhiteSpace(_aiSummaryMessage))
        {
            <div class="p-3 rounded-xl bg-[var(--state-info-bg)] border border-[var(--state-info-border)] text-xs text-[var(--state-info)] flex items-center justify-between gap-3">
                <div class="flex items-center gap-2">
                    <Icon Name="bot" Size="14" />
                    <span>@_aiSummaryMessage</span>
                </div>
                <button type="button" @onclick="() => _aiSummaryMessage = null" class="text-[var(--text-muted)] hover:text-[var(--text-primary)]">&times;</button>
            </div>
        }

        @* 1. Bloque Editorial: Veredicto Fundador (Fase 2) o Resumen IA (Fase 1) *@
        @if (_foundingVerdict != null)
        {
            <FoundingVerdictCard Verdict="@_foundingVerdict" />
        }
        else if (_aiSummary != null)
        {
            <AiSummaryCard Summary="@_aiSummary" />
        }
        else if (CurrentUserService.IsFoundingTeam || (CurrentUserService.IsInRole("Moderator") && CurrentUserService.HasPermission(ModeratorPermission.CanEditGames)))
        {
            <div class="rounded-xl bg-[var(--bg-card)] border border-dashed border-[var(--border-subtle)] p-5 text-center space-y-3">
                <div><Icon Name="bot" Size="24" /></div>
                <h3 class="text-sm font-bold text-[var(--text-primary)]">Ficha pendiente de síntesis editorial</h3>
                <p class="text-xs text-[var(--text-muted)] max-w-md mx-auto">
                    Este título aún no cuenta con síntesis de IA ni veredicto de la mesa fundadora. Puedes generar su síntesis ahora bajo demanda.
                </p>
                <button type="button"
                        @onclick="HandleRequestAiSummary"
                        disabled="@_isGeneratingAiSummary"
                        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold bg-[var(--brand-primary)] text-[var(--on-brand)] hover:opacity-90 transition-opacity shadow-sm disabled:opacity-50">
                    @if (_isGeneratingAiSummary)
                    {
                        <span class="animate-spin"><Icon Name="settings" Size="14" /></span>
                        <span>Generando síntesis con IA...</span>
                    }
                    else
                    {
                        <Icon Name="zap" Size="12" />
                        <span>Generar Síntesis con IA Ahora</span>
                    }
                </button>
            </div>
        }

        @* MÓDULO DE EXPANSIÓN: ¿Qué aporta al Juego Base? *@
        @if (Game.IsExpansion)
        {
            <ExpansionAporteCard
                Necessity="@Game.ExpansionNecessity"
                ImpactTags="@Game.ImpactTags"
                WhatItBringsSummary="@Game.WhatItBringsSummary"
                ExtraPlayerCount="@Game.ExtraPlayerCount"
                ExtraDurationMinutes="@Game.ExtraDurationMinutes" />
        }
        else if (_expansions.Count > 0)
        {
            @* MÓDULO DE JUEGO BASE: Ecosistema de Expansiones y Mezclador de Mesa *@
            <ExpansionEcosystemSection BaseGameId="@Game.Id" Expansions="@_expansions" />
        }

        @* 2. Tarjeta de Valoración Propia y Acceso a Review *@
        <UserReviewCard
            Review="@_userReview"
            CanReview="@CanUserReview()"
            DisabledReviewReason="@GetDisabledReviewReason()"
            OnEditClicked="OpenReviewModal" />

        @* 3. Semáforo Dinámico *@
        <div class="p-6 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)]">
            <h2 class="text-lg font-black text-[var(--text-primary)] mb-1">
                Semáforo Dinámico de Escalabilidad (1 a 7+ jugadores)
            </h2>
            <p class="text-xs text-[var(--text-secondary)] mb-4">
                Basado en miles de partidas y votaciones del hobby para saber si el juego realmente escala bien antes de sacarlo a mesa.
            </p>

            <ScalabilityTrafficLight Entries="@Game.Scalability" IdealText="@Game.IdealPlayerCountText" />
        </div>

        @* MÓDULO DE EXPANSIÓN: Expansiones Hermanas del mismo Ecosistema *@
        @if (Game.IsExpansion && _sisterExpansions.Count > 0)
        {
            <ExpansionSisterList
                CurrentExpansionId="@Game.Id"
                BaseGameTitle="@(_parentGame?.SpanishTitle ?? "Juego Base")"
                Sisters="@_sisterExpansions"
                Synergies="@_sisterSynergies" />
        }

        @* 4. Dónde Comprar (Tiendas Especializadas y Afiliados) *@
        <StoreOffersCard Offers="@Game.PurchaseLinks" GameTitle="@Game.SpanishTitle" GameId="@Game.Id" />

        @* 5. Guía de Fundas *@
        <SleeveGuideCard Sleeves="@Game.Sleeves" />

        @* 6. Hub Multimedia (YouTube e Instagram) *@
        <MultimediaHub MediaHub="@_mediaHub" GameTitle="@Game.SpanishTitle" OnMediaChanged="ReloadMediaAsync" />

        @* 7. Consultorio de Reglas Q&A *@
        <RuleQuestionsSection GameId="@Game.Id" GameTitle="@Game.SpanishTitle" />

        @* 8. Galería Visual Comunitaria (Contraportada y Foto en Mesa) *@
        @if (!string.IsNullOrWhiteSpace(Game.BackCoverImageUrl) || !string.IsNullOrWhiteSpace(Game.TableImageUrl))
        {
            <div class="p-6 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-4">
                <div class="flex items-center gap-2">
                    <Icon Name="image" Size="18" class="text-[var(--brand-primary)]" />
                    <h2 class="text-base font-bold text-[var(--text-primary)]">Galería Visual & Componentes</h2>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    @if (!string.IsNullOrWhiteSpace(Game.BackCoverImageUrl))
                    {
                        <div class="space-y-2">
                            <span class="text-xs font-semibold text-[var(--text-secondary)]">Contraportada oficial</span>
                            <div class="rounded-xl overflow-hidden border border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)] max-h-80 flex items-center justify-center">
                                <img src="@Game.BackCoverImageUrl" alt="Contraportada de @Game.SpanishTitle" loading="lazy" class="w-full h-auto object-contain max-h-80" />
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Game.TableImageUrl))
                    {
                        <div class="space-y-2">
                            <span class="text-xs font-semibold text-[var(--text-secondary)]">En mesa y componentes</span>
                            <div class="rounded-xl overflow-hidden border border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)] max-h-80 flex items-center justify-center">
                                <img src="@Game.TableImageUrl" alt="Componentes en mesa de @Game.SpanishTitle" loading="lazy" class="w-full h-auto object-contain max-h-80" />
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @* 9. Sinopsis / Descripción *@
        @if (!string.IsNullOrWhiteSpace(Game.Description))
        {
            <div class="p-6 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)]">
                <h2 class="text-base font-bold text-[var(--text-primary)] mb-3">Sobre el juego</h2>
                <div class="text-sm text-[var(--text-secondary)] leading-relaxed space-y-3">
                    @((MarkupString)Game.Description.Replace("\n", "<br />"))
                </div>
            </div>
        }
    </div>

    @* Modales *@
    <SocialCardModal
        IsOpen="@_isSocialCardModalOpen"
        Data="@_socialCardData"
        OnClose="() => _isSocialCardModalOpen = false" />

    <LoanModal
        IsOpen="@_isLoanModalOpen"
        ActiveLoan="@_activeLoan"
        OnCreateLoan="HandleCreateLoan"
        OnReturnLoan="HandleReturnLoan"
        OnClose="() => _isLoanModalOpen = false" />

    <RecordPlayModal
        IsOpen="@_isRecordPlayModalOpen"
        GameId="@Game.Id"
        GameTitle="@Game.SpanishTitle"
        OnPlayRecorded="HandlePlayRecorded"
        OnClose="() => _isRecordPlayModalOpen = false" />

    <ReviewBottomSheet
        IsOpen="@_isReviewModalOpen"
        ExistingReview="@_userReview"
        OnSubmitReview="HandleSubmitReview"
        OnClose="() => _isReviewModalOpen = false" />

    <FoundingVerdictModal
        IsOpen="@_isFoundingModalOpen"
        GameId="@Game.Id"
        GameTitle="@Game.SpanishTitle"
        ExistingVerdict="@_foundingVerdict"
        OnSaveVerdict="HandleSaveFoundingVerdict"
        OnClose="() => _isFoundingModalOpen = false" />

    <GameReportModal
        IsOpen="@_isReportModalOpen"
        GameId="@Game.Id"
        GameSlug="@Game.Slug"
        GameTitle="@Game.SpanishTitle"
        OnClose="() => _isReportModalOpen = false" />

    <GameEditorModal
        @bind-IsOpen="_isEditorModalOpen"
        Game="@Game"
        OnGameUpdated="HandleGameUpdated" />
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private GameDetailDto? Game { get; set; }
    private UserCollectionItemDto? _collectionItem;
    private GameLoanDto? _activeLoan;
    private UserReviewDto? _userReview;
    private FoundingVerdictDto? _foundingVerdict;
    private AiGameSummaryDto? _aiSummary;
    private GameMediaHubDto? _mediaHub;

    // Incremento 8: Expansiones, Sinergias y Ecosistema
    private IReadOnlyList<ExpansionSummaryDto> _expansions = [];
    private IReadOnlyList<ExpansionSummaryDto> _sisterExpansions = [];
    private IReadOnlyList<ExpansionSynergyDto> _sisterSynergies = [];
    private ParentGameSummaryDto? _parentGame;

    private bool _isLoading = true;
    private bool _isLoanModalOpen;
    private bool _isRecordPlayModalOpen;
    private bool _isReviewModalOpen;
    private bool _isFoundingModalOpen;
    private bool _isSocialCardModalOpen;
    private bool _isReportModalOpen;
    private bool _isEditorModalOpen;
    private SocialCardDataDto? _socialCardData;
    private bool _isGeneratingAiSummary;
    private string? _aiSummaryMessage;
    private int _userPlaysCount;

    /// <summary>Indica si hay sesión iniciada: las acciones con identidad la exigen (INC-46 F4).</summary>
    private bool HasSession => !string.IsNullOrWhiteSpace(CurrentUserService.UserId);

    private void HandleGameUpdated(GameDetailDto updated)
    {
        Game = updated;
        StateHasChanged();
    }

    private void OpenSocialCardModal()
    {
        if (Game == null) return;

        string? verdictBadge = null;
        if (_foundingVerdict != null)
        {
            verdictBadge = _foundingVerdict.Recommendation switch
            {
                FoundingRecommendation.MustPlay => "Imprescindible (Mesa Fundadora)",
                FoundingRecommendation.RecommendedWithAdaptations => "Recomendado con adaptaciones",
                _ => "Prescindible"
            };
        }

        _socialCardData = new SocialCardDataDto(
            GameTitle: Game.SpanishTitle,
            OriginalTitle: Game.OriginalTitle,
            YearPublished: Game.YearPublished,
            Designer: Game.Designer,
            Publisher: Game.Publisher,
            CoverImageUrl: Game.CoverImageUrl,
            Rating: Game.LudistRating > 0 ? Game.LudistRating : Game.BggRating,
            StyleText: Game.Style.ToString(),
            ConfrontationText: Game.Confrontation.ToString(),
            IdealPlayersText: Game.IdealPlayerCountText ?? "Consulta ficha",
            EstimatedDurationPerPlayer: Game.Duration.EstimatedPerPlayerMinutes,
            FoundingVerdictBadge: verdictBadge);

        _isSocialCardModalOpen = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _isLoading = true;
            Game = await CatalogService.GetGameBySlugAsync(Slug);
            if (Game != null)
            {
                await LoadUserDataAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar la ficha del juego {Slug}", Slug);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadUserDataAsync()
    {
        if (Game == null) return;

        try
        {
            _collectionItem = await LibraryService.GetCollectionStateAsync(Game.Id);
            _activeLoan = await LibraryService.GetActiveLoanAsync(Game.Id);
            _userReview = await LibraryService.GetUserReviewAsync(Game.Id);
            await RefreshPlaysCountAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error al cargar datos de biblioteca de usuario para el juego {GameId}", Game.Id);
        }

        try
        {
            _foundingVerdict = await FoundingService.GetVerdictByGameIdAsync(Game.Id);
            if (_foundingVerdict == null)
            {
                _aiSummary = await FoundingService.GetAiSummaryForGameAsync(Game.Id);
            }
            else
            {
                _aiSummary = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error al cargar veredicto o resumen IA para el juego {GameId}", Game.Id);
        }

        try
        {
            _mediaHub = await MediaService.GetGameMediaAsync(Game.Id);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error al cargar multimedia para el juego {GameId}", Game.Id);
        }

        try
        {
            // Carga de datos de expansiones
            if (Game.IsExpansion)
            {
                _parentGame = Game.BaseGame ?? (Game.BaseGameId.HasValue ? await ExpansionService.GetParentGameForExpansionAsync(Game.Id) : null);
                if (Game.BaseGameId.HasValue)
                {
                    var allSisters = await ExpansionService.GetExpansionsForBaseGameAsync(Game.BaseGameId.Value);
                    _sisterExpansions = allSisters.Where(s => s.Id != Game.Id).ToList();
                    _sisterSynergies = await ExpansionService.GetSynergiesForExpansionAsync(Game.Id);
                }
            }
            else
            {
                _expansions = await ExpansionService.GetExpansionsForBaseGameAsync(Game.Id);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error al cargar ecosistema de expansiones para el juego {GameId}", Game.Id);
        }
    }

    private bool CanUserReview()
    {
        if (_userReview != null) return true;
        if (_collectionItem != null && _collectionItem.Status == CollectionStatus.WantToBuy && !_collectionItem.IsPlayed)
        {
            return false;
        }
        return true;
    }

    private string? GetDisabledReviewReason()
    {
        if (_collectionItem != null && _collectionItem.Status == CollectionStatus.WantToBuy && !_collectionItem.IsPlayed)
        {
            return "Tienes este juego en tu lista de compra. Para valorarlo, márcalo como «Jugado» o registra una partida.";
        }
        return null;
    }

    private void OpenReviewModal()
    {
        if (!CanUserReview()) return;
        _isReviewModalOpen = true;
    }

    private async Task HandleTogglePlayed()
    {
        if (Game == null) return;
        bool wasUnrated = _userReview == null;
        bool wasPlayed = _collectionItem?.IsPlayed == true;

        try
        {
            _collectionItem = await LibraryService.TogglePlayedStateAsync(Game.Id);
            await RefreshPlaysCountAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
            return;
        }

        if (wasUnrated && !wasPlayed && _collectionItem?.IsPlayed == true)
        {
            _isReviewModalOpen = true;
        }
    }

    private async Task HandlePlayRecorded(RecordPlayRequest req)
    {
        if (Game == null) return;

        try
        {
            await PlayLogService.RecordPlayAsync(req);
            _collectionItem = await LibraryService.GetCollectionStateAsync(Game.Id);
            await RefreshPlaysCountAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
        }
    }

    private async Task RefreshPlaysCountAsync()
    {
        if (Game == null) return;
        var plays = await PlayLogService.GetGamePlaysAsync(Game.Id);
        _userPlaysCount = plays.Count;
    }

    private async Task HandleStatusSelected(CollectionStatus status)
    {
        if (Game == null) return;

        bool wasUnrated = _userReview == null;
        var prevStatus = _collectionItem?.Status;

        try
        {
            _collectionItem = await LibraryService.SetCollectionStateAsync(Game.Id, status);
            _activeLoan = await LibraryService.GetActiveLoanAsync(Game.Id);
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
            return;
        }

        // Disparador de valoración: si el juego pasa a En mi ludoteca por primera vez y no tiene valoración, sugerir valoración
        if (wasUnrated && _collectionItem != null &&
            status == CollectionStatus.InCollection &&
            prevStatus != status)
        {
            _isReviewModalOpen = true;
        }
    }

    private async Task HandleCreateLoan(CreateLoanRequest req)
    {
        if (Game == null) return;

        try
        {
            await LibraryService.CreateLoanAsync(new CreateLoanRequest(Game.Id, req.BorrowerName, req.LoanDate, req.Notes));
            await LoadUserDataAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
        }
    }

    private async Task HandleReturnLoan(Guid loanId)
    {
        try
        {
            await LibraryService.ReturnLoanAsync(loanId);
            await LoadUserDataAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
        }
    }

    private async Task HandleSubmitReview(SubmitReviewRequest req)
    {
        if (Game == null) return;

        try
        {
            await LibraryService.SubmitReviewAsync(new SubmitReviewRequest(
                Game.Id,
                req.Score,
                req.MicroReview,
                req.PlayerCountVotes,
                req.FamilyExperience,
                req.PlayContext
            ));

            // Refrescar ficha del juego para reflejar el consenso actualizado
            Game = await CatalogService.GetGameBySlugAsync(Slug);
            await LoadUserDataAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
        }
    }

    private async Task HandleSaveFoundingVerdict(SaveFoundingVerdictRequest req)
    {
        if (Game == null) return;

        try
        {
            await FoundingService.SaveVerdictAsync(req);

            // Refrescar ficha y datos del veredicto
            Game = await CatalogService.GetGameBySlugAsync(Slug);
            await LoadUserDataAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
        }
    }

    private async Task HandleRequestAiSummary()
    {
        if (Game == null || _isGeneratingAiSummary) return;

        _isGeneratingAiSummary = true;
        _aiSummaryMessage = null;

        try
        {
            _aiSummary = await FoundingService.RequestAiSummaryGenerationAsync(Game.Id);
            _aiSummaryMessage = "Síntesis estructurada generada y guardada correctamente con IA.";
            Game = await CatalogService.GetGameBySlugAsync(Slug);
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
        }
        catch (Exception ex)
        {
            _aiSummaryMessage = $"No se pudo generar la síntesis: {ex.Message}";
        }
        finally
        {
            _isGeneratingAiSummary = false;
        }
    }

    private async Task ReloadMediaAsync()
    {
        if (Game != null)
        {
            _mediaHub = await MediaService.GetGameMediaAsync(Game.Id);
            StateHasChanged();
        }
    }
}
