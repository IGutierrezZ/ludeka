    };

    private static string GetNotificationTypeLabel(UserNotificationType type) => type switch
    {
        UserNotificationType.PriceDrop => "Oferta detectada (-15%)",
        UserNotificationType.Reprint => "Reimpresión",
        UserNotificationType.Restock => "Reestock disponible",
        UserNotificationType.NewGiveaway => "Nuevo sorteo",
        _ => "Aviso de Ludeka"
    };

    private static string GetAlertTypeIcon(GameAlertType alertType) => alertType switch
    {
        GameAlertType.PriceDrop => "tag",
        GameAlertType.Reprint => "repeat",
        GameAlertType.Restock => "package",
        _ => "bell"
    };

    private static string GetAlertTypeLabel(GameAlertType alertType) => alertType switch
    {
        GameAlertType.PriceDrop => "Oferta (-15% PVP)",
        GameAlertType.Reprint => "Reimpresión",
        GameAlertType.Restock => "Reestock",
        _ => "Alerta"
    };

    private static string FormatDate(DateTime date)
    {
        var diff = DateTime.UtcNow - date;
        if (diff.TotalMinutes < 2) return "Hace un instante";
        if (diff.TotalMinutes < 60) return $"Hace {(int)diff.TotalMinutes} min";
        if (diff.TotalHours < 24) return $"Hace {(int)diff.TotalHours} h";
        return date.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
    }
