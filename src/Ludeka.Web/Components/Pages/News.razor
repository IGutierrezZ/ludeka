@page "/novedades"
@rendermode InteractiveServer
@inject IWeeklyReleaseService ReleaseService
@inject ICurrentUserService CurrentUserService

<PageTitle>Novedades y Estrenos Editoriales — Ludeka</PageTitle>

<div class="container-ludeka py-8 space-y-8">
    <PageHeaderEditorial Badge="Calendario de Estrenos"
                         BadgeIcon="newspaper"
                         Subtitle="Cronología de novedades, preventas y reimpresiones programadas para llegar a tiendas especializadas de juegos de mesa en español.">
        <Title>Novedades de los Viernes & Lanzamientos</Title>
        <Actions>
            @if (IsModerator)
            {
                <button type="button"
                        @onclick="() => _isExpressModalOpen = true"
                        class="px-3.5 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs transition-all flex items-center gap-1.5 shadow-sm">
                    <Icon Name="zap" Size="12" /> Alta Exprés
                </button>
                <button type="button"
                        @onclick="() => _isCreateModalOpen = true"
                        class="px-4 py-2 rounded-xl bg-[var(--brand-primary)] hover:opacity-90 text-[var(--on-brand)] font-bold text-xs transition-all flex items-center gap-1.5 shadow-sm">
                    <Icon Name="plus" Size="12" /> Añadir Novedad
                </button>
            }
        </Actions>
    </PageHeaderEditorial>

    @* Barra de Filtros y Búsqueda *@
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3 w-full sm:w-auto">
            <div class="relative w-full sm:w-72">
                <span class="absolute inset-y-0 left-3 flex items-center"><Icon Name="search" Size="16" /></span>
                <input type="text"
                       @bind="_searchTerm"
                       @bind:event="oninput"
                       placeholder="Buscar por juego o editorial..."
                       class="w-full pl-9 pr-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
            </div>

            @if (!string.IsNullOrWhiteSpace(_selectedPublisher))
            {
                    <button type="button"
                        @onclick="() => _selectedPublisher = null"
                        class="px-3 py-1.5 rounded-lg bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-secondary)] hover:text-[var(--text-primary)] flex items-center gap-1 font-semibold">
                    <span>@_selectedPublisher</span>
                    <span class="text-[var(--state-error)] font-bold">&times;</span>
                </button>
            }
        </div>

        <span class="text-xs text-[var(--text-muted)]">
            Total lanzamientos: <strong>@FilteredReleases.Count</strong>
        </span>
    </div>

    @if (_isLoading)
    {
        <div class="py-16 text-center text-[var(--text-muted)]">
            <div class="inline-block animate-spin mb-2"><Icon Name="package" Size="30" /></div>
            <p class="text-sm font-semibold">Cargando lanzamientos de tiendas...</p>
        </div>
    }
    else if (FilteredReleases.Count == 0)
    {
        <div class="p-12 text-center rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)]">
            <span class="inline-block mb-3"><Icon Name="package" Size="40" /></span>
            <h3 class="text-base font-bold text-[var(--text-primary)] mb-1">Sin lanzamientos encontrados</h3>
            <p class="text-xs text-[var(--text-secondary)] max-w-md mx-auto mb-4">
                No hay novedades registradas con los filtros actuales.
            </p>
            @if (IsModerator)
            {
                <button type="button"
                        @onclick="() => _isCreateModalOpen = true"
                        class="px-3.5 py-1.5 rounded-xl bg-[var(--brand-primary)] hover:opacity-90 text-[var(--on-brand)] font-bold text-xs transition-opacity">
                    <Icon Name="plus" Size="12" /> Añadir Primer Lanzamiento
                </button>
            }
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var release in FilteredReleases)
            {
                <div class="rail-card justify-between shadow-sm">
                    <div>
                        <div class="rail-cover h-44 border-b border-[var(--border-subtle)]">
                            @if (string.IsNullOrWhiteSpace(release.CoverImageUrl))
                            {
                                <DefaultImage Domain="DefaultImageDomain.Novedad"
                                              Alt="@($"Carátula de {release.Title}")"
                                              CssClass="w-full h-full" />
                            }
                            else
                            {
                                <img src="@release.CoverImageUrl"
                                     alt="Carátula de @release.Title"
                                     width="400"
                                     height="225"
                                     loading="lazy"
                                     decoding="async"
                                     onerror="this.onerror=null; this.src='/images/defaults/novedad-default.svg';" />
                            }
                        </div>

                        <div class="p-5">
                            <div class="flex items-center justify-between gap-2 mb-3">
                                <span class="px-2.5 py-0.5 rounded-lg text-xs font-bold border inline-flex items-center gap-1 @(release.IsReprint ? "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)]" : "bg-[var(--brand-glow)] border-[var(--brand-primary)] text-[var(--brand-primary)]")">
                                    @if (release.IsReprint)
                                    {
                                        <Icon Name="refresh-cw" Size="12" />
                                    }
                                    else
                                    {
                                        <Icon Name="sparkles" Size="12" />
                                    }
                                    @(release.IsReprint ? "Reimpresión" : "Novedad")
                                </span>

                                <span class="text-xs text-[var(--text-muted)] font-medium">
                                    <Icon Name="calendar-days" Size="12" /> @release.ReleaseDate.ToString("dd/MM/yyyy")
                                </span>
                            </div>

                            <h3 class="text-base font-black text-[var(--text-primary)]">
                                @release.Title
                            </h3>

                            <p class="text-xs text-[var(--text-secondary)] mt-1 flex items-center gap-1.5">
                                <span class="text-[var(--text-muted)]">Editorial:</span>
                                <button type="button"
                                        @onclick="() => _selectedPublisher = release.Publisher"
                                        class="font-semibold text-[var(--text-primary)] hover:underline">
                                    @release.Publisher
                                </button>
                            </p>

                            @if (!string.IsNullOrWhiteSpace(release.Notes))
                            {
                                <p class="text-xs text-[var(--text-secondary)] mt-3 p-2.5 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] leading-relaxed">
                                    @release.Notes
                                </p>
                            }
                        </div>
                    </div>

                    <div class="p-5 pt-3 border-t border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)] flex items-center justify-between text-xs">
                        @if (release.EstimatedPvp.HasValue)
                        {
                            <div>
                                <span class="text-[var(--text-muted)] block text-[0.68rem]">PVP aproximado:</span>
                                <span class="font-extrabold text-[var(--text-primary)] text-sm">@release.EstimatedPvp.Value.ToString("0.00") €</span>
                            </div>
                        }
                        else
                        {
                            <span class="text-[0.68rem] text-[var(--text-muted)]">PVP por confirmar</span>
                        }

                        @if (release.IsPublishedOnInstagram && !string.IsNullOrWhiteSpace(release.InstagramPermalink))
                        {
                            <a href="@release.InstagramPermalink"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="inline-flex items-center gap-1 text-[0.7rem] font-bold text-[var(--state-highlight)] hover:opacity-80">
                                <Icon Name="camera" Size="12" /> <span>En Instagram</span> <span>↗</span>
                            </a>
                        }
                        else if (IsModerator)
                        {
                            <a href="/admin/instagram?sourceType=WeeklyRelease&sourceId=@release.Id"
                               class="px-2.5 py-1 rounded-lg bg-[var(--bg-card)] border border-[var(--border-subtle)] hover:border-[var(--state-info)] text-[var(--state-info)] font-bold text-[0.7rem] transition-colors inline-flex items-center gap-1">
                                <Icon Name="camera" Size="12" /> <span>Instagram</span>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@* Modal para Registrar Novedad Manualmente *@
    <EditorialModal Open="@_isCreateModalOpen"
                    Title="Añadir Novedad Editorial"
                    TitleIcon="newspaper"
                    OnClose="@(() => _isCreateModalOpen = false)">
        <ChildContent>
            <div class="space-y-3 text-xs">
                <div>
                    <label class="font-semibold text-[var(--text-secondary)] block mb-1">Título del Juego *</label>
                    <input type="text"
                           @bind="_formTitle"
                           placeholder="Ej. Heat: Lluvia Torrencial"
                           class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="font-semibold text-[var(--text-secondary)] block mb-1">Editorial / Distribuidora *</label>
                        <input type="text"
                               @bind="_formPublisher"
                               placeholder="Ej. Asmodee / Days of Wonder"
                               class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
                    </div>
                    <div>
                        <label class="font-semibold text-[var(--text-secondary)] block mb-1">Fecha de Lanzamiento *</label>
                        <input type="date"
                               @bind="_formReleaseDate"
                               class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="font-semibold text-[var(--text-secondary)] block mb-1">PVP Estimado (€)</label>
                        <input type="number"
                               step="0.5"
                               @bind="_formPvp"
                               placeholder="Ej. 39.99"
                               class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                    </div>
                    <div class="flex items-center pt-5">
                        <label class="flex items-center gap-2 cursor-pointer font-medium text-[var(--text-secondary)]">
                            <input type="checkbox"
                                   @bind="_formIsReprint"
                                   class="rounded bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--brand-primary)] focus:ring-0" />
                            <span>Es Reimpresión</span>
                        </label>
                    </div>
                </div>

                <div>
                    <label class="font-semibold text-[var(--text-secondary)] block mb-1">URL de Carátula (Opcional)</label>
                    <input type="url"
                           @bind="_formCoverImageUrl"
                           placeholder="https://... o /images/..."
                           class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
                </div>

                <div>
                    <label class="font-semibold text-[var(--text-secondary)] block mb-1">Notas Editoriales (Opcional)</label>
                    <textarea rows="2"
                              @bind="_formNotes"
                              placeholder="Ej. Incluye nuevos circuitos y modo solitario mejorado..."
                              class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]"></textarea>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_formError))
            {
                <div class="p-2.5 rounded-xl bg-[var(--state-error-bg)] border border-[var(--state-error-border)] text-[var(--state-error)] text-xs">
                    @_formError
                </div>
            }
        </ChildContent>

        <Footer>
                <button type="button"
                        @onclick="() => _isCreateModalOpen = false"
                        class="px-4 py-2 rounded-xl border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] text-xs font-bold transition-colors">
                    Cancelar
                </button>
                <button type="button"
                        @onclick="HandleSubmitRelease"
                        class="px-4 py-2 rounded-xl bg-[var(--brand-primary)] hover:opacity-90 text-[var(--on-brand)] text-xs font-bold transition-opacity">
                    Guardar y Publicar
                </button>
        </Footer>
    </EditorialModal>

    <SocialExpressIngestModal IsOpen="_isExpressModalOpen"
                              OnClose="() => _isExpressModalOpen = false"
                              OnItemCreated="HandleExpressItemCreated" />

@code {
    private bool _isLoading = true;
    private IReadOnlyList<WeeklyReleaseDto> _releases = new List<WeeklyReleaseDto>();
    private string _searchTerm = string.Empty;
    private string? _selectedPublisher;

    private bool _isExpressModalOpen;
    private bool _isCreateModalOpen;
    private string _formTitle = string.Empty;
    private string _formPublisher = string.Empty;
    private DateOnly _formReleaseDate = DateOnly.FromDateTime(DateTime.UtcNow);
    private decimal? _formPvp;
    private bool _formIsReprint;
    private string? _formCoverImageUrl;
    private string? _formNotes;
    private string? _formError;

    private bool IsModerator => CurrentUserService.IsFoundingTeam || CurrentUserService.IsInRole("Moderator");

    private IReadOnlyList<WeeklyReleaseDto> FilteredReleases
    {
        get
        {
            var query = _releases.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_selectedPublisher))
            {
                query = query.Where(r => r.Publisher.Equals(_selectedPublisher, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim();
                query = query.Where(r => r.Title.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                                         r.Publisher.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            return query.OrderByDescending(r => r.ReleaseDate).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _releases = await ReleaseService.GetReleasesAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSubmitRelease()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_formTitle))
        {
            _formError = "El título del lanzamiento es obligatorio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_formPublisher))
        {
            _formError = "La editorial es obligatoria.";
            return;
        }

        var request = new CreateWeeklyReleaseRequest(
            Title: _formTitle,
            Publisher: _formPublisher,
            ReleaseDate: _formReleaseDate,
            CoverImageUrl: string.IsNullOrWhiteSpace(_formCoverImageUrl) ? null : _formCoverImageUrl.Trim(),
            EstimatedPvp: _formPvp,
            IsReprint: _formIsReprint,
            Notes: string.IsNullOrWhiteSpace(_formNotes) ? null : _formNotes.Trim());

        await ReleaseService.CreateReleaseAsync(request);

        _isCreateModalOpen = false;
        _formTitle = string.Empty;
        _formPublisher = string.Empty;
        _formPvp = null;
        _formIsReprint = false;
        _formCoverImageUrl = null;
        _formNotes = null;

        await LoadDataAsync();
    }

    private async Task HandleExpressItemCreated(Ludeka.Application.DTOs.SocialInboxItemDto item)
    {
        _isExpressModalOpen = false;
        await LoadDataAsync();
    }
}
