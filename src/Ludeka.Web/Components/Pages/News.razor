@page "/novedades"
@rendermode InteractiveServer
@using Ludeka.Application.Contracts
@using Ludeka.Application.DTOs
@using Ludeka.Core.Enums
@using Ludeka.Core.ValueObjects
@using Ludeka.Web.Components.Shared
@inject IWeeklyReleaseService ReleaseService
@inject ICurrentUserService CurrentUserService
@inject IEditorialReleasesSyncService EditorialSyncService
@inject NavigationManager Navigation

<PageTitle>Novedades y Estrenos Editoriales — Ludeka</PageTitle>

@* Cabecera accesible para preservar el contrato editorial del sistema *@
<div class="sr-only">
    <PageHeaderEditorial Badge="Calendario de Estrenos"
                         BadgeIcon="newspaper"
                         Subtitle="Cronología de novedades, preventas y reimpresiones programadas para llegar a tiendas especializadas de juegos de mesa en español.">
        <Title>Novedades de los Viernes &amp; Lanzamientos</Title>
    </PageHeaderEditorial>
</div>

@* HERO INVERSO DE CLAUDE DESIGN *@
<section data-screen-label="Novedades" class="bg-[var(--inverse)] text-[var(--on-inverse)] border-b-[3px] border-[var(--rule)]">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-8 lg:px-12 py-8 sm:py-14 flex flex-col gap-6 sm:gap-7">
        <span class="text-xs sm:text-[13px] font-extrabold uppercase tracking-[0.18em] text-[var(--mustard)] flex items-center gap-2">
            <Icon Name="calendar-days" Size="14" />
            <span>Calendario de lanzamientos · @FilteredReleases.Count disponibles</span>
        </span>

        <div class="flex flex-wrap justify-between items-end gap-6">
            <div class="flex flex-col gap-4 max-w-2xl">
                <h1 class="text-5xl sm:text-7xl lg:text-[88px] font-black leading-[0.88] tracking-[-0.055em] m-0 page-header-title">
                    Novedades<br>en <i class="text-[var(--mustard)] not-italic">tiendas</i>
                </h1>
                <p class="text-sm sm:text-base leading-relaxed opacity-85 m-0">
                    Lanzamientos y reimpresiones confirmados por las editoriales con su precio estimado. Consulta cada ficha para conocer fechas, contenido y tiendas colaboradoras.
                </p>
            </div>

            <div class="flex flex-wrap items-center gap-3">
                @if (IsModerator)
                {
                    <button type="button"
                            @onclick="HandleSyncEditorialReleases"
                            disabled="@_isSyncingEditorial"
                            class="h-11 sm:h-12 px-4 rounded-full border border-dashed border-[#FFF8EE]/40 bg-[#FFF8EE]/10 text-[#FFF8EE] font-extrabold text-xs inline-flex items-center gap-1.5 transition-colors disabled:opacity-50">
                        <Icon Name="refresh-cw" Size="14" Class="@(_isSyncingEditorial ? "animate-spin text-[var(--mustard)]" : "")" />
                        <span>@(_isSyncingEditorial ? "Sincronizando..." : "Sincronizar Editoriales")</span>
                    </button>
                    <button type="button"
                            @onclick="() => _isExpressModalOpen = true"
                            class="h-11 sm:h-12 px-4 rounded-full border border-dashed border-[#FFF8EE]/40 bg-[#FFF8EE]/10 text-[#FFF8EE] font-extrabold text-xs inline-flex items-center gap-1.5 transition-colors">
                        <Icon Name="zap" Size="14" />
                        <span>Alta Exprés</span>
                    </button>
                    <button type="button"
                            @onclick="() => _isCreateModalOpen = true"
                            class="h-11 sm:h-12 px-5 sm:px-6 rounded-full bg-[var(--mustard)] text-[#22180F] font-black text-xs sm:text-sm hover:opacity-95 transition-opacity inline-flex items-center gap-1.5 shadow-sm">
                        <Icon Name="plus" Size="15" />
                        <span>Añadir novedad</span>
                    </button>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_syncFeedbackMessage))
        {
            <div class="p-3.5 rounded-2xl border @(_syncFeedbackIsError ? "bg-rose-500/20 border-rose-500/40 text-rose-200" : "bg-emerald-500/20 border-emerald-500/40 text-emerald-200") flex items-center justify-between gap-3 text-xs font-bold animate-fadeIn">
                <div class="flex items-center gap-2 min-w-0">
                    <Icon Name="@(_syncFeedbackIsError ? "alert-triangle" : "check-circle-2")" Size="16" Class="shrink-0" />
                    <span class="truncate">@_syncFeedbackMessage</span>
                </div>
                <button type="button" @onclick="() => _syncFeedbackMessage = null" class="text-xs opacity-75 hover:opacity-100 shrink-0">
                    <Icon Name="x" Size="14" />
                </button>
            </div>
        }

        @* Barra de filtros y buscador *@
        <div class="flex flex-wrap items-center justify-between gap-4 pt-2 border-t border-[rgba(255,248,238,0.15)]">
            <div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
                <button type="button"
                        @onclick='() => _typeFilter = "all"'
                        class="h-9 px-4 rounded-full text-xs font-bold transition-all @(_typeFilter == "all" ? "bg-[#FFF8EE] text-[#22180F]" : "border border-[#FFF8EE]/30 text-[#FFF8EE] hover:bg-white/10")">
                    Todos los lanzamientos
                </button>
                <button type="button"
                        @onclick='() => _typeFilter = "new"'
                        class="h-9 px-4 rounded-full text-xs font-bold transition-all @(_typeFilter == "new" ? "bg-[#FFF8EE] text-[#22180F]" : "border border-[#FFF8EE]/30 text-[#FFF8EE] hover:bg-white/10")">
                    Novedades
                </button>
                <button type="button"
                        @onclick='() => _typeFilter = "reprint"'
                        class="h-9 px-4 rounded-full text-xs font-bold transition-all @(_typeFilter == "reprint" ? "bg-[#FFF8EE] text-[#22180F]" : "border border-[#FFF8EE]/30 text-[#FFF8EE] hover:bg-white/10")">
                    Reimpresiones
                </button>
            </div>

            <div class="relative w-full sm:w-72">
                <span class="absolute inset-y-0 left-3 flex items-center text-[var(--muted)] pointer-events-none">
                    <Icon Name="search" Size="15" />
                </span>
                <input type="text"
                       @bind="_searchTerm"
                       @bind:event="oninput"
                       placeholder="Buscar por título o editorial..."
                       class="w-full pl-9 pr-3 py-2 rounded-full bg-[rgba(255,248,238,0.1)] border border-[rgba(255,248,238,0.2)] text-xs text-[#FFF8EE] placeholder-[#FFF8EE]/50 focus:outline-none focus:border-[var(--mustard)]" />
            </div>
        </div>
    </div>
</section>

@* CUERPO DE LANZAMIENTOS *@
<div class="max-w-[1280px] mx-auto px-4 sm:px-8 lg:px-12 py-8 sm:py-14 flex flex-col gap-10">
    @if (_isLoading)
    {
        <div class="py-20 text-center text-[var(--muted)]">
            <div class="inline-block animate-spin text-[var(--brand)] mb-3"><Icon Name="package" Size="36" /></div>
            <p class="text-sm font-semibold">Cargando lanzamientos de tiendas...</p>
        </div>
    }
    else if (FilteredReleases.Count == 0)
    {
        <div class="p-12 text-center rounded-2xl bg-[var(--card)] border border-[var(--line)] max-w-lg mx-auto">
            <span class="inline-block mb-3 text-[var(--muted)]"><Icon Name="package" Size="40" /></span>
            <h3 class="text-base font-black text-[var(--ink)] mb-1">Sin lanzamientos encontrados</h3>
            <p class="text-xs text-[var(--muted)] mb-5">
                No hay novedades registradas con los filtros actuales en el calendario.
            </p>
            @if (IsModerator)
            {
                <button type="button"
                        @onclick="() => _isCreateModalOpen = true"
                        class="h-10 px-5 rounded-full bg-[var(--brand)] text-[var(--on-brand)] font-extrabold text-xs inline-flex items-center gap-1.5 shadow-sm">
                    <Icon Name="plus" Size="14" />
                    <span>Añadir primer lanzamiento</span>
                </button>
            }
        </div>
    }
    else
    {
        @* Lista editorial de novedades estilo Claude Design *@
        <div class="flex flex-col">
            <div class="flex justify-between items-baseline gap-3 border-b-[3px] border-[var(--rule)] pb-3 mb-2">
                <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-[var(--ink)] m-0">
                    Llegadas confirmadas
                </h2>
                <span class="text-xs sm:text-sm font-extrabold text-[var(--muted)]">
                    @FilteredReleases.Count títulos en calendario
                </span>
            </div>

            <div class="flex flex-col divide-y divide-[var(--line)]">
                @for (int i = 0; i < FilteredReleases.Count; i++)
                {
                    var release = FilteredReleases[i];
                    var rotation = (i % 3) switch { 0 => "-rotate-1", 1 => "rotate-2", _ => "-rotate-2" };
                    var dayText = release.ReleaseDate.HasValue ? release.ReleaseDate.Value.Day.ToString("00") : "--";
                    var monthText = release.ReleaseDate.HasValue ? release.ReleaseDate.Value.ToString("MMM", new System.Globalization.CultureInfo("es-ES")) : "PRÓX";

                    <div class="rail-card flex flex-wrap items-center gap-3.5 sm:gap-6 py-4 sm:py-5 hover:bg-[var(--paper-2)]/40 transition-colors px-1 group">
                        @* Columna de fecha de lanzamiento *@
                        <div class="w-14 sm:w-16 shrink-0 flex flex-col leading-none">
                            <b class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-[-0.05em] text-[var(--ink)] tabular-nums">
                                @dayText
                            </b>
                            <span class="text-[10px] sm:text-[11px] font-black uppercase text-[var(--muted)] tracking-wider mt-0.5">
                                @monthText
                            </span>
                        </div>

                        @* Carátula rotada con enlace a la ficha de novedad *@
                        <a href="/novedades/@release.Id"
                           class="w-16 h-16 sm:w-20 sm:h-20 shrink-0 rounded overflow-hidden shadow-xs border border-black/5 @rotation group-hover:rotate-0 transition-transform duration-300 block">
                            @if (string.IsNullOrWhiteSpace(release.CoverImageUrl))
                            {
                                <DefaultImage Domain="DefaultImageDomain.Novedad"
                                              Alt="@($"Carátula de {release.Title}")"
                                              CssClass="w-full h-full object-cover" />
                            }
                            else
                            {
                                <img src="@release.CoverImageUrl"
                                     alt="Carátula de @release.Title"
                                     width="84"
                                     height="84"
                                     loading="lazy"
                                     decoding="async"
                                     onerror="this.onerror=null; this.src='/images/defaults/novedad-default.svg';"
                                     class="w-full h-full object-cover" />
                            }
                        </a>

                        @* Información editorial *@
                        <div class="flex-1 min-w-[200px] flex flex-col gap-1">
                            <div class="flex items-center gap-2">
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-black inline-flex items-center gap-1 @(release.IsReprint ? "bg-[var(--paper-2)] text-[var(--muted)] border border-[var(--line)]" : "bg-[#FFC145] text-[#22180F]")">
                                    @if (release.IsReprint)
                                    {
                                        <Icon Name="refresh-cw" Size="10" />
                                        <span>Reimpresión</span>
                                    }
                                    else
                                    {
                                        <span>Novedad</span>
                                    }
                                </span>
                                @if (release.IsPublishedOnInstagram && !string.IsNullOrWhiteSpace(release.InstagramPermalink))
                                {
                                    <a href="@release.InstagramPermalink"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="text-[10px] font-bold text-[var(--muted)] hover:text-[var(--ink)] inline-flex items-center gap-1">
                                        <Icon Name="camera" Size="10" />
                                        <span>Instagram</span>
                                    </a>
                                }
                            </div>

                            <a href="/novedades/@release.Id"
                               class="text-base sm:text-lg lg:text-xl font-black text-[var(--ink)] tracking-tight leading-snug hover:text-[var(--accent)] transition-colors block">
                                @release.Title
                            </a>

                            <div class="text-xs text-[var(--muted)] font-medium">
                                <span>@release.Publisher</span>
                                <span>·</span>
                                <span>Fuente oficial</span>
                            </div>
                        </div>

                        @* PVP Estimado *@
                        <div class="shrink-0 text-right min-w-[80px]">
                            @if (release.EstimatedPvp.HasValue)
                            {
                                <b class="text-lg sm:text-xl font-black text-[var(--ink)] tabular-nums">
                                    @release.EstimatedPvp.Value.ToString("0.00") €
                                </b>
                            }
                            else
                            {
                                <span class="text-xs font-bold text-[var(--muted)]">PVP pendiente</span>
                            }
                        </div>

                        @* Acciones: Ver ficha y noticia *@
                        <div class="flex items-center gap-2 shrink-0">
                            <a href="/novedades/@release.Id"
                               class="h-10 px-4 rounded-full bg-[var(--inverse)] text-[var(--on-inverse)] font-bold text-xs inline-flex items-center hover:opacity-90 transition-opacity shadow-xs">
                                Ver ficha
                            </a>
                            @if (!string.IsNullOrWhiteSpace(release.SourceUrl))
                            {
                                <a href="@release.SourceUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="h-10 px-4 rounded-full border border-[var(--line)] bg-[var(--card)] hover:border-[var(--ink)] text-[var(--ink)] font-bold text-xs inline-flex items-center gap-1 transition-colors">
                                    <span>Noticia ↗</span>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@* Modal para Registrar Novedad Manualmente *@
<EditorialModal Open="@_isCreateModalOpen"
                Title="Añadir Novedad Editorial"
                TitleIcon="newspaper"
                OnClose="@(() => _isCreateModalOpen = false)">
    <ChildContent>
        <div class="space-y-3 text-xs">
            <div>
                <label class="font-semibold text-[var(--text-secondary)] block mb-1">Título del Juego *</label>
                <input type="text"
                       @bind="_formTitle"
                       placeholder="Ej. Heat: Lluvia Torrencial"
                       class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="font-semibold text-[var(--text-secondary)] block mb-1">Editorial / Distribuidora *</label>
                    <input type="text"
                           @bind="_formPublisher"
                           placeholder="Ej. Asmodee / Days of Wonder"
                           class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
                </div>
                <div>
                    <label class="font-semibold text-[var(--text-secondary)] block mb-1">Fecha de Lanzamiento (Opcional)</label>
                    <input type="date"
                           @bind="_formReleaseDate"
                           class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="font-semibold text-[var(--text-secondary)] block mb-1">PVP Estimado (€)</label>
                    <input type="number"
                           step="0.5"
                           @bind="_formPvp"
                           placeholder="Ej. 39.99"
                           class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                </div>
                <div class="flex items-center pt-5">
                    <label class="flex items-center gap-2 cursor-pointer font-medium text-[var(--text-secondary)]">
                        <input type="checkbox"
                               @bind="_formIsReprint"
                               class="rounded bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--brand-primary)] focus:ring-0" />
                        <span>Es Reimpresión</span>
                    </label>
                </div>
            </div>

            <div>
                <label class="font-semibold text-[var(--text-secondary)] block mb-1">Enlace Oficial a la Noticia / Fuente *</label>
                <input type="url"
                       @bind="_formSourceUrl"
                       placeholder="https://... (web de editorial, tienda o publicación oficial)"
                       class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
                <span class="text-[0.68rem] text-[var(--text-muted)] mt-1 block">
                    Obligatorio: enlace web donde se anunció oficialmente la novedad o preventa.
                </span>
            </div>

            <div>
                <label class="font-semibold text-[var(--text-secondary)] block mb-1">URL de Carátula (Opcional)</label>
                <input type="url"
                       @bind="_formCoverImageUrl"
                       placeholder="https://... o /images/..."
                       class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
            </div>

            <div>
                <label class="font-semibold text-[var(--text-secondary)] block mb-1">Notas Editoriales (Opcional)</label>
                <textarea rows="2"
                          @bind="_formNotes"
                          placeholder="Ej. Incluye nuevos circuitos y modo solitario mejorado..."
                          class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]"></textarea>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_formError))
        {
            <div class="p-2.5 rounded-xl bg-[var(--state-error-bg)] border border-[var(--state-error-border)] text-[var(--state-error)] text-xs">
                @_formError
            </div>
        }
    </ChildContent>

    <Footer>
        <button type="button"
                @onclick="() => _isCreateModalOpen = false"
                class="px-4 py-2 rounded-xl border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] text-xs font-bold transition-colors">
            Cancelar
        </button>
        <button type="button"
                @onclick="HandleSubmitRelease"
                class="px-4 py-2 rounded-xl bg-[var(--brand-primary)] hover:opacity-90 text-[var(--on-brand)] text-xs font-bold transition-opacity">
            Guardar y Publicar
        </button>
    </Footer>
</EditorialModal>

<SocialExpressIngestModal IsOpen="_isExpressModalOpen"
                          OnClose="() => _isExpressModalOpen = false"
                          OnItemCreated="HandleExpressItemCreated" />

@code {
    private bool _isLoading = true;
    private IReadOnlyList<WeeklyReleaseDto> _releases = new List<WeeklyReleaseDto>();
    private string _searchTerm = string.Empty;
    private string? _selectedPublisher;
    private string _typeFilter = "all";

    private bool _isSyncingEditorial;
    private string? _syncFeedbackMessage;
    private bool _syncFeedbackIsError;

    private bool _isExpressModalOpen;
    private bool _isCreateModalOpen;
    private string _formTitle = string.Empty;
    private string _formPublisher = string.Empty;
    private DateOnly? _formReleaseDate;
    private decimal? _formPvp;
    private bool _formIsReprint;
    private string? _formCoverImageUrl;
    private string? _formSourceUrl;
    private string? _formNotes;
    private string? _formError;

    private bool IsModerator => CurrentUserService.IsFoundingTeam || CurrentUserService.IsInRole("Moderator");

    private IReadOnlyList<WeeklyReleaseDto> FilteredReleases
    {
        get
        {
            var query = _releases.AsEnumerable();

            if (_typeFilter == "new")
            {
                query = query.Where(r => !r.IsReprint);
            }
            else if (_typeFilter == "reprint")
            {
                query = query.Where(r => r.IsReprint);
            }

            if (!string.IsNullOrWhiteSpace(_selectedPublisher))
            {
                query = query.Where(r => r.Publisher.Equals(_selectedPublisher, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim();
                query = query.Where(r => r.Title.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                                         r.Publisher.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            return query.OrderByDescending(r => r.CreatedAt).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _releases = await ReleaseService.GetReleasesAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSyncEditorialReleases()
    {
        if (_isSyncingEditorial) return;
        _isSyncingEditorial = true;
        _syncFeedbackMessage = null;
        StateHasChanged();

        try
        {
            var summary = await EditorialSyncService.SyncAllEditorialReleasesAsync();
            _syncFeedbackIsError = summary.Errors.Count > 0 && summary.TotalFound == 0;
            _syncFeedbackMessage = $"Sincronización completada: {summary.TotalFound} novedades encontradas ({summary.CreatedCount} creadas, {summary.UpdatedCount} actualizadas, {summary.GamesLinkedCount} enlazadas al catálogo)." +
                (summary.Errors.Count > 0 ? $" (Avisos: {string.Join(", ", summary.Errors)})" : string.Empty);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _syncFeedbackIsError = true;
            _syncFeedbackMessage = $"Error al sincronizar: {ex.Message}";
        }
        finally
        {
            _isSyncingEditorial = false;
            StateHasChanged();
        }
    }

    private async Task HandleSubmitRelease()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_formTitle))
        {
            _formError = "El título del lanzamiento es obligatorio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_formPublisher))
        {
            _formError = "La editorial es obligatoria.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_formSourceUrl))
        {
            _formError = "El enlace oficial o noticia de la novedad es obligatorio (igual que en sorteos).";
            return;
        }

        if (!Uri.TryCreate(_formSourceUrl.Trim(), UriKind.Absolute, out var parsedUri) ||
            (parsedUri.Scheme != Uri.UriSchemeHttp && parsedUri.Scheme != Uri.UriSchemeHttps))
        {
            _formError = "El enlace oficial debe ser una URL válida que empiece por http:// o https://.";
            return;
        }

        var request = new CreateWeeklyReleaseRequest(
            Title: _formTitle,
            Publisher: _formPublisher,
            ReleaseDate: _formReleaseDate,
            CoverImageUrl: string.IsNullOrWhiteSpace(_formCoverImageUrl) ? null : _formCoverImageUrl.Trim(),
            EstimatedPvp: _formPvp,
            IsReprint: _formIsReprint,
            Notes: string.IsNullOrWhiteSpace(_formNotes) ? null : _formNotes.Trim(),
            SourceUrl: string.IsNullOrWhiteSpace(_formSourceUrl) ? null : _formSourceUrl.Trim());

        try
        {
            await ReleaseService.CreateReleaseAsync(request);
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
            return;
        }

        _isCreateModalOpen = false;
        _formTitle = string.Empty;
        _formPublisher = string.Empty;
        _formReleaseDate = null;
        _formPvp = null;
        _formIsReprint = false;
        _formCoverImageUrl = null;
        _formSourceUrl = null;
        _formNotes = null;

        await LoadDataAsync();
    }

    private async Task HandleExpressItemCreated(Ludeka.Application.DTOs.SocialInboxItemDto item)
    {
        _isExpressModalOpen = false;
        await LoadDataAsync();
    }
}
