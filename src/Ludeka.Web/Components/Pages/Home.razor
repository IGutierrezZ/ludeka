            </button>

            <span class="text-xs font-semibold text-[var(--text-muted)]">
                Página <strong class="text-[var(--text-primary)]">@_currentPage</strong> de <strong class="text-[var(--text-primary)]">@_totalPages</strong>
            </span>

            <button type="button"
                    @onclick="NextPage"
                    disabled="@(_currentPage >= _totalPages)"
                    class="px-4 py-2.5 rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] disabled:opacity-30 disabled:cursor-not-allowed transition-all font-semibold flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)]"
                    aria-label="Página siguiente">
                <span>Siguiente</span>
                <Icon Name="chevron-right" Size="14" />
            </button>
        </div>
    }
</div>

@code {
    private enum Preset { Todos, JuegosBase, Expansiones, EspecialParejas, MesaFamiliar, SoloTop, PartidasRapidas }

    private Preset _activePreset = Preset.Todos;
    private readonly HashSet<int> _selectedPlayerCounts = [];
    private readonly HashSet<GameComplexity> _selectedComplexities = [];
    private readonly HashSet<GameType> _selectedTypes = [];
    private readonly HashSet<GameStyle> _selectedStyles = [];
    private readonly HashSet<TableFootprint> _selectedFootprints = [];
    private readonly HashSet<ConfrontationType> _selectedConfrontations = [];
    private readonly HashSet<int> _selectedMaxDurations = [];
    private GameSortOrder _sortBy = GameSortOrder.Rank;

    private bool _showAdvancedFilters = false;

    // Propiedades de compatibilidad para contratos y pruebas existentes (INC-59 / INC-72)
    private TableFootprint? _selectedFootprint => _selectedFootprints.Count == 1 ? _selectedFootprints.First() : null;
    private int? _selectedPlayerCount => _selectedPlayerCounts.Count == 1 ? _selectedPlayerCounts.First() : null;
    private int? _selectedMaxDuration => _selectedMaxDurations.Count == 1 ? _selectedMaxDurations.First() : null;

    private string _searchTerm = string.Empty;
    private bool _isLoading = true;
    private int _totalCount = 0;
    private int _totalPages = 0;
    private int _currentPage = 1;
    private const int _pageSize = 24;
    private string _viewMode = "grid";
    private bool _isInternalNavigation = false;
    private IReadOnlyList<GameSummaryDto> _games = [];

    private int ActiveAdvancedFiltersCount =>
        _selectedPlayerCounts.Count +
        _selectedComplexities.Count +
        _selectedTypes.Count +
        _selectedStyles.Count +
        _selectedFootprints.Count +
        _selectedConfrontations.Count +
        _selectedMaxDurations.Count;

    private bool HasActiveRefinements =>
        ActiveAdvancedFiltersCount > 0 ||
        _activePreset != Preset.Todos ||
        !string.IsNullOrWhiteSpace(_searchTerm);

    private void ToggleAdvancedFilters()
    {
        _showAdvancedFilters = !_showAdvancedFilters;
    }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        ReadQueryParameters();
        await LoadCatalogAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_isInternalNavigation) return;

        _ = InvokeAsync(async () =>
        {
            ReadQueryParameters();
            await LoadCatalogAsync();
        });
    }

    private void ReadQueryParameters()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("q", out var qVal) && !string.IsNullOrWhiteSpace(qVal))
        {
            _searchTerm = qVal.ToString();
        }
        else
        {
            _searchTerm = string.Empty;
        }

        if (query.TryGetValue("page", out var pVal) && int.TryParse(pVal, out var pageNum) && pageNum >= 1)
        {
            _currentPage = pageNum;
        }
        else
        {
            _currentPage = 1;
        }

        if (query.TryGetValue("view", out var vVal) && string.Equals(vVal.ToString(), "list", StringComparison.OrdinalIgnoreCase))
        {
            _viewMode = "list";
        }
        else
        {
            _viewMode = "grid";
        }

        if (query.ContainsKey("parejas"))
        {
            _activePreset = Preset.EspecialParejas;
        }
        else if (query.ContainsKey("familiar"))
        {
            _activePreset = Preset.MesaFamiliar;
        }
        else if (query.ContainsKey("expansiones"))
        {
            _activePreset = Preset.Expansiones;
        }
        else if (query.ContainsKey("solo"))
        {
            _activePreset = Preset.SoloTop;
        }
        else if (query.ContainsKey("rapidas"))
        {
            _activePreset = Preset.PartidasRapidas;
        }
        else if (query.TryGetValue("tipo", out var tipoVal) && string.Equals(tipoVal.ToString(), "base", StringComparison.OrdinalIgnoreCase))
        {
            _activePreset = Preset.JuegosBase;
        }
        else if (query.TryGetValue("preset", out var presetVal))
        {
            _activePreset = presetVal.ToString() switch
            {
                "parejas" => Preset.EspecialParejas,
                "familiar" => Preset.MesaFamiliar,
                "expansiones" => Preset.Expansiones,
                "base" => Preset.JuegosBase,
                "solo" => Preset.SoloTop,
                "rapidas" => Preset.PartidasRapidas,
                _ => Preset.Todos
            };
        }
        else
        {
            _activePreset = Preset.Todos;
        }

        _selectedFootprints.Clear();
        if (query.TryGetValue("mesa", out var mesaVal) && !string.IsNullOrWhiteSpace(mesaVal))
        {
            foreach (var item in mesaVal.ToString().Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                var fp = item.ToLowerInvariant() switch
                {
                    "pequena" or "small" => TableFootprint.SmallTable,
                    "estandar" or "standard" => TableFootprint.StandardTable,
                    "monstruo" or "monster" or "grande" => TableFootprint.TableMonster,
                    _ => (TableFootprint?)null
                };
                if (fp.HasValue) _selectedFootprints.Add(fp.Value);
            }
        }

        _selectedPlayerCounts.Clear();
        var jTokens = query.TryGetValue("jugadores", out var jVal) ? jVal.ToString()
            : (query.TryGetValue("players", out var pVal2) ? pVal2.ToString() : null);
        if (!string.IsNullOrWhiteSpace(jTokens))
        {
            foreach (var item in jTokens.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                if (int.TryParse(item, out var num) && num >= 1)
                {
                    _selectedPlayerCounts.Add(num);
                }
            }
        }

        _selectedMaxDurations.Clear();
        var dTokens = query.TryGetValue("duracion", out var dVal) ? dVal.ToString()
            : (query.TryGetValue("duration", out var durVal2) ? durVal2.ToString() : null);
        if (!string.IsNullOrWhiteSpace(dTokens))
        {
            foreach (var item in dTokens.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                if (int.TryParse(item, out var num) && num > 0)
                {
                    _selectedMaxDurations.Add(num);
                }
            }
        }

        _selectedComplexities.Clear();
        if (query.TryGetValue("dureza", out var durezaVal) && !string.IsNullOrWhiteSpace(durezaVal))
        {
            foreach (var item in durezaVal.ToString().Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                if (Enum.TryParse<GameComplexity>(item, ignoreCase: true, out var c))
                {
                    _selectedComplexities.Add(c);
                }
            }
        }

        _selectedStyles.Clear();
        if (query.TryGetValue("estilos", out var estilosVal) && !string.IsNullOrWhiteSpace(estilosVal))
        {
            foreach (var item in estilosVal.ToString().Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                if (Enum.TryParse<GameStyle>(item, ignoreCase: true, out var s))
                {
                    _selectedStyles.Add(s);
                }
            }
        }

        _selectedConfrontations.Clear();
        if (query.TryGetValue("confrontacion", out var confVal) && !string.IsNullOrWhiteSpace(confVal))
        {
            foreach (var item in confVal.ToString().Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                if (Enum.TryParse<ConfrontationType>(item, ignoreCase: true, out var c))
                {
                    _selectedConfrontations.Add(c);
                }
            }
        }

        _selectedTypes.Clear();
        if (query.TryGetValue("tipos", out var tiposVal) && !string.IsNullOrWhiteSpace(tiposVal))
        {
            foreach (var item in tiposVal.ToString().Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                if (Enum.TryParse<GameType>(item, ignoreCase: true, out var t))
                {
                    _selectedTypes.Add(t);
                }
            }
        }

        if (query.TryGetValue("orden", out var oVal) && !string.IsNullOrWhiteSpace(oVal))
        {
            var oNormalized = oVal.ToString().ToLowerInvariant();
            if (oNormalized is "tendencia" or "tendencias" or "trending" or "hot" or "hotness")
            {
                Navigation.NavigateTo("/tendencias", replace: true);
                return;
            }

            _sortBy = oNormalized switch
            {
                "rating" => GameSortOrder.RatingDesc,
                "dureza-asc" or "ligero" => GameSortOrder.ComplexityAsc,
                "dureza-desc" or "duro" => GameSortOrder.ComplexityDesc,
                "duracion-asc" or "rapido" => GameSortOrder.DurationAsc,
                "duracion-desc" or "largo" => GameSortOrder.DurationDesc,
                "novedad" or "ano" or "year" => GameSortOrder.YearDesc,
                "alfabetico" or "titulo" or "az" => GameSortOrder.TitleAsc,
                _ => GameSortOrder.Rank
            };
        }
        else
        {
            _sortBy = GameSortOrder.Rank;
        }

        if (ActiveAdvancedFiltersCount > 0)
        {
            _showAdvancedFilters = true;
        }
    }

    private void SyncUrl()
    {
        var queryParams = new Dictionary<string, string?>();

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            queryParams["q"] = _searchTerm;
        }

        if (_currentPage > 1)
        {
            queryParams["page"] = _currentPage.ToString();
        }

        if (_viewMode == "list")
        {
            queryParams["view"] = "list";
        }

        switch (_activePreset)
        {
            case Preset.EspecialParejas:
                queryParams["parejas"] = "1";
                break;
            case Preset.MesaFamiliar:
                queryParams["familiar"] = "1";
                break;
            case Preset.Expansiones:
                queryParams["expansiones"] = "1";
                break;
            case Preset.JuegosBase:
                queryParams["tipo"] = "base";
                break;
            case Preset.SoloTop:
                queryParams["solo"] = "1";
                break;
            case Preset.PartidasRapidas:
                queryParams["rapidas"] = "1";
                break;
        }

        if (_selectedFootprints.Count > 0)
        {
            queryParams["mesa"] = string.Join(",", _selectedFootprints.Select(f => f switch
            {
                TableFootprint.SmallTable => "pequena",
                TableFootprint.TableMonster => "monstruo",
                _ => "estandar"
            }));
        }

        if (_selectedPlayerCounts.Count > 0)
        {
            queryParams["jugadores"] = string.Join(",", _selectedPlayerCounts.OrderBy(x => x));
        }

        if (_selectedMaxDurations.Count > 0)
        {
            queryParams["duracion"] = string.Join(",", _selectedMaxDurations.OrderBy(x => x));
        }

        if (_selectedComplexities.Count > 0)
        {
            queryParams["dureza"] = string.Join(",", _selectedComplexities.Select(c => c.ToString().ToLowerInvariant()));
        }

        if (_selectedStyles.Count > 0)
        {
            queryParams["estilos"] = string.Join(",", _selectedStyles.Select(s => s.ToString().ToLowerInvariant()));
        }

        if (_selectedConfrontations.Count > 0)
        {
            queryParams["confrontacion"] = string.Join(",", _selectedConfrontations.Select(c => c.ToString().ToLowerInvariant()));
        }

        if (_selectedTypes.Count > 0)
        {
            queryParams["tipos"] = string.Join(",", _selectedTypes.Select(t => t.ToString().ToLowerInvariant()));
        }

        if (_sortBy != GameSortOrder.Rank)
        {
            queryParams["orden"] = _sortBy switch
            {
                GameSortOrder.RatingDesc => "rating",
                GameSortOrder.ComplexityAsc => "dureza-asc",
                GameSortOrder.ComplexityDesc => "dureza-desc",
                GameSortOrder.DurationAsc => "duracion-asc",
                GameSortOrder.DurationDesc => "duracion-desc",
                GameSortOrder.YearDesc => "novedad",
                GameSortOrder.TitleAsc => "alfabetico",
                _ => null
            };
        }

        var targetUrl = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/catalogo", queryParams);

        try
        {
            _isInternalNavigation = true;
            Navigation.NavigateTo(targetUrl, replace: true);
        }
        finally
        {
            _isInternalNavigation = false;
        }
    }

    private async Task OnSearchChanged(string term)
    {
        _searchTerm = term;
        _currentPage = 1;
        SyncUrl();
        await LoadCatalogAsync();
    }

    private async Task SetPreset(Preset preset)
    {
        _activePreset = (_activePreset == preset && preset != Preset.Todos) ? Preset.Todos : preset;
        if (_activePreset == Preset.JuegosBase || _activePreset == Preset.Expansiones)
        {
            _selectedTypes.Clear();
        }
        if (_activePreset == Preset.PartidasRapidas)
        {
            _selectedMaxDurations.Clear();
        }
        _currentPage = 1;
        SyncUrl();
        await LoadCatalogAsync();
    }

    private void SetViewMode(string mode)
    {
        var normalized = mode == "list" ? "list" : "grid";
        if (_viewMode == normalized) return;

        _viewMode = normalized;
        SyncUrl();
        StateHasChanged();
    }

    private async Task PreviousPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            SyncUrl();
            await LoadCatalogAsync();
        }
    }

    private async Task NextPage()
    {
        if (_currentPage < _totalPages)
        {
            _currentPage++;
            SyncUrl();
            await LoadCatalogAsync();
        }
    }

