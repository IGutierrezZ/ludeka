@page "/catalogo"
@rendermode InteractiveServer
@implements IDisposable
@using Ludeka.Core.Enums
@using Microsoft.AspNetCore.Components.Routing
@inject ICatalogService CatalogService
@inject NavigationManager Navigation

<PageTitle>Catálogo de Juegos de Mesa — Ludeka</PageTitle>

<div class="container-ludeka pt-3 pb-8">
    @* Buscador principal elevado (elevación visual sin redundancias) *@
    <div class="max-w-2xl mb-5">
        <CatalogSearchBar Value="@_searchTerm" ValueChanged="@OnSearchChanged" />
    </div>

    @* Zona de Filtros Avanzados (Colapsable / Acordeón con multiselección) *@
    <div class="mb-6">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-2.5">
            <button type="button"
                    @onclick="ToggleAdvancedFilters"
                    class="px-3.5 py-2 rounded-xl border text-xs font-bold transition-all flex items-center gap-2 @(_showAdvancedFilters || ActiveAdvancedFiltersCount > 0 ? "bg-[var(--bg-surface-elevated)] border-[var(--brand-primary)] text-[var(--brand-primary)] shadow-sm" : "bg-[var(--bg-card)] border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-highlight)]")"
                    aria-expanded="@_showAdvancedFilters"
                    aria-controls="panel-filtros-avanzados">
                <Icon Name="sliders-horizontal" Size="14" />
                <span>Filtros avanzados</span>
                @if (ActiveAdvancedFiltersCount > 0)
                {
                    <span class="px-1.5 py-0.2 rounded-full bg-[var(--brand-primary)] text-white text-[0.65rem] font-black">
                        @ActiveAdvancedFiltersCount
                    </span>
                }
                <Icon Name="@(_showAdvancedFilters ? "chevron-up" : "chevron-down")" Size="13" />
            </button>

            @if (HasActiveRefinements)
            {
                <button type="button"
                        @onclick="ResetFilters"
                        class="text-xs font-semibold text-[var(--brand-primary)] hover:underline flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] rounded px-2 py-1"
                        aria-label="Restablecer todos los filtros">
                    <Icon Name="x" Size="13" />
                    <span>Limpiar filtros</span>
                </button>
            }
        </div>

        @if (_showAdvancedFilters)
        {
            <div id="panel-filtros-avanzados" class="p-4 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-4 text-xs shadow-md animate-fade-in">
                <div class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-2">
                    <span class="font-extrabold text-sm text-[var(--text-primary)] flex items-center gap-2">
                        <Icon Name="sparkles" Size="14" />
                        <span>Refinar por mesa y partida</span>
                    </span>
                    <span class="text-[0.68rem] text-[var(--text-muted)] italic hidden sm:inline">
                        Multiselección disponible en todos los filtros
                    </span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    @* 1. Número de comensales (PlayerCounts) - Multiselección *@
                    <div class="flex flex-col gap-1.5" role="group" aria-label="Filtrar por número de jugadores">
                        <div class="flex items-center justify-between">
                            <span class="text-[0.72rem] font-bold uppercase tracking-wider text-[var(--text-muted)] flex items-center gap-1.5">
                                <Icon Name="users" Size="13" />
                                <span>Jugadores en mesa</span>
                            </span>
                            @if (_selectedPlayerCounts.Count > 0)
                            {
                                <button type="button" @onclick="() => SetPlayerCount(null)" class="text-[0.65rem] text-[var(--text-muted)] hover:text-[var(--brand-primary)]">
                                    Desmarcar
                                </button>
                            }
                        </div>
                        <div class="flex items-center gap-1 flex-wrap">
                            <button type="button"
                                    class="px-2 py-1.5 rounded-lg border text-xs font-semibold transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedPlayerCounts.Count == 0 ? "bg-[var(--brand-primary)] text-white border-transparent" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                                    @onclick="() => SetPlayerCount(null)"
                                    aria-label="Cualquier número de jugadores"
                                    aria-pressed="@(_selectedPlayerCounts.Count == 0 ? "true" : "false")">
                                Todos
                            </button>
                            @foreach (var count in new[] { 1, 2, 3, 4, 5, 6, 7 })
                            {
                                var c = count;
                                var label = c >= 7 ? "7+" : c.ToString();
                                var isSelected = _selectedPlayerCounts.Contains(c);
                                <button type="button"
                                        class="w-8 py-1.5 rounded-lg border text-xs font-semibold text-center transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(isSelected ? "bg-[var(--brand-primary)] text-white border-transparent shadow-sm" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                                        @onclick="() => TogglePlayerCount(c)"
                                        aria-label="@(c >= 7 ? "7 o más jugadores" : $"{c} jugadores")"
                                        aria-pressed="@(isSelected ? "true" : "false")">
                                    @label
                                </button>
                            }
                        </div>
                    </div>

                    @* 2. Dureza / Complejidad cognitiva (Complexities) - Multiselección *@
                    <div class="flex flex-col gap-1.5" role="group" aria-label="Filtrar por dureza">
                        <span class="text-[0.72rem] font-bold uppercase tracking-wider text-[var(--text-muted)] flex items-center gap-1.5">
                            <Icon Name="brain" Size="13" />
                            <span>Dureza / Complejidad</span>
                        </span>
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <button type="button"
                                    class="px-2.5 py-1.5 rounded-lg border text-xs font-semibold transition-all flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedComplexities.Contains(GameComplexity.Light) ? "bg-[var(--brand-primary)] text-white border-transparent shadow-sm" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                                    @onclick="() => ToggleComplexity(GameComplexity.Light)"
                                    aria-label="Dureza ligera o familiar"
                                    aria-pressed="@(_selectedComplexities.Contains(GameComplexity.Light) ? "true" : "false")"
                                    title="Fácil de explicar y jugar">
                                <Icon Name="feather" Size="12" />
                                <span>Ligero</span>
                            </button>
                            <button type="button"
                                    class="px-2.5 py-1.5 rounded-lg border text-xs font-semibold transition-all flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedComplexities.Contains(GameComplexity.Medium) ? "bg-[var(--brand-primary)] text-white border-transparent shadow-sm" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                                    @onclick="() => ToggleComplexity(GameComplexity.Medium)"
                                    aria-label="Dureza media"
                                    aria-pressed="@(_selectedComplexities.Contains(GameComplexity.Medium) ? "true" : "false")"
                                    title="Reglas accesibles con profundidad táctica">
                                <Icon Name="zap" Size="12" />
                                <span>Medio</span>
                            </button>
                            <button type="button"
                                    class="px-2.5 py-1.5 rounded-lg border text-xs font-semibold transition-all flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedComplexities.Contains(GameComplexity.Heavy) ? "bg-[var(--brand-primary)] text-white border-transparent shadow-sm" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                                    @onclick="() => ToggleComplexity(GameComplexity.Heavy)"
                                    aria-label="Dureza alta o experto"
                                    aria-pressed="@(_selectedComplexities.Contains(GameComplexity.Heavy) ? "true" : "false")"
                                    title="Juegos densos y exigentes para jugadores experimentados">
                                <Icon Name="shield-alert" Size="12" />
                                <span>Duro</span>
                            </button>
                        </div>
                    </div>

                    @* 3. Tipo de juego (Types) - Multiselección *@
                    <div class="flex flex-col gap-1.5" role="group" aria-label="Filtrar por tipo de juego">
                        <span class="text-[0.72rem] font-bold uppercase tracking-wider text-[var(--text-muted)] flex items-center gap-1.5">
                            <Icon Name="layers" Size="13" />
                            <span>Tipo de juego</span>
                        </span>
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <button type="button"
                                    class="px-2.5 py-1.5 rounded-lg border text-xs font-semibold transition-all flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedTypes.Contains(GameType.BaseGame) ? "bg-[var(--brand-primary)] text-white border-transparent shadow-sm" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                                    @onclick="() => ToggleType(GameType.BaseGame)"
                                    aria-label="Juegos base completos"
                                    aria-pressed="@(_selectedTypes.Contains(GameType.BaseGame) ? "true" : "false")">
                                <Icon Name="dices" Size="12" />
                                <span>Juego Base</span>
                            </button>
                            <button type="button"
                                    class="px-2.5 py-1.5 rounded-lg border text-xs font-semibold transition-all flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedTypes.Contains(GameType.Expansion) ? "bg-[var(--brand-primary)] text-white border-transparent shadow-sm" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                                    @onclick="() => ToggleType(GameType.Expansion)"
                                    aria-label="Expansiones oficiales"
                                    aria-pressed="@(_selectedTypes.Contains(GameType.Expansion) ? "true" : "false")">
                                <Icon Name="puzzle" Size="12" />
                                <span>Expansión</span>
                            </button>
                            <button type="button"
                                    class="px-2.5 py-1.5 rounded-lg border text-xs font-semibold transition-all flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedTypes.Contains(GameType.StandaloneExpansion) ? "bg-[var(--brand-primary)] text-white border-transparent shadow-sm" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                                    @onclick="() => ToggleType(GameType.StandaloneExpansion)"
                                    aria-label="Expansiones autojugables"
                                    aria-pressed="@(_selectedTypes.Contains(GameType.StandaloneExpansion) ? "true" : "false")">
                                <Icon Name="box" Size="12" />
                                <span>Autojugable</span>
                            </button>
                        </div>
                    </div>

                    @* 4. Categoría / Estilo lúdico (Styles) - Multiselección *@
                    <div class="flex flex-col gap-1.5" role="group" aria-label="Filtrar por categoría o estilo">
                        <span class="text-[0.72rem] font-bold uppercase tracking-wider text-[var(--text-muted)] flex items-center gap-1.5">
                            <Icon Name="shapes" Size="13" />
                            <span>Categoría / Estilo</span>
                        </span>
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <button type="button"
                                    class="px-2.5 py-1.5 rounded-lg border text-xs font-semibold transition-all flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedStyles.Contains(GameStyle.Eurogame) ? "bg-[var(--brand-primary)] text-white border-transparent shadow-sm" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                                    @onclick="() => ToggleStyle(GameStyle.Eurogame)"
                                    aria-label="Eurogames de gestión y estrategia"
                                    aria-pressed="@(_selectedStyles.Contains(GameStyle.Eurogame) ? "true" : "false")">
                                <Icon Name="settings" Size="12" />
                                <span>Euro</span>
                            </button>
                            <button type="button"
                                    class="px-2.5 py-1.5 rounded-lg border text-xs font-semibold transition-all flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedStyles.Contains(GameStyle.Ameritrash) ? "bg-[var(--brand-primary)] text-white border-transparent shadow-sm" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                                    @onclick="() => ToggleStyle(GameStyle.Ameritrash)"
                                    aria-label="Juegos temáticos de aventura y conflicto"
                                    aria-pressed="@(_selectedStyles.Contains(GameStyle.Ameritrash) ? "true" : "false")">
                                <Icon Name="dices" Size="12" />
                                <span>Temático</span>
                            </button>
                            <button type="button"
                                    class="px-2.5 py-1.5 rounded-lg border text-xs font-semibold transition-all flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedStyles.Contains(GameStyle.PartyGame) ? "bg-[var(--brand-primary)] text-white border-transparent shadow-sm" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                                    @onclick="() => ToggleStyle(GameStyle.PartyGame)"
                                    aria-label="Party games sociales y divertidos"
                                    aria-pressed="@(_selectedStyles.Contains(GameStyle.PartyGame) ? "true" : "false")">
                                <Icon Name="party-popper" Size="12" />
                                <span>Party</span>
                            </button>
                            <button type="button"
                                    class="px-2.5 py-1.5 rounded-lg border text-xs font-semibold transition-all flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedStyles.Contains(GameStyle.FillerAbstract) ? "bg-[var(--brand-primary)] text-white border-transparent shadow-sm" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                                    @onclick="() => ToggleStyle(GameStyle.FillerAbstract)"
                                    aria-label="Fillers y abstractos"
                                    aria-pressed="@(_selectedStyles.Contains(GameStyle.FillerAbstract) ? "true" : "false")">
                                <Icon Name="puzzle" Size="12" />
                                <span>Filler</span>
                            </button>
                            <button type="button"
                                    class="px-2.5 py-1.5 rounded-lg border text-xs font-semibold transition-all flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedStyles.Contains(GameStyle.NarrativeCampaign) ? "bg-[var(--brand-primary)] text-white border-transparent shadow-sm" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                                    @onclick="() => ToggleStyle(GameStyle.NarrativeCampaign)"
                                    aria-label="Narrativos y campaña"
                                    aria-pressed="@(_selectedStyles.Contains(GameStyle.NarrativeCampaign) ? "true" : "false")">
                                <Icon Name="book-open" Size="12" />
                                <span>Narrativo</span>
                            </button>
                        </div>
                    </div>

                    @* 5. Espacio en mesa (TableFootprint) - Multiselección *@
                    <div class="flex flex-col gap-1.5" role="group" aria-label="Filtrar por tamaño en mesa">
                        <span class="text-[0.72rem] font-bold uppercase tracking-wider text-[var(--text-muted)] flex items-center gap-1.5">
                            <Icon Name="armchair" Size="13" />
                            <span>Tamaño en mesa</span>
                        </span>
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <button type="button"
                                    class="px-2.5 py-1.5 rounded-lg border text-xs font-semibold transition-all flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedFootprints.Count == 0 ? "bg-[var(--brand-primary)] text-white border-transparent" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                                    @onclick="() => SetFootprint(null)"
                                    aria-label="Cualquier tamaño en mesa"
                                    aria-pressed="@(_selectedFootprints.Count == 0 ? "true" : "false")">
                                Cualquiera
                            </button>
                            <button type="button"
                                    class="px-2.5 py-1.5 rounded-lg border text-xs font-semibold transition-all flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedFootprints.Contains(TableFootprint.SmallTable) || _selectedFootprint == TableFootprint.SmallTable ? "bg-[var(--brand-primary)] text-white border-transparent shadow-sm" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                                    @onclick="() => ToggleFootprint(TableFootprint.SmallTable)"
                                    aria-label="Mesa pequeña o cafetería"
                                    aria-pressed="@(_selectedFootprints.Contains(TableFootprint.SmallTable) || _selectedFootprint == TableFootprint.SmallTable ? "true" : "false")"
                                    title="Despliegue compacto sin tableros masivos">
                                <Icon Name="armchair" Size="12" />
                                <span>Mesa pequeña</span>
                            </button>
                            <button type="button"
                                    class="px-2.5 py-1.5 rounded-lg border text-xs font-semibold transition-all flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedFootprints.Contains(TableFootprint.StandardTable) || _selectedFootprint == TableFootprint.StandardTable ? "bg-[var(--brand-primary)] text-white border-transparent shadow-sm" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                                    @onclick="() => ToggleFootprint(TableFootprint.StandardTable)"
                                    aria-label="Mesa de comedor estándar"
                                    aria-pressed="@(_selectedFootprints.Contains(TableFootprint.StandardTable) || _selectedFootprint == TableFootprint.StandardTable ? "true" : "false")"
                                    title="Espacio suficiente para tablero central y personales">
                                <Icon Name="utensils" Size="12" />
                                <span>Estándar</span>
                            </button>
                            <button type="button"
                                    class="px-2.5 py-1.5 rounded-lg border text-xs font-semibold transition-all flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedFootprints.Contains(TableFootprint.TableMonster) || _selectedFootprint == TableFootprint.TableMonster ? "bg-[var(--brand-primary)] text-white border-transparent shadow-sm" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                                    @onclick="() => ToggleFootprint(TableFootprint.TableMonster)"
                                    aria-label="Monstruo de mesa o despliegue masivo"
                                    aria-pressed="@(_selectedFootprints.Contains(TableFootprint.TableMonster) || _selectedFootprint == TableFootprint.TableMonster ? "true" : "false")"
                                    title="Requiere mesa amplia para reservas, mercados y áreas masivas">
                                <Icon Name="castle" Size="12" />
                                <span>Mesa grande</span>
                            </button>
                        </div>
                    </div>

                    @* 6. Confrontación (Confrontations) - Multiselección *@
                    <div class="flex flex-col gap-1.5" role="group" aria-label="Filtrar por confrontación">
                        <span class="text-[0.72rem] font-bold uppercase tracking-wider text-[var(--text-muted)] flex items-center gap-1.5">
                            <Icon Name="swords" Size="13" />
                            <span>Confrontación</span>
                        </span>
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <button type="button"
                                    class="px-2.5 py-1.5 rounded-lg border text-xs font-semibold transition-all flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedConfrontations.Contains(ConfrontationType.Competitive) ? "bg-[var(--brand-primary)] text-white border-transparent shadow-sm" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                                    @onclick="() => ToggleConfrontation(ConfrontationType.Competitive)"
                                    aria-label="Juegos competitivos"
                                    aria-pressed="@(_selectedConfrontations.Contains(ConfrontationType.Competitive) ? "true" : "false")">
                                <Icon Name="trophy" Size="12" />
                                <span>Competitivo</span>
                            </button>
                            <button type="button"
                                    class="px-2.5 py-1.5 rounded-lg border text-xs font-semibold transition-all flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedConfrontations.Contains(ConfrontationType.Cooperative) ? "bg-[var(--brand-primary)] text-white border-transparent shadow-sm" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                                    @onclick="() => ToggleConfrontation(ConfrontationType.Cooperative)"
                                    aria-label="Juegos cooperativos"
                                    aria-pressed="@(_selectedConfrontations.Contains(ConfrontationType.Cooperative) ? "true" : "false")">
                                <Icon Name="users" Size="12" />
                                <span>Cooperativo</span>
                            </button>
                            <button type="button"
                                    class="px-2.5 py-1.5 rounded-lg border text-xs font-semibold transition-all flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedConfrontations.Contains(ConfrontationType.HiddenRolesOrTeams) ? "bg-[var(--brand-primary)] text-white border-transparent shadow-sm" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                                    @onclick="() => ToggleConfrontation(ConfrontationType.HiddenRolesOrTeams)"
                                    aria-label="Roles ocultos o equipos"
                                    aria-pressed="@(_selectedConfrontations.Contains(ConfrontationType.HiddenRolesOrTeams) ? "true" : "false")">
                                <Icon Name="eye-off" Size="12" />
                                <span>Roles ocultos</span>
                            </button>
                            <button type="button"
                                    class="px-2.5 py-1.5 rounded-lg border text-xs font-semibold transition-all flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedConfrontations.Contains(ConfrontationType.SemiCooperative) ? "bg-[var(--brand-primary)] text-white border-transparent shadow-sm" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                                    @onclick="() => ToggleConfrontation(ConfrontationType.SemiCooperative)"
                                    aria-label="Semicooperativo"
                                    aria-pressed="@(_selectedConfrontations.Contains(ConfrontationType.SemiCooperative) ? "true" : "false")">
                                <Icon Name="shield" Size="12" />
                                <span>Semicooperativo</span>
                            </button>
                        </div>
                    </div>

                    @* 7. Duración máxima (MaxDurationMinutes) *@
                    <div class="flex flex-col gap-1.5" role="group" aria-label="Filtrar por duración máxima">
                        <span class="text-[0.72rem] font-bold uppercase tracking-wider text-[var(--text-muted)] flex items-center gap-1.5">
                            <Icon Name="timer" Size="13" />
                            <span>Duración máxima</span>
                        </span>
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <button type="button"
                                    class="px-2.5 py-1.5 rounded-lg border text-xs font-semibold transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedMaxDurations.Count == 0 ? "bg-[var(--brand-primary)] text-white border-transparent" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                                    @onclick="() => SetMaxDuration(null)"
                                    aria-label="Cualquier duración de partida"
                                    aria-pressed="@(_selectedMaxDurations.Count == 0 ? "true" : "false")">
