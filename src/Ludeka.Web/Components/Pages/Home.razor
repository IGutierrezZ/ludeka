@page "/catalogo"
@rendermode InteractiveServer
@implements IDisposable
@using Ludeka.Core.Enums
@using Microsoft.AspNetCore.Components.Routing
@inject ICatalogService CatalogService
@inject NavigationManager Navigation

<PageTitle>Catálogo de Juegos de Mesa — Ludeka</PageTitle>

<div class="container-ludeka py-6">
    @* Cabecera editorial compartida (INC-36, DD-06) y buscador principal en bloque propio *@
    <PageHeaderEditorial Badge="Catálogo Colaborativo" BadgeIcon="dices"
                         Subtitle="Catálogo colaborativo, valoraciones comunitarias y escalabilidad en mesa.">
        <Title>Descubre tu próxima partida<span class="text-[var(--brand-primary)]">.</span></Title>
    </PageHeaderEditorial>

    <div class="max-w-xl mt-6 mb-8">
        <CatalogSearchBar Value="@_searchTerm" ValueChanged="@OnSearchChanged" />
    </div>

    @* Filtros prácticos de situación real y tipo de juego *@
    <div class="flex items-center gap-2 overflow-x-auto pb-3 mb-6 scrollbar-none" role="group" aria-label="Filtros del catálogo">
        <button type="button" class="filter-btn @(_activePreset == Preset.Todos ? "active" : "")" @onclick="() => SetPreset(Preset.Todos)">
            Todos (@_totalCount)
        </button>
        <button type="button" class="filter-btn @(_activePreset == Preset.JuegosBase ? "active" : "")" @onclick="() => SetPreset(Preset.JuegosBase)">
            <Icon Name="dices" Size="12" /> Juegos Base
        </button>
        <button type="button" class="filter-btn @(_activePreset == Preset.Expansiones ? "active" : "")" @onclick="() => SetPreset(Preset.Expansiones)">
            <Icon Name="puzzle" Size="12" /> Expansiones
        </button>
        <button type="button" class="filter-btn @(_activePreset == Preset.EspecialParejas ? "active" : "")" @onclick="() => SetPreset(Preset.EspecialParejas)">
            <Icon Name="swords" Size="12" /> Especial Parejas (2J)
        </button>
        <button type="button" class="filter-btn @(_activePreset == Preset.MesaFamiliar ? "active" : "")" @onclick="() => SetPreset(Preset.MesaFamiliar)">
            <Icon Name="users" Size="12" /> Mesa Familiar
        </button>
        <button type="button" class="filter-btn @(_activePreset == Preset.SoloTop ? "active" : "")" @onclick="() => SetPreset(Preset.SoloTop)">
            <Icon Name="user" Size="12" /> Modo Solitario
        </button>
        <button type="button" class="filter-btn @(_activePreset == Preset.PartidasRapidas ? "active" : "")" @onclick="() => SetPreset(Preset.PartidasRapidas)">
            <Icon Name="timer" Size="12" /> &le; 45 min
        </button>
    </div>

    @* Barra de refinamiento facetado: Espacio en mesa, Comensales y Duración (INC-59) *@
    <div class="mb-6 p-4 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-3.5 text-xs">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[var(--border-subtle)] pb-2.5">
            <span class="font-extrabold text-sm text-[var(--text-primary)] flex items-center gap-2">
                <Icon Name="sparkles" Size="14" />
                <span>Refinar por mesa y partida</span>
            </span>

            @if (HasActiveRefinements)
            {
                <button type="button"
                        @onclick="ResetFilters"
                        class="text-xs font-semibold text-[var(--brand-primary)] hover:underline flex items-center gap-1 self-start sm:self-auto focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] rounded px-1.5 py-0.5"
                        aria-label="Restablecer todos los filtros">
                    <Icon Name="x" Size="13" />
                    <span>Limpiar filtros</span>
                </button>
            }
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            @* 1. Espacio en mesa (TableFootprint) *@
            <div class="flex flex-col gap-1.5" role="group" aria-label="Filtrar por tamaño en mesa">
                <span class="text-[0.72rem] font-bold uppercase tracking-wider text-[var(--text-muted)] flex items-center gap-1.5">
                    <Icon Name="armchair" Size="13" />
                    <span>Tamaño en mesa</span>
                </span>
                <div class="flex items-center gap-1.5 flex-wrap">
                    <button type="button"
                            class="px-2.5 py-1.5 rounded-lg border text-xs font-semibold transition-all flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedFootprint == null ? "bg-[var(--brand-primary)] text-white border-transparent" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                            @onclick="() => SetFootprint(null)"
                            aria-label="Cualquier tamaño en mesa"
                            aria-pressed="@(_selectedFootprint == null ? "true" : "false")">
                        Cualquiera
                    </button>
                    <button type="button"
                            class="px-2.5 py-1.5 rounded-lg border text-xs font-semibold transition-all flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedFootprint == TableFootprint.SmallTable ? "bg-[var(--brand-primary)] text-white border-transparent" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                            @onclick="() => SetFootprint(TableFootprint.SmallTable)"
                            aria-label="Mesa pequeña o cafetería"
                            aria-pressed="@(_selectedFootprint == TableFootprint.SmallTable ? "true" : "false")"
                            title="Despliegue compacto sin tableros masivos">
                        <Icon Name="armchair" Size="12" />
                        <span>Mesa pequeña</span>
                    </button>
                    <button type="button"
                            class="px-2.5 py-1.5 rounded-lg border text-xs font-semibold transition-all flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedFootprint == TableFootprint.StandardTable ? "bg-[var(--brand-primary)] text-white border-transparent" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                            @onclick="() => SetFootprint(TableFootprint.StandardTable)"
                            aria-label="Mesa de comedor estándar"
                            aria-pressed="@(_selectedFootprint == TableFootprint.StandardTable ? "true" : "false")"
                            title="Espacio suficiente para tablero central y personales">
                        <Icon Name="utensils" Size="12" />
                        <span>Estándar</span>
                    </button>
                    <button type="button"
                            class="px-2.5 py-1.5 rounded-lg border text-xs font-semibold transition-all flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedFootprint == TableFootprint.TableMonster ? "bg-[var(--brand-primary)] text-white border-transparent" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                            @onclick="() => SetFootprint(TableFootprint.TableMonster)"
                            aria-label="Monstruo de mesa o despliegue masivo"
                            aria-pressed="@(_selectedFootprint == TableFootprint.TableMonster ? "true" : "false")"
                            title="Requiere mesa amplia para reservas, mercados y áreas masivas">
                        <Icon Name="castle" Size="12" />
                        <span>Mesa grande</span>
                    </button>
                </div>
            </div>

            @* 2. Número de comensales (PlayerCount) *@
            <div class="flex flex-col gap-1.5" role="group" aria-label="Filtrar por número de jugadores">
                <span class="text-[0.72rem] font-bold uppercase tracking-wider text-[var(--text-muted)] flex items-center gap-1.5">
                    <Icon Name="users" Size="13" />
                    <span>Jugadores en mesa</span>
                </span>
                <div class="flex items-center gap-1 flex-wrap">
                    <button type="button"
                            class="px-2 py-1.5 rounded-lg border text-xs font-semibold transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedPlayerCount == null ? "bg-[var(--brand-primary)] text-white border-transparent" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                            @onclick="() => SetPlayerCount(null)"
                            aria-label="Cualquier número de jugadores"
                            aria-pressed="@(_selectedPlayerCount == null ? "true" : "false")">
                        Todos
                    </button>
                    @foreach (var count in new[] { 1, 2, 3, 4, 5, 6, 7 })
                    {
                        var c = count;
                        var label = c >= 7 ? "7+" : c.ToString();
                        <button type="button"
                                class="w-8 py-1.5 rounded-lg border text-xs font-semibold text-center transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedPlayerCount == c ? "bg-[var(--brand-primary)] text-white border-transparent" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                                @onclick="() => SetPlayerCount(c)"
                                aria-label="@(c >= 7 ? "7 o más jugadores" : $"{c} jugadores")"
                                aria-pressed="@(_selectedPlayerCount == c ? "true" : "false")">
                            @label
                        </button>
                    }
                </div>
            </div>

            @* 3. Duración máxima (MaxDurationMinutes) *@
            <div class="flex flex-col gap-1.5" role="group" aria-label="Filtrar por duración máxima">
                <span class="text-[0.72rem] font-bold uppercase tracking-wider text-[var(--text-muted)] flex items-center gap-1.5">
                    <Icon Name="timer" Size="13" />
                    <span>Duración máxima</span>
                </span>
                <div class="flex items-center gap-1.5 flex-wrap">
                    <button type="button"
                            class="px-2.5 py-1.5 rounded-lg border text-xs font-semibold transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedMaxDuration == null ? "bg-[var(--brand-primary)] text-white border-transparent" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                            @onclick="() => SetMaxDuration(null)"
                            aria-label="Cualquier duración de partida"
                            aria-pressed="@(_selectedMaxDuration == null ? "true" : "false")">
                        Cualquiera
                    </button>
                    @foreach (var dur in new[] { 30, 45, 60, 90, 120 })
                    {
                        var d = dur;
                        <button type="button"
                                class="px-2 py-1.5 rounded-lg border text-xs font-semibold transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_selectedMaxDuration == d ? "bg-[var(--brand-primary)] text-white border-transparent" : "bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                                @onclick="() => SetMaxDuration(d)"
                                aria-label="Hasta @d minutos"
                                aria-pressed="@(_selectedMaxDuration == d ? "true" : "false")">
                            &le; @(d)'
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    @* Barra de estado de resultados y selector conmutable de modo de vista *@
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6 pb-3 border-b border-[var(--border-subtle)] text-xs">
        <div class="text-[var(--text-muted)] flex items-center gap-2">
            @if (_isLoading)
            {
                <span class="flex items-center gap-1.5 font-medium">
                    <span class="inline-block animate-spin"><Icon Name="dices" Size="14" /></span>
                    <span>Buscando en el catálogo...</span>
                </span>
            }
            else if (_totalCount > 0)
            {
                var startItem = ((_currentPage - 1) * _pageSize) + 1;
                var endItem = Math.Min(_currentPage * _pageSize, _totalCount);
                <span>
                    Mostrando <strong class="text-[var(--text-primary)]">@startItem–@endItem</strong> de <strong class="text-[var(--text-primary)]">@_totalCount</strong> títulos
                </span>
            }
            else
            {
                <span>0 títulos encontrados</span>
            }
        </div>

        @* Selector de vista: Cuadrícula ↔ Lista *@
        <div class="flex items-center gap-1.5 self-end sm:self-auto" role="group" aria-label="Modo de visualización">
            <span class="text-[var(--text-muted)] mr-1 hidden sm:inline">Vista:</span>
            <button type="button"
                    class="px-2.5 py-1.5 rounded-xl border text-xs font-semibold transition-colors flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_viewMode == "grid" ? "bg-[var(--brand-primary)] text-white border-transparent shadow-sm" : "bg-[var(--bg-card)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                    @onclick='() => SetViewMode("grid")'
                    aria-label="Vista en cuadrícula"
                    aria-pressed="@(_viewMode == "grid" ? "true" : "false")">
                <Icon Name="layout-grid" Size="13" />
                <span class="hidden sm:inline">Cuadrícula</span>
            </button>
            <button type="button"
                    class="px-2.5 py-1.5 rounded-xl border text-xs font-semibold transition-colors flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_viewMode == "list" ? "bg-[var(--brand-primary)] text-white border-transparent shadow-sm" : "bg-[var(--bg-card)] text-[var(--text-secondary)] border-[var(--border-subtle)] hover:text-[var(--text-primary)]")"
                    @onclick='() => SetViewMode("list")'
                    aria-label="Vista en lista"
                    aria-pressed="@(_viewMode == "list" ? "true" : "false")">
                <Icon Name="list" Size="13" />
                <span class="hidden sm:inline">Lista</span>
            </button>
        </div>
    </div>

    @* Listado de juegos: según el modo de vista *@
    @if (_isLoading)
    {
        <div class="py-16 text-center text-[var(--text-secondary)]">
            <div class="inline-block animate-spin mb-2"><Icon Name="dices" Size="30" /></div>
            <p class="text-sm font-medium">Cargando catálogo lúdico...</p>
        </div>
    }
    else if (_games == null || _games.Count == 0)
    {
        <div class="py-16 text-center max-w-md mx-auto p-6 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)]">
            <span class="inline-block mb-3"><Icon Name="puzzle" Size="40" /></span>
            <h3 class="text-lg font-bold text-[var(--text-primary)] mb-1">Sin resultados</h3>
            <p class="text-xs text-[var(--text-muted)] mb-4">
                No hemos encontrado ningún juego que coincida con tu búsqueda. Prueba a limpiar los filtros.
            </p>
            <button type="button" class="filter-btn active text-xs" @onclick="ResetFilters">
                Restablecer filtros
            </button>
        </div>
    }
    else if (_viewMode == "list")
    {
        <div class="space-y-3">
            @foreach (var game in _games)
            {
                <GameListItem Game="@game" />
            }
        </div>
    }
    else
    {
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4 sm:gap-6">
            @foreach (var game in _games)
            {
                <GameCard Game="@game" />
            }
        </div>
    }

    @* Controles de paginación inferior *@
    @if (!_isLoading && _totalPages > 1)
    {
        <div class="flex items-center justify-between pt-8 mt-6 border-t border-[var(--border-subtle)] text-xs">
            <button type="button"
                    @onclick="PreviousPage"
                    disabled="@(_currentPage <= 1)"
                    class="px-4 py-2.5 rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] disabled:opacity-30 disabled:cursor-not-allowed transition-all font-semibold flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)]"
                    aria-label="Página anterior">
                <Icon Name="chevron-left" Size="14" />
                <span>Anterior</span>
            </button>

            <span class="text-xs font-semibold text-[var(--text-muted)]">
                Página <strong class="text-[var(--text-primary)]">@_currentPage</strong> de <strong class="text-[var(--text-primary)]">@_totalPages</strong>
            </span>

            <button type="button"
                    @onclick="NextPage"
                    disabled="@(_currentPage >= _totalPages)"
                    class="px-4 py-2.5 rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] disabled:opacity-30 disabled:cursor-not-allowed transition-all font-semibold flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)]"
                    aria-label="Página siguiente">
                <span>Siguiente</span>
                <Icon Name="chevron-right" Size="14" />
            </button>
        </div>
    }
</div>

@code {
    private enum Preset { Todos, JuegosBase, Expansiones, EspecialParejas, MesaFamiliar, SoloTop, PartidasRapidas }

    private Preset _activePreset = Preset.Todos;
    private TableFootprint? _selectedFootprint = null;
    private int? _selectedPlayerCount = null;
    private int? _selectedMaxDuration = null;
    private string _searchTerm = string.Empty;
    private bool _isLoading = true;
    private int _totalCount = 0;
    private int _totalPages = 0;
    private int _currentPage = 1;
    private const int _pageSize = 24;
    private string _viewMode = "grid";
    private bool _isInternalNavigation = false;
    private IReadOnlyList<GameSummaryDto> _games = [];

    private bool HasActiveRefinements =>
        _selectedFootprint.HasValue ||
        _selectedPlayerCount.HasValue ||
        _selectedMaxDuration.HasValue ||
        _activePreset != Preset.Todos ||
        !string.IsNullOrWhiteSpace(_searchTerm);

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        ReadQueryParameters();
        await LoadCatalogAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_isInternalNavigation) return;

        _ = InvokeAsync(async () =>
        {
            ReadQueryParameters();
            await LoadCatalogAsync();
        });
    }

    private void ReadQueryParameters()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("q", out var qVal) && !string.IsNullOrWhiteSpace(qVal))
        {
            _searchTerm = qVal.ToString();
        }
        else
        {
            _searchTerm = string.Empty;
        }

        if (query.TryGetValue("page", out var pVal) && int.TryParse(pVal, out var pageNum) && pageNum >= 1)
        {
            _currentPage = pageNum;
        }
        else
        {
            _currentPage = 1;
        }

        if (query.TryGetValue("view", out var vVal) && string.Equals(vVal.ToString(), "list", StringComparison.OrdinalIgnoreCase))
        {
            _viewMode = "list";
        }
        else
        {
            _viewMode = "grid";
        }

        if (query.ContainsKey("parejas"))
        {
            _activePreset = Preset.EspecialParejas;
        }
        else if (query.ContainsKey("familiar"))
        {
            _activePreset = Preset.MesaFamiliar;
        }
        else if (query.ContainsKey("expansiones"))
        {
            _activePreset = Preset.Expansiones;
        }
        else if (query.ContainsKey("solo"))
        {
            _activePreset = Preset.SoloTop;
        }
        else if (query.ContainsKey("rapidas"))
        {
            _activePreset = Preset.PartidasRapidas;
        }
        else if (query.TryGetValue("tipo", out var tipoVal) && string.Equals(tipoVal.ToString(), "base", StringComparison.OrdinalIgnoreCase))
        {
            _activePreset = Preset.JuegosBase;
        }
        else if (query.TryGetValue("preset", out var presetVal))
        {
            _activePreset = presetVal.ToString() switch
            {
                "parejas" => Preset.EspecialParejas,
                "familiar" => Preset.MesaFamiliar,
                "expansiones" => Preset.Expansiones,
                "base" => Preset.JuegosBase,
                "solo" => Preset.SoloTop,
                "rapidas" => Preset.PartidasRapidas,
                _ => Preset.Todos
            };
        }
        else
        {
            _activePreset = Preset.Todos;
        }

        if (query.TryGetValue("mesa", out var mesaVal))
        {
            _selectedFootprint = mesaVal.ToString().ToLowerInvariant() switch
            {
                "pequena" or "small" => TableFootprint.SmallTable,
                "estandar" or "standard" => TableFootprint.StandardTable,
                "monstruo" or "monster" or "grande" => TableFootprint.TableMonster,
                _ => null
            };
        }
        else
        {
            _selectedFootprint = null;
        }

        if (query.TryGetValue("jugadores", out var jVal) && int.TryParse(jVal, out var jNum) && jNum >= 1)
        {
            _selectedPlayerCount = jNum;
        }
        else if (query.TryGetValue("players", out var pCountVal) && int.TryParse(pCountVal, out var pCountNum) && pCountNum >= 1)
        {
            _selectedPlayerCount = pCountNum;
        }
        else
        {
            _selectedPlayerCount = null;
        }

        if (query.TryGetValue("duracion", out var dVal) && int.TryParse(dVal, out var dNum) && dNum > 0)
        {
            _selectedMaxDuration = dNum;
        }
        else if (query.TryGetValue("duration", out var durVal2) && int.TryParse(durVal2, out var durNum2) && durNum2 > 0)
        {
            _selectedMaxDuration = durNum2;
        }
        else
        {
            _selectedMaxDuration = null;
        }
    }

    private void SyncUrl()
    {
        var queryParams = new Dictionary<string, string?>();

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            queryParams["q"] = _searchTerm;
        }

        if (_currentPage > 1)
        {
            queryParams["page"] = _currentPage.ToString();
        }

        if (_viewMode == "list")
        {
            queryParams["view"] = "list";
        }

        switch (_activePreset)
        {
            case Preset.EspecialParejas:
                queryParams["parejas"] = "1";
                break;
            case Preset.MesaFamiliar:
                queryParams["familiar"] = "1";
                break;
            case Preset.Expansiones:
                queryParams["expansiones"] = "1";
                break;
            case Preset.JuegosBase:
                queryParams["tipo"] = "base";
                break;
            case Preset.SoloTop:
                queryParams["solo"] = "1";
                break;
            case Preset.PartidasRapidas:
                queryParams["rapidas"] = "1";
                break;
        }

        if (_selectedFootprint.HasValue)
        {
            queryParams["mesa"] = _selectedFootprint.Value switch
            {
                TableFootprint.SmallTable => "pequena",
                TableFootprint.TableMonster => "monstruo",
                _ => "estandar"
            };
        }

        if (_selectedPlayerCount.HasValue)
        {
            queryParams["jugadores"] = _selectedPlayerCount.Value.ToString();
        }

        if (_selectedMaxDuration.HasValue)
        {
            queryParams["duracion"] = _selectedMaxDuration.Value.ToString();
        }

        var targetUrl = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/catalogo", queryParams);

        try
        {
            _isInternalNavigation = true;
            Navigation.NavigateTo(targetUrl, replace: true);
        }
        finally
        {
            _isInternalNavigation = false;
        }
    }

    private async Task OnSearchChanged(string term)
    {
        _searchTerm = term;
        _currentPage = 1;
        SyncUrl();
        await LoadCatalogAsync();
    }

    private async Task SetPreset(Preset preset)
    {
        _activePreset = preset;
        _currentPage = 1;
        SyncUrl();
        await LoadCatalogAsync();
    }

    private void SetViewMode(string mode)
    {
        var normalized = mode == "list" ? "list" : "grid";
        if (_viewMode == normalized) return;

        _viewMode = normalized;
        SyncUrl();
        StateHasChanged();
    }

    private async Task PreviousPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            SyncUrl();
            await LoadCatalogAsync();
        }
    }

    private async Task NextPage()
    {
        if (_currentPage < _totalPages)
        {
            _currentPage++;
            SyncUrl();
            await LoadCatalogAsync();
        }
    }

    private async Task SetFootprint(TableFootprint? footprint)
    {
        if (_selectedFootprint == footprint) return;
        _selectedFootprint = footprint;
        _currentPage = 1;
        SyncUrl();
        await LoadCatalogAsync();
    }

    private async Task SetPlayerCount(int? count)
    {
        if (_selectedPlayerCount == count) return;
        _selectedPlayerCount = count;
        _currentPage = 1;
        SyncUrl();
        await LoadCatalogAsync();
    }

    private async Task SetMaxDuration(int? minutes)
    {
        if (_selectedMaxDuration == minutes) return;
        _selectedMaxDuration = minutes;
        _currentPage = 1;
        SyncUrl();
        await LoadCatalogAsync();
    }

    private async Task ResetFilters()
    {
        _activePreset = Preset.Todos;
        _selectedFootprint = null;
        _selectedPlayerCount = null;
        _selectedMaxDuration = null;
        _searchTerm = string.Empty;
        _currentPage = 1;
        SyncUrl();
        await LoadCatalogAsync();
    }

    private async Task LoadCatalogAsync()
    {
        _isLoading = true;
        StateHasChanged();

        GameType? typeFilter = _activePreset switch
        {
            Preset.JuegosBase => GameType.BaseGame,
            Preset.Expansiones => GameType.Expansion,
            _ => null
        };

        var criteria = new GameFilterCriteria(
            SearchTerm: _searchTerm,
            PlayerCount: _selectedPlayerCount,
            Footprint: _selectedFootprint,
            MaxDurationMinutes: _selectedMaxDuration ?? (_activePreset == Preset.PartidasRapidas ? 45 : null),
            EspecialParejas: _activePreset == Preset.EspecialParejas,
            MesaFamiliar: _activePreset == Preset.MesaFamiliar,
            SoloTop: _activePreset == Preset.SoloTop,
            TypeFilter: typeFilter
        );

        var result = await CatalogService.GetCatalogAsync(criteria, page: _currentPage, pageSize: _pageSize);
        _games = result.Games;
        _totalCount = result.TotalCount;
        _totalPages = result.TotalPages;

        if (_totalPages > 0 && _currentPage > _totalPages)
        {
            _currentPage = _totalPages;
            SyncUrl();
            result = await CatalogService.GetCatalogAsync(criteria, page: _currentPage, pageSize: _pageSize);
            _games = result.Games;
            _totalCount = result.TotalCount;
            _totalPages = result.TotalPages;
        }

        _isLoading = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
