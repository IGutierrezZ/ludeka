@page "/"
@rendermode InteractiveServer
@using Ludeka.Application.Contracts
@using Ludeka.Web.Components.Home
@using Ludeka.Web.Components.Shared
@inject IHomeDashboardService DashboardService

<PageTitle>Ludeka — Juegos, sorteos, eventos y opiniones de verdad</PageTitle>

<div class="container-ludeka py-6 space-y-10">
    @* 1. Hero editorial narrativo: la variante activa del fondo se fija aquí, en una línea *@
    <HeroEditorial Background="HeroBackgroundVariant.Ilustracion" />

    @if (_isLoading)
    {
        <div class="py-20 text-center text-[var(--text-secondary)]">
            <div class="inline-block animate-spin text-[var(--brand-primary)] mb-3">
                <Icon Name="dices" Size="40" />
            </div>
            <p class="text-sm font-semibold">Sintonizando el dashboard editorial de Ludeka...</p>
        </div>
    }
    else
    {
        @* 2. Carril 1: Conmutador Editorial: En tendencia (defecto) vs Mejor valorados *@
        <section class="space-y-4" aria-label="@(_showTrending ? "Juegos en tendencia hoy" : "Top 20 Juegos de Mesa")">
            <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-center flex-wrap gap-2.5 sm:gap-3">
                    <span class="text-[var(--brand-primary)]">
                        <Icon Name="@(_showTrending ? "flame" : "trophy")" Size="22" />
                    </span>
                    <h2 class="rail-title text-xl sm:text-2xl">
                        @(_showTrending ? "En tendencia hoy" : "Top 20 Juegos de Mesa")
                    </h2>

                    @* Conmutador editorial *@
                    <div class="inline-flex items-center bg-[var(--bg-surface)] p-0.5 sm:p-1 rounded-xl border border-[var(--border-subtle)] shadow-sm text-xs font-bold" role="tablist" aria-label="Seleccionar vista de juegos destacados">
                        <button type="button"
                                role="tab"
                                aria-selected="@(_showTrending ? "true" : "false")"
                                class="px-2.5 py-1 rounded-lg transition-all flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(_showTrending ? "bg-[var(--brand-primary)] text-white shadow-sm font-extrabold" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)]")"
                                @onclick="() => _showTrending = true">
                            <Icon Name="flame" Size="13" />
                            <span>En tendencia</span>
                        </button>
                        <button type="button"
                                role="tab"
                                aria-selected="@(!_showTrending ? "true" : "false")"
                                class="px-2.5 py-1 rounded-lg transition-all flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] @(!_showTrending ? "bg-[var(--brand-primary)] text-white shadow-sm font-extrabold" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)]")"
                                @onclick="() => _showTrending = false">
                            <Icon Name="trophy" Size="13" />
                            <span>Mejor valorados</span>
                        </button>
                    </div>
                </div>

                <a href="@(_showTrending ? "/tendencias" : "/catalogo")" class="text-xs sm:text-sm font-bold text-[var(--brand-primary)] hover:underline inline-flex items-center gap-1">
                    @(_showTrending ? "Ver todas las tendencias" : "Ver catálogo completo") <span aria-hidden="true">&rarr;</span>
                </a>
            </header>

            @{
                var displayedGames = (_showTrending && _dashboard.TrendingGames != null && _dashboard.TrendingGames.Count > 0)
                    ? _dashboard.TrendingGames
                    : _dashboard.TopGames;
            }

            <div class="flex gap-2.5 sm:gap-4 overflow-x-auto snap-x snap-mandatory scrollbar-none pb-4 pt-1 px-1" role="list">
                @foreach (var game in displayedGames)
                {
                    <HomeGameCard Game="game" />
                }
            </div>
        </section>

        @* 3. Carril 2: Sorteos Activos & Promocionados *@
        <section class="space-y-4" aria-label="Sorteos Activos y Destacados">
            <RailHeader IconName="gift"
                        Title="Sorteos en Marcha"
                        Count="_dashboard.Giveaways.Count"
                        CountLabel="activos"
                        Href="/sorteos"
                        LinkText="Ver todos los sorteos"
                        AriaLabel="Sorteos Activos y Destacados" />

            @if (_dashboard.Giveaways.Count == 0)
            {
                <div class="p-8 text-center rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] text-xs text-[var(--text-secondary)]">
                    No hay sorteos registrados en este momento. ¡Sé el primero en compartir uno en la comunidad!
                </div>
            }
            else
            {
                <div class="flex gap-4 overflow-x-auto snap-x snap-mandatory scrollbar-none pb-4 pt-1 px-1" role="list">
                    @foreach (var giveaway in _dashboard.Giveaways)
                    {
                        <HomeGiveawayCard Giveaway="giveaway" />
                    }
                </div>
            }
        </section>

        @* 4. Carril 3: Novedades del Sector & Lanzamientos *@
        <section class="space-y-4" aria-label="Novedades del Sector y Lanzamientos">
            <RailHeader IconName="rocket"
                        Title="Novedades en Tiendas"
                        Count="_dashboard.RecentReleases.Count"
                        CountLabel="títulos"
                        Href="/novedades"
                        LinkText="Ver todas las novedades"
                        AriaLabel="Novedades del Sector y Lanzamientos" />

            @if (_dashboard.RecentReleases.Count == 0)
            {
                <div class="p-8 text-center rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] text-xs text-[var(--text-secondary)]">
                    No hay novedades cargadas para esta semana.
                </div>
            }
            else
            {
                <div class="flex gap-4 overflow-x-auto snap-x snap-mandatory scrollbar-none pb-4 pt-1 px-1" role="list">
                    @foreach (var release in _dashboard.RecentReleases)
                    {
                        <HomeReleaseCard Release="release" />
                    }
                </div>
            }
        </section>

        @* 5. Carril 4: Próximos Eventos & Ferias Lúdicas *@
        <section class="space-y-4" aria-label="Próximos Eventos y Ferias Lúdicas">
            <RailHeader IconName="tent"
                        Title="Grandes Citas & Ferias del Sector"
                        Count="_dashboard.UpcomingEvents.Count"
                        CountLabel="eventos"
                        Href="/eventos"
                        LinkText="Ver todos los eventos"
                        AriaLabel="Próximos Eventos y Ferias Lúdicas" />

            <div class="flex gap-4 overflow-x-auto snap-x snap-mandatory scrollbar-none pb-4 pt-1 px-1" role="list">
                @foreach (var evt in _dashboard.UpcomingEvents)
                {
                    <HomeEventCard Event="evt" />
                }
            </div>
        </section>
    }
</div>

@code {
    private bool _isLoading = true;
    private bool _showTrending = true;
    private HomeDashboardDto _dashboard = new([], [], [], []);

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            _dashboard = await DashboardService.GetDashboardDataAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }
}
