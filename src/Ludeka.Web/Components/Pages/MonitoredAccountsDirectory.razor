@page "/admin/canales-monitorizados"
@rendermode InteractiveServer
@using Ludeka.Application.Contracts
@using Ludeka.Application.DTOs
@using Ludeka.Core.Enums
@inject IMonitoredAccountService AccountService
@inject ISocialCollectorService CollectorService
@inject ICurrentUserService CurrentUserService
@inject NavigationManager Navigation

<PageTitle>Directorio de Cuentas Monitorizadas — Ludeka</PageTitle>

<div class="container-ludeka py-8 space-y-8">
    @if (!CanModerate)
    {
        <div class="p-8 rounded-3xl bg-[var(--bg-card)] border border-rose-500/20 text-center space-y-4 max-w-lg mx-auto">
            <span class="p-3 rounded-2xl bg-rose-500/10 text-rose-400 inline-block">
                <Icon Name="shield" Size="36" />
            </span>
            <h2 class="text-xl font-black text-[var(--text-primary)]">Acceso Exclusivo de Moderación</h2>
            <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
                Esta sección está reservada al equipo fundador y moderadores de la comunidad lúdica.
            </p>
            <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-2xl bg-[var(--brand-primary)] text-white text-xs font-bold hover:opacity-90 transition-opacity">
                Volver al Inicio
            </a>
        </div>
    }
    else
    {
        @* Encabezado *@
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 border-b border-[var(--border-subtle)] pb-6">
            <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-500 dark:text-blue-400 text-xs font-bold mb-2">
                    <Icon Name="radio" Size="14" /> Fuentes &amp; Redes Sociales
                </div>
                <h1 class="text-3xl sm:text-4xl font-black text-[var(--text-primary)] tracking-tight">
                    Canales &amp; Cuentas Monitorizadas
                </h1>
                <p class="text-sm text-[var(--text-secondary)] mt-1 max-w-2xl">
                    Directorio de perfiles oficiales de Instagram, YouTube y webs de editoriales, divulgadores y tiendas para facilitar la captura exprés comunitaria.
                </p>
            </div>

            <div class="flex items-center gap-3 flex-wrap">
                <button type="button"
                        @onclick="OpenCreateAccountModal"
                        class="px-4 py-2.5 rounded-2xl bg-[var(--brand-primary)] hover:opacity-90 text-white font-bold text-xs transition-all flex items-center gap-2 shadow-sm">
                    <Icon Name="plus" Size="14" />
                    <span>Añadir Cuenta</span>
                </button>

                <button type="button"
                        @onclick="SyncFromDirectoryAsync"
                        disabled="@_isSyncing"
                        class="px-3.5 py-2.5 rounded-2xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] hover:border-[var(--brand-primary)] text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all flex items-center gap-2 shadow-sm disabled:opacity-50">
                    <Icon Name="refresh-cw" Size="14" Class="@(_isSyncing ? "animate-spin" : "")" />
                    <span>@(_isSyncing ? "Sincronizando..." : "Sincronizar Directorio")</span>
                </button>

                <button type="button"
                        @onclick="CollectAllChannelsAsync"
                        disabled="@(_isCollecting || _isSyncing)"
                        class="px-3.5 py-2.5 rounded-2xl bg-indigo-500/10 border border-indigo-500/30 hover:border-indigo-500 text-xs font-semibold text-indigo-500 dark:text-indigo-400 hover:text-indigo-600 transition-all flex items-center gap-2 shadow-sm disabled:opacity-50">
                    <Icon Name="rss" Size="14" Class="@(_isCollecting ? "animate-spin" : "")" />
                    <span>@(_isCollecting ? "Sondeando Canales..." : "Sondear Canales")</span>
                </button>

                <a href="/admin/ingesta-social"
                   class="px-3.5 py-2.5 rounded-2xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] hover:border-[var(--brand-primary)] text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all flex items-center gap-1.5 shadow-sm">
                    <Icon Name="inbox" Size="14" />
                    <span>Bandeja de Moderación</span>
                </a>
            </div>
        </div>

        @* Notificaciones de feedback *@
        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-xs font-semibold flex items-center justify-between animate-fade-in">
                <div class="flex items-center gap-2">
                    <Icon Name="check" Size="18" />
                    <span>@_statusMessage</span>
                </div>
                <button type="button" @onclick="() => _statusMessage = null" class="text-xs opacity-70 hover:opacity-100">&times;</button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-500 dark:text-rose-400 text-xs font-semibold flex items-center justify-between animate-fade-in">
                <div class="flex items-center gap-2">
                    <Icon Name="triangle-alert" Size="18" />
                    <span>@_errorMessage</span>
                </div>
                <button type="button" @onclick="() => _errorMessage = null" class="text-xs opacity-70 hover:opacity-100">&times;</button>
            </div>
        }

        @* Barra de Filtros *@
        <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-4 gap-3 bg-[var(--bg-card)] p-4 rounded-2xl border border-[var(--border-subtle)]">
            <div>
                <label class="block text-[0.7rem] font-bold text-[var(--text-muted)] mb-1">Buscar por nombre o handle</label>
                <input type="text"
                       @bind="_searchFilter"
                       @bind:event="oninput"
                       placeholder="Ej. Devir, Meeple, Zacatrus..."
                       class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
            </div>

            <div>
                <label class="block text-[0.7rem] font-bold text-[var(--text-muted)] mb-1">Plataforma</label>
                <select @bind="_platformFilter"
                        @bind:after="LoadAccountsAsync"
                        class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]">
                    <option value="">Todas las plataformas</option>
                    <option value="@SocialPlatform.Instagram">Instagram</option>
                    <option value="@SocialPlatform.YouTube">YouTube</option>
                    <option value="@SocialPlatform.Telegram">Telegram</option>
                    <option value="@SocialPlatform.RssFeed">Feed RSS / Blog</option>
                    <option value="@SocialPlatform.Twitter">Twitter / X</option>
                    <option value="@SocialPlatform.TikTok">TikTok</option>
                    <option value="@SocialPlatform.Website">Sitio Web</option>
                </select>
            </div>

            <div>
                <label class="block text-[0.7rem] font-bold text-[var(--text-muted)] mb-1">Tipo de Cuenta</label>
                <select @bind="_typeFilter"
                        @bind:after="LoadAccountsAsync"
                        class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]">
                    <option value="">Todos los tipos</option>
                    <option value="@MonitoredAccountType.Publisher">Editorial</option>
                    <option value="@MonitoredAccountType.Creator">Divulgador / Creador</option>
                    <option value="@MonitoredAccountType.Store">Tienda</option>
                    <option value="@MonitoredAccountType.Community">Comunidad / Asociación</option>
                </select>
            </div>

            <div class="flex items-end">
                <button type="button"
                        @onclick="ResetFilters"
                        class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface)] hover:bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors">
                    Limpiar Filtros
                </button>
            </div>
        </div>

        @* Listado de Cuentas *@
        @if (_isLoading)
        {
            <div class="py-20 text-center space-y-3">
                <span class="inline-block animate-spin text-[var(--brand-primary)]">
                    <Icon Name="refresh-cw" Size="32" />
                </span>
                <p class="text-sm font-medium text-[var(--text-muted)]">Cargando directorio de cuentas...</p>
            </div>
        }
        else if (FilteredAccounts.Count == 0)
        {
            <div class="p-12 rounded-3xl bg-[var(--bg-card)] border border-dashed border-[var(--border-subtle)] text-center space-y-4 max-w-lg mx-auto my-8">
                <span class="p-3 rounded-2xl bg-[var(--bg-surface-elevated)] text-[var(--text-muted)] inline-block">
                    <Icon Name="radio" Size="32" />
                </span>
                <h3 class="text-base font-bold text-[var(--text-primary)]">No hay cuentas registradas con este filtro</h3>
                <p class="text-xs text-[var(--text-muted)] leading-relaxed">
                    Puedes dar de alta una cuenta o pulsar "Sincronizar Directorio" para importar automáticamente las cuentas de Instagram y YouTube ya existentes en editoriales, creadores y tiendas.
                </p>
                <div class="flex items-center justify-center gap-3 pt-2">
                    <button type="button"
                            @onclick="SyncFromDirectoryAsync"
                            class="px-4 py-2 rounded-xl bg-[var(--brand-primary)] text-white text-xs font-bold hover:opacity-90 transition-opacity">
                        Sincronizar Directorio
                    </button>
                    <button type="button"
                            @onclick="OpenCreateAccountModal"
                            class="px-4 py-2 rounded-xl bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] text-xs font-bold hover:text-[var(--text-primary)] transition-colors">
                        Nueva Cuenta Manual
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var account in FilteredAccounts)
                {
                    <div class="p-5 rounded-3xl bg-[var(--bg-card)] border border-[var(--border-subtle)] shadow-sm hover:border-[var(--border-focus)] transition-all flex flex-col justify-between space-y-4">
                        <div class="space-y-3">
                            <div class="flex items-start justify-between gap-3">
                                <div class="flex items-center gap-2.5">
                                    <span class="p-2.5 rounded-2xl @GetPlatformBgClass(account.Platform) text-white shrink-0">
                                        <Icon Name="@GetPlatformIcon(account.Platform)" Size="18" />
                                    </span>
                                    <div>
                                        <h3 class="font-bold text-sm text-[var(--text-primary)] leading-tight">
                                            @account.Name
                                        </h3>
                                        <p class="text-xs text-[var(--text-muted)] mt-0.5">
                                            @account.HandleOrChannelId
                                        </p>
                                    </div>
                                </div>

                                <span class="px-2.5 py-1 rounded-full text-[0.65rem] font-black uppercase tracking-wider @GetTypeBadgeClass(account.AccountType)">
                                    @GetTypeLabel(account.AccountType)
                                </span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(account.Notes))
                            {
                                <p class="text-xs text-[var(--text-secondary)] italic bg-[var(--bg-surface)] p-2.5 rounded-xl border border-[var(--border-subtle)] line-clamp-2">
                                    @account.Notes
                                </p>
                            }

                            <div class="flex items-center justify-between text-[0.7rem] text-[var(--text-muted)] pt-1">
                                <span class="flex items-center gap-1">
                                    <span class="w-2 h-2 rounded-full @(account.IsEnabled ? "bg-emerald-500" : "bg-zinc-500")"></span>
                                    <span>@(account.IsEnabled ? "Activa" : "Pausada")</span>
                                </span>
                                <span>
                                    @(account.LastCheckedAt.HasValue ? $"Revisada: {account.LastCheckedAt.Value.ToString("dd/MM/yyyy")}" : "Sin revisiones")
                                </span>
                            </div>
                        </div>

                        @* Acciones de la Tarjeta *@
                        <div class="pt-3 border-t border-[var(--border-subtle)] flex items-center justify-between gap-2">
                            <div class="flex items-center gap-1.5">
                                <a href="@account.ProfileUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   title="Visitar perfil externo"
                                   class="p-2 rounded-xl bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface)] transition-colors flex items-center">
                                    <Icon Name="external-link" Size="14" />
                                </a>

                                <button type="button"
                                        @onclick="() => OpenEditAccountModal(account)"
                                        title="Editar cuenta"
                                        class="p-2 rounded-xl bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface)] transition-colors flex items-center">
                                    <Icon Name="edit" Size="14" />
                                </button>

                                <button type="button"
                                        @onclick="() => ToggleStatusAsync(account)"
                                        title="@(account.IsEnabled ? "Pausar monitorización" : "Activar monitorización")"
                                        class="p-2 rounded-xl bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface)] transition-colors flex items-center">
                                    <Icon Name="@(account.IsEnabled ? "pause" : "play")" Size="14" />
                                </button>

                                <button type="button"
                                        @onclick="() => CollectSingleAccountAsync(account.Id)"
                                        disabled="@(_collectingAccountId == account.Id || _isCollecting)"
                                        title="Sondear publicaciones recientes de este canal"
                                        class="p-2 rounded-xl bg-indigo-500/10 text-indigo-500 dark:text-indigo-400 hover:text-indigo-600 hover:bg-indigo-500/20 transition-colors flex items-center disabled:opacity-50">
                                    <Icon Name="rss" Size="14" Class="@(_collectingAccountId == account.Id ? "animate-spin" : "")" />
                                </button>
                            </div>

                            @* Botón de Alta Exprés prepoblada con este organizador *@
                            <button type="button"
                                    @onclick="() => LaunchExpressIngestForAccount(account)"
                                    class="px-3 py-1.5 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-500 dark:text-amber-400 text-xs font-bold transition-all flex items-center gap-1.5 border border-amber-500/30">
                                <Icon Name="zap" Size="13" />
                                <span>Publicación Exprés</span>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@* Modal de Alta Exprés con Organizador Prepoblado *@
<SocialExpressIngestModal IsOpen="_showExpressModal"
                          PrepopulatedOrganizer="@_prepopulatedOrganizer"
                          OnItemCreated="HandleExpressItemCreated"
                          OnClose="() => _showExpressModal = false" />

@* Modal de Crear / Editar Cuenta *@
@if (_showAccountModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm animate-fade-in"
         role="dialog"
         aria-modal="true">
        <div class="w-full max-w-lg rounded-3xl bg-[var(--bg-card)] border border-[var(--border-subtle)] shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)]">
                <h3 class="font-black text-base text-[var(--text-primary)]">
                    @(_accountToEdit == null ? "Nueva Cuenta Monitorizada" : $"Editar: {_modalName}")
                </h3>
                <button type="button" @onclick="() => _showAccountModal = false" class="p-1 rounded-full text-[var(--text-muted)] hover:text-[var(--text-primary)]">&times;</button>
            </div>

            <div class="p-6 space-y-4 overflow-y-auto">
                <div>
                    <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">Nombre de la Entidad o Canal *</label>
                    <input type="text"
                           @bind="_modalName"
                           placeholder="Ej. Devir Iberia, Zacatrus, Meeple Foundry..."
                           class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">Plataforma *</label>
                        <select @bind="_modalPlatform"
                                class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]">
                            <option value="@SocialPlatform.Instagram">Instagram</option>
                            <option value="@SocialPlatform.YouTube">YouTube</option>
                            <option value="@SocialPlatform.Telegram">Telegram</option>
                            <option value="@SocialPlatform.RssFeed">Feed RSS / Blog</option>
                            <option value="@SocialPlatform.Twitter">Twitter / X</option>
                            <option value="@SocialPlatform.TikTok">TikTok</option>
                            <option value="@SocialPlatform.Website">Sitio Web</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">Tipo de Cuenta *</label>
                        <select @bind="_modalType"
                                class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]">
                            <option value="@MonitoredAccountType.Publisher">Editorial</option>
                            <option value="@MonitoredAccountType.Creator">Divulgador / Creador</option>
                            <option value="@MonitoredAccountType.Store">Tienda</option>
                            <option value="@MonitoredAccountType.Community">Comunidad / Asociación</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">Handle o ID de Canal *</label>
                    <input type="text"
                           @bind="_modalHandle"
                           placeholder="Ej. @@deviriberia o UC12345..."
                           class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">URL Completa del Perfil *</label>
                    <input type="url"
                           @bind="_modalProfileUrl"
                           placeholder="https://instagram.com/deviriberia"
                           class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">Notas internas (opcional)</label>
                    <textarea @bind="_modalNotes"
                              rows="2"
                              placeholder="Ej. Publica sorteos semanales los viernes..."
                              class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]"></textarea>
                </div>

                <div class="flex items-center gap-2 pt-1">
                    <input type="checkbox"
                           id="modal-is-enabled"
                           @bind="_modalIsEnabled"
                           class="rounded text-[var(--brand-primary)] focus:ring-[var(--brand-primary)]" />
                    <label for="modal-is-enabled" class="text-xs font-medium text-[var(--text-secondary)]">
                        Monitorización activa
                    </label>
                </div>
            </div>

            <div class="px-6 py-4 border-t border-[var(--border-subtle)] flex items-center justify-between bg-[var(--bg-surface-elevated)]">
                @if (_accountToEdit != null)
                {
                    <button type="button"
                            @onclick="DeleteAccountAsync"
                            class="text-rose-500 hover:text-rose-400 text-xs font-bold transition-colors flex items-center gap-1">
                        <Icon Name="trash-2" Size="14" />
                        <span>Eliminar Cuenta</span>
                    </button>
                }
                else
                {
                    <div></div>
                }

                <div class="flex items-center gap-2">
                    <button type="button"
                            @onclick="() => _showAccountModal = false"
                            class="px-4 py-2 rounded-xl bg-[var(--bg-surface)] text-xs font-bold text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors">
                        Cancelar
                    </button>
                    <button type="button"
                            @onclick="SaveAccountAsync"
                            class="px-4 py-2 rounded-xl bg-[var(--brand-primary)] text-white text-xs font-bold hover:opacity-90 transition-opacity">
                        Guardar Cuenta
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private bool _isSyncing;
    private List<MonitoredAccountDto> _accounts = new();

    private string _searchFilter = string.Empty;
    private string _platformFilter = string.Empty;
    private string _typeFilter = string.Empty;

    private string? _statusMessage;
    private string? _errorMessage;

    // Sondeo automático
    private bool _isCollecting;
    private Guid? _collectingAccountId;

    // Alta Exprés modal
    private bool _showExpressModal;
    private string? _prepopulatedOrganizer;

    // Crear/Editar modal
    private bool _showAccountModal;
    private MonitoredAccountDto? _accountToEdit;
    private string _modalName = string.Empty;
    private SocialPlatform _modalPlatform = SocialPlatform.Instagram;
    private MonitoredAccountType _modalType = MonitoredAccountType.Publisher;
    private string _modalHandle = string.Empty;
    private string _modalProfileUrl = string.Empty;
    private string _modalNotes = string.Empty;
    private bool _modalIsEnabled = true;

    private bool CanModerate =>
        CurrentUserService.IsFoundingTeam ||
        CurrentUserService.IsInRole("Moderator") ||
        CurrentUserService.HasPermission(ModeratorPermission.CanApproveMedia);

    private IReadOnlyList<MonitoredAccountDto> FilteredAccounts
    {
        get
        {
            var query = _accounts.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchFilter))
            {
                var term = _searchFilter.Trim().ToLowerInvariant();
                query = query.Where(a =>
                    a.Name.ToLowerInvariant().Contains(term) ||
                    a.HandleOrChannelId.ToLowerInvariant().Contains(term));
            }

            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();
    }

    private async Task LoadAccountsAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            SocialPlatform? pFilter = Enum.TryParse<SocialPlatform>(_platformFilter, out var p) ? p : null;
            MonitoredAccountType? tFilter = Enum.TryParse<MonitoredAccountType>(_typeFilter, out var t) ? t : null;

            var results = await AccountService.GetAccountsAsync(
                platform: pFilter,
                type: tFilter);

            _accounts = results.ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error al cargar cuentas: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ResetFilters()
    {
        _searchFilter = string.Empty;
        _platformFilter = string.Empty;
        _typeFilter = string.Empty;
        _ = LoadAccountsAsync();
    }

    private async Task SyncFromDirectoryAsync()
    {
        if (_isSyncing) return;

        _isSyncing = true;
        _statusMessage = null;
        _errorMessage = null;

        try
        {
            var count = await AccountService.SyncFromDirectoryAsync();
            _statusMessage = count > 0
                ? $"¡Sincronización completada! Se añadieron {count} nuevas cuentas al directorio."
                : "Sincronización al día: todas las editoriales, creadores y tiendas ya estaban registradas.";

            await LoadAccountsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error al sincronizar: {ex.Message}";
        }
        finally
        {
            _isSyncing = false;
        }
    }

    private async Task ToggleStatusAsync(MonitoredAccountDto account)
    {
        try
        {
            await AccountService.ToggleAccountStatusAsync(account.Id, !account.IsEnabled);
            await LoadAccountsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error al cambiar estado: {ex.Message}";
        }
    }

    private void LaunchExpressIngestForAccount(MonitoredAccountDto account)
    {
        _prepopulatedOrganizer = account.Name;
        _showExpressModal = true;
    }

    private void OpenCreateAccountModal()
    {
        _accountToEdit = null;
        _modalName = string.Empty;
        _modalPlatform = SocialPlatform.Instagram;
        _modalType = MonitoredAccountType.Publisher;
        _modalHandle = string.Empty;
        _modalProfileUrl = string.Empty;
        _modalNotes = string.Empty;
        _modalIsEnabled = true;
        _showAccountModal = true;
    }

    private void OpenEditAccountModal(MonitoredAccountDto account)
    {
        _accountToEdit = account;
        _modalName = account.Name;
        _modalPlatform = account.Platform;
        _modalType = account.AccountType;
        _modalHandle = account.HandleOrChannelId;
        _modalProfileUrl = account.ProfileUrl;
        _modalNotes = account.Notes ?? string.Empty;
        _modalIsEnabled = account.IsEnabled;
        _showAccountModal = true;
    }

    private async Task SaveAccountAsync()
    {
        if (string.IsNullOrWhiteSpace(_modalName))
        {
            _errorMessage = "El nombre es obligatorio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_modalHandle))
        {
            _errorMessage = "El handle o identificador es obligatorio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_modalProfileUrl))
        {
            _errorMessage = "La URL del perfil es obligatoria.";
            return;
        }

        try
        {
            if (_accountToEdit == null)
            {
                var newDto = new MonitoredAccountDto(
                    Guid.NewGuid(),
                    _modalName,
                    _modalPlatform,
                    _modalHandle,
                    _modalType,
                    _modalProfileUrl,
                    _modalIsEnabled,
                    null,
                    _modalNotes,
                    DateTimeOffset.UtcNow);

                await AccountService.CreateAccountAsync(newDto);
                _statusMessage = "Cuenta añadida con éxito al directorio.";
            }
            else
            {
                var updatedDto = _accountToEdit with
                {
                    Name = _modalName,
                    Platform = _modalPlatform,
                    AccountType = _modalType,
                    HandleOrChannelId = _modalHandle,
                    ProfileUrl = _modalProfileUrl,
                    Notes = _modalNotes,
                    IsEnabled = _modalIsEnabled
                };

                await AccountService.UpdateAccountAsync(updatedDto);
                _statusMessage = "Cuenta actualizada correctamente.";
            }

            _showAccountModal = false;
            await LoadAccountsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error al guardar cuenta: {ex.Message}";
        }
    }

    private async Task DeleteAccountAsync()
    {
        if (_accountToEdit == null) return;

        try
        {
            await AccountService.DeleteAccountAsync(_accountToEdit.Id);
            _statusMessage = "Cuenta eliminada del directorio.";
            _showAccountModal = false;
            await LoadAccountsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error al eliminar: {ex.Message}";
        }
    }

    private async Task HandleExpressItemCreated(SocialInboxItemDto item)
    {
        _statusMessage = "¡Publicación capturada y agregada a la bandeja de moderación!";
        await Task.CompletedTask;
    }

    private async Task CollectAllChannelsAsync()
    {
        if (_isCollecting) return;
        _isCollecting = true;
        _statusMessage = null;
        _errorMessage = null;

        try
        {
            var result = await CollectorService.CollectAllAccountsAsync();
            _statusMessage = $"Sondeo completado: {result.AccountsScanned} canales examinados. {result.ItemsImported} publicaciones nuevas en moderación ({result.ItemsSkippedDuplicates} omitidas por duplicado).";
            await LoadAccountsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error durante el sondeo de canales: {ex.Message}";
        }
        finally
        {
            _isCollecting = false;
        }
    }

    private async Task CollectSingleAccountAsync(Guid accountId)
    {
        if (_collectingAccountId.HasValue || _isCollecting) return;
        _collectingAccountId = accountId;
        _statusMessage = null;
        _errorMessage = null;

        try
        {
            var result = await CollectorService.CollectAccountAsync(accountId);
            var summary = result.AccountSummaries.FirstOrDefault();
            if (summary?.HasError == true)
            {
                _errorMessage = $"Incidencia en canal '{summary.AccountName}': {summary.ErrorMessage}";
            }
            else
            {
                _statusMessage = $"Canal '{summary?.AccountName}' sondeado: {result.ItemsImported} publicaciones nuevas ({result.ItemsSkippedDuplicates} omitidas por duplicado).";
            }
            await LoadAccountsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error al sondear canal: {ex.Message}";
        }
        finally
        {
            _collectingAccountId = null;
        }
    }

