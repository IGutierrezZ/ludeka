@page "/novedades/{Id:guid}"
@page "/novedad/{Id:guid}"
@rendermode InteractiveServer
@using System.IO
@using Ludeka.Application.Contracts
@using Ludeka.Application.DTOs
@using Ludeka.Core.Entities
@using Ludeka.Core.Enums
@using Ludeka.Core.ValueObjects
@using Ludeka.Web.Components.Shared
@inject IWeeklyReleaseService ReleaseService
@inject IImageStorageService ImageStorageService
@inject ICurrentUserService CurrentUserService
@inject IGameRepository GameRepository
@inject NavigationManager Navigation
@inject ILogger<ReleaseDetail> Logger

<PageTitle>@(_release != null ? $"{_release.Title} — Novedad Editorial | Ludeka" : "Lanzamiento no encontrado — Ludeka")</PageTitle>

@if (_isLoading)
{
    <div class="container-ludeka py-20 text-center text-[var(--text-muted)]">
        <div class="inline-block animate-spin mb-3">
            <Icon Name="newspaper" Size="36" />
        </div>
        <p class="text-base font-semibold">Cargando ficha del lanzamiento...</p>
    </div>
}
else if (_release == null)
{
    <div class="container-ludeka py-20 text-center max-w-lg mx-auto">
        <span class="inline-block mb-4 text-[var(--text-muted)]">
            <Icon Name="package" Size="40" />
        </span>
        <h1 class="text-2xl font-black text-[var(--text-primary)] mb-2">Lanzamiento no encontrado</h1>
        <p class="text-sm text-[var(--text-muted)] mb-6">
            La novedad o lanzamiento que buscas no existe o ha sido retirado del calendario.
        </p>
        <a href="/novedades" class="px-5 py-2.5 rounded-full bg-[var(--brand-primary)] text-[var(--on-brand)] font-bold text-xs transition-opacity shadow-sm inline-flex items-center gap-1.5">
            <span>&larr;</span> Volver al calendario de novedades
        </a>
    </div>
}
else
{
    @* HERO INVERSO DE NOVEDAD EDITORIAL *@
    <section class="bg-[var(--inverse)] text-[var(--on-inverse)]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 flex flex-col gap-6 sm:gap-8">
            @* Barra de navegación y acciones de moderación *@
            <div class="flex flex-wrap items-center justify-between gap-4 font-extrabold text-[13px]">
                <a href="/novedades" class="text-white/80 hover:text-[#FFC145] transition-colors inline-flex items-center gap-1.5">
                    <span>&larr;</span> Volver al calendario de novedades
                </a>

                <div class="flex flex-wrap items-center gap-2">
                    @if (_release.IsPublishedOnInstagram && !string.IsNullOrWhiteSpace(_release.InstagramPermalink))
                    {
                        <a href="@_release.InstagramPermalink"
                           target="_blank"
                           rel="noopener noreferrer"
                           title="Ver publicación oficial en Instagram"
                           class="px-3 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white font-bold text-xs transition-colors flex items-center gap-1.5">
                            <Icon Name="camera" Size="13" /> Instagram <span>↗</span>
                        </a>
                    }
                    else if (CanModerate)
                    {
                        <a href="/admin/instagram?sourceType=WeeklyRelease&sourceId=@_release.Id"
                           class="px-3 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white font-bold text-xs transition-colors flex items-center gap-1.5">
                            <Icon Name="camera" Size="13" /> Crear Post Instagram
                        </a>
                    }

                    @if (CanModerate)
                    {
                        <div class="flex items-center gap-2 pl-2 border-l border-white/20">
                            <button type="button"
                                    @onclick="OpenEditModal"
                                    title="Editar datos y carátula del lanzamiento"
                                    class="px-3 py-1.5 rounded-full bg-[#FFC145] hover:bg-[#e6ad3e] text-[#22180F] font-extrabold text-xs transition-colors flex items-center gap-1.5 shadow-sm">
                                <Icon Name="pen-line" Size="13" /> Editar Novedad
                            </button>
                            <button type="button"
                                    @onclick="() => _isDeleteConfirmOpen = true"
                                    title="Eliminar este lanzamiento"
                                    class="px-3 py-1.5 rounded-full bg-red-600/80 hover:bg-red-600 text-white font-bold text-xs transition-colors flex items-center gap-1.5 shadow-sm">
                                <Icon Name="trash-2" Size="13" /> Eliminar
                            </button>
                        </div>
                    }
                </div>
            </div>

            @* Grid Principal del Hero: Título, Métricas y Carátula Rotada *@
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
                <div class="lg:col-span-7 flex flex-col gap-5 min-w-0">
                    <div class="flex flex-wrap gap-2 items-center">
                        <span class="px-3 py-1 rounded-full text-xs font-black shadow-sm flex items-center gap-1 @(_release.IsReprint ? "bg-white/20 text-white" : "bg-[#FFC145] text-[#22180F]")">
                            @if (_release.IsReprint)
                            {
                                <Icon Name="refresh-cw" Size="12" /> <span>Reimpresión</span>
                            }
                            else
                            {
                                <Icon Name="sparkles" Size="12" /> <span>Novedad</span>
                            }
                        </span>
                        <span class="px-3 py-1 rounded-full bg-transparent text-white text-xs font-extrabold border border-white/40 flex items-center gap-1">
                            <Icon Name="building-2" Size="12" /> @_release.Publisher
                        </span>
                    </div>

                    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-[0.92] text-balance">
                        @_release.Title
                    </h1>

                    @* Barra de Métricas Destacada *@
                    <div class="flex flex-wrap gap-x-8 gap-y-4 py-4 border-t-[3px] border-[#FFC145] border-b border-white/20">
                        <div class="flex flex-col">
                            <b class="text-3xl sm:text-4xl font-black tracking-tight leading-none capitalize">
                                @(_release.ReleaseDate.HasValue ? (_release.IsMonthOnly ? _release.ReleaseDate.Value.ToString("MMMM", new System.Globalization.CultureInfo("es-ES")) : _release.ReleaseDate.Value.ToString("dd/MM")) : "Pronto")
                            </b>
                            <span class="text-xs font-extrabold uppercase tracking-wider text-white/70 mt-1">
                                Salida · @(_release.ReleaseDate.HasValue ? _release.ReleaseDate.Value.ToString("yyyy") : "Calendario")
                            </span>
                        </div>

                        <div class="flex flex-col">
                            <b class="text-3xl sm:text-4xl font-black tracking-tight leading-none text-[#FFC145]">
                                @(_release.EstimatedPvp.HasValue ? $"{_release.EstimatedPvp.Value:0.00} €" : "Por definir")
                            </b>
                            <span class="text-xs font-extrabold uppercase tracking-wider text-white/70 mt-1">
                                Precio estimado
                            </span>
                        </div>

                        <div class="flex flex-col">
                            <b class="text-3xl sm:text-4xl font-black tracking-tight leading-none">
                                @(_release.IsReprint ? "Reimpresión" : "Nueva tirada")
                            </b>
                            <span class="text-xs font-extrabold uppercase tracking-wider text-white/70 mt-1">
                                Tipo de edición
                            </span>
                        </div>
                    </div>

                    @* Botones de Acción Hero *@
                    <div class="flex flex-wrap items-center gap-3 pt-2">
                        @if (!string.IsNullOrWhiteSpace(_release.SourceUrl))
                        {
                            <a href="@_release.SourceUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="h-[52px] px-6 rounded-full bg-[var(--brand-primary)] hover:opacity-90 text-[var(--on-brand)] font-extrabold text-[15px] inline-flex items-center gap-2 shadow-lg transition-all">
                                <span>Ir a la noticia oficial</span>
                                <span>↗</span>
                            </a>
                        }
                        else
                        {
                            <div class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-white/10 text-xs text-white/80">
                                <Icon Name="newspaper" Size="14" Class="text-[#FFC145]" />
                                <span>Información catalogada directamente por el equipo editorial</span>
                            </div>
                            @if (CanModerate)
                            {
                                <button type="button"
                                        @onclick="OpenEditModal"
                                        class="h-[46px] px-5 rounded-full bg-[#FFC145] text-[#22180F] font-extrabold text-xs transition-transform hover:scale-105 inline-flex items-center gap-1.5 shadow-md">
                                    <Icon Name="link" Size="13" />
                                    <span>Añadir enlace oficial a la noticia</span>
                                </button>
                            }
                        }

                        @if (_associatedGame != null)
                        {
                            <a href="/juegos/@_associatedGame.Slug"
                               class="h-[52px] px-5 rounded-full border-2 border-white/50 bg-transparent text-white font-extrabold text-sm inline-flex items-center gap-1.5 hover:bg-white/10 transition-colors">
                                <Icon Name="dices" Size="15" /> Ver ficha de @_associatedGame.SpanishTitle
                            </a>
                        }
                    </div>
                </div>

                @* Columna Derecha: Carátula Rotada con Sello Circular *@
                <div class="lg:col-span-5 relative flex justify-center py-4 sm:py-6">
                    <div class="relative w-full max-w-[340px] sm:max-w-[380px]">
                        @if (string.IsNullOrWhiteSpace(_release.CoverImageUrl))
                        {
                            <DefaultImage Domain="DefaultImageDomain.Novedad"
                                          Alt="@($"Carátula de {_release.Title}")"
                                          CssClass="w-full aspect-square object-cover rounded-xl shadow-2xl -rotate-2 border border-white/10" />
                        }
                        else
                        {
                            <img src="@_release.CoverImageUrl"
                                 alt="Carátula oficial de @_release.Title"
                                 width="600"
                                 height="600"
                                 loading="lazy"
                                 decoding="async"
                                 onerror="this.onerror=null; this.src='/images/defaults/novedad-default.svg';"
                                 class="w-full aspect-square object-cover rounded-xl shadow-2xl -rotate-2 border border-white/10" />
                        }

                        @* Badge Circular Flotante estilo Claude Design *@
                        <div class="absolute -bottom-4 -left-3 sm:-left-6 w-24 h-24 sm:w-28 sm:h-28 rounded-full bg-[#FFC145] text-[#22180F] flex flex-col items-center justify-center text-center -rotate-12 shadow-xl p-2 z-10">
                            <b class="text-3xl sm:text-4xl font-black tracking-tight leading-none">
                                @(_release.ReleaseDate.HasValue ? (_release.IsMonthOnly ? "—" : _release.ReleaseDate.Value.Day.ToString()) : "—")
                            </b>
                            <span class="text-[11px] sm:text-xs font-black uppercase tracking-wider mt-0.5">
                                @(_release.ReleaseDate.HasValue ? _release.ReleaseDate.Value.ToString("MMM", new System.Globalization.CultureInfo("es-ES")).TrimEnd('.') : "Pronto")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* CUERPO EDITORIAL PRINCIPAL: 01 Qué llega / 02 Datos / 03 Reserva y Aside *@
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
            @* Contenido Central (01, 02, 03) *@
            <div class="lg:col-span-8 space-y-12">
                @* 01 Qué llega *@
                <section class="space-y-4">
                    <div class="flex items-baseline gap-4">
                        <b class="text-4xl sm:text-5xl font-black tracking-tight leading-none text-[var(--brand-primary)]">01</b>
                        <b class="text-2xl sm:text-3xl font-black tracking-tight">Qué llega</b>
                    </div>
                    <div class="text-lg sm:text-xl font-bold text-[var(--text-primary)] leading-relaxed text-pretty">
                        @if (!string.IsNullOrWhiteSpace(_release.Notes))
                        {
                            <p class="whitespace-pre-line">@_release.Notes</p>
                        }
                        else
                        {
                            <p>
                                @_release.Title llega al catálogo de @_release.Publisher. Mantén la pista de este lanzamiento para conocer la fecha exacta de distribución en tiendas.
                            </p>
                        }
                    </div>
                    <p class="text-xs text-[var(--text-muted)] flex items-center gap-1.5 pt-1">
                        <Icon Name="check-circle" Size="13" Class="text-emerald-500" />
                        <span>Información catalogada directamente por el equipo editorial</span>
                    </p>
                </section>

                @* 02 Datos del lanzamiento *@
                <section class="space-y-4">
                    <div class="flex items-baseline gap-4">
                        <b class="text-4xl sm:text-5xl font-black tracking-tight leading-none text-[#FFC145]">02</b>
                        <b class="text-2xl sm:text-3xl font-black tracking-tight">Datos del lanzamiento</b>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 pt-2">
                        <div class="p-3.5 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] flex flex-col gap-1">
                            <span class="text-[11px] font-extrabold uppercase tracking-wider text-[var(--text-muted)]">Editorial</span>
                            <b class="text-base text-[var(--text-primary)] leading-tight">@_release.Publisher</b>
                        </div>

                        <div class="p-3.5 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] flex flex-col gap-1">
                            <span class="text-[11px] font-extrabold uppercase tracking-wider text-[var(--text-muted)]">Fecha prevista</span>
                            <b class="text-base text-[var(--text-primary)] leading-tight capitalize">
                                @(_release.ReleaseDate.HasValue ? (_release.IsMonthOnly ? _release.ReleaseDate.Value.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-ES")) : _release.ReleaseDate.Value.ToString("dd/MM/yyyy")) : "Próximamente")
                            </b>
                        </div>

                        <div class="p-3.5 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] flex flex-col gap-1">
                            <span class="text-[11px] font-extrabold uppercase tracking-wider text-[var(--text-muted)]">PVP Estimado</span>
                            <b class="text-base text-[var(--text-primary)] leading-tight">
                                @(_release.EstimatedPvp.HasValue ? $"{_release.EstimatedPvp.Value:0.00} €" : "Sin confirmar")
                            </b>
                        </div>

                        <div class="p-3.5 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] flex flex-col gap-1">
                            <span class="text-[11px] font-extrabold uppercase tracking-wider text-[var(--text-muted)]">Edición</span>
                            <b class="text-base text-[var(--text-primary)] leading-tight">
                                @(_release.IsReprint ? "Reimpresión oficial" : "Nueva novedad")
                            </b>
                        </div>

                        <div class="p-3.5 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] flex flex-col gap-1">
                            <span class="text-[11px] font-extrabold uppercase tracking-wider text-[var(--text-muted)]">Idioma</span>
                            <b class="text-base text-[var(--text-primary)] leading-tight">Español</b>
                        </div>

                        <div class="p-3.5 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] flex flex-col gap-1">
                            <span class="text-[11px] font-extrabold uppercase tracking-wider text-[var(--text-muted)]">Circuito</span>
                            <b class="text-base text-[var(--text-primary)] leading-tight">Tiendas especializadas</b>
                        </div>
                    </div>
                </section>

                @* 03 Dónde reservar / Noticia oficial *@
                <section class="space-y-4">
                    <div class="flex items-baseline gap-4">
                        <b class="text-4xl sm:text-5xl font-black tracking-tight leading-none text-emerald-600">03</b>
                        <b class="text-2xl sm:text-3xl font-black tracking-tight">Dónde reservar / Seguir</b>
                    </div>

                    <div class="p-5 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-4 shadow-sm">
                        @if (!string.IsNullOrWhiteSpace(_release.SourceUrl))
                        {
                            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                                <div class="space-y-1">
                                    <b class="text-base text-[var(--text-primary)]">Publicación y fuente original</b>
                                    <p class="text-xs text-[var(--text-secondary)]">Consulta el anuncio oficial de la editorial o tienda distribuidora.</p>
                                </div>
                                <a href="@_release.SourceUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="px-5 py-2.5 rounded-full bg-[var(--brand-primary)] text-[var(--on-brand)] font-extrabold text-xs inline-flex items-center gap-1.5 hover:opacity-90 shadow-sm shrink-0">
                                    <span>Ir a la noticia oficial</span>
                                    <span>&rarr;</span>
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="text-xs text-[var(--text-secondary)] flex items-center gap-2">
                                <Icon Name="info" Size="14" Class="text-[var(--text-muted)]" />
                                <span>Este lanzamiento aún no tiene enlace directo de reserva asignado.</span>
                            </div>
                        }
                    </div>
                </section>
            </div>

            @* Columna Lateral (Aside): Juego relacionado y Retorno al Calendario *@
            <aside class="lg:col-span-4 space-y-8">
                @if (_associatedGame != null)
                {
                    <div class="p-5 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-4 shadow-sm">
                        <b class="text-xs font-black uppercase tracking-wider text-[var(--text-muted)] block border-b-2 border-[var(--border-subtle)] pb-2">
                            Juego Relacionado
                        </b>

                        <a href="/juegos/@_associatedGame.Slug" class="flex gap-4 items-center group">
                            <div class="w-16 h-16 rounded-xl overflow-hidden bg-[var(--bg-surface-elevated)] shrink-0 border border-[var(--border-subtle)] rotate-2 group-hover:rotate-0 transition-transform">
                                @if (!string.IsNullOrWhiteSpace(_associatedGame.ThumbnailUrl))
                                {
                                    <img src="@_associatedGame.ThumbnailUrl"
                                         alt="@_associatedGame.SpanishTitle"
                                         width="64"
                                         height="64"
                                         loading="lazy"
                                         decoding="async"
                                         class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <img src="/images/game-placeholder.svg"
                                         alt="@_associatedGame.SpanishTitle"
                                         width="64"
                                         height="64"
                                         loading="lazy"
                                         decoding="async"
                                         class="w-full h-full object-cover opacity-80" />
                                }
                            </div>

                            <div class="min-w-0 flex-1">
                                <b class="text-base text-[var(--text-primary)] group-hover:text-[var(--brand-primary)] transition-colors block truncate">
                                    @_associatedGame.SpanishTitle
                                </b>
                                <span class="text-xs text-[var(--text-muted)] block truncate">
                                    @_associatedGame.Designer &bull; @_associatedGame.YearPublished
                                </span>
                                <div class="flex items-center gap-2 mt-1 text-xs font-extrabold text-amber-500">
                                    <Icon Name="star" Size="12" />
                                    <span>@_associatedGame.BggRating.ToString("0.0")</span>
                                    <span class="text-[var(--text-muted)] font-normal">#@_associatedGame.BggRank en BGG</span>
                                </div>
                            </div>
                        </a>

                        <div class="pt-2">
                            <a href="/juegos/@_associatedGame.Slug" class="w-full py-2.5 rounded-full border border-[var(--border-subtle)] hover:bg-[var(--bg-surface-elevated)] text-[var(--text-primary)] text-xs font-bold text-center block transition-colors">
                                Ver Ficha del Juego
                            </a>
                        </div>
                    </div>
                }

                @* Calendario Completo *@
                <div class="p-5 rounded-2xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] space-y-3">
                    <b class="text-xs font-black uppercase tracking-wider text-[var(--text-muted)] block">
                        Calendario Editorial
                    </b>
                    <p class="text-xs text-[var(--text-secondary)]">
                        Explora todas las novedades confirmadas, reediciones y salidas previstas del mes en curso.
                    </p>
                    <a href="/novedades" class="inline-flex items-center gap-1.5 font-black text-xs text-[var(--brand-primary)] hover:underline pt-1">
                        <span>Ver calendario completo</span>
                        <span>&rarr;</span>
                    </a>
                </div>
            </aside>
        </div>
    </div>
}

@* Modal de Edición de Novedad *@
@if (CanModerate && _isEditModalOpen)
{
    <EditorialModal Open="@_isEditModalOpen"
                    Title="Editar Novedad Editorial"
                    TitleIcon="pen-line"
                    OnClose="@(() => _isEditModalOpen = false)">
        <ChildContent>
            <div class="space-y-4 text-xs">
                @* Título *@
                <div>
                    <label class="font-semibold text-[var(--text-secondary)] block mb-1">Título del Juego *</label>
                    <input type="text"
                           @bind="_editTitle"
                           placeholder="Ej. Heat: Lluvia Torrencial"
                           class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                </div>

                @* Editorial y Fecha *@
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="font-semibold text-[var(--text-secondary)] block mb-1">Editorial / Distribuidora *</label>
                        <input type="text"
                               @bind="_editPublisher"
                               placeholder="Ej. Asmodee / Days of Wonder"
                               class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                    </div>
                    <div>
                        <label class="font-semibold text-[var(--text-secondary)] block mb-1">Fecha de Lanzamiento (Opcional)</label>
                        <input type="date"
                               @bind="_editReleaseDate"
                               class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                    </div>
                </div>

                @* PVP y Tipo *@
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="font-semibold text-[var(--text-secondary)] block mb-1">PVP Estimado (€)</label>
                        <input type="number"
                               step="0.5"
                               @bind="_editPvp"
                               placeholder="Ej. 39.99"
                               class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                    </div>
                    <div class="flex flex-col sm:flex-row sm:items-center gap-4 pt-5">
                        <label class="flex items-center gap-2 cursor-pointer font-medium text-[var(--text-secondary)]">
                            <input type="checkbox"
                                   @bind="_editIsReprint"
                                   class="rounded bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--brand-primary)] focus:ring-0" />
                            <span>Es Reimpresión</span>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer font-medium text-[var(--text-secondary)]">
                            <input type="checkbox"
                                   @bind="_editIsMonthOnly"
                                   class="rounded bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--brand-primary)] focus:ring-0" />
                            <span>Solo mes previsto (sin día exacto)</span>
                        </label>
                    </div>
                </div>

                @* URL de Noticia Oficial / Origen *@
                <div>
                    <label class="font-semibold text-[var(--text-secondary)] block mb-1">Enlace Oficial a la Noticia / Fuente (URL) *</label>
                    <input type="url"
                           @bind="_editSourceUrl"
                           placeholder="https://... (web de editorial, tienda o publicación oficial)"
                           class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                    <span class="text-[0.68rem] text-[var(--text-muted)] mt-1 block">
                        Obligatorio (igual que en sorteos): enlace a la web de la editorial o tienda donde se anunció la novedad.
                    </span>
                </div>

                @* Carátula y Subida R2 *@
                <div class="p-3 rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-2">
                    <label class="font-semibold text-[var(--text-secondary)] block">Carátula de la Novedad</label>
                    <div class="flex items-center gap-3">
                        @if (!string.IsNullOrWhiteSpace(_editCoverImageUrl))
                        {
                            <img src="@_editCoverImageUrl"
                                 alt="Vista previa"
                                 class="w-14 h-14 rounded-lg object-cover border border-[var(--border-subtle)] shrink-0"
                                 onerror="this.onerror=null; this.src='/images/defaults/novedad-default.svg';" />
                        }
                        else
                        {
                            <DefaultImage Domain="DefaultImageDomain.Novedad" CssClass="w-14 h-14 rounded-lg object-cover border border-[var(--border-subtle)] shrink-0" />
                        }

                        <div class="flex-1 space-y-1.5">
                            <InputFile OnChange="HandleImageSelected"
                                       accept="image/png,image/jpeg,image/webp"
                                       class="text-xs text-[var(--text-muted)] file:mr-2 file:py-1 file:px-2.5 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-[var(--brand-primary)] file:text-white hover:file:opacity-90 cursor-pointer" />
                            <p class="text-[0.65rem] text-[var(--text-muted)]">
                                Optimizado automático a WebP con compresión y almacenamiento en Cloudflare R2.
                            </p>
                            @if (_isUploadingImage)
                            {
                                <span class="text-xs text-[var(--brand-primary)] flex items-center gap-1 font-semibold">
                                    <span class="animate-spin"><Icon Name="refresh-cw" Size="11" /></span> Optimizando y subiendo...
                                </span>
                            }
                        </div>
                    </div>

                    <div>
                        <label class="text-[0.7rem] text-[var(--text-muted)] block mb-1">O introduce URL directa:</label>
                        <input type="url"
                               @bind="_editCoverImageUrl"
                               placeholder="https://... o /images/..."
                               class="w-full px-3 py-1.5 rounded-lg bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                    </div>
                </div>

                @* Notas *@
                <div>
                    <label class="font-semibold text-[var(--text-secondary)] block mb-1">Notas Editoriales</label>
                    <textarea rows="3"
                              @bind="_editNotes"
                              placeholder="Ej. Edición en español confirmada para el último trimestre..."
                              class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]"></textarea>
                </div>

                @if (!string.IsNullOrWhiteSpace(_editError))
                {
                    <div class="p-2.5 rounded-xl bg-[var(--state-error-bg)] border border-[var(--state-error-border)] text-[var(--state-error)] text-xs">
                        @_editError
                    </div>
                }
            </div>
        </ChildContent>

        <Footer>
            <button type="button"
                    @onclick="() => _isEditModalOpen = false"
                    disabled="@_isSaving"
                    class="px-4 py-2 rounded-xl border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] text-xs font-bold transition-colors">
                Cancelar
            </button>
            <button type="button"
                    @onclick="HandleSaveRelease"
                    disabled="@_isSaving"
                    class="px-4 py-2 rounded-xl bg-[var(--brand-primary)] hover:opacity-90 text-[var(--on-brand)] text-xs font-bold transition-opacity inline-flex items-center gap-1.5 shadow-sm disabled:opacity-50">
                @if (_isSaving)
                {
                    <span class="animate-spin"><Icon Name="refresh-cw" Size="12" /></span>
                    <span>Guardando...</span>
                }
                else
                {
                    <span>Guardar Cambios</span>
                }
            </button>
        </Footer>
    </EditorialModal>
}

@* Modal de Confirmación de Eliminación *@
@if (CanModerate)
{
    <EditorialModal Open="@_isDeleteConfirmOpen"
                    Title="Eliminar Lanzamiento"
                    TitleIcon="trash-2"
                    OnClose="@(() => _isDeleteConfirmOpen = false)">
        <ChildContent>
            <div class="space-y-3 text-xs">
                <p class="text-[var(--text-primary)] font-semibold">
                    ¿Estás seguro de que deseas eliminar definitivamente este lanzamiento?
                </p>
                <div class="p-3 rounded-xl bg-[var(--state-error-bg)] border border-[var(--state-error-border)] text-[var(--state-error)] text-xs">
                    Esta acción retirará la novedad del calendario y de la portada de Ludeka. La operación no se puede deshacer.
                </div>
            </div>
        </ChildContent>

        <Footer>
            <button type="button"
                    @onclick="() => _isDeleteConfirmOpen = false"
                    disabled="@_isDeleting"
                    class="px-4 py-2 rounded-xl border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] text-xs font-bold transition-colors">
                Cancelar
            </button>
            <button type="button"
                    @onclick="HandleDeleteRelease"
                    disabled="@_isDeleting"
                    class="px-4 py-2 rounded-xl bg-[var(--state-error)] hover:opacity-90 text-[var(--on-brand)] text-xs font-bold transition-opacity inline-flex items-center gap-1.5 shadow-sm disabled:opacity-50">
                @if (_isDeleting)
                {
                    <span class="animate-spin"><Icon Name="refresh-cw" Size="12" /></span>
                    <span>Eliminando...</span>
                }
                else
                {
                    <span>Eliminar Definitivamente</span>
                }
            </button>
        </Footer>
    </EditorialModal>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private WeeklyReleaseDto? _release;
    private Game? _associatedGame;
    private bool _isLoading = true;
    private bool _isEditModalOpen;
    private bool _isDeleteConfirmOpen;
    private bool _isSaving;
    private bool _isDeleting;
    private bool _isUploadingImage;

    // Campos de edición
    private string _editTitle = string.Empty;
    private string _editPublisher = string.Empty;
    private DateOnly? _editReleaseDate;
    private decimal? _editPvp;
    private bool _editIsReprint;
    private bool _editIsMonthOnly;
    private string? _editCoverImageUrl;
    private string? _editNotes;
    private string? _editSourceUrl;
    private Guid? _editGameId;
    private string? _editError;

    private bool CanModerate => CurrentUserService.IsFoundingTeam ||
                               (CurrentUserService.IsInRole("Moderator") && CurrentUserService.HasPermission(ModeratorPermission.CanApproveMedia));

    protected override async Task OnInitializedAsync()
    {
        await LoadReleaseAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_release != null && _release.Id != Id)
        {
            await LoadReleaseAsync();
        }
    }

    private async Task LoadReleaseAsync()
    {
        _isLoading = true;
        try
        {
            _release = await ReleaseService.GetByIdAsync(Id);
            if (_release?.GameId.HasValue == true)
            {
                _associatedGame = await GameRepository.GetByIdAsync(_release.GameId.Value);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar el lanzamiento {ReleaseId}", Id);
            _release = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenEditModal()
    {
        if (_release == null) return;

        _editTitle = _release.Title;
        _editPublisher = _release.Publisher;
        _editReleaseDate = _release.ReleaseDate;
        _editPvp = _release.EstimatedPvp;
        _editIsReprint = _release.IsReprint;
        _editIsMonthOnly = _release.IsMonthOnly;
        _editCoverImageUrl = _release.CoverImageUrl;
        _editNotes = _release.Notes;
        _editSourceUrl = _release.SourceUrl;
        _editGameId = _release.GameId;
        _editError = null;
        _isEditModalOpen = true;
    }

    private async Task HandleImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        if (file.Size > 10 * 1024 * 1024)
        {
            _editError = "La imagen no debe superar los 10 MB.";
            return;
        }

        _isUploadingImage = true;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            var objectKey = $"releases/{Id:N}/cover.webp";
            var publicUrl = await ImageStorageService.UploadOptimizedImageAsync(
                memoryStream,
                objectKey,
                maxWidth: 1200,
                quality: 85);

            _editCoverImageUrl = publicUrl;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al optimizar y subir carátula para el lanzamiento {ReleaseId}", Id);
            _editError = "No se pudo subir la imagen. Verifica la conexión o formato del archivo.";
        }
        finally
        {
            _isUploadingImage = false;
        }
    }

    private async Task HandleSaveRelease()
    {
        _editError = null;

        if (string.IsNullOrWhiteSpace(_editTitle))
        {
            _editError = "El título del lanzamiento es obligatorio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_editPublisher))
        {
            _editError = "La editorial es obligatoria.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_editSourceUrl))
        {
            _editError = "El enlace oficial o noticia de la novedad es obligatorio (igual que en sorteos).";
            return;
        }

        if (!Uri.TryCreate(_editSourceUrl.Trim(), UriKind.Absolute, out var parsedUri) ||
            (parsedUri.Scheme != Uri.UriSchemeHttp && parsedUri.Scheme != Uri.UriSchemeHttps))
        {
            _editError = "El enlace oficial debe ser una URL válida que empiece por http:// o https://.";
            return;
        }

        var request = new UpdateWeeklyReleaseRequest(
            Id: Id,
            Title: _editTitle,
            Publisher: _editPublisher,
            ReleaseDate: _editReleaseDate,
            GameId: _editGameId,
            CoverImageUrl: string.IsNullOrWhiteSpace(_editCoverImageUrl) ? null : _editCoverImageUrl.Trim(),
            EstimatedPvp: _editPvp,
            IsReprint: _editIsReprint,
            Notes: string.IsNullOrWhiteSpace(_editNotes) ? null : _editNotes.Trim(),
            SourceUrl: string.IsNullOrWhiteSpace(_editSourceUrl) ? null : _editSourceUrl.Trim(),
            IsMonthOnly: _editIsMonthOnly);

        _isSaving = true;
        try
        {
            _release = await ReleaseService.UpdateReleaseAsync(Id, request);
            if (_release.GameId.HasValue)
            {
                _associatedGame = await GameRepository.GetByIdAsync(_release.GameId.Value);
            }
            else
            {
                _associatedGame = null;
            }

            _isEditModalOpen = false;
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al guardar el lanzamiento {ReleaseId}", Id);
            _editError = "Ocurrió un error inesperado al guardar los cambios.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task HandleDeleteRelease()
    {
        _isDeleting = true;
        try
        {
            await ReleaseService.DeleteReleaseAsync(Id);
            _isDeleteConfirmOpen = false;
            Navigation.NavigateTo("/novedades");
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al eliminar el lanzamiento {ReleaseId}", Id);
        }
        finally
        {
            _isDeleting = false;
        }
    }
}
