@page "/admin/afiliados"
@page "/admin/feeds"
@attribute [Authorize(Policy = AuthorizationPolicies.PermisoGestionarTiendas)]
@layout AdminLayout
@rendermode InteractiveServer
@using Ludeka.Application.Contracts
@using Ludeka.Core.Entities
@using Ludeka.Core.Enums
@using Ludeka.Web.Authentication
@inject IAffiliateFeedSourceRepository FeedSourceRepository
@inject IAffiliateEanDiscrepancyRepository DiscrepancyRepository
@inject ICatalogFeedSyncService FeedSyncService
@inject IGameRepository GameRepository
@inject ICurrentUserService CurrentUserService

<PageTitle>Feeds de Tiendas & Discrepancias EAN | Ludeka Gestión</PageTitle>

<div class="max-w-[1280px] mx-auto py-2 sm:py-4 space-y-6">
    @if (!CanManageAffiliates)
    {
        <div class="max-w-md mx-auto py-16 text-center space-y-4">
            <span class="inline-block text-amber-500"><Icon Name="shopping-bag" Size="48" /></span>
            <h1 class="text-2xl font-black text-[var(--ink)]">Acceso Restringido a Gestión de Tiendas</h1>
            <p class="text-sm text-[var(--muted)]">
                La configuración de feeds comerciales y resolución de discrepancias EAN requiere el permiso de gestión de tiendas y afiliados.
            </p>
            <a href="/" class="inline-block text-xs font-bold text-[var(--accent)] underline">
                &larr; Volver al Catálogo
            </a>
        </div>
    }
    else
    {
        @* Cabecera Editorial Segun Diseno de Claude (Screenshot 1) *@
        <div class="space-y-4 mb-6">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
                <div class="space-y-1">
                    <span class="text-xs font-black uppercase tracking-[0.14em] text-[var(--accent)]">
                        Comercial
                    </span>
                    <h1 class="text-2xl sm:text-3xl font-black tracking-[-0.035em] text-[var(--ink)]">
                        Feeds y afiliados
                    </h1>
                    <p class="text-xs sm:text-sm text-[var(--muted)] max-w-2xl">
                        Ingesta de catálogos de tiendas (Google Shopping XML, Shopify JSON o CSV) y discrepancias EAN.
                    </p>
                </div>
                <div class="flex items-center gap-2.5 shrink-0 flex-wrap">
                    <button type="button"
                            @onclick="() => { _isFormVisible = !_isFormVisible; if (!_isFormVisible) ResetForm(); }"
                            class="h-10 px-4 rounded-full border-2 border-[var(--rule)] bg-transparent text-[var(--ink)] font-extrabold text-xs hover:bg-[var(--paper-2)] transition-all">
                        + Registrar feed
                    </button>
                    <button type="button"
                            @onclick="SyncAllActiveAsync"
                            disabled="@_isSyncingAll"
                            class="h-10 px-5 rounded-full bg-[var(--brand)] text-[var(--on-brand)] font-extrabold text-xs hover:opacity-90 transition-opacity disabled:opacity-50">
                        @if (_isSyncingAll)
                        {
                            <span class="inline-flex items-center gap-2">
                                <Icon Name="refresh-cw" Size="14" class="animate-spin" />
                                <span>Sincronizando...</span>
                            </span>
                        }
                        else
                        {
                            <span>Sincronizar Feeds Activos</span>
                        }
                    </button>
                    <button type="button"
                            @onclick="LoadDataAsync"
                            title="Refrescar datos"
                            class="h-10 w-10 rounded-full border border-[var(--line)] bg-[var(--card)] hover:bg-[var(--paper-2)] text-[var(--muted)] hover:text-[var(--ink)] flex items-center justify-center transition-colors">
                        <Icon Name="refresh-cw" Size="14" />
                    </button>
                </div>
            </div>
        </div>

        @* Notificación de Feedback *@
        @if (!string.IsNullOrEmpty(_feedbackMessage))
        {
            <div class="p-3.5 mb-5 rounded-2xl text-xs font-bold flex items-center justify-between transition-all @(_isFeedbackError ? "bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/25" : "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/25")" role="alert">
                <div class="flex items-center gap-2">
                    @if (_isFeedbackError)
                    {
                        <Icon Name="info" Size="14" />
                    }
                    else
                    {
                        <Icon Name="check" Size="14" />
                    }
                    <span>@_feedbackMessage</span>
                </div>
                <button type="button" @onclick="() => _feedbackMessage = null" class="opacity-60 hover:opacity-100 text-sm font-black">
                    &times;
                </button>
            </div>
        }

        @* Pestañas en Píldora (Screenshot 1) *@
        <div class="inline-flex p-1 rounded-full bg-[var(--paper-2)] gap-1 mb-5">
            <button type="button"
                    @onclick="() => _activeTab = TabFeeds"
                    class="h-8.5 px-4 rounded-full text-xs font-extrabold transition-all @(_activeTab == TabFeeds ? "bg-[var(--ink)] text-[var(--paper)] shadow-xs" : "text-[var(--muted)] hover:text-[var(--ink)]")">
                Fuentes de Catálogo
            </button>
            <button type="button"
                    @onclick="() => _activeTab = TabDiscrepancies"
                    class="h-8.5 px-4 rounded-full text-xs font-extrabold transition-all @(_activeTab == TabDiscrepancies ? "bg-[var(--ink)] text-[var(--paper)] shadow-xs" : "text-[var(--muted)] hover:text-[var(--ink)]")">
                Discrepancias EAN @(_discrepancies.Count > 0 ? $"· {_discrepancies.Count}" : "")
            </button>
        </div>

        @* Formulario de Registro o Edición *@
        @if (_isFormVisible)
        {
            <div class="p-6 mb-6 rounded-3xl bg-[var(--card)] border-2 border-[var(--rule)] shadow-xl space-y-4 animate-fade-in">
                <div class="flex items-center justify-between pb-3 border-b border-[var(--line)]">
                    <h2 class="text-sm font-black text-[var(--ink)] flex items-center gap-2">
                        <Icon Name="shopping-bag" Size="16" />
                        <span>@(_editingSourceId.HasValue ? "Editar Fuente de Catálogo" : "Registrar Nueva Fuente de Catálogo")</span>
                    </h2>
                    <button type="button" @onclick="ResetForm" class="text-xs font-bold text-[var(--muted)] hover:text-[var(--ink)]">
                        Cancelar
                    </button>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
                    <div class="space-y-1">
                        <label class="font-extrabold text-[var(--ink)]">Nombre de la Tienda *</label>
                        <input type="text"
                               @bind="_formStoreName"
                               placeholder="Ej: Meeple Express, Dados & Café, Zacatrus"
                               class="w-full h-10 px-3.5 rounded-xl bg-[var(--paper)] border border-[var(--line)] text-[var(--ink)] focus:outline-none focus:border-[var(--brand)] font-bold text-xs" />
                    </div>

                    <div class="space-y-1 md:col-span-2">
                        <label class="font-extrabold text-[var(--ink)]">URL del Feed Comercial *</label>
                        <input type="url"
                               @bind="_formFeedUrl"
                               placeholder="https://tienda.es/feeds/google-shopping.xml o https://tienda.es/products.json"
                               class="w-full h-10 px-3.5 rounded-xl bg-[var(--paper)] border border-[var(--line)] text-[var(--ink)] focus:outline-none focus:border-[var(--brand)] font-mono text-[11px]" />
                    </div>

                    <div class="space-y-1">
                        <label class="font-extrabold text-[var(--ink)]">Formato del Feed</label>
                        <select @bind="_formFormat"
                                class="w-full h-10 px-3 rounded-xl bg-[var(--paper)] border border-[var(--line)] text-[var(--ink)] focus:outline-none focus:border-[var(--brand)] font-bold text-xs">
                            <option value="@FeedFormat.GoogleShoppingXml">Google Shopping XML (Merchant)</option>
                            <option value="@FeedFormat.ShopifyJson">Shopify Catálogo JSON (/products.json)</option>
                            <option value="@FeedFormat.GenericCsv">CSV Genérico (Delimitado)</option>
                        </select>
                    </div>

                    <div class="space-y-1">
                        <label class="font-extrabold text-[var(--ink)]">Tag / Parámetro de Afiliado</label>
                        <input type="text"
                               @bind="_formAffiliateTag"
                               placeholder="Ej: tag=ludeka-21 o ref=ludeka"
                               class="w-full h-10 px-3.5 rounded-xl bg-[var(--paper)] border border-[var(--line)] text-[var(--ink)] focus:outline-none focus:border-[var(--brand)] font-bold text-xs" />
                    </div>

                    <div class="space-y-1">
                        <label class="font-extrabold text-[var(--ink)]">País / Ámbito</label>
                        <input type="text"
                               @bind="_formCountry"
                               placeholder="España"
                               class="w-full h-10 px-3.5 rounded-xl bg-[var(--paper)] border border-[var(--line)] text-[var(--ink)] focus:outline-none focus:border-[var(--brand)] font-bold text-xs" />
                    </div>

                    <div class="space-y-1">
                        <label class="font-extrabold text-[var(--ink)]">Intervalo de Sincronización (horas)</label>
                        <input type="number"
                               min="1"
                               max="168"
                               @bind="_formSyncIntervalHours"
                               class="w-full h-10 px-3.5 rounded-xl bg-[var(--paper)] border border-[var(--line)] text-[var(--ink)] focus:outline-none focus:border-[var(--brand)] font-bold text-xs" />
                    </div>

                    <div class="flex items-center gap-2 pt-4">
                        <input type="checkbox"
                               id="feedIsEnabled"
                               @bind="_formIsEnabled"
                               class="rounded bg-[var(--paper)] border-[var(--line)] text-[var(--brand)] w-4 h-4" />
                        <label for="feedIsEnabled" class="font-extrabold text-[var(--ink)] cursor-pointer text-xs">
                            Habilitar ingesta periódica automática
                        </label>
                    </div>
                </div>

                <div class="flex items-center justify-end gap-2 pt-3 border-t border-[var(--line)]">
                    <button type="button"
                            @onclick="ResetForm"
                            class="h-9 px-4 rounded-full border border-[var(--line)] bg-[var(--paper-2)] hover:bg-[var(--line)] text-[var(--ink)] text-xs font-bold transition-colors">
                        Cancelar
                    </button>
                    <button type="button"
                            @onclick="SaveSourceAsync"
                            disabled="@_isSaving"
                            class="h-9 px-5 rounded-full bg-[var(--brand)] hover:opacity-90 text-[var(--on-brand)] text-xs font-black transition-opacity disabled:opacity-50">
                        @(_isSaving ? "Guardando..." : (_editingSourceId.HasValue ? "Actualizar Fuente" : "Guardar Fuente"))
                    </button>
                </div>
            </div>
        }

        @* Pestaña 1: Fuentes de Catálogo *@
        @if (_activeTab == TabFeeds)
        {
            @if (_isLoading)
            {
                <div class="p-12 text-center text-xs text-[var(--muted)] space-y-2">
                    <span class="animate-spin inline-block"><Icon Name="refresh-cw" Size="20" /></span>
                    <p>Cargando fuentes de catálogo...</p>
                </div>
            }
            else if (_sources.Count == 0)
            {
                <div class="p-12 text-center rounded-3xl bg-[var(--card)] border border-[var(--line)] space-y-3">
                    <span class="text-[var(--muted)] inline-block"><Icon Name="shopping-bag" Size="36" /></span>
                    <h3 class="text-sm font-bold text-[var(--ink)]">No hay fuentes de catálogo configuradas</h3>
                    <p class="text-xs text-[var(--muted)] max-w-sm mx-auto">
                        Registra la URL del feed Google Shopping XML, Shopify JSON o CSV provisto por una tienda asociada para comenzar la sincronización.
                    </p>
                    <button type="button"
                            @onclick="() => _isFormVisible = true"
                            class="h-10 px-5 rounded-full bg-[var(--brand)] text-[var(--on-brand)] text-xs font-bold hover:opacity-90 transition-opacity">
                        Registrar Primer Feed
                    </button>
                </div>
            }
            else
            {
                <div class="flex flex-col gap-2">
                    @foreach (var feed in _sources)
                    {
                        var isSyncing = _syncingSourceId == feed.Id;
                        var isFailed = !string.IsNullOrWhiteSpace(feed.LastSyncStatus) &&
                            (feed.LastSyncStatus.Contains("error", StringComparison.OrdinalIgnoreCase) ||
                             feed.LastSyncStatus.Contains("fall", StringComparison.OrdinalIgnoreCase));
                        var dotColor = !feed.IsEnabled ? "bg-zinc-400" : (isFailed ? "bg-red-500" : "bg-emerald-500");
                        var opacityClass = feed.IsEnabled ? "opacity-100" : "opacity-60";

                        <div class="flex flex-wrap items-center gap-3 sm:gap-4 p-3.5 sm:p-4 rounded-2xl border border-[var(--line)] bg-[var(--card)] transition-all @opacityClass">
                            <span class="w-2.5 h-2.5 rounded-full @dotColor shrink-0"></span>

                            <div class="flex-1 min-w-[200px] flex flex-col min-w-0">
                                <b class="text-sm font-bold text-[var(--ink)] truncate">@feed.StoreName</b>
                                <span class="text-xs text-[var(--muted)] truncate max-w-md">
                                    @GetFormatDisplayName(feed.Format) &bull; @feed.FeedUrl
                                </span>
                            </div>

                            <span class="w-40 text-xs font-semibold text-[var(--muted)] shrink-0">
                                @if (!feed.IsEnabled)
                                {
                                    <span>Desactivado</span>
                                }
                                else if (isFailed)
                                {
                                    <span class="text-rose-500 font-bold truncate block">Error: @feed.LastSyncStatus</span>
                                }
                                else if (feed.LastSyncUtc.HasValue)
                                {
                                    <span>@FormatSyncDate(feed.LastSyncUtc.Value)</span>
                                }
                                else
                                {
                                    <span>Pendiente</span>
                                }
                            </span>

                            <span class="w-24 text-xs font-extrabold text-[var(--ink)] shrink-0">
                                @feed.MatchedProductsCount ofertas
                            </span>

                            <div class="flex items-center gap-2 shrink-0">
                                <button type="button"
                                        @onclick="() => SyncFeedAsync(feed.Id)"
                                        disabled="@(isSyncing || !feed.IsEnabled)"
                                        class="h-8.5 px-3.5 rounded-full border border-[var(--rule)] bg-transparent font-extrabold text-xs text-[var(--ink)] hover:bg-[var(--paper-2)] transition-all disabled:opacity-40">
                                    @(isSyncing ? "Sincronizando..." : "Sincronizar")
                                </button>

                                <button type="button"
                                        @onclick="() => ToggleSourceEnabledAsync(feed)"
                                        role="switch"
                                        aria-checked="@feed.IsEnabled"
                                        aria-label="Activar o desactivar feed"
                                        class="w-12 h-7 rounded-full p-0.5 transition-colors relative shrink-0 @(feed.IsEnabled ? "bg-emerald-600" : "bg-zinc-300 dark:bg-zinc-700")">
                                    <span class="block w-6 h-6 rounded-full bg-white shadow-xs transition-transform @(feed.IsEnabled ? "translate-x-5" : "translate-x-0")"></span>
                                </button>

                                <button type="button"
                                        @onclick="() => StartEditSource(feed)"
                                        title="Editar feed"
                                        class="p-2 rounded-full text-[var(--muted)] hover:text-[var(--ink)] hover:bg-[var(--paper-2)] transition-colors">
                                    <Icon Name="pen-line" Size="14" />
                                </button>
                                <button type="button"
                                        @onclick="() => DeleteSourceAsync(feed.Id)"
                                        title="Eliminar feed"
                                        class="p-2 rounded-full text-[var(--muted)] hover:text-rose-500 hover:bg-rose-500/10 transition-colors">
                                    <Icon Name="trash-2" Size="14" />
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        }

        @* Pestaña 2: Discrepancias EAN *@
        @if (_activeTab == TabDiscrepancies)
        {
            <span class="block text-xs sm:text-sm text-[var(--muted)] leading-relaxed mb-3 max-w-3xl">
                Cuando un feed reporta un juego que coincide con el catálogo pero con un EAN distinto, el sistema lo guarda como código adicional y levanta esta alerta.
            </span>

            @if (_isLoading)
            {
                <div class="p-12 text-center text-xs text-[var(--muted)] space-y-2">
                    <span class="animate-spin inline-block"><Icon Name="refresh-cw" Size="20" /></span>
                    <p>Cargando discrepancias EAN...</p>
                </div>
            }
            else if (_discrepancies.Count == 0)
            {
                <div class="p-12 text-center rounded-3xl bg-[var(--card)] border border-[var(--line)]">
                    <p class="text-xs sm:text-sm font-bold text-[var(--muted)]">
                        Todos los juegos de los feeds coinciden con los códigos del catálogo.
                    </p>
                </div>
            }
            else
            {
                <div class="flex flex-col gap-2">
                    @foreach (var disc in _discrepancies)
                    {
                        <div class="flex flex-wrap items-center gap-3 sm:gap-4 p-3.5 sm:p-4 rounded-2xl border border-[var(--line)] bg-[var(--card)]">
                            <b class="flex-1 min-w-[180px] text-sm font-extrabold text-[var(--ink)]">
                                @disc.GameTitle
                            </b>

                            <div class="flex flex-col text-xs w-40 shrink-0">
                                <span class="text-[var(--muted)] text-[11px]">EAN actual en Ludeka</span>
                                <b class="font-mono font-bold text-[var(--ink)]">@(string.IsNullOrWhiteSpace(disc.CurrentEan) ? "—" : disc.CurrentEan)</b>
                            </div>

                            <div class="flex flex-col text-xs w-48 shrink-0">
                                <span class="text-[var(--muted)] text-[11px]">EAN en feed &bull; @disc.StoreName</span>
                                <b class="font-mono font-bold text-[var(--accent)]">@disc.FeedEan</b>
                            </div>

                            <div class="flex items-center gap-2 shrink-0">
                                <button type="button"
                                        @onclick="() => DismissDiscrepancyAsync(disc)"
                                        disabled="@_isProcessingDiscrepancy"
                                        class="h-8.5 px-3.5 rounded-full border border-[var(--rule)] bg-transparent font-extrabold text-xs text-[var(--ink)] hover:bg-[var(--paper-2)] transition-all">
                                    Descartar
                                </button>
                                <button type="button"
                                        @onclick="() => PromoteDiscrepancyAsync(disc)"
                                        disabled="@_isProcessingDiscrepancy"
                                        class="h-8.5 px-3.5 rounded-full bg-[var(--ink)] text-[var(--paper)] font-extrabold text-xs hover:opacity-90 transition-opacity">
                                    Promover a EAN principal
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    }
</div>

@code {
    private const string TabFeeds = "feeds";
    private const string TabDiscrepancies = "discrepancies";

    private string _activeTab = TabFeeds;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isSyncingAll;
    private Guid? _syncingSourceId;
    private bool _isProcessingDiscrepancy;
    private string? _feedbackMessage;
    private bool _isFeedbackError;

    // Fuentes
    private List<AffiliateFeedSource> _sources = new();
    private List<AffiliateEanDiscrepancyLog> _discrepancies = new();

    // Estado del formulario
    private bool _isFormVisible;
    private Guid? _editingSourceId;
    private string _formStoreName = string.Empty;
    private string _formFeedUrl = string.Empty;
    private FeedFormat _formFormat = FeedFormat.GoogleShoppingXml;
    private string? _formAffiliateTag;
    private string _formCountry = "España";
    private int _formSyncIntervalHours = 6;
    private bool _formIsEnabled = true;

    private bool CanManageAffiliates =>
        CurrentUserService.IsFoundingTeam || CurrentUserService.HasPermission(ModeratorPermission.CanManageStoreLinks);

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _sources = await FeedSourceRepository.GetAllAsync();
            _discrepancies = await DiscrepancyRepository.GetPendingDiscrepanciesAsync(50);
        }
        catch (Exception ex)
        {
            SetFeedback($"Error al cargar datos: {ex.Message}", isError: true);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void StartEditSource(AffiliateFeedSource source)
    {
        _editingSourceId = source.Id;
        _formStoreName = source.StoreName;
        _formFeedUrl = source.FeedUrl;
        _formFormat = source.Format;
        _formAffiliateTag = source.AffiliateTag;
        _formCountry = source.Country;
        _formSyncIntervalHours = source.SyncIntervalHours;
        _formIsEnabled = source.IsEnabled;
        _isFormVisible = true;
    }

    private void ResetForm()
    {
        _editingSourceId = null;
        _formStoreName = string.Empty;
        _formFeedUrl = string.Empty;
        _formFormat = FeedFormat.GoogleShoppingXml;
        _formAffiliateTag = null;
        _formCountry = "España";
        _formSyncIntervalHours = 6;
        _formIsEnabled = true;
        _isFormVisible = false;
    }

    private async Task SaveSourceAsync()
    {
        if (string.IsNullOrWhiteSpace(_formStoreName))
        {
            SetFeedback("El nombre de la tienda es obligatorio.", isError: true);
            return;
        }

        if (string.IsNullOrWhiteSpace(_formFeedUrl) || !Uri.TryCreate(_formFeedUrl, UriKind.Absolute, out _))
        {
            SetFeedback("Introduce una URL de feed válida (ej: https://tienda.es/feed.xml).", isError: true);
            return;
        }

        _isSaving = true;
        try
        {
            if (_editingSourceId.HasValue)
            {
                var existing = await FeedSourceRepository.GetByIdAsync(_editingSourceId.Value);
                if (existing != null)
                {
                    existing.StoreName = _formStoreName.Trim();
                    existing.FeedUrl = _formFeedUrl.Trim();
                    existing.Format = _formFormat;
                    existing.AffiliateTag = string.IsNullOrWhiteSpace(_formAffiliateTag) ? null : _formAffiliateTag.Trim();
                    existing.Country = string.IsNullOrWhiteSpace(_formCountry) ? "España" : _formCountry.Trim();
                    existing.SyncIntervalHours = _formSyncIntervalHours > 0 ? _formSyncIntervalHours : 6;
                    existing.IsEnabled = _formIsEnabled;

                    await FeedSourceRepository.UpdateAsync(existing);
                    SetFeedback($"Fuente '{existing.StoreName}' actualizada con éxito.");
                }
            }
            else
            {
                var newSource = new AffiliateFeedSource(
                    _formStoreName,
                    _formFeedUrl,
                    _formFormat,
                    _formAffiliateTag,
                    _formCountry,
                    _formSyncIntervalHours)
                {
                    IsEnabled = _formIsEnabled
                };

                await FeedSourceRepository.AddAsync(newSource);
                SetFeedback($"Fuente '{newSource.StoreName}' registrada con éxito.");
            }

            ResetForm();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            SetFeedback($"Error al guardar la fuente: {ex.Message}", isError: true);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ToggleSourceEnabledAsync(AffiliateFeedSource source)
    {
        try
        {
            source.IsEnabled = !source.IsEnabled;
            await FeedSourceRepository.UpdateAsync(source);
            SetFeedback($"Fuente '{source.StoreName}' {(source.IsEnabled ? "activada" : "pausada")}.");
        }
        catch (Exception ex)
        {
            SetFeedback($"Error al alternar estado: {ex.Message}", isError: true);
        }
    }

    private async Task DeleteSourceAsync(Guid id)
    {
        try
        {
            await FeedSourceRepository.DeleteAsync(id);
            SetFeedback("Fuente de catálogo eliminada.");
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            SetFeedback($"Error al eliminar fuente: {ex.Message}", isError: true);
        }
    }

    private async Task SyncFeedAsync(Guid feedId)
    {
        _syncingSourceId = feedId;
        try
        {
            var result = await FeedSyncService.SyncFeedSourceByIdAsync(feedId);
            if (result.Success)
            {
                SetFeedback($"Sincronización de '{result.StoreName}' completada: {result.ItemsRead} productos leídos, {result.MatchedCount} ofertas enlazadas.");
            }
            else
            {
                SetFeedback($"Fallo en sincronización de '{result.StoreName}': {result.ErrorMessage}", isError: true);
            }
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            SetFeedback($"Error en sincronización: {ex.Message}", isError: true);
        }
        finally
        {
            _syncingSourceId = null;
        }
    }

    private async Task SyncAllActiveAsync()
    {
        _isSyncingAll = true;
        try
        {
            var results = await FeedSyncService.SyncAllActiveFeedsAsync();
            var successCount = results.Count(r => r.Success);
            var totalMatched = results.Sum(r => r.MatchedCount);
            SetFeedback($"Sincronización global finalizada: {successCount}/{results.Count} feeds exitosos, {totalMatched} ofertas totales enlazadas.");
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            SetFeedback($"Error en sincronización masiva: {ex.Message}", isError: true);
        }
        finally
        {
            _isSyncingAll = false;
        }
    }

    private async Task PromoteDiscrepancyAsync(AffiliateEanDiscrepancyLog discrepancy)
    {
        _isProcessingDiscrepancy = true;
        try
        {
            var game = await GameRepository.GetByIdAsync(discrepancy.GameId);
            if (game != null)
            {
                var oldEan = game.Ean;
                var currentBarcodes = game.AdditionalBarcodes.ToList();

                if (!string.IsNullOrEmpty(oldEan) && !currentBarcodes.Contains(oldEan))
                {
                    currentBarcodes.Add(oldEan);
                }

                game.UpdateEan(discrepancy.FeedEan);
                game.UpdateAdditionalBarcodes(currentBarcodes);
                await GameRepository.UpdateAsync(game);

                var userName = !string.IsNullOrWhiteSpace(CurrentUserService.UserName)
                    ? CurrentUserService.UserName
                    : (!string.IsNullOrWhiteSpace(CurrentUserService.UserId) ? CurrentUserService.UserId : "Moderador");
                discrepancy.MarkResolved($"Promovido a EAN principal por {userName}");
                await DiscrepancyRepository.UpdateAsync(discrepancy);

                SetFeedback($"Código EAN '{discrepancy.FeedEan}' promovido a principal para '{game.SpanishTitle}'. El EAN previo se conservó en códigos adicionales.");
                await LoadDataAsync();
            }
            else
            {
                SetFeedback("No se encontró el juego en catálogo.", isError: true);
            }
        }
        catch (Exception ex)
        {
            SetFeedback($"Error al promover EAN: {ex.Message}", isError: true);
        }
        finally
        {
            _isProcessingDiscrepancy = false;
        }
    }

    private async Task DismissDiscrepancyAsync(AffiliateEanDiscrepancyLog discrepancy)
    {
        _isProcessingDiscrepancy = true;
        try
        {
            var userName = !string.IsNullOrWhiteSpace(CurrentUserService.UserName)
                ? CurrentUserService.UserName
                : (!string.IsNullOrWhiteSpace(CurrentUserService.UserId) ? CurrentUserService.UserId : "Moderador");
            discrepancy.MarkResolved($"Descartado por {userName}");
            await DiscrepancyRepository.UpdateAsync(discrepancy);

            SetFeedback("Discrepancia descartada.");
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            SetFeedback($"Error al descartar discrepancia: {ex.Message}", isError: true);
        }
        finally
        {
            _isProcessingDiscrepancy = false;
        }
    }

    private static string FormatSyncDate(DateTimeOffset date)
    {
        var now = DateTimeOffset.UtcNow;
        if (date.Date == now.Date)
        {
            return $"Hoy {date:HH:mm}";
        }
        if (date.Date == now.Date.AddDays(-1))
        {
            return $"Ayer {date:HH:mm}";
        }
        return date.ToString("dd/MM HH:mm");
    }

    private void SetFeedback(string message, bool isError = false)
    {
        _feedbackMessage = message;
        _isFeedbackError = isError;
    }

    private static string GetFormatDisplayName(FeedFormat format) => format switch
    {
        FeedFormat.GoogleShoppingXml => "Google Shopping XML",
        FeedFormat.ShopifyJson => "Shopify JSON",
        FeedFormat.GenericCsv => "CSV Genérico",
        _ => format.ToString()
    };
}
