@page "/clasificaciones"
@using Ludeka.Application.Contracts
@using Ludeka.Application.DTOs
@inject ILeaderboardService LeaderboardService
@inject ICurrentUserService CurrentUserService
@inject NavigationManager Navigation

<PageTitle>Clasificación Mensual de Jugadores — Ludeka</PageTitle>

@* HERO CIRUELA EDITORIAL (INC-125) *@
<section data-screen-label="Clasificación" class="bg-[var(--plum)] text-[#FFF8EE] font-sans">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-8 lg:px-12 py-8 sm:py-14 pb-10 sm:pb-16 grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-end">
        <div class="flex flex-col gap-5">
            <span class="text-xs sm:text-[13px] font-extrabold uppercase tracking-[0.18em] text-[var(--plum-soft)]">
                Comunidad · Actividad en mesa
            </span>
            <h1 class="m-0 text-[54px] sm:text-[76px] lg:text-[96px] leading-[0.88] font-extrabold tracking-[-0.055em] text-[#FFF8EE]">
                Clasificación<br />
                <i class="text-[var(--mustard)] font-serif font-normal italic">mensual</i>
            </h1>
            <p class="m-0 text-base sm:text-[17px] leading-[1.5] max-w-[560px] opacity-90">
                Reconocimiento a los jugones más activos de la comunidad según sus partidas registradas en mesa durante el mes. Sin trampas, con opt-in voluntario y respeto estricto al anonimato.
            </p>
        </div>

        <div class="flex flex-col gap-3 items-start lg:items-end">
            <span class="text-xs font-extrabold uppercase tracking-[0.14em] text-[var(--plum-soft)]">
                Periodo · se reinicia cada mes natural
            </span>
            <div class="flex items-center gap-2 flex-wrap">
                <button type="button"
                        id="prev-month-btn"
                        @onclick="PreviousMonthAsync"
                        aria-label="Mes anterior"
                        class="w-12 h-12 rounded-full border-[1.5px] border-[#FFF8EE] bg-transparent text-[#FFF8EE] text-xl font-extrabold flex items-center justify-center hover:bg-[#FFF8EE]/10 transition-colors shadow-sm cursor-pointer">
                    ‹
                </button>

                <div class="min-w-[200px] h-12 px-6 rounded-full bg-[#FFF8EE] text-[#22180F] flex items-center justify-center font-extrabold text-base tracking-tight shadow-sm">
                    @(_leaderboard?.MonthLabel ?? $"{_selectedMonth:D2}/{_selectedYear}")
                </div>

                <button type="button"
                        id="next-month-btn"
                        @onclick="NextMonthAsync"
                        disabled="@IsCurrentOrFutureMonth"
                        aria-label="Mes siguiente"
                        class="w-12 h-12 rounded-full border-[1.5px] border-[#FFF8EE] bg-transparent text-[#FFF8EE] text-xl font-extrabold flex items-center justify-center hover:bg-[#FFF8EE]/10 transition-colors shadow-sm disabled:opacity-30 disabled:pointer-events-none cursor-pointer">
                    ›
                </button>

                @if (!IsCurrentMonth)
                {
                    <button type="button"
                            id="current-month-btn"
                            @onclick="GoToCurrentMonthAsync"
                            class="h-12 px-5 rounded-full text-xs font-extrabold bg-[#FFF8EE]/15 hover:bg-[#FFF8EE] hover:text-[#22180F] text-[#FFF8EE] border border-[#FFF8EE]/40 transition-colors shadow-sm cursor-pointer">
                        Mes actual
                    </button>
                }
            </div>
            <span class="text-xs sm:text-[13px] opacity-85">
                @(_leaderboard?.PeriodStart.ToString("d MMM") ?? "") – @(_leaderboard?.PeriodEnd.ToString("d MMM yyyy") ?? "")
            </span>
        </div>
    </div>
</section>

@* CUERPO PRINCIPAL EDITORIAL *@
<div class="max-w-[1280px] mx-auto px-4 sm:px-8 lg:px-12 py-8 pb-20 flex flex-col gap-11 font-sans">

    @* Banner de Estado y Consentimiento *@
    @if (HasSession)
    {
        @if (_leaderboard?.CurrentUserHasOptedIn == true)
        {
            <div class="p-4 sm:p-5 rounded-[18px] bg-[var(--p-mint)] text-[var(--ink)] border-2 border-[var(--rule)] flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-sm shadow-sm" role="status">
                <div class="flex items-center gap-2.5 font-bold">
                    <Icon Name="circle-check" Size="18" />
                    <span>
                        Estás participando en la clasificación de este mes.
                        @if (_leaderboard.CurrentUserRank.HasValue)
                        {
                            <strong> Tu posición actual es la #@_leaderboard.CurrentUserRank.</strong>
                        }
                        else
                        {
                            <span> Registra una partida en mesa este mes para aparecer en la tabla.</span>
                        }
                    </span>
                </div>
                <a href="/cuenta/privacidad" class="h-10 px-5 rounded-full bg-[var(--ink)] text-[var(--paper)] font-extrabold text-xs inline-flex items-center justify-center shrink-0 hover:opacity-90 transition-opacity">
                    Ajustes de privacidad
                </a>
            </div>
        }
        else
        {
            <div class="p-4 sm:p-5 rounded-[18px] bg-[var(--p-peach)] text-[var(--ink)] border-2 border-[var(--rule)] flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-sm shadow-sm" role="status">
                <div class="flex items-center gap-2.5 font-bold">
                    <Icon Name="eye-off" Size="18" />
                    <span>
                        Actualmente no apareces en la clasificación pública. Por privacidad, solo participan los jugadores que lo autorizan explícitamente.
                    </span>
                </div>
                <a href="/cuenta/privacidad" class="h-10 px-5 rounded-full bg-[var(--ink)] text-[var(--paper)] font-extrabold text-xs inline-flex items-center justify-center shrink-0 hover:opacity-90 transition-opacity">
                    Sumarme a la tabla
                </a>
            </div>
        }
    }
    else
    {
        <div class="p-4 sm:p-5 rounded-[18px] bg-[var(--paper-2)] text-[var(--ink)] border-2 border-[var(--rule)] flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-sm shadow-sm">
            <div class="flex items-center gap-2.5 font-bold">
                <Icon Name="info" Size="18" />
                <span>Inicia sesión para comprobar tu posición o sumarte a la clasificación de la comunidad.</span>
            </div>
            <a href="/login" class="h-10 px-5 rounded-full bg-[var(--ink)] text-[var(--paper)] font-extrabold text-xs inline-flex items-center justify-center shrink-0 hover:opacity-90 transition-opacity">
                Iniciar sesión
            </a>
        </div>
    }

    @* Banda de Estadísticas *@
    <div class="grid grid-cols-2 sm:grid-cols-3 border-t-[3px] border-[var(--rule)] border-b border-[var(--line)] py-5 gap-4">
        <div class="flex flex-col gap-1">
            <b class="text-3xl sm:text-[44px] font-extrabold tracking-[-0.04em] leading-none text-[var(--ink)]">
                @(_leaderboard?.TotalParticipants ?? 0)
            </b>
            <span class="text-xs font-extrabold uppercase tracking-[0.1em] text-[var(--muted)]">
                Jugadores en tabla
            </span>
        </div>
        <div class="flex flex-col gap-1">
            <b class="text-3xl sm:text-[44px] font-extrabold tracking-[-0.04em] leading-none text-[var(--ink)]">
                @(_leaderboard?.TotalPlaysLogged ?? 0)
            </b>
            <span class="text-xs font-extrabold uppercase tracking-[0.1em] text-[var(--muted)]">
                Partidas en mesa
            </span>
        </div>
        <div class="col-span-2 sm:col-span-1 flex flex-col gap-1 justify-center">
            <b class="text-lg sm:text-2xl font-extrabold tracking-[-0.02em] text-[var(--ink)]">
                @(_leaderboard?.PeriodStart.ToString("d MMM") ?? "") – @(_leaderboard?.PeriodEnd.ToString("d MMM") ?? "")
            </b>
            <span class="text-xs font-extrabold uppercase tracking-[0.1em] text-[var(--muted)]">
                Ventana de cómputo
            </span>
        </div>
    </div>

    @* Podio de Honor Top 3 *@
    @if (_leaderboard != null && _leaderboard.Entries.Count > 0)
    {
        var topEntries = _leaderboard.Entries.Take(3).ToList();

        <section class="flex flex-col gap-5" aria-label="Podio de honor">
            <div class="flex items-baseline gap-4">
                <span class="text-xs sm:text-[13px] font-extrabold uppercase tracking-[0.18em] text-[var(--accent)]">
                    Podio de honor
                </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-5 items-end">
                @for (int i = 0; i < topEntries.Count; i++)
                {
                    var entry = topEntries[i];
                    string medalColor = entry.Rank switch
                    {
                        1 => "var(--mustard)",
                        2 => "var(--silver)",
                        _ => "var(--bronze)"
                    };
                    string cardHeight = entry.Rank switch
                    {
                        1 => "md:min-h-[300px]",
                        2 => "md:min-h-[270px]",
                        _ => "md:min-h-[250px]"
                    };

                    <div class="p-6 rounded-[24px] bg-[var(--card)] border-[3px] shadow-[0_12px_24px_var(--shadow)] flex flex-col gap-3 justify-between @cardHeight"
                         style="border-color: @medalColor;">
                        <b class="text-[72px] sm:text-[84px] leading-[0.8] tracking-[-0.06em] font-extrabold" style="color: @medalColor;">
                            @($"{entry.Rank:D2}")
                        </b>

                        <div class="flex flex-col gap-2 mt-auto">
                            @if (!entry.IsAnonymous && !string.IsNullOrWhiteSpace(entry.PublicProfileUrl))
                            {
                                <a href="@entry.PublicProfileUrl" class="text-xl sm:text-[22px] font-extrabold tracking-[-0.025em] leading-[1.15] text-[var(--ink)] hover:text-[var(--brand)] transition-colors">
                                    @entry.DisplayName
                                </a>
                            }
                            else
                            {
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="font-mono text-xl font-extrabold text-[var(--ink)]">@entry.DisplayName</span>
                                </div>
                            }

                            <div class="flex flex-wrap gap-1.5 items-center">
                                @if (entry.IsAnonymous)
                                {
                                    <span class="px-2.5 py-0.5 rounded-full bg-[var(--p-peach)] text-[var(--ink)] text-[11px] font-extrabold">
                                        Anónimo
                                    </span>
                                }
                                @if (_leaderboard.CurrentUserRank.HasValue && _leaderboard.CurrentUserRank.Value == entry.Rank)
                                {
                                    <span class="px-2.5 py-0.5 rounded-full bg-[var(--mustard)] text-[#22180F] text-[11px] font-extrabold">
                                        Tú
                                    </span>
                                }
                                @if (!string.IsNullOrWhiteSpace(entry.BadgeName))
                                {
                                    <span class="px-2.5 py-0.5 rounded-full bg-[var(--p-pink)] text-[var(--ink)] text-[11px] font-extrabold">
                                        @entry.BadgeName
                                    </span>
                                }
                                @if (!entry.IsAnonymous && !string.IsNullOrWhiteSpace(entry.Country))
                                {
                                    <span class="text-xs text-[var(--muted)]">
                                        @entry.Country
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="flex gap-6 pt-3 border-t border-[var(--line)]">
                            <span class="flex flex-col">
                                <b class="text-2xl sm:text-[26px] font-extrabold text-[var(--ink)] leading-none">@entry.TotalPlaysThisMonth</b>
                                <span class="text-[11px] font-extrabold uppercase tracking-wider text-[var(--muted)] mt-1">Partidas</span>
                            </span>
                            <span class="flex flex-col">
                                <b class="text-2xl sm:text-[26px] font-extrabold text-[var(--ink)] leading-none">@entry.UnlockedMilestonesCount</b>
                                <span class="text-[11px] font-extrabold uppercase tracking-wider text-[var(--muted)] mt-1">Hitos</span>
                            </span>
                        </div>
                    </div>
                }
            </div>
        </section>

        @* Tabla Completa Accesible *@
        <section class="flex flex-col gap-4" aria-label="Tabla de clasificación">
            <div class="flex justify-between items-baseline border-b-[3px] border-[var(--rule)] pb-3">
                <h2 class="m-0 text-2xl sm:text-[36px] font-extrabold tracking-[-0.04em] text-[var(--ink)]">
                    Tabla completa
                </h2>
                <span class="text-sm font-extrabold text-[var(--muted)]">
                    @_leaderboard.Entries.Count @(_leaderboard.Entries.Count == 1 ? "jugador" : "jugadores")
                </span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm" aria-label="Clasificación de jugadores">
                    <thead class="text-xs uppercase font-extrabold tracking-wider text-[var(--muted)] border-b border-[var(--line)]">
                        <tr>
                            <th scope="col" class="py-3 px-3 w-16">#</th>
                            <th scope="col" class="py-3 px-3">Jugador / Mesa</th>
                            <th scope="col" class="py-3 px-3 text-center">Partidas en mesa</th>
                            <th scope="col" class="py-3 px-3 text-center">Hitos</th>
                            <th scope="col" class="py-3 px-3">Distintivo</th>
                            <th scope="col" class="py-3 px-3 text-right">País</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[var(--line)]">
                        @foreach (var entry in _leaderboard.Entries)
                        {
                            bool isCurrent = _leaderboard.CurrentUserRank.HasValue && _leaderboard.CurrentUserRank.Value == entry.Rank;
                            string rowBg = isCurrent ? "bg-[var(--p-mint)]" : "transparent";
                            string rankColor = entry.Rank switch
                            {
                                1 => "color: var(--mustard)",
                                2 => "color: var(--silver)",
                                3 => "color: var(--bronze)",
                                _ => "color: var(--muted)"
                            };

                            <tr class="@rowBg transition-colors" style="@(isCurrent ? "border-radius: 12px;" : "")">
                                <td class="py-3.5 px-3 font-extrabold text-lg sm:text-xl tracking-tight" style="@rankColor">
                                    @($"{entry.Rank:D2}")
                                </td>
                                <td class="py-3.5 px-3">
                                    <div class="flex items-center gap-2 flex-wrap">
                                        @if (!entry.IsAnonymous && !string.IsNullOrWhiteSpace(entry.PublicProfileUrl))
                                        {
                                            <a href="@entry.PublicProfileUrl" class="font-extrabold text-base text-[var(--ink)] hover:text-[var(--brand)] transition-colors">
                                                @entry.DisplayName
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="font-mono font-bold text-base text-[var(--ink)]">@entry.DisplayName</span>
                                            <span class="px-2 py-0.5 rounded-full bg-[var(--p-peach)] text-[var(--ink)] text-[11px] font-extrabold">
                                                Anónimo
                                            </span>
                                        }

                                        @if (isCurrent)
                                        {
                                            <span class="px-2 py-0.5 rounded-full bg-[var(--mustard)] text-[#22180F] text-[11px] font-extrabold">
                                                Tú
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="py-3.5 px-3 text-center font-extrabold text-base text-[var(--ink)]">
                                    @entry.TotalPlaysThisMonth partidas
                                </td>
                                <td class="py-3.5 px-3 text-center font-bold text-sm text-[var(--muted)]">
                                    @entry.UnlockedMilestonesCount hitos
                                </td>
                                <td class="py-3.5 px-3">
                                    @if (!string.IsNullOrWhiteSpace(entry.BadgeName))
                                    {
                                        <span class="px-2 py-0.5 rounded-full bg-[var(--p-pink)] text-[var(--ink)] text-[11px] font-extrabold inline-flex items-center gap-1">
                                            @entry.BadgeName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-[var(--muted)]">&mdash;</span>
                                    }
                                </td>
                                <td class="py-3.5 px-3 text-right text-xs text-[var(--muted)]">
                                    @if (!entry.IsAnonymous && !string.IsNullOrWhiteSpace(entry.Country))
                                    {
                                        <span>@entry.Country</span>
                                    }
                                    else
                                    {
                                        <span class="font-mono">Reservado</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
    else
    {
        @* Estado Vacío *@
        <div class="p-12 rounded-[24px] bg-[var(--paper-2)] border-2 border-[var(--rule)] text-center space-y-4" role="region" aria-label="Sin datos">
            <div class="w-16 h-16 rounded-2xl bg-[var(--card)] border border-[var(--line)] text-[var(--accent)] flex items-center justify-center mx-auto shadow-sm">
                <Icon Name="dices" Size="32" />
            </div>
            <div class="space-y-1 max-w-md mx-auto">
                <h2 class="text-2xl font-extrabold text-[var(--ink)] tracking-tight">Mesa vacía en este periodo</h2>
                <p class="text-sm text-[var(--muted)] leading-relaxed">
                    Aún no hay partidas registradas en mesa durante este mes por jugadores con consentimiento de clasificación activo.
                </p>
            </div>
            @if (HasSession)
            {
                <a href="/cuenta/ludoteca" class="h-11 px-6 rounded-full bg-[var(--brand)] text-[var(--on-brand)] font-extrabold text-sm inline-flex items-center justify-center gap-2 hover:opacity-90 transition-opacity shadow-sm">
                    <Icon Name="plus" Size="14" />
                    <span>Registrar una partida en mi ludoteca</span>
                </a>
            }
        </div>
    }

    @* Reglas de Mesa y Privacidad *@
    <div class="p-6 sm:p-8 rounded-[24px] bg-[var(--paper-2)] border-2 border-[var(--rule)] flex flex-col gap-4">
        <span class="text-xs font-extrabold uppercase tracking-[0.14em] text-[var(--muted)]">
            Reglas de mesa · Privacidad y transparencia
        </span>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-sm text-[var(--muted)] leading-relaxed">
            <div class="flex flex-col gap-1.5">
                <b class="text-base text-[var(--ink)] font-extrabold">1. Opt-in obligatorio</b>
                <span>Nadie entra en las clasificaciones por defecto. Solo participas si lo activas expresamente desde tus ajustes.</span>
            </div>
            <div class="flex flex-col gap-1.5">
                <b class="text-base text-[var(--ink)] font-extrabold">2. Anonimato real</b>
                <span>El modo anónimo oculta avatar, país y enlace a tu perfil, generando un seudónimo determinista no reversible.</span>
            </div>
            <div class="flex flex-col gap-1.5">
                <b class="text-base text-[var(--ink)] font-extrabold">3. Ventana mensual</b>
                <span>Las clasificaciones premian la actividad lúdica del mes en curso y se reinician puntualmente sin fosilizar puestos.</span>
            </div>
        </div>
    </div>
</div>

@code {
    private int _selectedYear;
    private int _selectedMonth;
    private MonthlyLeaderboardDto? _leaderboard;

    private bool HasSession => !string.IsNullOrWhiteSpace(CurrentUserService.UserId);

    private bool IsCurrentMonth =>
        _selectedYear == DateTime.UtcNow.Year && _selectedMonth == DateTime.UtcNow.Month;

    private bool IsCurrentOrFutureMonth
    {
        get
        {
            var now = DateTime.UtcNow;
            if (_selectedYear > now.Year) return true;
            if (_selectedYear == now.Year && _selectedMonth >= now.Month) return true;
            return false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var now = DateTime.UtcNow;
        _selectedYear = now.Year;
        _selectedMonth = now.Month;

        await LoadLeaderboardAsync();
    }

    private async Task PreviousMonthAsync()
    {
        if (_selectedMonth == 1)
        {
            _selectedMonth = 12;
            _selectedYear--;
        }
        else
        {
            _selectedMonth--;
        }

        await LoadLeaderboardAsync();
    }

    private async Task NextMonthAsync()
    {
        if (IsCurrentOrFutureMonth) return;

        if (_selectedMonth == 12)
        {
            _selectedMonth = 1;
            _selectedYear++;
        }
        else
        {
            _selectedMonth++;
        }

        await LoadLeaderboardAsync();
    }

    private async Task GoToCurrentMonthAsync()
    {
        var now = DateTime.UtcNow;
        _selectedYear = now.Year;
        _selectedMonth = now.Month;

        await LoadLeaderboardAsync();
    }

    private async Task LoadLeaderboardAsync()
    {
        _leaderboard = await LeaderboardService.GetMonthlyLeaderboardAsync(_selectedYear, _selectedMonth, CurrentUserService.UserId);
    }
}
