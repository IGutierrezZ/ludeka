@page "/editoriales/{Slug}"
@rendermode InteractiveServer
@using Ludeka.Application.Contracts
@using Ludeka.Application.DTOs
@using Ludeka.Core.Enums
@using Ludeka.Web.Components.Shared
@inject IPublisherService PublisherService
@inject ICurrentUserService CurrentUserService
@inject NavigationManager Navigation

<PageTitle>@(_publisher != null ? $"{_publisher.Name} — Catálogo Editorial" : "Editorial") — Ludeka</PageTitle>

@if (_loading)
{
    <div class="container-ludeka py-16 text-center text-sm text-[var(--text-secondary)] flex items-center justify-center gap-2">
        <span class="animate-spin inline-block"><Icon Name="dices" Size="20" /></span>
        <span>Cargando ficha editorial...</span>
    </div>
}
else if (_publisher == null)
{
    <div class="container-ludeka py-16 text-center space-y-4">
        <span class="inline-block"><Icon Name="search" Size="36" /></span>
        <h1 class="text-2xl font-black text-[var(--text-primary)]">Editorial no encontrada</h1>
        <p class="text-sm text-[var(--text-secondary)] max-w-md mx-auto">
            No encontramos ninguna editorial registrada con el slug especificado.
        </p>
        <a href="/editoriales" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-[var(--brand-primary)] text-white text-xs font-bold">
            &larr; Volver al Directorio
        </a>
    </div>
}
else
{
    <div class="container-ludeka py-8 space-y-8">
        @* Navegación y Acciones Superiores *@
        <div class="flex items-center justify-between gap-4 flex-wrap">
            <a href="/editoriales" class="text-xs font-bold text-[var(--text-secondary)] hover:text-[var(--text-primary)] inline-flex items-center gap-1 transition-colors">
                &larr; Volver al Directorio de Editoriales
            </a>

            @if (CurrentUserService.IsFoundingTeam || (CurrentUserService.IsInRole("Moderator") && CurrentUserService.HasPermission(ModeratorPermission.CanManagePublishers)))
            {
                <button type="button"
                        @onclick="() => _isEditModalOpen = true"
                        class="px-3.5 py-1.5 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 font-bold text-xs transition-colors flex items-center gap-1.5 shadow-sm">
                    <Icon Name="pencil" Size="12" /> Editar Editorial
                </button>
            }
        </div>

        @* Hero Editorial *@
        <div class="p-6 sm:p-8 rounded-3xl bg-[var(--bg-card)] border border-[var(--border-subtle)] shadow-sm space-y-6">
            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6">
                @if (!string.IsNullOrWhiteSpace(_publisher.LogoUrl))
                {
                    <img src="@_publisher.LogoUrl"
                         alt="Logotipo de @_publisher.Name"
                         class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl object-contain bg-[var(--bg-surface-elevated)] p-2 border border-[var(--border-subtle)] shrink-0"
                         onerror="this.onerror=null; this.src='/images/game-placeholder.svg';" />
                }
                else
                {
                    <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl bg-[var(--brand-primary)]/10 border border-[var(--brand-primary)]/20 flex items-center justify-center text-3xl text-[var(--brand-primary)] font-black shrink-0">
                        @_publisher.Name[..Math.Min(2, _publisher.Name.Length)].ToUpper()
                    </div>
                }

                <div class="space-y-2 flex-1">
                    <div class="flex items-center gap-2 flex-wrap">
                        <span class="px-2.5 py-0.5 rounded-full bg-[var(--brand-primary)]/15 text-[var(--brand-primary)] border border-[var(--brand-primary)]/30 text-xs font-black">
                            <Icon Name="building-2" Size="12" /> Editorial Oficial
                        </span>
                        <span class="text-xs font-bold text-[var(--text-secondary)] inline-flex items-center gap-1">
                            <Icon Name="map-pin" Size="12" /> @_publisher.Country @(!string.IsNullOrWhiteSpace(_publisher.City) ? $"({_publisher.City})" : "")
                        </span>
                        <LikeButton TargetType="LikeTargetType.Publisher"
                                    TargetId="@_publisher.Id"
                                    InitialLikesCount="@_publisher.LikesCount"
                                    OnLikesCountChanged="(cnt) => _publisher = _publisher with { LikesCount = cnt }" />
                    </div>

                    <h1 class="text-2xl sm:text-4xl font-black text-[var(--text-primary)] tracking-tight">
                        @_publisher.Name
                    </h1>

                    @if (!string.IsNullOrWhiteSpace(_publisher.WebsiteUrl))
                    {
                        <a href="@_publisher.WebsiteUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="text-xs font-semibold text-[var(--brand-primary)] hover:underline inline-flex items-center gap-1">
                            <Icon Name="globe" Size="12" /> Sitio web oficial &nearr;
                        </a>
                    }
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_publisher.Description))
            {
                <div class="pt-4 border-t border-[var(--border-subtle)] text-sm text-[var(--text-secondary)] leading-relaxed space-y-2">
                    <h2 class="text-xs font-bold uppercase tracking-wider text-[var(--text-muted)]">Sobre la editorial</h2>
                    <p>@((MarkupString)_publisher.Description.Replace("\n", "<br />"))</p>
                </div>
            }

            @* Redes y Foco Audiovisual *@
            @if (_publisher.SocialLinks != null && _publisher.SocialLinks.Count > 0)
            {
                <div class="pt-4 border-t border-[var(--border-subtle)] space-y-2">
                    <h2 class="text-xs font-bold uppercase tracking-wider text-[var(--text-muted)]">Canales oficiales y redes sociales</h2>
                    <SocialLinksList Links="@_publisher.SocialLinks" />
                </div>
            }
        </div>

        @* Catálogo publicado en Ludeka *@
        <div class="space-y-4">
            <div class="flex items-baseline justify-between gap-2 border-b border-[var(--border-subtle)] pb-3">
                <div class="flex items-center gap-2">
                    <Icon Name="dices" Size="20" />
                    <h2 class="text-xl font-black text-[var(--text-primary)]">
                        Catálogo de @_publisher.Name en Ludeka
                    </h2>
                </div>
                <span class="text-xs font-bold text-[var(--text-secondary)]">
                    @_publisher.Games.Count @(_publisher.Games.Count == 1 ? "juego registrado" : "juegos registrados")
                </span>
            </div>

            @if (_publisher.Games.Count == 0)
            {
                <div class="p-8 text-center rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] text-xs text-[var(--text-muted)]">
                    Actualmente no hay juegos vinculados a esta editorial en el catálogo activo de Ludeka.
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                    @foreach (var game in _publisher.Games)
                    {
                        <GameCard Game="@game" />
                    }
                </div>
            }
        </div>
    </div>

    @* Modal de Edición *@
    <PublisherEditModal
        IsOpen="@_isEditModalOpen"
        PublisherId="@_publisher.Id"
        Name="@_publisher.Name"
        Country="@_publisher.Country"
        City="@_publisher.City"
        Description="@_publisher.Description"
        LogoUrl="@_publisher.LogoUrl"
        WebsiteUrl="@_publisher.WebsiteUrl"
        InitialSocialLinks="@(_publisher.SocialLinks?.ToList() ?? new())"
        OnClose="() => _isEditModalOpen = false"
        OnSaved="LoadPublisherAsync" />
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private bool _loading = true;
    private PublisherDetailDto? _publisher;
    private bool _isEditModalOpen = false;

    protected override async Task OnParametersSetAsync()
    {
        await LoadPublisherAsync();
    }

    private async Task LoadPublisherAsync()
    {
        _loading = true;
        _publisher = await PublisherService.GetBySlugAsync(Slug);
        _loading = false;
    }
}
