@page "/editoriales/{Slug}"
@rendermode InteractiveServer
@using Ludeka.Application.Contracts
@using Ludeka.Application.DTOs
@using Ludeka.Core.Enums
@using Ludeka.Web.Components.Shared
@inject IPublisherService PublisherService
@inject ICurrentUserService CurrentUserService
@inject NavigationManager Navigation

<PageTitle>@(_publisher != null ? $"{_publisher.Name} — Catálogo Editorial" : "Editorial") — Ludeka</PageTitle>

@if (_loading)
{
    <div class="max-w-[1280px] mx-auto px-4 sm:px-8 py-20 text-center text-sm text-[var(--muted)] flex items-center justify-center gap-2">
        <span class="animate-spin inline-block"><Icon Name="dices" Size="22" /></span>
        <span>Cargando ficha editorial...</span>
    </div>
}
else if (_publisher == null)
{
    <div class="max-w-md mx-auto my-20 p-8 rounded-[24px] bg-[var(--paper-2)] border-2 border-[var(--rule)] text-center space-y-4">
        <span class="inline-block text-[var(--muted)]"><Icon Name="search" Size="36" /></span>
        <h1 class="text-2xl font-extrabold text-[var(--ink)]">Editorial no encontrada</h1>
        <p class="text-sm text-[var(--muted)]">
            No encontramos ninguna editorial registrada con el slug especificado.
        </p>
        <a href="/editoriales" class="h-11 px-5 rounded-full bg-[var(--brand)] text-[var(--on-brand)] font-extrabold text-xs inline-flex items-center gap-2 hover:opacity-90 shadow-sm">
            &larr; Volver al Directorio
        </a>
    </div>
}
else
{
    @* Retroceso a Directorio *@
    <div class="max-w-[1280px] mx-auto px-4 sm:px-8 lg:px-12 pt-6 text-xs sm:text-[13px] font-extrabold text-[var(--muted)] font-sans">
        <a href="/editoriales" class="hover:text-[var(--ink)] transition-colors inline-flex items-center gap-1">
            &larr; Todas las editoriales
        </a>
    </div>

    @* FICHA DE DIRECTORIO HERO (INC-125) *@
    <section data-screen-label="Ficha de directorio" class="max-w-[1280px] mx-auto px-4 sm:px-8 lg:px-12 py-6 sm:py-10 flex flex-wrap gap-8 items-end font-sans">
        @if (!string.IsNullOrWhiteSpace(_publisher.LogoUrl))
        {
            <div class="w-28 h-28 sm:w-36 sm:h-36 rounded-[28px] bg-[var(--p-blue)] p-3 border border-[var(--line)] shadow-[0_12px_24px_var(--shadow)] -rotate-4 shrink-0 flex items-center justify-center">
                <img src="@_publisher.LogoUrl"
                     alt="Logo de @_publisher.Name"
                     class="max-w-full max-h-full object-contain"
                     onerror="this.onerror=null; this.src='/images/game-placeholder.svg';" />
            </div>
        }
        else
        {
            <div class="w-28 h-28 sm:w-36 sm:h-36 rounded-[28px] bg-[var(--p-blue)] text-[var(--ink)] border border-[var(--line)] flex items-center justify-center text-4xl sm:text-6xl font-extrabold tracking-[-0.04em] shadow-[0_12px_24px_var(--shadow)] -rotate-4 shrink-0">
                @_publisher.Name[..Math.Min(2, _publisher.Name.Length)].ToUpper()
            </div>
        }

        <div class="flex-1 min-w-[280px] sm:min-w-[360px] flex flex-col gap-3">
            <span class="text-xs sm:text-[13px] font-extrabold uppercase tracking-[0.18em] text-[var(--accent)] inline-flex items-center gap-1.5">
                <Icon Name="building-2" Size="14" />
                <span>Editorial · @_publisher.Country</span>
            </span>
            <h1 class="m-0 text-4xl sm:text-6xl lg:text-[76px] leading-[0.88] font-extrabold tracking-[-0.06em] text-[var(--ink)] text-balance">
                @_publisher.Name
            </h1>

            @if (!string.IsNullOrWhiteSpace(_publisher.Description))
            {
                <p class="m-0 text-base sm:text-[17px] leading-relaxed text-[var(--muted)] max-w-2xl">
                    @_publisher.Description
                </p>
            }

            <div class="flex flex-wrap gap-2 items-center pt-1">
                <span class="px-3 py-1 rounded-full bg-[var(--paper-2)] border border-[var(--line)] text-xs font-extrabold text-[var(--ink)] inline-flex items-center gap-1">
                    <Icon Name="map-pin" Size="12" />
                    <span>@_publisher.Country @(!string.IsNullOrWhiteSpace(_publisher.City) ? $"({_publisher.City})" : "")</span>
                </span>
                <span class="px-3 py-1 rounded-full bg-[var(--paper-2)] border border-[var(--line)] text-xs font-extrabold text-[var(--ink)]">
                    @_publisher.Games.Count @(_publisher.Games.Count == 1 ? "título en catálogo" : "títulos en catálogo")
                </span>
            </div>

            @if (_publisher.SocialLinks != null && _publisher.SocialLinks.Count > 0)
            {
                <div class="pt-1">
                    <SocialLinksList Links="@_publisher.SocialLinks" />
                </div>
            }
        </div>

        <div class="flex items-center gap-3 flex-wrap">
            @if (!string.IsNullOrWhiteSpace(_publisher.WebsiteUrl))
            {
                <a href="@_publisher.WebsiteUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="h-12 px-6 rounded-full bg-[var(--brand)] text-[var(--on-brand)] font-extrabold text-sm inline-flex items-center gap-2 hover:opacity-90 shadow-sm transition-opacity">
                    <Icon Name="globe" Size="16" />
                    <span>Web oficial</span>
                    <span>&nearr;</span>
                </a>
            }

            <LikeButton TargetType="LikeTargetType.Publisher"
                        TargetId="@_publisher.Id"
                        InitialLikesCount="@_publisher.LikesCount"
                        OnLikesCountChanged="(cnt) => _publisher = _publisher with { LikesCount = cnt }" />

            @if (CurrentUserService.IsFoundingTeam || (CurrentUserService.IsInRole("Moderator") && CurrentUserService.HasPermission(ModeratorPermission.CanManagePublishers)))
            {
                <button type="button"
                        @onclick="() => _isEditModalOpen = true"
                        class="h-12 px-5 rounded-full bg-[var(--card)] text-[var(--ink)] border-2 border-[var(--rule)] font-extrabold text-xs inline-flex items-center gap-1.5 hover:bg-[var(--paper-2)] transition-colors shadow-sm cursor-pointer">
                    <Icon Name="pencil" Size="14" />
                    <span>Editar</span>
                </button>
            }
        </div>
    </section>

    @* CATÁLOGO EN LUDEKA *@
    <section class="max-w-[1280px] mx-auto px-4 sm:px-8 lg:px-12 py-8 pb-24 flex flex-col gap-6 font-sans">
        <div class="flex justify-between items-baseline gap-4 border-b-[3px] border-[var(--rule)] pb-3">
            <h2 class="m-0 text-2xl sm:text-[36px] font-extrabold tracking-[-0.04em] text-[var(--ink)]">
                Catálogo en Ludeka
            </h2>
            <span class="text-sm font-extrabold text-[var(--muted)]">
                @_publisher.Games.Count @(_publisher.Games.Count == 1 ? "juego" : "juegos")
            </span>
        </div>

        @if (_publisher.Games.Count == 0)
        {
            <div class="p-12 text-center rounded-[24px] bg-[var(--paper-2)] border-2 border-[var(--rule)] text-sm text-[var(--muted)]">
                Actualmente no hay juegos vinculados a esta editorial en el catálogo activo de Ludeka.
            </div>
        }
        else
        {
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6 sm:gap-8 pt-2">
                @foreach (var game in _publisher.Games)
                {
                    <GameCard Game="@game" />
                }
            </div>
        }
    </section>

    @* Modal de Edición *@
    <PublisherEditModal
        IsOpen="@_isEditModalOpen"
        PublisherId="@_publisher.Id"
        Name="@_publisher.Name"
        Country="@_publisher.Country"
        City="@_publisher.City"
        Description="@_publisher.Description"
        LogoUrl="@_publisher.LogoUrl"
        WebsiteUrl="@_publisher.WebsiteUrl"
        InitialSocialLinks="@(_publisher.SocialLinks?.ToList() ?? new())"
        OnClose="() => _isEditModalOpen = false"
        OnSaved="LoadPublisherAsync" />
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private bool _loading = true;
    private PublisherDetailDto? _publisher;
    private bool _isEditModalOpen = false;

    protected override async Task OnParametersSetAsync()
    {
        await LoadPublisherAsync();
    }

    private async Task LoadPublisherAsync()
    {
        _loading = true;
        _publisher = await PublisherService.GetBySlugAsync(Slug);
        _loading = false;
    }
}
