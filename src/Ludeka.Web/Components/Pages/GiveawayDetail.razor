@page "/sorteos/{Id:guid}"
@page "/sorteo/{Id:guid}"
@rendermode InteractiveServer
@using System.IO
@using Ludeka.Application.Contracts
@using Ludeka.Application.DTOs
@using Ludeka.Core.Entities
@using Ludeka.Core.Enums
@using Ludeka.Core.ValueObjects
@using Ludeka.Web.Components.Shared
@inject IGiveawayService GiveawayService
@inject IImageStorageService ImageStorageService
@inject ICurrentUserService CurrentUserService
@inject IGameRepository GameRepository
@inject NavigationManager Navigation
@inject ILogger<GiveawayDetail> Logger

<PageTitle>@(_giveaway != null ? $"{_giveaway.Title} — Ficha del Sorteo | Ludeka" : "Sorteo no encontrado — Ludeka")</PageTitle>

@if (_isLoading)
{
    <div class="py-24 text-center text-[var(--muted)]">
        <div class="inline-block animate-spin text-[var(--brand)] mb-3">
            <Icon Name="dices" Size="40" />
        </div>
        <p class="text-base font-semibold">Cargando ficha del sorteo...</p>
    </div>
}
else if (_giveaway == null)
{
    <div class="py-20 text-center max-w-lg mx-auto px-4">
        <span class="inline-block mb-4 text-[var(--muted)]">
            <Icon Name="radar" Size="44" />
        </span>
        <h1 class="text-3xl font-black text-[var(--ink)] mb-2">Sorteo no encontrado</h1>
        <p class="text-sm text-[var(--muted)] mb-6">
            El sorteo que buscas no existe o ha sido retirado de nuestra plataforma.
        </p>
        <a href="/sorteos" class="h-11 px-6 rounded-full bg-[var(--brand)] text-[var(--on-brand)] font-extrabold text-xs inline-flex items-center gap-2 shadow-sm">
            <span>&larr;</span>
            <span>Volver al radar de sorteos</span>
        </a>
    </div>
}
else
{
    @* HERO MOSTAZA DE CLAUDE DESIGN *@
    <section data-screen-label="Ficha de sorteo" class="bg-[#FFC145] text-[#22180F] border-b-[3px] border-[var(--rule)]">
        <div class="max-w-[1280px] mx-auto px-4 sm:px-8 lg:px-12 py-6 sm:py-10 flex flex-col gap-6 sm:gap-8">
            @* Barra superior de navegación y acciones de moderación *@
            <div class="flex flex-wrap justify-between items-center gap-3 text-xs sm:text-sm font-extrabold">
                <a href="/sorteos" class="hover:underline inline-flex items-center gap-1.5 text-[#22180F]">
                    <span>&larr;</span>
                    <span>Volver al radar de sorteos</span>
                </a>

                <div class="flex items-center gap-2 flex-wrap">
                    @if (_giveaway.IsPublishedOnInstagram && !string.IsNullOrWhiteSpace(_giveaway.InstagramPermalink))
                    {
                        <a href="@_giveaway.InstagramPermalink"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="h-8 px-3 rounded-full bg-[#22180F]/10 hover:bg-[#22180F]/20 text-[#22180F] text-xs font-bold transition-colors inline-flex items-center gap-1.5">
                            <Icon Name="camera" Size="12" />
                            <span>Instagram ↗</span>
                        </a>
                    }

                    @if (CanModerate)
                    {
                        <button type="button"
                                @onclick="OpenEditModal"
                                class="h-8 px-3 rounded-full bg-[#22180F] text-[#FFC145] text-xs font-extrabold hover:opacity-90 transition-opacity inline-flex items-center gap-1.5 shadow-xs">
                            <Icon Name="pen-line" Size="12" />
                            <span>Editar</span>
                        </button>
                        <button type="button"
                                @onclick="() => _isDeleteConfirmOpen = true"
                                class="h-8 px-3 rounded-full bg-red-700 text-white text-xs font-extrabold hover:bg-red-800 transition-colors inline-flex items-center gap-1.5 shadow-xs">
                            <Icon Name="trash-2" Size="12" />
                            <span>Eliminar</span>
                        </button>
                    }
                </div>
            </div>

            @* Cuadrícula Hero: Información a la izquierda, Polaroid a la derecha *@
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
                <div class="lg:col-span-7 flex flex-col gap-5 sm:gap-6 min-w-0">
                    @* Badges de urgencia y plataforma *@
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="px-3 py-1 rounded-full bg-[#22180F] text-[#FFC145] text-xs font-black">
                            @(_giveaway.IsExpired ? "Sorteo finalizado" : _giveaway.RemainingTimeText)
                        </span>
                        <span class="px-3 py-1 rounded-full border-1.5 border-[#22180F] bg-transparent text-[#22180F] text-xs font-extrabold flex items-center gap-1.5">
                            <Icon Name="@GetPlatformIcon(_giveaway.Platform)" Size="12" />
                            <span>@_giveaway.Platform · @CountryCatalog.GetFlag(_giveaway.Country) @(_giveaway.IsInternational ? "Internacional" : _giveaway.Country)</span>
                        </span>
                    </div>

                    @* Título gigante *@
                    <h1 class="text-4xl sm:text-6xl lg:text-[72px] font-black leading-[0.9] tracking-[-0.05em] m-0 text-balance">
                        @_giveaway.Title
                    </h1>

                    @* Organizador y cierre *@
                    <span class="text-sm sm:text-base font-bold leading-relaxed text-[#22180F]/90">
                        Organiza <b>@_giveaway.Organizer</b> · cierra el <b>@_giveaway.DeadlineAt.ToString("dd/MM/yyyy 'a las' HH:mm") UTC</b>
                    </span>

                    @* Cajas de cuenta atrás gigante en negro *@
                    <div class="flex gap-2 sm:gap-3 pt-1">
                        @{
                            var cd = GetCountdownBlocks(_giveaway);
                        }
                        <div class="w-20 sm:w-26 p-3 rounded-2xl bg-[#22180F] text-[#FFF8EE] flex flex-col items-center justify-center gap-0.5 shadow-sm">
                            <b class="text-3xl sm:text-4xl font-black tabular-nums tracking-tight text-[#FFC145]">
                                @cd.Days
                            </b>
                            <span class="text-[10px] sm:text-[11px] font-black uppercase tracking-widest opacity-80">
                                @(cd.Days == 1 ? "DÍA" : "DÍAS")
                            </span>
                        </div>
                        <div class="w-20 sm:w-26 p-3 rounded-2xl bg-[#22180F] text-[#FFF8EE] flex flex-col items-center justify-center gap-0.5 shadow-sm">
                            <b class="text-3xl sm:text-4xl font-black tabular-nums tracking-tight text-[#FFF8EE]">
                                @cd.Hours
                            </b>
                            <span class="text-[10px] sm:text-[11px] font-black uppercase tracking-widest opacity-80">
                                HORAS
                            </span>
                        </div>
                        <div class="w-20 sm:w-26 p-3 rounded-2xl bg-[#22180F] text-[#FFF8EE] flex flex-col items-center justify-center gap-0.5 shadow-sm">
                            <b class="text-3xl sm:text-4xl font-black tabular-nums tracking-tight text-[#FFF8EE]">
                                @cd.Minutes
                            </b>
                            <span class="text-[10px] sm:text-[11px] font-black uppercase tracking-widest opacity-80">
                                MINUTOS
                            </span>
                        </div>
                    </div>

                    @* Botones CTA *@
                    <div class="flex flex-wrap items-center gap-3 pt-2">
                        <a href="@_giveaway.Url"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="h-13 sm:h-14 px-7 sm:px-8 rounded-full bg-[#22180F] text-[#FFC145] font-black text-sm sm:text-base hover:opacity-95 transition-opacity inline-flex items-center gap-2 shadow-md">
                            <span>Participar en el sorteo oficial</span>
                            <span>↗</span>
                        </a>
                        <a href="/sorteos"
                           class="h-13 sm:h-14 px-6 rounded-full border-2 border-[#22180F] bg-transparent text-[#22180F] font-extrabold text-xs sm:text-sm hover:bg-[#22180F]/5 transition-colors inline-flex items-center gap-1.5">
                            Ver otros sorteos
                        </a>
                    </div>
                </div>

                @* Polaroid destacada de Claude Design con Sello Circular *@
                <div class="lg:col-span-5 flex justify-center lg:justify-end">
                    <div class="relative w-full max-w-[380px] bg-[#FFF8EE] text-[#22180F] p-4 pb-6 rounded shadow-[0_30px_50px_rgba(34,24,15,0.3)] rotate-[2.5deg] flex flex-col gap-3 group">
                        <div class="w-full aspect-square bg-[#EFE4D6] rounded-sm overflow-hidden relative">
                            @if (string.IsNullOrWhiteSpace(_giveaway.ThumbnailUrl))
                            {
                                <DefaultImage Domain="DefaultImageDomain.Sorteo"
                                              Alt="@($"Cartel del sorteo {_giveaway.Title}")"
                                              CssClass="w-full h-full object-cover" />
                            }
                            else
                            {
                                <img src="@_giveaway.ThumbnailUrl"
                                     alt="Cartel oficial de @_giveaway.Title"
                                     width="600"
                                     height="600"
                                     loading="lazy"
                                     decoding="async"
                                     onerror="this.onerror=null; this.src='/images/defaults/sorteo-default.svg';"
                                     class="w-full h-full object-cover" />
                            }
                        </div>

                        <div class="flex justify-between items-center gap-2 pt-1 text-[#22180F]">
                            <b class="text-base sm:text-lg font-black truncate">
                                @(!string.IsNullOrWhiteSpace(_giveaway.GameTitle) ? _giveaway.GameTitle : _giveaway.Title)
                            </b>
                            <span class="text-xs font-extrabold text-[#6B5848] shrink-0">
                                @CountryCatalog.GetFlag(_giveaway.Country) @(_giveaway.IsInternational ? "Internacional" : _giveaway.Country)
                            </span>
                        </div>

                        @if (CanModerate)
                        {
                            <div class="pt-1 text-center">
                                <button type="button"
                                        @onclick="OpenEditModal"
                                        class="text-xs font-bold text-[var(--brand)] hover:underline inline-flex items-center gap-1">
                                    <Icon Name="pen-line" Size="12" />
                                    <span>Cambiar o subir carátula</span>
                                </button>
                            </div>
                        }

                        @* Sello circular superpuesto en esquina: Verificado por Ludeka *@
                        <div class="absolute -right-3 -top-3 sm:-right-4 sm:-top-4 w-24 h-24 sm:w-28 sm:h-28 rounded-full bg-[#C9481C] text-[#FFF8EE] flex flex-col items-center justify-center text-center rotate-[10deg] shadow-lg pointer-events-none p-2 border-2 border-[#FFF8EE]/20">
                            <span class="text-[9px] sm:text-[10px] font-black uppercase tracking-wider">Verificado</span>
                            <b class="text-sm sm:text-base font-black leading-tight">por Ludeka</b>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* CUERPO EDITORIAL PRINCIPAL DE CLAUDE DESIGN *@
    <div class="max-w-[1280px] mx-auto px-4 sm:px-8 lg:px-12 py-10 sm:py-16 flex flex-col lg:flex-row gap-12 lg:gap-16">
        @* Columna Principal de Secciones Editoriales *@
        <div class="flex-1 min-w-0 flex flex-col gap-12 sm:gap-14">
            @* 01 Cómo participar *@
            <section class="flex flex-col gap-4">
                <div class="flex items-baseline gap-4">
                    <b class="text-4xl sm:text-5xl font-black leading-none tracking-[-0.06em] text-[var(--accent)]">01</b>
                    <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-[var(--ink)] m-0">Cómo participar</h2>
                </div>

                <div class="flex flex-col divide-y divide-[var(--line)] border-t-[3px] border-[var(--rule)]">
                    <div class="flex items-center gap-4 py-3.5">
                        <b class="w-10 h-10 shrink-0 rounded-full bg-[#FFC145] text-[#22180F] flex items-center justify-center text-base font-black">1</b>
                        <span class="text-sm sm:text-base font-bold text-[var(--ink)] leading-snug">
                            Accede a la publicación oficial mediante el enlace verificado de participación.
                        </span>
                    </div>
                    <div class="flex items-center gap-4 py-3.5">
                        <b class="w-10 h-10 shrink-0 rounded-full bg-[#FFC145] text-[#22180F] flex items-center justify-center text-base font-black">2</b>
                        <span class="text-sm sm:text-base font-bold text-[var(--ink)] leading-snug">
                            Cumple las condiciones del organizador oficial (@_giveaway.Organizer en @_giveaway.Platform).
                        </span>
                    </div>
                    <div class="flex items-center gap-4 py-3.5">
                        <b class="w-10 h-10 shrink-0 rounded-full bg-[#FFC145] text-[#22180F] flex items-center justify-center text-base font-black">3</b>
                        <span class="text-sm sm:text-base font-bold text-[var(--ink)] leading-snug">
                            Atento al cierre el @_giveaway.DeadlineAt.ToString("dd/MM/yyyy") para el sorteo de ganadores.
                        </span>
                    </div>
                </div>

                <p class="text-xs sm:text-sm text-[var(--muted)] leading-relaxed m-0 pt-1">
                    Nota comunitaria: Ludeka recopila e indexa oportunidades del sector lúdico. No organizamos los sorteos de terceros ni solicitamos pagos o registros privados para participar.
                </p>
            </section>

            @* 02 Condiciones *@
            <section class="flex flex-col gap-4">
                <div class="flex items-baseline gap-4">
                    <b class="text-4xl sm:text-5xl font-black leading-none tracking-[-0.06em] text-[#FFC145]">02</b>
                    <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-[var(--ink)] m-0">Condiciones</h2>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 pt-2">
                    <div class="flex flex-col gap-1 pt-3 border-t border-[var(--line)]">
                        <span class="text-[11px] font-black uppercase tracking-wider text-[var(--muted)]">Ámbito territorial</span>
                        <b class="text-base text-[var(--ink)] font-bold">
                            @CountryCatalog.GetFlag(_giveaway.Country) @(_giveaway.IsInternational ? "Internacional (Todos los países)" : _giveaway.Country)
                        </b>
                    </div>

                    <div class="flex flex-col gap-1 pt-3 border-t border-[var(--line)]">
                        <span class="text-[11px] font-black uppercase tracking-wider text-[var(--muted)]">Plataforma</span>
                        <b class="text-base text-[var(--ink)] font-bold">@_giveaway.Platform</b>
                    </div>

                    <div class="flex flex-col gap-1 pt-3 border-t border-[var(--line)]">
                        <span class="text-[11px] font-black uppercase tracking-wider text-[var(--muted)]">Fecha de Cierre</span>
                        <b class="text-base text-[var(--ink)] font-bold">@_giveaway.DeadlineAt.ToString("dd/MM/yyyy HH:mm") UTC</b>
                    </div>

                    <div class="flex flex-col gap-1 pt-3 border-t border-[var(--line)]">
                        <span class="text-[11px] font-black uppercase tracking-wider text-[var(--muted)]">Organizador</span>
                        <b class="text-base text-[var(--ink)] font-bold">@_giveaway.Organizer</b>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_giveaway.Collaborator))
                    {
                        <div class="flex flex-col gap-1 pt-3 border-t border-[var(--line)]">
                            <span class="text-[11px] font-black uppercase tracking-wider text-[var(--muted)]">Colaborador</span>
                            <b class="text-base text-[var(--ink)] font-bold">@_giveaway.Collaborator</b>
                        </div>
                    }

                    <div class="flex flex-col gap-1 pt-3 border-t border-[var(--line)]">
                        <span class="text-[11px] font-black uppercase tracking-wider text-[var(--muted)]">Estado actual</span>
                        <b class="text-base font-bold @(_giveaway.IsExpired ? "text-red-600" : "text-[#1B7D52]")">
                            @(_giveaway.IsExpired ? "Concluido" : "Vigente y activo")
                        </b>
                    </div>
                </div>
            </section>

            @* 03 Fiabilidad *@
            <section class="flex flex-col gap-4">
                <div class="flex items-baseline gap-4">
                    <b class="text-4xl sm:text-5xl font-black leading-none tracking-[-0.06em] text-[var(--accent-green)]">03</b>
                    <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-[var(--ink)] m-0">Fiabilidad</h2>
                </div>

                <div class="flex flex-col gap-3 pt-2">
                    <div class="flex items-start gap-3">
                        <span class="w-6 h-6 shrink-0 rounded-full bg-[#E5F7ED] text-[#1B7D52] flex items-center justify-center font-black text-xs mt-0.5">
                            ✓
                        </span>
                        <div class="flex flex-col gap-0.5">
                            <b class="text-sm font-bold text-[var(--ink)]">Enlace verificado en fuente oficial</b>
                            <span class="text-xs text-[var(--muted)] leading-relaxed">
                                El sorteo enlaza directamente al canal oficial de la editorial o tienda promotora.
                            </span>
                        </div>
                    </div>

                    <div class="flex items-start gap-3">
                        <span class="w-6 h-6 shrink-0 rounded-full bg-[#E5F7ED] text-[#1B7D52] flex items-center justify-center font-black text-xs mt-0.5">
                            ✓
                        </span>
                        <div class="flex flex-col gap-0.5">
                            <b class="text-sm font-bold text-[var(--ink)]">Sin intermediarios ni registros de terceros</b>
                            <span class="text-xs text-[var(--muted)] leading-relaxed">
                                No recopilamos datos privados de participación ni cobramos comisiones.
                            </span>
                        </div>
                    </div>

                    <div class="flex items-start gap-3">
                        <span class="w-6 h-6 shrink-0 rounded-full bg-[#E5F7ED] text-[#1B7D52] flex items-center justify-center font-black text-xs mt-0.5">
                            ✓
                        </span>
                        <div class="flex flex-col gap-0.5">
                            <b class="text-sm font-bold text-[var(--ink)]">Comunidad y radar editorial Ludeka</b>
                            <span class="text-xs text-[var(--muted)] leading-relaxed">
                                Revisado activamente por la mesa fundadora para evitar campañas engañosas o caducadas.
                            </span>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        @* Barra Lateral Aside: El juego del premio *@
        <aside class="w-full lg:w-[320px] shrink-0 flex flex-col gap-10">
            @if (_associatedGame != null)
            {
                <div class="flex flex-col gap-3.5">
                    <span class="text-xs font-black uppercase tracking-[0.14em] pb-2 border-b-[3px] border-[var(--rule)] text-[var(--ink)]">
                        El juego del premio
                    </span>

                    <a href="/juegos/@_associatedGame.Slug" class="flex gap-3.5 items-center group">
                        <div class="w-20 h-20 shrink-0 rounded overflow-hidden shadow-xs border border-black/5 -rotate-2 group-hover:rotate-0 transition-transform">
                            @if (!string.IsNullOrWhiteSpace(_associatedGame.ThumbnailUrl))
                            {
                                <img src="@_associatedGame.ThumbnailUrl" alt="@_associatedGame.SpanishTitle" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                <img src="/images/game-placeholder.svg" alt="@_associatedGame.SpanishTitle" class="w-full h-full object-cover opacity-80" />
                            }
                        </div>

                        <div class="flex flex-col gap-1 min-w-0">
                            <b class="text-base font-black text-[var(--ink)] tracking-tight leading-snug truncate group-hover:text-[var(--accent)] transition-colors">
                                @_associatedGame.SpanishTitle
                            </b>
                            <span class="text-xs text-[var(--muted)]">@_associatedGame.YearPublished · @_associatedGame.Designer</span>
                            <div class="text-xs font-bold flex items-center gap-1.5">
                                <span class="text-[var(--ink)]">★ @_associatedGame.BggRating.ToString("0.0")</span>
                                @if (_associatedGame.BggRank.HasValue && _associatedGame.BggRank.Value > 0)
                                {
                                    <span class="text-[#1B7D52]">· BGG #@_associatedGame.BggRank.Value</span>
                                }
                            </div>
                        </div>
                    </a>

                    <div class="flex flex-wrap gap-2 pt-1">
                        <a href="/juegos/@_associatedGame.Slug" class="h-9 px-4 rounded-full border border-[var(--line)] bg-[var(--card)] hover:border-[var(--ink)] text-[var(--ink)] font-bold text-xs inline-flex items-center transition-colors">
                            Ver ficha del juego
                        </a>
                        <a href="/cuenta/ludoteca" class="h-9 px-4 rounded-full bg-[var(--inverse)] text-[var(--on-inverse)] font-bold text-xs inline-flex items-center hover:opacity-90 transition-opacity">
                            Añadir a deseados
                        </a>
                    </div>
                </div>
            }

            <div class="p-6 rounded-2xl bg-[var(--paper-2)] border border-[var(--line)] flex flex-col gap-3">
                <span class="text-xs font-black uppercase tracking-wider text-[var(--muted)]">Radar Comunitario</span>
                <b class="text-base font-black text-[var(--ink)]">¿Quieres explorar más sorteos activos?</b>
                <p class="text-xs text-[var(--muted)] leading-relaxed m-0">
                    Consulta el radar completo con filtros por país, plataforma y alertas de cierre inminente.
                </p>
                <a href="/sorteos" class="mt-1 h-10 px-5 rounded-full bg-[var(--brand)] text-[var(--on-brand)] text-xs font-black inline-flex items-center justify-center self-start hover:scale-105 active:scale-95 transition-transform shadow-xs">
                    Ver todos los sorteos &rarr;
                </a>
            </div>
        </aside>
    </div>
}

@* Modal de Edición de Sorteo (Solo Administradores / Moderadores) *@
@if (CanModerate)
{
    <EditorialModal Open="@_isEditModalOpen"
                    Title="Editar Ficha del Sorteo"
                    TitleIcon="pen-line"
                    OnClose="@(() => _isEditModalOpen = false)">
        <ChildContent>
            <div class="space-y-4 text-xs">
                <div>
                    <label class="font-semibold text-[var(--text-secondary)] block mb-1">Título del Sorteo *</label>
                    <input type="text"
                           @bind="_editTitle"
                           placeholder="Ej. Sorteo Brass Birmingham + Monedas"
                           class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="font-semibold text-[var(--text-secondary)] block mb-1">Organizador (Editorial / Tienda) *</label>
                        <input type="text"
                               @bind="_editOrganizer"
                               placeholder="Ej. Maldito Games"
                               class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
                    </div>
                    <div>
                        <label class="font-semibold text-[var(--text-secondary)] block mb-1">Colaborador (Influencer / Canal)</label>
                        <input type="text"
                               @bind="_editCollaborator"
                               placeholder="Ej. Análisis Parálisis"
                               class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
                    </div>
                </div>

                <div>
                    <label class="font-semibold text-[var(--text-secondary)] block mb-1">Enlace Oficial al Sorteo *</label>
                    <input type="url"
                           @bind="_editUrl"
                           placeholder="https://www.instagram.com/p/..."
                           class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="font-semibold text-[var(--text-secondary)] block mb-1">Plataforma</label>
                        <select @bind="_editPlatform"
                                class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]">
                            <option value="@GiveawayPlatform.Instagram">Instagram</option>
                            <option value="@GiveawayPlatform.TwitterX">Twitter / X</option>
                            <option value="@GiveawayPlatform.YouTube">YouTube</option>
                            <option value="@GiveawayPlatform.Community">Comunidad Ludeka</option>
                        </select>
                    </div>

                    <div>
                        <label class="font-semibold text-[var(--text-secondary)] block mb-1">País / Ámbito Territorial</label>
                        <select @bind="_editCountry"
                                class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]">
                            <option value="Internacional">Internacional (Válido para todos)</option>
                            @foreach (var c in CountryCatalog.GetAllCountries())
                            {
                                <option value="@c.Name">@c.FlagEmoji @c.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="font-semibold text-[var(--text-secondary)] block mb-1">Fecha Límite</label>
                        <input type="date"
                               @bind="_editDeadlineDate"
                               class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                    </div>
                    <div>
                        <label class="font-semibold text-[var(--text-secondary)] block mb-1">Hora Límite (UTC)</label>
                        <input type="time"
                               @bind="_editDeadlineTime"
                               class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                    </div>
                </div>

                <div class="p-3 rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-2">
                    <label class="font-semibold text-[var(--text-secondary)] block">Imagen de Portada / Cartel</label>

                    <div class="flex items-center gap-3">
                        @if (!string.IsNullOrWhiteSpace(_editThumbnailUrl))
                        {
                            <img src="@_editThumbnailUrl"
                                 alt="Miniatura actual"
                                 width="50"
                                 height="50"
                                 class="w-12 h-12 rounded-lg object-cover border border-[var(--border-subtle)] shrink-0" />
                        }

                        <div class="flex-1 space-y-1">
                            <InputFile OnChange="HandleCoverFileUpload"
                                       accept="image/*"
                                       disabled="@_isUploadingImage"
                                       class="block w-full text-xs text-[var(--text-secondary)] file:mr-2 file:py-1 file:px-2.5 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-[var(--brand-primary)] file:text-[var(--on-brand)] hover:file:opacity-90 cursor-pointer" />
                            @if (_isUploadingImage)
                            {
                                <span class="text-[0.68rem] text-[var(--brand-primary)] font-semibold inline-flex items-center gap-1">
                                    <span class="animate-spin"><Icon Name="refresh-cw" Size="10" /></span>
                                    <span>Optimizando y subiendo a R2...</span>
                                </span>
                            }
                        </div>
                    </div>

                    <div>
                        <label class="text-[0.68rem] text-[var(--text-muted)] block mb-0.5">O introducir URL directa de imagen:</label>
                        <input type="url"
                               @bind="_editThumbnailUrl"
                               placeholder="https://... o /images/..."
                               class="w-full px-3 py-1.5 rounded-lg bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)] text-xs" />
                    </div>
                </div>

                <div>
                    <label class="font-semibold text-[var(--text-secondary)] block mb-1">Nombre del Juego Asociado (Opcional)</label>
                    <input type="text"
                           @bind="_editGameTitle"
                           placeholder="Ej. Brass: Birmingham"
                           class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
                </div>

                <div class="space-y-2 pt-1">
                    <div class="flex items-center gap-2">
                        <input type="checkbox"
                               id="editCommExcl"
                               @bind="_editIsCommunityExclusive"
                               class="rounded bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--brand-primary)] focus:ring-0" />
                        <label for="editCommExcl" class="text-[var(--text-secondary)] font-medium cursor-pointer">
                            Sorteo exclusivo para miembros de la comunidad Ludeka
                        </label>
                    </div>

                    <div class="flex items-center gap-2 p-2 rounded-xl bg-[var(--state-warning-bg)] border border-[var(--state-warning-border)]">
                        <input type="checkbox"
                               id="editIsPromoted"
                               @bind="_editIsPromoted"
                               class="rounded bg-[var(--bg-surface-elevated)] border-[var(--state-warning-border)] text-[var(--state-warning)] focus:ring-0" />
                        <label for="editIsPromoted" class="text-[var(--state-warning)] font-bold cursor-pointer">
                            Destacar como Sorteo Promocionado (Top de cabecera)
                        </label>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_editError))
                {
                    <div class="p-2.5 rounded-xl bg-[var(--state-error-bg)] border border-[var(--state-error-border)] text-[var(--state-error)] text-xs">
                        @_editError
                    </div>
                }
            </div>
        </ChildContent>

        <Footer>
            <button type="button"
                    @onclick="() => _isEditModalOpen = false"
                    disabled="@_isSaving"
                    class="px-4 py-2 rounded-xl border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] text-xs font-bold transition-colors">
                Cancelar
            </button>
            <button type="button"
                    @onclick="HandleSaveGiveaway"
                    disabled="@_isSaving"
                    class="px-4 py-2 rounded-xl bg-[var(--brand-primary)] hover:opacity-90 text-[var(--on-brand)] text-xs font-bold transition-opacity inline-flex items-center gap-1.5 shadow-sm disabled:opacity-50">
                @if (_isSaving)
                {
                    <span class="animate-spin"><Icon Name="refresh-cw" Size="12" /></span>
                    <span>Guardando...</span>
                }
                else
                {
                    <span>Guardar Cambios</span>
                }
            </button>
        </Footer>
    </EditorialModal>
}

@* Modal de Confirmación de Eliminación *@
@if (CanModerate)
{
    <EditorialModal Open="@_isDeleteConfirmOpen"
                    Title="Eliminar Sorteo"
                    TitleIcon="trash-2"
                    OnClose="@(() => _isDeleteConfirmOpen = false)">
        <ChildContent>
            <div class="space-y-3 text-xs">
                <p class="text-[var(--text-primary)] font-semibold">
                    ¿Estás seguro de que deseas eliminar definitivamente este sorteo?
                </p>
                <div class="p-3 rounded-xl bg-[var(--state-error-bg)] border border-[var(--state-error-border)] text-[var(--state-error)] text-xs">
                    Esta acción eliminará el sorteo del radar y de las portadas de Ludeka. La operación no se puede deshacer.
                </div>
            </div>
        </ChildContent>

        <Footer>
            <button type="button"
                    @onclick="() => _isDeleteConfirmOpen = false"
                    disabled="@_isDeleting"
                    class="px-4 py-2 rounded-xl border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] text-xs font-bold transition-colors">
                Cancelar
            </button>
            <button type="button"
                    @onclick="HandleDeleteGiveaway"
                    disabled="@_isDeleting"
                    class="px-4 py-2 rounded-xl bg-[var(--state-error)] hover:opacity-90 text-[var(--on-brand)] text-xs font-bold transition-opacity inline-flex items-center gap-1.5 shadow-sm disabled:opacity-50">
                @if (_isDeleting)
                {
                    <span class="animate-spin"><Icon Name="refresh-cw" Size="12" /></span>
                    <span>Eliminando...</span>
                }
                else
                {
                    <span>Eliminar Definitivamente</span>
                }
            </button>
        </Footer>
    </EditorialModal>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private GiveawayDto? _giveaway;
    private Game? _associatedGame;
    private bool _isLoading = true;
    private bool _isEditModalOpen;
    private bool _isDeleteConfirmOpen;
    private bool _isSaving;
    private bool _isDeleting;
    private bool _isUploadingImage;

    private string _editTitle = string.Empty;
    private string _editOrganizer = string.Empty;
    private string? _editCollaborator;
    private string _editUrl = string.Empty;
    private string? _editThumbnailUrl;
    private string _editCountry = "Internacional";
    private GiveawayPlatform _editPlatform = GiveawayPlatform.Instagram;
    private DateOnly _editDeadlineDate = DateOnly.FromDateTime(DateTime.UtcNow.AddDays(7));
    private TimeOnly _editDeadlineTime = new(23, 59);
    private string? _editGameTitle;
    private Guid? _editGameId;
    private bool _editIsCommunityExclusive;
    private bool _editIsPromoted;
    private string? _editError;

    private bool CanModerate => CurrentUserService.IsFoundingTeam ||
                               (CurrentUserService.IsInRole("Moderator") && CurrentUserService.HasPermission(ModeratorPermission.CanApproveMedia));

    protected override async Task OnInitializedAsync()
    {
        await LoadGiveawayAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_giveaway != null && _giveaway.Id != Id)
        {
            await LoadGiveawayAsync();
        }
    }

    private async Task LoadGiveawayAsync()
    {
        _isLoading = true;
        try
        {
            _giveaway = await GiveawayService.GetByIdAsync(Id);
            if (_giveaway?.GameId.HasValue == true)
            {
                _associatedGame = await GameRepository.GetByIdAsync(_giveaway.GameId.Value);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar el sorteo {GiveawayId}", Id);
            _giveaway = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenEditModal()
    {
        if (_giveaway == null) return;

        _editTitle = _giveaway.Title;
        _editOrganizer = _giveaway.Organizer;
        _editCollaborator = _giveaway.Collaborator;
        _editUrl = _giveaway.Url;
        _editThumbnailUrl = _giveaway.ThumbnailUrl;
        _editCountry = _giveaway.Country;
        _editPlatform = _giveaway.Platform;
        _editDeadlineDate = DateOnly.FromDateTime(_giveaway.DeadlineAt.UtcDateTime);
        _editDeadlineTime = TimeOnly.FromTimeSpan(_giveaway.DeadlineAt.UtcDateTime.TimeOfDay);
        _editGameTitle = _giveaway.GameTitle;
        _editGameId = _giveaway.GameId;
        _editIsCommunityExclusive = _giveaway.IsCommunityExclusive;
        _editIsPromoted = _giveaway.IsPromoted;
        _editError = null;

        _isEditModalOpen = true;
    }

    private async Task HandleCoverFileUpload(InputFileChangeEventArgs e)
    {
        _editError = null;
        var file = e.File;
        if (file == null) return;

        if (file.Size > 10 * 1024 * 1024)
        {
            _editError = "La imagen seleccionada supera el límite máximo de 10 MB.";
            return;
        }

        _isUploadingImage = true;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            var objectKey = $"giveaways/{Id:N}/cover.webp";
            var publicUrl = await ImageStorageService.UploadOptimizedImageAsync(
                memoryStream,
                objectKey,
                maxWidth: 1200,
                quality: 85);

            _editThumbnailUrl = publicUrl;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al optimizar y subir carátula para el sorteo {GiveawayId}", Id);
            _editError = "No se pudo subir la imagen. Verifica la conexión o formato del archivo.";
        }
        finally
        {
            _isUploadingImage = false;
        }
    }

    private async Task HandleSaveGiveaway()
    {
        _editError = null;

        if (string.IsNullOrWhiteSpace(_editTitle))
        {
            _editError = "El título del sorteo es obligatorio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_editOrganizer))
        {
            _editError = "El organizador es obligatorio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_editUrl))
        {
            _editError = "El enlace oficial del sorteo es obligatorio.";
            return;
        }

        var deadlineDateTime = _editDeadlineDate.ToDateTime(_editDeadlineTime, DateTimeKind.Utc);
        var deadlineOffset = new DateTimeOffset(deadlineDateTime, TimeSpan.Zero);

        var request = new UpdateGiveawayRequest(
            Id: Id,
            Title: _editTitle,
            Organizer: _editOrganizer,
            Collaborator: _editCollaborator,
            Url: _editUrl,
            Platform: _editPlatform,
            DeadlineAt: deadlineOffset,
            ThumbnailUrl: string.IsNullOrWhiteSpace(_editThumbnailUrl) ? null : _editThumbnailUrl.Trim(),
            IsCommunityExclusive: _editIsCommunityExclusive,
            IsPromoted: _editIsPromoted,
            Country: _editCountry,
            GameId: _editGameId,
            GameTitle: _editGameTitle);

        _isSaving = true;
        try
        {
            _giveaway = await GiveawayService.UpdateGiveawayAsync(request);
            if (_giveaway.GameId.HasValue)
            {
                _associatedGame = await GameRepository.GetByIdAsync(_giveaway.GameId.Value);
            }
            else
            {
                _associatedGame = null;
            }

            _isEditModalOpen = false;
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al actualizar el sorteo {GiveawayId}", Id);
            _editError = "Ocurrió un error al guardar los cambios: " + ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task HandleDeleteGiveaway()
    {
        _isDeleting = true;
        try
        {
            await GiveawayService.DeleteGiveawayAsync(Id);
            _isDeleteConfirmOpen = false;
            Navigation.NavigateTo("/sorteos");
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al eliminar el sorteo {GiveawayId}", Id);
            _isDeleteConfirmOpen = false;
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private static (int Days, int Hours, int Minutes) GetCountdownBlocks(GiveawayDto giveaway)
    {
        if (giveaway.IsExpired) return (0, 0, 0);
        var diff = giveaway.DeadlineAt - DateTimeOffset.UtcNow;
        if (diff.TotalSeconds <= 0) return (0, 0, 0);
        return ((int)diff.TotalDays, diff.Hours, diff.Minutes);
    }

    private static string GetPlatformIcon(GiveawayPlatform platform) => platform switch
    {
        GiveawayPlatform.Instagram => "camera",
        GiveawayPlatform.TwitterX => "twitter",
        GiveawayPlatform.YouTube => "clapperboard",
        GiveawayPlatform.Community => "dices",
        _ => "link"
    };
}
