@page "/sorteos/{Id:guid}"
@page "/sorteo/{Id:guid}"
@rendermode InteractiveServer
@using System.IO
@using Ludeka.Application.Contracts
@using Ludeka.Application.DTOs
@using Ludeka.Core.Entities
@using Ludeka.Core.Enums
@using Ludeka.Core.ValueObjects
@using Ludeka.Web.Components.Shared
@inject IGiveawayService GiveawayService
@inject IImageStorageService ImageStorageService
@inject ICurrentUserService CurrentUserService
@inject IGameRepository GameRepository
@inject NavigationManager Navigation
@inject ILogger<GiveawayDetail> Logger

<PageTitle>@(_giveaway != null ? $"{_giveaway.Title} — Ficha del Sorteo | Ludeka" : "Sorteo no encontrado — Ludeka")</PageTitle>

@if (_isLoading)
{
    <div class="container-ludeka py-20 text-center text-[var(--text-muted)]">
        <div class="inline-block animate-spin mb-3">
            <Icon Name="dices" Size="36" />
        </div>
        <p class="text-base font-semibold">Cargando ficha del sorteo...</p>
    </div>
}
else if (_giveaway == null)
{
    <div class="container-ludeka py-20 text-center max-w-lg mx-auto">
        <span class="inline-block mb-4 text-[var(--text-muted)]">
            <Icon Name="gift" Size="40" />
        </span>
        <h1 class="text-2xl font-black text-[var(--text-primary)] mb-2">Sorteo no encontrado</h1>
        <p class="text-sm text-[var(--text-muted)] mb-6">
            El sorteo que buscas no existe o ha sido retirado de nuestra plataforma.
        </p>
        <a href="/sorteos" class="px-4 py-2 rounded-xl bg-[var(--brand-primary)] text-[var(--on-brand)] font-bold text-xs transition-opacity shadow-sm inline-flex items-center gap-1.5">
            <span>&larr;</span> Volver al radar de sorteos
        </a>
    </div>
}
else
{
    @* Barra de navegación superior y acciones de moderación *@
    <div class="border-b border-[var(--border-subtle)] bg-[var(--bg-surface)]">
        <div class="container-ludeka py-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
            <div class="flex items-center gap-4">
                <a href="/sorteos" class="text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--brand-primary)] transition-colors inline-flex items-center gap-1.5">
                    <span>&larr;</span> Volver al radar de sorteos
                </a>
            </div>

            <div class="flex flex-wrap items-center gap-2">
                @if (_giveaway.IsPublishedOnInstagram && !string.IsNullOrWhiteSpace(_giveaway.InstagramPermalink))
                {
                    <a href="@_giveaway.InstagramPermalink"
                       target="_blank"
                       rel="noopener noreferrer"
                       title="Ver publicación oficial en Instagram"
                       class="px-3 py-1 rounded-lg bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-card)] text-[var(--text-primary)] border border-[var(--border-subtle)] font-bold text-xs transition-colors flex items-center gap-1.5 shadow-sm">
                        <Icon Name="camera" Size="12" /> Publicación en Instagram <span>↗</span>
                    </a>
                }
                else if (CanModerate)
                {
                    <a href="/admin/instagram?sourceType=Giveaway&sourceId=@_giveaway.Id"
                       class="px-3 py-1 rounded-lg bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-card)] text-[var(--text-primary)] border border-[var(--border-subtle)] font-bold text-xs transition-colors flex items-center gap-1.5 shadow-sm">
                        <Icon Name="camera" Size="12" /> Crear Post Instagram
                    </a>
                }

                @if (CanModerate)
                {
                    <div class="flex items-center gap-1.5 pl-2 border-l border-[var(--border-subtle)]">
                        <button type="button"
                                @onclick="OpenEditModal"
                                title="Editar datos y carátula del sorteo"
                                class="px-3 py-1 rounded-lg bg-[var(--state-warning-bg)] hover:bg-[var(--state-warning-border)] text-[var(--state-warning)] border border-[var(--state-warning-border)] font-bold text-xs transition-colors flex items-center gap-1.5 shadow-sm">
                            <Icon Name="pen-line" Size="12" /> Editar Sorteo
                        </button>
                        <button type="button"
                                @onclick="() => _isDeleteConfirmOpen = true"
                                title="Eliminar este sorteo"
                                class="px-3 py-1 rounded-lg bg-[var(--state-error-bg)] hover:bg-[var(--state-error-border)] text-[var(--state-error)] border border-[var(--state-error-border)] font-bold text-xs transition-colors flex items-center gap-1.5 shadow-sm">
                            <Icon Name="trash-2" Size="12" /> Eliminar
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    @* Contenedor Editorial Principal *@
    <div class="container-ludeka py-6 sm:py-10">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
            @* Columna Izquierda: Cartel del Sorteo y Acción Principal *@
            <div class="md:col-span-5 lg:col-span-5 space-y-4">
                <div class="rail-card flex flex-col p-2 bg-[var(--bg-card)] border border-[var(--border-subtle)] rounded-2xl shadow-md overflow-hidden relative">
                    <div class="relative w-full aspect-square bg-[var(--bg-surface-elevated)] rounded-xl overflow-hidden">
                        @if (string.IsNullOrWhiteSpace(_giveaway.ThumbnailUrl))
                        {
                            <DefaultImage Domain="DefaultImageDomain.Sorteo"
                                          Alt="@($"Cartel del sorteo {_giveaway.Title}")"
                                          CssClass="w-full h-full object-cover" />
                        }
                        else
                        {
                            <img src="@_giveaway.ThumbnailUrl"
                                 alt="Cartel oficial de @_giveaway.Title"
                                 width="600"
                                 height="600"
                                 loading="lazy"
                                 decoding="async"
                                 onerror="this.onerror=null; this.src='/images/defaults/sorteo-default.svg';"
                                 class="w-full h-full object-cover" />
                        }

                        @* Badges flotantes en la carátula *@
                        <div class="absolute top-3 left-3 flex flex-col gap-1.5 items-start z-10">
                            @if (_giveaway.IsPromoted)
                            {
                                <span class="px-2.5 py-1 rounded-lg text-xs font-black bg-[var(--state-warning)] text-[var(--on-brand)] shadow-md flex items-center gap-1">
                                    <Icon Name="star" Size="12" /> Promocionado
                                </span>
                            }
                            @if (_giveaway.IsCommunityExclusive)
                            {
                                <span class="px-2.5 py-1 rounded-lg text-xs font-black bg-[var(--brand-primary)] text-[var(--on-brand)] shadow-md flex items-center gap-1">
                                    <Icon Name="gift" Size="12" /> Exclusivo Comunidad
                                </span>
                            }
                        </div>

                        <div class="absolute bottom-3 right-3 z-10 px-3 py-1 rounded-lg text-xs font-bold shadow-md border @GetCountdownBadgeClass(_giveaway.IsExpired, _giveaway.RemainingTimeText)">
                            @_giveaway.RemainingTimeText
                        </div>
                    </div>

                    @if (CanModerate)
                    {
                        <div class="pt-2 px-1 text-center">
                            <button type="button"
                                    @onclick="OpenEditModal"
                                    class="text-xs font-semibold text-[var(--brand-primary)] hover:underline inline-flex items-center gap-1">
                                <Icon Name="pen-line" Size="12" /> Cambiar o subir carátula
                            </button>
                        </div>
                    }
                </div>

                @* Botón de Acción Principal: Participar *@
                <div class="space-y-2">
                    <a href="@_giveaway.Url"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="w-full py-3.5 px-4 rounded-xl bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-[var(--on-brand)] font-extrabold text-sm sm:text-base text-center flex items-center justify-center gap-2 shadow-md transition-all">
                        <span>Participar en el sorteo oficial</span>
                        <span class="text-base">&rarr;</span>
                    </a>
                    <p class="text-center text-[0.72rem] text-[var(--text-muted)] flex items-center justify-center gap-1">
                        <Icon Name="check-circle" Size="12" />
                        <span>Enlace oficial verificado en @_giveaway.Platform</span>
                    </p>
                </div>

                @if (_giveaway.IsExpired)
                {
                    <div class="p-4 rounded-xl bg-[var(--state-error-bg)] border border-[var(--state-error-border)] text-[var(--state-error)] text-xs flex items-start gap-2.5">
                        <Icon Name="clock" Size="16" Class="shrink-0 mt-0.5" />
                        <div>
                            <strong class="font-bold block">Sorteo finalizado</strong>
                            <span>Este sorteo concluyó el @_giveaway.DeadlineAt.ToString("dd/MM/yyyy 'a las' HH:mm"). La participación oficial puede estar cerrada.</span>
                        </div>
                    </div>
                }
            </div>

            @* Columna Derecha: Metadatos, Organizadores y Juego Asociado *@
            <div class="md:col-span-7 lg:col-span-7 space-y-6">
                @* Badges de Cabecera *@
                <div class="flex items-center gap-2 flex-wrap">
                    @* Badge Territorial / Bandera *@
                    <span class="px-2.5 py-1 rounded-lg text-xs font-bold border flex items-center gap-1.5 bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)]">
                        <span>@CountryCatalog.GetFlag(_giveaway.Country)</span>
                        <span>@(_giveaway.IsInternational ? "Internacional (Válido para todos)" : _giveaway.Country)</span>
                    </span>

                    @* Badge de Plataforma *@
                    <span class="px-2.5 py-1 rounded-lg text-xs font-bold border flex items-center gap-1.5 bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)]">
                        <Icon Name="@GetPlatformIcon(_giveaway.Platform)" Size="13" />
                        <span>@_giveaway.Platform</span>
                    </span>

                    @* Badge de Countdown *@
                    <span class="px-2.5 py-1 rounded-lg text-xs font-bold border flex items-center gap-1.5 @GetCountdownBadgeClass(_giveaway.IsExpired, _giveaway.RemainingTimeText)">
                        <Icon Name="timer" Size="13" />
                        <span>@_giveaway.RemainingTimeText</span>
                    </span>
                </div>

                @* Título *@
                <div>
                    <h1 class="text-2xl sm:text-3xl font-black text-[var(--text-primary)] leading-tight tracking-tight">
                        @_giveaway.Title
                    </h1>
                </div>

                @* Bloque de Organizador y Colaboradores *@
                <div class="p-4 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-3">
                    <h2 class="text-xs font-black text-[var(--text-muted)] uppercase tracking-wider">
                        Convocatoria y Organización
                    </h2>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="flex items-start gap-3">
                            <div class="w-9 h-9 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] flex items-center justify-center shrink-0 text-[var(--text-primary)]">
                                <Icon Name="user" Size="16" />
                            </div>
                            <div>
                                <span class="text-[0.68rem] text-[var(--text-muted)] block">Organizador oficial</span>
                                <strong class="text-sm font-extrabold text-[var(--text-primary)]">@_giveaway.Organizer</strong>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_giveaway.Collaborator))
                        {
                            <div class="flex items-start gap-3">
                                <div class="w-9 h-9 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] flex items-center justify-center shrink-0 text-[var(--text-primary)]">
                                    <Icon Name="users" Size="16" />
                                </div>
                                <div>
                                    <span class="text-[0.68rem] text-[var(--text-muted)] block">En colaboración con</span>
                                    <strong class="text-sm font-extrabold text-[var(--text-primary)]">@_giveaway.Collaborator</strong>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @* Tabla / Grid de Datos y Fechas Clave *@
                <div class="p-4 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-3">
                    <h2 class="text-xs font-black text-[var(--text-muted)] uppercase tracking-wider">
                        Detalles del Sorteo
                    </h2>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                        <div class="p-2.5 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)]">
                            <span class="text-[0.65rem] text-[var(--text-muted)] block">Fecha límite de participación</span>
                            <span class="font-bold text-[var(--text-primary)]">@_giveaway.DeadlineAt.ToString("dd/MM/yyyy HH:mm") UTC</span>
                        </div>

                        <div class="p-2.5 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)]">
                            <span class="text-[0.65rem] text-[var(--text-muted)] block">Registrado en Ludeka</span>
                            <span class="font-bold text-[var(--text-primary)]">@_giveaway.CreatedAt.ToString("dd/MM/yyyy")</span>
                        </div>

                        <div class="p-2.5 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)]">
                            <span class="text-[0.65rem] text-[var(--text-muted)] block">Ámbito territorial</span>
                            <span class="font-bold text-[var(--text-primary)]">@CountryCatalog.GetFlag(_giveaway.Country) @(_giveaway.IsInternational ? "Internacional" : _giveaway.Country)</span>
                        </div>

                        <div class="p-2.5 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)]">
                            <span class="text-[0.65rem] text-[var(--text-muted)] block">Plataforma</span>
                            <span class="font-bold text-[var(--text-primary)]">@_giveaway.Platform</span>
                        </div>
                    </div>
                </div>

                @* Juego Asociado (si existe) *@
                @if (_associatedGame != null)
                {
                    <div class="p-4 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-3">
                        <h2 class="text-xs font-black text-[var(--text-muted)] uppercase tracking-wider flex items-center gap-1.5">
                            <Icon Name="dices" Size="14" />
                            <span>Juego de Mesa Asociado</span>
                        </h2>

                        <div class="flex items-center gap-4">
                            <a href="/juegos/@_associatedGame.Slug" class="shrink-0 w-20 h-20 rounded-xl overflow-hidden border border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)] block">
                                @if (!string.IsNullOrWhiteSpace(_associatedGame.ThumbnailUrl))
                                {
                                    <img src="@_associatedGame.ThumbnailUrl"
                                         alt="@_associatedGame.SpanishTitle"
                                         width="80"
                                         height="80"
                                         loading="lazy"
                                         decoding="async"
                                         class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <img src="/images/game-placeholder.svg"
                                         alt="@_associatedGame.SpanishTitle"
                                         width="80"
                                         height="80"
                                         loading="lazy"
                                         decoding="async"
                                         class="w-full h-full object-cover opacity-80" />
                                }
                            </a>

                            <div class="flex-1 min-w-0">
                                <a href="/juegos/@_associatedGame.Slug" class="text-base font-extrabold text-[var(--text-primary)] hover:text-[var(--brand-primary)] transition-colors block truncate">
                                    @_associatedGame.SpanishTitle
                                </a>
                                <p class="text-xs text-[var(--text-secondary)] mt-0.5">
                                    @_associatedGame.YearPublished &bull; @_associatedGame.Designer
                                </p>
                                <div class="mt-2">
                                    <a href="/juegos/@_associatedGame.Slug" class="text-xs font-bold text-[var(--brand-primary)] hover:underline inline-flex items-center gap-1">
                                        <span>Ver ficha completa del juego</span>
                                        <span>&rarr;</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_giveaway.GameTitle))
                {
                    <div class="p-4 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] flex items-center justify-between gap-3">
                        <div class="flex items-center gap-2">
                            <Icon Name="dices" Size="16" Class="text-[var(--brand-primary)]" />
                            <span class="text-xs font-bold text-[var(--text-primary)]">Juego: @_giveaway.GameTitle</span>
                        </div>
                        <a href="/catalogo?q=@Uri.EscapeDataString(_giveaway.GameTitle)" class="text-xs font-bold text-[var(--brand-primary)] hover:underline">
                            Buscar en catálogo &rarr;
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* Modal de Edición de Sorteo (Solo Administradores / Moderadores) *@
@if (CanModerate)
{
    <EditorialModal Open="@_isEditModalOpen"
                    Title="Editar Ficha del Sorteo"
                    TitleIcon="pen-line"
                    OnClose="@(() => _isEditModalOpen = false)">
        <ChildContent>
            <div class="space-y-4 text-xs">
                @* Título *@
                <div>
                    <label class="font-semibold text-[var(--text-secondary)] block mb-1">Título del Sorteo *</label>
                    <input type="text"
                           @bind="_editTitle"
                           placeholder="Ej. Sorteo Brass Birmingham + Monedas"
                           class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
                </div>

                @* Organizador y Colaborador *@
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="font-semibold text-[var(--text-secondary)] block mb-1">Organizador (Editorial / Tienda) *</label>
                        <input type="text"
                               @bind="_editOrganizer"
                               placeholder="Ej. Maldito Games"
                               class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
                    </div>
                    <div>
                        <label class="font-semibold text-[var(--text-secondary)] block mb-1">Colaborador (Influencer / Canal)</label>
                        <input type="text"
                               @bind="_editCollaborator"
                               placeholder="Ej. Análisis Parálisis"
                               class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
                    </div>
                </div>

                @* Enlace Oficial *@
                <div>
                    <label class="font-semibold text-[var(--text-secondary)] block mb-1">Enlace Oficial al Sorteo *</label>
                    <input type="url"
                           @bind="_editUrl"
                           placeholder="https://www.instagram.com/p/..."
                           class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
                </div>

                @* Plataforma y Ámbito Territorial *@
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="font-semibold text-[var(--text-secondary)] block mb-1">Plataforma</label>
                        <select @bind="_editPlatform"
                                class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]">
                            <option value="@GiveawayPlatform.Instagram">Instagram</option>
                            <option value="@GiveawayPlatform.TwitterX">Twitter / X</option>
                            <option value="@GiveawayPlatform.YouTube">YouTube</option>
                            <option value="@GiveawayPlatform.Community">Comunidad Ludeka</option>
                        </select>
                    </div>

                    <div>
                        <label class="font-semibold text-[var(--text-secondary)] block mb-1">País / Ámbito Territorial</label>
                        <select @bind="_editCountry"
                                class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]">
                            <option value="Internacional">Internacional (Válido para todos)</option>
                            @foreach (var c in CountryCatalog.GetAllCountries())
                            {
                                <option value="@c.Name">@c.FlagEmoji @c.Name</option>
                            }
                        </select>
                    </div>
                </div>

                @* Fecha y Hora Límite *@
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="font-semibold text-[var(--text-secondary)] block mb-1">Fecha Límite</label>
                        <input type="date"
                               @bind="_editDeadlineDate"
                               class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                    </div>
                    <div>
                        <label class="font-semibold text-[var(--text-secondary)] block mb-1">Hora Límite (UTC)</label>
                        <input type="time"
                               @bind="_editDeadlineTime"
                               class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]" />
                    </div>
                </div>

                @* Reemplazo de Imagen de Portada *@
                <div class="p-3 rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-2">
                    <label class="font-semibold text-[var(--text-secondary)] block">Imagen de Portada / Cartel</label>

                    <div class="flex items-center gap-3">
                        @if (!string.IsNullOrWhiteSpace(_editThumbnailUrl))
                        {
                            <img src="@_editThumbnailUrl"
                                 alt="Miniatura actual"
                                 width="50"
                                 height="50"
                                 class="w-12 h-12 rounded-lg object-cover border border-[var(--border-subtle)] shrink-0" />
                        }

                        <div class="flex-1 space-y-1">
                            <InputFile OnChange="HandleCoverFileUpload"
                                       accept="image/*"
                                       disabled="@_isUploadingImage"
                                       class="block w-full text-xs text-[var(--text-secondary)] file:mr-2 file:py-1 file:px-2.5 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-[var(--brand-primary)] file:text-[var(--on-brand)] hover:file:opacity-90 cursor-pointer" />
                            @if (_isUploadingImage)
                            {
                                <span class="text-[0.68rem] text-[var(--brand-primary)] font-semibold inline-flex items-center gap-1">
                                    <span class="animate-spin"><Icon Name="refresh-cw" Size="10" /></span>
                                    <span>Optimizando y subiendo a R2...</span>
                                </span>
                            }
                        </div>
                    </div>

                    <div>
                        <label class="text-[0.68rem] text-[var(--text-muted)] block mb-0.5">O introducir URL directa de imagen:</label>
                        <input type="url"
                               @bind="_editThumbnailUrl"
                               placeholder="https://... o /images/..."
                               class="w-full px-3 py-1.5 rounded-lg bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)] text-xs" />
                    </div>
                </div>

                @* Juego Asociado *@
                <div>
                    <label class="font-semibold text-[var(--text-secondary)] block mb-1">Nombre del Juego Asociado (Opcional)</label>
                    <input type="text"
                           @bind="_editGameTitle"
                           placeholder="Ej. Brass: Birmingham"
                           class="w-full px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)]" />
                </div>

                @* Toggles de Promoción y Comunidad *@
                <div class="space-y-2 pt-1">
                    <div class="flex items-center gap-2">
                        <input type="checkbox"
                               id="editCommExcl"
                               @bind="_editIsCommunityExclusive"
                               class="rounded bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--brand-primary)] focus:ring-0" />
                        <label for="editCommExcl" class="text-[var(--text-secondary)] font-medium cursor-pointer">
                            Sorteo exclusivo para miembros de la comunidad Ludeka
                        </label>
                    </div>

                    <div class="flex items-center gap-2 p-2 rounded-xl bg-[var(--state-warning-bg)] border border-[var(--state-warning-border)]">
                        <input type="checkbox"
                               id="editIsPromoted"
                               @bind="_editIsPromoted"
                               class="rounded bg-[var(--bg-surface-elevated)] border-[var(--state-warning-border)] text-[var(--state-warning)] focus:ring-0" />
                        <label for="editIsPromoted" class="text-[var(--state-warning)] font-bold cursor-pointer">
                            Destacar como Sorteo Promocionado (Top de cabecera)
                        </label>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_editError))
                {
                    <div class="p-2.5 rounded-xl bg-[var(--state-error-bg)] border border-[var(--state-error-border)] text-[var(--state-error)] text-xs">
                        @_editError
                    </div>
                }
            </div>
        </ChildContent>

        <Footer>
            <button type="button"
                    @onclick="() => _isEditModalOpen = false"
                    disabled="@_isSaving"
                    class="px-4 py-2 rounded-xl border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] text-xs font-bold transition-colors">
                Cancelar
            </button>
            <button type="button"
                    @onclick="HandleSaveGiveaway"
                    disabled="@_isSaving"
                    class="px-4 py-2 rounded-xl bg-[var(--brand-primary)] hover:opacity-90 text-[var(--on-brand)] text-xs font-bold transition-opacity inline-flex items-center gap-1.5 shadow-sm disabled:opacity-50">
                @if (_isSaving)
                {
                    <span class="animate-spin"><Icon Name="refresh-cw" Size="12" /></span>
                    <span>Guardando...</span>
                }
                else
                {
                    <span>Guardar Cambios</span>
                }
            </button>
        </Footer>
    </EditorialModal>
}

@* Modal de Confirmación de Eliminación *@
@if (CanModerate)
{
    <EditorialModal Open="@_isDeleteConfirmOpen"
                    Title="Eliminar Sorteo"
                    TitleIcon="trash-2"
                    OnClose="@(() => _isDeleteConfirmOpen = false)">
        <ChildContent>
            <div class="space-y-3 text-xs">
                <p class="text-[var(--text-primary)] font-semibold">
                    ¿Estás seguro de que deseas eliminar definitivamente este sorteo?
                </p>
                <div class="p-3 rounded-xl bg-[var(--state-error-bg)] border border-[var(--state-error-border)] text-[var(--state-error)] text-xs">
                    Esta acción eliminará el sorteo del radar y de las portadas de Ludeka. La operación no se puede deshacer.
                </div>
            </div>
        </ChildContent>

        <Footer>
            <button type="button"
                    @onclick="() => _isDeleteConfirmOpen = false"
                    disabled="@_isDeleting"
                    class="px-4 py-2 rounded-xl border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] text-xs font-bold transition-colors">
                Cancelar
            </button>
            <button type="button"
                    @onclick="HandleDeleteGiveaway"
                    disabled="@_isDeleting"
                    class="px-4 py-2 rounded-xl bg-[var(--state-error)] hover:opacity-90 text-[var(--on-brand)] text-xs font-bold transition-opacity inline-flex items-center gap-1.5 shadow-sm disabled:opacity-50">
                @if (_isDeleting)
                {
                    <span class="animate-spin"><Icon Name="refresh-cw" Size="12" /></span>
                    <span>Eliminando...</span>
                }
                else
                {
                    <span>Eliminar Definitivamente</span>
                }
            </button>
        </Footer>
    </EditorialModal>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private GiveawayDto? _giveaway;
    private Game? _associatedGame;
    private bool _isLoading = true;
    private bool _isEditModalOpen;
    private bool _isDeleteConfirmOpen;
    private bool _isSaving;
    private bool _isDeleting;
    private bool _isUploadingImage;

    // Campos del formulario de edición
    private string _editTitle = string.Empty;
    private string _editOrganizer = string.Empty;
    private string? _editCollaborator;
    private string _editUrl = string.Empty;
    private string? _editThumbnailUrl;
    private string _editCountry = "Internacional";
    private GiveawayPlatform _editPlatform = GiveawayPlatform.Instagram;
    private DateOnly _editDeadlineDate = DateOnly.FromDateTime(DateTime.UtcNow.AddDays(7));
    private TimeOnly _editDeadlineTime = new(23, 59);
    private string? _editGameTitle;
    private Guid? _editGameId;
    private bool _editIsCommunityExclusive;
    private bool _editIsPromoted;
    private string? _editError;

    private bool CanModerate => CurrentUserService.IsFoundingTeam ||
                               (CurrentUserService.IsInRole("Moderator") && CurrentUserService.HasPermission(ModeratorPermission.CanApproveMedia));

    protected override async Task OnInitializedAsync()
    {
        await LoadGiveawayAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_giveaway != null && _giveaway.Id != Id)
        {
            await LoadGiveawayAsync();
        }
    }

    private async Task LoadGiveawayAsync()
    {
        _isLoading = true;
        try
        {
            _giveaway = await GiveawayService.GetByIdAsync(Id);
            if (_giveaway?.GameId.HasValue == true)
            {
                _associatedGame = await GameRepository.GetByIdAsync(_giveaway.GameId.Value);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar el sorteo {GiveawayId}", Id);
            _giveaway = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenEditModal()
    {
        if (_giveaway == null) return;

        _editTitle = _giveaway.Title;
        _editOrganizer = _giveaway.Organizer;
        _editCollaborator = _giveaway.Collaborator;
        _editUrl = _giveaway.Url;
        _editThumbnailUrl = _giveaway.ThumbnailUrl;
        _editCountry = _giveaway.Country;
        _editPlatform = _giveaway.Platform;
        _editDeadlineDate = DateOnly.FromDateTime(_giveaway.DeadlineAt.UtcDateTime);
        _editDeadlineTime = TimeOnly.FromTimeSpan(_giveaway.DeadlineAt.UtcDateTime.TimeOfDay);
        _editGameTitle = _giveaway.GameTitle;
        _editGameId = _giveaway.GameId;
        _editIsCommunityExclusive = _giveaway.IsCommunityExclusive;
        _editIsPromoted = _giveaway.IsPromoted;
        _editError = null;

        _isEditModalOpen = true;
    }

    private async Task HandleCoverFileUpload(InputFileChangeEventArgs e)
    {
        _editError = null;
        var file = e.File;
        if (file == null) return;

        if (file.Size > 10 * 1024 * 1024)
        {
            _editError = "La imagen seleccionada supera el límite máximo de 10 MB.";
            return;
        }

        _isUploadingImage = true;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            var objectKey = $"giveaways/{Id:N}/cover.webp";
            var publicUrl = await ImageStorageService.UploadOptimizedImageAsync(
                memoryStream,
                objectKey,
                maxWidth: 1200,
                quality: 85);

            _editThumbnailUrl = publicUrl;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al optimizar y subir carátula para el sorteo {GiveawayId}", Id);
            _editError = "No se pudo subir la imagen. Verifica la conexión o formato del archivo.";
        }
        finally
        {
            _isUploadingImage = false;
        }
    }

    private async Task HandleSaveGiveaway()
    {
        _editError = null;

        if (string.IsNullOrWhiteSpace(_editTitle))
        {
            _editError = "El título del sorteo es obligatorio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_editOrganizer))
        {
            _editError = "El organizador es obligatorio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_editUrl))
        {
            _editError = "El enlace oficial del sorteo es obligatorio.";
            return;
        }

        var deadlineDateTime = _editDeadlineDate.ToDateTime(_editDeadlineTime, DateTimeKind.Utc);
        var deadlineOffset = new DateTimeOffset(deadlineDateTime, TimeSpan.Zero);

        var request = new UpdateGiveawayRequest(
            Id: Id,
            Title: _editTitle,
            Organizer: _editOrganizer,
            Collaborator: _editCollaborator,
            Url: _editUrl,
            Platform: _editPlatform,
            DeadlineAt: deadlineOffset,
            ThumbnailUrl: string.IsNullOrWhiteSpace(_editThumbnailUrl) ? null : _editThumbnailUrl.Trim(),
            IsCommunityExclusive: _editIsCommunityExclusive,
            IsPromoted: _editIsPromoted,
            Country: _editCountry,
            GameId: _editGameId,
            GameTitle: _editGameTitle);

        _isSaving = true;
        try
        {
            _giveaway = await GiveawayService.UpdateGiveawayAsync(request);
            if (_giveaway.GameId.HasValue)
            {
                _associatedGame = await GameRepository.GetByIdAsync(_giveaway.GameId.Value);
            }
            else
            {
                _associatedGame = null;
            }

            _isEditModalOpen = false;
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al actualizar el sorteo {GiveawayId}", Id);
            _editError = "Ocurrió un error al guardar los cambios: " + ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task HandleDeleteGiveaway()
    {
        _isDeleting = true;
        try
        {
            await GiveawayService.DeleteGiveawayAsync(Id);
            _isDeleteConfirmOpen = false;
            Navigation.NavigateTo("/sorteos");
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al eliminar el sorteo {GiveawayId}", Id);
            _isDeleteConfirmOpen = false;
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private static string GetPlatformIcon(GiveawayPlatform platform) => platform switch
    {
        GiveawayPlatform.Instagram => "camera",
        GiveawayPlatform.TwitterX => "twitter",
        GiveawayPlatform.YouTube => "clapperboard",
        GiveawayPlatform.Community => "dices",
        _ => "link"
    };

    private static string GetCountdownBadgeClass(bool isExpired, string remainingText)
    {
        if (isExpired)
            return "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-muted)]";

        if (remainingText.Contains("horas", StringComparison.OrdinalIgnoreCase))
            return "bg-[var(--state-error-bg)] border-[var(--state-error-border)] text-[var(--state-error)] animate-pulse";

        return "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-primary)]";
    }
}
