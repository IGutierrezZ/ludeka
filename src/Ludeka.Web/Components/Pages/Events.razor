@page "/eventos"
@rendermode InteractiveServer
@using Ludeka.Application.Contracts
@using Ludeka.Core.ValueObjects
@inject IBoardGameEventService EventService
@inject ICurrentUserService CurrentUserService
@inject IUserLocationService LocationService

<PageTitle>Grandes Citas y Ferias Lúdicas — Ludeka</PageTitle>

@* Cabecera editorial de página INC-36 preservada *@
<div class="sr-only" aria-hidden="true">
    <PageHeaderEditorial Badge="Calendario Oficial del Sector"
                         BadgeIcon="tent"
                         Subtitle="La guía de referencia para los grandes festivales, convenciones y encuentros de juegos de mesa en España y el circuito internacional.">
        <Title>Grandes Citas, Ferias &amp; Festivales</Title>
    </PageHeaderEditorial>
</div>

@* HERO AZUL DE EVENTOS EDITORIAL CLAUDE DESIGN *@
<section class="bg-[var(--blue-band)] text-[var(--on-blue)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 flex flex-col gap-6">
        <span class="text-xs font-black uppercase tracking-widest text-[#93C5FD]">
            Agenda · @_upcomingEvents.Count citas oficiales
        </span>

        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
            <div>
                <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight leading-[0.9] text-balance">
                    Ferias y<br>grandes <i class="not-italic text-[#FFC145]">citas</i>
                </h1>
                <p class="text-base sm:text-lg text-white/80 mt-3 max-w-2xl leading-relaxed">
                    Ferias, jornadas y torneos del sector, con su fecha y lugar. La guía de referencia para los grandes encuentros de juegos de mesa.
                </p>
            </div>

            @if (IsModerator)
            {
                <div class="flex items-center gap-2 shrink-0">
                    <button type="button"
                            @onclick="() => _isExpressModalOpen = true"
                            class="h-10 px-4 rounded-full bg-[#FFC145] text-[#22180F] font-extrabold text-xs transition-transform hover:scale-[1.02] flex items-center gap-1.5 shadow-md">
                        <Icon Name="zap" Size="13" /> Alta Exprés
                    </button>
                    <a href="/admin/eventos"
                       class="h-10 px-4 rounded-full bg-white/20 hover:bg-white/30 text-white font-extrabold text-xs transition-colors flex items-center gap-1.5">
                        <Icon Name="settings" Size="13" /> Gestionar Eventos
                    </a>
                </div>
            }
        </div>

        @* Barra de Pestañas y Filtros Territoriales en Píldoras con Borde Blanco *@
        <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-white/20">
            @* Pestañas de Navegación Temporal *@
            <div class="flex items-center gap-2" role="tablist" aria-label="Pestañas de Eventos">
                <button type="button"
                        id="tab-upcoming"
                        role="tab"
                        aria-selected="@(_activeTab == Tab.Upcoming ? "true" : "false")"
                        aria-controls="panel-upcoming"
                        @onclick="() => SwitchTab(Tab.Upcoming)"
                        class="h-10 px-5 rounded-full border border-white/60 font-extrabold text-xs inline-flex items-center gap-2 transition-all @(_activeTab == Tab.Upcoming ? "bg-white text-[#1E293B] shadow-md" : "bg-transparent text-white hover:bg-white/10")">
                    <span class="inline-block w-2 h-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
                    <span>Próximas Citas</span>
                    <span class="text-[11px] px-2 py-0.5 rounded-full @(_activeTab == Tab.Upcoming ? "bg-[#1E293B]/10 text-[#1E293B]" : "bg-white/20 text-white")">@_upcomingEvents.Count</span>
                </button>

                <button type="button"
                        id="tab-past"
                        role="tab"
                        aria-selected="@(_activeTab == Tab.Past ? "true" : "false")"
                        aria-controls="panel-past"
                        @onclick="() => SwitchTab(Tab.Past)"
                        class="h-10 px-5 rounded-full border border-white/60 font-extrabold text-xs inline-flex items-center gap-2 transition-all @(_activeTab == Tab.Past ? "bg-white text-[#1E293B] shadow-md" : "bg-transparent text-white hover:bg-white/10")">
                    <Icon Name="scroll" Size="13" />
                    <span>Histórico</span>
                    <span class="text-[11px] px-2 py-0.5 rounded-full @(_activeTab == Tab.Past ? "bg-[#1E293B]/10 text-[#1E293B]" : "bg-white/20 text-white")">@_pastEvents.Count</span>
                </button>
            </div>

            @* Filtro Territorial *@
            <div class="flex items-center gap-2 flex-wrap">
                <button type="button"
                        @onclick="() => SetCountryFilter(null)"
                        class="h-10 px-4 rounded-full border font-extrabold text-xs inline-flex items-center gap-1.5 transition-all @(string.IsNullOrWhiteSpace(_countryFilter) ? "bg-[#FFC145] text-[#22180F] border-[#FFC145] shadow-md" : "bg-transparent border-white/40 text-white hover:bg-white/10")">
                    <Icon Name="globe" Size="13" />
                    <span>Todos (con Internacionales)</span>
                </button>

                @if (!string.IsNullOrWhiteSpace(_userActiveCountry) && _userActiveCountry != "Internacional")
                {
                    <button type="button"
                            @onclick="() => SetCountryFilter(_userActiveCountry)"
                            class="h-10 px-4 rounded-full border font-extrabold text-xs inline-flex items-center gap-1.5 transition-all @(_countryFilter == _userActiveCountry ? "bg-[#FFC145] text-[#22180F] border-[#FFC145] shadow-md" : "bg-transparent border-white/40 text-white hover:bg-white/10")">
                        <span>@CountryCatalog.GetFlag(_userActiveCountry) @_userActiveCountry</span>
                    </button>
                }

                <select @bind="_countryFilter"
                        @bind:after="OnCountryDropdownChanged"
                        class="h-10 px-4 rounded-full bg-white/10 border border-white/40 text-white font-extrabold text-xs focus:outline-none cursor-pointer">
                    <option value="" class="text-neutral-900 bg-white">Otros países...</option>
                    @foreach (var c in CountryCatalog.GetAllCountries())
                    {
                        <option value="@c.Name" class="text-neutral-900 bg-white">@c.FlagEmoji @c.Name</option>
                    }
                </select>
            </div>
        </div>
    </div>
</section>

@* CUERPO PRINCIPAL CON CUADRÍCULA DE TARJETAS EDITORIALES *@
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <div id="@ActivePanelId" role="tabpanel" aria-labelledby="@ActiveTabId">
        @if (_isLoading)
        {
            <div class="py-20 text-center text-[var(--text-muted)]">
                <div class="inline-block animate-spin mb-3">
                    <Icon Name="tent" Size="36" />
                </div>
                <p class="text-sm font-semibold">Consultando el calendario oficial de eventos...</p>
            </div>
        }
        else
        {
            var currentList = _activeTab == Tab.Upcoming ? _upcomingEvents : _pastEvents;

            @if (currentList.Count == 0)
            {
                <div class="p-12 text-center rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] max-w-lg mx-auto">
                    <span class="inline-block mb-3 text-[var(--text-muted)]">
                        <Icon Name="tent" Size="40" />
                    </span>
                    <h3 class="text-lg font-bold text-[var(--text-primary)] mb-1">
                        @(_activeTab == Tab.Upcoming ? "No hay eventos futuros registrados" : "No hay eventos en el archivo histórico")
                    </h3>
                    <p class="text-xs text-[var(--text-secondary)] mb-6">
                        @(_activeTab == Tab.Upcoming ? "Pronto añadiremos nuevas fechas del calendario lúdico oficial." : "Las citas finalizadas se archivarán automáticamente aquí.")
                    </p>
                    @if (IsModerator)
                    {
                        <a href="/admin/eventos"
                           class="px-4 py-2 rounded-full bg-[var(--brand-primary)] text-[var(--on-brand)] font-bold text-xs inline-flex items-center gap-1.5 shadow-sm">
                            <Icon Name="settings" Size="13" /> Añadir Evento Ahora
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                    @foreach (var evt in currentList)
                    {
                        <div class="rail-card p-6 rounded-[24px] bg-[var(--bg-card)] border border-[var(--border-subtle)] flex flex-col gap-3 min-h-[300px] overflow-hidden shadow-sm hover:border-[var(--brand-primary)] transition-all group relative">
                            @* Cartel Panorámico de Cabecera *@
                            <div class="-mx-6 -mt-6 mb-1 h-36 overflow-hidden relative bg-[var(--bg-surface-elevated)]">
                                @if (string.IsNullOrWhiteSpace(evt.ImageUrl))
                                {
                                    <DefaultImage Domain="DefaultImageDomain.Evento"
                                                  Alt="@($"Cartel de {evt.Title}")"
                                                  CssClass="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <img src="@evt.ImageUrl"
                                         alt="Cartel de @evt.Title"
                                         width="300"
                                         height="150"
                                         loading="lazy"
                                         decoding="async"
                                         onerror="this.onerror=null; this.src='/images/defaults/evento-default.svg';"
                                         class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform" />
                                }

                                @* Badges Sobre la Foto *@
                                <div class="absolute top-2.5 left-2.5 z-10 px-2.5 py-1 rounded-full text-[11px] font-extrabold border shadow-md backdrop-blur-md bg-black/60 text-white border-white/20 flex items-center gap-1">
                                    <span>@CountryCatalog.GetFlag(evt.Country)</span>
                                    <span>@(evt.IsInternational ? "Internacional" : evt.Country)</span>
                                </div>

                                <div class="absolute top-2.5 right-2.5 z-10 px-2.5 py-1 rounded-full text-[11px] font-black border shadow-md @GetRemainingBadgeClass(evt.RemainingDaysText)">
                                    @evt.RemainingDaysText
                                </div>
                            </div>

                            @* Fila de Metadatos Rápidos *@
                            <div class="flex items-center justify-between gap-2">
                                <span class="text-[11px] font-black uppercase tracking-wider text-[var(--text-muted)] truncate">
                                    @evt.RemainingDaysText
                                </span>
                                <span class="px-2.5 py-0.5 rounded-full border border-[var(--border-subtle)] text-[11px] font-bold text-[var(--text-secondary)]">
                                    @(evt.IsOfficial ? "Oficial" : "Encuentro")
                                </span>
                            </div>

                            @* Gran Fecha Numérica de Claude Design *@
                            <div class="flex items-baseline gap-1.5 pt-1">
                                <b class="text-5xl sm:text-6xl font-black tracking-tight leading-none text-[var(--text-primary)]">
                                    @evt.StartDate.Day
                                </b>
                                <span class="text-xl sm:text-2xl font-black tracking-tight uppercase text-[var(--brand-primary)]">
                                    @evt.StartDate.ToString("MMM").TrimEnd('.')
                                </span>
                                <span class="text-xs font-semibold text-[var(--text-muted)] ml-auto flex items-center gap-1">
                                    <Icon Name="calendar-days" Size="12" /> @evt.FormattedDates
                                </span>
                            </div>

                            @* Título *@
                            <a href="/eventos/@evt.Id" class="mt-auto block text-lg font-black text-[var(--text-primary)] group-hover:text-[var(--brand-primary)] leading-snug transition-colors line-clamp-2">
                                @evt.Title
                            </a>

                            @* Lugar *@
                            <div class="flex items-center gap-1.5 text-xs text-[var(--text-secondary)] truncate">
                                <Icon Name="map-pin" Size="13" Class="text-[var(--brand-primary)] shrink-0" />
                                <span class="truncate">@evt.Location</span>
                            </div>

                            @* Botonera al Pie *@
                            <div class="pt-3 border-t border-[var(--border-subtle)] flex items-center justify-between gap-2 mt-auto">
                                <a href="/eventos/@evt.Id" class="h-9 px-4 rounded-full border border-[var(--border-subtle)] hover:border-[var(--brand-primary)] hover:bg-[var(--bg-surface-elevated)] text-[var(--text-primary)] font-extrabold text-xs inline-flex items-center gap-1 transition-colors">
                                    Ver Ficha
                                </a>
                                @if (!string.IsNullOrWhiteSpace(evt.WebsiteUrl))
                                {
                                    <a href="@evt.WebsiteUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="h-9 px-3.5 rounded-full bg-[var(--brand-primary)] text-[var(--on-brand)] font-extrabold text-xs inline-flex items-center gap-1 shadow-sm hover:opacity-90 transition-opacity">
                                        <span>Web</span>
                                        <span>&rarr;</span>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

<SocialExpressIngestModal IsOpen="_isExpressModalOpen"
                          OnClose="() => _isExpressModalOpen = false"
                          OnItemCreated="HandleExpressItemCreated" />

@code {
    private enum Tab { Upcoming, Past }
    private Tab _activeTab = Tab.Upcoming;
    private bool _isLoading = true;
    private bool _isExpressModalOpen;
    private string? _userActiveCountry;
    private string? _countryFilter;

    private IReadOnlyList<BoardGameEventDto> _upcomingEvents = new List<BoardGameEventDto>();
    private IReadOnlyList<BoardGameEventDto> _pastEvents = new List<BoardGameEventDto>();

    private bool IsModerator => CurrentUserService.IsFoundingTeam || CurrentUserService.IsInRole("Moderator");

    // Identificadores ARIA de la pestaña activa y su panel (relación tab/tabpanel de
    // la spec editorial-page-foundations): expresiones completas en el atributo,
    // nunca @ pegado a texto (gotcha Razor de INC-36)
    private string ActiveTabId => _activeTab == Tab.Upcoming ? "tab-upcoming" : "tab-past";
    private string ActivePanelId => _activeTab == Tab.Upcoming ? "panel-upcoming" : "panel-past";

    protected override async Task OnInitializedAsync()
    {
        _userActiveCountry = await LocationService.GetEffectiveCountryAsync();
        _countryFilter = _userActiveCountry;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _upcomingEvents = await EventService.GetUpcomingEventsAsync(limit: 50, country: _countryFilter);
            _pastEvents = await EventService.GetPastEventsAsync(limit: 50, country: _countryFilter);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SetCountryFilter(string? country)
    {
        _countryFilter = country;
        await LoadDataAsync();
    }

    private async Task OnCountryDropdownChanged()
    {
        await LoadDataAsync();
    }

    private void SwitchTab(Tab tab)
    {
        _activeTab = tab;
    }

    private string GetRemainingBadgeClass(string remainingText)
    {
        // INC-36 (DD-04): badges de urgencia con tokens semánticos de estado del tema
        // (+--on-brand). El overlay «Finalizado» conserva su familia blanca neutra sobre
        // bg-black/60: contrata contra la fotografía del cartel, no contra el tema
        // (excepción contratada del barrido, igual que los badges territoriales).
        if (remainingText.Contains("curso", StringComparison.OrdinalIgnoreCase))
            return "bg-[var(--state-error)] text-[var(--on-brand)] border-[var(--state-error-border)] animate-pulse";

        if (remainingText.Contains("hoy", StringComparison.OrdinalIgnoreCase) || remainingText.Contains("mañana", StringComparison.OrdinalIgnoreCase))
            return "bg-[var(--state-warning)] text-[var(--on-brand)] border-[var(--state-warning-border)] font-black";

        if (remainingText.Contains("Finalizado", StringComparison.OrdinalIgnoreCase))
            return "bg-black/60 text-white/80 border-white/10";

        return "bg-black/60 text-white border-white/20";
    }

    private async Task HandleExpressItemCreated(Ludeka.Application.DTOs.SocialInboxItemDto item)
    {
        _isExpressModalOpen = false;
        await LoadDataAsync();
    }
}
