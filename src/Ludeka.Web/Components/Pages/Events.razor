@page "/eventos"
@rendermode InteractiveServer
@using Ludeka.Application.Contracts
@using Ludeka.Core.ValueObjects
@inject IBoardGameEventService EventService
@inject ICurrentUserService CurrentUserService
@inject IUserLocationService LocationService

<PageTitle>Grandes Citas y Ferias Lúdicas — Ludeka</PageTitle>

<div class="container-ludeka py-8 space-y-8">
    @* Cabecera editorial de página (INC-36, DD-06): componente compartido con el
       único h1 de la página y la acción de moderador en la zona Actions *@
    <PageHeaderEditorial Badge="Calendario Oficial del Sector"
                         BadgeIcon="tent"
                         Subtitle="La guía de referencia para los grandes festivales, convenciones y encuentros de juegos de mesa en España y el circuito internacional.">
        <Title>Grandes Citas, Ferias & Festivales</Title>
        <Actions>
            @if (IsModerator)
            {
                <button type="button"
                        @onclick="() => _isExpressModalOpen = true"
                        class="px-3.5 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs transition-all flex items-center gap-1.5 shadow-sm">
                    <Icon Name="zap" Size="12" /> Alta Exprés
                </button>
                <a href="/admin/eventos"
                   class="px-4 py-2 rounded-xl bg-[var(--brand-primary)] hover:opacity-90 text-[var(--on-brand)] font-bold text-xs transition-all flex items-center gap-1.5 shadow-sm">
                    <Icon Name="settings" Size="12" /> Gestionar Eventos
                </a>
            }
        </Actions>
    </PageHeaderEditorial>

    @* Pestañas de Navegación Temporal *@
    <div class="flex items-center gap-3 border-b border-[var(--border-subtle)]" role="tablist" aria-label="Pestañas de Eventos">
        <button type="button"
                id="tab-upcoming"
                role="tab"
                aria-selected="@(_activeTab == Tab.Upcoming ? "true" : "false")"
                aria-controls="panel-upcoming"
                @onclick="() => SwitchTab(Tab.Upcoming)"
                class="pb-3 px-2 text-sm font-bold border-b-2 transition-all flex items-center gap-2 @(_activeTab == Tab.Upcoming ? "border-[var(--brand-primary)] text-[var(--text-primary)]" : "border-transparent text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-500" aria-hidden="true"></span> Próximas Citas
            <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)]">@_upcomingEvents.Count</span>
        </button>

        <button type="button"
                id="tab-past"
                role="tab"
                aria-selected="@(_activeTab == Tab.Past ? "true" : "false")"
                aria-controls="panel-past"
                @onclick="() => SwitchTab(Tab.Past)"
                class="pb-3 px-2 text-sm font-bold border-b-2 transition-all flex items-center gap-2 @(_activeTab == Tab.Past ? "border-[var(--brand-primary)] text-[var(--text-primary)]" : "border-transparent text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
            <Icon Name="scroll" Size="14" /> Histórico de Ediciones
            <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)]">@_pastEvents.Count</span>
        </button>
    </div>

    @* Filtro Territorial de Eventos *@
    <div class="flex items-center justify-between flex-wrap gap-3">
        <div class="flex items-center gap-2 flex-wrap">
            <span class="text-xs text-[var(--text-muted)] mr-1">Ámbito:</span>
            <button type="button"
                    @onclick="() => SetCountryFilter(null)"
                    class="px-2.5 py-1 rounded-lg text-xs font-bold border transition-colors @(string.IsNullOrWhiteSpace(_countryFilter) ? "bg-[var(--brand-primary)] text-[var(--on-brand)] shadow-sm" : "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                <Icon Name="globe" Size="12" /> Todos (con Internacionales)
            </button>
            @if (!string.IsNullOrWhiteSpace(_userActiveCountry) && _userActiveCountry != "Internacional")
            {
                <button type="button"
                        @onclick="() => SetCountryFilter(_userActiveCountry)"
                        class="px-2.5 py-1 rounded-lg text-xs font-bold border transition-colors @(_countryFilter == _userActiveCountry ? "bg-[var(--brand-primary)] text-[var(--on-brand)] shadow-sm" : "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                    @CountryCatalog.GetFlag(_userActiveCountry) Solo @_userActiveCountry
                </button>
            }
            <select @bind="_countryFilter"
                    @bind:after="OnCountryDropdownChanged"
                    class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]">
                <option value="">Otros países...</option>
                @foreach (var c in CountryCatalog.GetAllCountries())
                {
                    <option value="@c.Name">@c.FlagEmoji @c.Name</option>
                }
            </select>
        </div>

        <span class="text-xs text-[var(--text-muted)]">
            <Icon Name="star" Size="12" /> Internacionales siempre visibles &bull; Filtra citas por país
        </span>
    </div>

    @* Panel de la pestaña activa (INC-36, DD-09): el id conmuta con la pestaña y la
       pestaña activa queda emparejada vía aria-labelledby (relación tab/panel completa) *@
    <div id="@ActivePanelId" role="tabpanel" aria-labelledby="@ActiveTabId">
        @if (_isLoading)
    {
        <div class="py-16 text-center text-[var(--text-muted)]">
            <div class="inline-block animate-spin mb-2"><Icon Name="tent" Size="30" /></div>
            <p class="text-sm font-semibold">Consultando el calendario oficial de eventos...</p>
        </div>
    }
    else
    {
        var currentList = _activeTab == Tab.Upcoming ? _upcomingEvents : _pastEvents;

        @if (currentList.Count == 0)
        {
            <div class="p-12 text-center rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)]">
                <span class="inline-block mb-3"><Icon Name="tent" Size="40" /></span>
                <h3 class="text-base font-bold text-[var(--text-primary)] mb-1">
                    @(_activeTab == Tab.Upcoming ? "No hay eventos futuros registrados" : "No hay eventos en el archivo histórico")
                </h3>
                <p class="text-xs text-[var(--text-secondary)] max-w-md mx-auto mb-4">
                    @(_activeTab == Tab.Upcoming ? "Pronto añadiremos nuevas fechas del calendario lúdico oficial." : "Las citas finalizadas se archivarán automáticamente aquí.")
                </p>
                @if (IsModerator)
                {
                    <a href="/admin/eventos"
                       class="px-3.5 py-1.5 rounded-xl bg-[var(--brand-primary)] hover:opacity-90 text-[var(--on-brand)] font-bold text-xs transition-opacity inline-flex items-center gap-1.5">
                        <Icon Name="plus" Size="12" /> Añadir Evento Ahora
                    </a>
                }
            </div>
        }
        else
        {
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3 sm:gap-4">
                @foreach (var evt in currentList)
                {
                    <div class="rail-card flex flex-col justify-between h-full shadow-sm">
                        <div class="flex flex-col flex-1">
                            <a href="/eventos/@evt.Id"
                               class="rail-cover rail-cover--square relative overflow-hidden block group cursor-pointer"
                               aria-label="Ver ficha del evento @evt.Title">
                                @if (string.IsNullOrWhiteSpace(evt.ImageUrl))
                                {
                                    <DefaultImage Domain="DefaultImageDomain.Evento"
                                                  Alt="@($"Cartel de {evt.Title}")"
                                                  CssClass="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <img src="@evt.ImageUrl"
                                         alt="Cartel de @evt.Title"
                                         width="240"
                                         height="240"
                                         loading="lazy"
                                         decoding="async"
                                         onerror="this.onerror=null; this.src='/images/defaults/evento-default.svg';"
                                         class="w-full h-full object-cover" />
                                }

                                @* Badges superiores: País y Urgencia / Estado *@
                                <div class="absolute top-2 left-2 z-10">
                                    <span class="px-2 py-0.5 rounded-md text-[0.65rem] font-bold border shadow-md backdrop-blur-md bg-black/60 text-white border-white/20 flex items-center gap-1">
                                        <span>@CountryCatalog.GetFlag(evt.Country)</span>
                                        <span class="hidden sm:inline">@(evt.IsInternational ? "Internacional" : evt.Country)</span>
                                    </span>
                                </div>

                                <div class="absolute top-2 right-2 z-10">
                                    <span class="px-2 py-0.5 rounded-md text-[0.65rem] font-black border shadow-md @GetRemainingBadgeClass(evt.RemainingDaysText)">
                                        @evt.RemainingDaysText
                                    </span>
                                </div>

                                @* Badge flotante inferior con fechas *@
                                <div class="absolute bottom-2 right-2 z-10 px-2 py-0.5 rounded-md text-[0.65rem] font-bold shadow-md border bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-primary)] flex items-center gap-1">
                                    <Icon Name="calendar-days" Size="11" />
                                    <span>@evt.FormattedDates</span>
                                </div>
                            </a>

                            @* Contenido: Ubicación, Título, Organizador *@
                            <div class="p-2 sm:p-3 flex flex-col flex-1">
                                <div class="flex items-center gap-1 text-[0.65rem] sm:text-xs font-semibold text-[var(--text-muted)] mb-1 truncate">
                                    <Icon Name="map-pin" Size="11" />
                                    <span class="truncate">@evt.Location</span>
                                </div>

                                <a href="/eventos/@evt.Id" class="block group mb-1">
                                    <h3 class="font-extrabold text-xs sm:text-sm text-[var(--text-primary)] group-hover:text-[var(--brand-primary)] transition-colors line-clamp-2 leading-snug">
                                        @evt.Title
                                    </h3>
                                </a>

                                @if (!string.IsNullOrWhiteSpace(evt.Organizer))
                                {
                                    <p class="text-[0.65rem] text-[var(--text-muted)] truncate mt-auto">
                                        @evt.Organizer
                                    </p>
                                }
                            </div>
                        </div>

                        @* Footer de acciones compactas *@
                        <div class="p-2 sm:p-2.5 pt-2 border-t border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)] flex items-center justify-between gap-2 mt-auto">
                            <span class="text-[0.62rem] text-[var(--text-muted)] font-medium truncate">
                                @(evt.IsOfficial ? "Oficial" : "Encuentro")
                            </span>

                            <div class="flex items-center gap-1 shrink-0">
                                <a href="/eventos/@evt.Id"
                                   class="px-2 py-1 rounded-lg bg-[var(--bg-card)] hover:bg-[var(--bg-surface)] text-[var(--text-primary)] border border-[var(--border-subtle)] font-bold text-[0.68rem] transition-colors"
                                   title="Ver ficha con todos los detalles">
                                    Ficha
                                </a>
                                @if (!string.IsNullOrWhiteSpace(evt.WebsiteUrl))
                                {
                                    <a href="@evt.WebsiteUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="px-2 py-1 rounded-lg bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-[var(--on-brand)] font-bold text-[0.68rem] transition-colors inline-flex items-center gap-0.5 shadow-sm"
                                       title="Ir a web oficial">
                                        <span>Web</span>
                                        <span>&rarr;</span>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    </div>
</div>

<SocialExpressIngestModal IsOpen="_isExpressModalOpen"
                          OnClose="() => _isExpressModalOpen = false"
                          OnItemCreated="HandleExpressItemCreated" />

@code {
    private enum Tab { Upcoming, Past }
    private Tab _activeTab = Tab.Upcoming;
    private bool _isLoading = true;
    private bool _isExpressModalOpen;
    private string? _userActiveCountry;
    private string? _countryFilter;

    private IReadOnlyList<BoardGameEventDto> _upcomingEvents = new List<BoardGameEventDto>();
    private IReadOnlyList<BoardGameEventDto> _pastEvents = new List<BoardGameEventDto>();

    private bool IsModerator => CurrentUserService.IsFoundingTeam || CurrentUserService.IsInRole("Moderator");

    // Identificadores ARIA de la pestaña activa y su panel (relación tab/tabpanel de
    // la spec editorial-page-foundations): expresiones completas en el atributo,
    // nunca @ pegado a texto (gotcha Razor de INC-36)
    private string ActiveTabId => _activeTab == Tab.Upcoming ? "tab-upcoming" : "tab-past";
    private string ActivePanelId => _activeTab == Tab.Upcoming ? "panel-upcoming" : "panel-past";

    protected override async Task OnInitializedAsync()
    {
        _userActiveCountry = await LocationService.GetEffectiveCountryAsync();
        _countryFilter = _userActiveCountry;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _upcomingEvents = await EventService.GetUpcomingEventsAsync(limit: 50, country: _countryFilter);
            _pastEvents = await EventService.GetPastEventsAsync(limit: 50, country: _countryFilter);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SetCountryFilter(string? country)
    {
        _countryFilter = country;
        await LoadDataAsync();
    }

    private async Task OnCountryDropdownChanged()
    {
        await LoadDataAsync();
    }

    private void SwitchTab(Tab tab)
    {
        _activeTab = tab;
    }

    private string GetRemainingBadgeClass(string remainingText)
    {
        // INC-36 (DD-04): badges de urgencia con tokens semánticos de estado del tema
        // (+--on-brand). El overlay «Finalizado» conserva su familia blanca neutra sobre
        // bg-black/60: contrata contra la fotografía del cartel, no contra el tema
        // (excepción contratada del barrido, igual que los badges territoriales).
        if (remainingText.Contains("curso", StringComparison.OrdinalIgnoreCase))
            return "bg-[var(--state-error)] text-[var(--on-brand)] border-[var(--state-error-border)] animate-pulse";

        if (remainingText.Contains("hoy", StringComparison.OrdinalIgnoreCase) || remainingText.Contains("mañana", StringComparison.OrdinalIgnoreCase))
            return "bg-[var(--state-warning)] text-[var(--on-brand)] border-[var(--state-warning-border)] font-black";

        if (remainingText.Contains("Finalizado", StringComparison.OrdinalIgnoreCase))
            return "bg-black/60 text-white/80 border-white/10";

        return "bg-black/60 text-white border-white/20";
    }

    private async Task HandleExpressItemCreated(Ludeka.Application.DTOs.SocialInboxItemDto item)
    {
        _isExpressModalOpen = false;
        await LoadDataAsync();
    }
}
