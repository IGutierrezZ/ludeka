@page "/cuenta/ludoteca"
@page "/mi-ludoteca"
@rendermode InteractiveServer
@using Ludeka.Application.Contracts
@using Ludeka.Application.DTOs
@using Ludeka.Core.ValueObjects
@inject IUserLibraryService LibraryService
@inject IGamePlayLogService PlayLogService
@inject ICurrentUserService CurrentUserService
@inject IUserPreferenceService PreferenceService
@inject IUserLocationService LocationService
@inject IUserLibraryStatsService StatsService
@inject IPriceRadarService PriceRadarService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Mi Ludoteca Personal — Ludeka</PageTitle>

<div class="container-ludeka py-8 space-y-8">

    @* Cabecera de la sección *@
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-[var(--border-subtle)] pb-6">
        <div>
            <div class="flex items-center gap-2 mb-2">
                <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border border-[var(--border-subtle)]">
                    Tu Espacio Lúdico
                </span>
                <span class="text-xs text-[var(--text-secondary)]">Sesión activa como <strong class="text-[var(--text-primary)]">@CurrentUserService.UserName</strong></span>
            </div>
            <h1 class="text-3xl sm:text-4xl font-black text-[var(--text-primary)] tracking-tight">
                Mi Ludoteca Personal
            </h1>
            <p class="text-sm text-[var(--text-secondary)] mt-1">
                Gestiona tus copias físicas en propiedad, títulos jugados, lista de compra y tu diario de partidas y préstamos.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <button type="button"
                    disabled="@_isOfflineMode"
                    @onclick="OpenBggImportModal"
                    class="px-4 py-2 rounded-xl text-xs font-bold @(_isOfflineMode ? "opacity-50 cursor-not-allowed bg-zinc-600 text-zinc-300" : "bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-white") transition-all inline-flex items-center gap-1.5 shadow-sm"
                    title="@(_isOfflineMode ? "La importación de BGG requiere conexión a internet" : "")">
                <Icon Name="download" Size="14" />
                <span>Importar BGG</span>
            </button>
            <button type="button"
                    disabled="@_isOfflineMode"
                    @onclick="OpenBggSearchModal"
                    class="px-4 py-2 rounded-xl text-xs font-bold @(_isOfflineMode ? "opacity-50 cursor-not-allowed bg-zinc-700 text-zinc-400" : "bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-card)] text-[var(--text-primary)] border border-[var(--border-subtle)]") transition-colors inline-flex items-center gap-1.5 shadow-sm"
                    title="@(_isOfflineMode ? "La búsqueda asistida requiere conexión a internet" : "")">
                <Icon Name="dices" Size="14" />
                <span>+ Añadir por BGG</span>
            </button>
            <a href="/" class="px-4 py-2 rounded-xl text-xs font-bold bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-card)] text-[var(--text-secondary)] border border-[var(--border-subtle)] transition-colors inline-flex items-center gap-1.5 shadow-sm">
                <Icon Name="search" Size="14" />
                <span>Explorar Catálogo</span>
            </a>
        </div>
    </div>

    @* Invitación al acceso: sin sesión no hay ludoteca ni preferencias que persistir (INC-46 F4) *@
    @if (!HasSession)
    {
        <div class="p-4 rounded-2xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs shadow-sm" role="status">
            <div class="flex items-center gap-2 text-[var(--text-secondary)] font-medium">
                <span><Icon Name="user" Size="14" /></span>
                <span>
                    <strong class="text-[var(--text-primary)]">Estás navegando sin sesión.</strong>
                    Tu ludoteca, tu diario de partidas, tus préstamos y tus preferencias se guardan asociados a tu cuenta.
                </span>
            </div>
            <a href="@ExternalAuthenticationSchemes.LoginPath"
               class="px-3.5 py-1.5 rounded-xl bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-white font-bold self-start sm:self-auto transition-colors flex items-center gap-1.5 shadow-sm">
                <Icon Name="shield" Size="14" />
                <span>Inicia sesión para guardar</span>
            </a>
        </div>
    }

    @if (_isOfflineMode)
    {
        <div class="p-4 rounded-2xl bg-amber-500/10 border border-amber-500/25 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs shadow-sm" role="status">
            <div class="flex items-center gap-2 text-amber-600 dark:text-amber-400 font-medium">
                <span><Icon Name="wifi-off" Size="14" /></span>
                <span>
                    <strong>Modo Consulta Offline activo:</strong> Mostrando los títulos guardados en este dispositivo
                    @if (!string.IsNullOrWhiteSpace(_offlineTimestamp))
                    {
                        <span>(última sincronización: @_offlineTimestamp)</span>
                    }.
                </span>
            </div>
            <button type="button" 
                    @onclick="LoadSummaryAsync"
                    class="px-3.5 py-1.5 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 text-amber-700 dark:text-amber-300 font-bold self-start sm:self-auto transition-colors flex items-center gap-1.5 shadow-sm">
                <Icon Name="refresh-cw" Size="14" />
                <span>Reconectar</span>
            </button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="py-20 text-center text-[var(--text-secondary)]">
            <div class="inline-block animate-spin mb-3"><Icon Name="dices" Size="36" /></div>
            <p class="text-base font-semibold">Cargando tu ludoteca...</p>
        </div>
    }
    else if (_summary != null)
    {
        @* Pestañas Horizontales *@
        <div class="flex flex-wrap gap-2 border-b border-[var(--border-subtle)] pb-2" role="tablist" aria-label="Secciones de la ludoteca personal">
            <button type="button"
                    id="tab-incollection"
                    role="tab"
                    aria-selected="@(_activeTab == TabType.InCollection ? "true" : "false")"
                    aria-controls="panel-collection"
                    @onclick="() => _activeTab = TabType.InCollection"
                    class="px-4 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 @GetTabClass(TabType.InCollection)">
                <span class="inline-flex items-center gap-1.5"><Icon Name="library" Size="14" /> En mi ludoteca</span>
                <span class="px-2 py-0.5 rounded-full text-[0.68rem] font-black @GetBadgeClass(TabType.InCollection)">
                    @_summary.TotalInCollection
                </span>
            </button>

            <button type="button"
                    id="tab-played"
                    role="tab"
                    aria-selected="@(_activeTab == TabType.Played ? "true" : "false")"
                    aria-controls="panel-collection"
                    @onclick="() => _activeTab = TabType.Played"
                    class="px-4 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 @GetTabClass(TabType.Played)">
                <span class="inline-flex items-center gap-1.5"><Icon Name="dices" Size="14" /> Jugados</span>
                <span class="px-2 py-0.5 rounded-full text-[0.68rem] font-black @GetBadgeClass(TabType.Played)">
                    @_summary.TotalPlayed
                </span>
            </button>

            <button type="button"
                    id="tab-wanttobuy"
                    role="tab"
                    aria-selected="@(_activeTab == TabType.WantToBuy ? "true" : "false")"
                    aria-controls="panel-collection"
                    @onclick="() => _activeTab = TabType.WantToBuy"
                    class="px-4 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 @GetTabClass(TabType.WantToBuy)">
                <span class="inline-flex items-center gap-1.5"><Icon Name="shopping-cart" Size="14" /> Comprar</span>
                <span class="px-2 py-0.5 rounded-full text-[0.68rem] font-black @GetBadgeClass(TabType.WantToBuy)">
                    @_summary.TotalWantToBuy
                </span>
            </button>

            <button type="button"
                    id="tab-plays"
                    role="tab"
                    aria-selected="@(_activeTab == TabType.Plays ? "true" : "false")"
                    aria-controls="panel-plays"
                    @onclick="SwitchToPlaysAsync"
                    class="px-4 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 @GetTabClass(TabType.Plays)">
                <span class="inline-flex items-center gap-1.5"><Icon Name="notebook-pen" Size="14" /> Diario de Partidas</span>
                @if (_playsStats != null && _playsStats.TotalPlays > 0)
                {
                    <span class="px-2 py-0.5 rounded-full text-[0.68rem] font-black @GetBadgeClass(TabType.Plays)">
                        @_playsStats.TotalPlays
                    </span>
                }
            </button>

            <button type="button"
                    id="tab-loans"
                    role="tab"
                    aria-selected="@(_activeTab == TabType.Loans ? "true" : "false")"
                    aria-controls="panel-loans"
                    @onclick="() => _activeTab = TabType.Loans"
                    class="px-4 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 @GetTabClass(TabType.Loans)">
                <span class="inline-flex items-center gap-1.5"><Icon Name="package" Size="14" /> Préstamos</span>
                <span class="px-2 py-0.5 rounded-full text-[0.68rem] font-black @GetBadgeClass(TabType.Loans)">
                    @_summary.TotalActiveLoans
                </span>
            </button>

            <button type="button"
                    id="tab-queue"
                    role="tab"
                    aria-selected="@(_activeTab == TabType.Queue ? "true" : "false")"
                    aria-controls="panel-queue"
                    @onclick="() => _activeTab = TabType.Queue"
                    class="px-4 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 @GetTabClass(TabType.Queue)">
                <span class="inline-flex items-center gap-1.5"><Icon Name="hourglass" Size="14" /> Cola comunitaria</span>
            </button>

            <button type="button"
                    id="tab-appearance"
                    role="tab"
                    aria-selected="@(_activeTab == TabType.Appearance ? "true" : "false")"
                    aria-controls="panel-appearance"
                    @onclick="() => _activeTab = TabType.Appearance"
                    class="px-4 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 @GetTabClass(TabType.Appearance)">
                <span class="inline-flex items-center gap-1.5"><Icon Name="palette" Size="14" /> Apariencia &amp; <Icon Name="globe" Size="14" /> País</span>
            </button>

            <button type="button"
                    id="tab-stats"
                    role="tab"
                    aria-selected="@(_activeTab == TabType.Stats ? "true" : "false")"
                    aria-controls="panel-stats"
                    @onclick="SwitchToStatsAsync"
                    class="px-4 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 @GetTabClass(TabType.Stats)">
                <span class="inline-flex items-center gap-1.5"><Icon Name="dna" Size="14" /> ADN y Estadísticas</span>
            </button>
        </div>

        @* Contenido de la pestaña activa *@
        @if (_activeTab == TabType.Appearance)
        {
            <div id="panel-appearance" role="tabpanel" aria-labelledby="tab-appearance" class="space-y-6">
                <div class="p-6 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)]">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <div class="flex items-center gap-2 mb-1">
                                <Icon Name="palette" Size="20" />
                                <h2 class="text-xl font-bold text-[var(--text-primary)]">
                                    Estilo Visual y Paleta de tu Mesa
                                </h2>
                            </div>
                            <p class="text-xs sm:text-sm text-[var(--text-secondary)]">
                                Personaliza los colores de Ludeka para tu usuario (<strong class="text-[var(--text-primary)]">@CurrentUserService.UserName</strong>). Tu selección se guardará en tu perfil y se cargará automáticamente en todas tus sesiones.
                            </p>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_saveMessage))
                        {
                            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-bold shrink-0">
                                <span>✓</span>
                                <span>@_saveMessage</span>
                            </div>
                        }
                    </div>

                    @* Grid de Temas *@
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mt-6">
                        @* 1. Papel *@
                        <div class="p-5 rounded-2xl border transition-all flex flex-col justify-between gap-4 cursor-pointer @(_userCurrentTheme == "editorial" ? "border-[var(--brand-primary)] bg-[var(--bg-surface-elevated)] ring-2 ring-[var(--brand-primary)]/20" : "border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:border-[var(--border-highlight)]")"
                             @onclick='() => SelectUserTheme("editorial")'>
                            <div>
                                <div class="flex items-center justify-between mb-2">
                                    <div class="flex items-center gap-2">
                                        <Icon Name="book-open" Size="18" />
                                        <h3 class="text-sm font-black text-[var(--text-primary)]">Papel & Tinta</h3>
                                    </div>
                                    @if (_userCurrentTheme == "editorial")
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-[0.65rem] font-black bg-[var(--brand-primary)] text-white">Activo</span>
                                    }
                                </div>
                                <p class="text-xs text-[var(--text-secondary)] mb-4">
                                    Editorial Claro. Inspirado en libros, reglamentos impresos y fanzines. Fondo blanco roto de máxima legibilidad y tinta oscura.
                                </p>
                            </div>
                            <div class="flex items-center justify-between pt-3 border-t border-[var(--border-subtle)]">
                                <div class="flex items-center gap-1.5">
                                    <span class="w-5 h-5 rounded-full border border-black/10 inline-block shadow-sm" style="background-color: #F8F7F4;" title="Fondo Papel (#F8F7F4)"></span>
                                    <span class="w-5 h-5 rounded-full border border-black/10 inline-block shadow-sm" style="background-color: #FFFFFF;" title="Superficie (#FFFFFF)"></span>
                                    <span class="w-5 h-5 rounded-full border border-black/10 inline-block shadow-sm" style="background-color: #B8432F;" title="Tinta Roja (#B8432F)"></span>
                                    <span class="w-5 h-5 rounded-full border border-black/10 inline-block shadow-sm" style="background-color: #121417;" title="Texto (#121417)"></span>
                                </div>
                                <button type="button" class="px-3 py-1.5 rounded-lg text-xs font-bold @(_userCurrentTheme == "editorial" ? "bg-[var(--brand-primary)] text-white" : "bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)]")">
                                    @(_userCurrentTheme == "editorial" ? "En uso" : "Aplicar")
                                </button>
                            </div>
                        </div>

                        @* 2. Madera Clara (NUEVO) *@
                        <div class="p-5 rounded-2xl border transition-all flex flex-col justify-between gap-4 cursor-pointer @(_userCurrentTheme == "wood" ? "border-[var(--brand-primary)] bg-[var(--bg-surface-elevated)] ring-2 ring-[var(--brand-primary)]/20" : "border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:border-[var(--border-highlight)]")"
                             @onclick='() => SelectUserTheme("wood")'>
                            <div>
                                <div class="flex items-center justify-between mb-2">
                                    <div class="flex items-center gap-2">
                                        <Icon Name="tree-pine" Size="18" />
                                        <h3 class="text-sm font-black text-[var(--text-primary)]">Madera Clara</h3>
                                    </div>
                                    @if (_userCurrentTheme == "wood")
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-[0.65rem] font-black bg-[var(--brand-primary)] text-white">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-[0.65rem] font-black bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20">Nuevo</span>
                                    }
                                </div>
                                <p class="text-xs text-[var(--text-secondary)] mb-4">
                                    Arce & Haya Lúdica. Inspirado en mesas nórdicas de juego y componentes de madera noble clara. Cálido, luminoso y acogedor.
                                </p>
                            </div>
                            <div class="flex items-center justify-between pt-3 border-t border-[var(--border-subtle)]">
                                <div class="flex items-center gap-1.5">
                                    <span class="w-5 h-5 rounded-full border border-black/10 inline-block shadow-sm" style="background-color: #F5EFEB;" title="Fondo Madera Clara (#F5EFEB)"></span>
                                    <span class="w-5 h-5 rounded-full border border-black/10 inline-block shadow-sm" style="background-color: #FAF6F1;" title="Superficie (#FAF6F1)"></span>
                                    <span class="w-5 h-5 rounded-full border border-black/10 inline-block shadow-sm" style="background-color: #B85323;" title="Acento Ámbar Tostado (#B85323)"></span>
                                    <span class="w-5 h-5 rounded-full border border-black/10 inline-block shadow-sm" style="background-color: #2D2118;" title="Texto Nogal Oscuro (#2D2118)"></span>
                                </div>
                                <button type="button" class="px-3 py-1.5 rounded-lg text-xs font-bold @(_userCurrentTheme == "wood" ? "bg-[var(--brand-primary)] text-white" : "bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)]")">
                                    @(_userCurrentTheme == "wood" ? "En uso" : "Aplicar")
                                </button>
                            </div>
                        </div>

                        @* 3. Mesa Cálida *@
                        <div class="p-5 rounded-2xl border transition-all flex flex-col justify-between gap-4 cursor-pointer @(_userCurrentTheme == "tabletop" ? "border-[var(--brand-primary)] bg-[var(--bg-surface-elevated)] ring-2 ring-[var(--brand-primary)]/20" : "border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:border-[var(--border-highlight)]")"
                             @onclick='() => SelectUserTheme("tabletop")'>
                            <div>
                                <div class="flex items-center justify-between mb-2">
                                    <div class="flex items-center gap-2">
                                        <Icon Name="dices" Size="18" />
                                        <h3 class="text-sm font-black text-[var(--text-primary)]">Mesa Cálida</h3>
                                    </div>
                                    @if (_userCurrentTheme == "tabletop")
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-[0.65rem] font-black bg-[var(--brand-primary)] text-white">Activo</span>
                                    }
                                </div>
                                <p class="text-xs text-[var(--text-secondary)] mb-4">
                                    Madera Espresso & Tapete. Tono de mesa nocturna en club de juegos. Marrones chocolate profundo y texto pergamino cálido.
                                </p>
                            </div>
                            <div class="flex items-center justify-between pt-3 border-t border-[var(--border-subtle)]">
                                <div class="flex items-center gap-1.5">
                                    <span class="w-5 h-5 rounded-full border border-white/10 inline-block shadow-sm" style="background-color: #1A1412;" title="Fondo Espresso (#1A1412)"></span>
                                    <span class="w-5 h-5 rounded-full border border-white/10 inline-block shadow-sm" style="background-color: #28201B;" title="Superficie (#28201B)"></span>
                                    <span class="w-5 h-5 rounded-full border border-white/10 inline-block shadow-sm" style="background-color: #D97736;" title="Acento Caramelo (#D97736)"></span>
                                    <span class="w-5 h-5 rounded-full border border-white/10 inline-block shadow-sm" style="background-color: #F7EFE6;" title="Texto Crema (#F7EFE6)"></span>
                                </div>
                                <button type="button" class="px-3 py-1.5 rounded-lg text-xs font-bold @(_userCurrentTheme == "tabletop" ? "bg-[var(--brand-primary)] text-white" : "bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)]")">
                                    @(_userCurrentTheme == "tabletop" ? "En uso" : "Aplicar")
                                </button>
                            </div>
                        </div>

                        @* 4. Azul Medianoche *@
                        <div class="p-5 rounded-2xl border transition-all flex flex-col justify-between gap-4 cursor-pointer @(_userCurrentTheme == "midnight" ? "border-[var(--brand-primary)] bg-[var(--bg-surface-elevated)] ring-2 ring-[var(--brand-primary)]/20" : "border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:border-[var(--border-highlight)]")"
                             @onclick='() => SelectUserTheme("midnight")'>
                            <div>
                                <div class="flex items-center justify-between mb-2">
                                    <div class="flex items-center gap-2">
                                        <Icon Name="moon-star" Size="18" />
                                        <h3 class="text-sm font-black text-[var(--text-primary)]">Azul Medianoche</h3>
                                    </div>
                                    @if (_userCurrentTheme == "midnight")
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-[0.65rem] font-black bg-[var(--brand-primary)] text-white">Activo</span>
                                    }
                                </div>
                                <p class="text-xs text-[var(--text-secondary)] mb-4">
                                    Cian & Lima Digital. Alto contraste sobre azul espacial profundo. Ideal para sesiones nocturnas con aire contemporáneo.
                                </p>
                            </div>
                            <div class="flex items-center justify-between pt-3 border-t border-[var(--border-subtle)]">
                                <div class="flex items-center gap-1.5">
                                    <span class="w-5 h-5 rounded-full border border-white/10 inline-block shadow-sm" style="background-color: #090E1A;" title="Fondo Marino (#090E1A)"></span>
                                    <span class="w-5 h-5 rounded-full border border-white/10 inline-block shadow-sm" style="background-color: #121C34;" title="Superficie (#121C34)"></span>
                                    <span class="w-5 h-5 rounded-full border border-white/10 inline-block shadow-sm" style="background-color: #06B6D4;" title="Acento Cian (#06B6D4)"></span>
                                    <span class="w-5 h-5 rounded-full border border-white/10 inline-block shadow-sm" style="background-color: #F1F5F9;" title="Texto Blanco Hielo (#F1F5F9)"></span>
                                </div>
                                <button type="button" class="px-3 py-1.5 rounded-lg text-xs font-bold @(_userCurrentTheme == "midnight" ? "bg-[var(--brand-primary)] text-white" : "bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)]")">
                                    @(_userCurrentTheme == "midnight" ? "En uso" : "Aplicar")
                                </button>
                            </div>
                        </div>

                        @* 5. Carbón Oscuro *@
                        <div class="p-5 rounded-2xl border transition-all flex flex-col justify-between gap-4 cursor-pointer @(_userCurrentTheme == "charcoal" ? "border-[var(--brand-primary)] bg-[var(--bg-surface-elevated)] ring-2 ring-[var(--brand-primary)]/20" : "border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:border-[var(--border-highlight)]")"
                             @onclick='() => SelectUserTheme("charcoal")'>
                            <div>
                                <div class="flex items-center justify-between mb-2">
                                    <div class="flex items-center gap-2">
                                        <Icon Name="moon" Size="18" />
                                        <h3 class="text-sm font-black text-[var(--text-primary)]">Carbón Oscuro</h3>
                                    </div>
                                    @if (_userCurrentTheme == "charcoal")
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-[0.65rem] font-black bg-[var(--brand-primary)] text-white">Activo</span>
                                    }
                                </div>
                                <p class="text-xs text-[var(--text-secondary)] mb-4">
                                    Terracota & Pizarra. La estética insignia de Ludeka. Sobriedad, elegancia y acento naranja cálido.
                                </p>
                            </div>
                            <div class="flex items-center justify-between pt-3 border-t border-[var(--border-subtle)]">
                                <div class="flex items-center gap-1.5">
                                    <span class="w-5 h-5 rounded-full border border-white/10 inline-block shadow-sm" style="background-color: #14181C;" title="Fondo Carbón (#14181C)"></span>
                                    <span class="w-5 h-5 rounded-full border border-white/10 inline-block shadow-sm" style="background-color: #1F262D;" title="Superficie (#1F262D)"></span>
                                    <span class="w-5 h-5 rounded-full border border-white/10 inline-block shadow-sm" style="background-color: #E05A38;" title="Acento Terracota (#E05A38)"></span>
                                    <span class="w-5 h-5 rounded-full border border-white/10 inline-block shadow-sm" style="background-color: #FFFFFF;" title="Texto Blanco (#FFFFFF)"></span>
                                </div>
                                <button type="button" class="px-3 py-1.5 rounded-lg text-xs font-bold @(_userCurrentTheme == "charcoal" ? "bg-[var(--brand-primary)] text-white" : "bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)]")">
                                    @(_userCurrentTheme == "charcoal" ? "En uso" : "Aplicar")
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                @* Tarjeta de Ubicación y Filtrado de País (Incremento 29) *@
                <div class="p-6 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <div class="flex items-center gap-2 mb-1">
                                <Icon Name="globe" Size="20" />
                                <h2 class="text-xl font-bold text-[var(--text-primary)]">
                                    Ubicación y Filtrado Territorial
                                </h2>
                            </div>
                            <p class="text-xs sm:text-sm text-[var(--text-secondary)]">
                                Define tu país de residencia para filtrar tiendas con envíos a tu territorio, sorteos y eventos lúdicos.
                            </p>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_countrySaveMessage))
                        {
                            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-bold shrink-0">
                                <span>✓</span>
                                <span>@_countrySaveMessage</span>
                            </div>
                        }
                    </div>

                    @* Advertencia Obligatoria *@
                    <div class="p-4 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-500 dark:text-amber-400 text-xs space-y-1.5">
                        <div class="flex items-center gap-1.5 font-black text-sm">
                            <Icon Name="triangle-alert" Size="14" />
                            <span>Aviso Importante sobre el Filtrado por País</span>
                        </div>
                        <p class="leading-relaxed">
                            Al seleccionar un país, los sorteos, eventos y tiendas se filtrarán automáticamente para mostrar únicamente los disponibles en tu territorio. Si prefieres explorar toda la información de la comunidad global sin filtrar, déjalo sin seleccionar.
                        </p>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-center pt-2">
                        <div>
                            <label class="font-bold text-xs text-[var(--text-secondary)] block mb-1.5">
                                País seleccionado para tu usuario:
                            </label>
                            <select @bind="_userCurrentCountry"
                                    @bind:after="OnCountrySelectChangedAsync"
                                    class="w-full px-3.5 py-2.5 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand-primary)]">
                                <option value="">Sin país (Global - Todo visible sin filtrar)</option>
                                @foreach (var c in CountryCatalog.GetAllCountries())
                                {
                                    <option value="@c.Name">@c.FlagEmoji @c.Name (@c.Code)</option>
                                }
                            </select>
                        </div>

                        <div class="flex flex-col justify-end sm:pt-6">
                            <button type="button"
                                    @onclick="AutoDetectCountryAsync"
                                    class="px-4 py-2.5 rounded-xl bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-card)] border border-[var(--border-subtle)] hover:border-[var(--brand-primary)] text-xs font-bold text-[var(--text-primary)] transition-all flex items-center justify-center gap-2 shadow-sm">
                                <Icon Name="map-pin" Size="12" />
                                <span>Detectar automáticamente por zona horaria</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (_activeTab == TabType.Stats)
        {
            <div id="panel-stats" role="tabpanel" aria-labelledby="tab-stats" class="space-y-6">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-5 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)]">
                    <div>
                        <h2 class="text-base font-bold text-[var(--text-primary)] flex items-center gap-2">
                            <Icon Name="dna" Size="14" />
                            <span>ADN de tu Estantería y Analíticas de Colección</span>
                        </h2>
                        <p class="text-xs text-[var(--text-secondary)] mt-0.5">
                            Métricas calculadas en vivo a partir de tus títulos físicos en posesión («En mi ludoteca»).
                        </p>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                        @if (HasSession)
                        {
                            <button type="button"
                                    @onclick="CopyPublicProfileLinkAsync"
                                    class="px-3.5 py-2 rounded-xl text-xs font-bold bg-[var(--bg-surface)] hover:bg-[var(--bg-surface-elevated)] text-[var(--text-primary)] border border-[var(--border-subtle)] transition-all flex items-center gap-1.5 shadow-sm">
                                <Icon Name="@(_copiedProfileLink ? "check" : "copy")" Size="12" />
                                <span>@(_copiedProfileLink ? "¡Enlace copiado!" : "Copiar enlace de mi perfil")</span>
                            </button>
                            <a href="@PublicProfilePath"
                               target="_blank"
                               class="px-3.5 py-2 rounded-xl text-xs font-bold bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-white transition-all flex items-center gap-1.5 shadow-sm">
                                <Icon Name="eye" Size="12" />
                                <span>Ver Perfil Público</span>
                            </a>
                        }
                        else
                        {
                            <a href="@ExternalAuthenticationSchemes.LoginPath"
                               class="px-3.5 py-2 rounded-xl text-xs font-bold bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-white transition-all flex items-center gap-1.5 shadow-sm">
                                <Icon Name="shield" Size="12" />
                                <span>Inicia sesión para publicar tu perfil</span>
                            </a>
                        }
                    </div>
                </div>

                @if (_isLoadingStats)
                {
                    <div class="py-20 text-center text-[var(--text-secondary)]">
                        <div class="inline-block animate-spin mb-3"><Icon Name="dna" Size="36" /></div>
                        <p class="text-base font-semibold">Analizando el ADN de tu estantería...</p>
                    </div>
                }
                else if (_stats != null)
                {
                    <LibraryStatsDashboard Stats="_stats" />
                }
            </div>
        }
        else if (_activeTab == TabType.Queue)
        {
            <div id="panel-queue" role="tabpanel" aria-labelledby="tab-queue">
                <CatalogQueuePanel OnQueueProcessed="LoadSummaryAsync" />
            </div>
        }
        else if (_activeTab == TabType.Plays)
        {
            <div id="panel-plays" role="tabpanel" aria-labelledby="tab-plays" class="space-y-6">
                @if (_isLoadingPlays)
                {
                    <div class="py-20 text-center text-[var(--text-secondary)]">
                        <div class="inline-block animate-spin mb-3"><Icon Name="dices" Size="36" /></div>
                        <p class="text-base font-semibold">Cargando tu diario de partidas...</p>
                    </div>
                }
                else
                {
                    @* Panel de Métricas de Partidas *@
                    @if (_playsStats != null && _playsStats.TotalPlays > 0)
                    {
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                            <div class="p-4 rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)]">
                                <span class="text-[0.68rem] uppercase font-bold text-[var(--text-muted)] block mb-1">Total Partidas</span>
                                <span class="text-2xl font-black text-[var(--text-primary)]">@_playsStats.TotalPlays</span>
                            </div>
                            <div class="p-4 rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)]">
                                <span class="text-[0.68rem] uppercase font-bold text-[var(--text-muted)] block mb-1">Este Mes</span>
                                <span class="text-2xl font-black text-amber-500">@_playsStats.PlaysThisMonth</span>
                            </div>
                            <div class="p-4 rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)]">
                                <span class="text-[0.68rem] uppercase font-bold text-[var(--text-muted)] block mb-1">Más Jugado</span>
                                <span class="text-xs font-bold text-[var(--text-primary)] truncate block" title="@_playsStats.MostPlayedGameTitle">
                                    @(_playsStats.MostPlayedGameTitle ?? "—")
                                </span>
                                @if (_playsStats.MostPlayedGameCount > 0)
                                {
                                    <span class="text-[0.65rem] text-[var(--brand-primary)] font-semibold">(@_playsStats.MostPlayedGameCount partidas)</span>
                                }
                            </div>
                            <div class="p-4 rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)]">
                                <span class="text-[0.68rem] uppercase font-bold text-[var(--text-muted)] block mb-1">Lugar Favorito</span>
                                <span class="text-xs font-bold text-[var(--text-primary)] truncate block" title="@_playsStats.FavoriteLocation">
                                    @(_playsStats.FavoriteLocation ?? "—")
                                </span>
                                @if (_playsStats.MostCommonPlayerCount.HasValue)
                                {
                                    <span class="text-[0.65rem] text-[var(--text-muted)]">(@_playsStats.MostCommonPlayerCount jug. habitual)</span>
                                }
                            </div>
                        </div>
                    }

                    @* Listado de Partidas Cronológicas *@
                    @if (_userPlayLogs == null || _userPlayLogs.Count == 0)
                    {
                        <div class="py-16 text-center max-w-md mx-auto p-8 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)]">
                            <span class="inline-block mb-3"><Icon Name="dices" Size="40" /></span>
                            <h3 class="text-lg font-bold text-[var(--text-primary)] mb-1">Tu diario de partidas está vacío</h3>
                            <p class="text-xs text-[var(--text-secondary)] mb-6">
                                Registra cada sesión con fecha, lugar, número de jugadores y notas desde la ficha de cualquier juego.
                            </p>
                            <a href="/" class="px-4 py-2.5 rounded-xl text-xs font-bold bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-white transition-colors inline-block shadow-sm">
                                Explorar Catálogo para Registrar Partida
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-3">
                            <div class="flex items-center justify-between px-1">
                                <span class="text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider">Historial de Sesiones</span>
                                <span class="text-xs text-[var(--text-muted)]">@_userPlayLogs.Count registradas</span>
                            </div>

                            <div class="divide-y divide-[var(--border-subtle)] rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] overflow-hidden shadow-sm">
                                @foreach (var play in _userPlayLogs)
                                {
                                    <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-[var(--bg-surface)] transition-colors">
                                        <div class="flex items-start sm:items-center gap-3.5 min-w-0">
                                            <a href="/juegos/@play.GameSlug" class="shrink-0 w-12 h-12 rounded-xl overflow-hidden border border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)] block">
                                                @if (!string.IsNullOrWhiteSpace(play.GameCoverUrl))
                                                {
                                                    <img src="@play.GameCoverUrl" alt="@play.GameTitle" class="w-full h-full object-cover" />
                                                }
                                                else
                                                {
                                                    <img src="/images/game-placeholder.svg" alt="@play.GameTitle" class="w-full h-full object-cover opacity-80" />
                                                }
                                            </a>
                                            <div class="min-w-0">
                                                <a href="/juegos/@play.GameSlug" class="text-sm font-bold text-[var(--text-primary)] hover:text-[var(--brand-primary)] transition-colors block truncate">
                                                    @play.GameTitle
                                                </a>
                                                <div class="flex flex-wrap items-center gap-2 mt-1 text-xs text-[var(--text-secondary)]">
                                                    <span class="inline-flex items-center gap-1 font-semibold text-[var(--text-primary)]">
                                                        <Icon Name="calendar" Size="12" /> @play.PlayDate.ToString("dd/MM/yyyy")
                                                    </span>
                                                    <span>·</span>
                                                    <span class="inline-flex items-center gap-1">
                                                        <Icon Name="users" Size="12" /> @play.PlayerCount @(play.PlayerCount == 1 ? "jugador" : "jugadores")
                                                    </span>
                                                    <span>·</span>
                                                    <span class="inline-flex items-center gap-1">
                                                        <Icon Name="map-pin" Size="12" /> @play.Location
                                                    </span>
                                                    @if (play.DurationMinutes.HasValue)
                                                    {
                                                        <span>·</span>
                                                        <span class="inline-flex items-center gap-1">
                                                            <Icon Name="timer" Size="12" /> @(play.DurationMinutes)m
                                                        </span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(play.Comment))
                                                {
                                                    <p class="text-xs text-[var(--text-secondary)] italic mt-2 line-clamp-2 bg-[var(--bg-surface-elevated)] p-2 rounded-lg border border-[var(--border-subtle)]">
                                                        &ldquo;@play.Comment&rdquo;
                                                    </p>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        }
        else if (_activeTab == TabType.Loans)
        {
            @* Vista de Préstamos Activos *@
            <div id="panel-loans" role="tabpanel" aria-labelledby="tab-loans">
                @if (_summary.ActiveLoans.Count == 0)
                {
                    <div class="py-16 text-center max-w-md mx-auto p-8 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)]">
                        <span class="inline-block mb-3"><Icon Name="handshake" Size="40" /></span>
                        <h3 class="text-lg font-bold text-[var(--text-primary)] mb-1">Todos tus juegos están a buen recaudo</h3>
                        <p class="text-xs text-[var(--text-secondary)]">
                            No tienes ningún juego prestado en este momento. Cuando le dejes un título a un amigo o asociación, regístralo desde su ficha.
                        </p>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        @foreach (var loan in _summary.ActiveLoans)
                        {
                            <div class="p-5 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] flex flex-col justify-between gap-4">
                                <div class="flex gap-4 items-start">
                                    <a href="/juegos/@loan.GameSlug" class="shrink-0 w-20 h-20 rounded-xl overflow-hidden border border-[var(--border-subtle)] bg-[var(--bg-surface)] block">
                                        @if (!string.IsNullOrWhiteSpace(loan.GameCoverUrl))
                                        {
                                            <img src="@loan.GameCoverUrl"
                                                 alt="@loan.GameTitle"
                                                 loading="lazy"
                                                 decoding="async"
                                                 width="80"
                                                 height="80"
                                                 onerror="this.onerror=null; this.src='/images/game-placeholder.svg';"
                                                 class="w-full h-full object-cover" />
                                        }
                                        else
                                        {
                                            <img src="/images/game-placeholder.svg"
                                                 alt="Carátula no disponible"
                                                 width="80"
                                                 height="80"
                                                 class="w-full h-full object-cover opacity-90" />
                                        }
                                    </a>

                                <div class="flex-1 min-w-0">
                                    <a href="/juegos/@loan.GameSlug" class="text-sm font-black text-[var(--text-primary)] hover:text-[var(--brand-primary)] transition-colors block truncate">
                                        @loan.GameTitle
                                    </a>
                                    <div class="mt-2 space-y-1">
                                        <div class="flex items-center gap-1.5 text-xs text-[var(--brand-primary)] font-bold">
                                            <Icon Name="user" Size="12" />
                                            <span>@loan.BorrowerName</span>
                                        </div>
                                        <div class="text-[0.68rem] text-[var(--text-secondary)]">
                                            Prestado el @loan.LoanDate.ToString("dd/MM/yyyy")
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(loan.Notes))
                                    {
                                        <p class="text-[0.68rem] text-[var(--text-secondary)] mt-2 italic line-clamp-2">
                                            &ldquo;@loan.Notes&rdquo;
                                        </p>
                                    }
                                </div>
                            </div>

                            <button type="button"
                                    @onclick="() => HandleReturnLoan(loan.Id)"
                                    class="w-full py-2.5 px-3 rounded-xl text-xs font-bold bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-white transition-colors flex items-center justify-center gap-1.5 shadow-sm">
                                <Icon Name="undo-2" Size="12" />
                                <span>Marcar como devuelto</span>
                            </button>
                        </div>
                    }
                    </div>
                }
            </div>
        }
        else
        {
            @* Vista de Juegos por Estado *@
            <div id="panel-collection" role="tabpanel" aria-labelledby="@($"tab-{_activeTab.ToString().ToLowerInvariant()}")">
                @if (_activeTab == TabType.WantToBuy)
                {
                    @if (_wantToBuyAlerts != null && _wantToBuyAlerts.Count > 0)
                    {
                        <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/25 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-emerald-700 dark:text-emerald-300 shadow-sm mb-6">
                            <div class="flex items-center gap-3">
                                <span class="shrink-0 p-2 rounded-xl bg-emerald-500/20 text-emerald-500"><Icon Name="trending-down" Size="22" /></span>
                                <div>
                                    <strong class="font-bold block text-sm mb-0.5">¡Tienes @_wantToBuyAlerts.Count @(_wantToBuyAlerts.Count == 1 ? "oferta detectada" : "ofertas detectadas") en tu lista de compra!</strong>
                                    <span>Títulos de tu lista de seguimiento han bajado de precio o alcanzado su mínimo histórico en tiendas colaboradoras.</span>
                                </div>
                            </div>
                            <a href="/radar" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-emerald-600 hover:bg-emerald-500 text-white transition-colors inline-flex items-center gap-1.5 self-start sm:self-auto shrink-0 shadow-sm">
                                <Icon Name="radar" Size="14" />
                                <span>Ver Radar de Ofertas</span>
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="p-4 rounded-2xl bg-sky-500/10 border border-sky-500/25 flex items-center gap-3 text-xs text-sky-700 dark:text-sky-300 shadow-sm mb-6">
                            <span class="shrink-0"><Icon Name="bell" Size="24" /></span>
                            <div>
                                <strong class="font-bold block text-sm mb-0.5">Radar de Compra Inteligente Activo</strong>
                                <span>Ludeka monitoriza bajadas de precio, ofertas especiales, sorteos y reimpresiones en tiendas para todos los títulos de tu lista de seguimiento para comprar.</span>
                            </div>
                        </div>
                    }
                }

                @{
                    var currentList = GetFilteredItems();
                }

                @if (currentList.Count == 0)
                {
                    <div class="py-16 text-center max-w-md mx-auto p-8 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)]">
                        <span class="inline-block mb-3"><Icon Name="dices" Size="40" /></span>
                        <h3 class="text-lg font-bold text-[var(--text-primary)] mb-1">Sin juegos en esta lista</h3>
                        <p class="text-xs text-[var(--text-secondary)] mb-6">
                            Aún no tienes ningún título clasificado como @GetActiveTabName(). Puedes importar tu colección desde BGG o añadir juegos con el buscador.
                        </p>
                        <div class="flex justify-center gap-3">
                            <button type="button"
                                    @onclick="() => _showBggImportModal = true"
                                    class="px-4 py-2.5 rounded-xl text-xs font-bold bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-white transition-colors shadow-sm">
                                Importar desde BGG
                            </button>
                            <a href="/" class="px-4 py-2.5 rounded-xl text-xs font-bold bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-card)] text-[var(--text-secondary)] border border-[var(--border-subtle)] transition-colors">
                                Explorar Catálogo
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4">
                        @foreach (var item in currentList)
                        {
                            <div class="group relative rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] hover:border-[var(--brand-primary)] overflow-hidden flex flex-col transition-all shadow-sm">
                                @{
                                    var placeholderUrl = item.IsExpansion ? "/images/expansion-placeholder.svg" : "/images/game-placeholder.svg";
                                }
                                @if (item.IsPendingCataloging)
                                {
                                    <div class="block aspect-square w-full overflow-hidden bg-[var(--bg-surface-elevated)] relative">
                                        @if (!string.IsNullOrWhiteSpace(item.GameCoverUrl))
                                        {
                                            <img src="@item.GameCoverUrl"
                                                 alt="@item.GameTitle"
                                                 loading="lazy"
                                                 decoding="async"
                                                 width="200"
                                                 height="200"
                                                 onerror="this.onerror=null; this.src='@placeholderUrl';"
                                                 class="w-full h-full object-cover opacity-80" />
                                        }
                                        else
                                        {
                                            <img src="@placeholderUrl"
                                                 alt="@item.GameTitle"
                                                 width="200"
                                                 height="200"
                                                 class="w-full h-full object-cover opacity-70" />
                                        }

                                        @if (item.IsExpansion)
                                        {
                                            <div class="absolute top-2 right-2 z-20 px-2 py-0.5 rounded-md bg-purple-950/85 backdrop-blur-sm border border-purple-500/40 text-[0.62rem] font-black text-purple-200 shadow-md flex items-center gap-1">
                                                <Icon Name="puzzle" Size="12" />
                                                <span>Expansión</span>
                                            </div>
                                        }

                                        <div class="absolute bottom-2 left-2 right-2 px-2 py-1 rounded-md bg-[var(--bg-nav)] text-[var(--brand-primary)] border border-[var(--border-subtle)] text-[0.6rem] font-bold uppercase tracking-wider backdrop-blur-sm z-10 flex items-center gap-1 shadow-sm">
                                            <Icon Name="hourglass" Size="12" />
                                            <span class="truncate">En cola de catalogación</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <a href="/juegos/@item.GameSlug" class="block aspect-square w-full overflow-hidden bg-[var(--bg-surface-elevated)] relative">
                                        @if (!string.IsNullOrWhiteSpace(item.GameCoverUrl))
                                        {
                                            <img src="@item.GameCoverUrl"
                                                 alt="@item.GameTitle"
                                                 loading="lazy"
                                                 decoding="async"
                                                 width="200"
                                                 height="200"
                                                 onerror="this.onerror=null; this.src='@placeholderUrl';"
                                                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                                        }
                                        else
                                        {
                                            <img src="@placeholderUrl"
                                                 alt="@item.GameTitle"
                                                 width="200"
                                                 height="200"
                                                 class="w-full h-full object-cover opacity-90 group-hover:scale-105 transition-transform duration-300" />
                                        }

                                        @if (item.IsExpansion)
                                        {
                                            <div class="absolute top-2 right-2 z-10 px-2 py-0.5 rounded-md bg-purple-950/85 backdrop-blur-sm border border-purple-500/40 text-[0.62rem] font-black text-purple-200 shadow-md flex items-center gap-1">
                                                <Icon Name="puzzle" Size="12" />
                                                <span>Expansión</span>
                                            </div>
                                        }

                                        @if (item.IsCurrentlyLoaned)
                                        {
                                            <div class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-[var(--bg-nav)] text-[var(--text-primary)] border border-[var(--border-highlight)] text-[0.62rem] font-bold uppercase tracking-wider backdrop-blur-sm z-10">
                                                <Icon Name="package" Size="12" /> Prestado
                                            </div>
                                        }
                                        else if (_activeTab == TabType.WantToBuy && item.GameId.HasValue && _alertsByGameId.TryGetValue(item.GameId.Value, out var imgAlert))
                                        {
                                            <div class="absolute top-2 left-2 z-10 px-2 py-0.5 rounded-md bg-emerald-950/85 backdrop-blur-sm border border-emerald-500/40 text-[0.62rem] font-black text-emerald-300 shadow-md flex items-center gap-1" title="@($"Oferta en {imgAlert.StoreName}: {imgAlert.FormattedCurrentPrice}")">
                                                <Icon Name="trending-down" Size="12" />
                                                <span>@(imgAlert.IsAllTimeLow ? "Mínimo" : $"-{imgAlert.DiscountPercentage:0.#}%")</span>
                                            </div>
                                        }
                                    </a>
                                }

                                <div class="p-3 flex-1 flex flex-col justify-between gap-2">
                                    <div>
                                        @if (item.IsPendingCataloging)
                                        {
                                            <div class="text-xs font-bold text-[var(--text-secondary)] line-clamp-2" title="@item.GameTitle">
                                                @item.GameTitle
                                            </div>
                                            <span class="text-[0.62rem] text-[var(--brand-primary)] font-medium block mt-0.5">
                                                <Icon Name="hourglass" Size="12" /> Auto-catalogación pendiente
                                            </span>
                                        }
                                        else
                                        {
                                            <a href="/juegos/@item.GameSlug" class="text-xs font-bold text-[var(--text-primary)] hover:text-[var(--brand-primary)] transition-colors line-clamp-2">
                                                @item.GameTitle
                                            </a>
                                        }
                                        @if (_activeTab == TabType.WantToBuy && item.GameId.HasValue && _alertsByGameId.TryGetValue(item.GameId.Value, out var cardAlert))
                                        {
                                            <div class="mt-1.5 p-1.5 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-[0.65rem] space-y-0.5">
                                                <div class="flex items-center justify-between font-bold text-emerald-600 dark:text-emerald-400">
                                                    <span class="truncate">@cardAlert.StoreName</span>
                                                    <span class="shrink-0">@cardAlert.FormattedCurrentPrice</span>
                                                </div>
                                                <div class="flex items-center justify-between text-[0.6rem] text-emerald-500/80">
                                                    <span>@(cardAlert.IsAllTimeLow ? "Mínimo histórico" : $"Bajada de {cardAlert.DiscountPercentage:0.#}%")</span>
                                                    @if (cardAlert.ReferencePrice.HasValue)
                                                    {
                                                        <span class="line-through text-[var(--text-muted)]">@cardAlert.FormattedReferencePrice</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <div class="text-[0.62rem] text-[var(--text-muted)] font-medium">
                                        Añadido el @item.AddedAt.ToString("dd/MM/yyyy")
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@* Modales interactivos *@
<BggImportModal IsVisible="_showBggImportModal" 
                OnClose="() => _showBggImportModal = false" 
                OnImportCompleted="LoadSummaryAsync" />

<BggSearchModal IsVisible="_showBggSearchModal" 
                OnClose="() => _showBggSearchModal = false" 
                OnGameAdded="LoadSummaryAsync" />

@code {
    private enum TabType
    {
        InCollection,
        Played,
        WantToBuy,
        Plays,
        Loans,
        Queue,
        Appearance,
        Stats
    }

    private TabType _activeTab = TabType.InCollection;
    private UserLibrarySummaryDto? _summary;
    private UserLibraryStatsDto? _stats;
    private IReadOnlyList<GamePlayLogDto>? _userPlayLogs;
    private UserPlaysStatsDto? _playsStats;
    private bool _isLoading = true;
    private bool _isLoadingStats = false;
    private bool _isLoadingPlays = false;
    private bool _copiedProfileLink = false;
    private bool _showBggImportModal = false;
    private bool _showBggSearchModal = false;
    private string _userCurrentTheme = "charcoal";
    private string? _saveMessage;
    private string? _userCurrentCountry;
    private string? _countrySaveMessage;
    private bool _isOfflineMode = false;
    private string? _offlineTimestamp;
    private IReadOnlyList<PriceDropAlertDto>? _wantToBuyAlerts;
    private Dictionary<Guid, PriceDropAlertDto> _alertsByGameId = new();

    /// <summary>
    /// Deep-link de código cerrado desde el hub /cuenta (INC-50, diseño §D1): `?seccion=apariencia`
    /// abre la pestaña Apariencia &amp; País. Cualquier otro valor o ausencia conserva el
    /// comportamiento actual (pestaña por defecto).
    /// </summary>
    [SupplyParameterFromQuery(Name = "seccion")]
    public string? Seccion { get; set; }

    /// <summary>Indica si hay sesión iniciada: la ludoteca y sus preferencias la exigen (INC-46 F4).</summary>
    private bool HasSession => !string.IsNullOrWhiteSpace(CurrentUserService.UserId);

    /// <summary>
    /// Ruta del perfil público, o <c>null</c> cuando no hay una identidad real que mostrar. El
    /// enlace nunca se construye con un identificador vacío.
    /// </summary>
    private string? PublicProfilePath
    {
        get
        {
            string userId = CurrentUserService.UserId;
            return string.IsNullOrWhiteSpace(userId) ? null : $"/u/{userId.Trim()}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Deep-link del hub: ?seccion=apariencia ⇒ redirección canónica a /cuenta/apariencia (INC-62).
        if (string.Equals(Seccion, "apariencia", StringComparison.OrdinalIgnoreCase))
        {
            _activeTab = TabType.Appearance;
            Navigation.NavigateTo("/cuenta/apariencia", replace: true);
            return;
        }

        await LoadSummaryAsync();
        try
        {
            _userCurrentTheme = await PreferenceService.GetUserThemeAsync(CurrentUserService.UserId);
            _userCurrentCountry = await PreferenceService.GetUserCountryAsync(CurrentUserService.UserId);
        }
        catch
        {
        }
    }

    private async Task LoadSummaryAsync()
    {
        _isLoading = true;
        try
        {
            _summary = await LibraryService.GetLibrarySummaryAsync();
            _isOfflineMode = false;

            // Sincronizar instantánea offline en segundo plano
            if (_summary != null)
            {
                var snapshot = OfflineLibrarySnapshotDto.FromSummary(CurrentUserService.UserId, _summary);
                string json = System.Text.Json.JsonSerializer.Serialize(snapshot);
                _ = JS.InvokeVoidAsync("LudekaOffline.saveLibrarySnapshot", CurrentUserService.UserId, json);
            }
        }
        catch (Exception)
        {
            // Intentar recuperar de la caché local offline
            try
            {
                string? raw = await JS.InvokeAsync<string?>("LudekaOffline.getLibrarySnapshot", CurrentUserService.UserId);
                if (!string.IsNullOrWhiteSpace(raw))
                {
                    using var doc = System.Text.Json.JsonDocument.Parse(raw);
                    if (doc.RootElement.TryGetProperty("data", out var dataProp))
                    {
                        var snapshot = System.Text.Json.JsonSerializer.Deserialize<OfflineLibrarySnapshotDto>(dataProp.GetRawText());
                        if (snapshot != null)
                        {
                            _summary = snapshot.ToSummary();
                            _isOfflineMode = true;
                            _offlineTimestamp = await JS.InvokeAsync<string?>("LudekaOffline.getLastSnapshotTimestamp", CurrentUserService.UserId);
                        }
                    }
                }
            }
            catch
            {
            }
        }
        finally
        {
            _isLoading = false;
            _stats = null;
            try
            {
                _playsStats = await PlayLogService.GetUserPlaysStatsAsync();
            }
            catch
            {
            }

            try
            {
                if (!string.IsNullOrWhiteSpace(CurrentUserService.UserId))
                {
                    var alerts = await PriceRadarService.GetUserWantToBuyAlertsAsync(CurrentUserService.UserId);
                    _wantToBuyAlerts = alerts;
                    _alertsByGameId = alerts.ToDictionary(a => a.GameId, a => a);
                }
                else
                {
                    _wantToBuyAlerts = [];
                    _alertsByGameId = new();
                }
            }
            catch
            {
                _wantToBuyAlerts = [];
                _alertsByGameId = new();
            }

            if (_activeTab == TabType.Stats)
            {
                await LoadStatsAsync();
            }
            else if (_activeTab == TabType.Plays)
            {
                await LoadPlaysDataAsync();
            }
        }
    }

    private async Task SwitchToPlaysAsync()
    {
        _activeTab = TabType.Plays;
        if (_userPlayLogs == null)
        {
            await LoadPlaysDataAsync();
        }
    }

    private async Task LoadPlaysDataAsync()
    {
        _isLoadingPlays = true;
        StateHasChanged();
        try
        {
            _userPlayLogs = await PlayLogService.GetUserPlaysAsync();
            _playsStats = await PlayLogService.GetUserPlaysStatsAsync();
        }
        catch
        {
        }
        finally
        {
            _isLoadingPlays = false;
            StateHasChanged();
        }
    }

    private async Task SwitchToStatsAsync()
    {
        _activeTab = TabType.Stats;
        if (_stats == null)
        {
            await LoadStatsAsync();
        }
    }

    private async Task LoadStatsAsync()
    {
        _isLoadingStats = true;
        StateHasChanged();
        try
        {
            _stats = await StatsService.GetUserStatsAsync(CurrentUserService.UserId);
        }
        catch
        {
        }
        finally
        {
            _isLoadingStats = false;
            StateHasChanged();
        }
    }

    private async Task CopyPublicProfileLinkAsync()
    {
        if (!HasSession)
        {
            Navigation.ToLogin();
            return;
        }

        try
        {
            string url = Navigation.ToAbsoluteUri(PublicProfilePath!).ToString();
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            _copiedProfileLink = true;
            StateHasChanged();
            await Task.Delay(2500);
            _copiedProfileLink = false;
            StateHasChanged();
        }
        catch
        {
        }
    }

    /// <summary>Abre la importación de BGG solo con sesión; sin ella lleva al acceso.</summary>
    private void OpenBggImportModal()
    {
        if (!HasSession)
        {
            Navigation.ToLogin();
            return;
        }

        _showBggImportModal = true;
    }

    /// <summary>Abre la búsqueda asistida de BGG solo con sesión; sin ella lleva al acceso.</summary>
    private void OpenBggSearchModal()
    {
        if (!HasSession)
        {
            Navigation.ToLogin();
            return;
        }

        _showBggSearchModal = true;
    }

    private async Task HandleReturnLoan(Guid loanId)
    {
        try
        {
            await LibraryService.ReturnLoanAsync(loanId);
            await LoadSummaryAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
        }
    }

    private async Task SelectUserTheme(string theme)
    {
        _userCurrentTheme = theme;
        _saveMessage = null;
        try
        {
            await JS.InvokeVoidAsync("setLudekaTheme", theme, CurrentUserService.UserId);
            await PreferenceService.SetUserThemeAsync(CurrentUserService.UserId, theme);
            _saveMessage = $"Tema '{GetThemeDisplayName(theme)}' guardado para {CurrentUserService.UserName}";
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
            return;
        }
        catch
        {
            _saveMessage = "Tema aplicado localmente";
        }
        StateHasChanged();
    }

    private static string GetThemeDisplayName(string theme) => theme switch
    {
        "editorial" => "Papel & Tinta",
        "wood" => "Madera Clara",
        "tabletop" => "Mesa Cálida",
        "midnight" => "Azul Medianoche",
        _ => "Carbón Oscuro"
    };

    private async Task OnCountrySelectChangedAsync()
    {
        string? country = string.IsNullOrWhiteSpace(_userCurrentCountry) ? null : _userCurrentCountry;
        await SelectUserCountryAsync(country);
    }

    private async Task SelectUserCountryAsync(string? country)
    {
        _userCurrentCountry = country;
        _countrySaveMessage = null;
        try
        {
            await PreferenceService.SetUserCountryAsync(CurrentUserService.UserId, country);
            LocationService.SetUserCountry(country);
            await JS.InvokeVoidAsync("setStoredUserCountry", country, CurrentUserService.UserId);
            _countrySaveMessage = country != null
                ? $"País configurado a {CountryCatalog.GetFlag(country)} {country} para {CurrentUserService.UserName}."
                : "Ámbito global restablecido (sin filtro). Todo el contenido es visible.";
        }
        catch (UnauthorizedAccessException ex)
        {
            Navigation.TryRedirectToLogin(ex);
            return;
        }
        catch (Exception ex)
        {
            _countrySaveMessage = $"Error al guardar país: {ex.Message}";
        }
        StateHasChanged();
    }

    private async Task AutoDetectCountryAsync()
    {
        try
        {
            var detected = await JS.InvokeAsync<string?>("detectUserCountry");
            if (!string.IsNullOrWhiteSpace(detected))
            {
                await SelectUserCountryAsync(detected);
            }
            else
            {
                _countrySaveMessage = "No se pudo inferir el país desde la zona horaria del dispositivo.";
            }
        }
        catch (Exception ex)
        {
            _countrySaveMessage = $"Error al detectar: {ex.Message}";
        }
        StateHasChanged();
    }

    private List<UserCollectionItemDto> GetFilteredItems()
    {
        if (_summary == null) return [];

        return _activeTab switch
        {
            TabType.InCollection => _summary.Items.Where(i => i.Status == CollectionStatus.InCollection).ToList(),
            TabType.Played => _summary.Items.Where(i => i.IsPlayed).ToList(),
            TabType.WantToBuy => _summary.Items.Where(i => i.Status == CollectionStatus.WantToBuy).ToList(),
            _ => _summary.Items.Where(i => i.Status == CollectionStatus.InCollection).ToList()
        };
    }

    private string GetActiveTabName() => _activeTab switch
    {
        TabType.InCollection => "«En mi ludoteca»",
        TabType.Played => "«Jugados»",
        TabType.WantToBuy => "«Comprar»",
        TabType.Plays => "«Diario de Partidas»",
        TabType.Loans => "«Préstamos»",
        TabType.Queue => "«Cola comunitaria»",
        TabType.Appearance => "«Apariencia y Tema»",
        TabType.Stats => "«ADN y Estadísticas»",
        _ => ""
    };

    private string GetTabClass(TabType tab)
    {
        bool isActive = _activeTab == tab;
        if (isActive)
        {
            return "bg-[var(--brand-primary)] text-white shadow-sm";
        }
        return "bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-card)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border-subtle)]";
    }

    private string GetBadgeClass(TabType tab)
    {
        bool isActive = _activeTab == tab;
        if (isActive)
        {
            return "bg-black/20 text-white";
        }
        return "bg-[var(--bg-card)] text-[var(--text-muted)]";
    }
}
