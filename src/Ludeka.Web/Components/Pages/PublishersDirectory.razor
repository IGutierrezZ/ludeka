@page "/editoriales"
@rendermode InteractiveServer
@using Ludeka.Application.Contracts
@using Ludeka.Application.DTOs
@using Ludeka.Core.Enums
@using Ludeka.Web.Components.Shared
@inject IPublisherService PublisherService
@inject IDirectorySeederService DirectorySeederService
@inject ICurrentUserService CurrentUserService

<PageTitle>Directorio de Editoriales de Juegos de Mesa — Ludeka</PageTitle>

<section data-screen-label="Directorio" class="max-w-[1280px] mx-auto px-4 sm:px-8 lg:px-12 pt-8 sm:pt-14 flex flex-col gap-6 font-sans">
    <span class="text-xs sm:text-[13px] font-extrabold uppercase tracking-[0.18em] text-[var(--accent)] inline-flex items-center gap-1.5">
        <Icon Name="building-2" Size="14" />
        <span>Ecosistema lúdico · Casas de edición</span>
    </span>
    <h1 class="m-0 text-[54px] sm:text-[76px] lg:text-[104px] leading-[0.86] font-extrabold tracking-[-0.06em] text-[var(--ink)]">
        Editoriales
    </h1>
    <p class="m-0 text-base sm:text-[17px] leading-relaxed text-[var(--muted)] max-w-2xl">
        Explora las editoriales del hobby, sus catálogos publicados en España, enlaces a webs oficiales y canales didácticos de YouTube.
    </p>

    @* Barra de Búsqueda y Acciones de Staff *@
    <div class="flex flex-wrap items-center justify-between gap-4 pt-2">
        <div class="flex-1 min-w-[280px] max-w-md h-[52px] rounded-full bg-[var(--card)] border-2 border-[var(--rule)] flex items-center gap-3 px-5 shadow-sm">
            <span class="text-[var(--muted)] flex-shrink-0">
                <Icon Name="search" Size="18" />
            </span>
            <input type="text"
                   @bind="_searchTerm"
                   @bind:event="oninput"
                   @bind:after="FilterPublishers"
                   placeholder="Buscar editorial por nombre, país o ciudad..."
                   class="flex-1 min-w-0 border-0 outline-none bg-transparent text-sm sm:text-base text-[var(--ink)] placeholder-[var(--muted)]" />
        </div>

        <div class="flex items-center gap-2.5 flex-wrap">
            @if (CurrentUserService.IsFoundingTeam)
            {
                <button type="button"
                        @onclick="SyncDirectoryAsync"
                        disabled="@_isSyncing"
                        class="h-11 px-4 rounded-full bg-[var(--paper-2)] hover:bg-[var(--card)] text-[var(--ink)] border border-[var(--line)] font-extrabold text-xs transition-colors flex items-center gap-2 shadow-sm disabled:opacity-50 cursor-pointer">
                    @if (_isSyncing)
                    {
                        <span class="animate-spin inline-block"><Icon Name="loader" Size="14" /></span>
                        <span>Sincronizando...</span>
                    }
                    else
                    {
                        <Icon Name="refresh-cw" Size="14" />
                        <span>Sincronizar Padrón</span>
                    }
                </button>
            }
            @if (CurrentUserService.IsFoundingTeam || (CurrentUserService.IsInRole("Moderator") && CurrentUserService.HasPermission(ModeratorPermission.CanManagePublishers)))
            {
                <button type="button"
                        @onclick="OpenCreateModal"
                        class="h-11 px-5 rounded-full bg-[var(--brand)] text-[var(--on-brand)] font-extrabold text-xs transition-opacity hover:opacity-90 flex items-center gap-1.5 shadow-sm cursor-pointer">
                    <Icon Name="plus" Size="14" />
                    <span>Nueva Editorial</span>
                </button>
            }
        </div>
    </div>
</section>

<section class="max-w-[1280px] mx-auto px-4 sm:px-8 lg:px-12 py-8 pb-20 flex flex-col gap-5 font-sans">
    <span class="text-sm font-extrabold text-[var(--muted)]">
        @_publishers.Count @(_publishers.Count == 1 ? "editorial registrada" : "editoriales registradas")
    </span>

    @if (_loading)
    {
        <div class="py-16 text-center text-sm text-[var(--muted)] flex items-center justify-center gap-2">
            <span class="animate-spin inline-block"><Icon Name="dices" Size="22" /></span>
            <span>Cargando catálogo de editoriales...</span>
        </div>
    }
    else if (_publishers.Count == 0)
    {
        <div class="p-12 text-center rounded-[24px] bg-[var(--paper-2)] border-2 border-[var(--rule)] space-y-3">
            <span class="inline-block text-[var(--muted)]"><Icon Name="package" Size="36" /></span>
            <h2 class="text-lg font-extrabold text-[var(--ink)]">No se encontraron editoriales</h2>
            <p class="text-xs sm:text-sm text-[var(--muted)] max-w-sm mx-auto">
                No hay resultados para la búsqueda actual. Puedes reiniciar el filtro o dar de alta una nueva editorial si eres moderador.
            </p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            @for (int i = 0; i < _publishers.Count; i++)
            {
                var pub = _publishers[i];
                string pastelBg = GetPastelBg(i);
                string rotation = GetRotationClass(i);

                <div class="flex flex-col gap-3.5 pt-4 border-t-[3px] border-[var(--rule)] justify-between group">
                    <div class="flex flex-col gap-3">
                        <div class="flex items-center gap-4">
                            @if (!string.IsNullOrWhiteSpace(pub.LogoUrl))
                            {
                                <div class="w-16 h-16 rounded-[16px] object-contain @pastelBg p-1.5 border border-[var(--line)] shadow-sm shrink-0 flex items-center justify-center @rotation">
                                    <img src="@pub.LogoUrl"
                                         alt="Logo de @pub.Name"
                                         loading="lazy"
                                         class="max-w-full max-h-full object-contain"
                                         onerror="this.onerror=null; this.src='/images/game-placeholder.svg';" />
                                </div>
                            }
                            else
                            {
                                <div class="w-16 h-16 rounded-[16px] @pastelBg text-[var(--ink)] border border-[var(--line)] flex items-center justify-center text-2xl font-extrabold tracking-[-0.03em] shadow-sm shrink-0 @rotation">
                                    @pub.Name[..Math.Min(2, pub.Name.Length)].ToUpper()
                                </div>
                            }

                            <div class="flex flex-col min-w-0">
                                <a href="/editoriales/@pub.Slug"
                                   class="text-xl sm:text-[21px] font-extrabold tracking-[-0.025em] leading-[1.15] text-[var(--ink)] group-hover:text-[var(--brand)] transition-colors line-clamp-1">
                                    @pub.Name
                                </a>
                                <span class="text-xs sm:text-[13px] text-[var(--muted)] mt-0.5 inline-flex items-center gap-1">
                                    <Icon Name="map-pin" Size="13" />
                                    <span>@pub.Country @(!string.IsNullOrWhiteSpace(pub.City) ? $"({pub.City})" : "") · @pub.GamesCount @(pub.GamesCount == 1 ? "título" : "títulos")</span>
                                </span>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(pub.Description))
                        {
                            <p class="m-0 text-sm leading-[1.5] text-[var(--muted)] line-clamp-2">
                                @pub.Description
                            </p>
                        }

                        @if (pub.SocialLinks != null && pub.SocialLinks.Count > 0)
                        {
                            <div class="pt-1">
                                <SocialLinksList Links="@pub.SocialLinks" />
                            </div>
                        }
                    </div>

                    <div class="pt-2.5 mt-auto border-t border-[var(--line)] flex items-center justify-between gap-3 text-sm">
                        <a href="/editoriales/@pub.Slug" class="font-extrabold text-sm text-[var(--accent)] hover:opacity-80 transition-opacity inline-flex items-center gap-1">
                            <span>Ver catálogo editorial</span>
                            <span>&rarr;</span>
                        </a>

                        <div class="flex items-center gap-2">
                            <LikeButton TargetType="LikeTargetType.Publisher" TargetId="@pub.Id" InitialLikesCount="@pub.LikesCount" Compact="true" />

                            @if (CurrentUserService.IsFoundingTeam || (CurrentUserService.IsInRole("Moderator") && CurrentUserService.HasPermission(ModeratorPermission.CanManagePublishers)))
                            {
                                <button type="button"
                                        @onclick="() => OpenEditModal(pub)"
                                        class="text-[var(--muted)] hover:text-amber-500 font-bold text-xs p-1.5 rounded-lg hover:bg-[var(--paper-2)] transition-colors cursor-pointer"
                                        title="Editar editorial">
                                    <Icon Name="pencil" Size="14" />
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

@* Modal de Edición / Creación *@
<PublisherEditModal
    IsOpen="@_isModalOpen"
    PublisherId="@_selectedId"
    Name="@_modalName"
    Country="@_modalCountry"
    City="@_modalCity"
    Description="@_modalDescription"
    LogoUrl="@_modalLogoUrl"
    WebsiteUrl="@_modalWebsiteUrl"
    InitialSocialLinks="@_modalSocialLinks"
    OnClose="() => _isModalOpen = false"
    OnSaved="LoadPublishersAsync" />

@code {
    private bool _loading = true;
    private bool _isSyncing = false;
    private string _searchTerm = string.Empty;
    private IReadOnlyList<PublisherDto> _publishers = [];
    private bool _isModalOpen = false;
    private Guid? _selectedId;
    private string _modalName = string.Empty;
    private string _modalCountry = "España";
    private string? _modalCity;
    private string? _modalDescription;
    private string? _modalLogoUrl;
    private string? _modalWebsiteUrl;
    private List<SocialNetworkLinkDto>? _modalSocialLinks;

    protected override async Task OnInitializedAsync()
    {
        await LoadPublishersAsync();
    }

    private async Task LoadPublishersAsync()
    {
        _loading = true;
        _publishers = await PublisherService.GetAllAsync(_searchTerm);
        _loading = false;
    }

    private async Task FilterPublishers()
    {
        _publishers = await PublisherService.GetAllAsync(_searchTerm);
    }

    private async Task SyncDirectoryAsync()
    {
        if (_isSyncing) return;
        _isSyncing = true;
        try
        {
            await DirectorySeederService.SeedDirectoryAsync();
            await LoadPublishersAsync();
        }
        catch (Exception)
        {
            // Salvaguarda
        }
        finally
        {
            _isSyncing = false;
        }
    }

    private void OpenCreateModal()
    {
        _selectedId = null;
        _modalName = string.Empty;
        _modalCountry = "España";
        _modalCity = null;
        _modalDescription = null;
        _modalLogoUrl = null;
        _modalWebsiteUrl = null;
        _modalSocialLinks = new List<SocialNetworkLinkDto>();
        _isModalOpen = true;
    }

    private void OpenEditModal(PublisherDto pub)
    {
        _selectedId = pub.Id;
        _modalName = pub.Name;
        _modalCountry = pub.Country;
        _modalCity = pub.City;
        _modalDescription = pub.Description;
        _modalLogoUrl = pub.LogoUrl;
        _modalWebsiteUrl = pub.WebsiteUrl;
        _modalSocialLinks = pub.SocialLinks.ToList();
        _isModalOpen = true;
    }

    private static string GetPastelBg(int index) => (index % 4) switch
    {
        0 => "bg-[var(--p-blue)]",
        1 => "bg-[var(--p-pink)]",
        2 => "bg-[var(--p-peach)]",
        _ => "bg-[var(--p-mint)]"
    };

    private static string GetRotationClass(int index) => (index % 5) switch
    {
        0 => "-rotate-2",
        1 => "rotate-2",
        2 => "-rotate-1",
        3 => "rotate-1",
        _ => "rotate-0"
    };
}
