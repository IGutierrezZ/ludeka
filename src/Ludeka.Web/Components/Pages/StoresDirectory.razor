@page "/tiendas"
@rendermode InteractiveServer
@using Ludeka.Application.Contracts
@using Ludeka.Application.DTOs
@using Ludeka.Core.Enums
@using Ludeka.Core.ValueObjects
@using Ludeka.Web.Components.Shared
@inject IStoreService StoreService
@inject IDirectorySeederService DirectorySeederService
@inject ICurrentUserService CurrentUserService
@inject IUserLocationService UserLocationService

<PageTitle>Directorio de Tiendas de Juegos de Mesa — Ludeka</PageTitle>

<section data-screen-label="Directorio" class="max-w-[1280px] mx-auto px-4 sm:px-8 lg:px-12 pt-8 sm:pt-14 flex flex-col gap-6 font-sans">
    <span class="text-xs sm:text-[13px] font-extrabold uppercase tracking-[0.18em] text-[var(--accent)] inline-flex items-center gap-1.5">
        <Icon Name="shopping-cart" Size="14" />
        <span>Ecosistema comercial &bull; Tiendas lúdicas</span>
    </span>
    <h1 class="m-0 text-[54px] sm:text-[76px] lg:text-[104px] leading-[0.86] font-extrabold tracking-[-0.06em] text-[var(--ink)]">
        Tiendas
    </h1>
    <p class="m-0 text-base sm:text-[17px] leading-relaxed text-[var(--muted)] max-w-2xl">
        Directorio de tiendas físicas y online recomendadas: dónde jugar, comprar tus juegos favoritos, disfrutar de programas de fidelidad y ver sus canales de divulgación.
    </p>

    @* Buscador y Filtros por Tipo y País *@
    <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4 pt-2">
        <div class="flex-1 min-w-[280px] max-w-md h-[52px] rounded-full bg-[var(--card)] border-2 border-[var(--rule)] flex items-center gap-3 px-5 shadow-sm">
            <span class="text-[var(--muted)] flex-shrink-0">
                <Icon Name="search" Size="18" />
            </span>
            <input type="text"
                   @bind="_searchTerm"
                   @bind:event="oninput"
                   @bind:after="FilterStores"
                   placeholder="Buscar por nombre, ciudad o dirección..."
                   class="flex-1 min-w-0 border-0 outline-none bg-transparent text-sm sm:text-base text-[var(--ink)] placeholder-[var(--muted)]" />
        </div>

        <div class="flex flex-wrap items-center gap-3">
            @* Filtro por País *@
            <select @bind="_selectedCountry"
                    @bind:after="FilterStores"
                    class="h-11 px-4 rounded-full bg-[var(--card)] border-2 border-[var(--rule)] text-xs font-extrabold text-[var(--ink)] outline-none shadow-sm cursor-pointer">
                <option value="">Todos los países</option>
                @foreach (var c in CountryCatalog.GetAllCountries())
                {
                    <option value="@c.Name">@c.FlagEmoji @c.Name</option>
                }
            </select>

            @* Filtro por Tipo de Tienda *@
            <div class="flex items-center bg-[var(--paper-2)] p-1 rounded-full border border-[var(--line)] text-xs font-extrabold" role="group" aria-label="Filtro por tipo de tienda">
                <button type="button"
                        @onclick="() => SetTypeFilter(null)"
                        class="px-3.5 py-1.5 rounded-full transition-all cursor-pointer @(!_selectedType.HasValue ? "bg-[var(--brand)] text-[var(--on-brand)] shadow-sm" : "text-[var(--muted)] hover:text-[var(--ink)]")">
                    Todas
                </button>
                <button type="button"
                        @onclick="() => SetTypeFilter(StoreType.Hybrid)"
                        class="px-3.5 py-1.5 rounded-full transition-all cursor-pointer @(_selectedType == StoreType.Hybrid ? "bg-[var(--brand)] text-[var(--on-brand)] shadow-sm" : "text-[var(--muted)] hover:text-[var(--ink)]")">
                    <span class="inline-flex items-center gap-1"><Icon Name="store" Size="12" /> Híbrida</span>
                </button>
                <button type="button"
                        @onclick="() => SetTypeFilter(StoreType.PhysicalOnly)"
                        class="px-3.5 py-1.5 rounded-full transition-all cursor-pointer @(_selectedType == StoreType.PhysicalOnly ? "bg-[var(--brand)] text-[var(--on-brand)] shadow-sm" : "text-[var(--muted)] hover:text-[var(--ink)]")">
                    <span class="inline-flex items-center gap-1"><Icon Name="building-2" Size="12" /> Física</span>
                </button>
                <button type="button"
                        @onclick="() => SetTypeFilter(StoreType.OnlineOnly)"
                        class="px-3.5 py-1.5 rounded-full transition-all cursor-pointer @(_selectedType == StoreType.OnlineOnly ? "bg-[var(--brand)] text-[var(--on-brand)] shadow-sm" : "text-[var(--muted)] hover:text-[var(--ink)]")">
                    <span class="inline-flex items-center gap-1"><Icon Name="globe" Size="12" /> Online</span>
                </button>
            </div>

            @* Acciones de Staff *@
            <div class="flex items-center gap-2">
                @if (CurrentUserService.IsFoundingTeam)
                {
                    <button type="button"
                            @onclick="SyncDirectoryAsync"
                            disabled="@_isSyncing"
                            class="h-11 px-4 rounded-full bg-[var(--paper-2)] hover:bg-[var(--card)] text-[var(--ink)] border border-[var(--line)] font-extrabold text-xs transition-colors flex items-center gap-2 shadow-sm disabled:opacity-50 cursor-pointer">
                        @if (_isSyncing)
                        {
                            <span class="animate-spin inline-block"><Icon Name="loader" Size="14" /></span>
                            <span>Sincronizando...</span>
                        }
                        else
                        {
                            <Icon Name="refresh-cw" Size="14" />
                            <span>Sincronizar Padrón</span>
                        }
                    </button>
                }
                @if (CurrentUserService.IsFoundingTeam || (CurrentUserService.IsInRole("Moderator") && CurrentUserService.HasPermission(ModeratorPermission.CanManageStoreLinks)))
                {
                    <button type="button"
                            @onclick="OpenCreateModal"
                            class="h-11 px-5 rounded-full bg-[var(--brand)] text-[var(--on-brand)] font-extrabold text-xs transition-opacity hover:opacity-90 flex items-center gap-1.5 shadow-sm cursor-pointer">
                        <Icon Name="plus" Size="14" />
                        <span>Nueva Tienda</span>
                    </button>
                }
            </div>
        </div>
    </div>
</section>

<section class="max-w-[1280px] mx-auto px-4 sm:px-8 lg:px-12 py-8 pb-20 flex flex-col gap-5 font-sans">
    <span class="text-sm font-extrabold text-[var(--muted)]">
        @_stores.Count @(_stores.Count == 1 ? "tienda registrada" : "tiendas registradas")
    </span>

    @if (_loading)
    {
        <div class="py-16 text-center text-sm text-[var(--muted)] flex items-center justify-center gap-2">
            <span class="animate-spin inline-block"><Icon Name="dices" Size="22" /></span>
            <span>Cargando catálogo de tiendas...</span>
        </div>
    }
    else if (_stores.Count == 0)
    {
        <div class="p-12 text-center rounded-[24px] bg-[var(--paper-2)] border-2 border-[var(--rule)] space-y-3">
            <span class="inline-block text-[var(--muted)]"><Icon Name="store" Size="36" /></span>
            <h2 class="text-lg font-extrabold text-[var(--ink)]">No se encontraron tiendas</h2>
            <p class="text-xs sm:text-sm text-[var(--muted)] max-w-sm mx-auto">
                No hay resultados para los criterios seleccionados@(!string.IsNullOrWhiteSpace(_selectedCountry) ? $" en {_selectedCountry}" : "").
            </p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            @for (int i = 0; i < _stores.Count; i++)
            {
                var store = _stores[i];
                string pastelBg = GetPastelBg(i);
                string rotation = GetRotationClass(i);

                <div class="flex flex-col gap-3.5 pt-4 border-t-[3px] border-[var(--rule)] justify-between group">
                    <div class="flex flex-col gap-3">
                        <div class="flex items-center gap-4">
                            @if (!string.IsNullOrWhiteSpace(store.LogoUrl))
                            {
                                <div class="w-16 h-16 rounded-[16px] object-contain @pastelBg p-1.5 border border-[var(--line)] shadow-sm shrink-0 flex items-center justify-center @rotation">
                                    <img src="@store.LogoUrl"
                                         alt="Logo de @store.Name"
                                         loading="lazy"
                                         class="max-w-full max-h-full object-contain"
                                         onerror="this.onerror=null; this.src='/images/game-placeholder.svg';" />
                                </div>
                            }
                            else
                            {
                                <div class="w-16 h-16 rounded-[16px] @pastelBg text-[var(--ink)] border border-[var(--line)] flex items-center justify-center text-2xl font-extrabold tracking-[-0.03em] shadow-sm shrink-0 @rotation">
                                    @store.Name[..Math.Min(2, store.Name.Length)].ToUpper()
                                </div>
                            }

                            <div class="flex flex-col min-w-0">
                                <a href="/tiendas/@store.Slug"
                                   class="text-xl sm:text-[21px] font-extrabold tracking-[-0.025em] leading-[1.15] text-[var(--ink)] group-hover:text-[var(--brand)] transition-colors line-clamp-1">
                                    @store.Name
                                </a>
                                <div class="flex items-center gap-1.5 flex-wrap text-xs sm:text-[13px] text-[var(--muted)] mt-0.5">
                                    <span>@FormatStoreType(store.Type)</span>
                                    @if (!string.IsNullOrWhiteSpace(store.City))
                                    {
                                        <span>&bull; @store.City</span>
                                    }
                                    <span class="inline-flex items-center gap-0.5 px-2 py-0.5 rounded-full bg-[var(--paper-2)] border border-[var(--line)] text-xs font-bold text-[var(--ink)]">
                                        @CountryCatalog.GetFlag(store.Country) @store.Country
                                    </span>
                                </div>
                            </div>
                        </div>

                        @if (store.HasLoyaltyProgram)
                        {
                            <div class="pt-0.5">
                                <span class="px-2.5 py-0.5 rounded-full text-xs font-extrabold bg-amber-500/15 text-amber-600 dark:text-amber-400 border border-amber-500/30 inline-flex items-center gap-1">
                                    <Icon Name="star" Size="11" /> Club de fidelidad
                                </span>
                            </div>
                        }

                        @if (store.ShippingCountries != null && store.ShippingCountries.Count > 0)
                        {
                            <div class="px-3 py-1.5 rounded-[12px] bg-[var(--paper-2)] border border-[var(--line)] text-xs text-[var(--muted)] flex items-center gap-1.5 flex-wrap">
                                <span class="inline-flex items-center gap-1 font-extrabold text-[var(--ink)]"><Icon Name="truck" Size="12" /> Envíos:</span>
                                <span>@string.Join(", ", store.ShippingCountries)</span>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(store.Address))
                        {
                            <p class="m-0 text-xs text-[var(--muted)] flex items-start gap-1">
                                <span class="shrink-0 text-[var(--accent)]"><Icon Name="map-pin" Size="12" /></span>
                                <span class="line-clamp-1">@store.Address</span>
                            </p>
                        }

                        @if (!string.IsNullOrWhiteSpace(store.Description))
                        {
                            <p class="m-0 text-sm leading-[1.5] text-[var(--muted)] line-clamp-2">
                                @store.Description
                            </p>
                        }

                        @if (store.SocialLinks != null && store.SocialLinks.Count > 0)
                        {
                            <div class="pt-1">
                                <SocialLinksList Links="@store.SocialLinks" />
                            </div>
                        }
                    </div>

                    <div class="pt-2.5 mt-auto border-t border-[var(--line)] flex items-center justify-between gap-3 text-sm">
                        <a href="/tiendas/@store.Slug" class="font-extrabold text-sm text-[var(--accent)] hover:opacity-80 transition-opacity inline-flex items-center gap-1">
                            <span>Ver ficha y ofertas (@store.ActiveOffersCount)</span>
                            <span>&rarr;</span>
                        </a>

                        <div class="flex items-center gap-2">
                            <LikeButton TargetType="LikeTargetType.Store" TargetId="@store.Id" InitialLikesCount="@store.LikesCount" Compact="true" />

                            @if (CurrentUserService.IsFoundingTeam || (CurrentUserService.IsInRole("Moderator") && CurrentUserService.HasPermission(ModeratorPermission.CanManageStoreLinks)))
                            {
                                <button type="button"
                                        @onclick="() => OpenEditModal(store)"
                                        class="text-[var(--muted)] hover:text-amber-500 font-bold text-xs p-1.5 rounded-lg hover:bg-[var(--paper-2)] transition-colors cursor-pointer"
                                        title="Editar tienda">
                                    <Icon Name="pencil" Size="14" />
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

@* Modal de Edición / Creación *@
<StoreEditModal
    IsOpen="@_isModalOpen"
    StoreId="@_selectedId"
    Name="@_modalName"
    Type="@_modalType"
    Country="@_modalCountry"
    City="@_modalCity"
    Address="@_modalAddress"
    Description="@_modalDescription"
    LogoUrl="@_modalLogoUrl"
    WebsiteUrl="@_modalWebsiteUrl"
    AffiliateCode="@_modalAffiliateCode"
    HasLoyaltyProgram="@_modalHasLoyaltyProgram"
    InitialSocialLinks="@_modalSocialLinks"
    InitialShippingCountries="@_modalShippingCountries"
    OnClose="() => _isModalOpen = false"
    OnSaved="LoadStoresAsync" />

@code {
    private bool _loading = true;
    private bool _isSyncing = false;
    private string _searchTerm = string.Empty;
    private string _selectedCountry = string.Empty;
    private StoreType? _selectedType;
    private IReadOnlyList<StoreDto> _stores = [];
    private bool _isModalOpen = false;
    private Guid? _selectedId;
    private string _modalName = string.Empty;
    private StoreType _modalType = StoreType.Hybrid;
    private string _modalCountry = "España";
    private string? _modalCity;
    private string? _modalAddress;
    private string? _modalDescription;
    private string? _modalLogoUrl;
    private string? _modalWebsiteUrl;
    private string? _modalAffiliateCode;
    private bool _modalHasLoyaltyProgram;
    private List<SocialNetworkLinkDto>? _modalSocialLinks;
    private List<string>? _modalShippingCountries;

    private static readonly string[] PastelBgs =
    [
        "bg-[var(--p-blue)]",
        "bg-[var(--p-pink)]",
        "bg-[var(--p-peach)]",
        "bg-[var(--p-mint)]"
    ];

    private static readonly string[] Rotations =
    [
        "-rotate-2",
        "rotate-2",
        "-rotate-1",
        "rotate-1"
    ];

    private static string GetPastelBg(int index) => PastelBgs[index % PastelBgs.Length];
    private static string GetRotationClass(int index) => Rotations[index % Rotations.Length];

    protected override async Task OnInitializedAsync()
    {
        var userLoc = await UserLocationService.GetUserLocationAsync();
        if (!string.IsNullOrWhiteSpace(userLoc.EffectiveCountry))
        {
            _selectedCountry = userLoc.EffectiveCountry;
        }

        await LoadStoresAsync();
    }

    private async Task LoadStoresAsync()
    {
        _loading = true;
        var countryFilter = string.IsNullOrWhiteSpace(_selectedCountry) ? null : _selectedCountry;
        _stores = await StoreService.GetAllAsync(_searchTerm, _selectedType, countryFilter);
        _loading = false;
    }

    private async Task FilterStores()
    {
        var countryFilter = string.IsNullOrWhiteSpace(_selectedCountry) ? null : _selectedCountry;
        _stores = await StoreService.GetAllAsync(_searchTerm, _selectedType, countryFilter);
    }

    private async Task SetTypeFilter(StoreType? type)
    {
        _selectedType = type;
        await FilterStores();
    }

    private async Task SyncDirectoryAsync()
    {
        if (_isSyncing) return;
        _isSyncing = true;
        try
        {
            await DirectorySeederService.SeedDirectoryAsync();
            await LoadStoresAsync();
        }
        catch (Exception)
        {
            // Salvaguarda
        }
        finally
        {
            _isSyncing = false;
        }
    }

    private string FormatStoreType(StoreType type) => type switch
    {
        StoreType.Hybrid => "Híbrida (Física y Online)",
        StoreType.PhysicalOnly => "Solo Tienda Física",
        StoreType.OnlineOnly => "Solo Tienda Online",
        _ => "Tienda"
    };

    private void OpenCreateModal()
    {
        _selectedId = null;
        _modalName = string.Empty;
        _modalType = StoreType.Hybrid;
        _modalCountry = string.IsNullOrWhiteSpace(_selectedCountry) ? "España" : _selectedCountry;
        _modalCity = null;
        _modalAddress = null;
        _modalDescription = null;
        _modalLogoUrl = null;
        _modalWebsiteUrl = null;
        _modalAffiliateCode = null;
        _modalHasLoyaltyProgram = false;
        _modalSocialLinks = new List<SocialNetworkLinkDto>();
        _modalShippingCountries = null;
        _isModalOpen = true;
    }

    private void OpenEditModal(StoreDto store)
    {
        _selectedId = store.Id;
        _modalName = store.Name;
        _modalType = store.Type;
        _modalCountry = store.Country;
        _modalCity = store.City;
        _modalAddress = store.Address;
        _modalDescription = store.Description;
        _modalLogoUrl = store.LogoUrl;
        _modalWebsiteUrl = store.WebsiteUrl;
        _modalAffiliateCode = store.AffiliateCode;
        _modalHasLoyaltyProgram = store.HasLoyaltyProgram;
        _modalSocialLinks = store.SocialLinks.ToList();
        _modalShippingCountries = store.ShippingCountries?.ToList();
        _isModalOpen = true;
    }
}
