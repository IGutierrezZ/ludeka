@page "/admin/cola-catalogacion"
@attribute [Authorize(Policy = AuthorizationPolicies.PermisoEditarFichas)]
@rendermode InteractiveServer
@implements IDisposable
@using Ludeka.Application.Contracts
@using Ludeka.Application.DTOs
@using Ludeka.Core.Enums
@inject INightlyCatalogingService NightlyService
@inject IBggCatalogQueueService QueueService
@inject IBggMassIngestionService MassIngestionService
@inject IBggDiscoveryService DiscoveryService
@inject IBggRawSnapshotSyncService SnapshotSyncService
@inject ICurrentUserService CurrentUserService
@inject IServiceScopeFactory ScopeFactory
@inject NavigationManager Navigation

<PageTitle>Cola de Catalogación & Batch Nocturno — Ludeka</PageTitle>

<div class="container-ludeka py-8 space-y-8">
    @if (!CanManageQueue)
    {
        <div class="p-8 rounded-2xl bg-[var(--bg-card)] border border-rose-500/20 text-center space-y-4 max-w-lg mx-auto">
            <span class="inline-block"><Icon Name="shield" Size="36" /></span>
            <h2 class="text-xl font-bold text-[var(--text-primary)]">Acceso Exclusivo de Moderación</h2>
            <p class="text-sm text-[var(--text-secondary)]">
                Esta sección está reservada a la Mesa Fundadora y moderadores con permisos de edición de catálogo.
            </p>
            <a href="/" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[var(--brand-primary)] text-white text-xs font-bold hover:opacity-90 transition-opacity">
                Volver al Inicio
            </a>
        </div>
    }
    else
    {
        @* Encabezado de Página *@
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 border-b border-[var(--border-subtle)] pb-6">
            <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-secondary)] text-xs font-bold mb-2">
                    <Icon Name="moon" Size="14" /> Operaciones & Catálogo Automático
                </div>
                <h1 class="text-3xl sm:text-4xl font-black text-[var(--text-primary)] tracking-tight">
                    Cola de Catalogación & Batch Nocturno
                </h1>
                <p class="text-sm text-[var(--text-secondary)] mt-1 max-w-2xl">
                    Supervisión y control del pipeline inteligente de extracción de juegos en novedades editoriales, ingesta de cola comunitaria y relleno de cupo con el Top de BGG.
                </p>
            </div>

            <div class="flex items-center gap-3 flex-wrap">
                <button type="button"
                        @onclick="ExecuteBggDiscoveryAsync"
                        disabled="@(_isNightlyBatchActive || _isDiscoveringBgg)"
                        class="px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs transition-all flex items-center gap-2 shadow-sm disabled:opacity-50 disabled:cursor-not-allowed">
                    @if (_isDiscoveringBgg)
                    {
                        <span class="animate-spin inline-block"><Icon Name="settings" Size="14" /></span>
                        <span>Escaneando BGG...</span>
                    }
                    else
                    {
                        <Icon Name="trending-up" Size="14" />
                        <span>Escanear Novedades BGG</span>
                    }
                </button>

                @* Control de Batch Nocturno con Selector de Cupo *@
                <div class="flex items-center rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] p-1 gap-1">
                    <span class="text-xs text-[var(--text-muted)] font-semibold px-2 flex items-center gap-1">
                        <Icon Name="hash" Size="12" /> Lote:
                    </span>
                    <select @bind="_customBatchLimit"
                            disabled="@_isNightlyBatchActive"
                            class="bg-transparent text-xs font-bold text-[var(--text-primary)] rounded-lg px-2 py-1.5 border-0 focus:ring-1 focus:ring-[var(--brand-primary)] cursor-pointer disabled:cursor-not-allowed">
                        <option value="40">40 títulos (rápido)</option>
                        <option value="50">50 títulos</option>
                        <option value="100">100 títulos</option>
                        <option value="200">200 títulos</option>
                        <option value="400">400 títulos (completo)</option>
                    </select>

                    @if (_isNightlyBatchActive)
                    {
                        <button type="button"
                                @onclick="StopNightlyBatch"
                                class="px-3.5 py-1.5 rounded-lg bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs transition-all flex items-center gap-1.5 shadow-sm">
                            <span class="animate-spin inline-block"><Icon Name="loader" Size="13" /></span>
                            <span>Detener Batch</span>
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                @onclick="ExecuteNightlyBatchAsync"
                                class="px-3.5 py-1.5 rounded-lg bg-[var(--brand-primary)] hover:opacity-90 text-white font-bold text-xs transition-all flex items-center gap-1.5 shadow-sm">
                            <Icon Name="zap" Size="13" />
                            <span>Ejecutar Batch</span>
                        </button>
                    }
                </div>

                <button type="button"
                        @onclick="LoadDataAsync"
                        disabled="@_isNightlyBatchActive"
                        class="px-3.5 py-2.5 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] hover:border-[var(--brand-primary)] text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all flex items-center gap-1.5 shadow-sm">
                    <Icon Name="refresh-cw" Size="14" />
                    <span>Refrescar</span>
                </button>
            </div>
        </div>

        @* Banner reactivo de estado de Batch Nocturno *@
        @if (_isNightlyBatchActive)
        {
            <div class="p-4 rounded-xl bg-[var(--brand-primary)]/10 border border-[var(--brand-primary)]/30 text-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3 animate-pulse shadow-sm">
                <div class="flex items-center gap-2.5">
                    <span class="animate-spin inline-block text-[var(--brand-primary)]"><Icon Name="loader" Size="18" /></span>
                    <div>
                        <span class="font-bold text-[var(--text-primary)] text-sm">Batch Nocturno de Catalogación en Segundo Plano Activo</span>
                        <p class="text-[var(--text-secondary)] text-[0.75rem] mt-0.5">
                            @(_nightlyBatchMessage ?? "Procesando títulos BGG y enriquecimiento Gemini Flash...")
                        </p>
                    </div>
                </div>
                <button type="button"
                        @onclick="StopNightlyBatch"
                        class="px-3.5 py-1.5 rounded-lg bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs shrink-0 self-start sm:self-auto transition-all shadow-sm">
                    Detener Batch
                </button>
            </div>
        }
        else if (!string.IsNullOrEmpty(_nightlyBatchMessage))
        {
            <div class="p-3.5 rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)] text-xs text-[var(--text-secondary)] flex items-center justify-between gap-2 shadow-sm">
                <span><Icon Name="circle-check" Size="14" class="inline text-emerald-500 mr-1.5" /> @_nightlyBatchMessage</span>
                <button type="button" @onclick="() => _nightlyBatchMessage = null" class="text-base text-[var(--text-muted)] hover:text-[var(--text-primary)]">&times;</button>
            </div>
        }

        @* Tarjetas de Métricas KPI *@
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
            <div class="p-5 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-1">
                <span class="text-xs text-[var(--text-muted)] font-semibold flex items-center gap-1.5">
                    <Icon Name="target" Size="12" /> Cupo Diario Configurado
                </span>
                <div class="text-2xl font-black text-[var(--text-primary)]">
                    @(_options?.DailyCatalogingLimit ?? 400) <span class="text-xs font-normal text-[var(--text-muted)]">juegos / día</span>
                </div>
                <div class="text-[0.7rem] text-emerald-600 dark:text-emerald-400 font-medium">
                    Pausa de cortesía: @(_options?.MinDelaySecondsBetweenCalls ?? 2.5)s activa
                </div>
            </div>

            <div class="p-5 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-1">
                <span class="text-xs text-[var(--text-muted)] font-semibold flex items-center gap-1.5">
                    <Icon Name="hourglass" Size="14" /> En Cola de Espera
                </span>
                <div class="text-2xl font-black text-amber-500">
                    @_totalQueueCount <span class="text-xs font-normal text-[var(--text-muted)]">títulos pendientes</span>
                </div>
                <div class="text-[0.7rem] text-[var(--text-secondary)]">
                    Prioridad comunitaria y novedades
                </div>
            </div>

            <div class="p-5 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-1">
                <span class="text-xs text-[var(--text-muted)] font-semibold flex items-center gap-1.5">
                    <Icon Name="newspaper" Size="14" /> Origen Novedades
                </span>
                <div class="text-2xl font-black text-sky-500">
                    @_newsDiscoveryCount <span class="text-xs font-normal text-[var(--text-muted)]">descubrimientos</span>
                </div>
                <div class="text-[0.7rem] text-[var(--text-secondary)]">
                    Extraídos de anuncios editoriales
                </div>
            </div>

            <div class="p-5 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-1">
                <span class="text-xs text-[var(--text-muted)] font-semibold flex items-center gap-1.5">
                    <Icon Name="trending-up" Size="14" /> Tendencias BGG
                </span>
                <div class="text-2xl font-black text-rose-500">
                    @_bggDiscoveryCount <span class="text-xs font-normal text-[var(--text-muted)]">descubiertos</span>
                </div>
                <div class="text-[0.7rem] text-[var(--text-secondary)]">
                    Hotness & lanzamientos del año
                </div>
            </div>

            <div class="p-5 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-1">
                <span class="text-xs text-[var(--text-muted)] font-semibold flex items-center gap-1.5">
                    <Icon Name="scroll" Size="14" /> Última Ejecución
                </span>
                <div class="text-2xl font-black @GetStatusColor(_lastHistory?.Status)">
                    @(_lastHistory?.Status ?? "Sin historial")
                </div>
                <div class="text-[0.7rem] text-[var(--text-secondary)]">
                    @if (_lastHistory != null)
                    {
                        <span>@_lastHistory.TotalCatalogedCount catalogados (@_lastHistory.StartedAt.ToLocalTime().ToString("dd/MM HH:mm"))</span>
                    }
                    else
                    {
                        <span>Esperando primer ciclo</span>
                    }
                </div>
            </div>
        </div>

        @* Notificación de Descubrimiento BGG *@
        @if (_discoveryResult != null)
        {
            <div class="p-5 rounded-2xl border bg-amber-500/10 border-amber-500/30 text-xs space-y-2">
                <div class="flex items-center justify-between font-bold text-sm text-amber-600 dark:text-amber-300">
                    <span class="flex items-center gap-2">
                        <Icon Name="trending-up" Size="16" />
                        <span>Escaneo de Novedades y Tendencias BGG Completado</span>
                    </span>
                    <button type="button" @onclick="() => _discoveryResult = null" class="text-[var(--text-muted)] hover:text-[var(--text-primary)] text-base font-bold">&times;</button>
                </div>
                <p class="text-[var(--text-secondary)]">
                    Se escanearon <strong>@_discoveryResult.TotalScanned títulos</strong> en BGG:
                    <strong>@_discoveryResult.EnqueuedCount nuevos juegos</strong> agregados a la cola de catalogación,
                    <strong>@_discoveryResult.AlreadyCatalogedCount</strong> ya en catálogo y
                    <strong>@_discoveryResult.AlreadyInQueueCount</strong> ya presentes en espera o staging.
                </p>
                @if (_discoveryResult.EnqueuedTitles.Count > 0)
                {
                    <div class="text-[var(--text-muted)] pt-1 border-t border-[var(--border-subtle)]">
                        <strong>Nuevos encolados:</strong> @string.Join(", ", _discoveryResult.EnqueuedTitles)
                    </div>
                }
            </div>
        }

        @* Notificación de Resultado en Vivo *@
        @if (_lastResult != null)
        {
            <div class="p-5 rounded-2xl border @(_lastResult.FailedCount == 0 ? "bg-emerald-500/10 border-emerald-500/30" : "bg-amber-500/10 border-amber-500/30") text-xs space-y-2">
                <div class="flex items-center justify-between font-bold text-sm @(_lastResult.FailedCount == 0 ? "text-emerald-600 dark:text-emerald-300" : "text-amber-600 dark:text-amber-300")">
                    <span class="flex items-center gap-2">
                        <Icon Name="@(_lastResult.FailedCount == 0 ? "circle-check" : "triangle-alert")" Size="16" />
                        <span>Ejecución del Lote Completada</span>
                    </span>
                    <button type="button" @onclick="() => _lastResult = null" class="text-[var(--text-muted)] hover:text-[var(--text-primary)] text-base font-bold">&times;</button>
                </div>
                <p class="text-[var(--text-secondary)]">
                    Se han catalogado <strong>@_lastResult.TotalCatalogedCount juegos nuevos</strong>:
                    <strong>@_lastResult.QueueProcessedCount</strong> procedentes de la cola comunitaria/novedades y
                    <strong>@_lastResult.TopBackfillCount</strong> incorporados del Top de BGG.
                    @if (_lastResult.FailedCount > 0)
                    {
                        <span class="text-rose-500 font-semibold">(@_lastResult.FailedCount fallos registrados).</span>
                    }
                </p>
                @if (_lastResult.CatalogedTitles.Count > 0)
                {
                    <div class="text-[var(--text-muted)] pt-1 border-t border-[var(--border-subtle)]">
                        <strong>Títulos incorporados:</strong> @string.Join(", ", _lastResult.CatalogedTitles)
                    </div>
                }
            </div>
        }

        @* Sección 0: Ingesta Masiva BGG & Staging (~8.000 títulos) *@
        <div class="p-6 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[var(--border-subtle)] pb-4">
                <div>
                    <div class="flex items-center gap-2 flex-wrap mb-1">
                        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[var(--brand-primary)]/10 text-[var(--brand-primary)] text-xs font-bold">
                            <Icon Name="database" Size="12" /> Ingesta Masiva & Staging (Catálogo BGG)
                        </div>
                        @if (_pendingQualityCount > 0)
                        {
                            <div class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-violet-500/10 text-violet-400 text-xs font-bold border border-violet-500/20">
                                <Icon Name="sparkles" Size="12" /> @_pendingQualityCount títulos pendientes de enriquecimiento
                            </div>
                        }
                        else
                        {
                            <div class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-bold border border-emerald-500/20">
                                <Icon Name="check" Size="12" /> Catálogo 100% enriquecido
                            </div>
                        }
                    </div>
                    <h3 class="text-lg font-bold text-[var(--text-primary)]">
                        Estado del Pipeline de Catálogo BGG
                    </h3>
                    <p class="text-xs text-[var(--text-muted)] mt-0.5">
                        Aislamiento de catálogo, fotos comunitarias de GeekDo a Cloudflare R2 y síntesis con Gemini Flash en lotes.
                    </p>
                </div>

                <div class="flex items-center gap-2 flex-wrap">
                    <button type="button"
                            @onclick="ExecuteAutonomousStagingSeedAsync"
                            disabled="@(_isSeedingStaging || _isDrainingStaging || _isClearingStaging || _isBackfillingQuality || _isContinuousBackfillActive)"
                            class="px-3.5 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] hover:border-sky-500 text-xs font-bold text-[var(--text-primary)] transition-all flex items-center gap-1.5 shadow-sm disabled:opacity-50">
                        @if (_isSeedingStaging)
                        {
                            <span class="animate-spin inline-block"><Icon Name="loader" Size="14" /></span>
                            <span>Descargando y Poblando (≥100 opiniones)...</span>
                        }
                        else
                        {
                            <Icon Name="download" Size="14" class="text-sky-500" />
                            <span>Descargar y Poblar Catálogo BGG (≥100 opiniones)</span>
                        }
                    </button>

                    <button type="button"
                            @onclick="ExecuteStagingDrainAsync"
                            disabled="@(_isDrainingStaging || _isSeedingStaging || _isClearingStaging || _isContinuousDrainActive || _isBackfillingQuality || _isContinuousBackfillActive)"
                            class="px-3.5 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] hover:border-[var(--brand-primary)] text-xs font-bold text-[var(--text-primary)] transition-all flex items-center gap-1.5 shadow-sm disabled:opacity-50">
                        @if (_isDrainingStaging)
                        {
                            <span class="animate-spin inline-block"><Icon Name="settings" Size="14" /></span>
                            <span>Drenando Staging...</span>
                        }
                        else
                        {
                            <Icon Name="play" Size="14" class="text-[var(--brand-primary)]" />
                            <span>Drenar 1 Ciclo</span>
                        }
                    </button>

                    @if (!_isContinuousDrainActive)
                    {
                        <button type="button"
                                @onclick="StartContinuousDrain"
                                disabled="@(_isDrainingStaging || _isSeedingStaging || _isClearingStaging || _isBackfillingQuality || _isContinuousBackfillActive || _isContinuousAiDrainActive)"
                                class="px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition-all flex items-center gap-1.5 shadow-sm disabled:opacity-50">
                            <Icon Name="play" Size="14" />
                            <span>Drenaje Continuo (Segundo Plano)</span>
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                @onclick="StopContinuousDrain"
                                class="px-3.5 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-slate-950 text-xs font-bold transition-all flex items-center gap-1.5 shadow-sm">
                            <span class="animate-spin inline-block"><Icon Name="loader" Size="14" /></span>
                            <span>Detener Drenaje Continuo</span>
                        </button>
                    }

                    @if (!_isContinuousAiDrainActive)
                    {
                        <button type="button"
                                @onclick="StartContinuousAiDrain"
                                disabled="@(_isDrainingStaging || _isSeedingStaging || _isClearingStaging || _isBackfillingQuality || _isContinuousBackfillActive || _isContinuousDrainActive || (_stagingMetrics?.PendingAiCount ?? 0) == 0)"
                                class="px-3.5 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold transition-all flex items-center gap-1.5 shadow-sm disabled:opacity-50"
                                title="Lanza en segundo plano el procesamiento de todos los títulos pendientes de síntesis con Gemini Flash en lotes y promoción a catálogo">
                            <Icon Name="sparkles" Size="14" />
                            <span>Lanzar Pendientes IA en Lotes@((_stagingMetrics?.PendingAiCount ?? 0) > 0 ? $" ({_stagingMetrics!.PendingAiCount})" : "")</span>
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                @onclick="StopContinuousAiDrain"
                                class="px-3.5 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-slate-950 text-xs font-bold transition-all flex items-center gap-1.5 shadow-sm">
                            <span class="animate-spin inline-block"><Icon Name="loader" Size="14" /></span>
                            <span>Detener Lotes IA</span>
                        </button>
                    }

                    <button type="button"
                            @onclick="ExecuteQualitySweepBatchAsync"
                            disabled="@(_isSweepingQuality || _isBackfillingQuality || _isDrainingStaging || _isSeedingStaging || _isClearingStaging || _isContinuousDrainActive || _isContinuousBackfillActive || _isContinuousSweepActive)"
                            class="px-3.5 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] hover:border-violet-500 text-xs font-bold text-[var(--text-primary)] transition-all flex items-center gap-1.5 shadow-sm disabled:opacity-50">
                        @if (_isSweepingQuality)
                        {
                            <span class="animate-spin inline-block"><Icon Name="loader" Size="14" /></span>
                            <span>Barriendo Calidad (Lote)...</span>
                        }
                        else
                        {
                            <Icon Name="sparkles" Size="14" class="text-violet-400" />
                            <span>Barrido Calidad (Lote 50)</span>
                        }
                    </button>

                    @if (!_isContinuousSweepActive)
                    {
                        <button type="button"
                                @onclick="StartContinuousSweep"
                                disabled="@(_isSweepingQuality || _isBackfillingQuality || _isDrainingStaging || _isSeedingStaging || _isClearingStaging || _isContinuousDrainActive || _isContinuousBackfillActive || _totalCatalogCount == 0)"
                                class="px-3.5 py-2 rounded-xl bg-violet-600 hover:bg-violet-500 text-white text-xs font-bold transition-all flex items-center gap-1.5 shadow-sm disabled:opacity-50"
                                title="Audita y sanea ordenadamente todos los juegos del catálogo (~@_totalCatalogCount títulos) por cursor ascendente, corrigiendo falsos Eurogames, duraciones y escalabilidad">
                            <Icon Name="sparkles" Size="14" />
                            <span>Barrido Total Catálogo (@(_totalCatalogCount > 0 ? $"~{_totalCatalogCount}" : "Completo"))</span>
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                @onclick="StopContinuousSweep"
                                class="px-3.5 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-slate-950 text-xs font-bold transition-all flex items-center gap-1.5 shadow-sm">
                            <span class="animate-spin inline-block"><Icon Name="loader" Size="14" /></span>
                            <span>Detener Barrido Total</span>
                        </button>
                    }

                    @if (!_isContinuousBackfillActive)
                    {
                        <button type="button"
                                @onclick="StartContinuousBackfill"
                                disabled="@(_isSweepingQuality || _isBackfillingQuality || _isDrainingStaging || _isSeedingStaging || _isClearingStaging || _isContinuousDrainActive || _isContinuousSweepActive || _pendingQualityCount == 0)"
                                class="px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] hover:border-violet-500 text-xs font-bold text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all flex items-center gap-1.5 shadow-sm disabled:opacity-50"
                                title="Actualiza escalabilidad solo para los títulos sin votos comunitarios">
                            <Icon Name="sparkles" Size="14" class="text-violet-400" />
                            <span>Pendientes Sin Votos (@(_pendingQualityCount > 0 ? $"~{_pendingQualityCount}" : "0"))</span>
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                @onclick="StopContinuousBackfill"
                                class="px-3.5 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-slate-950 text-xs font-bold transition-all flex items-center gap-1.5 shadow-sm">
                            <span class="animate-spin inline-block"><Icon Name="loader" Size="14" /></span>
                            <span>Detener Pendientes</span>
                        </button>
                    }

                    @if ((_stagingMetrics?.AiQuotaExceededCount ?? 0) > 0)
                    {
                        <button type="button"
                                @onclick="ExecuteResetAiQuotaAsync"
                                disabled="@(_isResettingAiQuota || _isDrainingStaging)"
                                class="px-3.5 py-2 rounded-xl bg-purple-500/10 border border-purple-500/30 hover:bg-purple-500/20 text-xs font-bold text-purple-400 transition-all flex items-center gap-1.5 shadow-sm disabled:opacity-50">
                            @if (_isResettingAiQuota)
                            {
                                <span class="animate-spin inline-block"><Icon Name="loader" Size="14" /></span>
                                <span>Reanudando...</span>
                            }
                            else
                            {
                                <Icon Name="refresh-cw" Size="14" class="text-purple-400" />
                                <span>Reanudar IA en Pausa (@_stagingMetrics!.AiQuotaExceededCount)</span>
                            }
                        </button>
                    }

                    @if (!_confirmClearStaging)
                    {
                        <button type="button"
                                @onclick="() => _confirmClearStaging = true"
                                disabled="@(_isClearingStaging || _isSeedingStaging || _isDrainingStaging || (_stagingMetrics?.TotalInStaging ?? 0) == 0)"
                                class="px-3.5 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] hover:border-rose-500 hover:text-rose-500 text-xs font-bold text-[var(--text-muted)] transition-all flex items-center gap-1.5 shadow-sm disabled:opacity-40">
                            <Icon Name="trash-2" Size="14" class="text-rose-500" />
                            <span>Vaciar Staging</span>
                        </button>
                    }
                    else
                    {
                        <div class="inline-flex items-center gap-1.5 p-1 bg-rose-500/10 border border-rose-500/30 rounded-xl">
                            <span class="text-xs text-rose-500 font-bold px-1.5">¿Seguro?</span>
                            <button type="button"
                                    @onclick="ExecuteClearStagingAsync"
                                    disabled="@_isClearingStaging"
                                    class="px-2.5 py-1 rounded-lg bg-rose-600 hover:bg-rose-500 text-xs font-bold text-white shadow-sm flex items-center gap-1">
                                @if (_isClearingStaging)
                                {
                                    <span class="animate-spin inline-block"><Icon Name="loader" Size="12" /></span>
                                    <span>Vaciando...</span>
                                }
                                else
                                {
                                    <span>Sí, vaciar</span>
                                }
                            </button>
                            <button type="button"
                                    @onclick="() => _confirmClearStaging = false"
                                    disabled="@_isClearingStaging"
                                    class="px-2 py-1 rounded-lg bg-[var(--bg-surface)] text-xs font-bold text-[var(--text-muted)] hover:text-[var(--text-primary)]">
                                Cancelar
                            </button>
                        </div>
                    }
                </div>
            </div>

            @if (_stagingMetrics != null)
            {
                <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3 text-center">
                    <div class="p-3 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)]">
                        <span class="text-[0.7rem] text-[var(--text-muted)] uppercase tracking-wider font-bold">Total Staging</span>
                        <div class="text-xl font-black text-[var(--text-primary)]">@_stagingMetrics.TotalInStaging</div>
                    </div>
                    <div class="p-3 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)]">
                        <span class="text-[0.7rem] text-[var(--text-muted)] uppercase tracking-wider font-bold">Pend. Thing</span>
                        <div class="text-xl font-black text-amber-500">@_stagingMetrics.PendingFetchCount</div>
                    </div>
                    <div class="p-3 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)]">
                        <span class="text-[0.7rem] text-[var(--text-muted)] uppercase tracking-wider font-bold">Pend. Fotos R2</span>
                        <div class="text-xl font-black text-sky-500">@_stagingMetrics.PendingImagesCount</div>
                    </div>
                    <div class="p-3 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)]">
                        <span class="text-[0.7rem] text-[var(--text-muted)] uppercase tracking-wider font-bold">Pend. IA Lote</span>
                        <div class="text-xl font-black text-purple-500">@_stagingMetrics.PendingAiCount</div>
                        @if (_stagingMetrics.AiQuotaExceededCount > 0)
                        {
                            <span class="text-[0.65rem] text-rose-500 font-bold block">@_stagingMetrics.AiQuotaExceededCount en pausa</span>
                            <button type="button"
                                    @onclick="ExecuteResetAiQuotaAsync"
                                    disabled="@(_isResettingAiQuota || _isDrainingStaging)"
                                    class="mt-1 px-2 py-0.5 text-[0.65rem] font-bold rounded bg-purple-500/20 text-purple-400 hover:bg-purple-500/30 border border-purple-500/30 transition-all">
                                Reanudar
                            </button>
                        }
                        else if (_stagingMetrics.PendingAiCount > 0)
                        {
                            @if (!_isContinuousAiDrainActive)
                            {
                                <button type="button"
                                        @onclick="StartContinuousAiDrain"
                                        disabled="@(_isDrainingStaging || _isSeedingStaging || _isClearingStaging || _isContinuousDrainActive)"
                                        class="mt-1 px-2 py-0.5 text-[0.65rem] font-bold rounded bg-purple-500/20 text-purple-400 hover:bg-purple-500/30 border border-purple-500/30 transition-all inline-flex items-center gap-1">
                                    <Icon Name="sparkles" Size="10" />
                                    <span>Lanzar Lotes</span>
                                </button>
                            }
                            else
                            {
                                <span class="text-[0.65rem] text-purple-400 font-bold block animate-pulse mt-1">En curso...</span>
                            }
                        }
                    </div>
                    <div class="p-3 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)]">
                        <span class="text-[0.7rem] text-[var(--text-muted)] uppercase tracking-wider font-bold">Listos Promo</span>
                        <div class="text-xl font-black text-emerald-500">@_stagingMetrics.PendingPromotionCount</div>
                    </div>
                    <div class="p-3 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)]">
                        <span class="text-[0.7rem] text-[var(--text-muted)] uppercase tracking-wider font-bold">Promovidos</span>
                        <div class="text-xl font-black text-emerald-600 dark:text-emerald-400">@_stagingMetrics.PromotedCount</div>
                    </div>
                    <div class="p-3 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)]">
                        <span class="text-[0.7rem] text-[var(--text-muted)] uppercase tracking-wider font-bold">Fallidos</span>
                        <div class="text-xl font-black @(_stagingMetrics.FailedCount > 0 ? "text-rose-500" : "text-[var(--text-muted)]")">@_stagingMetrics.FailedCount</div>
                        @if (_stagingMetrics.FailedCount > 0)
                        {
                            <div class="text-[0.65rem] space-y-0.5 mt-0.5">
                                <span class="text-rose-400 font-semibold block" title="Títulos bloqueados sin promover al catálogo por fallos en descarga XML">
                                    @_stagingMetrics.UnpromotedFailedCount sin promover
                                </span>
                                @if (_stagingMetrics.FailedCount > _stagingMetrics.UnpromotedFailedCount)
                                {
                                    <span class="text-amber-400/90 font-medium block" title="Títulos ya promovidos al catálogo pero con avisos en imágenes o síntesis IA">
                                        @(_stagingMetrics.FailedCount - _stagingMetrics.UnpromotedFailedCount) en catálogo c/avisos
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            @if (_isContinuousDrainActive)
            {
                <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3 animate-pulse">
                    <div class="flex items-center gap-2.5">
                        <span class="animate-spin inline-block text-emerald-400"><Icon Name="loader" Size="18" /></span>
                        <div>
                            <span class="font-bold text-emerald-400 text-sm">Drenaje Continuo en Segundo Plano Activo</span>
                            <p class="text-[var(--text-secondary)] text-[0.75rem] mt-0.5">
                                @(_continuousDrainMessage ?? "Procesando títulos BGG y síntesis IA con pausas de cortesía...")
                            </p>
                        </div>
                    </div>
                    <button type="button"
                            @onclick="StopContinuousDrain"
                            class="px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs shrink-0 self-start sm:self-auto">
                        Detener Drenaje
                    </button>
                </div>
            }

            @if (_isContinuousAiDrainActive)
            {
                <div class="p-4 rounded-xl bg-purple-500/10 border border-purple-500/30 text-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3 animate-pulse">
                    <div class="flex items-center gap-2.5">
                        <span class="animate-spin inline-block text-purple-400"><Icon Name="loader" Size="18" /></span>
                        <div>
                            <span class="font-bold text-purple-400 text-sm">Procesamiento de IA en Lotes en Segundo Plano Activo</span>
                            <p class="text-[var(--text-secondary)] text-[0.75rem] mt-0.5">
                                @(_continuousAiDrainMessage ?? "Sintetizando títulos con Gemini Flash en lotes y promoviendo al catálogo...")
                            </p>
                        </div>
                    </div>
                    <button type="button"
                            @onclick="StopContinuousAiDrain"
                            class="px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs shrink-0 self-start sm:self-auto">
                        Detener Lotes IA
                    </button>
                </div>
            }

            @if (!_isContinuousAiDrainActive && !string.IsNullOrEmpty(_continuousAiDrainMessage))
            {
                <div class="p-4 rounded-xl bg-purple-500/10 border border-purple-500/25 text-xs text-[var(--text-secondary)] flex items-center justify-between">
                    <span><Icon Name="circle-check" Size="14" class="inline text-purple-400 mr-1.5" /> @_continuousAiDrainMessage</span>
                    <button type="button" @onclick="() => _continuousAiDrainMessage = null" class="text-base text-[var(--text-muted)] hover:text-[var(--text-primary)]">&times;</button>
                </div>
            }

            @if (_isContinuousSweepActive)
            {
                <div class="p-4 rounded-xl bg-violet-500/10 border border-violet-500/30 text-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3 animate-pulse">
                    <div class="flex items-center gap-2.5">
                        <span class="animate-spin inline-block text-violet-400"><Icon Name="loader" Size="18" /></span>
                        <div>
                            <span class="font-bold text-violet-400 text-sm">Barrido Completo de Calidad de Catálogo Activo</span>
                            <p class="text-[var(--text-secondary)] text-[0.75rem] mt-0.5">
                                @(_continuousSweepMessage ?? "Auditando y corrigiendo falsos Eurogames, duraciones y escalabilidad...")
                            </p>
                        </div>
                    </div>
                    <button type="button"
                            @onclick="StopContinuousSweep"
                            class="px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs shrink-0 self-start sm:self-auto">
                        Detener Barrido
                    </button>
                </div>
            }

            @if (!_isContinuousSweepActive && !string.IsNullOrEmpty(_continuousSweepMessage))
            {
                <div class="p-4 rounded-xl bg-violet-500/10 border border-violet-500/25 text-xs text-[var(--text-secondary)] flex items-center justify-between">
                    <span><Icon Name="circle-check" Size="14" class="inline text-violet-400 mr-1.5" /> @_continuousSweepMessage</span>
                    <button type="button" @onclick="() => _continuousSweepMessage = null" class="text-base text-[var(--text-muted)] hover:text-[var(--text-primary)]">&times;</button>
                </div>
            }

            @if (_qualitySweepResult != null)
            {
                <div class="p-4 rounded-xl bg-violet-500/10 border border-violet-500/25 text-xs text-[var(--text-secondary)] flex items-center justify-between">
                    <span><Icon Name="sparkles" Size="14" class="inline text-violet-400 mr-1.5" /> @_qualitySweepResult.Message</span>
                    <button type="button" @onclick="() => _qualitySweepResult = null" class="text-base text-[var(--text-muted)] hover:text-[var(--text-primary)]">&times;</button>
                </div>
            }

            @if (_isContinuousBackfillActive)
            {
                <div class="p-4 rounded-xl bg-violet-500/10 border border-violet-500/30 text-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3 animate-pulse">
                    <div class="flex items-center gap-2.5">
                        <span class="animate-spin inline-block text-violet-400"><Icon Name="loader" Size="18" /></span>
                        <div>
                            <span class="font-bold text-violet-400 text-sm">Actualización de Calidad de Catálogo en Segundo Plano Activa</span>
                            <p class="text-[var(--text-secondary)] text-[0.75rem] mt-0.5">
                                @(_continuousBackfillMessage ?? "Enriqueciendo huella de mesa, fundas, duraciones, editoriales y escalabilidad...")
                            </p>
                        </div>
                    </div>
                    <button type="button"
                            @onclick="StopContinuousBackfill"
                            class="px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs shrink-0 self-start sm:self-auto">
                        Detener Actualización
                    </button>
                </div>
            }

            @if (!_isContinuousBackfillActive && !string.IsNullOrEmpty(_continuousBackfillMessage))
            {
                <div class="p-4 rounded-xl bg-violet-500/10 border border-violet-500/25 text-xs text-[var(--text-secondary)] flex items-center justify-between">
                    <span><Icon Name="circle-check" Size="14" class="inline text-violet-400 mr-1.5" /> @_continuousBackfillMessage</span>
                    <button type="button" @onclick="() => _continuousBackfillMessage = null" class="text-base text-[var(--text-muted)] hover:text-[var(--text-primary)]">&times;</button>
                </div>
            }

            @if (_qualityBackfillResult != null)
            {
                <div class="p-4 rounded-xl bg-violet-500/10 border border-violet-500/25 text-xs text-[var(--text-secondary)] flex items-center justify-between">
                    <span><Icon Name="sparkles" Size="14" class="inline text-violet-400 mr-1.5" /> @_qualityBackfillResult.Message (@_pendingQualityCount títulos pendientes restantes en catálogo)</span>
                    <button type="button" @onclick="() => _qualityBackfillResult = null" class="text-base text-[var(--text-muted)] hover:text-[var(--text-primary)]">&times;</button>
                </div>
            }

            @if (!_isContinuousDrainActive && !string.IsNullOrEmpty(_continuousDrainMessage))
            {
                <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/25 text-xs text-[var(--text-secondary)] flex items-center justify-between">
                    <span><Icon Name="circle-check" Size="14" class="inline text-emerald-500 mr-1.5" /> @_continuousDrainMessage</span>
                    <button type="button" @onclick="() => _continuousDrainMessage = null" class="text-base text-[var(--text-muted)] hover:text-[var(--text-primary)]">&times;</button>
                </div>
            }

            @if (_drainCycleResult != null)
            {
                <div class="p-4 rounded-xl bg-[var(--brand-primary)]/10 border border-[var(--brand-primary)]/25 text-xs text-[var(--text-secondary)] flex items-center justify-between">
                    <span><Icon Name="circle-check" Size="14" class="inline text-emerald-500 mr-1.5" /> @_drainCycleResult.Message</span>
                    <button type="button" @onclick="() => _drainCycleResult = null" class="text-base text-[var(--text-muted)] hover:text-[var(--text-primary)]">&times;</button>
                </div>
            }

            @if (_stagingSeedResult != null)
            {
                <div class="p-4 rounded-xl bg-sky-500/10 border border-sky-500/25 text-xs text-[var(--text-secondary)] flex items-center justify-between">
                    <span><Icon Name="circle-check" Size="14" class="inline text-sky-500 mr-1.5" /> @_stagingSeedResult</span>
                    <button type="button" @onclick="() => _stagingSeedResult = null" class="text-base text-[var(--text-muted)] hover:text-[var(--text-primary)]">&times;</button>
                </div>
            }
        </div>

        @* Sección Snapshots Crudos BGG & Expansiones Satélite (INC-90) *@
        <div class="p-6 rounded-3xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[var(--border-subtle)] pb-4">
                <div class="space-y-1">
                    <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 text-[0.7rem] font-bold">
                        <Icon Name="database" Size="12" /> Snapshots Crudos BGG & Expansiones (INC-90)
                    </div>
                    <h2 class="text-base font-bold text-[var(--text-primary)]">
                        Tabla Satélite de Payloads BGG & Auto-Vinculación de Expansiones
                    </h2>
                    <p class="text-xs text-[var(--text-secondary)] max-w-2xl leading-relaxed">
                        Preserva el payload íntegro de BGG XMLAPI2 en formato desacoplado (jsonb) para recálculos deterministas futuros, sin sobrecargar la entidad Game, con auto-vinculación de expansiones y descubrimiento satélite.
                    </p>
                </div>

                <div class="flex items-center gap-2 flex-wrap">
                    @if (_isContinuousSnapshotsSyncActive)
                    {
                        <button type="button"
                                @onclick="CancelContinuousSnapshotsSync"
                                class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-black text-xs font-black transition-all flex items-center gap-2 shadow-sm animate-pulse">
                            <Icon Name="pause" Size="14" />
                            <span>Pausar Sincronización Continua</span>
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                @onclick="ExecuteContinuousSnapshotsSync"
                                disabled="@(_isDiscoveringExpansions || _isAutoLinkingExpansions || !CanManageQueue || (_snapshotStatus != null && _snapshotStatus.PendingSnapshots == 0))"
                                class="px-4 py-2 rounded-xl bg-gradient-to-r from-cyan-500 to-teal-500 hover:from-cyan-400 hover:to-teal-400 text-black text-xs font-black transition-all flex items-center gap-2 shadow-sm disabled:opacity-50">
                            <Icon Name="play" Size="14" />
                            <span>Sincronización Total en Segundo Plano</span>
                        </button>
                    }

                    <button type="button"
                            @onclick="ExecuteDiscoverExpansionsAsync"
                            disabled="@(_isDiscoveringExpansions || _isAutoLinkingExpansions)"
                            class="px-3.5 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] hover:border-cyan-500 text-xs font-bold text-[var(--text-primary)] transition-all flex items-center gap-1.5 shadow-sm disabled:opacity-50">
                        @if (_isDiscoveringExpansions)
                        {
                            <span class="animate-spin inline-block"><Icon Name="loader" Size="14" /></span>
                            <span>Buscando...</span>
                        }
                        else
                        {
                            <Icon Name="plus-circle" Size="14" />
                            <span>Descubrir Expansiones Top (1.200)</span>
                        }
                    </button>

                    <button type="button"
                            @onclick="ExecuteAutoLinkExpansionsAsync"
                            disabled="@(_isDiscoveringExpansions || _isAutoLinkingExpansions)"
                            class="px-3.5 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] hover:border-cyan-500 text-xs font-bold text-[var(--text-primary)] transition-all flex items-center gap-1.5 shadow-sm disabled:opacity-50">
                        @if (_isAutoLinkingExpansions)
                        {
                            <span class="animate-spin inline-block"><Icon Name="loader" Size="14" /></span>
                            <span>Vinculando...</span>
                        }
                        else
                        {
                            <Icon Name="link" Size="14" />
                            <span>Auto-vincular Huérfanas</span>
                        }
                    </button>

                    @if (_isContinuousVersionsSyncActive)
                    {
                        <button type="button"
                                @onclick="CancelContinuousVersionsSync"
                                class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-black text-xs font-black transition-all flex items-center gap-2 shadow-sm animate-pulse">
                            <Icon Name="pause" Size="14" />
                            <span>Pausar Sincronización Versiones</span>
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                @onclick="ExecuteContinuousVersionsSync"
                                disabled="@(_isSweepingVersions || _isContinuousSnapshotsSyncActive || !CanManageQueue || (_snapshotStatus != null && _snapshotStatus.SnapshotsPendingVersions == 0))"
                                class="px-4 py-2 rounded-xl bg-gradient-to-r from-purple-500 to-indigo-500 hover:from-purple-400 hover:to-indigo-400 text-white text-xs font-black transition-all flex items-center gap-2 shadow-sm disabled:opacity-50"
                                title="Descarga en segundo plano todas las versiones BGG pendientes (2x1) y al terminar ejecuta el barrido automático de títulos en español y EAN en todo el catálogo">
                            <Icon Name="play" Size="14" />
                            <span>Sincronización Continua (2x1 + Barrido)</span>
                        </button>
                    }

                    <button type="button"
                            @onclick="ExecuteSweepVersionsCatalogAsync"
                            disabled="@(_isSweepingVersions || _isContinuousVersionsSyncActive)"
                            class="px-3.5 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] hover:border-emerald-500 text-xs font-bold text-[var(--text-primary)] transition-all flex items-center gap-1.5 shadow-sm disabled:opacity-50"
                            title="Barrido 100% offline sobre snapshots locales para actualizar títulos en español, editoriales y códigos EAN-13">
                        @if (_isSweepingVersions)
                        {
                            <span class="animate-spin inline-block"><Icon Name="loader" Size="14" /></span>
                            <span>Barriendo...</span>
                        }
                        else
                        {
                            <Icon Name="sparkles" Size="14" class="text-emerald-400" />
                            <span>Barrer Títulos ES y EAN</span>
                        }
                    </button>
                </div>
            </div>

            @* Cuadrícula de Métricas de Snapshots *@
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
                <div class="p-4 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] space-y-1">
                    <span class="text-[0.7rem] text-[var(--text-muted)] font-semibold flex items-center gap-1">
                        <Icon Name="gamepad-2" Size="12" /> Juegos con BGG ID
                    </span>
                    <div class="text-xl font-black text-[var(--text-primary)]">
                        @(_snapshotStatus?.TotalGamesWithBggId ?? 0)
                    </div>
                    <div class="text-[0.7rem] text-[var(--text-secondary)]">
                        Total en catálogo caliente
                    </div>
                </div>

                <div class="p-4 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] space-y-1">
                    <span class="text-[0.7rem] text-[var(--text-muted)] font-semibold flex items-center gap-1">
                        <Icon Name="database" Size="12" /> Snapshots Almacenados
                    </span>
                    <div class="text-xl font-black text-cyan-400">
                        @(_snapshotStatus?.TotalSnapshots ?? 0)
                    </div>
                    <div class="text-[0.7rem] text-[var(--text-secondary)]">
                        Tabla satélite desacoplada
                    </div>
                </div>

                <div class="p-4 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] space-y-1">
                    <span class="text-[0.7rem] text-[var(--text-muted)] font-semibold flex items-center gap-1">
                        <Icon Name="clock" Size="12" /> Snapshots Pendientes
                    </span>
                    <div class="text-xl font-black @((_snapshotStatus?.PendingSnapshots ?? 0) > 0 ? "text-amber-400" : "text-emerald-400")">
                        @(_snapshotStatus?.PendingSnapshots ?? 0)
                    </div>
                    <div class="text-[0.7rem] text-[var(--text-secondary)]">
                        @((_snapshotStatus?.PendingSnapshots ?? 0) > 0 ? "Requieren ingesta asistida" : "100% sincronizado")
                    </div>
                </div>

                <div class="p-4 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] space-y-1">
                    <span class="text-[0.7rem] text-[var(--text-muted)] font-semibold flex items-center gap-1">
                        <Icon Name="barcode" Size="12" /> Versiones BGG (EAN / ES)
                    </span>
                    <div class="text-xl font-black text-purple-400">
                        @(_snapshotStatus?.SnapshotsWithVersions ?? 0)
                    </div>
                    <div class="text-[0.7rem] text-[var(--text-secondary)]">
                        <span class="text-purple-400 font-medium">@(_snapshotStatus?.SnapshotsWithVersions ?? 0) con versiones</span> / <span class="text-amber-400 font-medium">@(_snapshotStatus?.SnapshotsPendingVersions ?? 0) pendientes</span>
                    </div>
                </div>

                <div class="p-4 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] space-y-1">
                    <span class="text-[0.7rem] text-[var(--text-muted)] font-semibold flex items-center gap-1">
                        <Icon Name="layers" Size="12" /> Expansiones en Catálogo
                    </span>
                    <div class="text-xl font-black text-[var(--text-primary)]">
                        @(_snapshotStatus?.TotalExpansions ?? 0)
                    </div>
                    <div class="text-[0.7rem] text-[var(--text-secondary)]">
                        <span class="text-emerald-400 font-medium">@(_snapshotStatus?.LinkedExpansions ?? 0) vinculadas</span> / <span class="text-amber-400 font-medium">@(_snapshotStatus?.UnlinkedExpansions ?? 0) huérfanas</span>
                    </div>
                </div>
            </div>

            @* Alerta de Sincronización Continua en Segundo Plano *@
            @if (!string.IsNullOrEmpty(_continuousSnapshotsSyncMessage))
            {
                <div class="p-4 rounded-xl @(_isContinuousSnapshotsSyncActive ? "bg-cyan-500/10 border-cyan-500/30 text-cyan-300" : "bg-emerald-500/10 border-emerald-500/25 text-emerald-300") border text-xs flex items-center justify-between">
                    <span class="flex items-center gap-2">
                        <Icon Name="@(_isContinuousSnapshotsSyncActive ? "loader" : "circle-check")" Size="14" class="@(_isContinuousSnapshotsSyncActive ? "animate-spin text-cyan-400" : "text-emerald-400")" />
                        @_continuousSnapshotsSyncMessage
                    </span>
                    @if (!_isContinuousSnapshotsSyncActive)
                    {
                        <button type="button" @onclick="() => _continuousSnapshotsSyncMessage = null" class="text-base text-[var(--text-muted)] hover:text-[var(--text-primary)]">&times;</button>
                    }
                </div>
            }

            @* Alerta de Sincronización Continua de Versiones en Segundo Plano *@
            @if (!string.IsNullOrEmpty(_continuousVersionsSyncMessage))
            {
                <div class="p-4 rounded-xl @(_isContinuousVersionsSyncActive ? "bg-purple-500/10 border-purple-500/30 text-purple-300" : "bg-emerald-500/10 border-emerald-500/25 text-emerald-300") border text-xs flex items-center justify-between">
                    <span class="flex items-center gap-2">
                        <Icon Name="@(_isContinuousVersionsSyncActive ? "loader" : "circle-check")" Size="14" class="@(_isContinuousVersionsSyncActive ? "animate-spin text-purple-400" : "text-emerald-400")" />
                        @_continuousVersionsSyncMessage
                    </span>
                    @if (!_isContinuousVersionsSyncActive)
                    {
                        <button type="button" @onclick="() => _continuousVersionsSyncMessage = null" class="text-base text-[var(--text-muted)] hover:text-[var(--text-primary)]">&times;</button>
                    }
                </div>
            }

            <div class="p-3 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[0.7rem] text-[var(--text-muted)] flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <span><Icon Name="terminal" Size="12" class="inline mr-1 text-cyan-400" /> <strong>Backfill de snapshots:</strong> <code class="px-1.5 py-0.5 rounded bg-black/40 text-cyan-300 font-mono">dotnet run --project src/Ludeka.Jobs -- bgg-raw-backfill</code></span>
                <span><Icon Name="terminal" Size="12" class="inline mr-1 text-purple-400" /> <strong>Barrido versiones &amp; EAN:</strong> <code class="px-1.5 py-0.5 rounded bg-black/40 text-purple-300 font-mono">dotnet run --project src/Ludeka.Jobs -- bgg-versions-sweep</code></span>
            </div>

            @* Alertas de Resultado *@


            @if (_expansionDiscoveryResult != null)
            {
                <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs flex items-center justify-between">
                    <div>
                        <strong>Descubrimiento completado:</strong> @_expansionDiscoveryResult.DiscoveredCount expansiones detectadas, <strong>@_expansionDiscoveryResult.EnqueuedCount agregadas a la cola</strong> de importación.
                        @if (_expansionDiscoveryResult.EnqueuedTitles.Count > 0)
                        {
                            <span class="text-[var(--text-secondary)] block text-[0.75rem] mt-0.5">@string.Join(", ", _expansionDiscoveryResult.EnqueuedTitles)</span>
                        }
                    </div>
                    <button type="button" @onclick="() => _expansionDiscoveryResult = null" class="text-base font-bold">&times;</button>
                </div>
            }

            @if (_autoLinkResultCount.HasValue)
            {
                <div class="p-4 rounded-xl bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs flex items-center justify-between">
                    <span><strong>Auto-vinculación finalizada:</strong> Se han enlazado @_autoLinkResultCount.Value expansiones huérfanas a sus juegos base correspondientes.</span>
                    <button type="button" @onclick="() => _autoLinkResultCount = null" class="text-base font-bold">&times;</button>
                </div>
            }



            @if (_versionsSweepResult != null)
            {
                var isError = _versionsSweepResult.Message?.StartsWith("Error", StringComparison.OrdinalIgnoreCase) ?? false;
                <div class="p-4 rounded-xl @(!isError ? "bg-emerald-500/10 border-emerald-500/30 text-emerald-300" : "bg-rose-500/10 border-rose-500/30 text-rose-300") border text-xs space-y-2">
                    <div class="flex items-center justify-between font-bold text-sm @(!isError ? "text-emerald-400" : "text-rose-400")">
                        <span class="flex items-center gap-2">
                            <Icon Name="@(!isError ? "circle-check" : "triangle-alert")" Size="16" />
                            <span>Barrido de Versiones y EAN Finalizado</span>
                        </span>
                        <button type="button" @onclick="() => _versionsSweepResult = null" class="text-[var(--text-muted)] hover:text-[var(--text-primary)] text-base font-bold">&times;</button>
                    </div>
                    <p class="text-[var(--text-secondary)]">
                        @_versionsSweepResult.Message
                    </p>
                </div>
            }
        </div>

        @* Sección 1: Cola de Auto-Catalogación *@
        <div class="p-6 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[var(--border-subtle)] pb-4">
                <div>
                    <h3 class="text-lg font-bold text-[var(--text-primary)]">
                        Cola de Juegos Pendientes
                    </h3>
                    <p class="text-xs text-[var(--text-muted)] mt-0.5">
                        Juegos solicitados para su catalogación oficial, organizados por origen y solicitudes.
                    </p>
                </div>

                <div class="flex items-center gap-2 flex-wrap text-xs">
                    <span class="text-[var(--text-muted)] font-semibold">Filtrar origen:</span>
                    <button type="button"
                            @onclick="() => _originFilter = null"
                            class="px-2.5 py-1 rounded-lg border text-xs font-semibold transition-all @(_originFilter == null ? "bg-[var(--brand-primary)] text-white border-[var(--brand-primary)]" : "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)]")">
                        Todos
                    </button>
                    <button type="button"
                            @onclick="() => _originFilter = CatalogQueueOrigin.NewsDiscovery"
                            class="px-2.5 py-1 rounded-lg border text-xs font-semibold transition-all @(_originFilter == CatalogQueueOrigin.NewsDiscovery ? "bg-sky-600 text-white border-sky-600" : "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)]")">
                        <Icon Name="newspaper" Size="12" /> Novedades
                    </button>
                    <button type="button"
                            @onclick="() => _originFilter = CatalogQueueOrigin.BggNewReleases"
                            class="px-2.5 py-1 rounded-lg border text-xs font-semibold transition-all @(_originFilter == CatalogQueueOrigin.BggNewReleases ? "bg-amber-600 text-white border-amber-600" : "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)]")">
                        <Icon Name="sparkles" Size="12" /> Novedades BGG
                    </button>
                    <button type="button"
                            @onclick="() => _originFilter = CatalogQueueOrigin.BggHotness"
                            class="px-2.5 py-1 rounded-lg border text-xs font-semibold transition-all @(_originFilter == CatalogQueueOrigin.BggHotness ? "bg-rose-600 text-white border-rose-600" : "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)]")">
                        <Icon Name="trending-up" Size="12" /> Tendencia BGG
                    </button>
                    <button type="button"
                            @onclick="() => _originFilter = CatalogQueueOrigin.UserImport"
                            class="px-2.5 py-1 rounded-lg border text-xs font-semibold transition-all @(_originFilter == CatalogQueueOrigin.UserImport ? "bg-emerald-600 text-white border-emerald-600" : "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)]")">
                        <Icon Name="user" Size="12" /> Usuarios
                    </button>
                    <button type="button"
                            @onclick="() => _originFilter = CatalogQueueOrigin.TopBggBackfill"
                            class="px-2.5 py-1 rounded-lg border text-xs font-semibold transition-all @(_originFilter == CatalogQueueOrigin.TopBggBackfill ? "bg-amber-600 text-white border-amber-600" : "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)]")">
                        <Icon Name="trophy" Size="12" /> Top BGG
                    </button>
                </div>
            </div>

            @if (_isLoading)
            {
                <div class="py-12 text-center text-[var(--text-muted)] space-y-2">
                    <div class="inline-block animate-spin"><Icon Name="hourglass" Size="24" /></div>
                    <p class="text-xs font-semibold">Cargando cola de catalogación...</p>
                </div>
            }
            else if (FilteredQueueItems.Count == 0)
            {
                <div class="py-12 text-center text-[var(--text-muted)] space-y-2">
                    <span class="inline-block"><Icon Name="party-popper" Size="30" /></span>
                    <p class="text-sm font-bold text-[var(--text-primary)]">La cola de espera está vacía</p>
                    <p class="text-xs max-w-sm mx-auto">
                        No hay juegos pendientes en este momento con el filtro seleccionado. El batch nocturno rellenará el cupo diario con los mejores juegos de BGG.
                    </p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs text-[var(--text-secondary)]">
                        <thead class="text-[0.7rem] uppercase tracking-wider text-[var(--text-muted)] border-b border-[var(--border-subtle)] bg-[var(--bg-surface)]">
                            <tr>
                                <th class="py-3 px-4 font-bold">Juego / Título</th>
                                <th class="py-3 px-4 font-bold">BGG ID</th>
                                <th class="py-3 px-4 font-bold">Origen</th>
                                <th class="py-3 px-4 font-bold text-center">Solicitudes</th>
                                <th class="py-3 px-4 font-bold">Estado</th>
                                <th class="py-3 px-4 font-bold">Fecha</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[var(--border-subtle)]">
                            @foreach (var item in FilteredQueueItems)
                            {
                                <tr class="hover:bg-[var(--bg-surface-elevated)] transition-colors">
                                    <td class="py-3 px-4 font-bold text-[var(--text-primary)]">
                                        <div class="flex items-center gap-2">
                                            @if (!string.IsNullOrWhiteSpace(item.ThumbnailUrl))
                                            {
                                                <img src="@item.ThumbnailUrl" alt="Miniatura de @item.Title" class="w-7 h-7 rounded object-cover border border-[var(--border-subtle)]" />
                                            }
                                            <div>
                                                <div>@item.Title</div>
                                                @if (!string.IsNullOrWhiteSpace(item.ExtractedTitle) && item.ExtractedTitle != item.Title)
                                                {
                                                    <div class="text-[0.65rem] text-[var(--text-muted)] font-normal">
                                                        Extraído: "@item.ExtractedTitle"
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3 px-4 font-mono text-[var(--text-muted)]">
                                        <a href="https://boardgamegeek.com/boardgame/@item.BggId" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--brand-primary)] underline" title="Ver ficha en BoardGameGeek">
                                            #@item.BggId ↗
                                        </a>
                                    </td>
                                    <td class="py-3 px-4">
                                        @switch (item.Origin)
                                        {
                                            case CatalogQueueOrigin.NewsDiscovery:
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[0.65rem] font-bold bg-sky-500/10 text-sky-400 border border-sky-500/20">
                                                    <Icon Name="newspaper" /> Novedad Editorial
                                                </span>
                                                break;
                                            case CatalogQueueOrigin.BggNewReleases:
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[0.65rem] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20">
                                                    <Icon Name="sparkles" /> Novedad BGG
                                                </span>
                                                break;
                                            case CatalogQueueOrigin.BggHotness:
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[0.65rem] font-bold bg-rose-500/10 text-rose-400 border border-rose-500/20">
                                                    <Icon Name="trending-up" /> Tendencia BGG
                                                </span>
                                                break;
                                            case CatalogQueueOrigin.TopBggBackfill:
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[0.65rem] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20">
                                                    <Icon Name="trophy" /> Top BGG
                                                </span>
                                                break;
                                            default:
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[0.65rem] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                                                    <Icon Name="user" /> Usuario
                                                </span>
                                                break;
                                        }
                                    </td>
                                    <td class="py-3 px-4 text-center font-bold text-[var(--text-primary)]">
                                        @item.RequestedCount
                                    </td>
                                    <td class="py-3 px-4">
                                        @switch (item.Status)
                                        {
                                            case CatalogQueueStatus.Processing:
                                                <span class="inline-flex items-center gap-1 text-amber-400 font-bold text-[0.7rem]">
                                                    <span class="animate-spin inline-block"><Icon Name="settings" Size="12" /></span> Procesando
                                                </span>
                                                break;
                                            case CatalogQueueStatus.Completed:
                                                <span class="inline-flex items-center gap-1 text-emerald-400 font-bold text-[0.7rem]">
                                                    <Icon Name="circle-check" Size="12" /> Completado
                                                </span>
                                                break;
                                            case CatalogQueueStatus.Failed:
                                                <span class="inline-flex items-center gap-1 text-rose-400 font-bold text-[0.7rem]" title="@item.ErrorMessage">
                                                    <Icon Name="circle-x" Size="12" /> Fallido
                                                </span>
                                                break;
                                            default:
                                                <span class="inline-flex items-center gap-1 text-[var(--text-muted)] font-semibold text-[0.7rem]">
                                                    <Icon Name="hourglass" Size="12" /> Pendiente
                                                </span>
                                                break;
                                        }
                                    </td>
                                    <td class="py-3 px-4 text-[var(--text-muted)] whitespace-nowrap">
                                        @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @* Sección 2: Historial de Ejecuciones Nocturnas *@
        <div class="p-6 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-6">
            <div class="border-b border-[var(--border-subtle)] pb-4">
                <h3 class="text-lg font-bold text-[var(--text-primary)]">
                    Bitácora Histórica de Lotes & Ejecuciones
                </h3>
                <p class="text-xs text-[var(--text-muted)] mt-0.5">
                    Registro de cada disparo del batch con detalle de juegos incorporados, cuota y orígenes.
                </p>
            </div>

            @if (_history.Count == 0)
            {
                <div class="py-8 text-center text-[var(--text-muted)] text-xs">
                    No existen registros históricos de ejecuciones todavía.
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs text-[var(--text-secondary)]">
                        <thead class="text-[0.7rem] uppercase tracking-wider text-[var(--text-muted)] border-b border-[var(--border-subtle)] bg-[var(--bg-surface)]">
                            <tr>
                                <th class="py-3 px-4 font-bold">Fecha / Hora</th>
                                <th class="py-3 px-4 font-bold">Estado</th>
                                <th class="py-3 px-4 font-bold text-center">Cola</th>
                                <th class="py-3 px-4 font-bold text-center">Novedades</th>
                                <th class="py-3 px-4 font-bold text-center">Top BGG</th>
                                <th class="py-3 px-4 font-bold text-center">Total Nuevos</th>
                                <th class="py-3 px-4 font-bold">Títulos Catalogados</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[var(--border-subtle)]">
                            @foreach (var log in _history)
                            {
                                <tr class="hover:bg-[var(--bg-surface-elevated)] transition-colors">
                                    <td class="py-3 px-4 font-semibold text-[var(--text-primary)] whitespace-nowrap">
                                        @log.StartedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="py-3 px-4">
                                        <span class="inline-flex items-center gap-1 font-bold @GetStatusColor(log.Status)">
                                            @(log.Status == "Completed" ? "Completado" : log.Status == "Running" ? "En curso" : log.Status)
                                        </span>
                                    </td>
                                    <td class="py-3 px-4 text-center font-bold text-[var(--text-primary)]">
                                        @log.QueueProcessedCount
                                    </td>
                                    <td class="py-3 px-4 text-center font-bold text-sky-400">
                                        @log.NewsDiscoveryCount
                                    </td>
                                    <td class="py-3 px-4 text-center font-bold text-amber-400">
                                        @log.TopBackfillCount
                                    </td>
                                    <td class="py-3 px-4 text-center font-black text-emerald-400">
                                        @log.TotalCatalogedCount
                                    </td>
                                    <td class="py-3 px-4 text-[var(--text-muted)] max-w-xs truncate" title="@string.Join(", ", log.CatalogedTitles)">
                                        @(log.CatalogedTitles.Count > 0 ? string.Join(", ", log.CatalogedTitles) : "—")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@code {
    private static CancellationTokenSource? _nightlyBatchCts;
    private static bool _isNightlyBatchActive => _nightlyBatchCts != null && !_nightlyBatchCts.IsCancellationRequested;
    private static string? _nightlyBatchMessage;
    private int _customBatchLimit = 400;

    private static CancellationTokenSource? _continuousDrainCts;
    private static bool _isContinuousDrainActive => _continuousDrainCts != null && !_continuousDrainCts.IsCancellationRequested;
    private static string? _continuousDrainMessage;

    private static CancellationTokenSource? _continuousAiDrainCts;
    private static bool _isContinuousAiDrainActive => _continuousAiDrainCts != null && !_continuousAiDrainCts.IsCancellationRequested;
    private static string? _continuousAiDrainMessage;

    private static CancellationTokenSource? _continuousBackfillCts;
    private static bool _isContinuousBackfillActive => _continuousBackfillCts != null && !_continuousBackfillCts.IsCancellationRequested;
    private static string? _continuousBackfillMessage;

    private static CancellationTokenSource? _continuousSweepCts;
    private static bool _isContinuousSweepActive => _continuousSweepCts != null && !_continuousSweepCts.IsCancellationRequested;
    private static string? _continuousSweepMessage;

    private PeriodicTimer? _pollTimer;
    private Task? _pollTask;

    private bool _isLoading = true;
    private bool _isDrainingStaging = false;
    private bool _isSeedingStaging = false;
    private bool _isClearingStaging = false;
    private bool _isResettingAiQuota = false;
    private bool _confirmClearStaging = false;
    private bool _isDiscoveringBgg = false;
    private bool _isBackfillingQuality = false;
    private bool _isSweepingQuality = false;
    private int _pendingQualityCount = 0;
    private int _totalCatalogCount = 0;
    private int _totalQueueCount = 0;
    private int _newsDiscoveryCount = 0;
    private int _bggDiscoveryCount = 0;
    private CatalogQueueOrigin? _originFilter = null;
    private NightlyCatalogingOptions? _options;
    private NightlyCatalogingResultDto? _lastResult;
    private NightlyCatalogingExecutionLogDto? _lastHistory;
    private BggDiscoveryResultDto? _discoveryResult;
    private BggStagingMetricsDto? _stagingMetrics;
    private BggMassIngestionCycleResultDto? _drainCycleResult;
    private BggQualityBackfillResultDto? _qualityBackfillResult;
    private BggQualitySweepBatchResultDto? _qualitySweepResult;
    private string? _stagingSeedResult;
    private IReadOnlyList<CatalogQueueItemDto> _queueItems = [];
    private IReadOnlyList<NightlyCatalogingExecutionLogDto> _history = [];

    // Incremento 90: Snapshots Crudos BGG y Expansiones
    private BggRawSnapshotStatusDto? _snapshotStatus;
    private BggExpansionDiscoveryResultDto? _expansionDiscoveryResult;
    private int? _autoLinkResultCount;
    private bool _isDiscoveringExpansions = false;
    private bool _isAutoLinkingExpansions = false;

    // Incremento 105: Versiones BGG, Títulos en Español y EAN (2x1)
    private BggVersionCatalogSweepResultDto? _versionsSweepResult;
    private bool _isSweepingVersions = false;

    // Sincronización continua de versiones (2x1 + barrido) en segundo plano
    private CancellationTokenSource? _continuousVersionsSyncCts;
    private string? _continuousVersionsSyncMessage;
    private bool _isContinuousVersionsSyncActive => _continuousVersionsSyncCts != null;

    // Incremento 91: Sincronización continua de snapshots en segundo plano
    private CancellationTokenSource? _continuousSnapshotsSyncCts;
    private string? _continuousSnapshotsSyncMessage;
    private bool _isContinuousSnapshotsSyncActive => _continuousSnapshotsSyncCts != null;

    private bool CanManageQueue =>
        CurrentUserService.IsFoundingTeam ||
        (CurrentUserService.IsInRole("Moderator") && CurrentUserService.HasPermission(ModeratorPermission.CanEditGames));

    private IReadOnlyList<CatalogQueueItemDto> FilteredQueueItems =>
        _originFilter.HasValue
            ? _queueItems.Where(i => i.Origin == _originFilter.Value).ToList()
            : _queueItems;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        if (_isNightlyBatchActive || _isContinuousDrainActive || _isContinuousAiDrainActive || _isContinuousBackfillActive || _isContinuousSweepActive || _isContinuousSnapshotsSyncActive || _isContinuousVersionsSyncActive)
        {
            StartPollingTimer();
        }
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _options = await NightlyService.GetOptionsAsync();
            _queueItems = await QueueService.GetTopPendingQueueAsync(100);
            _totalQueueCount = await QueueService.GetTotalPendingCountAsync();
            _newsDiscoveryCount = _queueItems.Count(i => i.Origin == CatalogQueueOrigin.NewsDiscovery);
            _bggDiscoveryCount = _queueItems.Count(i => i.Origin == CatalogQueueOrigin.BggNewReleases || i.Origin == CatalogQueueOrigin.BggHotness);
            _history = await NightlyService.GetExecutionHistoryAsync(15);
            _lastHistory = _history.FirstOrDefault();
            _stagingMetrics = await MassIngestionService.GetMetricsAsync();
            _pendingQualityCount = await MassIngestionService.GetPendingQualityBackfillCountAsync();
            _totalCatalogCount = await MassIngestionService.GetTotalCatalogCountAsync();
            _snapshotStatus = await SnapshotSyncService.GetStatusAsync();
        }
        catch (Exception)
        {
            // Salvaguarda
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ExecuteBggDiscoveryAsync()
    {
        if (_isDiscoveringBgg) return;

        _isDiscoveringBgg = true;
        _discoveryResult = null;

