        if (_isContinuousSweepActive || !CanManageQueue) return;

        _continuousSweepCts = new CancellationTokenSource();
        _continuousSweepMessage = "Barrido total de calidad iniciado en segundo plano...";

        var token = _continuousSweepCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                using var scope = ScopeFactory.CreateScope();
                var massService = scope.ServiceProvider.GetRequiredService<IBggMassIngestionService>();

                int totalEvaluated = 0;
                int totalUpdated = 0;
                int totalSkipped = 0;
                int totalFailed = 0;
                int currentAfterBggId = 0;

                while (!token.IsCancellationRequested)
                {
                    var res = await massService.RunScheduledSweepCatalogQualityBatchAsync(currentAfterBggId, batchSize: 50, token);
                    totalEvaluated += res.EvaluatedCount;
                    totalUpdated += res.UpdatedCount;
                    totalSkipped += res.SkippedCount;
                    totalFailed += res.FailedCount;
                    currentAfterBggId = res.LastBggIdProcessed;

                    _continuousSweepMessage = $"Barrido de calidad en curso: {totalEvaluated}/{_totalCatalogCount} evaluados ({totalUpdated} corregidos, {totalSkipped} ya correctos, {totalFailed} errores). Último BGG #{currentAfterBggId}.";

                    if (!res.HasMore || res.EvaluatedCount == 0)
                    {
                        _continuousSweepMessage = $"Barrido de calidad completado con éxito: {totalEvaluated} títulos evaluados ({totalUpdated} corregidos, {totalSkipped} ya correctos, {totalFailed} errores).";
                        break;
                    }
                }
            }
            catch (OperationCanceledException)
            {
                _continuousSweepMessage = "Barrido de calidad detenido por el usuario.";
            }
            catch (Exception ex)
            {
                _continuousSweepMessage = $"Error durante el barrido de calidad: {ex.Message}";
            }
            finally
            {
                _continuousSweepCts?.Dispose();
                _continuousSweepCts = null;
            }
        }, token);

        StartPollingTimer();
    }

