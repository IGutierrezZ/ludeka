    private void ExecuteContinuousVersionsSync()
    {
        if (_isContinuousVersionsSyncActive || !CanManageQueue) return;

        _continuousVersionsSyncCts = new CancellationTokenSource();
        _continuousVersionsSyncMessage = "Iniciando sincronización continua de versiones BGG (2x1) y barrido de catálogo...";
        var token = _continuousVersionsSyncCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                using var scope = ScopeFactory.CreateScope();
                var syncService = scope.ServiceProvider.GetRequiredService<IBggRawSnapshotSyncService>();

                int totalSynced = 0;
                int totalErrors = 0;
                int batchNumber = 0;

                // Fase 1: Descarga y almacenamiento de versiones BGG (versions=1)
                while (!token.IsCancellationRequested)
                {
                    batchNumber++;
                    var res = await syncService.RunScheduledSyncVersionsBatchAsync(batchSize: 20, delayMs: 1200, token);
                    if (res.ProcessedCount == 0)
                    {
                        break;
                    }

                    totalSynced += res.SuccessCount;
                    totalErrors += res.FailedCount;

                    var status = await syncService.GetStatusAsync(token);
                    _continuousVersionsSyncMessage = $"[Fase 1/2: Descargando versiones BGG] Lote #{batchNumber}: {totalSynced} versiones sincronizadas, {totalErrors} incidencias. Quedan {status.SnapshotsPendingVersions} pendientes.";

                    if (res.SuccessCount == 0 && res.FailedCount == 0)
                    {
                        break;
                    }
                }

                if (token.IsCancellationRequested) return;

                // Fase 2: Barrido automático del catálogo para actualizar títulos ES y EANs
                int lastBggId = 0;
                int totalEvaluated = 0;
                int totalTitlesUpdated = 0;
                int totalEansUpdated = 0;

                while (!token.IsCancellationRequested)
                {
                    _continuousVersionsSyncMessage = $"[Fase 2/2: Barrido de catálogo] Actualizando títulos ES y EANs en caliente... ({totalTitlesUpdated} títulos ES, {totalEansUpdated} EANs actualizados de {totalEvaluated} evaluados).";

                    var sweepRes = await syncService.RunScheduledSweepCatalogFromVersionsAsync(batchSize: 200, lastBggId: lastBggId, ct: token);
                    totalEvaluated += sweepRes.EvaluatedCount;
                    totalTitlesUpdated += sweepRes.UpdatedTitlesCount;
                    totalEansUpdated += sweepRes.UpdatedEansCount;
                    lastBggId = sweepRes.LastBggIdProcessed;

                    if (!sweepRes.HasMore || sweepRes.EvaluatedCount == 0)
                    {
                        _continuousVersionsSyncMessage = $"Sincronización continua y barrido completados: {totalSynced} versiones BGG sincronizadas. Catálogo actualizado con {totalTitlesUpdated} títulos en español y {totalEansUpdated} códigos EAN ({totalEvaluated} juegos evaluados).";
                        break;
                    }
                }
            }
            catch (OperationCanceledException)
            {
                _continuousVersionsSyncMessage = "Sincronización continua de versiones detenida por el usuario.";
            }
            catch (Exception ex)
            {
                _continuousVersionsSyncMessage = $"Error durante la sincronización continua de versiones: {ex.Message}";
            }
            finally
            {
                _continuousVersionsSyncCts?.Dispose();
                _continuousVersionsSyncCts = null;
            }
        }, token);

        StartPollingTimer();
    }

    private void ExecuteContinuousSnapshotsSync()
    {
        if (_isContinuousSnapshotsSyncActive || !CanManageQueue) return;

        _continuousSnapshotsSyncCts = new CancellationTokenSource();
        _continuousSnapshotsSyncMessage = "Sincronización continua de snapshots iniciada en segundo plano...";
        var token = _continuousSnapshotsSyncCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                using var scope = ScopeFactory.CreateScope();
                var syncService = scope.ServiceProvider.GetRequiredService<IBggRawSnapshotSyncService>();

                int totalSynced = 0;
                int totalErrors = 0;
                int batchNumber = 0;

                while (!token.IsCancellationRequested)
                {
                    batchNumber++;
                    var res = await syncService.RunScheduledSyncBatchAsync(batchSize: 50, delayMs: 1200, token);
                    if (res.ProcessedCount == 0)
                    {
                        _continuousSnapshotsSyncMessage = $"Sincronización continua completada: todos los títulos disponen de snapshot ({totalSynced} sincronizados en esta sesión).";
                        break;
                    }

                    totalSynced += res.SuccessCount;
                    totalErrors += res.FailedCount;

                    var status = await syncService.GetStatusAsync(token);
                    _continuousSnapshotsSyncMessage = $"Sincronización en curso (Lote #{batchNumber}): {totalSynced} snapshots guardados, {totalErrors} incidencias. Quedan {status.PendingSnapshots} títulos pendientes.";

                    if (res.SuccessCount == 0 && res.FailedCount == 0)
                    {
                        break;
                    }
                }
            }
            catch (OperationCanceledException)
            {
                _continuousSnapshotsSyncMessage = "Sincronización continua de snapshots detenida por el usuario.";
            }
            catch (Exception ex)
            {
                _continuousSnapshotsSyncMessage = $"Error durante la sincronización continua: {ex.Message}";
            }
            finally
            {
                _continuousSnapshotsSyncCts?.Dispose();
                _continuousSnapshotsSyncCts = null;
            }
        }, token);

        StartPollingTimer();
    }

    private void StartPollingTimer()
    {
        _pollTimer?.Dispose();
        _pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        _pollTask = Task.Run(async () =>
        {
            try
            {
                while (_pollTimer != null && await _pollTimer.WaitForNextTickAsync())
                {
                    await InvokeAsync(async () =>
                    {
                        await LoadDataAsync();
                        StateHasChanged();
                    });

                    if (!_isNightlyBatchActive && !_isContinuousDrainActive && !_isContinuousBackfillActive && !_isContinuousSweepActive && !_isContinuousSnapshotsSyncActive && !_isContinuousVersionsSyncActive)
                    {
                        break;
                    }
                }
            }
            catch
            {
                // Ignorar cancelaciones o cierres de timer
            }
        });
    }

    public void Dispose()
    {
        _pollTimer?.Dispose();
        _pollTimer = null;
        _continuousSnapshotsSyncCts?.Cancel();
        _continuousSnapshotsSyncCts?.Dispose();
        _continuousVersionsSyncCts?.Cancel();
        _continuousVersionsSyncCts?.Dispose();
    }

    private static string GetStatusColor(string? status) => status switch
    {
        "Completed" => "text-emerald-500",
        "Running" => "text-amber-500",
        "Failed" => "text-rose-500",
        _ => "text-[var(--text-muted)]"
    };
